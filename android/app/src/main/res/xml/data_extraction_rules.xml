<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of the app goes into a cloud backup or to a new phone (Android 12 and later): its
     settings hold the passwords and pairing keys of the user's computers and consoles.
     allowBackup="false" in the manifest does the same on older Android. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
