desc:NULL Resonator
author: Christos Koulaxizis
tags: resonator karplus-strong comb tuned pitch chord ringing sympathetic string midi
//category: Advanced
//NULL JSFX v2.9 • https://nulljsfx.tech • MIT License

slider1:0<0,11,1{C,C#,D,D#,E,F,F#,G,G#,A,A#,B}>Root Note
slider2:3<1,6,1>Octave
slider3:3<0,7,1{Unison,Octaves,Fifth,Major,Minor,Sus4,Maj7,Min7}>Chord
slider4:1.5<0.1,10,0.01:log>Decay (s)
slider5:50<0,100,1>Brightness (%)
slider6:30<0,100,1>Spread (%)
slider7:50<0,100,1>Mix (%)
slider8:0<0,1,1{Chord,MIDI}>Notes

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // A bank of up to four tuned Karplus-Strong string loops per channel, one per chord note,
  // that the input excites. Each loop is a delay line, a first-order allpass for the
  // fractional part of the period and a symmetric 3-tap low-pass (linear phase, exactly one
  // sample of delay), so every harmonic sits exactly on the note. The loop gain sets the
  // decay time of the fundamental, the low-pass how much faster the upper harmonics die.
  // The input to each loop is scaled by sqrt(1 - g^2) (unity noise power gain), and the
  // wet sum passes a DC blocker and a soft ceiling at 0 dBFS, so it can ring but never run away.
  // Notes MIDI tunes the strings to MIDI notes instead: each new note retunes them to the
  // four latest held notes (any octave; Root, Octave and Chord are then ignored). Releasing
  // notes keeps the tuning, so the tail rings on; before the first note the chord is used.
  // Every MIDI message passes through.
  buf_size = ceil(srate / 30) + 8;
  buf = 0;                          // 8 loops: voice v, channel c at buf + (v * 2 + c) * buf_size
  st = buf + 8 * buf_size;          // per loop: delay M, allpass coef, gain, input scale, states
  ivs = st + 8 * 16;                // chord table: 8 chords x 4 intervals (-1 = unused)
  held = ivs + 32;                  // MIDI: when each note was pressed (0 = not held)
  evq = held + 128;                 // this block's MIDI events
  mnt = evq + 1024;                 // Notes MIDI: the notes the strings are tuned to, newest first
  freembuf(mnt + 4);
  memset(held, 0, mnt + 4 - held);
  stamp = 0; mcnt = 0;
  m_ofs = m_1 = m_2 = m_3 = 0;
  memset(buf, 0, ivs - buf);
  wpos = 0;
  hp_x_l = hp_y_l = hp_x_r = hp_y_r = 0;
  dc_x_l = dc_y_l = dc_x_r = dc_y_r = 0;

  function set_chord(n, a, b, c, d) ( ivs[n * 4] = a; ivs[n * 4 + 1] = b; ivs[n * 4 + 2] = c; ivs[n * 4 + 3] = d; );
  set_chord(0, 0, -1, -1, -1);      // Unison
  set_chord(1, 0, 12, 24, -1);      // Octaves
  set_chord(2, 0, 7, 12, -1);       // Fifth
  set_chord(3, 0, 4, 7, 12);        // Major
  set_chord(4, 0, 3, 7, 12);        // Minor
  set_chord(5, 0, 5, 7, 12);        // Sus4
  set_chord(6, 0, 4, 7, 11);        // Maj7
  set_chord(7, 0, 3, 7, 10);        // Min7

  // one string loop: x = input, i = loop index (voice * 2 + channel)
  function string_tick(x, i) local(p, rp, s, a, f, y)
  (
    p = st + i * 16;
    rp = wpos - p[0];
    rp < 0 ? rp += buf_size;
    s = buf[i * buf_size + rp];
    // first-order allpass: the fractional part of the period
    a = p[1] * (s - p[5]) + p[4];
    p[4] = s; p[5] = a;
    // symmetric 3-tap low-pass, one sample of delay at every frequency
    f = lp_a0 * (a + p[7]) + lp_a1 * p[6];
    p[7] = p[6]; p[6] = a;
    y = x * p[3] + p[2] * f;
    abs(y) < 0.000000000000000000001 ? y = 0;
    buf[i * buf_size + wpos] = y;
    y;
  );

  // the two loops (left, right) of voice nv at MIDI note n
  function tune(n)
  (
    note = n;
    c = 0;
    loop(2,
      // Spread detunes the left loops down and the right ones up, by up to 15 cents
      f0 = 440 * 2 ^ ((note - 69 + (c == 0 ? -1 : 1) * spread * 0.15) / 12);
      len = srate / f0;
      // period = M (delay) + d (allpass, 0.5..1.5) + 1 (low-pass)
      m = floor(len - 1.5);
      d = len - 1 - m;
      p = st + (nv * 2 + c) * 16;
      p[0] = m;
      p[1] = (1 - d) / (1 + d);
      p[2] = min(0.99995, 10 ^ (-3 / (f0 * decay)));
      p[3] = sqrt(1 - p[2] * p[2]);
      p[8] = len;                 // period and note, for the GFX display
      p[9] = note;
      c += 1;
    );
    nv += 1;
  );

  // the strings: the chord, or in Notes MIDI the notes of mnt
  function retune()
  (
    nv = 0;
    v = 0;
    slider8 >= 0.5 && mcnt > 0 ? (
      loop(mcnt, tune(mnt[v]); v += 1;);
    ) : (
      loop(4,
        ivs[chord * 4 + v] >= 0 ? tune(12 * (octave + 1) + root + ivs[chord * 4 + v]);
        v += 1;
      );
    );
    wet_gain = 1 / sqrt(nv);
  );

  // the four latest held notes into mnt, newest first
  function held_notes() local(prev, b, j, k, cnt)
  (
    prev = 1000000000; cnt = 0;
    loop(4,
      b = 0; j = -1; k = 0;
      loop(128,
        held[k] > b && held[k] < prev ? ( b = held[k]; j = k; );
        k += 1;
      );
      j >= 0 ? ( evq[1020 + cnt] = j; cnt += 1; prev = b; );
    );
    cnt > 0 ? (
      mcnt = cnt; k = 0;
      loop(cnt, mnt[k] = evq[1020 + k]; k += 1;);
    );
  );

@slider
  root = slider1;
  octave = slider2;
  chord = slider3;
  decay = max(0.1, slider4);
  bright = slider5 / 100;
  spread = slider6 / 100;
  mix = slider7 / 100;

  lp_a0 = 0.25 * (1 - bright) * (1 - bright);
  lp_a1 = 1 - 2 * lp_a0;
  hp_c = exp(-2 * $pi * 20 / srate);
  dc_c = exp(-2 * $pi * 8 / srate);

  retune();

@block
  // MIDI: every message passes through; notes are applied at their offsets in @sample
  mq_n = 0;
  while (midirecv(m_ofs, m_1, m_2, m_3)) (
    midisend(m_ofs, m_1, m_2, m_3);
    mq_n < 255 ? (
      evq[mq_n * 4] = m_ofs;
      evq[mq_n * 4 + 1] = m_1;
      evq[mq_n * 4 + 2] = m_2;
      evq[mq_n * 4 + 3] = m_3;
      mq_n += 1;
    );
  );
  mq_i = 0;
  si = 0;

@sample
  // MIDI notes due now: held / released, all notes off; Notes MIDI retunes the strings
  while (mq_i < mq_n && evq[mq_i * 4] <= si) (
    m_st = evq[mq_i * 4 + 1] & 0xF0;
    m_n = evq[mq_i * 4 + 2];
    m_st == 0x90 && evq[mq_i * 4 + 3] > 0 ? (
      stamp += 1;
      held[m_n] = stamp;
      held_notes();
      slider8 >= 0.5 ? retune();
    ) : m_st == 0x80 || m_st == 0x90 ? (
      held[m_n] = 0;
    ) : m_st == 0xB0 && (m_n == 120 || m_n == 123) ? (
      memset(held, 0, 128);
    );
    mq_i += 1;
  );
  si += 1;

  // 20 Hz high-pass into the loops, so DC and rumble do not pile up in them
  hp_y_l = hp_c * (hp_y_l + spl0 - hp_x_l); hp_x_l = spl0;
  hp_y_r = hp_c * (hp_y_r + spl1 - hp_x_r); hp_x_r = spl1;
  abs(hp_y_l) < 0.000000000000000000001 ? hp_y_l = 0;
  abs(hp_y_r) < 0.000000000000000000001 ? hp_y_r = 0;

  wet_l = wet_r = 0;
  v = 0;
  loop(nv,
    wet_l += string_tick(hp_y_l, v * 2);
    wet_r += string_tick(hp_y_r, v * 2 + 1);
    v += 1;
  );
  wpos += 1;
  wpos >= buf_size ? wpos = 0;
  wet_l *= wet_gain;
  wet_r *= wet_gain;

  // DC blocker on the ringing sum
  dc_y_l = dc_c * (dc_y_l + wet_l - dc_x_l); dc_x_l = wet_l;
  dc_y_r = dc_c * (dc_y_r + wet_r - dc_x_r); dc_x_r = wet_r;
  abs(dc_y_l) < 0.000000000000000000001 ? dc_y_l = 0;
  abs(dc_y_r) < 0.000000000000000000001 ? dc_y_r = 0;

  // soft ceiling: linear up to 0.7, then bends smoothly towards 1.0
  wet_l = dc_y_l;
  wet_r = dc_y_r;
  abs(wet_l) > 0.7 ? (
    u = (abs(wet_l) - 0.7) / 0.3;
    wet_l = sign(wet_l) * (0.7 + 0.3 * u / (1 + u));
  );
  abs(wet_r) > 0.7 ? (
    u = (abs(wet_r) - 0.7) / 0.3;
    wet_r = sign(wet_r) * (0.7 + 0.3 * u / (1 + u));
  );

  spl0 = spl0 * (1 - mix) + wet_l * mix;
  spl1 = spl1 * (1 - mix) + wet_r * mix;
