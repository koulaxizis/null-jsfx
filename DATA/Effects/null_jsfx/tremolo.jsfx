desc:NULL Tremolo
author: Christos Koulaxizis
tags: tremolo amplitude modulation lfo rhythmic pulsing
//category: Essentials
//NULL JSFX v2.0 • https://nulljsfx.tech • MIT License

slider1:5<0.1,20,0.1>Rate (Hz)
slider2:50<0,100,1>Depth (%)
slider3:40<0,100,1>Mix (%)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  phase = 0;

@slider
  rate = slider1;
  depth_pct = slider2 / 100;
  mix_amt = slider3 / 100;
  phase_inc = 6.28318530717958 * rate / srate;

@sample
  phase >= 6.28318530717958 ? (phase = phase - 6.28318530717958;);
  lfo = sin(phase);
  phase = phase + phase_inc;
  
  // Gain stays within 0..1: full level at the LFO peak, 1 - Depth at the trough
  amplitude = 1 - depth_pct * (0.5 - 0.5 * lfo);
  proc_l = spl0 * amplitude;
  proc_r = spl1 * amplitude;
  
  out_l = spl0 * (1 - mix_amt) + proc_l * mix_amt;
  out_r = spl1 * (1 - mix_amt) + proc_r * mix_amt;
  
  spl0 = out_l;
  spl1 = out_r;
