desc:NULL Mono Maker
author: Christos Koulaxizis
tags: mono bass low frequency summing stereo width
//category: One Slider
//NULL JSFX v2.0 • https://nulljsfx.tech • MIT License

slider1:50<0,100,1>Amount

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  // Removes the side (L-R) content below a crossover, so the low end becomes mono
  // while everything above stays as wide as it was. Amount moves the crossover
  // from 0 (off) up to 400 Hz.
  s1 = s2 = s3 = s4 = 0;

@slider
  amount = slider1 / 100;
  fc = 20 * pow(20, amount);   // 20 Hz .. 400 Hz
  w = 2 * $pi * fc / srate;
  k = tan(w / 2);
  norm = 1 / (1 + sqrt(2) * k + k * k);
  b0 = norm;                   // high-pass
  b1 = -2 * b0;
  b2 = b0;
  a1 = 2 * (k * k - 1) * norm;
  a2 = (1 - sqrt(2) * k + k * k) * norm;

@sample
  side = (spl0 - spl1) * 0.5;
  // 4th-order high-pass (two Butterworth stages) keeps the side above the crossover;
  // everything below it is removed (24 dB/oct, no bump at the crossover)
  y = b0 * side + s1;
  s1 = b1 * side - a1 * y + s2;
  s2 = b2 * side - a2 * y;
  high_side = b0 * y + s3;
  s3 = b1 * y - a1 * high_side + s4;
  s4 = b2 * y - a2 * high_side;
  low_side = side - high_side;
  amount > 0 ? (
    spl0 -= low_side;
    spl1 += low_side;
  );
