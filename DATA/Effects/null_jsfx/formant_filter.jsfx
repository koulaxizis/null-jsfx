desc:NULL Formant Filter
author: Christos Koulaxizis
tags: filter formant vowel voice speech synthesis a e i o u
//category: Advanced
//NULL JSFX v2.0 • https://nulljsfx.tech • MIT License

slider1:0<0,4,1{A,E,I,O,U}>Vowel
slider2:0<-12,12,0.1>Gain (dB)
slider3:10<5,20,1>Q

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  PI=3.14159265358979;
  // Filter state is never reset: changing or automating Vowel, Gain or Q keeps the
  // filters running, and the formant frequencies glide (~15 ms) to the new vowel
  // instead of jumping, so there are no clicks.
  first=1;

  // RBJ band-pass (constant 0 dB peak gain) coefficients at frequency f
  function bp_set(f) instance(b0,b2,a1,a2) local(w0,alpha,a0inv)
  (
    w0=2*PI*f/srate;
    alpha=sin(w0)/(2*q);
    a0inv=1/(1+alpha);
    b0=a0inv*alpha;
    b2=-a0inv*alpha;
    a1=-2*a0inv*cos(w0);
    a2=a0inv*(1-alpha);
  );

@slider
  vowel=slider1;
  g=exp(slider2*0.11512925464970228420);
  q=max(1,slider3);

  vowel==0?(t1=730;t2=1090;t3=2440;);
  vowel==1?(t1=400;t2=1220;t3=2550;);
  vowel==2?(t1=270;t2=2290;t3=3010;);
  vowel==3?(t1=530;t2=1840;t3=2600;);
  vowel==4?(t1=530;t2=1220;t3=2440;);
  first?(f1=t1;f2=t2;f3=t3;first=0;);

@block
  // glide the formants toward the selected vowel, then update the coefficients
  k=1-exp(-samplesblock/(0.015*srate));
  f1+=(t1-f1)*k; f2+=(t2-f2)*k; f3+=(t3-f3)*k;
  c1.bp_set(f1); c2.bp_set(f2); c3.bp_set(f3);
  b0_f1=c1.b0; b1_f1=0; b2_f1=c1.b2; a1_f1=c1.a1; a2_f1=c1.a2;
  b0_f2=c2.b0; b1_f2=0; b2_f2=c2.b2; a1_f2=c2.a1; a2_f2=c2.a2;
  b0_f3=c3.b0; b1_f3=0; b2_f3=c3.b2; a1_f3=c3.a1; a2_f3=c3.a2;

@sample
  // F1 Left
  out_f1l=b0_f1*spl0+b1_f1*x1f1l+b2_f1*x2f1l-a1_f1*y1f1l-a2_f1*y2f1l;
  x2f1l=x1f1l;x1f1l=spl0;y2f1l=y1f1l;y1f1l=out_f1l;
  // F1 Right
  out_f1r=b0_f1*spl1+b1_f1*x1f1r+b2_f1*x2f1r-a1_f1*y1f1r-a2_f1*y2f1r;
  x2f1r=x1f1r;x1f1r=spl1;y2f1r=y1f1r;y1f1r=out_f1r;

  // F2 Left
  out_f2l=b0_f2*spl0+b1_f2*x1f2l+b2_f2*x2f2l-a1_f2*y1f2l-a2_f2*y2f2l;
  x2f2l=x1f2l;x1f2l=spl0;y2f2l=y1f2l;y1f2l=out_f2l;
  // F2 Right
  out_f2r=b0_f2*spl1+b1_f2*x1f2r+b2_f2*x2f2r-a1_f2*y1f2r-a2_f2*y2f2r;
  x2f2r=x1f2r;x1f2r=spl1;y2f2r=y1f2r;y1f2r=out_f2r;

  // F3 Left
  out_f3l=b0_f3*spl0+b1_f3*x1f3l+b2_f3*x2f3l-a1_f3*y1f3l-a2_f3*y2f3l;
  x2f3l=x1f3l;x1f3l=spl0;y2f3l=y1f3l;y1f3l=out_f3l;
  // F3 Right
  out_f3r=b0_f3*spl1+b1_f3*x1f3r+b2_f3*x2f3r-a1_f3*y1f3r-a2_f3*y2f3r;
  x2f3r=x1f3r;x1f3r=spl1;y2f3r=y1f3r;y1f3r=out_f3r;

  spl0=(out_f1l+out_f2l+out_f3l)*g*3;
  spl1=(out_f1r+out_f2r+out_f3r)*g*3;
