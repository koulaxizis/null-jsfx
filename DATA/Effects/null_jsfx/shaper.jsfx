desc:NULL Shaper
author: Christos Koulaxizis
tags: shaper waveshaper waveshaping distortion saturation fold wavefolder transfer curve drawable oversampling harmonics
//category: Essentials
//NULL JSFX v2.7 • https://nulljsfx.tech • MIT License

slider1:1<0,7,1{Custom,Soft,Hard,Tube,Fold,Sine,Steps,Asym}>Shape
slider2:6<0,36,0.1>Drive (dB)
slider3:0<-50,50,1>Bias (%)
slider4:0<0,1,1{Symmetric,Asymmetric}>Symmetry
slider5:1<0,2,1{Off,2x,4x}>Oversampling
slider6:20000<1000,20000,1:log>Tone (Hz)
slider7:100<0,100,1>Mix (%)
slider8:-6<-24,12,0.1>Output (dB)
slider9:0.1<0,1,0.001>P1 X
slider10:0.205<-1,1,0.001>P1 Y
slider11:0.25<0,1,0.001>P2 X
slider12:0.479<-1,1,0.001>P2 Y
slider13:0.4<0,1,0.001>P3 X
slider14:0.689<-1,1,0.001>P3 Y
slider15:0.6<0,1,0.001>P4 X
slider16:0.865<-1,1,0.001>P4 Y
slider17:0.8<0,1,0.001>P5 X
slider18:0.956<-1,1,0.001>P5 Y
slider19:1<0,1,0.001>P6 X
slider20:1<-1,1,0.001>P6 Y
slider21:0<0,1,0.001>P7 X
slider22:0<-1,1,0.001>P7 Y
slider23:0<0,1,0.001>P8 X
slider24:0<-1,1,0.001>P8 Y

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // Waveshaper with a drawable transfer curve. Drive (gain) and Bias (a DC offset, for even
  // harmonics) go into the curve, which runs at 1, 2 or 4 times the sample rate (Oversampling,
  // the halfband FIR stages of NULL Clipper: 63 and 23 taps) so its harmonics do not fold back
  // as aliasing. After it: a DC blocker (10 Hz) that removes the offset again, Tone (a 12 dB/oct
  // low-pass, off at 20 kHz), Mix with the dry input (delayed to match) and Output.
  // The curve: output for an input magnitude 0..1 (above 1 it holds the value at 1), through
  // (0, 0) and up to 8 points (P1..P8: X 0..1, Y -1..1; a point with X = 0 is unused), sorted by
  // X and joined by monotone cubic (PCHIP) segments; flat after the last point. It is sampled
  // into a 1024-step table read with linear interpolation. Symmetric mirrors it for negative
  // input; Asymmetric gives negative input a fixed gentler curve instead (Shape Asym always
  // does). Shape Custom uses the P sliders, every other Shape its built-in points (the GFX and
  // VST3/CLAP interfaces copy those into the P sliders when you pick a Shape, so editing starts
  // from it).
  // Latency (reported to the host): 0, 31 or 37 samples for Off, 2x and 4x.
  E1 = 0;  D1 = 32;  // stage 1 (63 taps): 32 even-phase taps, x2 for the upsampler
  E2 = 64; D2 = 76;  // stage 2 (23 taps): 12
  PX = 1000;         // the P sliders: x, y pairs
  SPTS = 1100;        // built-in points: 16 values per Shape
  XS = 1300; YS = 1320; MS = 1340; DS = 1360; // sorted points, tangents, secants
  TP = 2000;         // table of the curve (1025 values)
  TN = 3100;         // table of the negative curve in Asymmetric
  TLEN = 1024;

  // modified Bessel function I0 (series), for the Kaiser window
  function bessel_i0(x) local(s, t, k, q)
  (
    s = 1; t = 1; k = 1;
    loop(40,
      q = x / (2 * k);
      t *= q * q;
      s += t;
      k += 1;
    );
    s;
  );

  // the n = (taps + 1) / 2 nonzero side taps of a halfband lowpass (Kaiser beta), normalised
  // so they sum to 0.5 (the centre tap is 0.5): e = 2 h for the upsampler, d = h for the
  // downsampler
  function hb_design(e, d, taps, beta) local(c, i, dd, a, sg, r, w, s)
  (
    c = (taps - 1) / 2;
    s = 0;
    i = 0;
    loop((taps + 1) / 2,
      dd = 2 * i - c;
      a = abs(dd);
      sg = ((a - 1) / 2) % 2 ? -1 : 1;
      r = 2 * dd / (taps - 1);
      w = bessel_i0(beta * sqrt(max(0, 1 - r * r))) / bessel_i0(beta);
      d[i] = sg / ($pi * a) * w;
      s += d[i];
      i += 1;
    );
    i = 0;
    loop((taps + 1) / 2,
      d[i] = 0.5 * d[i] / s;
      e[i] = 2 * d[i];
      i += 1;
    );
  );

  hb_design(E1, D1, 63, 7.5);
  hb_design(E2, D2, 23, 8);

  // 2x upsampler, polyphase: one input sample in, hb_o0 (even) and hb_o1 (odd) out.
  // s[0] = write position, s[1 ..] = the last n inputs, stored twice
  function hb_up(x, s, e, n, m) local(p, q, acc, i)
  (
    p = s[0];
    p = p > 0 ? p - 1 : n - 1;
    s[0] = p;
    q = s + 1 + p;
    q[0] = x;
    q[n] = x;
    acc = 0;
    i = 0;
    loop(n, acc += e[i] * q[i]; i += 1;);
    hb_o0 = acc;
    hb_o1 = q[m];
  );

  // 2x downsampler, polyphase: an even and an odd sample in, one sample out.
  // s[0] = write position, s[1] = position in the odd delay, s[2 ..] = the last n even
  // samples stored twice, then m + 1 odd samples
  function hb_down(v0, v1, s, d, n, m) local(p, q, acc, i, o)
  (
    p = s[0];
    p = p > 0 ? p - 1 : n - 1;
    s[0] = p;
    q = s + 2 + p;
    q[0] = v0;
    q[n] = v0;
    acc = 0;
    i = 0;
    loop(n, acc += d[i] * q[i]; i += 1;);
    o = s + 2 + 2 * n + s[1];
    acc += 0.5 * o[0];
    o[0] = v1;
    s[1] = s[1] < m ? s[1] + 1 : 0;
    acc;
  );

  // per channel: filter states, the sample arrays of each rate, the pad and dry delays
  function ch_init(b)
  (
    this.u1 = b;              // 1 + 64
    this.u2 = b + 65;         // 1 + 24
    this.d1 = b + 107;        // 2 + 64 + 16
    this.d2 = b + 189;        // 2 + 24 + 6
    this.a0 = b + 243;        // 1
    this.a1 = b + 244;        // 2
    this.a2 = b + 246;        // 4
    this.pd = b + 258;        // 8
    this.dr = b + 266;        // 64
  );
  chl.ch_init(128);
  chr.ch_init(512);

  // built-in points of the Shapes (1 Soft .. 7 Asym): point i of Shape s
  function shp_pt(s, i, x, y) ( SPTS[s * 16 + i * 2] = x; SPTS[s * 16 + i * 2 + 1] = y; );
  memset(SPTS, 0, 128);
  shp_pt(1, 0, 0.1, 0.205); shp_pt(1, 1, 0.25, 0.479); shp_pt(1, 2, 0.4, 0.689);
  shp_pt(1, 3, 0.6, 0.865); shp_pt(1, 4, 0.8, 0.956); shp_pt(1, 5, 1, 1);
  shp_pt(2, 0, 0.4, 0.5); shp_pt(2, 1, 0.72, 0.9); shp_pt(2, 2, 0.8, 0.98);
  shp_pt(2, 3, 0.85, 1); shp_pt(2, 4, 1, 1);
  shp_pt(3, 0, 0.05, 0.1); shp_pt(3, 1, 0.2, 0.33); shp_pt(3, 2, 0.4, 0.56);
  shp_pt(3, 3, 0.65, 0.75); shp_pt(3, 4, 1, 0.9);
  shp_pt(4, 0, 0.25, 0.9); shp_pt(4, 1, 0.5, -0.3); shp_pt(4, 2, 0.75, 0.7);
  shp_pt(4, 3, 1, -0.5);
  shp_pt(5, 0, 0.167, 0.707); shp_pt(5, 1, 0.333, 1); shp_pt(5, 2, 0.5, 0.707);
  shp_pt(5, 3, 0.667, 0); shp_pt(5, 4, 0.833, -0.707); shp_pt(5, 5, 1, -1);
  shp_pt(6, 0, 0.18, 0.04); shp_pt(6, 1, 0.26, 0.33); shp_pt(6, 2, 0.43, 0.36);
  shp_pt(6, 3, 0.51, 0.65); shp_pt(6, 4, 0.68, 0.68); shp_pt(6, 5, 0.76, 0.97);
  shp_pt(6, 6, 1, 1);
  shp_pt(7, 0, 0.1, 0.25); shp_pt(7, 1, 0.3, 0.62); shp_pt(7, 2, 0.6, 0.9);
  shp_pt(7, 3, 1, 1);
  // the negative half in Asymmetric (Shape slot 0, which Custom never reads)
  shp_pt(0, 0, 0.2, 0.16); shp_pt(0, 1, 0.5, 0.34); shp_pt(0, 2, 1, 0.46);

  // the table dst (TLEN + 1 values over input 0..1) from 8 points src (x, y pairs; x = 0 unused):
  // (0, 0) plus the used points sorted by x (equal x: the first one counts), monotone cubic
  // Hermite segments (PCHIP tangents: weighted harmonic mean of the secants, 0 at an extremum;
  // the end tangents are the end secants), flat after the last point
  function lut_build(src, dst) local(n, i, k, x, y, m, h0, h1, w1, w2, j, u, h, t, t2, t3)
  (
    XS[0] = 0; YS[0] = 0;
    n = 1;
    i = 0;
    loop(8,
      x = src[2 * i];
      y = src[2 * i + 1];
      x > 0 ? (
        k = n;
        while (k > 1 && XS[k - 1] > x) (
          XS[k] = XS[k - 1];
          YS[k] = YS[k - 1];
          k -= 1;
        );
        XS[k] = x;
        YS[k] = y;
        n += 1;
      );
      i += 1;
    );
    m = 1;
    i = 1;
    loop(n - 1,
      XS[i] > XS[m - 1] ? (
        XS[m] = XS[i];
        YS[m] = YS[i];
        m += 1;
      );
      i += 1;
    );
    n = m;
    n < 2 ? ( XS[1] = 1; YS[1] = 1; n = 2; );
    k = 0;
    loop(n - 1,
      DS[k] = (YS[k + 1] - YS[k]) / (XS[k + 1] - XS[k]);
      k += 1;
    );
    MS[0] = DS[0];
    MS[n - 1] = DS[n - 2];
    k = 1;
    loop(n - 2,
      DS[k - 1] * DS[k] > 0 ? (
        h0 = XS[k] - XS[k - 1];
        h1 = XS[k + 1] - XS[k];
        w1 = 2 * h1 + h0;
        w2 = h1 + 2 * h0;
        MS[k] = (w1 + w2) / (w1 / DS[k - 1] + w2 / DS[k]);
      ) : (
        MS[k] = 0;
      );
      k += 1;
    );
    j = 0;
    k = 0;
    loop(TLEN + 1,
      u = k / TLEN;
      while (j < n - 2 && u > XS[j + 1]) ( j += 1; );
      u >= XS[n - 1] ? (
        dst[k] = YS[n - 1];
      ) : (
        h = XS[j + 1] - XS[j];
        t = (u - XS[j]) / h;
        t2 = t * t;
        t3 = t2 * t;
        dst[k] = (2 * t3 - 3 * t2 + 1) * YS[j] + (t3 - 2 * t2 + t) * h * MS[j]
                 + (3 * t2 - 2 * t3) * YS[j + 1] + (t3 - t2) * h * MS[j + 1];
      );
      k += 1;
    );
  );

  // the curve at input v: the table read with linear interpolation, mirrored (or the
  // negative table in Asymmetric) below 0
  function shape(v) local(a, p, i, f, tb)
  (
    a = min(abs(v), 1);
    p = a * TLEN;
    i = min(floor(p), TLEN - 1);
    f = p - i;
    tb = v < 0 && asym ? TN : TP;
    a = tb[i] + (tb[i + 1] - tb[i]) * f;
    v < 0 ? -a : a;
  );

  lut_build(SPTS, TN);
  freembuf(4200);

  os_prev = -1;
  pw = 0;
  dw = 0;
  dc_r = exp(-2 * $pi * 10 / srate);
  dcx_l = dcy_l = dcx_r = dcy_r = 0;
  lx1_l = lx2_l = ly1_l = ly2_l = 0;
  lx1_r = lx2_r = ly1_r = ly2_r = 0;
  pdc_bot_ch = 0;
  pdc_top_ch = 2;

@slider
  shp = floor(slider1 + 0.5);
  gin = 10 ^ (slider2 / 20);
  bias = slider3 / 100;
  asym = slider4 > 0.5 || shp > 6.5;
  os = slider5;
  mix = slider7 / 100;
  gout = 10 ^ (slider8 / 20);
  PX[0] = slider9; PX[1] = slider10; PX[2] = slider11; PX[3] = slider12;
  PX[4] = slider13; PX[5] = slider14; PX[6] = slider15; PX[7] = slider16;
  PX[8] = slider17; PX[9] = slider18; PX[10] = slider19; PX[11] = slider20;
  PX[12] = slider21; PX[13] = slider22; PX[14] = slider23; PX[15] = slider24;
  lut_build(shp < 0.5 ? PX : SPTS + shp * 16, TP);
  // Tone: RBJ low-pass, Q 0.7071, below 0.45 x the sample rate
  tone_on = slider6 < 20000;
  tw0 = 2 * $pi * min(slider6, 0.45 * srate) / srate;
  tcw = cos(tw0);
  tal = sin(tw0) / (2 * 0.7071067811865476);
  ta0 = 1 + tal;
  tb0 = (1 - tcw) / 2 / ta0;
  tb1 = (1 - tcw) / ta0;
  ta1 = -2 * tcw / ta0;
  ta2 = (1 - tal) / ta0;
  os < 0.5 ? ( osf = 1; lat = 0; pad = 0; ) :
  os < 1.5 ? ( osf = 2; lat = 31; pad = 0; ) :
             ( osf = 4; lat = 37; pad = 2; );
  pdc_delay = lat;
  // a new rate starts every filter and delay from silence
  osf != os_prev ? (
    memset(128, 0, 768);
    pw = 0;
    dw = 0;
    os_prev = osf;
  );
  tl = osf > 2 ? chl.a2 : osf > 1 ? chl.a1 : chl.a0;
  tr = osf > 2 ? chr.a2 : osf > 1 ? chr.a1 : chr.a0;

@sample
  xl = spl0 * gin;
  xr = spl1 * gin;

  // up to the shaper's rate
  osf > 1 ? (
    hb_up(xl, chl.u1, E1, 32, 15); chl.a1[0] = hb_o0; chl.a1[1] = hb_o1;
    hb_up(xr, chr.u1, E1, 32, 15); chr.a1[0] = hb_o0; chr.a1[1] = hb_o1;
    osf > 2 ? (
      i = 0;
      loop(2,
        hb_up(chl.a1[i], chl.u2, E2, 12, 5); chl.a2[2 * i] = hb_o0; chl.a2[2 * i + 1] = hb_o1;
        hb_up(chr.a1[i], chr.u2, E2, 12, 5); chr.a2[2 * i] = hb_o0; chr.a2[2 * i + 1] = hb_o1;
        i += 1;
      );
    );
  ) : (
    tl[0] = xl;
    tr[0] = xr;
  );

  // pad delay (whole latency in samples), Bias and the curve, at the top rate
  i = 0;
  loop(osf,
    cxl = tl[i];
    cxr = tr[i];
    pad > 0 ? (
      chl.pd[pw] = cxl;
      chr.pd[pw] = cxr;
      j = (pw - pad + 8) % 8;
      cxl = chl.pd[j];
      cxr = chr.pd[j];
      pw = (pw + 1) % 8;
    );
    tl[i] = shape(cxl + bias);
    tr[i] = shape(cxr + bias);
    i += 1;
  );

  // back down to the sample rate
  osf > 1 ? (
    osf > 2 ? (
      i = 0;
      loop(2,
        chl.a1[i] = hb_down(chl.a2[2 * i], chl.a2[2 * i + 1], chl.d2, D2, 12, 5);
        chr.a1[i] = hb_down(chr.a2[2 * i], chr.a2[2 * i + 1], chr.d2, D2, 12, 5);
        i += 1;
      );
    );
    yl = hb_down(chl.a1[0], chl.a1[1], chl.d1, D1, 32, 15);
    yr = hb_down(chr.a1[0], chr.a1[1], chr.d1, D1, 32, 15);
  ) : (
    yl = tl[0];
    yr = tr[0];
  );

  // DC blocker (removes the Bias offset and the curve's own DC)
  dcy_l = yl - dcx_l + dc_r * dcy_l; dcx_l = yl; yl = dcy_l;
  dcy_r = yr - dcx_r + dc_r * dcy_r; dcx_r = yr; yr = dcy_r;

  // Tone
  tone_on ? (
    ty = tb0 * yl + tb1 * lx1_l + tb0 * lx2_l - ta1 * ly1_l - ta2 * ly2_l;
    lx2_l = lx1_l; lx1_l = yl; ly2_l = ly1_l; ly1_l = ty; yl = ty;
    ty = tb0 * yr + tb1 * lx1_r + tb0 * lx2_r - ta1 * ly1_r - ta2 * ly2_r;
    lx2_r = lx1_r; lx1_r = yr; ly2_r = ly1_r; ly1_r = ty; yr = ty;
  );

  // dry signal delayed by the latency, mix, output
  chl.dr[dw] = spl0;
  chr.dr[dw] = spl1;
  j = (dw - lat + 64) % 64;
  dry_l = chl.dr[j];
  dry_r = chr.dr[j];
  dw = (dw + 1) % 64;
  spl0 = (dry_l * (1 - mix) + yl * mix) * gout;
  spl1 = (dry_r * (1 - mix) + yr * mix) * gout;
