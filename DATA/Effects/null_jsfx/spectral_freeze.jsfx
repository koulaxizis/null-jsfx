desc:NULL Spectral Freeze
author: Christos Koulaxizis
tags: spectral freeze fft sustain drone infinite hold pad ambient
//category: Advanced
//NULL JSFX v2.0 • https://nulljsfx.tech • MIT License

slider1:0<0,1,1{Off,Frozen}>Freeze
slider2:300<10,3000,1>Fade (ms)
slider3:40<0,100,1>Smear (%)
slider4:0<-24,12,0.1>Level (dB)
slider5:100<0,100,1>Mix (%)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  // Captures the spectrum of the sound at the moment Freeze is switched on and holds
  // it forever as a sustained texture (2048-point FFT, 4x overlap). While Off the audio
  // passes untouched and the plugin keeps listening. Smear sets how much the frozen
  // phases are randomised: 0% keeps a tonal, buzzy snapshot; 100% a smooth, airy drone.
  // Fade crossfades into and out of the frozen sound.
  N = 2048; H = N / 4; NB = N / 2 + 1;
  fft_buf = 0;                       // 2N slots, aligned so it never crosses 65536
  win = 2 * N;
  in_l = win + N; in_r = in_l + N;
  mag_l = in_r + N; mag_r = mag_l + NB;
  ph_l = mag_r + NB; ph_r = ph_l + NB;
  out_l = ph_r + NB; out_r = out_l + N;
  freembuf(out_r + N);
  memset(win, 0, out_r + N - win);
  i = 0;
  loop(N, win[i] = 0.5 - 0.5 * cos(2 * $pi * i / N); i += 1);
  // random starting phases, so the frozen frame never lines up into a click
  i = 0;
  loop(NB, ph_l[i] = rand(2 * $pi); ph_r[i] = rand(2 * $pi); i += 1);
  ipos = 0; opos = 0; cnt = 0;
  frozen = 0; wet = 0; filled = 0;

  // analyse the last N samples into magnitudes
  function analyse(inb, magb) local(i, re, im)
  (
    i = 0;
    loop(N,
      fft_buf[2 * i] = inb[(ipos + i) % N] * win[i];
      fft_buf[2 * i + 1] = 0;
      i += 1;
    );
    fft(fft_buf, N);
    fft_permute(fft_buf, N);
    i = 0;
    loop(NB,
      re = fft_buf[2 * i]; im = fft_buf[2 * i + 1];
      magb[i] = sqrt(re * re + im * im);
      i += 1;
    );
  );

  // build one frame from the frozen magnitudes and overlap-add it
  function synth(magb, phb, outb) local(i, p, m)
  (
    i = 0;
    loop(NB,
      p = phb[i] + 2 * $pi * i * H / N + smear * (rand(2) - 1) * $pi;
      p -= floor(p / (2 * $pi)) * 2 * $pi;
      phb[i] = p;
      m = magb[i];
      fft_buf[2 * i] = m * cos(p);
      fft_buf[2 * i + 1] = m * sin(p);
      i > 0 && i < N / 2 ? (
        fft_buf[2 * (N - i)] = m * cos(p);
        fft_buf[2 * (N - i) + 1] = -m * sin(p);
      );
      i += 1;
    );
    fft_buf[1] = 0; fft_buf[N + 1] = 0;
    fft_ipermute(fft_buf, N);
    ifft(fft_buf, N);
    i = 0;
    loop(N,
      p = (opos + i) % N;
      // synthesis window; overlap-added Hann windows at 4x sum to 2, which makes up
      // for the 0.5 gain of the analysis window
      outb[p] += fft_buf[2 * i] * win[i] / N;
      i += 1;
    );
  );

@slider
  want = slider1;
  fade = 1 / max(1, slider2 / 1000 * srate);
  smear = slider3 / 100;
  level = 10 ^ (slider4 / 20);
  mix = slider5 / 100;

@sample
  in_l[ipos] = spl0;
  in_r[ipos] = spl1;
  ipos += 1; ipos >= N ? ipos = 0;
  filled < N ? filled += 1;

  cnt += 1;
  cnt >= H ? (
    cnt = 0;
    // keep the snapshot fresh until Freeze is switched on
    !frozen ? (analyse(in_l, mag_l); analyse(in_r, mag_r));
    // only freeze once a full window of audio has been heard
    want && filled >= N ? frozen = 1;
    wet > 0 || frozen ? (synth(mag_l, ph_l, out_l); synth(mag_r, ph_r, out_r));
  );
  !want && wet <= 0 ? frozen = 0;
  wet = frozen && want ? min(1, wet + fade) : max(0, wet - fade);

  f_l = out_l[opos]; out_l[opos] = 0;
  f_r = out_r[opos]; out_r[opos] = 0;
  opos += 1; opos >= N ? opos = 0;

  w = wet * mix;
  spl0 = spl0 * (1 - w) + f_l * level * w;
  spl1 = spl1 * (1 - w) + f_r * level * w;
