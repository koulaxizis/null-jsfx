desc:NULL Trance Gate
author: Christos Koulaxizis
tags: trance gate 16-step sequencer rhythmic pattern staccato tempo sync probability random
//category: Advanced
//NULL JSFX v4.1 • https://nulljsfx.tech • MIT License

slider1:1<0,1,1{Off,On}>Step 1
slider2:1<0,1,1{Off,On}>Step 2
slider3:0<0,1,1{Off,On}>Step 3
slider4:1<0,1,1{Off,On}>Step 4
slider5:1<0,1,1{Off,On}>Step 5
slider6:0<0,1,1{Off,On}>Step 6
slider7:0<0,1,1{Off,On}>Step 7
slider8:1<0,1,1{Off,On}>Step 8
slider9:1<0,1,1{Off,On}>Step 9
slider10:0<0,1,1{Off,On}>Step 10
slider11:0<0,1,1{Off,On}>Step 11
slider12:1<0,1,1{Off,On}>Step 12
slider13:1<0,1,1{Off,On}>Step 13
slider14:0<0,1,1{Off,On}>Step 14
slider15:0<0,1,1{Off,On}>Step 15
slider16:1<0,1,1{Off,On}>Step 16
slider17:0<0,1,1{Sync,Free}>Rate Mode
slider18:2<0,3,1{1/4,1/8,1/16,1/32}>Step Length
slider19:8<0.5,40,0.1>Free Rate (Hz)
slider20:5<1,100,1>Attack (ms)
slider21:40<10,500,1>Release (ms)
slider22:100<0,100,1>Gate Depth (%)
slider23:100<0,100,1>Probability (%)
slider24:0<0,999,1>Seed
slider25:0<0,1,1{Off,On}>Generate
slider26:50<0,100,1>Density (%)
slider27:0<0,4,1{Trance,Offbeat,Stutter,Half Time,Random}>Style
slider28:0<0,1,1{Hard,Flow}>Shape
slider29:0<0,100,1>Mutate (%)
slider30:1<0,3,1{1 Cycle,2 Cycles,4 Cycles,8 Cycles}>Mutate Every

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // 16-step gate. Sync: one step = Step Length at the host tempo; while the transport
  // plays, the step is taken from beat_position so the pattern stays locked to the bar
  // grid (step 1 on every bar downbeat in 4/4). Stopped, it free-runs at the host tempo.
  // Free: steps advance at Free Rate (steps per second), ignoring the host.
  // Gate Depth sets how far the "off" steps duck: 0% = no gating, 100% = silence.
  // Probability: the chance that an "on" step opens the gate; below 100% each step draws a
  // number from Seed and its position (exact Park-Miller in doubles, skipped ahead to the step,
  // so the same song position always makes the same choice and the native plugin matches).
  // Generate (appended in 4.0): On plays a pattern made from Seed, Density and Style in place
  // of the 16 Step sliders (which keep their values). Each style gives every step a weight;
  // one Park-Miller draw per step opens it with the chance min(1, weight * 2 * Density), so the
  // same Seed always makes the same pattern and a higher Density only adds steps.
  // Shape, Mutate and Mutate Every (appended 2026-11-18): Flow glides the gain from each step's
  // level to the next one's over the step (a raised cosine) instead of holding it. Mutate plays,
  // every Mutate Every cycles of 16 steps, a variation of the pattern: that share of the steps is
  // drawn anew (Generate On: by the style's weights and Density; Off: switched). The draws come
  // from Seed and the cycle's position, so the same song position always plays the same
  // variation; the first cycle block (0) plays the pattern itself.
  pat = 0;            // pattern, 16 slots
  step_pos = 0;
  gate_gain = 1;
  rnd_pos = 0;        // the step position, never wrapped (Probability)
  rnd_last = -0.5;    // the step the last draw was for
  rnd_keep = 1;
  rnd_keep_n = 1;     // Probability's draw for the next step (Flow)
  PM = 16;            // the pattern Mutate plays, 16 slots
  mb_last = -0.5;     // the cycle block PM was made for

  // (x * y) mod 2147483647, exact in doubles: y split into 16-bit halves
  function pm_mul(x, y) local(hi, r)
  (
    hi = floor(y / 65536);
    r = x * hi;
    r -= floor(r / 2147483647) * 2147483647;
    r = r * 65536 + x * (y - hi * 65536);
    r -= floor(r / 2147483647) * 2147483647;
    r < 0 ? r += 2147483647;
    r >= 2147483647 ? r -= 2147483647;
    r;
  );

  // the Park-Miller value for step i of seed sd (0..1): (sd + 1) * 16807^(i + 8) mod 2^31 - 1
  function pm_step(i, sd) local(e, b, p)
  (
    e = i - floor(i / 2147483646) * 2147483646 + 8;
    b = 16807;
    p = sd + 1;
    while (e > 0) (
      e - floor(e / 2) * 2 > 0 ? p = pm_mul(p, b);
      b = pm_mul(b, b);
      e = floor(e / 2);
    );
    p / 2147483647;
  );

  // one Park-Miller step (x * 16807 mod 2^31 - 1, exact in doubles), for Generate
  function gen_pm(x)
  (
    x *= 16807;
    x - floor(x / 2147483647) * 2147483647;
  );

  // Generate: per style, the weight of each step (1..9, '.' never)
  function gen_w(st)
  (
    st == 0 ? "9.69.69.9.69.6.9" : // Trance
    st == 1 ? "3.9.3.9.3.9.3.95" : // Offbeat
    st == 2 ? "99993...99993.3." : // Stutter
    st == 3 ? "9.6.....9.6...3." : // Half Time
    "5555555555555555";            // Random
  );

  // the generated pattern into pat[] (always 16 draws, so a higher Density only adds steps)
  function gen_make() local(x, st, d, i, c, w, str)
  (
    st = max(0, min(4, floor(slider27 + 0.5)));
    d = slider26 / 100;
    x = rnd_seed * 7 + st * 1000 + 12345;
    loop(4, x = gen_pm(x));
    str = gen_w(st);
    i = 0;
    loop(16,
      x = gen_pm(x);
      c = str_getchar(str, i);
      w = c >= '1' && c <= '9' ? (c - '0') / 9 : 0;
      pat[i] = x / 2147483647 < min(1, w * 2 * d) ? 1 : 0;
      i += 1;
    );
  );

  // Mutate: the variation of cycle block m into PM[]
  function tg_mut(m) local(i, r, c, w, d, str)
  (
    d = slider26 / 100;
    str = gen_w(max(0, min(4, floor(slider27 + 0.5))));
    i = 0;
    loop(16,
      m == 0 ? (
        PM[i] = pat[i];
      ) : (
        r = pm_step(m * 64 + i * 2 + 7919, rnd_seed);
        r < mut ? (
          c = str_getchar(str, i);
          w = c >= '1' && c <= '9' ? (c - '0') / 9 : 0;
          PM[i] = gen_on ? (pm_step(m * 64 + i * 2 + 7920, rnd_seed) < min(1, w * 2 * d) ? 1 : 0) : 1 - pat[i];
        ) : (
          PM[i] = pat[i];
        );
      );
      i += 1;
    );
  );

@slider
  pat[0] = slider1; pat[1] = slider2; pat[2] = slider3; pat[3] = slider4;
  pat[4] = slider5; pat[5] = slider6; pat[6] = slider7; pat[7] = slider8;
  pat[8] = slider9; pat[9] = slider10; pat[10] = slider11; pat[11] = slider12;
  pat[12] = slider13; pat[13] = slider14; pat[14] = slider15; pat[15] = slider16;
  free_mode = slider17;
  steps_per_beat = 2 ^ slider18;           // 1/4 -> 1, 1/8 -> 2, 1/16 -> 4, 1/32 -> 8
  free_rate = slider19;
  attack_coef = 1 / max(1, srate * slider20 * 0.001);
  release_coef = 1 / max(1, srate * slider21 * 0.001);
  gate_depth = slider22 / 100;
  prob = slider23 / 100;
  rnd_seed = slider24;
  rnd_last = -0.5;
  slider25 >= 0.5 ? gen_make();
  gen_on = slider25 >= 0.5;
  flow = slider28;
  mut = slider29 / 100;
  mev = slider30 == 0 ? 1 : slider30 == 1 ? 2 : slider30 == 2 ? 4 : 8;
  mb_last = -0.5;

@block
  bpm = tempo > 0 ? tempo : 120;
  free_mode ? (
    step_inc = free_rate / srate;
  ) : (
    step_inc = bpm / 60 * steps_per_beat / srate;
    // lock to the host grid while playing
    play_state & 1 ? (
      step_pos = beat_position * steps_per_beat;
      rnd_pos = step_pos;
    );
  );

@sample
  step_pos += step_inc;
  rnd_pos += step_inc;
  // keep the free-running counter small (the synced one is re-read every block)
  step_pos >= 16 ? step_pos -= 16;
  s = floor(step_pos);
  cur_step = s - 16 * floor(s / 16);       // also correct for negative positions (pre-roll)
  mut > 0 ? (
    // Mutate: a new variation at every cycle block
    mb = floor(floor(rnd_pos) / (16 * mev));
    mb != mb_last ? ( mb_last = mb; tg_mut(mb); );
    on_c = PM[cur_step];
    on_n = PM[(cur_step + 1) % 16];
  ) : (
    on_c = pat[cur_step];
    on_n = pat[(cur_step + 1) % 16];
  );
  prob < 1 ? (
    // Probability: a new draw whenever the step changes
    rnd_i = floor(rnd_pos);
    rnd_i != rnd_last ? (
      rnd_last = rnd_i;
      rnd_keep = pm_step(rnd_i, rnd_seed) < prob;
      flow ? rnd_keep_n = pm_step(rnd_i + 1, rnd_seed) < prob;
    );
    k_c = rnd_keep;
    k_n = rnd_keep_n;
  ) : (
    k_c = 1;
    k_n = 1;
  );
  target = 1 - gate_depth * (1 - on_c * k_c);
  flow ? (
    // Flow: from this step's level to the next one's over the step
    t_n = 1 - gate_depth * (1 - on_n * k_n);
    t_f = step_pos - floor(step_pos);
    target += (t_n - target) * (0.5 - 0.5 * cos($pi * t_f));
  );

  target > gate_gain ? (
    gate_gain += attack_coef;
    gate_gain > target ? gate_gain = target;
  ) : (
    gate_gain -= release_coef;
    gate_gain < target ? gate_gain = target;
  );

  spl0 *= gate_gain;
  spl1 *= gate_gain;
