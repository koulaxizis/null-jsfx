desc:NULL Tilt
author: Christos Koulaxizis
tags: eq tilt tone bass treble balance tonal
//category: One Slider
//NULL JSFX v2.0 • https://nulljsfx.tech • MIT License

slider1:0<-100,100,1>Amount

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  // Tilts the whole spectrum around 700 Hz: positive values brighten (treble up, bass
  // down), negative values darken (bass up, treble down), up to 6 dB each way. The
  // centre (0) is flat.
  lp_l = lp_r = 0;

@slider
  t = slider1 / 100;
  c = exp(-2 * $pi * 700 / srate);
  g_low = 10 ^ (-t * 6 / 20);
  g_high = 10 ^ (t * 6 / 20);

@sample
  lp_l = (1 - c) * spl0 + c * lp_l;
  lp_r = (1 - c) * spl1 + c * lp_r;
  spl0 = lp_l * g_low + (spl0 - lp_l) * g_high;
  spl1 = lp_r * g_low + (spl1 - lp_r) * g_high;
