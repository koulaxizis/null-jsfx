desc:NULL Distortion
//tags: distortion overdrive saturation drive grit aggressive
//author: Christos Koulaxizis
//Collection: NULL JSFX

slider1:30<0,100,0.1>Drive-%
slider2:0<-12,12,0.1>Tone-(dB)
slider3:50<0,100,1>Mix-%

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
  DB2LIN = 0.11512925464970228420;

@slider
  drive_pct = slider1 / 100;
  tilt_db = slider2;
  mix_pct = slider3 / 100;

  dist_pregain = 1 + drive_pct * 49;
  
  tilt_alpha = 1 - exp(-2 * 3.14159265 * 1500 / srate);
  tilt_hi = pow(10, tilt_db / 40);
  tilt_lo = pow(10, -tilt_db / 40);
  tilt_lp_l = 0;
  tilt_lp_r = 0;

@sample
  drv_l = spl0 * dist_pregain;
  drv_r = spl1 * dist_pregain;

  c_l = drv_l > 1 ? 1 : (drv_l < -1 ? -1 : drv_l);
  c_l = c_l - (c_l * c_l * c_l) / 3;
  c_r = drv_r > 1 ? 1 : (drv_r < -1 ? -1 : drv_r);
  c_r = c_r - (c_r * c_r * c_r) / 3;

  h_th = 0.8;
  h_l = c_l > h_th ? h_th : (c_l < -h_th ? -h_th : c_l);
  h_r = c_r > h_th ? h_th : (c_r < -h_th ? -h_th : c_r);

  proc_l = h_l * 1.3;
  proc_r = h_r * 1.3;
  
  tilt_lp_l = tilt_lp_l + tilt_alpha * (proc_l - tilt_lp_l);
  tilt_lp_r = tilt_lp_r + tilt_alpha * (proc_r - tilt_lp_r);
  tilt_hp_l = proc_l - tilt_lp_l;
  tilt_hp_r = proc_r - tilt_lp_r;
  
  tilt_out_l = tilt_hp_l * tilt_hi + tilt_lp_l * tilt_lo;
  tilt_out_r = tilt_hp_r * tilt_hi + tilt_lp_r * tilt_lo;
  
  out_l = spl0 * (1 - mix_pct) + tilt_out_l * mix_pct;
  out_r = spl1 * (1 - mix_pct) + tilt_out_r * mix_pct;
  
  spl0 = out_l;
  spl1 = out_r;