desc:NULL Pressure
author: Christos Koulaxizis
tags: compressor dynamics leveling glue squash
//category: One Slider
//NULL JSFX v2.0 • https://nulljsfx.tech • MIT License

slider1:50<0,100,1>Amount

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  // Bus glue: a stereo-linked RMS-style compressor whose threshold drops (0 to -30 dB) and
  // ratio rises (1:1 to 6:1) with Amount, with 10 ms attack, 150 ms release and automatic
  // makeup gain. At 0 it does nothing.
  env = 0; gr = 1;

@slider
  a = slider1 / 100;
  thr = -30 * a;
  ratio = 1 + 5 * a;
  makeup = 10 ^ (-thr * (1 - 1 / ratio) * 0.5 / 20);
  att = exp(-1 / (0.01 * srate)); rel = exp(-1 / (0.15 * srate));
  det = exp(-1 / (0.005 * srate));

@sample
  lev = max(spl0 * spl0, spl1 * spl1);
  env = det * env + (1 - det) * lev;
  db = 10 * log10(env + 0.0000000001);
  target = db > thr ? 10 ^ (-(db - thr) * (1 - 1 / ratio) / 20) : 1;
  gr = target < gr ? att * gr + (1 - att) * target : rel * gr + (1 - rel) * target;
  spl0 *= gr * makeup;
  spl1 *= gr * makeup;
