desc:NULL Surround Panner
author: Christos Koulaxizis
tags: surround panner 5.1 7.1 7.1.4 atmos bed immersive vbap azimuth elevation spread lfe post production film music
//category: Advanced
//NULL JSFX v2.6 • https://nulljsfx.tech • MIT License

slider1:0<0,2,1{5.1,7.1,7.1.4}>Format
slider2:1<0,1,1{Mono,Stereo}>Input
slider3:0<-180,180,1>Azimuth (deg)
slider4:0<0,90,1>Elevation (deg)
slider5:60<0,180,1>Spread (deg)
slider6:100<0,100,1>Center (%)
slider7:-60<-60,0,0.1>LFE (dB)
slider8:0<-24,12,0.1>Output (dB)

in_pin:Left
in_pin:Right
out_pin:L
out_pin:R
out_pin:C
out_pin:LFE
out_pin:Ls
out_pin:Rs
out_pin:Lrs
out_pin:Rrs
out_pin:Ltf
out_pin:Rtf
out_pin:Ltr
out_pin:Rtr

@init
  // Pans a mono or stereo track into a surround bed: 5.1 (L R C LFE Ls Rs), 7.1 (L R C LFE Lss
  // Rss Lrs Rrs) or 7.1.4 (7.1 and the four tops Ltf Rtf Ltr Rtr), in that pin order; the pins a
  // format does not use stay silent. Speakers as ITU-R BS.775 / BS.2051 and Dolby: L/R at 30
  // degrees, C at 0, 5.1 surrounds at 110, 7.1 sides at 90 and rears at 150, tops at 45 and 135
  // (elevation 45). Azimuth runs from -180 to 180, negative to the left.
  //   - pairwise 2D VBAP on the ear-level ring, power-normalised; Center below 100 % moves the
  //     sound from C into a phantom centre between L and R (the powers crossfade)
  //   - Mono: the source is spread over Spread degrees (seven points, powers averaged);
  //     Stereo: the left and right inputs sit at Azimuth -/+ Spread/2 (60 = the front pair)
  //   - 7.1.4: Elevation crossfades the power from the ear level (cos) to the top ring (sin),
  //     VBAP on the four tops at the same azimuth
  //   - LFE sends the mono sum through a 120 Hz Linkwitz-Riley low-pass (Off at -60 dB)
  // Gains glide over about 20 ms, so a moving pan does not click.
  NCH = 12;
  GL = 0; GR = 16; SL = 32; SR = 48;   // target and smoothed gains per output pin
  SPK = 64;                            // the ring: azimuth, pin (pairs)
  TMP = 128;                           // gains of one point
  memset(0, 0, 256);
  sp_init = 0;

  // VBAP of the point at azimuth a (deg) on the ring of n speakers at SPK (sorted by azimuth),
  // added as power x w into the gains at dst
  function sp_vbap(a, n, dst, w) local(i, j, a1, a2, x, d, g1, g2, k)
  (
    // the pair around a: i at or below, j above (wrapping round the back)
    i = n - 1;
    k = 0;
    loop(n, SPK[k * 2] <= a ? i = k; k += 1;);
    a < SPK[0] ? i = n - 1;
    j = i + 1;
    j >= n ? j = 0;
    a1 = SPK[i * 2];
    a2 = SPK[j * 2];
    // angles relative to a1, the pair's span taken the short way round
    x = a - a1; x < 0 ? x += 360;
    d = a2 - a1; d <= 0 ? d += 360;
    a1 = 0;
    a2 = d * $pi / 180;
    x *= $pi / 180;
    d = sin(a2);
    g1 = (cos(x) * sin(a2) - sin(x) * cos(a2)) / d;
    g2 = sin(x) / d;
    d = g1 * g1 + g2 * g2;
    d > 0 ? (
      dst[SPK[i * 2 + 1]] += w * g1 * g1 / d;
      dst[SPK[j * 2 + 1]] += w * g2 * g2 / d;
    );
  );

  // the ring of the ear level (with or without C) or of the tops, at SPK; returns its size
  function sp_ring(top, withc) local(n)
  (
    n = 0;
    top ? (
      SPK[0] = -135; SPK[1] = 10; SPK[2] = -45; SPK[3] = 8; SPK[4] = 45; SPK[5] = 9; SPK[6] = 135; SPK[7] = 11;
      n = 4;
    ) : fmt == 0 ? (
      SPK[0] = -110; SPK[1] = 4; SPK[2] = -30; SPK[3] = 0;
      withc ? ( SPK[4] = 0; SPK[5] = 2; SPK[6] = 30; SPK[7] = 1; SPK[8] = 110; SPK[9] = 5; n = 5; )
            : ( SPK[4] = 30; SPK[5] = 1; SPK[6] = 110; SPK[7] = 5; n = 4; );
    ) : (
      SPK[0] = -150; SPK[1] = 6; SPK[2] = -90; SPK[3] = 4; SPK[4] = -30; SPK[5] = 0;
      withc ? ( SPK[6] = 0; SPK[7] = 2; SPK[8] = 30; SPK[9] = 1; SPK[10] = 90; SPK[11] = 5; SPK[12] = 150; SPK[13] = 7; n = 7; )
            : ( SPK[6] = 30; SPK[7] = 1; SPK[8] = 90; SPK[9] = 5; SPK[10] = 150; SPK[11] = 7; n = 6; );
    );
    n;
  );

  // the gains (power, summed into TMP) of a point source at azimuth a with the given power w
  function sp_point(a, w) local(n, e)
  (
    a = a - floor((a + 180) / 360) * 360;
    e = fmt == 2 ? cos(elev * $pi / 180) : 1;
    e *= e;
    cen > 0 ? ( n = sp_ring(0, 1); sp_vbap(a, n, TMP, w * e * cen); );
    cen < 1 ? ( n = sp_ring(0, 0); sp_vbap(a, n, TMP, w * e * (1 - cen)); );
    fmt == 2 && elev > 0 ? ( n = sp_ring(1, 0); sp_vbap(a, n, TMP, w * (1 - e)); );
  );

  // the amplitude gains of one input into dst: a point, or spread over sp degrees (mono)
  function sp_source(a, sp, dst) local(k)
  (
    memset(TMP, 0, NCH);
    sp > 0 ? (
      k = 0;
      loop(7, sp_point(a + sp * (k / 6 - 0.5), 1 / 7); k += 1;);
    ) : sp_point(a, 1);
    k = 0;
    loop(NCH, dst[k] = sqrt(TMP[k]) * outg; k += 1;);
  );

  // Linkwitz-Riley 120 Hz low-pass for the LFE: two Butterworth biquads
  function sp_lp(x) local(y)
  (
    y = lb0 * x + lz1;
    lz1 = lb1 * x - la1 * y + lz2;
    lz2 = lb2 * x - la2 * y;
    x = y;
    y = lb0 * x + lw1;
    lw1 = lb1 * x - la1 * y + lw2;
    lw2 = lb2 * x - la2 * y;
    y;
  );

@slider
  fmt = slider1;
  stereo = slider2 >= 0.5;
  elev = slider4;
  cen = slider6 / 100;
  outg = 10 ^ (slider8 / 20);
  lfe = slider7 > -60 ? 10 ^ (slider7 / 20) * outg : 0;
  stereo ? (
    sp_source(slider3 - slider5 / 2, 0, GL);
    sp_source(slider3 + slider5 / 2, 0, GR);
  ) : (
    sp_source(slider3, slider5, GL);
    memset(GR, 0, NCH);
  );
  // the pins the format does not use
  fmt == 0 ? ( memset(GL + 6, 0, 6); memset(GR + 6, 0, 6); );
  fmt == 1 ? ( memset(GL + 8, 0, 4); memset(GR + 8, 0, 4); );
  // the LFE low-pass
  lp_k = tan($pi * min(120, 0.45 * srate) / srate);
  lp_n = 1 / (1 + sqrt(2) * lp_k + lp_k * lp_k);
  lb0 = lp_k * lp_k * lp_n; lb1 = 2 * lb0; lb2 = lb0;
  la1 = 2 * (lp_k * lp_k - 1) * lp_n;
  la2 = (1 - sqrt(2) * lp_k + lp_k * lp_k) * lp_n;
  // the first @slider: no glide
  !sp_init ? ( memcpy(SL, GL, NCH); memcpy(SR, GR, NCH); sp_init = 1; );
  sm_c = exp(-1 / (0.02 * srate / 3));

@sample
  in_l = spl0;
  in_r = spl1;
  // the gains glide to their targets
  k = 0;
  loop(NCH,
    SL[k] = GL[k] + (SL[k] - GL[k]) * sm_c;
    SR[k] = GR[k] + (SR[k] - GR[k]) * sm_c;
    k += 1;
  );
  lfe_s = stereo ? (in_l + in_r) * 0.5 : in_l;
  spl0 = in_l * SL[0] + in_r * SR[0];
  spl1 = in_l * SL[1] + in_r * SR[1];
  spl2 = in_l * SL[2] + in_r * SR[2];
  spl3 = in_l * SL[3] + in_r * SR[3] + sp_lp(lfe_s) * lfe;
  spl4 = in_l * SL[4] + in_r * SR[4];
  spl5 = in_l * SL[5] + in_r * SR[5];
  spl6 = in_l * SL[6] + in_r * SR[6];
  spl7 = in_l * SL[7] + in_r * SR[7];
  spl8 = in_l * SL[8] + in_r * SR[8];
  spl9 = in_l * SL[9] + in_r * SR[9];
  spl10 = in_l * SL[10] + in_r * SR[10];
  spl11 = in_l * SL[11] + in_r * SR[11];
