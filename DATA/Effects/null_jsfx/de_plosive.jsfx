desc:NULL De-Plosive
author: Christos Koulaxizis
tags: de-plosive deplosive plosive pop p b vocal voice dialogue podcast low end thump repair restoration
//category: Essentials
//NULL JSFX v3.0 • https://nulljsfx.tech • MIT License

slider1:50<0,100,1>Sensitivity (%)
slider2:150<60,400,1:log>Frequency (Hz)
slider3:18<0,30,1>Max Reduction (dB)
slider4:80<20,300,1>Release (ms)
slider5:0<0,1,1{Off,On}>Listen

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // Removes the low-frequency bursts of P and B sounds. A Linkwitz-Riley crossover (24 dB/oct,
  // in phase, sums back flat) splits the signal at Frequency. A fast envelope of the low band
  // (1 ms attack, 30 ms release, both channels linked) is compared with the same envelope of
  // the high band and with its own slow average (200 ms): when it jumps above both by more
  // than the threshold (12 dB at Sensitivity 0 down to 0 dB at 100, 6 dB by default), the low
  // band alone is turned down by twice the excess, up to Max Reduction (1 ms attack, Release).
  // Both bands run 5 ms late (look-ahead, reported as latency) so the onset is caught.
  // Listen outputs only what is being removed.
  look = floor(0.005 * srate + 0.5);
  pdc_delay = look;
  pdc_bot_ch = 0;
  pdc_top_ch = 2;
  b_ll = 0;            // delayed bands: low left, low right, high left, high right
  b_lr = look;
  b_hl = 2 * look;
  b_hr = 3 * look;
  memset(0, 0, 4 * look);
  freembuf(4 * look);
  wp = 0;
  att_e = exp(-1 / (0.001 * srate));
  rel_e = exp(-1 / (0.03 * srate));
  slow_e = exp(-1 / (0.2 * srate));
  att_g = exp(-1 / (0.001 * srate));
  e_lo = e_hi = s_lo = 0;
  gs = 0;
  l1.ic1 = l1.ic2 = l2.ic1 = l2.ic2 = l3.ic1 = l3.ic2 = 0;
  r1.ic1 = r1.ic2 = r2.ic1 = r2.ic2 = r3.ic1 = r3.ic2 = 0;

  // TPT state-variable filter (Butterworth, k = sqrt 2): low-pass into this.lp, high-pass
  // into this.hp
  function svf(x) local(v1, v2, v3)
  (
    v3 = x - this.ic2;
    v1 = sa1 * this.ic1 + sa2 * v3;
    v2 = this.ic2 + sa2 * this.ic1 + sa3 * v3;
    this.ic1 = 2 * v1 - this.ic1;
    this.ic2 = 2 * v2 - this.ic2;
    this.lp = v2;
    this.hp = x - 1.4142135623730951 * v1 - v2;
  );

  // flushes a filter's state once it decays below -300 dB (no denormals in silence)
  function flush()
  (
    abs(this.ic1) < 0.000000000000001 ? this.ic1 = 0;
    abs(this.ic2) < 0.000000000000001 ? this.ic2 = 0;
  );

@slider
  sg = tan($pi * slider2 / srate);
  sa1 = 1 / (1 + sg * (sg + 1.4142135623730951));
  sa2 = sg * sa1;
  sa3 = sg * sa2;
  thr_db = 12 - 0.12 * slider1;
  thr = 10 ^ (thr_db / 20);
  maxr = slider3;
  rel_g = exp(-1 / (slider4 * 0.001 * srate));
  listen = slider5;

@block
  l1.flush(); l2.flush(); l3.flush(); r1.flush(); r2.flush(); r3.flush();
  e_lo < 0.000000000000001 ? e_lo = 0;
  e_hi < 0.000000000000001 ? e_hi = 0;
  s_lo < 0.000000000000001 ? s_lo = 0;

@sample
  // Linkwitz-Riley 4: low = LP(LP(x)), high = HP(HP(x))
  l1.svf(spl0);
  l2.svf(l1.lp);
  l3.svf(l1.hp);
  r1.svf(spl1);
  r2.svf(r1.lp);
  r3.svf(r1.hp);
  lo_l = l2.lp; hi_l = l3.hp;
  lo_r = r2.lp; hi_r = r3.hp;

  // detector: fast low and high envelopes, slow low average
  dl = max(abs(lo_l), abs(lo_r));
  dh = max(abs(hi_l), abs(hi_r));
  e_lo = dl > e_lo ? dl + (e_lo - dl) * att_e : dl + (e_lo - dl) * rel_e;
  e_hi = dh > e_hi ? dh + (e_hi - dh) * att_e : dh + (e_hi - dh) * rel_e;
  s_lo = e_lo + (s_lo - e_lo) * slow_e;
  ratio = min(e_lo / (e_hi + 0.001), e_lo / (s_lo + 0.001));
  gt = ratio > thr ? min(maxr, 2 * (20 * log10(ratio) - thr_db)) : 0;
  gs = gt > gs ? gt + (gs - gt) * att_g : gt + (gs - gt) * rel_g;
  gs < 0.000001 ? gs = 0;
  gl = gs > 0 ? 10 ^ (0 - gs / 20) : 1;

  // look-ahead: both bands 5 ms late
  dlo_l = b_ll[wp]; b_ll[wp] = lo_l;
  dlo_r = b_lr[wp]; b_lr[wp] = lo_r;
  dhi_l = b_hl[wp]; b_hl[wp] = hi_l;
  dhi_r = b_hr[wp]; b_hr[wp] = hi_r;
  wp = wp + 1 >= look ? 0 : wp + 1;

  listen > 0.5 ? (
    spl0 = dlo_l * (1 - gl);
    spl1 = dlo_r * (1 - gl);
  ) : (
    spl0 = dlo_l * gl + dhi_l;
    spl1 = dlo_r * gl + dhi_r;
  );
