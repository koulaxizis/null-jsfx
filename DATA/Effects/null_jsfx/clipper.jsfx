desc:NULL Clipper
author: Christos Koulaxizis
tags: clipper clip soft clip hard clip saturation oversampling ceiling loudness peak drums mastering
//category: Essentials
//NULL JSFX v2.6 • https://nulljsfx.tech • MIT License

slider1:0<-12,24,0.1>Input (dB)
slider2:-0.1<-24,0,0.1>Ceiling (dB)
slider3:0<0,100,1>Knee (%)
slider4:2<0,3,1{Off,2x,4x,8x}>Oversampling
slider5:100<0,100,1>Mix (%)
slider6:0<-24,12,0.1>Output (dB)
slider7:1<0,1,1{Stereo,Dual}>Link

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  // Clips peaks at Ceiling. Input drives the signal into the clipper; Knee rounds the corner
  // (0 = hard clip; above it the part of the wave over Ceiling x (1 - Knee) bends into the
  // ceiling along a tanh curve, which never reaches it). Oversampling runs the clipper at 2, 4
  // or 8 times the sample rate through linear-phase halfband FIR stages (Kaiser-windowed sinc:
  // 63, 23 and 15 taps) so the harmonics it makes do not fold back as aliasing. Without
  // oversampling no sample passes Ceiling; with it, the band-limited wave between the clipped
  // points may peak a little above (no clamp after the filters, which would bring the
  // aliasing back). Link Stereo applies the same gain to both channels, Dual clips each on
  // its own. Mix blends the clipped signal with the dry input (delayed to match), Output sets
  // the level after the mix.
  // Latency (reported to the host): 0, 31, 37 or 39 samples for Off, 2x, 4x and 8x.
  E1 = 0;  D1 = 32;  // stage 1 (63 taps): 32 even-phase taps, x2 for the upsampler
  E2 = 64; D2 = 76;  // stage 2 (23 taps): 12
  E3 = 88; D3 = 96;  // stage 3 (15 taps): 8

  // modified Bessel function I0 (series), for the Kaiser window
  function bessel_i0(x) local(s, t, k, q)
  (
    s = 1; t = 1; k = 1;
    loop(40,
      q = x / (2 * k);
      t *= q * q;
      s += t;
      k += 1;
    );
    s;
  );

  // the n = (taps + 1) / 2 nonzero side taps of a halfband lowpass (Kaiser beta), normalised
  // so they sum to 0.5 (the centre tap is 0.5): e = 2 h for the upsampler, d = h for the
  // downsampler
  function hb_design(e, d, taps, beta) local(c, i, dd, a, sg, r, w, s)
  (
    c = (taps - 1) / 2;
    s = 0;
    i = 0;
    loop((taps + 1) / 2,
      dd = 2 * i - c;
      a = abs(dd);
      sg = ((a - 1) / 2) % 2 ? -1 : 1;
      r = 2 * dd / (taps - 1);
      w = bessel_i0(beta * sqrt(max(0, 1 - r * r))) / bessel_i0(beta);
      d[i] = sg / ($pi * a) * w;
      s += d[i];
      i += 1;
    );
    i = 0;
    loop((taps + 1) / 2,
      d[i] = 0.5 * d[i] / s;
      e[i] = 2 * d[i];
      i += 1;
    );
  );

  hb_design(E1, D1, 63, 7.5);
  hb_design(E2, D2, 23, 8);
  hb_design(E3, D3, 15, 7.5);

  // 2x upsampler, polyphase: one input sample in, hb_o0 (even) and hb_o1 (odd) out.
  // s[0] = write position, s[1 ..] = the last n inputs, stored twice
  function hb_up(x, s, e, n, m) local(p, q, acc, i)
  (
    p = s[0];
    p = p > 0 ? p - 1 : n - 1;
    s[0] = p;
    q = s + 1 + p;
    q[0] = x;
    q[n] = x;
    acc = 0;
    i = 0;
    loop(n, acc += e[i] * q[i]; i += 1;);
    hb_o0 = acc;
    hb_o1 = q[m];
  );

  // 2x downsampler, polyphase: an even and an odd sample in, one sample out.
  // s[0] = write position, s[1] = position in the odd delay, s[2 ..] = the last n even
  // samples stored twice, then m + 1 odd samples
  function hb_down(v0, v1, s, d, n, m) local(p, q, acc, i, o)
  (
    p = s[0];
    p = p > 0 ? p - 1 : n - 1;
    s[0] = p;
    q = s + 2 + p;
    q[0] = v0;
    q[n] = v0;
    acc = 0;
    i = 0;
    loop(n, acc += d[i] * q[i]; i += 1;);
    o = s + 2 + 2 * n + s[1];
    acc += 0.5 * o[0];
    o[0] = v1;
    s[1] = s[1] < m ? s[1] + 1 : 0;
    acc;
  );

  // per channel: filter states, the sample arrays of each rate, the pad and dry delays
  function ch_init(b)
  (
    this.u1 = b;              // 1 + 64
    this.u2 = b + 65;         // 1 + 24
    this.u3 = b + 90;         // 1 + 16
    this.d1 = b + 107;        // 2 + 64 + 16
    this.d2 = b + 189;        // 2 + 24 + 6
    this.d3 = b + 221;        // 2 + 16 + 4
    this.a0 = b + 243;        // 1
    this.a1 = b + 244;        // 2
    this.a2 = b + 246;        // 4
    this.a3 = b + 250;        // 8
    this.pd = b + 258;        // 8
    this.dr = b + 266;        // 64
  );
  chl.ch_init(128);
  chr.ch_init(512);
  freembuf(896);

  // gain of the clipper's output for a magnitude a above the knee start kt
  function clip_mag(a)
  (
    kw > 0 ? kt + kw * (1 - 2 / (exp(2 * ((a - kt) / kw)) + 1)) : cl;
  );

  os_prev = -1;
  pw = 0;
  dw = 0;
  pdc_bot_ch = 0;
  pdc_top_ch = 2;

@slider
  gin = 10 ^ (slider1 / 20);
  cl = 10 ^ (slider2 / 20);
  kt = cl * (1 - slider3 / 100);
  kw = cl - kt;
  os = slider4;
  mix = slider5 / 100;
  gout = 10 ^ (slider6 / 20);
  link = slider7;
  os < 0.5 ? ( osf = 1; lat = 0; pad = 0; ) :
  os < 1.5 ? ( osf = 2; lat = 31; pad = 0; ) :
  os < 2.5 ? ( osf = 4; lat = 37; pad = 2; ) :
             ( osf = 8; lat = 39; pad = 6; );
  pdc_delay = lat;
  // a new rate starts every filter and delay from silence
  osf != os_prev ? (
    memset(128, 0, 768);
    pw = 0;
    dw = 0;
    os_prev = osf;
  );
  tl = osf > 4 ? chl.a3 : osf > 2 ? chl.a2 : osf > 1 ? chl.a1 : chl.a0;
  tr = osf > 4 ? chr.a3 : osf > 2 ? chr.a2 : osf > 1 ? chr.a1 : chr.a0;

@sample
  xl = spl0 * gin;
  xr = spl1 * gin;

  // up to the clipper's rate
  osf > 1 ? (
    hb_up(xl, chl.u1, E1, 32, 15); chl.a1[0] = hb_o0; chl.a1[1] = hb_o1;
    hb_up(xr, chr.u1, E1, 32, 15); chr.a1[0] = hb_o0; chr.a1[1] = hb_o1;
    osf > 2 ? (
      i = 0;
      loop(2,
        hb_up(chl.a1[i], chl.u2, E2, 12, 5); chl.a2[2 * i] = hb_o0; chl.a2[2 * i + 1] = hb_o1;
        hb_up(chr.a1[i], chr.u2, E2, 12, 5); chr.a2[2 * i] = hb_o0; chr.a2[2 * i + 1] = hb_o1;
        i += 1;
      );
      osf > 4 ? (
        i = 0;
        loop(4,
          hb_up(chl.a2[i], chl.u3, E3, 8, 3); chl.a3[2 * i] = hb_o0; chl.a3[2 * i + 1] = hb_o1;
          hb_up(chr.a2[i], chr.u3, E3, 8, 3); chr.a3[2 * i] = hb_o0; chr.a3[2 * i + 1] = hb_o1;
          i += 1;
        );
      );
    );
  ) : (
    tl[0] = xl;
    tr[0] = xr;
  );

  // pad delay (whole latency in samples) and the clipper, at the top rate
  cg = 1;
  i = 0;
  loop(osf,
    cxl = tl[i];
    cxr = tr[i];
    pad > 0 ? (
      chl.pd[pw] = cxl;
      chr.pd[pw] = cxr;
      j = (pw - pad + 8) % 8;
      cxl = chl.pd[j];
      cxr = chr.pd[j];
      pw = (pw + 1) % 8;
    );
    link < 0.5 ? (
      a = max(abs(cxl), abs(cxr));
      a > kt ? (
        g = clip_mag(a) / a;
        cxl *= g;
        cxr *= g;
        cg = min(cg, g);
      );
    ) : (
      a = abs(cxl);
      a > kt ? (
        g = clip_mag(a) / a;
        cxl *= g;
        cg = min(cg, g);
      );
      a = abs(cxr);
      a > kt ? (
        g = clip_mag(a) / a;
        cxr *= g;
        cg = min(cg, g);
      );
    );
    tl[i] = cxl;
    tr[i] = cxr;
    i += 1;
  );

  // back down to the sample rate
  osf > 1 ? (
    osf > 4 ? (
      i = 0;
      loop(4,
        chl.a2[i] = hb_down(chl.a3[2 * i], chl.a3[2 * i + 1], chl.d3, D3, 8, 3);
        chr.a2[i] = hb_down(chr.a3[2 * i], chr.a3[2 * i + 1], chr.d3, D3, 8, 3);
        i += 1;
      );
    );
    osf > 2 ? (
      i = 0;
      loop(2,
        chl.a1[i] = hb_down(chl.a2[2 * i], chl.a2[2 * i + 1], chl.d2, D2, 12, 5);
        chr.a1[i] = hb_down(chr.a2[2 * i], chr.a2[2 * i + 1], chr.d2, D2, 12, 5);
        i += 1;
      );
    );
    yl = hb_down(chl.a1[0], chl.a1[1], chl.d1, D1, 32, 15);
    yr = hb_down(chr.a1[0], chr.a1[1], chr.d1, D1, 32, 15);
  ) : (
    yl = tl[0];
    yr = tr[0];
  );

  // dry signal delayed by the latency, mix, output
  chl.dr[dw] = spl0;
  chr.dr[dw] = spl1;
  j = (dw - lat + 64) % 64;
  dry_l = chl.dr[j];
  dry_r = chr.dr[j];
  dw = (dw + 1) % 64;
  spl0 = (dry_l * (1 - mix) + yl * mix) * gout;
  spl1 = (dry_r * (1 - mix) + yr * mix) * gout;
