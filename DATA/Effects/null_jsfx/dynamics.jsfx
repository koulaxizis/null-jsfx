desc:NULL Dynamics
author: Christos Koulaxizis
tags: dynamics compressor expander gain reduction ratio threshold knee sidechain parallel bus fet opto upward
//category: Essentials
//NULL JSFX v2.7 • https://nulljsfx.tech • MIT License

slider1:0<0,1,1{Compressor,Expander}>Mode
slider2:-20<-60,0,1>Threshold (dB)
slider3:4<1,20,0.1>Ratio
slider4:6<0,20,1>Knee (dB)
slider5:10<0,200,1>Attack (ms)
slider6:100<0,1000,1>Release (ms)
slider7:0<0,20,1>Makeup (dB)
slider8:0<0,4,1{Clean,Bus,FET,Opto,Upward}>Style
slider9:20<20,500,1:log>Sidechain HPF (Hz)
slider10:100<0,100,1>Mix (%)
slider11:0<0,1,1{Internal,External}>Sidechain
slider12:0<0,2,1{Stereo,Mid,Side}>Channels
slider13:0<0,1,1{Output,Delta}>Listen

in_pin:Left
in_pin:Right
in_pin:Sidechain Left
in_pin:Sidechain Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // Style: Clean = peak detector, gain smoothed with Attack / Release (the original plugin).
  // Bus = crest-corrected RMS detector that partly listens to its own gain reduction (half
  // feedback, slope compensated so the static curve stays where the display draws it), a little
  // extra knee and an auto release: a slow second envelope holds the reduction after sustained
  // compression. FET = peak detector, attack 4x faster, half the knee, and odd-harmonic colour
  // that grows with the gain reduction. Opto = RMS detector, wide knee, program-dependent attack
  // (bigger jumps react faster) and a two-stage release whose slow half gets slower the more
  // reduction there has been. Sidechain HPF filters the detector only (off at 20 Hz); Mix blends
  // the dry signal back in (parallel compression); External listens to pins 3/4.
  // Upward = RMS detector (10 ms) that raises the level instead of lowering it: compressing, what
  // is below Threshold comes up (upward compression; quiet parts louder), expanding, what is above
  // it (upward expansion); at most 24 dB, and compressing, the lift fades out from 48 to 72 dB
  // under Threshold so silence and the noise floor stay down. Attack = how fast the lift falls
  // back when the level rises, Release = how fast it grows.
  // Appended in 2.7: Channels Mid / Side compresses only the mid or the side of the stereo pair
  // (the detector hears that half, or the key), Listen Delta plays what the dynamics take away
  // (or, Upward, add): the input minus the processed signal before Makeup and Mix.
  gain_env = 1;
  ln10 = 2.302585;
  db_to_lin = ln10 / 20;
  gr_db = gr_f = gr_s = gr_o1 = gr_o2 = gr_mem = 0;
  det_ms = 0;
  hp_l1 = hp_l2 = hp_r1 = hp_r2 = 0;

@slider
  mode = slider1;
  threshold_db = slider2;
  ratio = slider3;
  knee_db = slider4;
  attack_ms = slider5;
  release_ms = slider6;
  makeup_db = slider7;
  style = slider8;
  hpf_on = slider9 > 20;
  mix_on = slider10 < 100;
  mix_amt = slider10 / 100;
  sc_ext = slider11 > 0.5;
  ms_mode = slider12;
  listen_delta = slider13;
  
  attack_ms > 0 ? (
    attack_tc = 1 - exp(-1 / (attack_ms * srate / 1000));
  ) : (
    attack_tc = 1;
  );
  
  release_ms > 0 ? (
    release_tc = 1 - exp(-1 / (release_ms * srate / 1000));
  ) : (
    release_tc = 1;
  );

  // gain computer: slope (1 - 1/ratio) and knee, per style
  slope = 1 - 1/ratio;
  kn = knee_db;
  style == 1 ? (
    kn = knee_db + 4;
    mode == 0 ? slope = slope / (1 - 0.5 * slope); // half feedback: steady state = the curve
  );
  style == 2 ? kn = knee_db * 0.5;
  style == 3 ? kn = max(knee_db, 10);
  fet_att = min(1, attack_tc * 4);
  opto_att = attack_tc * 0.5;
  rms_tc = 1 - exp(-1 / ((style == 3 || style == 4 ? 10 : 5) * srate / 1000));
  bus_satt = 1 - exp(-1 / (250 * srate / 1000));
  bus_srel = 1 - exp(-1 / ((200 + 4 * release_ms) * srate / 1000));
  opto_srel = release_tc * 0.1;
  mem_tc = 1 - exp(-1 / srate);

  // detector high-pass: 12 dB/oct (RBJ biquad, Q = 0.7071)
  hpf_on ? (
    hp_w = 2 * $pi * slider9 / srate;
    hp_cs = cos(hp_w);
    hp_al = sin(hp_w) / (2 * sqrt(0.5));
    hp_a0 = 1 + hp_al;
    hp_b0 = (1 + hp_cs) / 2 / hp_a0;
    hp_b1 = -(1 + hp_cs) / hp_a0;
    hp_a1 = -2 * hp_cs / hp_a0;
    hp_a2 = (1 - hp_al) / hp_a0;
  );

@sample
  // Channels Mid / Side: the chosen half of the mid/side pair goes through on both channels,
  // the other waits and is added back after
  ms_mode ? (
    ms_m = (spl0 + spl1) * 0.5;
    ms_s = (spl0 - spl1) * 0.5;
    ms_mode == 1 ? (
      spl0 = spl1 = ms_m;
      ms_o = ms_s;
    ) : (
      spl0 = spl1 = ms_s;
      ms_o = ms_m;
    );
  );
  // detector input: the track, or pins 3/4 (External)
  sc_ext ? (
    det_l = spl2;
    det_r = spl3;
  ) : (
    det_l = spl0;
    det_r = spl1;
  );
  hpf_on ? (
    hp_y = hp_b0 * det_l + hp_l1;
    hp_l1 = hp_b1 * det_l - hp_a1 * hp_y + hp_l2;
    hp_l2 = hp_b0 * det_l - hp_a2 * hp_y;
    det_l = hp_y;
    hp_y = hp_b0 * det_r + hp_r1;
    hp_r1 = hp_b1 * det_r - hp_a1 * hp_y + hp_r2;
    hp_r2 = hp_b0 * det_r - hp_a2 * hp_y;
    det_r = hp_y;
  );
  input_abs = max(abs(det_l), abs(det_r));
  input_abs < 0.000001 ? input_abs = 0.000001;
  (style == 1 || style == 3 || style == 4) ? (
    // crest-corrected RMS (a sine reads its peak)
    det_ms += (input_abs * input_abs - det_ms) * rms_tc;
    det_lv = sqrt(2 * det_ms);
    det_lv < 0.000001 ? det_lv = 0.000001;
    input_db = log(det_lv) / ln10 * 20;
    style == 1 && mode == 0 ? input_db -= 0.5 * gr_db;
  ) : (
    input_db = log(input_abs) / ln10 * 20;
  );
  
  gr_target = 0;
  
  mode == 0 ? (
    // COMPRESSOR: above threshold
    excess = input_db - threshold_db;
    excess > 0 ? (
      kn > 0 && excess < kn ? (
        // quadratic soft knee: the slope rises smoothly from 1 to 1/ratio
        gr_target = slope * excess * excess / (2 * kn);
      ) : (
        gr_target = slope * (excess - kn / 2);
      );
    );
  ) : (
    // EXPANDER: below threshold
    deficit = threshold_db - input_db;
    deficit > 0 ? (
      kn > 0 && deficit < kn ? (
        gr_target = slope * deficit * deficit / (2 * kn);
      ) : (
        gr_target = slope * (deficit - kn / 2);
      );
    );
  );
  style == 4 ? (
    // UPWARD: a lift (negative reduction) below Threshold (Compressor) or above it (Expander)
    up_x = mode == 0 ? threshold_db - input_db : input_db - threshold_db;
    up_t = 0;
    up_x > 0 ? (
      kn > 0 && up_x < kn ? (
        up_t = slope * up_x * up_x / (2 * kn);
      ) : (
        up_t = slope * (up_x - kn / 2);
      );
      up_t = min(up_t, 24);
      mode == 0 && up_x > 48 ? up_t *= max(0, 1 - (up_x - 48) / 24);
    );
    gr_target = -up_t;
  );
  
  style == 0 ? (
    gain_target = exp(-gr_target * db_to_lin);
    
    gain_target < gain_env ? (
      gain_env = gain_env + (gain_target - gain_env) * attack_tc;
    ) : (
      gain_env = gain_env + (gain_target - gain_env) * release_tc;
    );
  ) : (
    // the other styles smooth the gain reduction in dB
    style == 1 ? (
      gr_f += (gr_target - gr_f) * (gr_target > gr_f ? attack_tc : release_tc);
      gr_s += (gr_f - gr_s) * (gr_f > gr_s ? bus_satt : bus_srel);
      gr_db = max(gr_f, gr_s);
    ) : style == 2 ? (
      gr_db += (gr_target - gr_db) * (gr_target > gr_db ? fet_att : release_tc);
    ) : style == 4 ? (
      gr_db += (gr_target - gr_db) * (gr_target > gr_db ? attack_tc : release_tc);
    ) : (
      gr_target > gr_o1 ? (
        gr_o1 += (gr_target - gr_o1) * min(1, opto_att * (1 + (gr_target - gr_o1) / 6));
      ) : (
        gr_o1 += (gr_target - gr_o1) * release_tc;
      );
      gr_target > gr_o2 ? (
        gr_o2 += (gr_target - gr_o2) * min(1, opto_att * (1 + (gr_target - gr_o2) / 6));
      ) : (
        gr_o2 += (gr_target - gr_o2) * opto_srel / (1 + gr_mem / 6);
      );
      gr_db = 0.5 * (gr_o1 + gr_o2);
      gr_mem += (gr_db - gr_mem) * mem_tc;
    );
    gain_env = exp(-gr_db * db_to_lin);
  );
  
  makeup_linear = exp(makeup_db * db_to_lin);
  mix_on || listen_delta ? (
    dry_l = spl0;
    dry_r = spl1;
  );
  style == 2 ? (
    // FET colour: a cubic curve (6 dB of headroom, linear above) on the compressed signal,
    // odd harmonics only, from 3 dB of reduction, full at 18 dB
    fet_amt = 0.5 * min(1, max(0, gr_db - 3) / 15);
    fet_x = spl0 * gain_env * 2;
    abs(fet_x) < 1 ? (
      fet_x -= fet_amt * fet_x * fet_x * fet_x / 3;
    ) : (
      fet_x = sign(fet_x) * (1 - fet_amt / 3) + (fet_x - sign(fet_x)) * (1 - fet_amt);
    );
    spl0 = fet_x * 0.5 * makeup_linear;
    fet_x = spl1 * gain_env * 2;
    abs(fet_x) < 1 ? (
      fet_x -= fet_amt * fet_x * fet_x * fet_x / 3;
    ) : (
      fet_x = sign(fet_x) * (1 - fet_amt / 3) + (fet_x - sign(fet_x)) * (1 - fet_amt);
    );
    spl1 = fet_x * 0.5 * makeup_linear;
  ) : (
    spl0 = spl0 * gain_env * makeup_linear;
    spl1 = spl1 * gain_env * makeup_linear;
  );
  listen_delta ? (
    spl0 = dry_l - spl0 / makeup_linear;
    spl1 = dry_r - spl1 / makeup_linear;
  ) : mix_on ? (
    // parallel compression: the dry signal under the compressed one
    spl0 = dry_l + (spl0 - dry_l) * mix_amt;
    spl1 = dry_r + (spl1 - dry_r) * mix_amt;
  );

  ms_mode ? (
    // back to left / right (Delta: the processed half alone)
    listen_delta ? ms_o = 0;
    ms_mode == 1 ? (
      ms_x = spl0;
      spl0 = ms_x + ms_o;
      spl1 = ms_x - ms_o;
    ) : (
      ms_x = spl0;
      spl0 = ms_o + ms_x;
      spl1 = ms_o - ms_x;
    );
  );
