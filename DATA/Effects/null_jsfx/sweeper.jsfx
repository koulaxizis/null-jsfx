desc:NULL Sweeper
author: Christos Koulaxizis
tags: filter sweep lowpass resonance creative
//category: One Slider
//NULL JSFX v2.0 • https://nulljsfx.tech • MIT License

slider1:50<0,100,1>Amount

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  // DJ-style filter sweep on one knob. 50 = open (no effect). Below 50 a low-pass closes
  // from 20 kHz down to 80 Hz; above 50 a high-pass rises from 20 Hz up to 8 kHz.
  // A little resonance builds up as the filter moves away from the centre.

  // TPT state-variable filter, state in this.ic1 / this.ic2
  function svf(x) local(v1, v2, v3)
  (
    v3 = x - this.ic2;
    v1 = a1 * this.ic1 + a2 * v3;
    v2 = this.ic2 + a2 * this.ic1 + a3 * v3;
    this.ic1 = 2 * v1 - this.ic1;
    this.ic2 = 2 * v2 - this.ic2;
    mode < 0 ? v2 : x - k * v1 - v2;
  );

@slider
  pos = (slider1 - 50) / 50;      // -1 .. +1
  mode = pos < 0 ? -1 : pos > 0 ? 1 : 0;
  d = abs(pos);
  fc = mode < 0 ? 20000 * pow(80 / 20000, d) : 20 * pow(8000 / 20, d);
  fc = min(fc, srate * 0.45);
  q = 0.707 + d * 1.5;
  g = tan($pi * fc / srate);
  k = 1 / q;
  a1 = 1 / (1 + g * (g + k));
  a2 = g * a1;
  a3 = g * a2;

@sample
  mode != 0 ? (
    spl0 = L.svf(spl0);
    spl1 = R.svf(spl1);
  );
