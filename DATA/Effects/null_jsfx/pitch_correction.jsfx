desc:NULL Pitch Correction
author: Christos Koulaxizis
tags: pitch correction auto tune autotune vocal tuning key scale retune hard tune psola midi vibrato
//category: Advanced
//NULL JSFX v2.6 • https://nulljsfx.tech • MIT License

slider1:0<0,11,1{C,C#,D,D#,E,F,F#,G,G#,A,A#,B}>Key
slider2:0<0,8,1{Chromatic,Major,Minor,Harmonic Minor,Pentatonic Major,Pentatonic Minor,Blues,Dorian,Mixolydian}>Scale
slider3:20<0,400,1>Retune Speed (ms)
slider4:20<0,100,1>Humanize (%)
slider5:0<-12,12,1>Transpose (semitones)
slider6:50<0,100,1>Sensitivity (%)
slider7:100<0,100,1>Mix (%)
slider8:0<0,1,1{Scale,MIDI}>Target
slider9:5<0,10,0.1>Vibrato Rate (Hz)
slider10:0<0,100,1>Vibrato Depth (cents)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  // Monophonic vocal tuning. The pitch is tracked with YIN on a mono, band-limited copy
  // decimated to about 11 kHz (70 Hz to 1 kHz, a new estimate every 64 decimated samples);
  // Sensitivity sets the YIN threshold (higher = more of the signal counts as pitched).
  // Each estimate is snapped to the nearest note of Key + Scale (with some hysteresis), and
  // the correction glides there at Retune Speed (0 ms = hard, stepped "robot" tuning).
  // Humanize keeps that share of the fast pitch movement (vibrato) around the note.
  // The shift is TD-PSOLA: analysis marks one input period apart, each on the same peak of
  // the cycle, and synthesis marks one output period apart; every synthesis mark adds the
  // Hann-windowed grain (two periods) around the nearest analysis mark, so the voice keeps
  // its formants. Unvoiced sounds pass with the transpose only. Latency: about 39 ms
  // (the pitch frame plus 1.5 periods of 70 Hz), reported to REAPER; the dry signal is
  // delayed to match.
  // Target MIDI tunes to the latest held MIDI note instead of the scale (with no note held it
  // falls back to Key + Scale); every MIDI message passes through. Vibrato adds a sine
  // vibrato of Vibrato Depth cents at Vibrato Rate to the corrected voice; it fades in over
  // about 0.25 s on every new note (off at Depth 0).
  dec = max(1, floor(srate / 11025 + 0.5));
  fa = srate / dec;
  tmax = ceil(fa / 70);
  tmin = max(2, floor(fa / 1000));
  hop = 64;
  hop_s = (hop * dec) / srate;
  // (EEL2 binds '-' tighter than '+' and '/' tighter than '*': mixed chains are bracketed
  // left to right so that the VST3/CLAP port computes the same doubles)
  hm = ceil(srate / 70);             // longest period, the largest grain half-length
  mlag = tmax * dec + floor((hop * dec) / 2); // age of the pitch estimate (centre of the frame)
  lat = mlag + ceil(1.5 * hm) + 4;
  bs = lat + 2 * hm + 16;            // ring length
  in_l = 0; in_r = bs;               // input rings
  acc_l = 2 * bs; acc_r = 3 * bs;    // output accumulators
  acc_w = 4 * bs;                    // sum of the grain windows
  dbuf = 5 * bs; dbs = 1024;         // decimated analysis ring
  frm = dbuf + dbs;                  // one analysis frame (2 * tmax)
  cmn = frm + 1024;                  // YIN cumulative mean normalised difference
  amk = cmn + 512;                   // ring of the last 64 analysis marks
  lpb = amk + 64;                    // the low-passed mono signal, for the pitch marks
  memset(0, 0, lpb + bs);
  freembuf(lpb + bs);
  pdc_delay = lat;
  pdc_bot_ch = 0;
  pdc_top_ch = 2;

  hold_n = floor(0.06 / hop_s) + 1;  // keep the correction through ~60 ms dropouts
  t_uv = floor(srate / 200);         // grain period for unvoiced sounds
  ln2 = log(2);
  gd = floor(srate * 0.00035 + 0.5); // delay of the analysis low-pass

  // analysis filters: 50 Hz one-pole high-pass, 4th-order Butterworth low-pass at 1.2 kHz
  hp_c = exp((-2 * $pi * 50) / srate);
  lw = (2 * $pi * 1200) / srate;
  lc = cos(lw);
  la = sin(lw) / (2 * 0.5411961);
  b0a = (1 - lc) / 2 / (1 + la); b1a = (1 - lc) / (1 + la);
  a1a = (-2 * lc) / (1 + la); a2a = (1 - la) / (1 + la);
  la = sin(lw) / (2 * 1.3065630);
  b0b = (1 - lc) / 2 / (1 + la); b1b = (1 - lc) / (1 + la);
  a1b = (-2 * lc) / (1 + la); a2b = (1 - la) / (1 + la);
  hp_x = hp_y = 0;
  xa1 = xa2 = ya1 = ya2 = 0;
  xb1 = xb2 = yb1 = yb2 = 0;

  wp = 0; nabs = 0;
  dcnt = 0; dw = 0; hcnt = 0;
  per = per_a = t_uv; am_last = 0; mk = 0; s_next = 0;
  voiced = 0; was_v = 0; uvc = hold_n + 1;
  tf = tmax; det = 0; ms = 0; tgt = 60; sh = sh_a = 0; sh_t = 0;
  // MIDI: when each note 0..127 was pressed (0 = not held), this block's events
  held = lpb + bs;
  evq = held + 128;
  memset(held, 0, 128);
  freembuf(evq + 1024);
  stamp = 0; m_note = -1;
  m_ofs = m_1 = m_2 = m_3 = 0;
  vib_ph = 0; vib_env = 0; vib = 0;
  vib_k = 1 - exp(-1 / (srate * 0.25));

  // YIN on the last 2 * tmax decimated samples: sets voiced and tf (period, decimated samples)
  function analyze() local(i, j, k, t, s, d, e, a, b, c, den, tau)
  (
    j = dw - 2 * tmax;
    j < 0 ? j += dbs;
    i = 0;
    loop(2 * tmax, frm[i] = dbuf[j]; j += 1; j >= dbs ? j = 0; i += 1;);
    e = 0; i = 0;
    loop(tmax, e += frm[i] * frm[i]; i += 1;);
    cmn[0] = 1;
    s = 0; t = 1;
    loop(tmax,
      d = 0; i = 0;
      loop(tmax, k = frm[i] - frm[i + t]; d += k * k; i += 1;);
      s += d;
      cmn[t] = s > 0 ? (d * t) / s : 1;
      t += 1;
    );
    // the first dip under the threshold, followed down to its minimum
    tau = 0; t = tmin;
    while (tau == 0 && t < tmax) (
      cmn[t] < thr ? (
        while (t + 1 < tmax && cmn[t + 1] < cmn[t]) ( t += 1; );
        tau = t;
      );
      t += 1;
    );
    voiced = tau > 0 && e > tmax * 0.00001;
    voiced ? (
      a = cmn[tau - 1]; b = cmn[tau]; c = cmn[tau + 1];
      den = (a - 2 * b) + c;
      tf = den > 0 ? tau + (0.5 * (a - c)) / den : tau;
    );
  );

  // pitch -> target note -> smoothed shift (semitones); keeps the previous hop's values
  function control() local(k, kk, pc, dd, bd, best)
  (
    per_a = per;
    sh_a = sh;
    voiced ? (
      per = min(tf * dec, hm);
      det = 69 + (12 * log(fa / tf / 440)) / ln2;
      best = 0; bd = 100;
      k = floor(det + 0.5) - 6;
      loop(13,
        kk = k - key;
        pc = kk - 12 * floor(kk / 12);
        (smask >> pc) & 1 ? (
          dd = abs(k - det);
          dd < bd ? ( bd = dd; best = k; );
        );
        k += 1;
      );
      // stay on the current note until the pitch is 0.7 semitone from it (chromatic)
      was_v ? (
        kk = tgt - key;
        pc = kk - 12 * floor(kk / 12);
        (((smask >> pc) & 1) && abs(tgt - det) < bd + 0.4) ? best = tgt;
      );
      // Target MIDI: the latest held note
      midi_on && m_note >= 0 ? best = m_note;
      // a new note starts the vibrato from nothing
      (!was_v || best != tgt) ? vib_env = 0;
      (!was_v || best != tgt) ? (ms = det) : (ms += (det - ms) * hum_c);
      tgt = best;
      sh_t = tgt - det - hum * (ms - det);
      was_v = 1;
      uvc = 0;
    ) : (
      uvc += 1;
      uvc > hold_n ? ( was_v = 0; sh_t = 0; per = t_uv; );
    );
    sh += (sh_t - sh) * rk;
  );

  // a voiced analysis mark goes to the highest peak of the low-passed signal within a quarter
  // period of c, so the grains are centred on the same point of every cycle
  function snap(c) local(r, j, j1, k, bj, bk, bv, ym, yp, den)
  (
    r = floor(per / 4);
    j = (floor(c + 0.5) - r) + gd;
    j1 = min(floor(c + 0.5) + r + gd, nabs - 1);
    bj = -1; bk = 0; bv = -1;
    k = (wp + j) - nabs;
    k < 0 ? k += bs;
    loop(j1 - j + 1,
      lpb[k] > bv ? ( bv = lpb[k]; bj = j; bk = k; );
      k += 1; k >= bs ? k = 0;
      j += 1;
    );
    bj < 0 ? c : (
      // between samples: the vertex of the parabola through the peak and its neighbours
      // (only for a true peak, not a slope cut by the window)
      ym = lpb[bk > 0 ? bk - 1 : bs - 1];
      yp = lpb[bk < bs - 1 ? bk + 1 : 0];
      den = ym - 2 * bv + yp;
      den < 0 && ym <= bv && yp <= bv ? (bj - gd) + (0.5 * (ym - yp)) / den : bj - gd;
    );
  );

  // adds the grain for synthesis mark s; returns the output period (next mark distance)
  function place(s) local(t1, h, k, a, c, cnt, d, fr, i0, i1, i, ri, si, s2, w)
  (
    t1 = vib_d > 0 ? per_i / 2 ^ (((sh_i + transp) + vib) / 12) : per_i / 2 ^ ((sh_i + transp) / 12);
    h = min(max(per_i, t1), hm);
    // the analysis mark nearest to s, walking back from the newest
    k = mk; c = amk[k]; cnt = 0;
    while (c > s && cnt < 63) (
      k -= 1;
      k < 0 ? k += 64;
      a = amk[k];
      a <= s ? (
        s - a <= c - s ? c = a;
        cnt = 63;
      ) : (
        c = a;
        cnt += 1;
      );
    );
    abs(c - s) > hm ? c = s;
    // the grain is read at s + (c - s), between samples: linear interpolation
    d = floor(c - s);
    fr = c - s - d;
    i0 = ceil(s - h); i1 = floor(s + h);
    ri = (wp + i0) - nabs;
    ri < 0 ? ri += bs;
    si = ri + d;
    si < 0 ? (si += bs) : si >= bs ? (si -= bs);
    s2 = si + 1;
    s2 >= bs ? s2 = 0;
    i = i0;
    loop(i1 - i0 + 1,
      w = 0.5 + 0.5 * cos(($pi * (i - s)) / h);
      acc_l[ri] += w * (in_l[si] + (in_l[s2] - in_l[si]) * fr);
      acc_r[ri] += w * (in_r[si] + (in_r[s2] - in_r[si]) * fr);
      acc_w[ri] += w;
      ri += 1; ri >= bs ? ri = 0;
      si = s2;
      s2 += 1; s2 >= bs ? s2 = 0;
      i += 1;
    );
    t1;
  );

@slider
  key = slider1;
  smask = slider2 == 0 ? 4095 : slider2 == 1 ? 2741 : slider2 == 2 ? 1453 : slider2 == 3 ? 2477 :
          slider2 == 4 ? 661 : slider2 == 5 ? 1193 : slider2 == 6 ? 1257 : slider2 == 7 ? 1709 : 1717;
  rk = slider3 > 0 ? 1 - exp((-hop_s * 1000) / slider3) : 1;
  hum = slider4 / 100;
  hum_c = 1 - exp(-hop_s / 0.15);
  transp = slider5;
  thr = 0.05 + (0.3 * slider6) / 100;
  mix = slider7 / 100;
  midi_on = slider8 >= 0.5;
  vib_w = ((2 * $pi) * slider9) / srate;
  vib_d = slider10 / 100;

@block
  // MIDI: every message passes through; notes are applied at their offsets in @sample
  mq_n = 0;
  while (midirecv(m_ofs, m_1, m_2, m_3)) (
    midisend(m_ofs, m_1, m_2, m_3);
    mq_n < 256 ? (
      evq[mq_n * 4] = m_ofs;
      evq[mq_n * 4 + 1] = m_1;
      evq[mq_n * 4 + 2] = m_2;
      evq[mq_n * 4 + 3] = m_3;
      mq_n += 1;
    );
  );
  mq_i = 0;
  si = 0;

@sample
  // MIDI notes due now: held / released, all notes off; the latest held note is m_note
  while (mq_i < mq_n && evq[mq_i * 4] <= si) (
    m_st = evq[mq_i * 4 + 1] & 0xF0;
    m_n = evq[mq_i * 4 + 2];
    m_st == 0x90 && evq[mq_i * 4 + 3] > 0 ? (
      stamp += 1;
      held[m_n] = stamp;
    ) : m_st == 0x80 || m_st == 0x90 ? (
      held[m_n] = 0;
    ) : m_st == 0xB0 && (m_n == 120 || m_n == 123) ? (
      memset(held, 0, 128);
    );
    m_note = -1;
    m_b = 0;
    m_k = 0;
    loop(128,
      held[m_k] > m_b ? ( m_b = held[m_k]; m_note = m_k; );
      m_k += 1;
    );
    mq_i += 1;
  );
  si += 1;
  // vibrato, faded in while a voiced note is corrected
  vib_d > 0 ? (
    vib_ph += vib_w;
    vib_ph >= 2 * $pi ? vib_ph -= 2 * $pi;
    vib_env += (was_v - vib_env) * vib_k;
    vib = (vib_d * vib_env) * sin(vib_ph);
  );

  // pitch tracking on a band-limited mono copy, decimated
  ax = (spl0 + spl1) * 0.5;
  hp_y = hp_c * ((hp_y + ax) - hp_x);
  hp_x = ax;
  abs(hp_y) < 0.000000000000000000000000000001 ? hp_y = 0;
  ya = (b0a * hp_y + b1a * xa1 + b0a * xa2) - a1a * ya1 - a2a * ya2;
  abs(ya) < 0.000000000000000000000000000001 ? ya = 0;
  xa2 = xa1; xa1 = hp_y; ya2 = ya1; ya1 = ya;
  yb = (b0b * ya + b1b * xb1 + b0b * xb2) - a1b * yb1 - a2b * yb2;
  abs(yb) < 0.000000000000000000000000000001 ? yb = 0;
  xb2 = xb1; xb1 = ya; yb2 = yb1; yb1 = yb;
  (dcnt += 1) >= dec ? (
    dcnt = 0;
    dbuf[dw] = yb;
    dw += 1;
    dw >= dbs ? dw = 0;
    (hcnt += 1) >= hop ? (
      hcnt = 0;
      analyze();
      control();
    );
  );

  // the grains are older than the pitch estimate: use the shift one hop late, interpolated
  // across the hop
  hph = (hcnt * dec + dcnt) / (hop * dec);
  per_i = per_a + (per - per_a) * hph;
  sh_i = sh_a + (sh - sh_a) * hph;
  in_l[wp] = spl0;
  in_r[wp] = spl1;
  lpb[wp] = yb;
  // analysis marks one input period apart, as far as the pitch estimate reaches
  while (am_last <= nabs - mlag) (
    am_last += per;
    was_v ? am_last = snap(am_last);
    mk += 1;
    mk >= 64 ? mk = 0;
    amk[mk] = am_last;
  );
  // synthesis marks one output period apart, placed one grain ahead of the output
  while (s_next - nabs <= (hm + 1) - lat) ( s_next += place(s_next); );

  ro = wp - lat;
  ro < 0 ? ro += bs;
  wv = max(acc_w[ro], 0.5);
  wet_l = acc_l[ro] / wv;
  wet_r = acc_r[ro] / wv;
  acc_l[ro] = 0; acc_r[ro] = 0; acc_w[ro] = 0;
  dry_l = in_l[ro];
  dry_r = in_r[ro];
  wp += 1;
  wp >= bs ? wp = 0;
  nabs += 1;

  spl0 = dry_l * (1 - mix) + wet_l * mix;
  spl1 = dry_r * (1 - mix) + wet_r * mix;
