desc:NULL Gate
author: Christos Koulaxizis
tags: gate noise vocal floor reduce silence threshold mute sidechain hold lookahead ducking
//category: Essentials
//NULL JSFX v2.4 • https://nulljsfx.tech • MIT License

slider1:-40<-60,0,0.1>Threshold (dB)
slider2:10<1,100,1>Attack (ms)
slider3:200<50,1000,1>Release (ms)
slider4:0<0,500,1>Sidechain HPF (Hz)
slider5:-80<-80,0,0.1>Range (dB)
slider6:0<0,500,1>Hold (ms)
slider7:0<0,10,0.1>Lookahead (ms)
slider8:0<0,1,1{Internal,External}>Sidechain
slider9:20000<1000,20000,1:log>Sidechain LPF (Hz)
slider10:0<0,1,1{Off,On}>Flip

in_pin:Left
in_pin:Right
in_pin:Sidechain Left
in_pin:Sidechain Right
out_pin:Left
out_pin:Right

@init
  pk_decay = exp(-1 / (0.0045 * srate)); // peak-envelope fall, 4.5 ms at any sample rate
  threshold_db = -40;
  attack_ms = 10;
  release_ms = 200;
  sc_hpf = 0;
  
  threshold_lin = pow(10, threshold_db / 20);
  
  attack_time = srate * attack_ms / 1000;
  release_time = srate * release_ms / 1000;
  
  at = attack_time > 1 ? attack_time : 1;
  rt = release_time > 1 ? release_time : 1;
  
  attack_coef = 1 - exp(-1 / at);
  release_coef = 1 - exp(-1 / rt);
  
  gate_level = 0;
  env_peak_l = 0;
  env_peak_r = 0;
  sc_lpf_l = 0;
  sc_lpf_r = 0;
  sc_lpf_coef = 0;
  // Hold keeps the gate open that long after the level falls below Threshold; Lookahead delays
  // the audio (not the detector) so the gate opens before the hit (reported as latency);
  // External listens to pins 3/4; Sidechain LPF low-passes the detector (off at 20 kHz);
  // Flip turns the gate into a ducker (the signal goes down to Range above Threshold).
  hold_n = 0;
  sc_lp_l = sc_lp_r = 0;
  la_buf = 0;
  la_size = floor(0.01 * srate) + 2;   // up to 10 ms, per channel, from memory 0
  memset(la_buf, 0, 2 * la_size);
  la_pos = 0;
  pdc_bot_ch = 0;
  pdc_top_ch = 2;

@slider
  threshold_db = slider1;
  attack_ms = slider2;
  release_ms = slider3;
  sc_hpf = slider4;
  // Range: gain when the gate is closed (-80 dB = fully closed, 0 dB = no gating)
  range_lin = slider5 <= -80 ? 0 : 10 ^ (slider5 / 20);
  
  threshold_lin = pow(10, threshold_db / 20);
  
  attack_time = srate * attack_ms / 1000;
  release_time = srate * release_ms / 1000;
  
  at = attack_time > 1 ? attack_time : 1;
  rt = release_time > 1 ? release_time : 1;
  
  attack_coef = 1 - exp(-1 / at);
  release_coef = 1 - exp(-1 / rt);
  
  sc_hpf > 0 ? (
    sc_lpf_coef = 1 - exp(-2 * 3.14159265358979 * sc_hpf / srate);
  );

  hold_s = floor(slider6 * srate / 1000 + 0.5);
  la_n = floor(slider7 * srate / 1000 + 0.5);
  pdc_delay = la_n;
  sc_ext = slider8 >= 0.5;
  sc_lp_on = slider9 < 20000;
  sc_lp_on ? sc_lp_coef = 1 - exp(-2 * $pi * slider9 / srate);
  flip = slider10 >= 0.5;

@sample
  // detector input: the track, or pins 3/4 (External)
  sc_ext ? (
    key_l = spl2;
    key_r = spl3;
  ) : (
    key_l = spl0;
    key_r = spl1;
  );
  sc_hpf > 0 ? (
    sc_lpf_l = sc_lpf_l + sc_lpf_coef * (key_l - sc_lpf_l);
    sc_lpf_r = sc_lpf_r + sc_lpf_coef * (key_r - sc_lpf_r);
    input_l = key_l - sc_lpf_l;
    input_r = key_r - sc_lpf_r;
  ) : (
    input_l = key_l;
    input_r = key_r;
  );
  sc_lp_on ? (
    sc_lp_l = sc_lp_l + sc_lp_coef * (input_l - sc_lp_l);
    sc_lp_r = sc_lp_r + sc_lp_coef * (input_r - sc_lp_r);
    input_l = sc_lp_l;
    input_r = sc_lp_r;
  );
  
  abs_l = input_l < 0 ? -input_l : input_l;
  abs_r = input_r < 0 ? -input_r : input_r;
  
  decay_l = env_peak_l * pk_decay;
  decay_r = env_peak_r * pk_decay;
  env_peak_l = abs_l > decay_l ? abs_l : decay_l;
  env_peak_r = abs_r > decay_r ? abs_r : decay_r;
  
  env_detected = env_peak_l > env_peak_r ? env_peak_l : env_peak_r;
  
  trig = env_detected > threshold_lin;
  hold_s > 0 ? (
    trig ? (
      hold_n = hold_s;
    ) : hold_n > 0 ? (
      hold_n -= 1;
      trig = 1;
    );
  );
  
  trig ? (
    gate_level < 1 ? gate_level = gate_level + attack_coef * (1 - gate_level);
  ) : (
    gate_level > 0 ? gate_level = gate_level + release_coef * (0 - gate_level);
  );
  
  gate_gain = range_lin + (1 - range_lin) * (flip ? 1 - gate_level : gate_level);
  la_buf[la_pos] = spl0;
  la_buf[la_size + la_pos] = spl1;
  la_n > 0 ? (
    la_k = la_pos - la_n;
    la_k < 0 ? la_k += la_size;
    spl0 = la_buf[la_k];
    spl1 = la_buf[la_size + la_k];
  );
  (la_pos += 1) >= la_size ? la_pos = 0;
  spl0 = spl0 * gate_gain;
  spl1 = spl1 * gate_gain;
