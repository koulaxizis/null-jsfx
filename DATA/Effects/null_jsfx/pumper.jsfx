desc:NULL Pumper
author: Christos Koulaxizis
tags: sidechain ducking pumping rhythm groove
//category: One Slider
//NULL JSFX v2.0 • https://nulljsfx.tech • MIT License

slider1:50<0,100,1>Amount

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  phase = 0;

@slider
  amount = slider1 / 100;
  rate = 2.0;

@sample
  phase += rate / srate;
  phase >= 1 ? phase -= 1;
  
  phase < 0.15 ? (
    dip = 1 - phase / 0.15;
  ) : (
    dip = (phase - 0.15) / 0.85;
  );
  
  gain = 1 - amount * (1 - dip);
  
  spl0 = spl0 * gain;
  spl1 = spl1 * gain;
