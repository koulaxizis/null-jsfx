desc:NULL Harmonizer
author: Christos Koulaxizis
tags: harmonizer harmony pitch shift voices interval thirds fifths octave backing vocals scale diatonic key midi formant psola
//category: Advanced
//NULL JSFX v2.9 • https://nulljsfx.tech • MIT License

slider1:4<-12,12,1>Voice 1 Interval (semitones)
slider2:7<-12,12,1>Voice 2 Interval (semitones)
slider3:-6<-48,0,0.5>Voice 1 Level (dB)
slider4:-6<-48,0,0.5>Voice 2 Level (dB)
slider5:8<0,30,0.5>Detune (cents)
slider6:15<0,80,1>Delay (ms)
slider7:70<0,100,1>Spread (%)
slider8:50<0,100,1>Mix (%)
slider9:0<0,2,1{Semitones,Scale,MIDI}>Mode
slider10:0<0,11,1{C,C#,D,D#,E,F,F#,G,G#,A,A#,B}>Key
slider11:0<0,6,1{Major,Minor,Dorian,Mixolydian,Harmonic Minor,Pentatonic Major,Pentatonic Minor}>Scale
slider12:0<0,1,1{Off,On}>Formant Preserve

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // Adds two pitch-shifted copies of the input at fixed intervals (e.g. +4 and +7 =
  // a major chord). Each voice is slightly detuned and delayed so it sounds like a
  // separate performer, and Spread pans voice 1 left and voice 2 right.
  // Mix is an equal-power dry/wet crossfade: 0% = original only, 50% = original and
  // harmony each at -3 dB (constant loudness), 100% = harmony voices only (for
  // printing the harmony to its own track).
  win = floor(srate * 0.05);
  buf_size = ceil(srate * 0.2) + win;
  buf = 0;
  memset(buf, 0, buf_size);
  freembuf(buf + buf_size);
  wpos = 0;

  function tap(d) local(rp, i, f, i2)
  (
    rp = wpos - d;
    rp < 0 ? rp += buf_size;
    i = floor(rp); f = rp - i;
    i2 = i + 1; i2 >= buf_size ? i2 = 0;
    buf[i] + (buf[i2] - buf[i]) * f;
  );
  // two-tap crossfading pitch shifter, state in this.ph
  function voice(ratio, base) local(p2, g)
  (
    this.ph += (1 - ratio) / win;
    this.ph >= 1 ? this.ph -= 1;
    this.ph < 0 ? this.ph += 1;
    p2 = this.ph + 0.5; p2 >= 1 ? p2 -= 1;
    g = 0.5 - 0.5 * cos(2 * $pi * this.ph);
    tap(base + 1 + this.ph * win) * g + tap(base + 1 + p2 * win) * (1 - g);
  );

  // Mode Scale and MIDI and Formant Preserve track the input pitch as pitch_correction.jsfx
  // does (YIN on a band-limited mono copy decimated to about 11 kHz, 70 Hz to 1 kHz, a new
  // estimate every 64 decimated samples). Scale: Voice 1/2 Interval count degrees of Key +
  // Scale from the sung note (snapped to the scale, with hysteresis), so +2 is the third and
  // +4 the fifth above in the key; the voices keep the singer's own intonation, and unpitched
  // sound keeps the last intervals. MIDI: voice 1 sings the latest held MIDI note and voice 2
  // the one held before it (the Interval sliders are ignored, Detune still applies); a voice
  // without a note fades out, and every MIDI message passes through. The voices glide to a
  // new interval in about 10 ms. Formant Preserve shifts the voices with TD-PSOLA instead
  // (pitch-synchronous two-period grains, as pitch_correction.jsfx), which keeps the vowels
  // natural; the voices then come about 39 ms later (the pitch frame plus 1.5 periods of
  // 70 Hz), on top of Delay.
  // (EEL2 binds '-' tighter than '+' and '/' tighter than '*': mixed chains are bracketed
  // left to right so that the VST3/CLAP port computes the same doubles)
  dec = max(1, floor(srate / 11025 + 0.5));
  fa = srate / dec;
  tmax = ceil(fa / 70);
  tmin = max(2, floor(fa / 1000));
  hop = 64;
  hop_s = (hop * dec) / srate;
  hm = ceil(srate / 70);             // longest period, the largest grain half-length
  mlag = tmax * dec + floor((hop * dec) / 2);
  lat = mlag + ceil(1.5 * hm) + 4;
  bs = lat + ceil(srate * 0.1096) + 2 * hm + 20; // rings, with the longest Delay (80 ms x 1.37)
  in_m = buf_size;                   // mono input ring
  acc1 = in_m + bs; acc2 = acc1 + bs; // PSOLA output accumulators, per voice
  aw1 = acc2 + bs; aw2 = aw1 + bs;   // sums of their grain windows
  lpb = aw2 + bs;                    // the low-passed mono signal, for the pitch marks
  dbuf = lpb + bs; dbs = 1024;       // decimated analysis ring
  frm = dbuf + dbs;                  // one analysis frame (2 * tmax)
  cmn = frm + 1024;                  // YIN cumulative mean normalised difference
  amk = cmn + 512;                   // ring of the last 64 analysis marks
  held = amk + 64;                   // MIDI: when each note was pressed (0 = not held)
  evq = held + 128;                  // this block's MIDI events
  memset(in_m, 0, evq + 1024 - in_m);
  freembuf(evq + 1024);

  hold_n = floor(0.06 / hop_s) + 1;  // keep the intervals through ~60 ms dropouts
  t_uv = floor(srate / 200);         // grain period for unvoiced sounds
  ln2 = log(2);
  gd = floor(srate * 0.00035 + 0.5); // delay of the analysis low-pass
  thr = 0.2;                         // YIN threshold (pitch_correction's Sensitivity 50%)
  hp_c = exp((-2 * $pi * 50) / srate);
  lw = (2 * $pi * 1200) / srate;
  lc = cos(lw);
  la = sin(lw) / (2 * 0.5411961);
  b0a = (1 - lc) / 2 / (1 + la); b1a = (1 - lc) / (1 + la);
  a1a = (-2 * lc) / (1 + la); a2a = (1 - la) / (1 + la);
  la = sin(lw) / (2 * 1.3065630);
  b0b = (1 - lc) / 2 / (1 + la); b1b = (1 - lc) / (1 + la);
  a1b = (-2 * lc) / (1 + la); a2b = (1 - la) / (1 + la);
  hp_x = hp_y = 0;
  xa1 = xa2 = ya1 = ya2 = 0;
  xb1 = xb2 = yb1 = yb2 = 0;
  wp = 0; nabs = 0;
  dcnt = 0; dw = 0; hcnt = 0;
  per = per_a = per_i = t_uv; am_last = 0; mk = 0; sn1 = sn2 = 0;
  voiced = 0; was_v = 0; uvc = hold_n + 1;
  tf = tmax; det = 60; cur = -1;
  ht1 = ht2 = hs1 = hs2 = 0; hgt1 = hgt2 = hg1 = hg2 = 0; hs_new = 1;
  hk = 1 - exp(-1 / (srate * 0.01)); // the voices' 10 ms glide
  stamp = 0; mn1 = mn2 = -1;
  m_ofs = m_1 = m_2 = m_3 = 0;

  // YIN on the last 2 * tmax decimated samples: sets voiced and tf (period, decimated samples)
  function analyze() local(i, j, k, t, s, d, e, a, b, c, den, tau)
  (
    j = dw - 2 * tmax;
    j < 0 ? j += dbs;
    i = 0;
    loop(2 * tmax, frm[i] = dbuf[j]; j += 1; j >= dbs ? j = 0; i += 1;);
    e = 0; i = 0;
    loop(tmax, e += frm[i] * frm[i]; i += 1;);
    cmn[0] = 1;
    s = 0; t = 1;
    loop(tmax,
      d = 0; i = 0;
      loop(tmax, k = frm[i] - frm[i + t]; d += k * k; i += 1;);
      s += d;
      cmn[t] = s > 0 ? (d * t) / s : 1;
      t += 1;
    );
    // the first dip under the threshold, followed down to its minimum
    tau = 0; t = tmin;
    while (tau == 0 && t < tmax) (
      cmn[t] < thr ? (
        while (t + 1 < tmax && cmn[t + 1] < cmn[t]) ( t += 1; );
        tau = t;
      );
      t += 1;
    );
    voiced = tau > 0 && e > tmax * 0.00001;
    voiced ? (
      a = cmn[tau - 1]; b = cmn[tau]; c = cmn[tau + 1];
      den = (a - 2 * b) + c;
      tf = den > 0 ? tau + (0.5 * (a - c)) / den : tau;
    );
  );

  // is note k in Key + Scale?
  function in_sc(k) local(kk)
  (
    kk = k - hkey;
    (hmask >> (kk - 12 * floor(kk / 12))) & 1;
  );

  // the note n scale degrees from note k
  function deg(k, n) local(c, d)
  (
    c = abs(n);
    d = n < 0 ? -1 : 1;
    while (c > 0) (
      k += d;
      in_sc(k) ? c -= 1;
    );
    k;
  );

  // Mode Scale: the voices' intervals (semitones, Detune included) from the current note
  function set_iv()
  (
    ht1 = (deg(cur, slider1) - cur) + slider5 / 100;
    ht2 = (deg(cur, slider2) - cur) - slider5 / 100;
  );

  // Mode MIDI: voice 1 sings the latest held note, voice 2 the one held before it
  function midi_iv() local(k, b1, b2)
  (
    mn1 = mn2 = -1;
    b1 = b2 = 0;
    k = 0;
    loop(128,
      held[k] > b1 ? (
        b2 = b1; mn2 = mn1;
        b1 = held[k]; mn1 = k;
      ) : held[k] > b2 ? (
        b2 = held[k]; mn2 = k;
      );
      k += 1;
    );
    hgt1 = mn1 >= 0;
    hgt2 = mn2 >= 0;
    mn1 >= 0 ? ht1 = max(-36, min(36, mn1 - det)) + slider5 / 100;
    mn2 >= 0 ? ht2 = max(-36, min(36, mn2 - det)) - slider5 / 100;
  );

  // pitch -> period for the marks, and the intervals of Mode Scale and MIDI
  function control() local(k, dd, bd, best)
  (
    per_a = per;
    voiced ? (
      per = min(tf * dec, hm);
      det = 69 + (12 * log(fa / tf / 440)) / ln2;
      hmode == 1 ? (
        best = 0; bd = 100;
        k = floor(det + 0.5) - 6;
        loop(13,
          in_sc(k) ? (
            dd = abs(k - det);
            dd < bd ? ( bd = dd; best = k; );
          );
          k += 1;
        );
        // stay on the current note until the pitch is 0.7 semitone from it (chromatic)
        was_v && in_sc(cur) && abs(cur - det) < bd + 0.4 ? best = cur;
        cur = best;
        set_iv();
      );
      hmode == 2 ? midi_iv();
      was_v = 1;
      uvc = 0;
    ) : (
      uvc += 1;
      uvc > hold_n ? ( was_v = 0; per = t_uv; );
    );
  );

  // a voiced analysis mark goes to the highest peak of the low-passed signal within a quarter
  // period of c, so the grains are centred on the same point of every cycle
  function snap(c) local(r, j, j1, k, bj, bk, bv, ym, yp, den)
  (
    r = floor(per / 4);
    j = (floor(c + 0.5) - r) + gd;
    j1 = min(floor(c + 0.5) + r + gd, nabs - 1);
    bj = -1; bk = 0; bv = -1;
    k = (wp + j) - nabs;
    k < 0 ? k += bs;
    loop(j1 - j + 1,
      lpb[k] > bv ? ( bv = lpb[k]; bj = j; bk = k; );
      k += 1; k >= bs ? k = 0;
      j += 1;
    );
    bj < 0 ? c : (
      ym = lpb[bk > 0 ? bk - 1 : bs - 1];
      yp = lpb[bk < bs - 1 ? bk + 1 : 0];
      den = ym - 2 * bv + yp;
      den < 0 && ym <= bv && yp <= bv ? (bj - gd) + (0.5 * (ym - yp)) / den : bj - gd;
    );
  );

  // adds a voice's grain for synthesis mark s, shifted by sh semitones, into its accumulator
  // ac and window sum aw; returns the output period (next mark distance)
  function place(s, sh, ac, aw) local(t1, h, k, a, c, cnt, d, fr, i0, i1, i, ri, si, s2, w)
  (
    t1 = per_i / 2 ^ (sh / 12);
    h = min(max(per_i, t1), hm);
    // the analysis mark nearest to s, walking back from the newest
    k = mk; c = amk[k]; cnt = 0;
    while (c > s && cnt < 63) (
      k -= 1;
      k < 0 ? k += 64;
      a = amk[k];
      a <= s ? (
        s - a <= c - s ? c = a;
        cnt = 63;
      ) : (
        c = a;
        cnt += 1;
      );
    );
    abs(c - s) > hm ? c = s;
    d = floor(c - s);
    fr = c - s - d;
    i0 = ceil(s - h); i1 = floor(s + h);
    ri = (wp + i0) - nabs;
    ri < 0 ? ri += bs;
    si = ri + d;
    si < 0 ? (si += bs) : si >= bs ? (si -= bs);
    s2 = si + 1;
    s2 >= bs ? s2 = 0;
    i = i0;
    loop(i1 - i0 + 1,
      w = 0.5 + 0.5 * cos(($pi * (i - s)) / h);
      ac[ri] += w * (in_m[si] + (in_m[s2] - in_m[si]) * fr);
      aw[ri] += w;
      ri += 1; ri >= bs ? ri = 0;
      si = s2;
      s2 += 1; s2 >= bs ? s2 = 0;
      i += 1;
    );
    t1;
  );

@slider
  r1 = 2 ^ ((slider1 + slider5 / 100) / 12);
  r2 = 2 ^ ((slider2 - slider5 / 100) / 12);
  g1 = 10 ^ (slider3 / 20);
  g2 = 10 ^ (slider4 / 20);
  base1 = slider6 * srate / 1000;
  base2 = slider6 * 1.37 * srate / 1000;
  sp = slider7 / 100;
  dry_g = cos(slider8 / 100 * $pi / 2);
  wet_g = sin(slider8 / 100 * $pi / 2);
  hmode = slider9;
  hkey = slider10;
  hmask = slider11 == 0 ? 2741 : slider11 == 1 ? 1453 : slider11 == 2 ? 1709 : slider11 == 3 ? 1717 :
          slider11 == 4 ? 2477 : slider11 == 5 ? 661 : 1193;
  fmt = slider12 >= 0.5;
  adv = hmode > 0 || fmt;
  fb1 = floor(base1 + 0.5);
  fb2 = floor(base2 + 0.5);
  hmode == 1 ? (
    cur < 0 ? cur = 60 + hkey;
    set_iv();
    hgt1 = hgt2 = 1;
  ) : hmode == 2 ? (
    midi_iv();
  ) : (
    ht1 = slider1 + slider5 / 100;
    ht2 = slider2 - slider5 / 100;
    hgt1 = hgt2 = 1;
  );

@block
  // MIDI: every message passes through; notes are applied at their offsets in @sample
  mq_n = 0;
  while (midirecv(m_ofs, m_1, m_2, m_3)) (
    midisend(m_ofs, m_1, m_2, m_3);
    mq_n < 256 ? (
      evq[mq_n * 4] = m_ofs;
      evq[mq_n * 4 + 1] = m_1;
      evq[mq_n * 4 + 2] = m_2;
      evq[mq_n * 4 + 3] = m_3;
      mq_n += 1;
    );
  );
  mq_i = 0;
  si = 0;

@sample
  // MIDI notes due now: held / released, all notes off
  while (mq_i < mq_n && evq[mq_i * 4] <= si) (
    m_st = evq[mq_i * 4 + 1] & 0xF0;
    m_n = evq[mq_i * 4 + 2];
    m_st == 0x90 && evq[mq_i * 4 + 3] > 0 ? (
      stamp += 1;
      held[m_n] = stamp;
    ) : m_st == 0x80 || m_st == 0x90 ? (
      held[m_n] = 0;
    ) : m_st == 0xB0 && (m_n == 120 || m_n == 123) ? (
      memset(held, 0, 128);
    );
    hmode == 2 ? midi_iv();
    mq_i += 1;
  );
  si += 1;

  buf[wpos] = (spl0 + spl1) * 0.5;
  adv ? (
    // pitch tracking on a band-limited mono copy, decimated (as pitch_correction.jsfx)
    ax = (spl0 + spl1) * 0.5;
    hp_y = hp_c * ((hp_y + ax) - hp_x);
    hp_x = ax;
    abs(hp_y) < 0.000000000000000000000000000001 ? hp_y = 0;
    ya = (b0a * hp_y + b1a * xa1 + b0a * xa2) - a1a * ya1 - a2a * ya2;
    abs(ya) < 0.000000000000000000000000000001 ? ya = 0;
    xa2 = xa1; xa1 = hp_y; ya2 = ya1; ya1 = ya;
    yb = (b0b * ya + b1b * xb1 + b0b * xb2) - a1b * yb1 - a2b * yb2;
    abs(yb) < 0.000000000000000000000000000001 ? yb = 0;
    xb2 = xb1; xb1 = ya; yb2 = yb1; yb1 = yb;
    (dcnt += 1) >= dec ? (
      dcnt = 0;
      dbuf[dw] = yb;
      dw += 1;
      dw >= dbs ? dw = 0;
      (hcnt += 1) >= hop ? (
        hcnt = 0;
        analyze();
        control();
      );
    );
    hph = (hcnt * dec + dcnt) / (hop * dec);
    per_i = per_a + (per - per_a) * hph;
    // the voices glide to their intervals (and, in Mode MIDI, fade in and out)
    hs_new ? ( hs1 = ht1; hs2 = ht2; hs_new = 0; );
    hs1 += (ht1 - hs1) * hk;
    hs2 += (ht2 - hs2) * hk;
    hg1 += (hgt1 - hg1) * hk;
    hg2 += (hgt2 - hg2) * hk;
    // PSOLA: analysis marks one input period apart, synthesis marks one output period apart
    in_m[wp] = ax;
    lpb[wp] = yb;
    while (am_last <= nabs - mlag) (
      am_last += per;
      was_v ? am_last = snap(am_last);
      mk += 1;
      mk >= 64 ? mk = 0;
      amk[mk] = am_last;
    );
    while (sn1 - nabs <= (hm + 1) - lat) ( sn1 += place(sn1, hs1, acc1, aw1); );
    while (sn2 - nabs <= (hm + 1) - lat) ( sn2 += place(sn2, hs2, acc2, aw2); );
    ro = wp - lat - fb1;
    ro < 0 ? ro += bs;
    f1 = acc1[ro] / max(aw1[ro], 0.5);
    acc1[ro] = 0; aw1[ro] = 0;
    ro = wp - lat - fb2;
    ro < 0 ? ro += bs;
    f2 = acc2[ro] / max(aw2[ro], 0.5);
    acc2[ro] = 0; aw2[ro] = 0;
    wp += 1;
    wp >= bs ? wp = 0;
    nabs += 1;
    fmt ? (
      v1 = f1 * (g1 * hg1);
      v2 = f2 * (g2 * hg2);
    ) : (
      v1 = v1s.voice(2 ^ (hs1 / 12), base1) * (g1 * hg1);
      v2 = v2s.voice(2 ^ (hs2 / 12), base2) * (g2 * hg2);
    );
  ) : (
    v1 = v1s.voice(r1, base1) * g1;
    v2 = v2s.voice(r2, base2) * g2;
  );
  wpos += 1;
  wpos >= buf_size ? wpos = 0;
  // equal-power panning: Spread 0 = both centred, 100 = voice 1 left, voice 2 right
  p1 = $pi / 4 * (1 - sp);
  p2 = $pi / 2 - p1;
  w_l = v1 * cos(p1) + v2 * cos(p2);
  w_r = v1 * sin(p1) + v2 * sin(p2);
  spl0 = spl0 * dry_g + w_l * wet_g;
  spl1 = spl1 * dry_g + w_r * wet_g;
