desc:NULL Reverser
author: Christos Koulaxizis
tags: reverse buffer playback realtime backwards filter
//category: Advanced
//NULL JSFX v2.0 • https://nulljsfx.tech • MIT License

slider1:2<1,10,0.1>Buffer Length (s)
slider2:0<0,3,1{Off,LP,BP,HP}>Filter
slider3:2000<100,20000,100>Filter Freq (Hz)
slider4:50<0,100,1>Mix (%)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
max_buf = srate * 10;
buf_l = 0;
buf_r = max_buf;
write_pos = 0;
read_pos = 0;
fa0 = 1; fa1 = 0; fa2 = 0;
fb0 = 1; fb1 = 0; fb2 = 0;
fx1 = 0; fx2 = 0; fy1 = 0; fy2 = 0;

memset(buf_l, 0, 2 * max_buf);
freembuf(buf_r + max_buf);

@slider
cur_buf_size = (srate * slider1) | 0;
cur_buf_size < 1 ? cur_buf_size = 1;
write_pos = write_pos % cur_buf_size;
read_pos = read_pos % cur_buf_size;
mix = slider4 / 100;

filt_mode = slider2;
filt_freq = slider3;

freq = filt_freq;
omega = 2 * $pi * freq / srate;
cs = cos(omega);
sn = sin(omega);
q = 0.707;
alpha = sn / (2 * q);

filt_mode == 1 ? (
  b0 = (1 - cs) * 0.5;
  b1 = 1 - cs;
  b2 = (1 - cs) * 0.5;
  a0 = 1 / (1 + alpha);
  a1 = -2 * cs;
  a2 = 1 - alpha;
);
filt_mode == 2 ? (
  b0 = alpha;
  b1 = 0;
  b2 = -alpha;
  a0 = 1 / (1 + alpha);
  a1 = -2 * cs;
  a2 = 1 - alpha;
);
filt_mode == 3 ? (
  b0 = (1 + cs) * 0.5;
  b1 = -(1 + cs);
  b2 = (1 + cs) * 0.5;
  a0 = 1 / (1 + alpha);
  a1 = -2 * cs;
  a2 = 1 - alpha;
);
filt_mode == 0 ? (
  b0 = 1; b1 = 0; b2 = 0;
  a0 = 1; a1 = 0; a2 = 0;
);

fa0 = a0;
fb0 = b0 * a0; fb1 = b1 * a0; fb2 = b2 * a0;
fa1 = a1; fa2 = a2;
fx1 = 0; fx2 = 0; fy1 = 0; fy2 = 0;

@sample
in_l = spl0;
in_r = spl1;

buf_l[write_pos] = in_l;
buf_r[write_pos] = in_r;
write_pos = (write_pos + 1) % cur_buf_size;

wet_l = buf_l[read_pos];
wet_r = buf_r[read_pos];
read_pos -= 1;
read_pos < 0 ? read_pos = cur_buf_size - 1;

filt_mode > 0 ? (
  filt_in_l = wet_l;
  filt_out_l = fa0 * (fb0*filt_in_l + fb1*fx1 + fb2*fx2 - fa1*fy1 - fa2*fy2);
  fx2 = fx1; fx1 = filt_in_l;
  fy2 = fy1; fy1 = filt_out_l;
  wet_l = filt_out_l;
  
  filt_in_r = wet_r;
  filt_out_r = fa0 * (fb0*filt_in_r + fb1*fx1 + fb2*fx2 - fa1*fy1 - fa2*fy2);
  fx2 = fx1; fx1 = filt_in_r;
  fy2 = fy1; fy1 = filt_out_r;
  wet_r = filt_out_r;
);

spl0 = in_l * (1 - mix) + wet_l * mix;
spl1 = in_r * (1 - mix) + wet_r * mix;
