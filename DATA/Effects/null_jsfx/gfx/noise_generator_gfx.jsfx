desc:NULL Noise Generator GFX
author: Christos Koulaxizis
tags: noise generator pink white brown test tone calibration stereo filter envelope follower ducking layer gui
//category: Essentials
//NULL JSFX v2.6 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:0<0,2,1{White,Pink,Brown}>-Type
slider2:-24<-60,0,0.1>-Level (dB)
slider3:100<0,100,1>-Stereo Width (%)
slider4:20<20,2000,1:log>-Low Cut (Hz)
slider5:20000<500,20000,1:log>-High Cut (Hz)
slider6:0<0,100,1>-Follow Input (%)
slider7:0<0,100,1>-Ducking (%)
slider8:0<0,1,1{Replace,Add}>-Mix Mode

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  // NULL Noise Generator (../noise_generator.jsfx) with its own interface: same audio code, plus @gfx.
  pb0_l=0; pb1_l=0; pb2_l=0; pb3_l=0; pb4_l=0; pb5_l=0; pb6_l=0;
  pb0_r=0; pb1_r=0; pb2_r=0; pb3_r=0; pb4_r=0; pb5_r=0; pb6_r=0;
  brn_l=0; brn_r=0;
  // Park-Miller generator in exact double arithmetic (seed * 16807 < 2^53), so the noise is the
  // same on every host and CPU; seed / 2^30 - 1 is uniform in (-1, 1) like rand() * 2 - 1
  seed = 12345;
  // Low Cut and High Cut are 12 dB/oct Butterworth filters (TPT state-variable) on the noise,
  // off at their end stops (20 Hz, 20 kHz). Follow Input scales the noise by the input's
  // envelope (a peak follower, 1 ms attack, 60 ms release; full level at 0 dBFS), so 100% makes
  // the noise breathe with the track. Ducking pushes the noise down while the input is loud
  // (10 ms attack, 250 ms release; full ducking from -12 dBFS). Mix Mode Replace outputs the
  // noise alone (the input is only listened to), Add puts it on top of the input.
  lc1_l = lc2_l = lc1_r = lc2_r = 0;
  hc1_l = hc2_l = hc1_r = hc2_r = 0;
  fo_env = 0;
  dk_env = 0;

  gfx_ext_retina = 1;

  function update()
  (
    noise_type = slider1;
    level_db = slider2;
    stereo_width = slider3 / 100;
    gain_lin = exp(level_db * 0.11512925464970228420);
    lc_on = slider4 > 20;
    lc_g = tan($pi * min(slider4, srate * 0.45) / srate);
    lc_d = 1 / (1 + 1.4142135623730951 * lc_g + lc_g * lc_g);
    hc_on = slider5 < 20000;
    hc_g = tan($pi * min(slider5, srate * 0.45) / srate);
    hc_d = 1 / (1 + 1.4142135623730951 * hc_g + hc_g * hc_g);
    fo_on = slider6 > 0;
    fo_amt = slider6 / 100;
    fo_att = 1 - exp(-1 / (0.001 * srate));
    fo_rel = 1 - exp(-1 / (0.06 * srate));
    dk_on = slider7 > 0;
    dk_amt = slider7 / 100;
    dk_att = 1 - exp(-1 / (0.01 * srate));
    dk_rel = 1 - exp(-1 / (0.25 * srate));
    add_mode = slider8;
  );

  // display: the spectrum's shape in dB at f Hz, pivoting on Level at 1 kHz
  // (white flat, pink -3 dB per octave, brown -6 dB per octave), with the Low Cut and
  // High Cut roll-offs (12 dB per octave)
  function ns_db(f) local(d)
  (
    d = level_db - noise_type * 3 * log(f / 1000) / log(2);
    slider4 > 20 ? d -= 10 * log10(1 + (slider4 / f) ^ 4);
    slider5 < 20000 ? d -= 10 * log10(1 + (f / slider5) ^ 4);
    d;
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 12;

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 0); ng_slider_set(2, -24); ng_slider_set(3, 100); ng_slider_set(4, 20); ng_slider_set(5, 20000); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 1 ? ( ng_slider_set(1, 1); ng_slider_set(2, -20); ng_slider_set(3, 0); ng_slider_set(4, 20); ng_slider_set(5, 20000); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 2 ? ( ng_slider_set(1, 1); ng_slider_set(2, -18); ng_slider_set(3, 100); ng_slider_set(4, 20); ng_slider_set(5, 20000); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 3 ? ( ng_slider_set(1, 0); ng_slider_set(2, -24); ng_slider_set(3, 0); ng_slider_set(4, 20); ng_slider_set(5, 20000); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 4 ? ( ng_slider_set(1, 0); ng_slider_set(2, -18); ng_slider_set(3, 100); ng_slider_set(4, 20); ng_slider_set(5, 20000); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 5 ? ( ng_slider_set(1, 2); ng_slider_set(2, -30); ng_slider_set(3, 80); ng_slider_set(4, 20); ng_slider_set(5, 20000); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 6 ? ( ng_slider_set(1, 1); ng_slider_set(2, -48); ng_slider_set(3, 100); ng_slider_set(4, 20); ng_slider_set(5, 20000); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 7 ? ( ng_slider_set(1, 0); ng_slider_set(2, -18); ng_slider_set(3, 100); ng_slider_set(4, 400); ng_slider_set(5, 20000); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 1); );
    p == 8 ? ( ng_slider_set(1, 0); ng_slider_set(2, -12); ng_slider_set(3, 60); ng_slider_set(4, 1500); ng_slider_set(5, 12000); ng_slider_set(6, 100); ng_slider_set(7, 0); ng_slider_set(8, 1); );
    p == 9 ? ( ng_slider_set(1, 1); ng_slider_set(2, -42); ng_slider_set(3, 100); ng_slider_set(4, 2000); ng_slider_set(5, 20000); ng_slider_set(6, 0); ng_slider_set(7, 60); ng_slider_set(8, 1); );
    p == 10 ? ( ng_slider_set(1, 1); ng_slider_set(2, -36); ng_slider_set(3, 80); ng_slider_set(4, 300); ng_slider_set(5, 8000); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 1); );
    p == 11 ? ( ng_slider_set(1, 2); ng_slider_set(2, -24); ng_slider_set(3, 100); ng_slider_set(4, 60); ng_slider_set(5, 4000); ng_slider_set(6, 70); ng_slider_set(7, 0); ng_slider_set(8, 1); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, -24) && ng_pre_eq(slider3, 100) && ng_pre_eq(slider4, 20) && ng_pre_eq(slider5, 20000) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, -20) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 20) && ng_pre_eq(slider5, 20000) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, -18) && ng_pre_eq(slider3, 100) && ng_pre_eq(slider4, 20) && ng_pre_eq(slider5, 20000) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, -24) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 20) && ng_pre_eq(slider5, 20000) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, -18) && ng_pre_eq(slider3, 100) && ng_pre_eq(slider4, 20) && ng_pre_eq(slider5, 20000) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, -30) && ng_pre_eq(slider3, 80) && ng_pre_eq(slider4, 20) && ng_pre_eq(slider5, 20000) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, -48) && ng_pre_eq(slider3, 100) && ng_pre_eq(slider4, 20) && ng_pre_eq(slider5, 20000) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, -18) && ng_pre_eq(slider3, 100) && ng_pre_eq(slider4, 400) && ng_pre_eq(slider5, 20000) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 1) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, -12) && ng_pre_eq(slider3, 60) && ng_pre_eq(slider4, 1500) && ng_pre_eq(slider5, 12000) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 1) ? m = 8;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, -42) && ng_pre_eq(slider3, 100) && ng_pre_eq(slider4, 2000) && ng_pre_eq(slider5, 20000) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 60) && ng_pre_eq(slider8, 1) ? m = 9;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, -36) && ng_pre_eq(slider3, 80) && ng_pre_eq(slider4, 300) && ng_pre_eq(slider5, 8000) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 1) ? m = 10;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, -24) && ng_pre_eq(slider3, 100) && ng_pre_eq(slider4, 60) && ng_pre_eq(slider5, 4000) && ng_pre_eq(slider6, 70) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 1) ? m = 11;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Pink Mono Calibration";
    p == 2 ? s = "Pink Stereo Reference";
    p == 3 ? s = "White Filter Test";
    p == 4 ? s = "White Riser Layer";
    p == 5 ? s = "Brown Rumble Bed";
    p == 6 ? s = "Soft Room Tone";
    p == 7 ? s = "Riser Noise";
    p == 8 ? s = "Snare Noise Layer";
    p == 9 ? s = "Hiss Bed";
    p == 10 ? s = "Vinyl Air";
    p == 11 ? s = "Breathing Texture";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  seed *= 16807; seed -= floor(seed / 2147483647) * 2147483647; rnd_l = seed / 1073741824 - 1;
  seed *= 16807; seed -= floor(seed / 2147483647) * 2147483647; rnd_r = seed / 1073741824 - 1;
  rnd_r = rnd_l * (1 - stereo_width) + rnd_r * stereo_width;

  noise_type == 0 ? (
    nse_l = rnd_l * gain_lin;
    nse_r = rnd_r * gain_lin;
  );

  noise_type == 1 ? (
    pb0_l = 0.99886 * pb0_l + rnd_l * 0.0555179;
    pb1_l = 0.99332 * pb1_l + rnd_l * 0.0750759;
    pb2_l = 0.96900 * pb2_l + rnd_l * 0.1538520;
    pb3_l = 0.86600 * pb3_l + rnd_l * 0.3104856;
    pb4_l = 0.55000 * pb4_l + rnd_l * 0.5329522;
    pb5_l = 0.31300 * pb5_l + rnd_l * 0.5329522;
    pb6_l = 0.11000 * pb6_l + rnd_l * 0.5329522;
    nse_l = (pb0_l + pb1_l + pb2_l + pb3_l + pb4_l + pb5_l + pb6_l + rnd_l * 0.5362) * 0.11 * gain_lin;

    pb0_r = 0.99886 * pb0_r + rnd_r * 0.0555179;
    pb1_r = 0.99332 * pb1_r + rnd_r * 0.0750759;
    pb2_r = 0.96900 * pb2_r + rnd_r * 0.1538520;
    pb3_r = 0.86600 * pb3_r + rnd_r * 0.3104856;
    pb4_r = 0.55000 * pb4_r + rnd_r * 0.5329522;
    pb5_r = 0.31300 * pb5_r + rnd_r * 0.5329522;
    pb6_r = 0.11000 * pb6_r + rnd_r * 0.5329522;
    nse_r = (pb0_r + pb1_r + pb2_r + pb3_r + pb4_r + pb5_r + pb6_r + rnd_r * 0.5362) * 0.11 * gain_lin;
  );

  noise_type == 2 ? (
    brn_l = brn_l + rnd_l * 0.02;
    brn_l = brn_l * 0.997;
    brn_l > 1 ? brn_l = 1 : (brn_l < -1 ? brn_l = -1);
    nse_l = brn_l * gain_lin * 3.5;

    brn_r = brn_r + rnd_r * 0.02;
    brn_r = brn_r * 0.997;
    brn_r > 1 ? brn_r = 1 : (brn_r < -1 ? brn_r = -1);
    nse_r = brn_r * gain_lin * 3.5;
  );

  lc_on ? (
    // high pass (Butterworth): v3 of the SVF
    v3 = (nse_l - lc2_l - (1.4142135623730951 + lc_g) * lc1_l) * lc_d;
    v1 = lc_g * v3 + lc1_l; v2 = lc_g * v1 + lc2_l; lc1_l = v1; lc2_l = v2; nse_l = v3;
    v3 = (nse_r - lc2_r - (1.4142135623730951 + lc_g) * lc1_r) * lc_d;
    v1 = lc_g * v3 + lc1_r; v2 = lc_g * v1 + lc2_r; lc1_r = v1; lc2_r = v2; nse_r = v3;
  );
  hc_on ? (
    // low pass (Butterworth): v2 of the SVF
    v3 = (nse_l - hc2_l - (1.4142135623730951 + hc_g) * hc1_l) * hc_d;
    v1 = hc_g * v3 + hc1_l; v2 = hc_g * v1 + hc2_l; hc1_l = v1; hc2_l = v2; nse_l = v2;
    v3 = (nse_r - hc2_r - (1.4142135623730951 + hc_g) * hc1_r) * hc_d;
    v1 = hc_g * v3 + hc1_r; v2 = hc_g * v1 + hc2_r; hc1_r = v1; hc2_r = v2; nse_r = v2;
  );
  fo_on || dk_on ? (
    in_pk = max(abs(spl0), abs(spl1));
    fo_on ? (
      fo_env += (in_pk > fo_env ? fo_att : fo_rel) * (in_pk - fo_env);
      fo_g = 1 - fo_amt + fo_amt * min(1, fo_env);
      nse_l *= fo_g;
      nse_r *= fo_g;
    );
    dk_on ? (
      dk_env += (in_pk > dk_env ? dk_att : dk_rel) * (in_pk - dk_env);
      dk_g = 1 - dk_amt * min(1, dk_env * 4);
      nse_l *= dk_g;
      nse_r *= dk_g;
    );
  );

  add_mode ? (
    spl0 += nse_l;
    spl1 += nse_r;
  ) : (
    spl0 = nse_l;
    spl1 = nse_r;
  );

@gfx 480 380
  ng_knobs_begin("NOISE GENERATOR", "ESSENTIALS", 480, 120, 2, 0);

  // display: the noise spectrum's slope over 20 Hz..20 kHz with the cuts, level in dB (0 to -72)
  ng_plot(ng_vx + 26, ng_vy + 4, ng_vw - 30, ng_vh - 20);
  ns_d = 10;
  loop(4,
    ns_m = 1;
    loop(9,
      ns_f = ns_m * ns_d;
      ns_f >= 20 && ns_f <= 20000 ? (
        ns_x = floor(ng_freq_x(ns_f)) + 0.5;
        ng_col(NG_BORDER, ns_m == 1 ? 1 : 0.5);
        gfx_line(ns_x, ng_py, ns_x, ng_py + ng_ph, 0);
      );
      ns_m += 1;
    );
    ns_d *= 10;
  );
  ns_i = 0;
  loop(4,
    ns_y = floor(ng_py + ng_ph * ns_i / 3) + 0.5;
    ng_col(NG_BORDER, 0.6);
    gfx_line(ng_px, ns_y, ng_px + ng_pw, ns_y, 0);
    ns_i += 1;
  );
  ng_font(4, 8, 0);
  ng_col(NG_MUTED, 1);
  ng_ptxt("0", ng_px - 6 * ng_s, ng_py, 2);
  ng_ptxt("-24", ng_px - 6 * ng_s, ng_py + ng_ph / 3, 2);
  ng_ptxt("-48", ng_px - 6 * ng_s, ng_py + ng_ph * 2 / 3, 2);
  ng_ptxt("-72", ng_px - 6 * ng_s, ng_py + ng_ph, 2);
  ng_ptxt("100", ng_freq_x(100), ng_py + ng_ph + 10 * ng_s, 1);
  ng_ptxt("1k", ng_freq_x(1000), ng_py + ng_ph + 10 * ng_s, 1);
  ng_ptxt("10k", ng_freq_x(10000), ng_py + ng_ph + 10 * ng_s, 1);
  noise_type == 0 ? sprintf(#ns_t, "FLAT") : noise_type == 1 ? sprintf(#ns_t, "-3 dB / OCT") : sprintf(#ns_t, "-6 dB / OCT");
  ng_ptxt(#ns_t, ng_px + ng_pw - 6 * ng_s, ng_py + 9 * ng_s, 2);
  slider6 > 0 ? sprintf(#ns_a, "FOLLOW %d%%", slider6) : strcpy(#ns_a, "");
  slider7 > 0 ? sprintf(#ns_b, "%sDUCK %d%%", slider6 > 0 ? "  " : "", slider7) : strcpy(#ns_b, "");
  sprintf(#ns_t, "%s%s%s", #ns_a, #ns_b, slider8 ? (slider6 > 0 || slider7 > 0 ? "  ADD" : "ADD") : "");
  ng_ptxt(#ns_t, ng_px + ng_pw - 6 * ng_s, ng_py + 21 * ng_s, 2);
  ng_col(NG_ACCENT, 0.10);
  ns_i = 0;
  loop(floor(ng_pw) + 1,
    gfx_line(ng_px + ns_i, ng_lin_y(ns_db(20 * 1000 ^ (ns_i / ng_pw)), -72, 0), ng_px + ns_i, ng_py + ng_ph, 0);
    ns_i += 1;
  );
  ng_col(NG_ACCENT, 1);
  ns_i = 0;
  loop(floor(ng_pw) + 1,
    ns_y = ng_lin_y(ns_db(20 * 1000 ^ (ns_i / ng_pw)), -72, 0);
    ns_i == 0 ? ng_line_start(ng_px, ns_y) : ng_line_to(ng_px + ns_i, ns_y);
    ns_i += 1;
  );

  ng_row(4);
  ng_select_ctl(1, "TYPE", "WHITE|PINK|BROWN", 0) ? update();
  sprintf(#v2, "%.1f dB", slider2);
  ng_knob_ctl(2, "LEVEL", #v2, -60, 0, -24, 0.1, 0) ? update();
  sprintf(#v3, "%d%%", slider3);
  ng_knob_ctl(3, "WIDTH", #v3, 0, 100, 100, 1, 0) ? update();
  ng_select_ctl(8, "MIX MODE", "REPL|ADD", 0) ? update();
  ng_row(4);
  slider4 > 20 ? (slider4 >= 1000 ? sprintf(#v4, "%.1f kHz", slider4 / 1000) : sprintf(#v4, "%d Hz", slider4)) : strcpy(#v4, "OFF");
  ng_knob_ctl_log(4, "LOW CUT", #v4, 20, 2000, 20, 1) ? update();
  slider5 >= 20000 ? strcpy(#v5, "OFF") : slider5 >= 1000 ? sprintf(#v5, "%.1f kHz", slider5 / 1000) : sprintf(#v5, "%d Hz", slider5);
  ng_knob_ctl_log(5, "HIGH CUT", #v5, 500, 20000, 20000, 1) ? update();
  sprintf(#v6, "%d%%", slider6);
  ng_knob_ctl(6, "FOLLOW", #v6, 0, 100, 0, 1, 0) ? update();
  sprintf(#v7, "%d%%", slider7);
  ng_knob_ctl(7, "DUCKING", #v7, 0, 100, 0, 1, 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
