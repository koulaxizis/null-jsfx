  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Warm Pad";
    p == 2 ? s = "Glass Pad";
    p == 3 ? s = "Vocal Pad";
    p == 4 ? s = "Saw Lead";
    p == 5 ? s = "Square Lead";
    p == 6 ? s = "Sync Lead";
    p == 7 ? s = "Soft Keys";
    p == 8 ? s = "Pluck";
    p == 9 ? s = "String Machine";
    p == 10 ? s = "Analog Bass";
    p == 11 ? s = "Wobble Bass";
    p == 12 ? s = "Sub Bass";
    p == 13 ? s = "Digital Bells";
    p == 14 ? s = "Organ";
    p == 15 ? s = "Fold Arp";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@block
  // MIDI of this block, played at its offsets in @sample
  mq_n = 0;
  while (midirecv(m_ofs, m_1, m_2, m_3)) (
    mq_n < 256 ? (
      MQ[mq_n * 4] = m_ofs;
      MQ[mq_n * 4 + 1] = m_1;
      MQ[mq_n * 4 + 2] = m_2;
      MQ[mq_n * 4 + 3] = m_3;
      mq_n += 1;
    );
  );
  mq_i = 0;
  si = 0;

  // the LFO: Rate in Hz, or a note value at the host tempo (locked to the beat while it plays)
  bpm = tempo > 0 ? tempo : 120;
  lfo_sync > 0 ? (
    lfo_inc = bpm / (lfo_bpc * srate * 60);
    // (a hair past the beat, so a host position a rounding error short of a cycle's start
    // does not land just before it)
    play_state & 1 ? ( lfo_ph = beat_position / lfo_bpc + 0.000000001; lfo_ph -= floor(lfo_ph); );
  ) : lfo_inc = slider26 / srate;
  lfo_sm = 1 - exp(-1000 / (2 * srate));
  dl_len = max(1, min(DLN - 2, floor(dl_beats * 60 / bpm * srate)));
  ch_inc = 0.45 / srate;

@sample
  while (mq_i < mq_n && MQ[mq_i * 4] <= si) (
    midi_in(MQ[mq_i * 4 + 1], MQ[mq_i * 4 + 2], MQ[mq_i * 4 + 3]);
    mq_i += 1;
  );
  si += 1;

  // white noise (Park-Miller)
  seed *= 16807; seed -= floor(seed / 2147483647) * 2147483647;
  nz = seed / 1073741824 - 1;

  // the LFO, smoothed over 2 ms; Random holds a new Park-Miller value each cycle
  lfo_ph += lfo_inc;
  lfo_ph >= 1 ? (
    lfo_ph -= floor(lfo_ph);
    lfo_x *= 16807; lfo_x -= floor(lfo_x / 2147483647) * 2147483647;
    lfo_r = lfo_x / 1073741824 - 1;
  );
  lfo_raw = lfo_shape == 0 ? sin(2 * $pi * lfo_ph) : lfo_shape == 1 ? 1 - 4 * abs(lfo_ph - 0.5) :
            lfo_shape == 2 ? (lfo_ph < 0.5 ? 1 : -1) : lfo_shape == 3 ? 1 - 2 * lfo_ph : lfo_r;
  lfo_s += (lfo_raw - lfo_s) * lfo_sm;
  lfo_v = lfo_s;
  pmod = bend * bend_r + lfo_v * (lfo_p + 0.5 * mwheel);

  // the table frames around Position (+ LFO)
  engine ? (
    wt_x = max(0, min(1, wt_pos + lfo_w * lfo_v)) * 7;
    wt_i = min(6, floor(wt_x));
    wt_f = wt_x - wt_i;
    wt_b = WT + (tbl * 8 + wt_i) * 8192;
  );

  outl = outr = 0;
  v0.vproc(); v1.vproc(); v2.vproc(); v3.vproc(); v4.vproc(); v5.vproc(); v6.vproc(); v7.vproc();

  // Chorus: two delay lines (12 ms +- 3 ms) moved by a slow sine in quadrature
  ch_on ? (
    ch_ph += ch_inc; ch_ph -= floor(ch_ph);
    CHL[ch_w] = outl; CHR[ch_w] = outr;
    ch_d = (0.012 + 0.003 * sin(2 * $pi * ch_ph)) * srate;
    ch_r = ch_w - ch_d; ch_r < 0 ? ch_r += CHN;
    ch_i = floor(ch_r); ch_fr = ch_r - ch_i; ch_j = ch_i + 1; ch_j >= CHN ? ch_j -= CHN;
    ch_yl = CHL[ch_i] + (CHL[ch_j] - CHL[ch_i]) * ch_fr;
    ch_d = (0.012 + 0.003 * cos(2 * $pi * ch_ph)) * srate;
    ch_r = ch_w - ch_d; ch_r < 0 ? ch_r += CHN;
    ch_i = floor(ch_r); ch_fr = ch_r - ch_i; ch_j = ch_i + 1; ch_j >= CHN ? ch_j -= CHN;
    ch_yr = CHR[ch_i] + (CHR[ch_j] - CHR[ch_i]) * ch_fr;
    ch_w += 1; ch_w >= CHN ? ch_w = 0;
    outl = outl * (1 - 0.5 * ch_mix) + ch_yr * 0.5 * ch_mix;
    outr = outr * (1 - 0.5 * ch_mix) + ch_yl * 0.5 * ch_mix;
  );

  // Delay: ping-pong at a note value of the host tempo, the repeats darkened
  dl_on ? (
    dl_r = dl_w - dl_len; dl_r < 0 ? dl_r += DLN;
    dl_yl = DLL[dl_r]; dl_yr = DLR[dl_r];
    dl_ll += (dl_yl - dl_ll) * 0.35;
    dl_lr += (dl_yr - dl_lr) * 0.35;
    DLL[dl_w] = (outl + outr) * 0.5 + dl_lr * dl_fb;
    DLR[dl_w] = dl_ll * dl_fb;
    dl_w += 1; dl_w >= DLN ? dl_w = 0;
    outl += dl_yl * dl_mix;
    outr += dl_yr * dl_mix;
  );

  // Reverb: eight delay lines through a Hadamard matrix, each damped and decaying by Size
  rv_on ? (
    k = 0;
    loop(8,
      rv_p = RVB + k * RVN + RVP[k];
      RVS[k] += (rv_p[0] - RVS[k]) * rv_dc;
      RVT[k] = RVS[k] * RVG[k];
      RVY[k] = RVT[k];
      k += 1;
    );
    rv_a = RVT[0] + RVT[1]; rv_b = RVT[0] - RVT[1]; RVT[0] = rv_a; RVT[1] = rv_b;
    rv_a = RVT[2] + RVT[3]; rv_b = RVT[2] - RVT[3]; RVT[2] = rv_a; RVT[3] = rv_b;
    rv_a = RVT[4] + RVT[5]; rv_b = RVT[4] - RVT[5]; RVT[4] = rv_a; RVT[5] = rv_b;
    rv_a = RVT[6] + RVT[7]; rv_b = RVT[6] - RVT[7]; RVT[6] = rv_a; RVT[7] = rv_b;
    rv_a = RVT[0] + RVT[2]; rv_b = RVT[0] - RVT[2]; RVT[0] = rv_a; RVT[2] = rv_b;
    rv_a = RVT[1] + RVT[3]; rv_b = RVT[1] - RVT[3]; RVT[1] = rv_a; RVT[3] = rv_b;
    rv_a = RVT[4] + RVT[6]; rv_b = RVT[4] - RVT[6]; RVT[4] = rv_a; RVT[6] = rv_b;
    rv_a = RVT[5] + RVT[7]; rv_b = RVT[5] - RVT[7]; RVT[5] = rv_a; RVT[7] = rv_b;
    rv_a = RVT[0] + RVT[4]; rv_b = RVT[0] - RVT[4]; RVT[0] = rv_a; RVT[4] = rv_b;
    rv_a = RVT[1] + RVT[5]; rv_b = RVT[1] - RVT[5]; RVT[1] = rv_a; RVT[5] = rv_b;
    rv_a = RVT[2] + RVT[6]; rv_b = RVT[2] - RVT[6]; RVT[2] = rv_a; RVT[6] = rv_b;
    rv_a = RVT[3] + RVT[7]; rv_b = RVT[3] - RVT[7]; RVT[3] = rv_a; RVT[7] = rv_b;
    k = 0;
    loop(8,
      rv_p = RVB + k * RVN + RVP[k];
      rv_p[0] = RVT[k] * 0.35355339059327373 + (k & 1 ? outr : outl) * 0.3;
      RVP[k] += 1; RVP[k] >= RVL[k] ? RVP[k] = 0;
      k += 1;
    );
    outl += (RVY[0] + RVY[2] + RVY[4] + RVY[6]) * 0.5 * rv_mix;
    outr += (RVY[1] + RVY[3] + RVY[5] + RVY[7]) * 0.5 * rv_mix;
  );

  spl0 = outl * vol;
  spl1 = outr * vol;

@gfx 600 438
  ng_knobs_begin("SYNTH", "INSTRUMENTS", 600, 150, 2, 1);

  // display: the oscillator wave (or the table's frame at Position), the filter's response and
  // the two envelopes, with a dot per voice that lights while it sounds
  sy_tw = slider1 >= 0.5;
  sy_tw ? (
    strcpy_substr(#sy_a, "BASIC  PULSE  ORGAN  VOCAL  GLASS  SYNC   FOLD   DIGITAL", floor(slider9 + 0.5) * 7, 7);
    sy_k = strlen(#sy_a); while (sy_k > 0 && str_getchar(#sy_a, sy_k - 1) == ' ') ( sy_k -= 1; );
    strcpy_substr(#sy_a, #sy_a, 0, sy_k);
    sprintf(#sy_ti, "TABLE  %s  %d%%", #sy_a, slider10);
  ) : (
    strcpy_substr(#sy_a, "SAW SQR TRI SIN", floor(slider2 + 0.5) * 4, 3);
    strcpy_substr(#sy_b, "SAW SQR TRI SIN", floor(slider3 + 0.5) * 4, 3);
    sprintf(#sy_ti, "OSC  %s + %s", #sy_a, #sy_b);
  );
  sy_panel(24, 176, #sy_ti);
  ng_col(NG_BORDER, 1);
  gfx_line(X(25), Y(134), X(199), Y(134), 0);
  ng_col(NG_ACCENT, 1);
  sy_fx = (floor(slider9 + 0.5) * 8) * 8192;
  sy_x = slider10 / 100 * 7; sy_i = min(6, floor(sy_x)); sy_f = sy_x - sy_i;
  sy_r2 = 2 ^ (slider4 / 12);
  sy_n = 0;
  loop(169,
    sy_p = sy_n / 168;
    sy_tw ? (
      sy_j = floor(sy_p * 1023 + 0.5);
      sy_b0 = WT + (floor(slider9 + 0.5) * 8 + sy_i) * 8192;
      sy_v = sy_b0[sy_j] + (sy_b0[8192 + sy_j] - sy_b0[sy_j]) * sy_f;
    ) : (
      sy_q = sy_p * sy_r2; sy_q -= floor(sy_q);
      sy_v = (1 - slider6 / 100) * sy_wave(floor(slider2 + 0.5), sy_p) + slider6 / 100 * sy_wave(floor(slider3 + 0.5), sy_q);
    );
    sy_px = X(28 + sy_n); sy_py = Y(134 - 50 * max(-1, min(1, sy_v)));
    sy_n == 0 ? ng_line_start(sy_px, sy_py) : ng_line_to(sy_px, sy_py);
    sy_n += 1;
  );

  sy_c = slider13 * 2 ^ (slider35 / 100);
  sy_c >= 1000 ? sprintf(#sy_cv, "%.1f kHz", sy_c / 1000) : sprintf(#sy_cv, "%d Hz", sy_c);
  sprintf(#sy_ti, "%s %s  %s", floor(slider11 + 0.5) == 0 ? "LP" : floor(slider11 + 0.5) == 1 ? "BP" : "HP", slider12 >= 0.5 ? "24" : "12", #sy_cv);
  sy_panel(212, 176, #sy_ti);
  ng_col(NG_BORDER, 1);
  sy_k = 0;
  loop(3, sy_px = floor(X(216 + 168 * (sy_k + 1) / 3)) + 0.5; gfx_line(sy_px, Y(77), sy_px, Y(191), 0); sy_k += 1; );
  gfx_line(X(213), Y(82 + 18 / 48 * 104), X(387), Y(82 + 18 / 48 * 104), 0);
  sy_res = slider14 / 100;
  sy_q = slider12 >= 0.5 ? 1.31 + 10.7 * sy_res * sy_res : 0.707 + 11.3 * sy_res * sy_res;
  ng_col(NG_ACCENT, 1);
  sy_n = 0;
  loop(169,
    sy_r = 20 * 1000 ^ (sy_n / 168) / sy_c;
    sy_v = sy_mag(sy_r, sy_q, floor(slider11 + 0.5));
    slider12 >= 0.5 ? sy_v *= sy_mag(sy_r, 0.54, floor(slider11 + 0.5));
    sy_db = 20 * log10(max(0.000001, sy_v));
    sy_px = X(216 + sy_n); sy_py = Y(82 + (18 - max(-30, min(18, sy_db))) / 48 * 104);
    sy_n == 0 ? ng_line_start(sy_px, sy_py) : ng_line_to(sy_px, sy_py);
    sy_n += 1;
  );

  sy_panel(400, 176, "ENVELOPES");
  ng_col(NG_MUTED, 0.8);
  sy_env(404, 168, slider17, slider18, slider19 / 100, slider20);
  ng_col(NG_ACCENT, 1);
  sy_env(404, 168, slider21, slider22, slider23 / 100, slider24);
  sy_k = 0;
  loop(8,
    sy_v = sy_k == 0 ? v0.ae : sy_k == 1 ? v1.ae : sy_k == 2 ? v2.ae : sy_k == 3 ? v3.ae : sy_k == 4 ? v4.ae : sy_k == 5 ? v5.ae : sy_k == 6 ? v6.ae : v7.ae;
    ng_mix(NG_BORDER, NG_ACCENT, max(0, min(1, sy_v)), 1);
    gfx_circle(X(510 + sy_k * 9), Y(68), 2.5 * ng_s, 1, 1);
    sy_k += 1;
  );

  sy_tab = ng_tabs("OSC|FILTER|AMP|LFO + FX", sy_tab);
  sy_tab == 0 ? (
    ng_row(6);
    ng_select_ctl(1, "ENGINE", "ANALOG|WAVE", 0) ? update();
    ng_select_ctl(2, "OSC 1", "SAW|SQUARE|TRIANGLE|SINE", 0) ? update();
    ng_select_ctl(3, "OSC 2", "SAW|SQUARE|TRIANGLE|SINE", 0) ? update();
    sprintf(#sy_v4, "%+d st", slider4);
    ng_knob_ctl(4, "SEMI", #sy_v4, -24, 24, 0, 1, 1) ? update();
    sprintf(#sy_v5, "%+d ct", slider5);
    ng_knob_ctl(5, "DETUNE", #sy_v5, -50, 50, 7, 1, 1) ? update();
    sprintf(#sy_v6, "%d%%", slider6);
    ng_knob_ctl(6, "OSC MIX", #sy_v6, 0, 100, 50, 1, 0) ? update();
    ng_row(6);
    ng_select_ctl(9, "TABLE", "BASIC|PULSE|ORGAN|VOCAL|GLASS|SYNC|FOLD|DIGITAL", 0) ? update();
    sprintf(#sy_v10, "%d%%", slider10);
    ng_knob_ctl(10, "POSITION", #sy_v10, 0, 100, 0, 1, 0) ? update();
    sprintf(#sy_v7, "%d%%", slider7);
    ng_knob_ctl(7, "SUB", #sy_v7, 0, 100, 0, 1, 0) ? update();
    sprintf(#sy_v8, "%d%%", slider8);
    ng_knob_ctl(8, "NOISE", #sy_v8, 0, 100, 0, 1, 0) ? update();
    sprintf(#sy_v33, "%d", slider33);
    ng_knob_ctl(33, "UNISON", #sy_v33, 1, 4, 1, 1, 0) ? update();
    sprintf(#sy_v34, "%d%%", slider34);
    ng_knob_ctl(34, "SPREAD", #sy_v34, 0, 100, 30, 1, 0) ? update();
  ) : sy_tab == 1 ? (
    ng_row(6);
    ng_select_ctl(11, "MODE", "LOW PASS|BAND PASS|HIGH PASS", 0) ? update();
    ng_select_ctl(12, "SLOPE", "12 DB|24 DB", 0) ? update();
    slider13 >= 1000 ? sprintf(#sy_v13, "%.2f kHz", slider13 / 1000) : sprintf(#sy_v13, "%d Hz", slider13);
    ng_knob_ctl_log(13, "CUTOFF", #sy_v13, 20, 20000, 2500, 1) ? update();
    sprintf(#sy_v14, "%d%%", slider14);
    ng_knob_ctl(14, "RESONANCE", #sy_v14, 0, 100, 20, 1, 0) ? update();
    sprintf(#sy_v15, "%+d%%", slider15);
    ng_knob_ctl(15, "ENV AMOUNT", #sy_v15, -100, 100, 30, 1, 1) ? update();
    sprintf(#sy_v16, "%d%%", slider16);
    ng_knob_ctl(16, "KEY TRACK", #sy_v16, 0, 100, 50, 1, 0) ? update();
    ng_row(4);
    strcpy(#sy_v17, sy_ms(slider17));
    ng_knob_ctl_log(17, "ATTACK", #sy_v17, 1, 10000, 5, 1) ? update();
    strcpy(#sy_v18, sy_ms(slider18));
    ng_knob_ctl_log(18, "DECAY", #sy_v18, 1, 10000, 600, 1) ? update();
    sprintf(#sy_v19, "%d%%", slider19);
    ng_knob_ctl(19, "SUSTAIN", #sy_v19, 0, 100, 30, 1, 0) ? update();
    strcpy(#sy_v20, sy_ms(slider20));
    ng_knob_ctl_log(20, "RELEASE", #sy_v20, 1, 10000, 400, 1) ? update();
  ) : sy_tab == 2 ? (
    ng_row(6);
    strcpy(#sy_v21, sy_ms(slider21));
    ng_knob_ctl_log(21, "ATTACK", #sy_v21, 1, 10000, 5, 1) ? update();
    strcpy(#sy_v22, sy_ms(slider22));
    ng_knob_ctl_log(22, "DECAY", #sy_v22, 1, 10000, 600, 1) ? update();
    sprintf(#sy_v23, "%d%%", slider23);
    ng_knob_ctl(23, "SUSTAIN", #sy_v23, 0, 100, 70, 1, 0) ? update();
    strcpy(#sy_v24, sy_ms(slider24));
    ng_knob_ctl_log(24, "RELEASE", #sy_v24, 1, 10000, 300, 1) ? update();
    sprintf(#sy_v42, "%d%%", slider42);
    ng_knob_ctl(42, "VELOCITY", #sy_v42, 0, 100, 50, 1, 0) ? update();
    sprintf(#sy_v45, "%+.1f dB", slider45);
    ng_knob_ctl(45, "VOLUME", #sy_v45, -24, 12, 0, 0.1, 0) ? update();
    ng_row(5);
    ng_select_ctl(32, "VOICES", "POLY|MONO|LEGATO", 0) ? update();
    sprintf(#sy_v31, "%d ms", slider31);
    ng_knob_ctl(31, "GLIDE", #sy_v31, 0, 2000, 0, 1, 0) ? update();
    sprintf(#sy_v44, "%+d", slider44);
    ng_knob_ctl(44, "OCTAVE", #sy_v44, -3, 3, 0, 1, 1) ? update();
    sprintf(#sy_v43, "%d st", slider43);
    ng_knob_ctl(43, "BEND", #sy_v43, 0, 24, 2, 1, 0) ? update();
    sprintf(#sy_v35, "%d%%", slider35);
    ng_knob_ctl(35, "CHARACTER", #sy_v35, 0, 100, 0, 1, 0) ? update();
  ) : (
    ng_row(6);
    ng_select_ctl(25, "LFO SHAPE", "SINE|TRIANGLE|SQUARE|SAW|RANDOM", 0) ? update();
    sprintf(#sy_v26, "%.2f Hz", slider26);
    ng_knob_ctl_log(26, "LFO RATE", #sy_v26, 0.05, 20, 5, 0.01) ? update();
    ng_select_ctl(27, "LFO SYNC", "OFF|1/1|1/2|1/4|1/8|1/16|1/4T|1/8T|1/4D|1/8D", 0) ? update();
    sprintf(#sy_v28, "%.2f st", slider28);
    ng_knob_ctl(28, "TO PITCH", #sy_v28, 0, 12, 0, 0.01, 0) ? update();
    sprintf(#sy_v29, "%.1f oct", slider29);
    ng_knob_ctl(29, "TO FILTER", #sy_v29, 0, 4, 0, 0.1, 0) ? update();
    sprintf(#sy_v30, "%d%%", slider30);
    ng_knob_ctl(30, "TO POSITION", #sy_v30, 0, 100, 0, 1, 0) ? update();
    ng_row(6);
    sprintf(#sy_v36, "%d%%", slider36);
    ng_knob_ctl(36, "CHORUS", #sy_v36, 0, 100, 20, 1, 0) ? update();
    sprintf(#sy_v37, "%d%%", slider37);
    ng_knob_ctl(37, "DELAY", #sy_v37, 0, 100, 0, 1, 0) ? update();
    ng_select_ctl(38, "DELAY TIME", "1/16|1/8T|1/8|1/8D|1/4T|1/4|1/4D|1/2", 0) ? update();
    sprintf(#sy_v39, "%d%%", slider39);
    ng_knob_ctl(39, "FEEDBACK", #sy_v39, 0, 90, 35, 1, 0) ? update();
    sprintf(#sy_v40, "%d%%", slider40);
    ng_knob_ctl(40, "REVERB", #sy_v40, 0, 100, 15, 1, 0) ? update();
    sprintf(#sy_v41, "%d%%", slider41);
    ng_knob_ctl(41, "SIZE", #sy_v41, 0, 100, 50, 1, 0) ? update();
  );

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
