desc:NULL Flanger GFX
author: Christos Koulaxizis
tags: flanger jet sweep modulation feedback comb filter thru-zero tape tempo sync gui
//category: Essentials
//NULL JSFX v2.8 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:0.3<0.1,5,0.1>-Rate (Hz)
slider2:5<1,20,0.1>-Depth (ms)
slider3:50<0,100,1>-Feedback (%)
slider4:40<0,100,1>-Mix (%)
slider5:0.5<0.1,10,0.1>-Manual (ms)
slider6:0<0,11,1{Off,1/1,1/2,1/4,1/8,1/16,2/1,4/1,1/4T,1/8T,1/4D,1/8D}>-Tempo Sync
slider7:0<0,180,1>-Stereo Phase (deg)
slider8:0<0,1,1{Off,On}>-Thru Zero

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // NULL Flanger (../flanger.jsfx) with its own interface: same audio code, plus @gfx.
  // A sine LFO sweeps the delay from Manual up to Manual + Depth; Stereo Phase offsets the
  // right channel's LFO. Tempo Sync sets one LFO cycle to a note at the host tempo, locked
  // to beat_position while the transport plays. Thru Zero delays the dry path by the
  // sweep's midpoint (whole samples, reported as latency) and mixes the swept path in
  // opposite polarity, so the sweep passes through zero delay against the dry signal and
  // cancels it there, like two tape machines. The defaults are the original flanger.
  buf_size = ceil(srate * 0.05);
  delay_l = 0;
  delay_r = delay_l + buf_size;
  dry_l = delay_r + buf_size;
  dry_r = dry_l + buf_size;
  memset(delay_l, 0, 4 * buf_size);
  freembuf(dry_r + buf_size);
  wpos = 0;
  phase = 0;
  fb_l = 0;
  fb_r = 0;
  pdc_bot_ch = 0;
  pdc_top_ch = 2;

  // the cycle in beats of Tempo Sync option s (1..11)
  function fl_cycle(s)
  (
    s == 1 ? 4 : s == 2 ? 2 : s == 3 ? 1 : s == 4 ? 0.5 : s == 5 ? 0.25 : s == 6 ? 8 : s == 7 ? 16 :
    s == 8 ? 2 / 3 : s == 9 ? 1 / 3 : s == 10 ? 1.5 : 0.75;
  );
  gfx_ext_retina = 1;

  function update()
  (
    rate = slider1;
    depth = slider2;
    fb_amt = slider3 / 100 * 0.7;
    mix_amt = slider4 / 100;
    phase_inc = 6.28318530717958 * rate / srate;
    manual = slider5;
    sync = floor(slider6 + 0.5);
    cyc = fl_cycle(sync);
    st_off = slider7 * $pi / 180;
    tz = slider8 >= 0.5;
    tz_delay = floor((manual + depth * 0.5) * srate / 1000 + 0.5);
    pdc_delay = tz ? tz_delay : 0;
  );

  // ---- modulation view: an info line over a plot of two LFO cycles ----
  // the delay time (0 to 32 ms) at u (0..1 = two cycles), as a plot y, the LFO shifted by
  // md_off (radians)
  function md_val(u)
  (
    ng_lin_y(slider5 + slider2 * 0.5 * (1 + sin(4 * $pi * u + md_off)), 0, 32);
  );

  function md_view(left, right)
  (
    ng_plot(ng_vx + 26, ng_vy + 14, ng_vw - 30, ng_vh - 30);
    ng_grid(4, 4, 0);
    ng_font(4, 8, 0);
    ng_col(NG_MUTED, 1);
    ng_ptxt(left, ng_px, Y(ng_vy + 4), 0);
    ng_ptxt(right, ng_px + ng_pw, Y(ng_vy + 4), 2);
  );

  // labels at the top, middle and bottom of the plot
  function md_ylabels(top, mid, bot)
  (
    ng_col(NG_MUTED, 1);
    ng_ptxt(top, ng_px - 6 * ng_s, ng_py, 2);
    ng_ptxt(mid, ng_px - 6 * ng_s, ng_py + ng_ph / 2, 2);
    ng_ptxt(bot, ng_px - 6 * ng_s, ng_py + ng_ph, 2);
  );

  // times under the plot at 1/4, 1/2 and 3/4 of its width for a cycle of period seconds
  function md_xlabels(period) local(i, t)
  (
    ng_col(NG_MUTED, 1);
    i = 1;
    loop(3,
      t = period * i / 2;
      t < 1 ? sprintf(#md_t, "%d ms", floor(t * 1000 + 0.5)) : sprintf(#md_t, "%.2f s", t);
      ng_ptxt(#md_t, ng_px + ng_pw * i / 4, ng_py + ng_ph + 10 * ng_s, 1);
      i += 1;
    );
  );

  // md_val across the plot in colour rgb at alpha a, shaded down to the bottom when fill = 1
  function md_curve(rgb, a, fill) local(i)
  (
    fill ? (
      ng_col(NG_ACCENT, 0.10);
      i = 0;
      loop(floor(ng_pw) + 1, gfx_line(ng_px + i, ng_py + ng_ph, ng_px + i, md_val(i / ng_pw), 0); i += 1;);
    );
    ng_col(rgb, a);
    i = 0;
    loop(floor(ng_pw) + 1,
      i == 0 ? ng_line_start(ng_px, md_val(0)) : ng_line_to(ng_px + i, md_val(i / ng_pw));
      i += 1;
    );
  );

  // dashed playhead at u (0..1) of the plot width
  function md_playhead(u) local(x, y)
  (
    x = floor(ng_px + max(0, min(1, u)) * ng_pw) + 0.5;
    ng_col(NG_ACCENT, 0.5);
    y = ng_py;
    while (
      gfx_line(x, y, x, min(y + 3 * ng_s, ng_py + ng_ph), 0);
      y += 6 * ng_s;
      y < ng_py + ng_ph;
    );
  );

  // dashed horizontal line at plot y
  function md_hline(y) local(x)
  (
    y = floor(y) + 0.5;
    x = ng_px;
    while (
      gfx_line(x, y, min(x + 3 * ng_s, ng_px + ng_pw), y, 0);
      x += 6 * ng_s;
      x < ng_px + ng_pw;
    );
  );

  // the name of Tempo Sync option s
  function md_note(s)
  (
    s == 1 ? "1/1" : s == 2 ? "1/2" : s == 3 ? "1/4" : s == 4 ? "1/8" : s == 5 ? "1/16" : s == 6 ? "2/1" :
    s == 7 ? "4/1" : s == 8 ? "1/4T" : s == 9 ? "1/8T" : s == 10 ? "1/4D" : "1/8D";
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 14;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1); ng_hist_add(2); ng_hist_add(3); ng_hist_add(4); ng_hist_add(5); ng_hist_add(6); ng_hist_add(7); ng_hist_add(8);
  ng_hist_init();

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 0.3); ng_slider_set(2, 5); ng_slider_set(3, 50); ng_slider_set(4, 40); ng_slider_set(5, 0.5); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 1 ? ( ng_slider_set(1, 0.2); ng_slider_set(2, 8); ng_slider_set(3, 70); ng_slider_set(4, 50); ng_slider_set(5, 0.5); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 2 ? ( ng_slider_set(1, 0.4); ng_slider_set(2, 3); ng_slider_set(3, 30); ng_slider_set(4, 35); ng_slider_set(5, 0.5); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 3 ? ( ng_slider_set(1, 0.1); ng_slider_set(2, 2); ng_slider_set(3, 85); ng_slider_set(4, 50); ng_slider_set(5, 0.5); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 4 ? ( ng_slider_set(1, 0.6); ng_slider_set(2, 5); ng_slider_set(3, 50); ng_slider_set(4, 40); ng_slider_set(5, 0.5); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 5 ? ( ng_slider_set(1, 3); ng_slider_set(2, 2); ng_slider_set(3, 40); ng_slider_set(4, 40); ng_slider_set(5, 0.5); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 6 ? ( ng_slider_set(1, 0.1); ng_slider_set(2, 15); ng_slider_set(3, 60); ng_slider_set(4, 50); ng_slider_set(5, 0.5); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 7 ? ( ng_slider_set(1, 0.1); ng_slider_set(2, 10); ng_slider_set(3, 80); ng_slider_set(4, 50); ng_slider_set(5, 0.3); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 8 ? ( ng_slider_set(1, 0.1); ng_slider_set(2, 6); ng_slider_set(3, 20); ng_slider_set(4, 50); ng_slider_set(5, 0.5); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 1); );
    p == 9 ? ( ng_slider_set(1, 0.2); ng_slider_set(2, 3); ng_slider_set(3, 0); ng_slider_set(4, 50); ng_slider_set(5, 0.5); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 1); );
    p == 10 ? ( ng_slider_set(1, 0.3); ng_slider_set(2, 6); ng_slider_set(3, 60); ng_slider_set(4, 50); ng_slider_set(5, 0.5); ng_slider_set(6, 1); ng_slider_set(7, 90); ng_slider_set(8, 0); );
    p == 11 ? ( ng_slider_set(1, 0.3); ng_slider_set(2, 2); ng_slider_set(3, 50); ng_slider_set(4, 40); ng_slider_set(5, 0.5); ng_slider_set(6, 4); ng_slider_set(7, 90); ng_slider_set(8, 0); );
    p == 12 ? ( ng_slider_set(1, 0.2); ng_slider_set(2, 1); ng_slider_set(3, 95); ng_slider_set(4, 50); ng_slider_set(5, 1.5); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 13 ? ( ng_slider_set(1, 0.3); ng_slider_set(2, 5); ng_slider_set(3, 50); ng_slider_set(4, 45); ng_slider_set(5, 0.5); ng_slider_set(6, 0); ng_slider_set(7, 180); ng_slider_set(8, 0); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 0.3) && ng_pre_eq(slider2, 5) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 40) && ng_pre_eq(slider5, 0.5) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 0.2) && ng_pre_eq(slider2, 8) && ng_pre_eq(slider3, 70) && ng_pre_eq(slider4, 50) && ng_pre_eq(slider5, 0.5) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 0.4) && ng_pre_eq(slider2, 3) && ng_pre_eq(slider3, 30) && ng_pre_eq(slider4, 35) && ng_pre_eq(slider5, 0.5) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 0.1) && ng_pre_eq(slider2, 2) && ng_pre_eq(slider3, 85) && ng_pre_eq(slider4, 50) && ng_pre_eq(slider5, 0.5) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 0.6) && ng_pre_eq(slider2, 5) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 40) && ng_pre_eq(slider5, 0.5) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 3) && ng_pre_eq(slider2, 2) && ng_pre_eq(slider3, 40) && ng_pre_eq(slider4, 40) && ng_pre_eq(slider5, 0.5) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 0.1) && ng_pre_eq(slider2, 15) && ng_pre_eq(slider3, 60) && ng_pre_eq(slider4, 50) && ng_pre_eq(slider5, 0.5) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 0.1) && ng_pre_eq(slider2, 10) && ng_pre_eq(slider3, 80) && ng_pre_eq(slider4, 50) && ng_pre_eq(slider5, 0.3) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 0.1) && ng_pre_eq(slider2, 6) && ng_pre_eq(slider3, 20) && ng_pre_eq(slider4, 50) && ng_pre_eq(slider5, 0.5) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 1) ? m = 8;
    m < 0 && ng_pre_eq(slider1, 0.2) && ng_pre_eq(slider2, 3) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 50) && ng_pre_eq(slider5, 0.5) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 1) ? m = 9;
    m < 0 && ng_pre_eq(slider1, 0.3) && ng_pre_eq(slider2, 6) && ng_pre_eq(slider3, 60) && ng_pre_eq(slider4, 50) && ng_pre_eq(slider5, 0.5) && ng_pre_eq(slider6, 1) && ng_pre_eq(slider7, 90) && ng_pre_eq(slider8, 0) ? m = 10;
    m < 0 && ng_pre_eq(slider1, 0.3) && ng_pre_eq(slider2, 2) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 40) && ng_pre_eq(slider5, 0.5) && ng_pre_eq(slider6, 4) && ng_pre_eq(slider7, 90) && ng_pre_eq(slider8, 0) ? m = 11;
    m < 0 && ng_pre_eq(slider1, 0.2) && ng_pre_eq(slider2, 1) && ng_pre_eq(slider3, 95) && ng_pre_eq(slider4, 50) && ng_pre_eq(slider5, 1.5) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 12;
    m < 0 && ng_pre_eq(slider1, 0.3) && ng_pre_eq(slider2, 5) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 45) && ng_pre_eq(slider5, 0.5) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 180) && ng_pre_eq(slider8, 0) ? m = 13;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Jet Sweep Drums";
    p == 2 ? s = "Subtle Guitar Flange";
    p == 3 ? s = "Metallic Resonance";
    p == 4 ? s = "Vocal Psychedelia";
    p == 5 ? s = "Fast Warble";
    p == 6 ? s = "Build-Up Swoosh";
    p == 7 ? s = "Jet Flange";
    p == 8 ? s = "Thru-Zero Jet";
    p == 9 ? s = "Thru-Zero Gentle";
    p == 10 ? s = "Synced Sweep";
    p == 11 ? s = "Synced Eighths";
    p == 12 ? s = "Metallic";
    p == 13 ? s = "Wide Stereo Flange";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@block
  sync > 0 ? (
    bpm = tempo > 0 ? tempo : 120;
    phase_inc = 6.28318530717958 * bpm / 60 / cyc / srate;
    // lock to the host grid while playing
    play_state & 1 ? phase = 6.28318530717958 * (beat_position / cyc - floor(beat_position / cyc));
  );

@sample
  phase >= 6.28318530717958 ? (phase = phase - 6.28318530717958;);
  fl_ph = phase;
  lfo = sin(phase);
  phase = phase + phase_inc;
  
  // sweep between Manual and Manual + Depth
  mod_delay = manual + depth * 0.5 * (1 + lfo);
  delay_samples = mod_delay * srate / 1000;
  
  rpos = wpos - delay_samples;
  rpos = rpos < 0 ? rpos + buf_size : rpos;
  
  rpos_i = floor(rpos);
  rpos_f = rpos - rpos_i;
  d1_l = delay_l[rpos_i];
  d2_l = delay_l[rpos_i >= buf_size - 1 ? 0 : rpos_i + 1];
  d_l = d1_l + (d2_l - d1_l) * rpos_f;
  
  st_off > 0 ? (
    // the right channel's own sweep
    mod_delay = manual + depth * 0.5 * (1 + sin(fl_ph + st_off));
    rpos = wpos - mod_delay * srate / 1000;
    rpos = rpos < 0 ? rpos + buf_size : rpos;
    rpos_i = floor(rpos);
    rpos_f = rpos - rpos_i;
  );
  d1_r = delay_r[rpos_i];
  d2_r = delay_r[rpos_i >= buf_size - 1 ? 0 : rpos_i + 1];
  d_r = d1_r + (d2_r - d1_r) * rpos_f;
  
  fb_in_l = spl0 + fb_l * fb_amt;
  fb_in_r = spl1 + fb_r * fb_amt;
  delay_l[wpos] = fb_in_l;
  delay_r[wpos] = fb_in_r;
  fb_l = d_l;
  fb_r = d_r;
  
  // the dry signal, kept for Thru Zero
  dry_l[wpos] = spl0;
  dry_r[wpos] = spl1;
  tz ? (
    fl_rd = wpos - tz_delay;
    fl_rd < 0 ? fl_rd += buf_size;
    spl0 = dry_l[fl_rd];
    spl1 = dry_r[fl_rd];
    d_l = -d_l;
    d_r = -d_r;
  );
  
  wpos = wpos + 1;
  wpos = wpos >= buf_size ? 0 : wpos;
  
  out_l = spl0 * (1 - mix_amt) + d_l * mix_amt;
  out_r = spl1 * (1 - mix_amt) + d_r * mix_amt;
  
  spl0 = out_l;
  spl1 = out_r;

@gfx 480 380
  ng_knobs_begin("FLANGER", "ESSENTIALS", 480, 120, 2, 0);

  // display: the delay time over two LFO cycles (0 to 32 ms), the LFO position dashed; the
  // right channel grey when Stereo Phase shifts it, the dry path's delay dashed in Thru-Zero
  md_bpm = tempo > 0 ? tempo : 120;
  md_sync = floor(slider6 + 0.5);
  md_period = md_sync > 0 ? fl_cycle(md_sync) * 60 / md_bpm : 1 / slider1;
  slider8 >= 0.5 ? strcpy(#md_a, "THRU-ZERO  ") : strcpy(#md_a, "");
  md_sync > 0 ? sprintf(#md_b, "%s  ", md_note(md_sync)) : strcpy(#md_b, "");
  sprintf(#md_r, "%s%s%.1f TO %.1f ms", #md_a, #md_b, slider5, slider5 + slider2);
  md_view("DELAY (ms)", #md_r);
  md_ylabels("32", "16", "0");
  md_xlabels(md_period);
  slider7 > 0 ? ( md_off = slider7 * $pi / 180; md_curve(NG_MUTED, 1, 0); );
  md_off = 0;
  md_curve(NG_ACCENT, 1, 1);
  slider8 >= 0.5 ? (
    ng_col(NG_TEXT, 0.6);
    md_hline(ng_lin_y(tz_delay * 1000 / srate, 0, 32));
  );
  md_playhead(phase / 6.28318530717958 / 2);

  ng_row(4);
  md_sync > 0 ? strcpy(#v1, md_note(md_sync)) : sprintf(#v1, "%.1f Hz", slider1);
  ng_knob_ctl(1, "RATE", #v1, 0.1, 5, 0.3, 0.1, 0) ? update();
  sprintf(#v2, "%.1f ms", slider2);
  ng_knob_ctl(2, "DEPTH", #v2, 1, 20, 5, 0.1, 0) ? update();
  sprintf(#v3, "%d%%", slider3);
  ng_knob_ctl(3, "FEEDBACK", #v3, 0, 100, 50, 1, 0) ? update();
  sprintf(#v4, "%d%%", slider4);
  ng_knob_ctl(4, "MIX", #v4, 0, 100, 40, 1, 0) ? update();
  ng_row(4);
  sprintf(#v5, "%.1f ms", slider5);
  ng_knob_ctl(5, "MANUAL", #v5, 0.1, 10, 0.5, 0.1, 0) ? update();
  ng_select_ctl(6, "SYNC", "OFF|1/1|1/2|1/4|1/8|1/16|2/1|4/1|1/4T|1/8T|1/4D|1/8D", 0) ? update();
  sprintf(#v7, "%d deg", slider7);
  ng_knob_ctl(7, "PHASE", #v7, 0, 180, 0, 1, 0) ? update();
  ng_select_ctl(8, "THRU-ZERO", "OFF|ON", 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
