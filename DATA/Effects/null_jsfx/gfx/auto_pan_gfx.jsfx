desc:NULL Auto Pan GFX
author: Christos Koulaxizis
tags: autopan pan modulation lfo movement stereo width tempo sync step pattern gui
//category: Essentials
//NULL JSFX v3.0 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:2<0.1,10,0.1>-Rate (Hz)
slider2:50<0,100,1>-Depth (%)
slider3:40<0,100,1>-Mix (%)
slider4:0<0,1,1{OFF,ON}>-Tempo Sync
slider5:0<0,3,1{1/2,1/4,1/8,1/16}>-Subdivision
slider6:0<0,5,1{SINE,2 STEPS,4 STEPS,8 STEPS,L-C-R,R-C-L}>-Mode
slider7:20<0,100,1>-Smoothing (%)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // NULL Auto Pan (../auto_pan.jsfx) with its own interface: same audio code, plus @gfx.
  phase = 0;
  calc_rate = 2;
  phase_inc = 6.28318530717958 * calc_rate / srate;
  tempo_sync = 0;
  mult = 0.5;
  // Mode: SINE moves the level with a sine LFO (the original plugin). The step modes jump between
  // pan positions instead, one step per LFO cycle (Rate, or one Subdivision note with Tempo Sync):
  // 2 STEPS = L R, 4 STEPS = L C R C, 8 STEPS = a stepped sweep L to R and back, L-C-R and
  // R-C-L = three-step paths. Smoothing glides into each step over that share of it (raised
  // cosine, at least 1 ms so steps never click).
  ap_step = 0;
  ap_n = 2;

  // pan position of step k in step mode m (+1 = left, -1 = right, as the LFO)
  function ap_val(m, k)
  (
    m == 1 ? (k == 0 ? 1 : -1) :
    m == 2 ? (k == 0 ? 1 : k == 2 ? -1 : 0) :
    m == 3 ? (k <= 4 ? 1 - k * 0.5 : -1 + (k - 4) * 0.5) :
    m == 4 ? 1 - k : k - 1;
  );
  gfx_ext_retina = 1;

  function update()
  (
    depth_pct = slider2 / 100;
    mix_amt = slider3 / 100;
    tempo_sync = slider4;
    subdivision = slider5;
    pmode = slider6;
    smooth = slider7 / 100;
    ap_n = pmode == 1 ? 2 : pmode == 2 ? 4 : pmode == 3 ? 8 : 3;
    ap_step >= ap_n ? ap_step = 0;

    subdivision == 0 ? mult = 0.5;
    subdivision == 1 ? mult = 1;
    subdivision == 2 ? mult = 2;
    subdivision == 3 ? mult = 4;

    tempo_sync == 0 ? (
      calc_rate = slider1;
      phase_inc = 6.28318530717958 * calc_rate / srate;
    );
  );

  // ---- modulation view: an info line over a plot of two LFO cycles (step modes: the pattern) ----
  // level of the left (md_ch 0) or right (1) channel at u (0..1 = two cycles, or the whole step
  // pattern), as a plot y
  function md_val(u) local(lfo, p, k, t, c, q)
  (
    slider6 ? (
      p = min(u * ap_n, ap_n - 0.000001);
      k = floor(p);
      t = (p - k) / max(slider7 / 100, 0.001 * calc_rate);
      c = ap_val(slider6, k);
      q = ap_val(slider6, k > 0 ? k - 1 : ap_n - 1);
      lfo = t < 1 ? q + (c - q) * (0.5 - 0.5 * cos($pi * t)) : c;
    ) : (
      lfo = sin(4 * $pi * u);
    );
    ng_lin_y(1 - slider3 / 100 + slider3 / 100 * (0.5 + (md_ch ? -0.5 : 0.5) * slider2 / 100 * lfo), 0, 1);
  );

  function md_view(left, right)
  (
    ng_plot(ng_vx + 26, ng_vy + 14, ng_vw - 30, ng_vh - 30);
    ng_grid(4, 4, 0);
    ng_font(4, 8, 0);
    ng_col(NG_MUTED, 1);
    ng_ptxt(left, ng_px, Y(ng_vy + 4), 0);
    ng_ptxt(right, ng_px + ng_pw, Y(ng_vy + 4), 2);
  );

  // labels at the top, middle and bottom of the plot
  function md_ylabels(top, mid, bot)
  (
    ng_col(NG_MUTED, 1);
    ng_ptxt(top, ng_px - 6 * ng_s, ng_py, 2);
    ng_ptxt(mid, ng_px - 6 * ng_s, ng_py + ng_ph / 2, 2);
    ng_ptxt(bot, ng_px - 6 * ng_s, ng_py + ng_ph, 2);
  );

  // times under the plot at 1/4, 1/2 and 3/4 of its width for a cycle of period seconds
  function md_xlabels(period) local(i, t)
  (
    ng_col(NG_MUTED, 1);
    i = 1;
    loop(3,
      t = period * i / 2;
      t < 1 ? sprintf(#md_t, "%d ms", floor(t * 1000 + 0.5)) : sprintf(#md_t, "%.2f s", t);
      ng_ptxt(#md_t, ng_px + ng_pw * i / 4, ng_py + ng_ph + 10 * ng_s, 1);
      i += 1;
    );
  );

  // md_val across the plot in colour rgb, shaded down to the bottom when fill = 1
  function md_curve(rgb, fill) local(i)
  (
    fill ? (
      ng_col(NG_ACCENT, 0.10);
      i = 0;
      loop(floor(ng_pw) + 1, gfx_line(ng_px + i, ng_py + ng_ph, ng_px + i, md_val(i / ng_pw), 0); i += 1;);
    );
    ng_col(rgb, 1);
    i = 0;
    loop(floor(ng_pw) + 1,
      i == 0 ? ng_line_start(ng_px, md_val(0)) : ng_line_to(ng_px + i, md_val(i / ng_pw));
      i += 1;
    );
  );

  // dashed playhead at u (0..1) of the plot width
  function md_playhead(u) local(x, y)
  (
    x = floor(ng_px + max(0, min(1, u)) * ng_pw) + 0.5;
    ng_col(NG_ACCENT, 0.5);
    y = ng_py;
    while (
      gfx_line(x, y, x, min(y + 3 * ng_s, ng_py + ng_ph), 0);
      y += 6 * ng_s;
      y < ng_py + ng_ph;
    );
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 13;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1); ng_hist_add(2); ng_hist_add(3); ng_hist_add(4); ng_hist_add(5); ng_hist_add(6); ng_hist_add(7);
  ng_hist_init();

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 2); ng_slider_set(2, 50); ng_slider_set(3, 40); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 20); );
    p == 1 ? ( ng_slider_set(1, 0.2); ng_slider_set(2, 60); ng_slider_set(3, 50); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 20); );
    p == 2 ? ( ng_slider_set(1, 0.5); ng_slider_set(2, 40); ng_slider_set(3, 30); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 20); );
    p == 3 ? ( ng_slider_set(1, 5); ng_slider_set(2, 80); ng_slider_set(3, 60); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 20); );
    p == 4 ? ( ng_slider_set(1, 2); ng_slider_set(2, 70); ng_slider_set(3, 60); ng_slider_set(4, 1); ng_slider_set(5, 1); ng_slider_set(6, 0); ng_slider_set(7, 20); );
    p == 5 ? ( ng_slider_set(1, 2); ng_slider_set(2, 60); ng_slider_set(3, 50); ng_slider_set(4, 1); ng_slider_set(5, 2); ng_slider_set(6, 0); ng_slider_set(7, 20); );
    p == 6 ? ( ng_slider_set(1, 2); ng_slider_set(2, 50); ng_slider_set(3, 40); ng_slider_set(4, 1); ng_slider_set(5, 3); ng_slider_set(6, 0); ng_slider_set(7, 20); );
    p == 7 ? ( ng_slider_set(1, 2); ng_slider_set(2, 100); ng_slider_set(3, 100); ng_slider_set(4, 1); ng_slider_set(5, 1); ng_slider_set(6, 1); ng_slider_set(7, 10); );
    p == 8 ? ( ng_slider_set(1, 2); ng_slider_set(2, 90); ng_slider_set(3, 80); ng_slider_set(4, 1); ng_slider_set(5, 2); ng_slider_set(6, 1); ng_slider_set(7, 0); );
    p == 9 ? ( ng_slider_set(1, 2); ng_slider_set(2, 100); ng_slider_set(3, 100); ng_slider_set(4, 1); ng_slider_set(5, 2); ng_slider_set(6, 4); ng_slider_set(7, 15); );
    p == 10 ? ( ng_slider_set(1, 2); ng_slider_set(2, 100); ng_slider_set(3, 100); ng_slider_set(4, 1); ng_slider_set(5, 3); ng_slider_set(6, 3); ng_slider_set(7, 30); );
    p == 11 ? ( ng_slider_set(1, 2); ng_slider_set(2, 80); ng_slider_set(3, 70); ng_slider_set(4, 1); ng_slider_set(5, 2); ng_slider_set(6, 2); ng_slider_set(7, 20); );
    p == 12 ? ( ng_slider_set(1, 0.5); ng_slider_set(2, 70); ng_slider_set(3, 60); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 5); ng_slider_set(7, 80); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 50) && ng_pre_eq(slider3, 40) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 20) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 0.2) && ng_pre_eq(slider2, 60) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 20) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 0.5) && ng_pre_eq(slider2, 40) && ng_pre_eq(slider3, 30) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 20) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 5) && ng_pre_eq(slider2, 80) && ng_pre_eq(slider3, 60) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 20) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 70) && ng_pre_eq(slider3, 60) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 1) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 20) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 60) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 2) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 20) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 50) && ng_pre_eq(slider3, 40) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 3) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 20) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 100) && ng_pre_eq(slider3, 100) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 1) && ng_pre_eq(slider6, 1) && ng_pre_eq(slider7, 10) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 90) && ng_pre_eq(slider3, 80) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 2) && ng_pre_eq(slider6, 1) && ng_pre_eq(slider7, 0) ? m = 8;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 100) && ng_pre_eq(slider3, 100) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 2) && ng_pre_eq(slider6, 4) && ng_pre_eq(slider7, 15) ? m = 9;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 100) && ng_pre_eq(slider3, 100) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 3) && ng_pre_eq(slider6, 3) && ng_pre_eq(slider7, 30) ? m = 10;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 80) && ng_pre_eq(slider3, 70) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 2) && ng_pre_eq(slider6, 2) && ng_pre_eq(slider7, 20) ? m = 11;
    m < 0 && ng_pre_eq(slider1, 0.5) && ng_pre_eq(slider2, 70) && ng_pre_eq(slider3, 60) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 5) && ng_pre_eq(slider7, 80) ? m = 12;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Slow Pad Drift";
    p == 2 ? s = "Ambience Motion";
    p == 3 ? s = "Fast Keys Tremolo";
    p == 4 ? s = "Quarter Note Pan";
    p == 5 ? s = "Eighth Note Guitar";
    p == 6 ? s = "Sixteenth Percussion";
    p == 7 ? s = "Ping Pong Quarters";
    p == 8 ? s = "Hard Ping Pong Eighths";
    p == 9 ? s = "L-C-R Eighths";
    p == 10 ? s = "Stepped Sweep Sixteenths";
    p == 11 ? s = "Four Step Bounce";
    p == 12 ? s = "Slow Path Drift";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@block
  tempo_sync == 1 ? (
    calc_rate = (tempo / 60) * mult;
    phase_inc = 6.28318530717958 * calc_rate / srate;
  );

@sample
  phase >= 6.28318530717958 ? (
    phase = phase - 6.28318530717958;
    ap_step += 1;
    ap_step >= ap_n ? ap_step = 0;
  );
  pmode ? (
    // step mode: glide from the last step's position over the first Smoothing share of the step
    ap_t = phase / 6.28318530717958 / max(smooth, 0.001 * calc_rate);
    ap_c = ap_val(pmode, ap_step);
    lfo = ap_t < 1 ? (
      ap_p = ap_val(pmode, ap_step > 0 ? ap_step - 1 : ap_n - 1);
      ap_p + (ap_c - ap_p) * (0.5 - 0.5 * cos($pi * ap_t));
    ) : ap_c;
  ) : (
    lfo = sin(phase);
  );
  phase = phase + phase_inc;

  left_gain = 0.5 + 0.5 * depth_pct * lfo;
  right_gain = 0.5 - 0.5 * depth_pct * lfo;

  proc_l = spl0 * left_gain;
  proc_r = spl1 * right_gain;

  out_l = spl0 * (1 - mix_amt) + proc_l * mix_amt;
  out_r = spl1 * (1 - mix_amt) + proc_r * mix_amt;

  spl0 = out_l;
  spl1 = out_r;

@gfx 480 380
  ng_knobs_begin("AUTO PAN", "ESSENTIALS", 480, 120, 2, 0);

  // display: the left and right levels over two LFO cycles (step modes: the whole pattern, one
  // step per cycle) from 0 to 100%, the LFO position dashed
  slider6 ? sprintf(#md_r, "%d STEPS AT %.2f Hz", ap_n, calc_rate) : sprintf(#md_r, "%.2f Hz", calc_rate);
  md_view("", #md_r);
  ng_col(NG_ACCENT, 1);
  ng_ptxt("LEFT", ng_px, Y(ng_vy + 4), 0);
  ng_col(NG_MUTED, 1);
  ng_ptxt("RIGHT", ng_px + 34 * ng_s, Y(ng_vy + 4), 0);
  md_ylabels("100%", "50%", "0%");
  calc_rate > 0 ? md_xlabels(slider6 ? ap_n / 2 / calc_rate : 1 / calc_rate);
  md_ch = 1;
  md_curve(NG_MUTED, 0);
  md_ch = 0;
  md_curve(NG_ACCENT, 1);
  md_playhead(slider6 ? (ap_step + phase / 6.28318530717958) / ap_n : phase / 6.28318530717958 / 2);

  ng_row(5);
  slider4 ? sprintf(#v1, "%.2f Hz", calc_rate) : sprintf(#v1, "%.1f Hz", slider1);
  ng_knob_ctl(1, "RATE", #v1, 0.1, 10, 2, 0.1, 0) ? update();
  sprintf(#v2, "%d%%", slider2);
  ng_knob_ctl(2, "DEPTH", #v2, 0, 100, 50, 1, 0) ? update();
  sprintf(#v3, "%d%%", slider3);
  ng_knob_ctl(3, "MIX", #v3, 0, 100, 40, 1, 0) ? update();
  ng_select_ctl(4, "SYNC", "OFF|ON", 0) ? update();
  ng_select_ctl(5, "NOTE", "1/2|1/4|1/8|1/16", 0) ? update();
  ng_row(2);
  ng_select_ctl(6, "MODE", "SINE|2 STEPS|4 STEPS|8 STEPS|L-C-R|R-C-L", 0) ? update();
  sprintf(#v7, "%d%%", slider7);
  ng_knob_ctl(7, "SMOOTHING", #v7, 0, 100, 20, 1, 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
