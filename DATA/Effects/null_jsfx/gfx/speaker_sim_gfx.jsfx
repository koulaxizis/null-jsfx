desc:NULL Speaker Sim GFX
author: Christos Koulaxizis
tags: speaker simulator device phone laptop earbuds tv radio telephone megaphone car mix check lo-fi small speaker gui
//category: Essentials
//NULL JSFX v2.9 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:0<0,7,1{Phone,Laptop,Earbuds,TV,Radio,Telephone,Megaphone,Car}>-Device
slider2:100<0,100,1>-Mix (%)
slider3:0<0,100,1>-Drive (%)
slider4:0<-24,12,0.1>-Output (dB)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep the filters, as in the VST3/CLAP
  // NULL Speaker Sim (../speaker_sim.jsfx) with its own interface: same audio code, plus @gfx.
  // How a mix sounds through small or everyday speakers: on the monitor FX for a quick check,
  // or as an effect on a voice. Each Device is a 24 dB/oct high-pass (Butterworth, two
  // biquads), two peaking bands for its resonances, a soft clip and a 24 dB/oct low-pass;
  // Phone, Radio, Telephone and Megaphone are mono (the two channels summed first). Drive adds
  // to the device's own clipping (only Megaphone has some at 0 %): the clip is tanh(g x) / g,
  // so quiet passages keep their level and peaks above 1 / g are squashed. Mix blends with the
  // dry signal, Output sets the level after it.
  DEV = 0;                     // per device: mono, hp, lp, f1, g1, q1, f2, g2, q2, drive (10 each)
  dv = 0;
  // Phone
  DEV[dv] = 1; DEV[dv+1] = 450; DEV[dv+2] = 9000; DEV[dv+3] = 1200; DEV[dv+4] = 4; DEV[dv+5] = 1.2; DEV[dv+6] = 3500; DEV[dv+7] = 5; DEV[dv+8] = 1.5; DEV[dv+9] = 0; dv += 10;
  // Laptop
  DEV[dv] = 0; DEV[dv+1] = 220; DEV[dv+2] = 14000; DEV[dv+3] = 800; DEV[dv+4] = 3; DEV[dv+5] = 1; DEV[dv+6] = 4000; DEV[dv+7] = 4; DEV[dv+8] = 2; DEV[dv+9] = 0; dv += 10;
  // Earbuds
  DEV[dv] = 0; DEV[dv+1] = 70; DEV[dv+2] = 15000; DEV[dv+3] = 2800; DEV[dv+4] = 5; DEV[dv+5] = 1.4; DEV[dv+6] = 7000; DEV[dv+7] = -3; DEV[dv+8] = 2; DEV[dv+9] = 0; dv += 10;
  // TV
  DEV[dv] = 0; DEV[dv+1] = 130; DEV[dv+2] = 12000; DEV[dv+3] = 350; DEV[dv+4] = 2; DEV[dv+5] = 1; DEV[dv+6] = 2500; DEV[dv+7] = 3; DEV[dv+8] = 1.2; DEV[dv+9] = 0; dv += 10;
  // Radio
  DEV[dv] = 1; DEV[dv+1] = 180; DEV[dv+2] = 5500; DEV[dv+3] = 1000; DEV[dv+4] = 4; DEV[dv+5] = 0.9; DEV[dv+6] = 2500; DEV[dv+7] = 2; DEV[dv+8] = 1; DEV[dv+9] = 0; dv += 10;
  // Telephone
  DEV[dv] = 1; DEV[dv+1] = 320; DEV[dv+2] = 3400; DEV[dv+3] = 1500; DEV[dv+4] = 5; DEV[dv+5] = 1; DEV[dv+6] = 2800; DEV[dv+7] = 3; DEV[dv+8] = 1.5; DEV[dv+9] = 0; dv += 10;
  // Megaphone
  DEV[dv] = 1; DEV[dv+1] = 550; DEV[dv+2] = 4200; DEV[dv+3] = 1800; DEV[dv+4] = 9; DEV[dv+5] = 1.3; DEV[dv+6] = 3000; DEV[dv+7] = 4; DEV[dv+8] = 2; DEV[dv+9] = 0.5; dv += 10;
  // Car
  DEV[dv] = 0; DEV[dv+1] = 40; DEV[dv+2] = 16000; DEV[dv+3] = 65; DEV[dv+4] = 6; DEV[dv+5] = 0.9; DEV[dv+6] = 3000; DEV[dv+7] = -3; DEV[dv+8] = 1; DEV[dv+9] = 0; dv += 10;
  ST = 100;                    // filter state: 6 biquads x 2 channels x 2 values
  memset(ST, 0, 24);

  // tanh (EEL2 has none): (e^2x - 1) / (e^2x + 1), clamped
  function ss_tanh(x) local(e)
  (
    x > 20 ? 1 : x < -20 ? -1 : (e = exp(2 * x); (e - 1) / (e + 1));
  );

  // RBJ biquads: kind 0 = high-pass, 1 = low-pass (Q q), 2 = peaking (gain g dB, Q q)
  function ss_bq(kind, f, q, g) local(w0, cw, al, a0, A)
  (
    w0 = 2 * $pi * min(f, 0.45 * srate) / srate;
    cw = cos(w0);
    al = sin(w0) / (2 * q);
    kind == 2 ? (
      A = 10 ^ (g / 40);
      a0 = 1 + al / A;
      this.b0 = (1 + al * A) / a0;
      this.b1 = -2 * cw / a0;
      this.b2 = (1 - al * A) / a0;
      this.a1 = this.b1;
      this.a2 = (1 - al / A) / a0;
    ) : (
      a0 = 1 + al;
      this.b0 = (kind ? (1 - cw) / 2 : (1 + cw) / 2) / a0;
      this.b1 = (kind ? 1 - cw : -(1 + cw)) / a0;
      this.b2 = this.b0;
      this.a1 = -2 * cw / a0;
      this.a2 = (1 - al) / a0;
    );
  );

  // run sample x through a biquad whose state is at ST[s], ST[s + 1]
  function ss_run(x, s) local(y)
  (
    y = this.b0 * x + ST[s];
    ST[s] = this.b1 * x - this.a1 * y + ST[s + 1];
    ST[s + 1] = this.b2 * x - this.a2 * y;
    y;
  );

  function ss_chain(x, c)
  (
    x = f1.ss_run(x, c * 12);
    x = f2.ss_run(x, c * 12 + 2);
    x = f3.ss_run(x, c * 12 + 4);
    x = f4.ss_run(x, c * 12 + 6);
    drv > 0 ? x = ss_tanh(dg * x) / dg;
    x = f5.ss_run(x, c * 12 + 8);
    f6.ss_run(x, c * 12 + 10);
  );
  gfx_ext_retina = 1;

  function update()
  (
    dv = slider1 * 10;
    mono = DEV[dv];
    f1.ss_bq(0, DEV[dv + 1], 0.5411961001461969, 0);
    f2.ss_bq(0, DEV[dv + 1], 1.3065629648763766, 0);
    f3.ss_bq(2, DEV[dv + 3], DEV[dv + 5], DEV[dv + 4]);
    f4.ss_bq(2, DEV[dv + 6], DEV[dv + 8], DEV[dv + 7]);
    f5.ss_bq(1, DEV[dv + 2], 0.5411961001461969, 0);
    f6.ss_bq(1, DEV[dv + 2], 1.3065629648763766, 0);
    drv = DEV[dv + 9] + slider3 / 100;
    dg = 1 + 8 * drv;
    mix = slider2 / 100;
    og = 10 ^ (slider4 / 20);
  );

  // |H|^2 of this biquad at angular frequency w
  function ss_pow(w) local(c1, s1, c2, s2, nr, ni, dr, di)
  (
    c1 = cos(w); s1 = sin(w); c2 = cos(2 * w); s2 = sin(2 * w);
    nr = this.b0 + this.b1 * c1 + this.b2 * c2;
    ni = -(this.b1 * s1 + this.b2 * s2);
    dr = 1 + this.a1 * c1 + this.a2 * c2;
    di = -(this.a1 * s1 + this.a2 * s2);
    (nr * nr + ni * ni) / (dr * dr + di * di);
  );

  // the device's filters in dB at f (clip, Mix and Output left out)
  function ss_db(f) local(w)
  (
    w = 2 * $pi * min(f, srate * 0.499) / srate;
    10 * log10(max(f1.ss_pow(w) * f2.ss_pow(w) * f3.ss_pow(w) * f4.ss_pow(w) * f5.ss_pow(w) * f6.ss_pow(w), 0.0000000001));
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 10;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1); ng_hist_add(2); ng_hist_add(3); ng_hist_add(4);
  ng_hist_init();

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 0); ng_slider_set(2, 100); ng_slider_set(3, 0); ng_slider_set(4, 0); );
    p == 1 ? ( ng_slider_set(1, 0); ng_slider_set(2, 100); ng_slider_set(3, 0); ng_slider_set(4, 0); );
    p == 2 ? ( ng_slider_set(1, 1); ng_slider_set(2, 100); ng_slider_set(3, 0); ng_slider_set(4, 0); );
    p == 3 ? ( ng_slider_set(1, 2); ng_slider_set(2, 100); ng_slider_set(3, 0); ng_slider_set(4, 0); );
    p == 4 ? ( ng_slider_set(1, 7); ng_slider_set(2, 100); ng_slider_set(3, 0); ng_slider_set(4, 0); );
    p == 5 ? ( ng_slider_set(1, 4); ng_slider_set(2, 100); ng_slider_set(3, 25); ng_slider_set(4, 0); );
    p == 6 ? ( ng_slider_set(1, 5); ng_slider_set(2, 100); ng_slider_set(3, 15); ng_slider_set(4, 3); );
    p == 7 ? ( ng_slider_set(1, 6); ng_slider_set(2, 100); ng_slider_set(3, 40); ng_slider_set(4, 2); );
    p == 8 ? ( ng_slider_set(1, 4); ng_slider_set(2, 50); ng_slider_set(3, 0); ng_slider_set(4, 0); );
    p == 9 ? ( ng_slider_set(1, 3); ng_slider_set(2, 100); ng_slider_set(3, 0); ng_slider_set(4, -6); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 100) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 100) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 100) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 100) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 7) && ng_pre_eq(slider2, 100) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 4) && ng_pre_eq(slider2, 100) && ng_pre_eq(slider3, 25) && ng_pre_eq(slider4, 0) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 5) && ng_pre_eq(slider2, 100) && ng_pre_eq(slider3, 15) && ng_pre_eq(slider4, 3) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 6) && ng_pre_eq(slider2, 100) && ng_pre_eq(slider3, 40) && ng_pre_eq(slider4, 2) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 4) && ng_pre_eq(slider2, 50) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) ? m = 8;
    m < 0 && ng_pre_eq(slider1, 3) && ng_pre_eq(slider2, 100) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, -6) ? m = 9;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Phone Check";
    p == 2 ? s = "Laptop Check";
    p == 3 ? s = "Earbuds Check";
    p == 4 ? s = "Car Check";
    p == 5 ? s = "Old Radio";
    p == 6 ? s = "Phone Call Voice";
    p == 7 ? s = "Megaphone Shout";
    p == 8 ? s = "Half Radio Blend";
    p == 9 ? s = "TV In The Next Room";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  mono ? (
    m = (spl0 + spl1) * 0.5;
    wl = wr = ss_chain(m, 0);
  ) : (
    wl = ss_chain(spl0, 0);
    wr = ss_chain(spl1, 1);
  );
  spl0 = (spl0 + (wl - spl0) * mix) * og;
  spl1 = (spl1 + (wr - spl1) * mix) * og;

@gfx 480 294
  ng_knobs_begin("SPEAKER SIM", "ESSENTIALS", 480, 120, 1, 0);

  // display: the device's response from 20 Hz to 20 kHz, its name and whether it is mono
  sk_px = ng_vx + 26; sk_py = ng_vy + 4; sk_pw = ng_vw - 30; sk_ph = ng_vh - 20;
  ng_plot(sk_px, sk_py, sk_pw, sk_ph);
  ng_grid_freq(36);
  sk_zy = ng_lin_y(-24, -24, 24);
  ng_col(NG_ACCENT, 0.10);
  sk_i = 0;
  loop(floor(ng_pw) + 1,
    gfx_line(ng_px + sk_i, sk_zy, ng_px + sk_i, ng_lin_y(ss_db(20 * 1000 ^ (sk_i / ng_pw)), -24, 24), 0);
    sk_i += 1;
  );
  ng_col(NG_ACCENT, 1);
  sk_i = 0;
  loop(floor(ng_pw) + 1,
    sk_yy = ng_lin_y(ss_db(20 * 1000 ^ (sk_i / ng_pw)), -24, 24);
    sk_i == 0 ? ng_line_start(ng_px, sk_yy) : ng_line_to(ng_px + sk_i, sk_yy);
    sk_i += 1;
  );
  ng_font(1, 7, 1);
  ng_col(NG_ACCENT, 1);
  strcpy(#sk_n, slider1 == 0 ? "PHONE" : slider1 == 1 ? "LAPTOP" : slider1 == 2 ? "EARBUDS" : slider1 == 3 ? "TV" :
                slider1 == 4 ? "RADIO" : slider1 == 5 ? "TELEPHONE" : slider1 == 6 ? "MEGAPHONE" : "CAR");
  ng_txt(#sk_n, sk_px + sk_pw - 4, sk_py + 8, 2, 1);
  ng_col(NG_MUTED, 1);
  ng_txt(mono ? "MONO" : "STEREO", sk_px + sk_pw - 4, sk_py + 20, 2, 1);

  ng_row(4);
  ng_select_ctl(1, "DEVICE", "PHONE|LAPTOP|EARBUDS|TV|RADIO|TELEPHONE|MEGAPHONE|CAR", 0) ? update();
  sprintf(#sk_v2, "%d%%", slider2);
  ng_knob_ctl(2, "MIX", #sk_v2, 0, 100, 100, 1, 0) ? update();
  sprintf(#sk_v3, "%d%%", slider3);
  ng_knob_ctl(3, "DRIVE", #sk_v3, 0, 100, 0, 1, 0) ? update();
  sprintf(#sk_v4, "%+.1f dB", slider4);
  ng_knob_ctl(4, "OUTPUT", #sk_v4, -24, 12, 0, 0.1, 1) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
