desc:NULL Phase Distortion GFX
author: Christos Koulaxizis
tags: phase distortion pd modulation delay fm self sidechain keyed bright digital grit sound design gui
//category: Advanced
//NULL JSFX v4.2.1 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:50<0,100,1>-Drive (%)
slider2:2000<100,20000,1:log>-Tone (Hz)
slider3:0<-100,100,1>-Bias (%)
slider4:0<0,100,1>-Spread (%)
slider5:0<0,1,1{Self,Sidechain}>-Source
slider6:100<0,100,1>-Mix (%)
slider7:0<-24,12,0.1>-Output (dB)

in_pin:Left
in_pin:Right
in_pin:Sidechain Left
in_pin:Sidechain Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // NULL Phase Distortion (../phase_distortion.jsfx) with its own interface: same audio code, plus @gfx.
  // Phase distortion: a very short delay whose time follows a signal, the track itself (Self)
  // or the sidechain on channels 3/4. Moving the delay bends the phase of the sound, a bright,
  // "digital" distortion that never clips. Drive sets how far the delay moves (up to 3 ms),
  // Tone low-passes the signal that moves it, Bias offsets it (asymmetry), Spread turns the
  // right channel's movement the other way (width), Mix blends with the dry signal, which is
  // delayed by the same centre time so the blend does not comb.
  pd_n = ceil(srate * 0.008) + 8;
  pd_bl = 0;
  pd_br = pd_n;
  memset(0, 0, pd_n * 2); freembuf(pd_n * 2);
  pd_wp = 0;
  pd_ml = pd_mr = 0;

  // the value delay samples behind the write position in the buffer at b, interpolated
  function pd_read(b, d) local(rp, i0, i1, fr)
  (
    rp = pd_wp - d;
    rp < 0 ? rp += pd_n;
    i0 = floor(rp);
    fr = rp - i0;
    i1 = i0 + 1;
    i1 >= pd_n ? i1 = 0;
    b[i0] + (b[i1] - b[i0]) * fr;
  );
  gfx_ext_retina = 1;

  function update()
  (
    pd_depth = (slider1 / 100) ^ 2 * 0.003 * srate;
    pd_tc = 1 - exp(-2 * $pi * min(slider2, 0.45 * srate) / srate);
    pd_bias = slider3 / 100;
    pd_sp = 1 - 2 * slider4 / 100;
    pd_key = slider5;
    pd_mix = slider6 / 100;
    pd_out = 10 ^ (slider7 / 20);
  );

  // the display: a 440 Hz sine at -6 dB through the effect (Tone, Spread and Mix left out),
  // at phase p (radians) of the input, the centre delay (the same for the dry signal) left out
  function pd_shape(p) ( sin(p - 2 * $pi * 440 * pd_depth * min(1, max(-1, 0.5 * sin(p) + pd_bias)) / srate); );
  function pd_hz_txt(f) ( f >= 1000 ? sprintf(#pd_v, "%.1f kHz", f / 1000) : sprintf(#pd_v, "%d Hz", f); #pd_v; );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 13;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1); ng_hist_add(2); ng_hist_add(3); ng_hist_add(4); ng_hist_add(5); ng_hist_add(6); ng_hist_add(7);
  ng_hist_init();
  ng_dice_add(1, 0, 100, 1, 0); ng_dice_add(2, 100, 20000, 1, 1); ng_dice_add(3, -100, 100, 1, 0); ng_dice_add(4, 0, 100, 1, 0); ng_dice_add(5, 0, 1, 1, 0);

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 50); ng_slider_set(2, 2000); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 100); ng_slider_set(7, 0); );
    p == 1 ? ( ng_slider_set(1, 25); ng_slider_set(2, 3000); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 60); ng_slider_set(7, 0); );
    p == 2 ? ( ng_slider_set(1, 60); ng_slider_set(2, 800); ng_slider_set(3, 20); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 100); ng_slider_set(7, 0); );
    p == 3 ? ( ng_slider_set(1, 75); ng_slider_set(2, 5000); ng_slider_set(3, 10); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 100); ng_slider_set(7, 0); );
    p == 4 ? ( ng_slider_set(1, 45); ng_slider_set(2, 6000); ng_slider_set(3, 0); ng_slider_set(4, 100); ng_slider_set(5, 0); ng_slider_set(6, 70); ng_slider_set(7, 0); );
    p == 5 ? ( ng_slider_set(1, 55); ng_slider_set(2, 2000); ng_slider_set(3, 60); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 100); ng_slider_set(7, 0); );
    p == 6 ? ( ng_slider_set(1, 70); ng_slider_set(2, 200); ng_slider_set(3, -30); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 100); ng_slider_set(7, 0); );
    p == 7 ? ( ng_slider_set(1, 40); ng_slider_set(2, 1500); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 40); ng_slider_set(7, 0); );
    p == 8 ? ( ng_slider_set(1, 20); ng_slider_set(2, 8000); ng_slider_set(3, 0); ng_slider_set(4, 50); ng_slider_set(5, 0); ng_slider_set(6, 35); ng_slider_set(7, 0); );
    p == 9 ? ( ng_slider_set(1, 65); ng_slider_set(2, 400); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 1); ng_slider_set(6, 100); ng_slider_set(7, 0); );
    p == 10 ? ( ng_slider_set(1, 80); ng_slider_set(2, 6000); ng_slider_set(3, 0); ng_slider_set(4, 60); ng_slider_set(5, 1); ng_slider_set(6, 100); ng_slider_set(7, 0); );
    p == 11 ? ( ng_slider_set(1, 100); ng_slider_set(2, 12000); ng_slider_set(3, 40); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 100); ng_slider_set(7, 0); );
    p == 12 ? ( ng_slider_set(1, 50); ng_slider_set(2, 4000); ng_slider_set(3, 0); ng_slider_set(4, 30); ng_slider_set(5, 0); ng_slider_set(6, 80); ng_slider_set(7, 0); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 50) && ng_pre_eq(slider2, 2000) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 25) && ng_pre_eq(slider2, 3000) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 60) && ng_pre_eq(slider7, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 60) && ng_pre_eq(slider2, 800) && ng_pre_eq(slider3, 20) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 75) && ng_pre_eq(slider2, 5000) && ng_pre_eq(slider3, 10) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 45) && ng_pre_eq(slider2, 6000) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 70) && ng_pre_eq(slider7, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 55) && ng_pre_eq(slider2, 2000) && ng_pre_eq(slider3, 60) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 70) && ng_pre_eq(slider2, 200) && ng_pre_eq(slider3, -30) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 40) && ng_pre_eq(slider2, 1500) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 40) && ng_pre_eq(slider7, 0) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 20) && ng_pre_eq(slider2, 8000) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 50) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 35) && ng_pre_eq(slider7, 0) ? m = 8;
    m < 0 && ng_pre_eq(slider1, 65) && ng_pre_eq(slider2, 400) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 1) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) ? m = 9;
    m < 0 && ng_pre_eq(slider1, 80) && ng_pre_eq(slider2, 6000) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 60) && ng_pre_eq(slider5, 1) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) ? m = 10;
    m < 0 && ng_pre_eq(slider1, 100) && ng_pre_eq(slider2, 12000) && ng_pre_eq(slider3, 40) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) ? m = 11;
    m < 0 && ng_pre_eq(slider1, 50) && ng_pre_eq(slider2, 4000) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 30) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 80) && ng_pre_eq(slider7, 0) ? m = 12;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Subtle Edge";
    p == 2 ? s = "Bright Bass Grit";
    p == 3 ? s = "Digital Lead";
    p == 4 ? s = "Wide Shimmer";
    p == 5 ? s = "Asymmetric Bite";
    p == 6 ? s = "Dark Warp";
    p == 7 ? s = "Drum Bus Crunch";
    p == 8 ? s = "Vocal Sparkle";
    p == 9 ? s = "Keyed Kick Warp";
    p == 10 ? s = "Keyed Cross Mod";
    p == 11 ? s = "Extreme Bend";
    p == 12 ? s = "Guitar Glass";
    s;
  );

  // the hint line under the controls: a short help text per slider (from tools/site_content.json)
  function ng_hint_text(i) local(s)
  (
    s = "";
    i == 1 ? s = "How far the delay moves, up to 3 ms (on a square curve, so the low half stays subtle)";
    i == 2 ? s = "Low-pass on the signal that moves the delay: lower values make a smoother, darker bend, higher values a";
    i == 3 ? s = "Offset added to the moving signal: the bend becomes asymmetric (even harmonics)";
    i == 4 ? s = "Turns the right channel's movement the other way, for width";
    i == 5 ? s = "What moves the delay: the track itself (Self) or the sidechain on channels 3/4";
    i == 6 ? s = "Blend with the dry signal, which is delayed by the same centre time so the blend does not comb";
    i == 7 ? s = "Output level";
    s;
  );

  function ng_presets() local(i)
  (
    ng_hint_i > 0 && !ng_pre_open ? ng_hint(ng_hint_text(ng_hint_i));
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  pd_xl = spl0;
  pd_xr = spl1;
  pd_bl[pd_wp] = pd_xl;
  pd_br[pd_wp] = pd_xr;
  pd_ml += ((pd_key ? spl2 : pd_xl) - pd_ml) * pd_tc;
  pd_mr += ((pd_key ? spl3 : pd_xr) - pd_mr) * pd_tc;
  pd_dl = 1 + pd_depth * (1 + min(1, max(-1, pd_ml + pd_bias)));
  pd_dr = 1 + pd_depth * (1 + min(1, max(-1, pd_mr * pd_sp + pd_bias)));
  pd_c = 1 + pd_depth;
  pd_wl = pd_read(pd_bl, pd_dl);
  pd_wr = pd_read(pd_br, pd_dr);
  pd_yl = pd_read(pd_bl, pd_c);
  pd_yr = pd_read(pd_br, pd_c);
  pd_wp += 1;
  pd_wp >= pd_n ? pd_wp = 0;
  spl0 = (pd_yl + (pd_wl - pd_yl) * pd_mix) * pd_out;
  spl1 = (pd_yr + (pd_wr - pd_yr) * pd_mix) * pd_out;

@gfx 480 380
  ng_knobs_begin("PHASE DISTORTION", "ADVANCED", 480, 120, 2, 0);

  // display: two cycles of a 440 Hz sine at -6 dB (dim) and what the effect makes of it
  // (Tone, Spread and Mix left out)
  ng_plot(ng_vx + 26, ng_vy + 4, ng_vw - 40, ng_vh - 20);
  ng_grid(8, 2, 0);
  ng_font(4, 8, 0);
  ng_col(NG_MUTED, 1);
  ng_ptxt("+1", ng_px - 6 * ng_s, ng_py, 2);
  ng_ptxt("0", ng_px - 6 * ng_s, ng_py + ng_ph / 2, 2);
  ng_ptxt("-1", ng_px - 6 * ng_s, ng_py + ng_ph, 2);
  ng_ptxt(slider5 ? "SINE IN, KEYED BY THE SIDECHAIN" : "SINE IN, MOVED BY ITSELF", ng_px, ng_py + ng_ph + 10 * ng_s, 0);
  ng_col(NG_MUTED, 0.6);
  pd_i = 0;
  loop(floor(ng_pw) + 1,
    pd_y = ng_lin_y(sin(4 * $pi * pd_i / ng_pw), -1, 1);
    pd_i == 0 ? ng_line_start(ng_px, pd_y) : ng_line_to(ng_px + pd_i, pd_y);
    pd_i += 1;
  );
  ng_col(NG_ACCENT, 1);
  pd_i = 0;
  loop(floor(ng_pw) + 1,
    pd_y = ng_lin_y(slider5 ? sin(4 * $pi * pd_i / ng_pw) : pd_shape(4 * $pi * pd_i / ng_pw), -1, 1);
    pd_i == 0 ? ng_line_start(ng_px, pd_y) : ng_line_to(ng_px + pd_i, pd_y);
    pd_i += 1;
  );

  ng_row(4);
  sprintf(#v1, "%d%%", slider1);
  ng_knob_ctl(1, "DRIVE", #v1, 0, 100, 50, 1, 0) ? update();
  ng_knob_ctl_log(2, "TONE", pd_hz_txt(slider2), 100, 20000, 2000, 1) ? update();
  sprintf(#v3, "%d%%", slider3);
  ng_knob_ctl(3, "BIAS", #v3, -100, 100, 0, 1, 1) ? update();
  sprintf(#v4, "%d%%", slider4);
  ng_knob_ctl(4, "SPREAD", #v4, 0, 100, 0, 1, 0) ? update();
  ng_row(3);
  ng_select_ctl(5, "SOURCE", "SELF|SIDECHAIN", 0) ? update();
  sprintf(#v6, "%d%%", slider6);
  ng_knob_ctl(6, "MIX", #v6, 0, 100, 100, 1, 0) ? update();
  sprintf(#v7, "%.1f dB", slider7);
  ng_knob_ctl(7, "OUTPUT", #v7, -24, 12, 0, 0.1, 1) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
