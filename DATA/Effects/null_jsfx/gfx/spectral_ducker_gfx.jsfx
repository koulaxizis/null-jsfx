desc:NULL Spectral Ducker GFX
author: Christos Koulaxizis
tags: sidechain spectral ducking ducker trackspacer vocal space mix eq advanced gui
//category: Advanced
//NULL JSFX v2.6 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:50<0,100,1>-Amount (%)
slider2:-40<-60,0,0.5>-Threshold (dB)
slider3:5<0.1,100,0.1:log>-Attack (ms)
slider4:150<10,1000,1:log>-Release (ms)
slider5:20<20,5000,1:log>-Low Cut (Hz)
slider6:20000<200,20000,1:log>-High Cut (Hz)
slider7:0<0,2,1{Stereo,Mid,Side}>-Channels
slider8:100<0,100,1>-Mix (%)
slider9:0<-12,12,0.1>-Output (dB)
slider10:0<0,1,1{Output,Delta}>-Listen

in_pin:Left
in_pin:Right
in_pin:Sidechain Left
in_pin:Sidechain Right
out_pin:Left
out_pin:Right

@init
  // NULL Spectral Ducker (../spectral_ducker.jsfx) with its own interface: same audio code, plus @gfx.
  // Spectral Ducker: makes room for the key (a vocal, a lead) inside the track, band by band.
  // Route the key to track channels 3/4. A bank of 32 fourth-order band passes (30 Hz - 18 kHz,
  // about a third of an octave apart) follows the key's level in each band; where a band goes
  // above Threshold, a bell on the same band cuts the track by the excess, up to Amount (100% =
  // 24 dB). The bells overlap (Q 3), so each cuts 0.43 of its band's amount and together they
  // cut about the amount. Only the bands between Low Cut and High Cut duck. The gains are worked
  // out every 16 samples; zero latency. Channels picks stereo, mid or side; Listen Delta plays
  // what is taken.
  SD_KC = 0;      // key band pass per band: b0 a1 a2 (b1 = 0, b2 = -b0)
  SD_KS = 96;     // key filter state per band, two stages: x1 x2 y1 y2, x1 x2 y1 y2
  SD_ENV = 352;   // key level per band (amplitude)
  SD_GR = 384;    // gain reduction per band (dB, positive = cut)
  SD_MC = 416;    // track bell per band: b0 b1 b2 a1 a2
  SD_MS = 576;    // track state per band: x1 x2 y1 y2 for L (or mid / side), then R
  SD_CW = 832;    // per band: cos(w), alpha of the bell, on (inside Low Cut .. High Cut)
  SD_AL = 864;
  SD_ON = 896;
  memset(0, 0, 928);
  sg_cnt = 0;

  // the bells' coefficients from the current gain reductions
  function sg_bells() local(k, aa, a0, c)
  (
    k = 0;
    loop(32,
      aa = 10 ^ (-SD_GR[k] * 0.43 / 40);
      a0 = 1 + SD_AL[k] / aa;
      c = SD_MC + k * 5;
      c[0] = (1 + SD_AL[k] * aa) / a0;
      c[1] = -2 * SD_CW[k] / a0;
      c[2] = (1 - SD_AL[k] * aa) / a0;
      c[3] = c[1];
      c[4] = (1 - SD_AL[k] / aa) / a0;
      k += 1;
    );
  );

  // the gain reductions from the key levels, then the bells
  function sg_gains() local(k, over)
  (
    k = 0;
    loop(32,
      over = 20 * log10(max(SD_ENV[k], 0.000000001)) - sg_thr;
      SD_GR[k] = SD_ON[k] && over > 0 ? min(sg_cut, over) : 0;
      k += 1;
    );
    sg_bells();
  );

  // x through the 32 bells with the state at s (8 apart per band)
  function sg_run(x, s) local(k, c, y)
  (
    k = 0;
    loop(32,
      c = SD_MC + k * 5;
      y = c[0] * x + c[1] * s[0] + c[2] * s[1] - c[3] * s[2] - c[4] * s[3];
      s[1] = s[0]; s[0] = x; s[3] = s[2]; s[2] = y;
      x = y;
      s += 8;
      k += 1;
    );
    x;
  );

  function update() local(k, f, w, al)
  (
    k = 0;
    loop(32,
      f = 30 * 600 ^ (k / 31);
      w = 2 * $pi * min(f, srate * 0.49) / srate;
      // key: a band pass as wide as the band spacing (Q 4.84); track: a wider bell (Q 3)
      al = sin(w) / (2 * 4.84);
      SD_KC[k * 3] = al / (1 + al);
      SD_KC[k * 3 + 1] = -2 * cos(w) / (1 + al);
      SD_KC[k * 3 + 2] = (1 - al) / (1 + al);
      SD_CW[k] = cos(w);
      SD_AL[k] = sin(w) / (2 * 3);
      SD_ON[k] = f >= slider5 && f <= slider6 && f < srate * 0.45;
      k += 1;
    );
    sg_cut = slider1 * 0.24;
    sg_thr = slider2;
    sg_att = exp(-1 / (slider3 * 0.001 * srate));
    sg_rel = exp(-1 / (slider4 * 0.001 * srate));
    sg_chan = slider7;
    sg_mix = slider8 / 100;
    sg_out = 10 ^ (slider9 / 20);
    sg_delta = slider10;
    sg_gains();
  );

  // ---- display (never changes the audio) ----
  // x of band k (0..31, its centre) and of a frequency on the same scale
  function sd_bx(k) ( ng_px + ng_pw * (k + 0.5) / 32; );
  function sd_fx(f) ( sd_bx(31 * log(f / 30) / log(600)); );
  function sd_hz_txt(f) ( f >= 1000 ? sprintf(#sg_v, "%.1f kHz", f / 1000) : sprintf(#sg_v, "%d Hz", f); #sg_v; );

  gfx_ext_retina = 1;

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 8;

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 50); ng_slider_set(2, -40); ng_slider_set(3, 5); ng_slider_set(4, 150); ng_slider_set(5, 20); ng_slider_set(6, 20000); ng_slider_set(7, 0); ng_slider_set(8, 100); ng_slider_set(9, 0); ng_slider_set(10, 0); );
    p == 1 ? ( ng_slider_set(1, 40); ng_slider_set(2, -42); ng_slider_set(3, 5); ng_slider_set(4, 120); ng_slider_set(5, 150); ng_slider_set(6, 8000); ng_slider_set(7, 0); ng_slider_set(8, 100); ng_slider_set(9, 0); ng_slider_set(10, 0); );
    p == 2 ? ( ng_slider_set(1, 50); ng_slider_set(2, -42); ng_slider_set(3, 5); ng_slider_set(4, 120); ng_slider_set(5, 150); ng_slider_set(6, 8000); ng_slider_set(7, 1); ng_slider_set(8, 100); ng_slider_set(9, 0); ng_slider_set(10, 0); );
    p == 3 ? ( ng_slider_set(1, 70); ng_slider_set(2, -36); ng_slider_set(3, 1); ng_slider_set(4, 90); ng_slider_set(5, 30); ng_slider_set(6, 250); ng_slider_set(7, 0); ng_slider_set(8, 100); ng_slider_set(9, 0); ng_slider_set(10, 0); );
    p == 4 ? ( ng_slider_set(1, 55); ng_slider_set(2, -45); ng_slider_set(3, 10); ng_slider_set(4, 250); ng_slider_set(5, 200); ng_slider_set(6, 12000); ng_slider_set(7, 0); ng_slider_set(8, 100); ng_slider_set(9, 0); ng_slider_set(10, 0); );
    p == 5 ? ( ng_slider_set(1, 80); ng_slider_set(2, -48); ng_slider_set(3, 8); ng_slider_set(4, 300); ng_slider_set(5, 120); ng_slider_set(6, 10000); ng_slider_set(7, 0); ng_slider_set(8, 100); ng_slider_set(9, 0); ng_slider_set(10, 0); );
    p == 6 ? ( ng_slider_set(1, 25); ng_slider_set(2, -40); ng_slider_set(3, 10); ng_slider_set(4, 200); ng_slider_set(5, 20); ng_slider_set(6, 20000); ng_slider_set(7, 0); ng_slider_set(8, 100); ng_slider_set(9, 0); ng_slider_set(10, 0); );
    p == 7 ? ( ng_slider_set(1, 60); ng_slider_set(2, -36); ng_slider_set(3, 2); ng_slider_set(4, 150); ng_slider_set(5, 150); ng_slider_set(6, 10000); ng_slider_set(7, 0); ng_slider_set(8, 80); ng_slider_set(9, 0); ng_slider_set(10, 0); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 50) && ng_pre_eq(slider2, -40) && ng_pre_eq(slider3, 5) && ng_pre_eq(slider4, 150) && ng_pre_eq(slider5, 20) && ng_pre_eq(slider6, 20000) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 100) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 40) && ng_pre_eq(slider2, -42) && ng_pre_eq(slider3, 5) && ng_pre_eq(slider4, 120) && ng_pre_eq(slider5, 150) && ng_pre_eq(slider6, 8000) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 100) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 50) && ng_pre_eq(slider2, -42) && ng_pre_eq(slider3, 5) && ng_pre_eq(slider4, 120) && ng_pre_eq(slider5, 150) && ng_pre_eq(slider6, 8000) && ng_pre_eq(slider7, 1) && ng_pre_eq(slider8, 100) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 70) && ng_pre_eq(slider2, -36) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, 90) && ng_pre_eq(slider5, 30) && ng_pre_eq(slider6, 250) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 100) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 55) && ng_pre_eq(slider2, -45) && ng_pre_eq(slider3, 10) && ng_pre_eq(slider4, 250) && ng_pre_eq(slider5, 200) && ng_pre_eq(slider6, 12000) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 100) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 80) && ng_pre_eq(slider2, -48) && ng_pre_eq(slider3, 8) && ng_pre_eq(slider4, 300) && ng_pre_eq(slider5, 120) && ng_pre_eq(slider6, 10000) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 100) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 25) && ng_pre_eq(slider2, -40) && ng_pre_eq(slider3, 10) && ng_pre_eq(slider4, 200) && ng_pre_eq(slider5, 20) && ng_pre_eq(slider6, 20000) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 100) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 60) && ng_pre_eq(slider2, -36) && ng_pre_eq(slider3, 2) && ng_pre_eq(slider4, 150) && ng_pre_eq(slider5, 150) && ng_pre_eq(slider6, 10000) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 80) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) ? m = 7;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Vocal Space";
    p == 2 ? s = "Vocal Space Wide";
    p == 3 ? s = "Kick Through Bass";
    p == 4 ? s = "Lead Over Pads";
    p == 5 ? s = "Voice Over Music";
    p == 6 ? s = "Gentle Carve";
    p == 7 ? s = "Snare Room In Reverb";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  // the key's level per band
  sg_key = (spl2 + spl3) * 0.5;
  sg_k = 0;
  loop(32,
    sg_c = SD_KC + sg_k * 3;
    sg_s = SD_KS + sg_k * 8;
    sg_y = sg_c[0] * sg_key - sg_c[0] * sg_s[1] - sg_c[1] * sg_s[2] - sg_c[2] * sg_s[3];
    sg_s[1] = sg_s[0]; sg_s[0] = sg_key; sg_s[3] = sg_s[2]; sg_s[2] = sg_y;
    sg_x = sg_y;
    sg_y = sg_c[0] * sg_x - sg_c[0] * sg_s[5] - sg_c[1] * sg_s[6] - sg_c[2] * sg_s[7];
    sg_s[5] = sg_s[4]; sg_s[4] = sg_x; sg_s[7] = sg_s[6]; sg_s[6] = sg_y;
    sg_a = abs(sg_y);
    SD_ENV[sg_k] = sg_a > SD_ENV[sg_k] ? sg_att * SD_ENV[sg_k] + (1 - sg_att) * sg_a : sg_rel * SD_ENV[sg_k] + (1 - sg_rel) * sg_a;
    sg_k += 1;
  );
  sg_cnt <= 0 ? ( sg_gains(); sg_cnt = 16; );
  sg_cnt -= 1;

  // the track through the bells: both channels, or the mid or the side only
  sg_dl = spl0; sg_dr = spl1;
  sg_chan == 0 ? (
    sg_l = sg_run(spl0, SD_MS);
    sg_r = sg_run(spl1, SD_MS + 4);
  ) : (
    sg_m = (spl0 + spl1) * 0.5;
    sg_sd = (spl0 - spl1) * 0.5;
    sg_chan == 1 ? sg_m = sg_run(sg_m, SD_MS) : sg_sd = sg_run(sg_sd, SD_MS);
    sg_l = sg_m + sg_sd;
    sg_r = sg_m - sg_sd;
  );
  sg_delta ? (
    spl0 = (sg_dl - sg_l) * sg_out;
    spl1 = (sg_dr - sg_r) * sg_out;
  ) : (
    spl0 = (sg_dl + (sg_l - sg_dl) * sg_mix) * sg_out;
    spl1 = (sg_dr + (sg_r - sg_dr) * sg_mix) * sg_out;
  );

@gfx 480 380
  ng_knobs_begin("SPECTRAL DUCKER", "ADVANCED", 480, 120, 2, 0);

  // display: per band the key's level from the bottom (-60..0 dB, Threshold dashed) and the
  // cut of the track from the top (0..24 dB); bands outside Low Cut .. High Cut are dimmed
  ng_plot(ng_vx + 26, ng_vy + 4, ng_vw - 30, ng_vh - 20);
  ng_col(NG_BORDER, 1);
  gfx_rect(ng_px, ng_py, ng_pw, 1);
  gfx_rect(ng_px, ng_py + ng_ph, ng_pw, 1);
  sg_k = 0;
  loop(32,
    sg_x0 = floor(ng_px + ng_pw * sg_k / 32) + 1;
    sg_x1 = floor(ng_px + ng_pw * (sg_k + 1) / 32) - 1;
    sg_on = SD_ON[sg_k];
    sg_y = ng_lin_y(20 * log10(max(SD_ENV[sg_k], 0.000000001)), -60, 0);
    ng_col(NG_MUTED, sg_on ? 0.35 : 0.12);
    sg_y < ng_py + ng_ph ? gfx_rect(sg_x0, sg_y, max(1, sg_x1 - sg_x0), ng_py + ng_ph - sg_y);
    sg_h = ng_ph * min(1, SD_GR[sg_k] / 24);
    ng_col(NG_ACCENT, 1);
    sg_h >= 1 ? gfx_rect(sg_x0, ng_py, max(1, sg_x1 - sg_x0), sg_h);
    sg_k += 1;
  );
  // Threshold on the key scale
  sg_y = floor(ng_lin_y(slider2, -60, 0)) + 0.5;
  ng_col(NG_ACCENT, 0.5);
  sg_x = ng_px;
  while (
    gfx_line(sg_x, sg_y, min(sg_x + 3 * ng_s, ng_px + ng_pw), sg_y, 0);
    sg_x += 6 * ng_s;
    sg_x < ng_px + ng_pw;
  );
  // frequency labels under the bars, dB labels on the left
  ng_font(1, 6.5, 0);
  ng_col(NG_MUTED, 1);
  ng_ptxt("100", sd_fx(100), ng_py + ng_ph + 8 * ng_s, 1);
  ng_ptxt("1k", sd_fx(1000), ng_py + ng_ph + 8 * ng_s, 1);
  ng_ptxt("10k", sd_fx(10000), ng_py + ng_ph + 8 * ng_s, 1);
  ng_ptxt("CUT", ng_px - 4 * ng_s, ng_py + 5 * ng_s, 2);
  ng_ptxt("KEY", ng_px - 4 * ng_s, ng_py + ng_ph - 5 * ng_s, 2);
  // status: what is ducked and the deepest cut now
  sg_max = 0;
  sg_k = 0;
  loop(32, sg_max = max(sg_max, SD_GR[sg_k]); sg_k += 1;);
  sprintf(#sg_st, "%s   -%.1f dB", slider10 ? "DELTA" : slider7 == 1 ? "MID" : slider7 == 2 ? "SIDE" : "STEREO", sg_max);
  ng_col(NG_MUTED, 1);
  ng_txt(#sg_st, ng_vx + ng_vw - 4, ng_vy + 14, 2, 1);

  ng_row(6);
  sprintf(#sg_a, "%d%%", slider1);
  ng_knob_ctl(1, "AMOUNT", #sg_a, 0, 100, 50, 1, 0) ? update();
  sprintf(#sg_t, "%.1f dB", slider2);
  ng_knob_ctl(2, "THRESHOLD", #sg_t, -60, 0, -40, 0.5, 0) ? update();
  sprintf(#sg_at, "%.1f ms", slider3);
  ng_knob_ctl_log(3, "ATTACK", #sg_at, 0.1, 100, 5, 0.1) ? update();
  sprintf(#sg_rl, "%d ms", slider4);
  ng_knob_ctl_log(4, "RELEASE", #sg_rl, 10, 1000, 150, 1) ? update();
  ng_knob_ctl_log(5, "LOW CUT", sd_hz_txt(slider5), 20, 5000, 20, 1) ? update();
  ng_knob_ctl_log(6, "HIGH CUT", sd_hz_txt(slider6), 200, 20000, 20000, 1) ? update();
  ng_row(4);
  ng_select_ctl(7, "CHANNELS", "STEREO|MID|SIDE", 0) ? update();
  sprintf(#sg_m, "%d%%", slider8);
  ng_knob_ctl(8, "MIX", #sg_m, 0, 100, 100, 1, 0) ? update();
  sprintf(#sg_o, "%+.1f dB", slider9);
  ng_knob_ctl(9, "OUTPUT", #sg_o, -12, 12, 0, 0.1, 1) ? update();
  ng_select_ctl(10, "LISTEN", "OUTPUT|DELTA", 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
