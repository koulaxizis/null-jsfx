desc:NULL Bass Management GFX
author: Christos Koulaxizis
tags: surround bass management crossover subwoofer lfe redirect 5.1 7.1 7.1.4 atmos bed monitoring linkwitz riley gui
//category: Advanced
//NULL JSFX v2.9 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:2<0,2,1{5.1,7.1,7.1.4}>-Bed
slider2:80<40,200,1>-Crossover (Hz)
slider3:0<0,1,1{Bass Managed,Full Range}>-Mains
slider4:1<0,1,1{0 dB,+10 dB}>-LFE Gain
slider5:0<-12,12,0.1>-Sub Level (dB)
slider6:0<0,2,1{All,Sub Only,Mains Only}>-Listen
slider7:0<-24,12,0.1>-Output (dB)

in_pin:L
in_pin:R
in_pin:C
in_pin:LFE
in_pin:Ls
in_pin:Rs
in_pin:Lrs
in_pin:Rrs
in_pin:Ltf
in_pin:Rtf
in_pin:Ltr
in_pin:Rtr
out_pin:L
out_pin:R
out_pin:C
out_pin:LFE
out_pin:Ls
out_pin:Rs
out_pin:Lrs
out_pin:Rrs
out_pin:Ltf
out_pin:Rtf
out_pin:Ltr
out_pin:Rtr

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // Plays a surround bed the way a monitoring system with a subwoofer does: the bass of every
  // main speaker of the Bed (all but the LFE) is taken off at the Crossover by a 4th-order
  // Linkwitz-Riley high-pass and sent, summed, through the matching low-pass to the
  // subwoofer, the LFE pin, with the LFE channel itself (+10 dB, as the LFE is played back, or
  // 0 dB) and Sub Level. The two LR4 halves add up flat, so the bass managed system sums to the
  // full range one (with the crossover's phase turn). Mains Full Range keeps the mains whole and
  // only adds their bass to the sub. Listen plays the sub or the mains alone. No latency.
  BM = 0;        // per pin: the high-pass state (4 each), 12 pins
  memset(0, 0, 64);

  // one LR4 section of the pin's high-pass (coefficients hb*, ha*), state at s
  function bm_hp(x, s) local(y)
  (
    y = hb0 * x + s[0];
    s[0] = hb1 * x - ha1 * y + s[1];
    s[1] = hb2 * x - ha2 * y;
    x = y;
    y = hb0 * x + s[2];
    s[2] = hb1 * x - ha1 * y + s[3];
    s[3] = hb2 * x - ha2 * y;
    y;
  );

  // the sub's low-pass
  function bm_lp(x) local(y)
  (
    y = lb0 * x + lz1;
    lz1 = lb1 * x - la1 * y + lz2;
    lz2 = lb2 * x - la2 * y;
    x = y;
    y = lb0 * x + lw1;
    lw1 = lb1 * x - la1 * y + lw2;
    lw2 = lb2 * x - la2 * y;
    y;
  );
  MTR = 64;     // the display: each output pin's peak
  memset(MTR, 0, 12);

  gfx_ext_retina = 1;
  function update()
  (
    bed = slider1;
    full = slider3;
    lfeg = slider4 ? 10 ^ (10 / 20) : 1;
    subg = 10 ^ (slider5 / 20);
    listen = slider6;
    outg = 10 ^ (slider7 / 20);
    bm_k = tan($pi * min(slider2, 0.45 * srate) / srate);
    bm_n = 1 / (1 + sqrt(2) * bm_k + bm_k * bm_k);
    lb0 = bm_k * bm_k * bm_n; lb1 = 2 * lb0; lb2 = lb0;
    la1 = 2 * (bm_k * bm_k - 1) * bm_n;
    la2 = (1 - sqrt(2) * bm_k + bm_k * bm_k) * bm_n;
    hb0 = bm_n; hb1 = -2 * hb0; hb2 = hb0;
    ha1 = la1; ha2 = la2;
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 13;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1); ng_hist_add(2); ng_hist_add(3); ng_hist_add(4); ng_hist_add(5); ng_hist_add(6); ng_hist_add(7);
  ng_hist_init();

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 2); ng_slider_set(2, 80); ng_slider_set(3, 0); ng_slider_set(4, 1); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); );
    p == 1 ? ( ng_slider_set(1, 2); ng_slider_set(2, 60); ng_slider_set(3, 0); ng_slider_set(4, 1); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); );
    p == 2 ? ( ng_slider_set(1, 2); ng_slider_set(2, 100); ng_slider_set(3, 0); ng_slider_set(4, 1); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); );
    p == 3 ? ( ng_slider_set(1, 2); ng_slider_set(2, 120); ng_slider_set(3, 0); ng_slider_set(4, 1); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); );
    p == 4 ? ( ng_slider_set(1, 2); ng_slider_set(2, 150); ng_slider_set(3, 0); ng_slider_set(4, 1); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); );
    p == 5 ? ( ng_slider_set(1, 2); ng_slider_set(2, 80); ng_slider_set(3, 1); ng_slider_set(4, 1); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); );
    p == 6 ? ( ng_slider_set(1, 2); ng_slider_set(2, 80); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); );
    p == 7 ? ( ng_slider_set(1, 2); ng_slider_set(2, 80); ng_slider_set(3, 0); ng_slider_set(4, 1); ng_slider_set(5, 0); ng_slider_set(6, 1); ng_slider_set(7, 0); );
    p == 8 ? ( ng_slider_set(1, 2); ng_slider_set(2, 80); ng_slider_set(3, 0); ng_slider_set(4, 1); ng_slider_set(5, 0); ng_slider_set(6, 2); ng_slider_set(7, 0); );
    p == 9 ? ( ng_slider_set(1, 2); ng_slider_set(2, 80); ng_slider_set(3, 0); ng_slider_set(4, 1); ng_slider_set(5, 3); ng_slider_set(6, 0); ng_slider_set(7, 0); );
    p == 10 ? ( ng_slider_set(1, 2); ng_slider_set(2, 80); ng_slider_set(3, 0); ng_slider_set(4, 1); ng_slider_set(5, -3); ng_slider_set(6, 0); ng_slider_set(7, 0); );
    p == 11 ? ( ng_slider_set(1, 0); ng_slider_set(2, 80); ng_slider_set(3, 0); ng_slider_set(4, 1); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); );
    p == 12 ? ( ng_slider_set(1, 1); ng_slider_set(2, 80); ng_slider_set(3, 0); ng_slider_set(4, 1); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 80) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 60) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 100) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 120) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 150) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 80) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 80) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 80) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 1) && ng_pre_eq(slider7, 0) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 80) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 2) && ng_pre_eq(slider7, 0) ? m = 8;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 80) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 3) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) ? m = 9;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 80) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, -3) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) ? m = 10;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 80) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) ? m = 11;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 80) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) ? m = 12;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Crossover 60 Hz";
    p == 2 ? s = "Crossover 100 Hz";
    p == 3 ? s = "Crossover 120 Hz";
    p == 4 ? s = "Small Satellites 150 Hz";
    p == 5 ? s = "Full Range Mains";
    p == 6 ? s = "LFE at 0 dB";
    p == 7 ? s = "Sub Only";
    p == 8 ? s = "Mains Only";
    p == 9 ? s = "Sub Hot +3 dB";
    p == 10 ? s = "Sub Low -3 dB";
    p == 11 ? s = "5.1 at 80 Hz";
    p == 12 ? s = "7.1 at 80 Hz";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  i6 = bed >= 1 ? spl6 : 0; i7 = bed >= 1 ? spl7 : 0;
  i8 = bed == 2 ? spl8 : 0; i9 = bed == 2 ? spl9 : 0; i10 = bed == 2 ? spl10 : 0; i11 = bed == 2 ? spl11 : 0;
  // the bass of the mains, to the sub
  sub = (bm_lp(spl0 + spl1 + spl2 + spl4 + spl5 + i6 + i7 + i8 + i9 + i10 + i11) + spl3 * lfeg) * subg;
  // the mains
  !full ? (
    spl0 = bm_hp(spl0, BM); spl1 = bm_hp(spl1, BM + 4); spl2 = bm_hp(spl2, BM + 8);
    spl4 = bm_hp(spl4, BM + 16); spl5 = bm_hp(spl5, BM + 20);
    i6 = bm_hp(i6, BM + 24); i7 = bm_hp(i7, BM + 28);
    i8 = bm_hp(i8, BM + 32); i9 = bm_hp(i9, BM + 36); i10 = bm_hp(i10, BM + 40); i11 = bm_hp(i11, BM + 44);
  );
  mg = listen == 1 ? 0 : outg;
  spl0 *= mg; spl1 *= mg; spl2 *= mg; spl4 *= mg; spl5 *= mg;
  spl6 = i6 * mg; spl7 = i7 * mg; spl8 = i8 * mg; spl9 = i9 * mg; spl10 = i10 * mg; spl11 = i11 * mg;
  spl3 = listen == 2 ? 0 : sub * outg;
  k = 0;
  loop(12, MTR[k] = max(MTR[k], abs(spl(k))); k += 1;);

@gfx 480 460
  ng_knobs_begin("BASS MANAGEMENT", "ADVANCED", 480, 200, 2, 0);

  // a meter row: the pin's name, then its peak on a -60..0 dB bar (silver, white over 0 dB)
  function bm_row(x, y, w, name, pk, on) local(f)
  (
    ng_font(1, 6, 1);
    ng_col(on ? NG_MUTED : NG_BORDER, 1);
    ng_txt(name, x, y + 4.5, 0, 0.5);
    ng_col(NG_CARD, 1);
    gfx_rect(X(x + 26), Y(y), (w - 26) * ng_s, 9 * ng_s);
    on ? (
      f = ng_db_norm(ng_to_db(pk), -60);
      ng_col(pk > 1 ? NG_TEXT : NG_ACCENT, 1);
      gfx_rect(X(x + 26), Y(y), (w - 26) * f * ng_s, 9 * ng_s);
    );
  );

  // left, the crossover: the mains' high-pass and the sub's low-pass (with Sub Level), and
  // their sum (dashed when the mains play full range); right, a meter for each output pin
  ng_plot(50, 84, 180, 140);
  ng_grid_freq(24);
  g_fc = slider2;
  g_i = 0;
  loop(3,
    ng_col(g_i == 2 ? NG_TEXT : g_i == 1 ? NG_MUTED : NG_ACCENT, g_i == 2 ? 0.6 : 1);
    g_c = 0;
    loop(197,
      g_f = 20 * 1000 ^ (g_c / 196);
      g_r = (g_f / g_fc) ^ 4;
      g_lp = 1 / (1 + g_r) * subg;
      g_hp = full ? 1 : g_r / (1 + g_r);
      g_v = g_i == 0 ? g_hp : g_i == 1 ? g_lp : sqrt(g_hp * g_hp + g_lp * g_lp);
      g_y = ng_lin_y(ng_to_db(g_v), -16, 16);
      g_c == 0 ? ng_line_start(ng_freq_x(g_f), g_y) : ng_line_to(ng_freq_x(g_f), g_y);
      g_c += 1;
    );
    g_i += 1;
  );
  ng_font(1, 6.5, 1);
  ng_col(NG_ACCENT, 1);
  ng_txt("MAINS", 50, 70, 0, 1);
  ng_col(NG_MUTED, 1);
  ng_txt("SUB", 86, 70, 0, 1);
  sprintf(#g_m, "%d HZ", g_fc);
  ng_txt(#g_m, 230, 70, 2, 1);

  ng_col(NG_BG, 1);
  gfx_rect(X(244), Y(62), 212 * ng_s, 180 * ng_s);
  g_k = 0;
  loop(12,
    g_on = g_k < 6 || (g_k < 8 && bed >= 1) || bed == 2;
    strcpy(#g_n, g_k == 0 ? "L" : g_k == 1 ? "R" : g_k == 2 ? "C" : g_k == 3 ? "SUB" : g_k == 4 ? (bed ? "LSS" : "LS") :
                 g_k == 5 ? (bed ? "RSS" : "RS") : g_k == 6 ? "LRS" : g_k == 7 ? "RRS" : g_k == 8 ? "LTF" : g_k == 9 ? "RTF" :
                 g_k == 10 ? "LTR" : "RTR");
    bm_row(252, 82 + g_k * 13, 196, #g_n, MTR[g_k], g_on);
    MTR[g_k] *= 0.85;
    g_k += 1;
  );
  ng_font(1, 7, 1);
  ng_col(NG_MUTED, 1);
  ng_txt(listen == 1 ? "LISTEN SUB" : listen == 2 ? "LISTEN MAINS" : "OUTPUT", 252, 70, 0, 1.2);

  ng_row(4);
  ng_select_ctl(1, "BED", "5.1|7.1|7.1.4", 0) ? update();
  sprintf(#v2, "%d Hz", slider2);
  ng_knob_ctl_log(2, "CROSSOVER", #v2, 40, 200, 80, 1) ? update();
  ng_select_ctl(3, "MAINS", "SPLIT|FULL", 0) ? update();
  ng_select_ctl(4, "LFE GAIN", "0 DB|+10 DB", 0) ? update();
  ng_row(4);
  sprintf(#v5, "%+.1f dB", slider5);
  ng_knob_ctl(5, "SUB LEVEL", #v5, -12, 12, 0, 0.1, 1) ? update();
  ng_select_ctl(6, "LISTEN", "ALL|SUB|MAINS", 0) ? update();
  sprintf(#v7, "%+.1f dB", slider7);
  ng_knob_ctl(7, "OUTPUT", #v7, -24, 12, 0, 0.1, 1) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
