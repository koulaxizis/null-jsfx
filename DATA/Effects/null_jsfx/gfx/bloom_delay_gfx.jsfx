desc:NULL Bloom Delay GFX
author: Christos Koulaxizis
tags: bloom delay diffusion diffused echo reverb ambient modulation tempo sync feedback infinite pad wash gui
//category: Advanced
//NULL JSFX v4.0 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:375<20,2000,1:log>-Time (ms)
slider2:0<0,7,1{Off,1/16,1/8,1/8 Dotted,1/4,1/4 Dotted,1/2,1/1}>-Sync
slider3:45<0,100,1>-Feedback (%)
slider4:50<0,100,1>-Bloom (%)
slider5:20<0,100,1>-Mod (%)
slider6:7000<1000,20000,1:log>-Damping (Hz)
slider7:100<0,100,1>-Width (%)
slider8:35<0,100,1>-Mix (%)
slider9:0<-24,12,0.1>-Output (dB)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // NULL Bloom Delay (../bloom_delay.jsfx) with its own interface: same audio code, plus @gfx.
  // A delay whose repeats bloom into a reverb: in the loop, after the delay line, a low-pass
  // (Damping), a 30 Hz high-pass and four allpass diffusers (different lengths per side) that
  // Bloom blends in, so each repeat comes back softer and more smeared than the last. The
  // feedback goes through a soft tanh curve, so even 100% (a near-endless wash) never blows up.
  // Mod sweeps the delay time with a slow LFO (0.35 Hz, up to 4 ms, the sides a quarter turn
  // apart); Sync locks the time to the project tempo (120 bpm when the host gives none) and
  // the time glides (80 ms) to a new value. Width narrows the wet signal towards mono.
  bd_n = ceil(srate * 4) + 8;  // 4 s per channel: a 1/1 note at 60 bpm
  bd_bl = 0;
  bd_br = bd_n;
  bd_wp = 0;
  bd_dt = -1;                  // the delay time in samples; -1 until the first sample sets it
  bd_glide = 1 - exp(-1 / (0.08 * srate));
  bd_hpc = 1 - exp(-2 * $pi * 30 / srate);
  bd_g = 0.6;
  bd_lfo = 0;
  bd_lpl = bd_lpr = bd_hpl = bd_hpr = 0;
  bd_ol = bd_or = 0;

  // allpass k (0 to 7, left 0-3, right 4-7) at base b with n samples
  bd_m = 2 * bd_n;
  function bd_ap_init(ms) ( this.b = bd_m; this.n = max(1, floor(ms * 0.001 * srate + 0.5)); this.p = 0; bd_m += this.n; );
  a0.bd_ap_init(4.77); a1.bd_ap_init(3.59); a2.bd_ap_init(12.73); a3.bd_ap_init(9.30);
  a4.bd_ap_init(5.21); a5.bd_ap_init(3.97); a6.bd_ap_init(11.83); a7.bd_ap_init(8.71);
  memset(0, 0, bd_m); freembuf(bd_m);
  function bd_ap(x) local(z, w)
  (
    z = this.b[this.p];
    w = x - bd_g * z;
    this.b[this.p] = w;
    this.p += 1;
    this.p >= this.n ? this.p = 0;
    z + bd_g * w;
  );
  function bd_sat(x) local(e) ( e = exp(2 * max(-20, min(20, x))); (e - 1) / (e + 1); );
  // the value d samples behind the write position in the line at b, interpolated
  function bd_read(b, d) local(rp, i0, i1, fr)
  (
    rp = bd_wp - d;
    rp < 0 ? rp += bd_n;
    rp >= bd_n ? rp -= bd_n;     // a tiny negative rp can round up to bd_n
    i0 = floor(rp);
    fr = rp - i0;
    i1 = i0 + 1;
    i1 >= bd_n ? i1 = 0;
    b[i0] + (b[i1] - b[i0]) * fr;
  );
  // the note length (beats) of Sync 1 to 7
  function bd_beats(v) ( v == 1 ? 0.25 : v == 2 ? 0.5 : v == 3 ? 0.75 : v == 4 ? 1 : v == 5 ? 1.5 : v == 6 ? 2 : 4; );
  gfx_ext_retina = 1;

  function update()
  (
    bd_sync = slider2;
    bd_note = bd_beats(slider2);
    bd_ms = slider1;
    bd_fb = slider3 / 100;
    bd_bloom = slider4 / 100;
    bd_depth = slider5 / 100 * 0.002 * srate;
    bd_lpc = 1 - exp(-2 * $pi * min(slider6, 0.45 * srate) / srate);
    bd_w = slider7 / 100;
    bd_mix = slider8 / 100;
    bd_out = 10 ^ (slider9 / 20);
  );
  function bd_hz_txt(f) ( f >= 1000 ? sprintf(#bd_v, "%.1f kHz", f / 1000) : sprintf(#bd_v, "%d Hz", f); #bd_v; );
  function bd_ms_txt(t) ( t >= 1000 ? sprintf(#bd_u, "%.2f s", t / 1000) : sprintf(#bd_u, "%d ms", t); #bd_u; );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 13;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1); ng_hist_add(2); ng_hist_add(3); ng_hist_add(4); ng_hist_add(5); ng_hist_add(6); ng_hist_add(7); ng_hist_add(8); ng_hist_add(9);
  ng_hist_init();

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 375); ng_slider_set(2, 0); ng_slider_set(3, 45); ng_slider_set(4, 50); ng_slider_set(5, 20); ng_slider_set(6, 7000); ng_slider_set(7, 100); ng_slider_set(8, 35); ng_slider_set(9, 0); );
    p == 1 ? ( ng_slider_set(1, 375); ng_slider_set(2, 4); ng_slider_set(3, 50); ng_slider_set(4, 60); ng_slider_set(5, 20); ng_slider_set(6, 7000); ng_slider_set(7, 100); ng_slider_set(8, 35); ng_slider_set(9, 0); );
    p == 2 ? ( ng_slider_set(1, 375); ng_slider_set(2, 3); ng_slider_set(3, 55); ng_slider_set(4, 70); ng_slider_set(5, 25); ng_slider_set(6, 7000); ng_slider_set(7, 100); ng_slider_set(8, 35); ng_slider_set(9, 0); );
    p == 3 ? ( ng_slider_set(1, 350); ng_slider_set(2, 0); ng_slider_set(3, 35); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 12000); ng_slider_set(7, 100); ng_slider_set(8, 35); ng_slider_set(9, 0); );
    p == 4 ? ( ng_slider_set(1, 300); ng_slider_set(2, 0); ng_slider_set(3, 45); ng_slider_set(4, 15); ng_slider_set(5, 45); ng_slider_set(6, 3500); ng_slider_set(7, 100); ng_slider_set(8, 35); ng_slider_set(9, 0); );
    p == 5 ? ( ng_slider_set(1, 600); ng_slider_set(2, 0); ng_slider_set(3, 70); ng_slider_set(4, 90); ng_slider_set(5, 30); ng_slider_set(6, 7000); ng_slider_set(7, 100); ng_slider_set(8, 45); ng_slider_set(9, 0); );
    p == 6 ? ( ng_slider_set(1, 800); ng_slider_set(2, 0); ng_slider_set(3, 100); ng_slider_set(4, 100); ng_slider_set(5, 35); ng_slider_set(6, 5000); ng_slider_set(7, 100); ng_slider_set(8, 50); ng_slider_set(9, 0); );
    p == 7 ? ( ng_slider_set(1, 375); ng_slider_set(2, 2); ng_slider_set(3, 35); ng_slider_set(4, 50); ng_slider_set(5, 20); ng_slider_set(6, 6000); ng_slider_set(7, 100); ng_slider_set(8, 25); ng_slider_set(9, 0); );
    p == 8 ? ( ng_slider_set(1, 450); ng_slider_set(2, 0); ng_slider_set(3, 60); ng_slider_set(4, 80); ng_slider_set(5, 20); ng_slider_set(6, 2000); ng_slider_set(7, 100); ng_slider_set(8, 40); ng_slider_set(9, 0); );
    p == 9 ? ( ng_slider_set(1, 90); ng_slider_set(2, 0); ng_slider_set(3, 30); ng_slider_set(4, 40); ng_slider_set(5, 60); ng_slider_set(6, 7000); ng_slider_set(7, 100); ng_slider_set(8, 30); ng_slider_set(9, 0); );
    p == 10 ? ( ng_slider_set(1, 375); ng_slider_set(2, 4); ng_slider_set(3, 40); ng_slider_set(4, 30); ng_slider_set(5, 20); ng_slider_set(6, 7000); ng_slider_set(7, 20); ng_slider_set(8, 35); ng_slider_set(9, 0); );
    p == 11 ? ( ng_slider_set(1, 375); ng_slider_set(2, 6); ng_slider_set(3, 75); ng_slider_set(4, 85); ng_slider_set(5, 20); ng_slider_set(6, 7000); ng_slider_set(7, 100); ng_slider_set(8, 40); ng_slider_set(9, 0); );
    p == 12 ? ( ng_slider_set(1, 40); ng_slider_set(2, 0); ng_slider_set(3, 75); ng_slider_set(4, 100); ng_slider_set(5, 15); ng_slider_set(6, 8000); ng_slider_set(7, 100); ng_slider_set(8, 40); ng_slider_set(9, 0); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 375) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 45) && ng_pre_eq(slider4, 50) && ng_pre_eq(slider5, 20) && ng_pre_eq(slider6, 7000) && ng_pre_eq(slider7, 100) && ng_pre_eq(slider8, 35) && ng_pre_eq(slider9, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 375) && ng_pre_eq(slider2, 4) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 60) && ng_pre_eq(slider5, 20) && ng_pre_eq(slider6, 7000) && ng_pre_eq(slider7, 100) && ng_pre_eq(slider8, 35) && ng_pre_eq(slider9, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 375) && ng_pre_eq(slider2, 3) && ng_pre_eq(slider3, 55) && ng_pre_eq(slider4, 70) && ng_pre_eq(slider5, 25) && ng_pre_eq(slider6, 7000) && ng_pre_eq(slider7, 100) && ng_pre_eq(slider8, 35) && ng_pre_eq(slider9, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 350) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 35) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 12000) && ng_pre_eq(slider7, 100) && ng_pre_eq(slider8, 35) && ng_pre_eq(slider9, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 300) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 45) && ng_pre_eq(slider4, 15) && ng_pre_eq(slider5, 45) && ng_pre_eq(slider6, 3500) && ng_pre_eq(slider7, 100) && ng_pre_eq(slider8, 35) && ng_pre_eq(slider9, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 600) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 70) && ng_pre_eq(slider4, 90) && ng_pre_eq(slider5, 30) && ng_pre_eq(slider6, 7000) && ng_pre_eq(slider7, 100) && ng_pre_eq(slider8, 45) && ng_pre_eq(slider9, 0) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 800) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 100) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 35) && ng_pre_eq(slider6, 5000) && ng_pre_eq(slider7, 100) && ng_pre_eq(slider8, 50) && ng_pre_eq(slider9, 0) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 375) && ng_pre_eq(slider2, 2) && ng_pre_eq(slider3, 35) && ng_pre_eq(slider4, 50) && ng_pre_eq(slider5, 20) && ng_pre_eq(slider6, 6000) && ng_pre_eq(slider7, 100) && ng_pre_eq(slider8, 25) && ng_pre_eq(slider9, 0) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 450) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 60) && ng_pre_eq(slider4, 80) && ng_pre_eq(slider5, 20) && ng_pre_eq(slider6, 2000) && ng_pre_eq(slider7, 100) && ng_pre_eq(slider8, 40) && ng_pre_eq(slider9, 0) ? m = 8;
    m < 0 && ng_pre_eq(slider1, 90) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 30) && ng_pre_eq(slider4, 40) && ng_pre_eq(slider5, 60) && ng_pre_eq(slider6, 7000) && ng_pre_eq(slider7, 100) && ng_pre_eq(slider8, 30) && ng_pre_eq(slider9, 0) ? m = 9;
    m < 0 && ng_pre_eq(slider1, 375) && ng_pre_eq(slider2, 4) && ng_pre_eq(slider3, 40) && ng_pre_eq(slider4, 30) && ng_pre_eq(slider5, 20) && ng_pre_eq(slider6, 7000) && ng_pre_eq(slider7, 20) && ng_pre_eq(slider8, 35) && ng_pre_eq(slider9, 0) ? m = 10;
    m < 0 && ng_pre_eq(slider1, 375) && ng_pre_eq(slider2, 6) && ng_pre_eq(slider3, 75) && ng_pre_eq(slider4, 85) && ng_pre_eq(slider5, 20) && ng_pre_eq(slider6, 7000) && ng_pre_eq(slider7, 100) && ng_pre_eq(slider8, 40) && ng_pre_eq(slider9, 0) ? m = 11;
    m < 0 && ng_pre_eq(slider1, 40) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 75) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 15) && ng_pre_eq(slider6, 8000) && ng_pre_eq(slider7, 100) && ng_pre_eq(slider8, 40) && ng_pre_eq(slider9, 0) ? m = 12;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Quarter Bloom";
    p == 2 ? s = "Dotted Eighth Wash";
    p == 3 ? s = "Clean Echo";
    p == 4 ? s = "Tape Echo";
    p == 5 ? s = "Ambient Swell";
    p == 6 ? s = "Endless Pad";
    p == 7 ? s = "Vocal Bloom";
    p == 8 ? s = "Dark Diffusion";
    p == 9 ? s = "Shimmering Slap";
    p == 10 ? s = "Narrow Repeats";
    p == 11 ? s = "Half Note Cloud";
    p == 12 ? s = "Reverb Only";
    s;
  );

  // the hint line under the controls: a short help text per slider (from tools/site_content.json)
  function ng_hint_text(i) local(s)
  (
    s = "";
    i == 1 ? s = "Delay time in milliseconds, used while Sync is Off";
    i == 2 ? s = "Locks the delay to the project tempo: 1/16 to a whole note, dotted 1/8 and 1/4 too (120 bpm when the host";
    i == 3 ? s = "How much of each repeat comes back; a soft curve in the loop keeps even 100% safe, for a near-endless wash";
    i == 4 ? s = "How much of the allpass diffusion is blended into the loop: each repeat comes back softer and more";
    i == 5 ? s = "A slow sweep of the delay time (0.35 Hz, up to 4 ms) for a gentle, tape-like movement";
    i == 6 ? s = "Low-pass in the loop: lower values make every repeat darker";
    i == 7 ? s = "Stereo width of the wet signal, from mono to full";
    i == 8 ? s = "Blend with the dry signal";
    i == 9 ? s = "Output level";
    s;
  );

  function ng_presets() local(i)
  (
    ng_hint_i > 0 && !ng_pre_open ? ng_hint(ng_hint_text(ng_hint_i));
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  bd_xl = spl0;
  bd_xr = spl1;
  bd_t = bd_sync ? bd_note * 60 / (tempo > 0 ? tempo : 120) * srate : bd_ms * 0.001 * srate;
  bd_t = min(bd_n - 2 * bd_depth - 4, max(1, bd_t));
  bd_dt < 0 ? bd_dt = bd_t : bd_dt += (bd_t - bd_dt) * bd_glide;
  bd_lfo += 0.35 / srate; bd_lfo >= 1 ? bd_lfo -= 1;
  bd_yl = bd_read(bd_bl, bd_dt + bd_depth * (1 + sin(2 * $pi * bd_lfo)));
  bd_yr = bd_read(bd_br, bd_dt + bd_depth * (1 + cos(2 * $pi * bd_lfo)));
  // the loop: damping low-pass, 30 Hz high-pass, diffusers blended in by Bloom
  bd_lpl += (bd_yl - bd_lpl) * bd_lpc;
  bd_lpr += (bd_yr - bd_lpr) * bd_lpc;
  bd_hpl += (bd_lpl - bd_hpl) * bd_hpc;
  bd_hpr += (bd_lpr - bd_hpr) * bd_hpc;
  bd_fl = bd_lpl - bd_hpl;
  bd_fr = bd_lpr - bd_hpr;
  bd_dl = a3.bd_ap(a2.bd_ap(a1.bd_ap(a0.bd_ap(bd_fl))));
  bd_dr = a7.bd_ap(a6.bd_ap(a5.bd_ap(a4.bd_ap(bd_fr))));
  bd_ol = bd_fl + (bd_dl - bd_fl) * bd_bloom;
  bd_or = bd_fr + (bd_dr - bd_fr) * bd_bloom;
  bd_bl[bd_wp] = bd_xl + bd_sat(bd_ol * bd_fb);
  bd_br[bd_wp] = bd_xr + bd_sat(bd_or * bd_fb);
  bd_wp += 1;
  bd_wp >= bd_n ? bd_wp = 0;
  // the wet signal, narrowed towards mono by Width
  bd_mm = (bd_ol + bd_or) * 0.5;
  bd_wl = bd_mm + (bd_ol - bd_mm) * bd_w;
  bd_wr = bd_mm + (bd_or - bd_mm) * bd_w;
  spl0 = (bd_xl + (bd_wl - bd_xl) * bd_mix) * bd_out;
  spl1 = (bd_xr + (bd_wr - bd_xr) * bd_mix) * bd_out;

@gfx 480 380
  ng_knobs_begin("BLOOM DELAY", "ADVANCED", 480, 120, 2, 0);

  // display: the input (dim) and twelve repeats at Feedback ^ (k - 1) down to -48 dB, each wider as Bloom
  // smears it (Damping, Mod and Width left out)
  ng_plot(ng_vx + 26, ng_vy + 4, ng_vw - 30, ng_vh - 20);
  ng_grid(13, 2, 0);
  ng_font(4, 8, 0);
  ng_col(NG_MUTED, 1);
  ng_ptxt("0", ng_px - 6 * ng_s, ng_py, 2);
  ng_ptxt("-24", ng_px - 6 * ng_s, ng_py + ng_ph / 2, 2);
  ng_ptxt("-48", ng_px - 6 * ng_s, ng_py + ng_ph, 2);
  ng_ptxt("REPEATS", ng_px, ng_py + ng_ph + 10 * ng_s, 0);
  slider2 ? sprintf(#bd_t, "SYNC %s", slider2 == 1 ? "1/16" : slider2 == 2 ? "1/8" : slider2 == 3 ? "1/8 DOTTED" :
    slider2 == 4 ? "1/4" : slider2 == 5 ? "1/4 DOTTED" : slider2 == 6 ? "1/2" : "1/1") : strcpy(#bd_t, bd_ms_txt(slider1));
  ng_ptxt(#bd_t, ng_px + ng_pw, Y(ng_vy + 4), 2);
  bd_k = 0;
  loop(13,
    bd_x = ng_px + ng_pw * (bd_k + 0.5) / 13;
    bd_a = bd_k == 0 ? 1 : (slider3 / 100) ^ (bd_k - 1);
    bd_y = ng_lin_y(20 * log10(max(bd_a, 0.000001)), -48, 0);
    bd_hw = (1 + slider4 / 100 * min(bd_k, 6) * 2.5) * ng_s;
    bd_k == 0 ? ng_col(NG_MUTED, 0.6) : ng_col(NG_ACCENT, 1);
    bd_a > 0.004 ? (
      ng_line_start(bd_x - bd_hw, ng_py + ng_ph);
      ng_line_to(bd_x, bd_y);
      ng_line_to(bd_x + bd_hw, ng_py + ng_ph);
    );
    bd_k += 1;
  );

  ng_row(5);
  ng_knob_ctl_log(1, "TIME", bd_ms_txt(slider1), 20, 2000, 375, 1) ? update();
  ng_select_ctl(2, "SYNC", "OFF|1/16|1/8|1/8 D|1/4|1/4 D|1/2|1/1", 0) ? update();
  sprintf(#v3, "%d%%", slider3);
  ng_knob_ctl(3, "FEEDBACK", #v3, 0, 100, 45, 1, 0) ? update();
  sprintf(#v4, "%d%%", slider4);
  ng_knob_ctl(4, "BLOOM", #v4, 0, 100, 50, 1, 0) ? update();
  sprintf(#v5, "%d%%", slider5);
  ng_knob_ctl(5, "MOD", #v5, 0, 100, 20, 1, 0) ? update();
  ng_row(4);
  ng_knob_ctl_log(6, "DAMPING", bd_hz_txt(slider6), 1000, 20000, 7000, 1) ? update();
  sprintf(#v7, "%d%%", slider7);
  ng_knob_ctl(7, "WIDTH", #v7, 0, 100, 100, 1, 0) ? update();
  sprintf(#v8, "%d%%", slider8);
  ng_knob_ctl(8, "MIX", #v8, 0, 100, 35, 1, 0) ? update();
  sprintf(#v9, "%.1f dB", slider9);
  ng_knob_ctl(9, "OUTPUT", #v9, -24, 12, 0, 0.1, 1) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
