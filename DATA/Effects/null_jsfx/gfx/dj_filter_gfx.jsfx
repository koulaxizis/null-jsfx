desc:NULL DJ Filter GFX
author: Christos Koulaxizis
tags: filter dj lowpass highpass sweep resonance performance gui
//category: One Slider
//NULL JSFX v2.7 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:0<-100,100,1>-Filter

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // NULL DJ Filter (../dj_filter.jsfx) with its own interface: same audio code, plus @gfx.
  // One-knob DJ filter. Left of centre a 24 dB/oct low-pass sweeps down from 20 kHz to
  // 60 Hz; right of centre a 24 dB/oct high-pass sweeps up from 20 Hz to 10 kHz. The centre
  // is the dry signal, bit for bit. A resonance bump grows with the amount. The position
  // glides (20 ms) so moves and automation do not zipper, and the first 5% of the travel
  // fades the filter in, so the filter appears smoothly out of the dry signal.
  ks = 1 - exp(-1 / (0.02 * srate));
  snap = 1;
  l_lp1.ic1 = l_lp1.ic2 = l_lp2.ic1 = l_lp2.ic2 = 0;
  r_lp1.ic1 = r_lp1.ic2 = r_lp2.ic1 = r_lp2.ic2 = 0;
  l_hp1.ic1 = l_hp1.ic2 = l_hp2.ic1 = l_hp2.ic2 = 0;
  r_hp1.ic1 = r_hp1.ic2 = r_hp2.ic1 = r_hp2.ic2 = 0;

  // TPT state-variable filter stage (state in this.ic1 / this.ic2); lp = 1 low-pass, 0 high-pass
  function svf(x, a1, a2, a3, k, lp) local(v1, v2, v3)
  (
    v3 = x - this.ic2;
    v1 = a1 * this.ic1 + a2 * v3;
    v2 = this.ic2 + a2 * this.ic1 + a3 * v3;
    this.ic1 = 2 * v1 - this.ic1;
    this.ic2 = 2 * v2 - this.ic2;
    lp ? v2 : x - k * v1 - v2;
  );

  // coefficients of one stage for g = tan(pi fc / srate) and q, into this.a1 .. this.k
  function stage(g, q)
  (
    this.k = 1 / q;
    this.a1 = 1 / (1 + g * (g + this.k));
    this.a2 = g * this.a1;
    this.a3 = g * this.a2;
  );

  // filters for the current position pos (-1..1): two stages each, Butterworth (Q 0.54 and
  // 1.31) at rest, the second stage's Q rising with the amount for the resonance bump
  function coefs() local(d, g)
  (
    d = max(0, -pos);
    g = tan($pi * min(20000 * (60 / 20000) ^ d, srate * 0.45) / srate);
    lp1.stage(g, 0.5412);
    lp2.stage(g, 1.3066 + 2.5 * d);
    d = max(0, pos);
    g = tan($pi * min(20 * (10000 / 20) ^ d, srate * 0.45) / srate);
    hp1.stage(g, 0.5412);
    hp2.stage(g, 1.3066 + 2.5 * d);
    mix = min(1, abs(pos) * 20);
  );

  // flushes a stage's state once it decays below -300 dB (no denormals in silence)
  function flush()
  (
    abs(this.ic1) < 0.000000000000001 ? this.ic1 = 0;
    abs(this.ic2) < 0.000000000000001 ? this.ic2 = 0;
  );

  function update()
  (
    tgt = slider1 / 100;
    snap ? (
      pos = tgt;
      coefs();
      snap = 0;
    );
  );

  // display: cutoff (Hz) of the filter at position p
  function dj_fc(p)
  (
    p < 0 ? min(20000 * (60 / 20000) ^ (0 - p), srate * 0.45) : min(20 * (10000 / 20) ^ p, srate * 0.45);
  );

  // display: magnitude (dB) at f of the filter at position p, dry mix included. The TPT stages
  // are the bilinear transform of 1 / (s^2 + k s + 1) (low-pass) and s^2 / (s^2 + k s + 1)
  // (high-pass) with s = j o, o = tan(pi f / srate) / g.
  function dj_db(f, p) local(d, o, k1, k2, dr, pr, pq, nr, den, wr, wi, m, hr, hi)
  (
    d = abs(p);
    o = tan($pi * min(f, srate * 0.4999) / srate) / tan($pi * dj_fc(p) / srate);
    k1 = 1 / 0.5412;
    k2 = 1 / (1.3066 + 2.5 * d);
    dr = 1 - o * o;
    pr = dr * dr - k1 * k2 * o * o;
    pq = o * dr * (k1 + k2);
    nr = p < 0 ? 1 : o * o * o * o;
    den = max(pr * pr + pq * pq, 0.00000000000000000001);
    wr = nr * pr / den;
    wi = 0 - nr * pq / den;
    m = min(1, d * 20);
    hr = 1 + (wr - 1) * m;
    hi = wi * m;
    10 * log10(max(hr * hr + hi * hi, 0.00000000000000000001));
  );

  gfx_ext_retina = 1;

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 6;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1);
  ng_hist_init();

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 0); );
    p == 1 ? ( ng_slider_set(1, 30); );
    p == 2 ? ( ng_slider_set(1, 60); );
    p == 3 ? ( ng_slider_set(1, -50); );
    p == 4 ? ( ng_slider_set(1, -70); );
    p == 5 ? ( ng_slider_set(1, -90); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 30) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 60) ? m = 2;
    m < 0 && ng_pre_eq(slider1, -50) ? m = 3;
    m < 0 && ng_pre_eq(slider1, -70) ? m = 4;
    m < 0 && ng_pre_eq(slider1, -90) ? m = 5;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Low Cut Thin";
    p == 2 ? s = "Telephone Highs";
    p == 3 ? s = "Muffled Low Pass";
    p == 4 ? s = "Next Room";
    p == 5 ? s = "Sub Only";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@block
  l_lp1.flush(); l_lp2.flush(); r_lp1.flush(); r_lp2.flush();
  l_hp1.flush(); l_hp2.flush(); r_hp1.flush(); r_hp2.flush();

@sample
  pos !== tgt ? (
    pos += (tgt - pos) * ks;
    abs(tgt - pos) < 0.0001 ? pos = tgt;
    coefs();
  );
  // both chains always run, so neither starts from a stale state when the knob crosses 0
  lo_l = l_lp2.svf(l_lp1.svf(spl0, lp1.a1, lp1.a2, lp1.a3, lp1.k, 1), lp2.a1, lp2.a2, lp2.a3, lp2.k, 1);
  lo_r = r_lp2.svf(r_lp1.svf(spl1, lp1.a1, lp1.a2, lp1.a3, lp1.k, 1), lp2.a1, lp2.a2, lp2.a3, lp2.k, 1);
  hi_l = l_hp2.svf(l_hp1.svf(spl0, hp1.a1, hp1.a2, hp1.a3, hp1.k, 0), hp2.a1, hp2.a2, hp2.a3, hp2.k, 0);
  hi_r = r_hp2.svf(r_hp1.svf(spl1, hp1.a1, hp1.a2, hp1.a3, hp1.k, 0), hp2.a1, hp2.a2, hp2.a3, hp2.k, 0);
  mix > 0 ? (
    spl0 += ((pos < 0 ? lo_l : hi_l) - spl0) * mix;
    spl1 += ((pos < 0 ? lo_r : hi_r) - spl1) * mix;
  );

@gfx 360 240
  ng_one_slider_begin("DJ FILTER");

  // display: the filter's magnitude response at the knob position, cutoff dashed
  ng_plot(46, 64, 284, 78);
  ng_grid_freq(36);
  dj_p = slider1 / 100;
  dj_p != 0 ? (
    xx = floor(ng_freq_x(dj_fc(dj_p))) + 0.5;
    ng_col(NG_ACCENT, 0.5);
    yy = ng_py;
    while(
      gfx_line(xx, yy, xx, min(yy + 3 * ng_s, ng_py + ng_ph), 0);
      yy += 6 * ng_s;
      yy < ng_py + ng_ph;
    );
  );
  zy = ng_lin_y(0, -24, 24);
  ng_col(NG_ACCENT, 0.10);
  i = 0;
  loop(floor(ng_pw) + 1,
    gfx_line(ng_px + i, zy, ng_px + i, ng_lin_y(dj_db(20 * 1000 ^ (i / ng_pw), dj_p), -24, 24), 0);
    i += 1;
  );
  ng_col(NG_ACCENT, 1);
  i = 0;
  loop(floor(ng_pw) + 1,
    yy = ng_lin_y(dj_db(20 * 1000 ^ (i / ng_pw), dj_p), -24, 24);
    i == 0 ? ng_line_start(ng_px, yy) : ng_line_to(ng_px + i, yy);
    i += 1;
  );

  // slider card
  dj_f = floor(dj_fc(dj_p) + 0.5);
  dj_f >= 1000 ? sprintf(#fq, "%.2f kHz", dj_f / 1000) : sprintf(#fq, "%d Hz", dj_f);
  slider1 == 0 ? sprintf(#cap, "DRY") : slider1 < 0 ? sprintf(#cap, "LOW PASS %s", #fq) : sprintf(#cap, "HIGH PASS %s", #fq);
  v = floor(slider1 + 0.5);
  v > 0 ? sprintf(#val, "+%d", v) : sprintf(#val, "%d", v);
  ng_set_slider(ng_one_slider_control("FILTER", #cap, #val, "LO PASS", "HI PASS", slider1, -100, 100, 0, 1), 1) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
