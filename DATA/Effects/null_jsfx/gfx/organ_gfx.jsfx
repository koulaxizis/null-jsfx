    m < 0 && ng_pre_eq(slider1, 8) && ng_pre_eq(slider2, 8) && ng_pre_eq(slider3, 8) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 1) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 0) && ng_pre_eq(slider14, 60) && ng_pre_eq(slider15, 0) && ng_pre_eq(slider16, 10) && ng_pre_eq(slider17, 0) && ng_pre_eq(slider18, 100) && ng_pre_eq(slider19, 50) && ng_pre_eq(slider20, 0) ? m = 9;
