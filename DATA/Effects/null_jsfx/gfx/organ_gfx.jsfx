  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Jazz";
    p == 2 ? s = "Mellow Jazz";
    p == 3 ? s = "Gospel";
    p == 4 ? s = "Rock";
    p == 5 ? s = "Dirty Lead";
    p == 6 ? s = "Blues";
    p == 7 ? s = "Ballad";
    p == 8 ? s = "Full";
    p == 9 ? s = "Reggae Skank";
    p == 10 ? s = "Pop Percussion";
    p == 11 ? s = "Soft Flute";
    p == 12 ? s = "Whistle Top";
    p == 13 ? s = "Chapel";
    p == 14 ? s = "Rotor Brake";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@block
  // the MIDI of this block, played at its offsets in @sample
  mq_n = 0;
  while (midirecv(m_ofs, m_1, m_2, m_3)) (
    mq_n < 512 ? (
      MQ[mq_n * 4] = m_ofs;
      MQ[mq_n * 4 + 1] = m_1;
      MQ[mq_n * 4 + 2] = m_2;
      MQ[mq_n * 4 + 3] = m_3;
      mq_n += 1;
    );
  );
  mq_i = 0;
  si = 0;

@sample
  while (mq_i < mq_n && MQ[mq_i * 4] <= si) (
    midi_ev(MQ[mq_i * 4 + 1], MQ[mq_i * 4 + 2], MQ[mq_i * 4 + 3]);
    mq_i += 1;
  );
  si += 1;

  // the voices
  sum = 0; csum = 0;
  v = 0;
  loop(NV,
    VN[v] >= 0 ? (
      ph = VPH[v] + VDT[v];
      ph -= floor(ph);
      VPH[v] = ph;
      a = 2 * $pi * ph;
      H[1] = sin(a);
      c2 = 2 * cos(a);
      H[2] = c2 * H[1];
      k = 3;
      km = VKM[v];
      while (k <= km) ( H[k] = c2 * H[k - 1] - H[k - 2]; k += 1; );
      b = v * 9;
      y = DG[0] * H[KE[b]] + DG[1] * H[KE[b + 1]] + DG[2] * H[KE[b + 2]] + DG[3] * H[KE[b + 3]]
        + DG[4] * H[KE[b + 4]] + DG[5] * H[KE[b + 5]] + DG[6] * H[KE[b + 6]] + DG[7] * H[KE[b + 7]]
        + DG[8] * H[KE[b + 8]];
      VPK[v] > 0 ? (
        perc_on ? y += perc_g * H[VKP[v]] * VPE[v];
        VPE[v] *= p_c;
      );
      sum += y * VE[v];
      csum += VCE[v];
      VCE[v] *= c_c;
      VG[v] > 0 ? VE[v] = min(1, VE[v] + a_inc) : VE[v] = max(0, VE[v] - (VPEND[v] >= 0 ? s_inc : r_inc));
      VG[v] <= 0 && VE[v] <= 0 ? (
        VPEND[v] >= 0 ? v_start(v, VPEND[v], VPP[v]) : VN[v] = -1;
      );
    );
    v += 1;
  );

  // key click: band-passed white noise (Park-Miller)
  seed *= 16807; seed -= floor(seed / 2147483647) * 2147483647;
  nz = seed / 1073741824 - 1;
  c_v3 = nz - c_s2;
  c_v1 = c_a1 * c_s1 + c_a2 * c_v3;
  c_v2 = c_s2 + c_a2 * c_s1 + c_a3 * c_v3;
  c_s1 = 2 * c_v1 - c_s1;
  c_s2 = 2 * c_v2 - c_s2;

  // expression (CC 11), smoothed
  ex += (ex_t - ex) * ex_c;
  x = (sum * 0.075 + c_v1 * csum * click * 0.3) * (0.1 + 0.9 * ex * ex);

  // vibrato scanner
  VB[vb_w] = x;
  vib > 0 ? (
    lfo_ph += lfo_dt;
    lfo_ph -= floor(lfo_ph);
    rp = vb_w - srate * (0.0002 + vib_d * (0.5 + 0.5 * sin(2 * $pi * lfo_ph)));
    rp < 0 ? rp += vb_size;
    i = floor(rp); f = rp - i;
    i2 = i + 1; i2 >= vb_size ? i2 = 0;
    w = VB[i] + (VB[i2] - VB[i]) * f;
    x = vib >= 4 ? 0.5 * (x + w) : w;
  );
  vb_w += 1;
  vb_w >= vb_size ? vb_w = 0;

  // preamp: Drive
  x = max(-3, min(3, x * drive));
  x = x * (27 + x * x) / (27 + 9 * x * x) * drv_n;

  // rotary speaker: lows to the drum, highs to the horn, both spinning with inertia
  lp1 = (1 - xc) * x + xc * lp1;
  lp2 = (1 - xc) * lp1 + xc * lp2;
  horn_f = horn_c * horn_f + (1 - horn_c) * horn_target;
  drum_f = drum_c * drum_f + (1 - drum_c) * drum_target;
  horn_ph += horn_f / srate; horn_ph >= 1 ? horn_ph -= 1;
  drum_ph += drum_f / srate; drum_ph >= 1 ? drum_ph -= 1;
  hl[rb_w] = x - lp2; hr[rb_w] = x - lp2;
  dl[rb_w] = lp2; dr[rb_w] = lp2;
  h_a = 2 * $pi * horn_ph;
  d_a = 2 * $pi * drum_ph;
  h_l = tap(hl, 1 + srate * 0.00035 * (1 + sin(h_a))) * (1 - 0.45 * (1 - cos(h_a)));
  h_r = tap(hr, 1 + srate * 0.00035 * (1 + sin(h_a + 2 * $pi * 0.2))) * (1 - 0.45 * (1 - cos(h_a + 2 * $pi * 0.2)));
  d_l = tap(dl, 1 + srate * 0.0005 * (1 + sin(d_a))) * (1 - 0.2 * (1 - cos(d_a)));
  d_r = tap(dr, 1 + srate * 0.0005 * (1 + sin(d_a + 2 * $pi * 0.2))) * (1 - 0.2 * (1 - cos(d_a + 2 * $pi * 0.2)));
  rb_w += 1;
  rb_w >= rb_size ? rb_w = 0;

  rot_mode > 0 ? (
    spl0 = (h_l * horn_g + d_l * drum_g) * vol;
    spl1 = (h_r * horn_g + d_r * drum_g) * vol;
  ) : (
    spl0 = x * vol;
    spl1 = spl0;
  );

@gfx 560 430
  ng_knobs_begin("ORGAN", "INSTRUMENTS", 560, 170, 2, 0);

  // display: the nine drawbars (click or drag one down to pull it out, the wheel steps it), the
  // rotary speaker's horn and drum turning, the expression and the voices sounding


  og_lmb = mouse_cap & 1;
  !og_lmb ? og_drag = 0;
  og_i = 0;
  loop(9,
    og_x = 32 + og_i * 38;
    og_val = floor(og_sl(og_i) + 0.5);
    og_hov = !ng_pre_open && mouse_x >= X(og_x - 4) && mouse_x < X(og_x + 32) && mouse_y >= Y(76) && mouse_y < Y(200);
    og_hov && ng_click ? og_drag = og_i + 1;
    og_drag == og_i + 1 ? (
      og_nw = max(0, min(8, floor((mouse_y - Y(86)) / (13 * ng_s) + 0.5)));
      ng_slider_set(og_i + 1, og_nw) ? update();
      og_val = og_nw;
    );
    og_hov && mouse_wheel != 0 ? (
      og_nw = max(0, min(8, og_val + (mouse_wheel > 0 ? -1 : 1)));
      ng_slider_set(og_i + 1, og_nw) ? update();
      og_val = og_nw;
    );
    ng_font(1, 6.5, 1);
    ng_col(NG_MUTED, 1);
    ng_txt(og_feet(og_i), og_x + 14, 70, 1, 0);
    ng_col(NG_BG, 1);
    gfx_rect(X(og_x + 12), Y(78), 4 * ng_s, 120 * ng_s);
    og_c = og_kind(og_i) == 0 ? 0x6b6762 : og_kind(og_i) == 1 ? NG_ACCENT : 0x131211;
    og_hy = 78 + og_val * 13;
    og_val > 0 ? ( ng_col(og_c, 0.35); gfx_rect(X(og_x + 4), Y(78), 20 * ng_s, (og_hy - 78) * ng_s); );
    ng_col(og_c, 1);
    gfx_roundrect(X(og_x), Y(og_hy), 28 * ng_s, 16 * ng_s, 3 * ng_s, 1);
    gfx_rect(X(og_x) + 1, Y(og_hy) + 1, 28 * ng_s - 1, 16 * ng_s - 1);
    ng_col(og_hov || og_drag == og_i + 1 ? 0x45433f : og_kind(og_i) == 2 ? 0x45433f : og_c, 1);
    gfx_roundrect(X(og_x), Y(og_hy), 28 * ng_s, 16 * ng_s, 3 * ng_s, 1);
    ng_font(1, 8, 1);
    ng_col(og_kind(og_i) == 1 ? NG_BG : NG_TEXT, 1);
    sprintf(#og_n, "%d", og_val);
    ng_txt(#og_n, og_x + 14, og_hy + 8, 1, 0);
    og_i += 1;
  );

  // the rotary speaker
  og_r = max(0, min(3, floor(rot_eff + 0.5)));
  ng_font(1, 7, 1);
  ng_col(NG_MUTED, 1);
  ng_txt("ROTARY", 392, 70, 0, 1);
  ng_col(NG_TEXT, 1);
  ng_txt(og_r == 0 ? "OFF" : og_r == 1 ? "SLOW" : og_r == 2 ? "FAST" : "STOP", 536, 70, 2, 1);
  og_rotor(426, 108, 22, horn_ph, 1);
  og_rotor(502, 108, 22, drum_ph, 0);
  ng_font(1, 6.5, 1);
  ng_col(NG_MUTED, 1);
  sprintf(#og_h, "HORN %.1f HZ", horn_f);
  ng_txt(#og_h, 426, 141, 1, 0.5);
  sprintf(#og_dr, "DRUM %.1f HZ", drum_f);
  ng_txt(#og_dr, 502, 141, 1, 0.5);

  // expression and voices
  ng_font(1, 7, 1);
  ng_col(NG_MUTED, 1);
  ng_txt("EXPRESSION", 392, 160, 0, 1);
  ng_col(NG_TEXT, 1);
  sprintf(#og_ex, "%d%%", floor(ex * 100 + 0.5));
  ng_txt(#og_ex, 536, 160, 2, 0);
  ng_col(NG_BG, 1);
  gfx_rect(X(392), Y(168), 144 * ng_s, 5 * ng_s);
  ng_col(NG_ACCENT, 1);
  gfx_rect(X(392), Y(168), 144 * max(0, min(1, ex)) * ng_s, 5 * ng_s);
  og_nv = 0; og_val = 0;
  loop(NV, VN[og_val] >= 0 ? og_nv += 1; og_val += 1;);
  ng_col(NG_MUTED, 1);
  ng_txt("VOICES", 392, 190, 0, 1);
  ng_col(NG_TEXT, 1);
  sprintf(#og_v, "%d / 16", og_nv);
  ng_txt(#og_v, 536, 190, 2, 0);

  // controls
  ng_row(6);
  ng_select_ctl(10, "PERCUSSION", "OFF|ON", 0) ? update();
  ng_select_ctl(11, "HARMONIC", "SECOND|THIRD", 0) ? update();
  ng_select_ctl(12, "PERC DECAY", "FAST|SLOW", 0) ? update();
  ng_select_ctl(13, "PERC VOLUME", "NORMAL|SOFT", 0) ? update();
  sprintf(#og_k, "%d%%", slider14);
  ng_knob_ctl(14, "KEY CLICK", #og_k, 0, 100, 30, 1, 0) ? update();
  ng_select_ctl(15, "VIBRATO", "OFF|V1|V2|V3|C1|C2|C3", 0) ? update();

  ng_row(5);
  sprintf(#og_drv, "%d%%", slider16);
  ng_knob_ctl(16, "DRIVE", #og_drv, 0, 100, 15, 1, 0) ? update();
  ng_select_ctl(17, "ROTARY", "OFF|SLOW|FAST|STOP", 0) ? update();
  sprintf(#og_a, "%d%%", slider18);
  ng_knob_ctl(18, "ACCELERATION", #og_a, 10, 400, 100, 1, 0) ? update();
  slider19 == 50 ? strcpy(#og_b, "EVEN") : sprintf(#og_b, slider19 > 50 ? "HORN %d" : "DRUM %d", slider19 > 50 ? (slider19 - 50) * 2 : (50 - slider19) * 2);
  ng_knob_ctl(19, "HORN/DRUM", #og_b, 0, 100, 50, 1, 1) ? update();
  sprintf(#og_vol, "%+.1f dB", slider20);
  ng_knob_ctl(20, "VOLUME", #og_vol, -24, 12, 0, 0.1, 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
