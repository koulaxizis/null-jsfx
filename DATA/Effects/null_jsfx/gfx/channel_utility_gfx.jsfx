desc:NULL Channel Utility GFX
author: Christos Koulaxizis
tags: gain phase polarity dc block solo mute balance mono utility trim pad stereo channel gui
//category: Essentials
//NULL JSFX v2.6.1 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:0<0,2,1{None,-6,-12}>-Input Pad
slider2:0<-12,18,0.1>-Input Gain (dB)
slider3:0<0,1,1{Normal,Inverted}>-Phase Left
slider4:0<0,1,1{Normal,Inverted}>-Phase Right
slider5:20<10,100,1>-DC Block Freq (Hz)
slider6:100<0,100,1>-DC Block Mix (%)
slider7:0<-6,6,0.1>-Balance Left (dB)
slider8:0<-6,6,0.1>-Balance Right (dB)
slider9:0<0,1,1{Off,On}>-Solo L
slider10:0<0,1,1{Off,On}>-Solo R
slider11:0<0,1,1{Stereo,Mono}>-Mono Check
slider12:0<-12,12,0.1>-Output Gain (dB)
slider13:0<0,1,1{Off,On}>-Hard Limit

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // NULL Channel Utility (../channel_utility.jsfx) with its own interface: same audio code, plus @gfx.
  DB2LIN = 0.11512925464970228420;
  clip_peak_l = 0;
  clip_peak_r = 0;
  clip_decay = 0.995;
  dc_xl = 0; dc_xr = 0; dc_yl = 0; dc_yr = 0;
  ext_prev_srate = srate;
  gfx_ext_retina = 1;
  // display only: peak followers of the input and output, 300 ms release
  cu_rel = exp(-1 / (0.3 * srate));
  cu_il = cu_ir = cu_ol = cu_or = 0;
  cu_tab = 0;

  function update()
  (
    pad_db = slider1 == 1 ? -6 : (slider1 == 2 ? -12 : 0);
    db2lin_pad = exp(pad_db * DB2LIN);
    in_gain_lin = exp(slider2 * DB2LIN);

    dc_freq = slider5;
    dc_mix = slider6 / 100;
    dc_alpha = 1 / (1 + 3.14159265358979 * dc_freq / srate);

    bal_l_lin = exp(slider7 * DB2LIN);
    bal_r_lin = exp(slider8 * DB2LIN);

    out_gain_lin = exp(slider12 * DB2LIN);

    solo_l = floor(slider9);
    solo_r = floor(slider10);
    mono_mode = floor(slider11);
  );

  // one stage of the signal chain in the display: box i of 9, name, value text, lit when the
  // stage changes the signal; a chevron to the next stage
  function cu_stage(i, name, value, lit) local(w, x)
  (
    w = (432 - 8 * 6) / 9;
    x = 24 + i * (w + 6);
    ng_col(lit ? 0x2d2b28 : NG_BG, 1);
    gfx_roundrect(X(x), Y(66), w * ng_s, 32 * ng_s, 4 * ng_s, 1);
    gfx_rect(X(x) + 1, Y(66) + 1, w * ng_s - 1, 32 * ng_s - 1);
    ng_col(lit ? 0x45433f : NG_BORDER, 1);
    gfx_roundrect(X(x), Y(66), w * ng_s, 32 * ng_s, 4 * ng_s, 1);
    ng_font(1, 6.5, 1);
    ng_col(NG_MUTED, 1);
    ng_txt(name, x + w / 2, 76, 1, 1);
    ng_font(4, 7.5, 0);
    ng_col(lit ? NG_TEXT : NG_MUTED, 1);
    ng_txt(value, x + w / 2, 89, 1, 0);
    i < 8 ? (
      ng_col(NG_MUTED, 1);
      ng_arrow(x + w + 3, 82, 1);
    );
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 9;

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 20); ng_slider_set(6, 100); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); ng_slider_set(10, 0); ng_slider_set(11, 0); ng_slider_set(12, 0); ng_slider_set(13, 0); );
    p == 1 ? ( ng_slider_set(1, 1); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 20); ng_slider_set(6, 100); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); ng_slider_set(10, 0); ng_slider_set(11, 0); ng_slider_set(12, 0); ng_slider_set(13, 0); );
    p == 2 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, 1); ng_slider_set(4, 1); ng_slider_set(5, 20); ng_slider_set(6, 100); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); ng_slider_set(10, 0); ng_slider_set(11, 0); ng_slider_set(12, 0); ng_slider_set(13, 0); );
    p == 3 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, 1); ng_slider_set(4, 0); ng_slider_set(5, 20); ng_slider_set(6, 100); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); ng_slider_set(10, 0); ng_slider_set(11, 0); ng_slider_set(12, 0); ng_slider_set(13, 0); );
    p == 4 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 20); ng_slider_set(6, 100); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); ng_slider_set(10, 0); ng_slider_set(11, 1); ng_slider_set(12, 0); ng_slider_set(13, 0); );
    p == 5 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 20); ng_slider_set(6, 100); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 1); ng_slider_set(10, 0); ng_slider_set(11, 0); ng_slider_set(12, 0); ng_slider_set(13, 0); );
    p == 6 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 20); ng_slider_set(6, 100); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); ng_slider_set(10, 1); ng_slider_set(11, 0); ng_slider_set(12, 0); ng_slider_set(13, 0); );
    p == 7 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 40); ng_slider_set(6, 100); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); ng_slider_set(10, 0); ng_slider_set(11, 0); ng_slider_set(12, 0); ng_slider_set(13, 0); );
    p == 8 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 20); ng_slider_set(6, 100); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); ng_slider_set(10, 0); ng_slider_set(11, 0); ng_slider_set(12, 0); ng_slider_set(13, 1); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 20) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 20) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 20) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 20) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 20) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 1) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 20) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 1) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 0) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 20) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 1) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 0) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 40) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 0) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 20) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 1) ? m = 8;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Pad Hot Input";
    p == 2 ? s = "Invert Both Polarity";
    p == 3 ? s = "Invert Left Only";
    p == 4 ? s = "Mono Check";
    p == 5 ? s = "Listen Left Only";
    p == 6 ? s = "Listen Right Only";
    p == 7 ? s = "Low Rumble Trim";
    p == 8 ? s = "Safety Clip";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@block
  ext_prev_srate != srate ? (
    dc_alpha = 1 / (1 + 3.14159265358979 * dc_freq / srate);
    ext_prev_srate = srate;
  );

@sample
  // display only (reads the input, never changes it)
  cu_a = abs(spl0);
  cu_il = cu_a > cu_il ? cu_a : cu_il * cu_rel;
  cu_a = abs(spl1);
  cu_ir = cu_a > cu_ir ? cu_a : cu_ir * cu_rel;

  // 1. Input Pad + Input Gain
  out_l = spl0 * db2lin_pad * in_gain_lin;
  out_r = spl1 * db2lin_pad * in_gain_lin;

  // 2. Phase Flip
  slider3 ? (out_l = -out_l;);
  slider4 ? (out_r = -out_r;);

  // 3. DC Block
  dc_bl = dc_alpha * (dc_yl + out_l - dc_xl);
  dc_br = dc_alpha * (dc_yr + out_r - dc_xr);
  dc_xl = out_l; dc_xr = out_r;
  dc_yl = dc_bl; dc_yr = dc_br;
  out_l = (1 - dc_mix) * out_l + dc_mix * dc_bl;
  out_r = (1 - dc_mix) * out_r + dc_mix * dc_br;

  // 4. Channel Balance
  out_l *= bal_l_lin;
  out_r *= bal_r_lin;

  // 5. Solo L / Solo R
  solo_l ? (
    out_r = 0;
  ) : (
    solo_r ? (out_l = 0;);
  );

  // 6. Mono Check
  mono_mode ? (
    out_l = (out_l + out_r) / 2;
    out_r = out_l;
  );

  // 7. Output Gain
  out_l *= out_gain_lin;
  out_r *= out_gain_lin;

  // 8. Hard Limit
  clip_peak_l *= clip_decay;
  clip_peak_r *= clip_decay;
  abs(out_l) > clip_peak_l ? clip_peak_l = abs(out_l);
  abs(out_r) > clip_peak_r ? clip_peak_r = abs(out_r);

  slider13 ? (
    abs(out_l) > 0.99 ? (out_l = sign(out_l) * 0.99;);
    abs(out_r) > 0.99 ? (out_r = sign(out_r) * 0.99;);
  );

  spl0 = out_l;
  spl1 = out_r;

  // display only (reads the output, never changes it)
  cu_a = abs(spl0);
  cu_ol = cu_a > cu_ol ? cu_a : cu_ol * cu_rel;
  cu_a = abs(spl1);
  cu_or = cu_a > cu_or ? cu_a : cu_or * cu_rel;

@gfx 480 408
  ng_knobs_begin("CHANNEL UTILITY", "ESSENTIALS", 480, 120, 2, 1);

  // display: the signal chain in processing order, the stages that change the signal lit,
  // then input and output level meters per channel
  sprintf(#cu_s, "%d dB", slider1 == 1 ? -6 : (slider1 == 2 ? -12 : 0));
  cu_stage(0, "PAD", #cu_s, slider1 > 0);
  sprintf(#cu_s, "%+.1f dB", slider2);
  cu_stage(1, "GAIN", #cu_s, slider2 != 0);
  cu_stage(2, "PHASE", slider3 && slider4 ? "L+R" : (slider3 ? "L" : (slider4 ? "R" : "OFF")), slider3 || slider4);
  slider6 > 0 ? sprintf(#cu_s, "%d Hz", slider5) : sprintf(#cu_s, "OFF");
  cu_stage(3, "DC", #cu_s, slider6 > 0);
  sprintf(#cu_s, "%.1f/%.1f", slider7, slider8);
  cu_stage(4, "BAL", #cu_s, slider7 != 0 || slider8 != 0);
  cu_stage(5, "SOLO", slider9 ? "L" : (slider10 ? "R" : "OFF"), slider9 || slider10);
  cu_stage(6, "MONO", slider11 ? "ON" : "OFF", slider11);
  sprintf(#cu_s, "%+.1f dB", slider12);
  cu_stage(7, "OUT", #cu_s, slider12 != 0);
  cu_stage(8, "LIMIT", slider13 ? "ON" : "OFF", slider13);
  ng_meter(24, 112, 208, 8, "IN L", ng_to_db(cu_il), -140, -60);
  ng_meter(24, 128, 208, 8, "IN R", ng_to_db(cu_ir), -140, -60);
  ng_meter(248, 112, 208, 8, "OUT L", ng_to_db(cu_ol), -140, -60);
  ng_meter(248, 128, 208, 8, "OUT R", ng_to_db(cu_or), -140, -60);
  ng_font(4, 8, 0);
  ng_col(NG_MUTED, 1);
  ng_txt("-60", 54, 149, 0, 0);
  ng_txt("-30", 143, 149, 1, 0);
  ng_txt("0 dB", 232, 149, 2, 0);
  ng_txt("-60", 278, 149, 0, 0);
  ng_txt("-30", 367, 149, 1, 0);
  ng_txt("0 dB", 456, 149, 2, 0);

  cu_tab = ng_tabs("INPUT|OUTPUT", cu_tab);
  cu_tab == 0 ? (
    ng_row(4);
    ng_select_ctl(1, "PAD", "NONE|-6 dB|-12 dB", 0) ? update();
    sprintf(#cu_v, "%+.1f dB", slider2);
    ng_knob_ctl(2, "GAIN", #cu_v, -12, 18, 0, 0.1, 0) ? update();
    ng_select_ctl(3, "INVERT L", "OFF|ON", 0) ? update();
    ng_select_ctl(4, "INVERT R", "OFF|ON", 0) ? update();
    ng_row(2);
    sprintf(#cu_v, "%d Hz", slider5);
    ng_knob_ctl(5, "DC FREQ", #cu_v, 10, 100, 20, 1, 0) ? update();
    sprintf(#cu_v, "%d%%", slider6);
    ng_knob_ctl(6, "DC MIX", #cu_v, 0, 100, 100, 1, 0) ? update();
  ) : (
    ng_row(4);
    sprintf(#cu_v, "%+.1f dB", slider7);
    ng_knob_ctl(7, "BAL L", #cu_v, -6, 6, 0, 0.1, 1) ? update();
    sprintf(#cu_v, "%+.1f dB", slider8);
    ng_knob_ctl(8, "BAL R", #cu_v, -6, 6, 0, 0.1, 1) ? update();
    ng_select_ctl(9, "SOLO L", "OFF|ON", 0) ? update();
    ng_select_ctl(10, "SOLO R", "OFF|ON", 0) ? update();
    ng_row(3);
    ng_select_ctl(11, "MONO", "STEREO|MONO", 0) ? update();
    sprintf(#cu_v, "%+.1f dB", slider12);
    ng_knob_ctl(12, "OUTPUT", #cu_v, -12, 12, 0, 0.1, 1) ? update();
    ng_select_ctl(13, "LIMIT", "OFF|ON", 0) ? update();
  );

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
