desc:NULL Note Echo GFX
author: Christos Koulaxizis
tags: midi note echo delay repeat repeater ratchet tempo sync velocity decay pitch step arpeggio generative gui
//category: MIDI
//NULL JSFX v3.0 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:3<1,16,1>-Repeats
slider2:250<10,2000,1>-Time (ms)
slider3:1<0,1,1{Off,On}>-Tempo Sync
slider4:1<0,7,1{1/4,1/8,1/16,1/32,1/2,1/8T,1/16T,1/8D}>-Subdivision
slider5:20<0,100,1>-Velocity Decay (%)
slider6:0<-12,12,1>-Pitch Step (semitones)
slider7:50<5,95,1>-Gate (%)
slider8:1<0,1,1{Off,On}>-Dry

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  // A delay for notes: every note-on that comes in is played again Repeats times, one Time (or a
  // tempo-synced Subdivision) apart, on its own channel. Echo k has the velocity v (1 - Velocity
  // Decay)^k (rounded; the echoes stop when it falls under 1) and the pitch moved by k x Pitch
  // Step (they stop past 0 or 127), and lasts Gate of the interval. Dry Off leaves out the notes
  // that came in, so only the echoes sound. A note that starts again while it still sounds is
  // ended first, so notes never pile up. Other MIDI passes through at its own sample; an all
  // notes off (CC 120/123) ends that channel's notes and drops its waiting echoes. The audio
  // passes through.
  ext_noinit = 1;
  // NULL Note Echo (../note_echo.jsfx) with its own interface: same audio code, plus @gfx.
  Q = 0;                       // incoming messages of the block: offset, status, data 1, data 2
  QMAX = 256;
  qn = qi = 0;
  E = 1024;                    // waiting echoes, sorted by time: time, status, note, velocity, id
  EMAX = 4096;
  eh = et = 0;
  SND = E + EMAX * 5;          // per channel and note: id of the note we sent that sounds (0 = none)
  ORG = SND + 2048;            // per channel and note: id of the dry note that came in
  memset(SND, 0, 4096);
  next_id = 1;
  now = 0;                     // samples since the start
  echoes = 0;

  function ne_on(ofs, ch, nt, v, id) local(k)
  (
    k = ch * 128 + nt;
    SND[k] ? midisend(ofs, 0x80 | ch, nt, 0);
    midisend(ofs, 0x90 | ch, nt, v);
    SND[k] = id;
  );

  function ne_off(ofs, ch, nt, id) local(k)
  (
    k = ch * 128 + nt;
    SND[k] == id ? (
      midisend(ofs, 0x80 | ch, nt, 0);
      SND[k] = 0;
    );
  );

  // a waiting event, kept in time order (after the ones at the same time)
  function ne_push(t, st, nt, v, id) local(i)
  (
    et >= EMAX ? (
      i = 0;
      loop(et - eh, memcpy(E + i * 5, E + (eh + i) * 5, 5); i += 1;);
      et -= eh;
      eh = 0;
    );
    i = et;
    while (i > eh && E[(i - 1) * 5] > t) (
      memcpy(E + i * 5, E + (i - 1) * 5, 5);
      i -= 1;
    );
    E[i * 5] = t; E[i * 5 + 1] = st; E[i * 5 + 2] = nt; E[i * 5 + 3] = v; E[i * 5 + 4] = id;
    et += 1;
  );

  // a note-on that came in at time t: its echoes wait in the queue
  function ne_note(t, ch, nt, v) local(k, vk, pk, ok)
  (
    k = 1;
    ok = 1;
    while (ok && k <= reps) (
      vk = floor(v * (1 - dec) ^ k + 0.5);
      pk = nt + k * pstep;
      vk >= 1 && pk >= 0 && pk <= 127 && et - eh + 2 <= EMAX ? (
        ne_push(t + k * iv, 0x90 | ch, pk, vk, next_id);
        ne_push(t + k * iv + len, 0x80 | ch, pk, 0, next_id);
        next_id += 1;
        echoes += 1;
      ) : ok = 0;
      k += 1;
    );
  );

  // all notes off on channel ch: its echoes are dropped and its notes end
  function ne_flush(ofs, ch) local(i, j, nt)
  (
    i = j = eh;
    while (i < et) (
      (E[i * 5 + 1] & 15) != ch ? ( j != i ? memcpy(E + j * 5, E + i * 5, 5); j += 1; );
      i += 1;
    );
    et = j;
    nt = 0;
    loop(128,
      SND[ch * 128 + nt] ? ( midisend(ofs, 0x80 | ch, nt, 0); SND[ch * 128 + nt] = 0; );
      ORG[ch * 128 + nt] = 0;
      nt += 1;
    );
  );
  gfx_ext_retina = 1;

  function update()
  (
    reps = slider1;
    tsync = slider3;
    dec = slider5 / 100;
    pstep = slider6;
    gate = slider7 / 100;
    dry = slider8;
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 10;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1); ng_hist_add(2); ng_hist_add(3); ng_hist_add(4); ng_hist_add(5); ng_hist_add(6); ng_hist_add(7); ng_hist_add(8);
  ng_hist_init();

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 3); ng_slider_set(2, 250); ng_slider_set(3, 1); ng_slider_set(4, 1); ng_slider_set(5, 20); ng_slider_set(6, 0); ng_slider_set(7, 50); ng_slider_set(8, 1); );
    p == 1 ? ( ng_slider_set(1, 3); ng_slider_set(2, 250); ng_slider_set(3, 1); ng_slider_set(4, 1); ng_slider_set(5, 25); ng_slider_set(6, 0); ng_slider_set(7, 50); ng_slider_set(8, 1); );
    p == 2 ? ( ng_slider_set(1, 4); ng_slider_set(2, 250); ng_slider_set(3, 1); ng_slider_set(4, 7); ng_slider_set(5, 20); ng_slider_set(6, 0); ng_slider_set(7, 50); ng_slider_set(8, 1); );
    p == 3 ? ( ng_slider_set(1, 3); ng_slider_set(2, 250); ng_slider_set(3, 1); ng_slider_set(4, 2); ng_slider_set(5, 10); ng_slider_set(6, 0); ng_slider_set(7, 40); ng_slider_set(8, 1); );
    p == 4 ? ( ng_slider_set(1, 6); ng_slider_set(2, 250); ng_slider_set(3, 1); ng_slider_set(4, 5); ng_slider_set(5, 18); ng_slider_set(6, 0); ng_slider_set(7, 50); ng_slider_set(8, 1); );
    p == 5 ? ( ng_slider_set(1, 4); ng_slider_set(2, 250); ng_slider_set(3, 1); ng_slider_set(4, 1); ng_slider_set(5, 15); ng_slider_set(6, 7); ng_slider_set(7, 50); ng_slider_set(8, 1); );
    p == 6 ? ( ng_slider_set(1, 3); ng_slider_set(2, 250); ng_slider_set(3, 1); ng_slider_set(4, 0); ng_slider_set(5, 20); ng_slider_set(6, -12); ng_slider_set(7, 50); ng_slider_set(8, 1); );
    p == 7 ? ( ng_slider_set(1, 8); ng_slider_set(2, 250); ng_slider_set(3, 1); ng_slider_set(4, 2); ng_slider_set(5, 8); ng_slider_set(6, 1); ng_slider_set(7, 60); ng_slider_set(8, 1); );
    p == 8 ? ( ng_slider_set(1, 4); ng_slider_set(2, 250); ng_slider_set(3, 1); ng_slider_set(4, 1); ng_slider_set(5, 25); ng_slider_set(6, 0); ng_slider_set(7, 50); ng_slider_set(8, 0); );
    p == 9 ? ( ng_slider_set(1, 1); ng_slider_set(2, 90); ng_slider_set(3, 0); ng_slider_set(4, 1); ng_slider_set(5, 35); ng_slider_set(6, 0); ng_slider_set(7, 50); ng_slider_set(8, 1); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 3) && ng_pre_eq(slider2, 250) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 20) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 50) && ng_pre_eq(slider8, 1) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 3) && ng_pre_eq(slider2, 250) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 25) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 50) && ng_pre_eq(slider8, 1) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 4) && ng_pre_eq(slider2, 250) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, 7) && ng_pre_eq(slider5, 20) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 50) && ng_pre_eq(slider8, 1) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 3) && ng_pre_eq(slider2, 250) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, 2) && ng_pre_eq(slider5, 10) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 40) && ng_pre_eq(slider8, 1) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 6) && ng_pre_eq(slider2, 250) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, 5) && ng_pre_eq(slider5, 18) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 50) && ng_pre_eq(slider8, 1) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 4) && ng_pre_eq(slider2, 250) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 15) && ng_pre_eq(slider6, 7) && ng_pre_eq(slider7, 50) && ng_pre_eq(slider8, 1) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 3) && ng_pre_eq(slider2, 250) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 20) && ng_pre_eq(slider6, -12) && ng_pre_eq(slider7, 50) && ng_pre_eq(slider8, 1) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 8) && ng_pre_eq(slider2, 250) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, 2) && ng_pre_eq(slider5, 8) && ng_pre_eq(slider6, 1) && ng_pre_eq(slider7, 60) && ng_pre_eq(slider8, 1) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 4) && ng_pre_eq(slider2, 250) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 25) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 50) && ng_pre_eq(slider8, 0) ? m = 8;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 90) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 35) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 50) && ng_pre_eq(slider8, 1) ? m = 9;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Eighth Echoes";
    p == 2 ? s = "Dotted Eighth";
    p == 3 ? s = "Sixteenth Ratchet";
    p == 4 ? s = "Triplet Trail";
    p == 5 ? s = "Rising Fifths";
    p == 6 ? s = "Falling Octaves";
    p == 7 ? s = "Chromatic Climb";
    p == 8 ? s = "Echoes Only";
    p == 9 ? s = "Free Time Slapback";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@block
  qn = qi = 0;
  while (midirecv(ofs, m1, m2, m3)) (
    qn < QMAX ? (
      Q[qn * 4] = min(max(ofs, 0), samplesblock - 1);
      Q[qn * 4 + 1] = m1;
      Q[qn * 4 + 2] = m2;
      Q[qn * 4 + 3] = m3;
      qn += 1;
    );
  );
  iv = tsync ? 60 / tempo * (slider4 == 0 ? 1 : slider4 == 1 ? 0.5 : slider4 == 2 ? 0.25 : slider4 == 3 ? 0.125 :
                             slider4 == 4 ? 2 : slider4 == 5 ? 1 / 3 : slider4 == 6 ? 1 / 6 : 0.75) : slider2 / 1000;
  iv = max(1, floor(iv * srate));
  len = max(1, floor(iv * gate));
  si = 0;

@sample
  // the echoes that are due go first
  while (eh < et && E[eh * 5] <= now) (
    E[eh * 5 + 1] >= 0x90 ? ne_on(si, E[eh * 5 + 1] & 15, E[eh * 5 + 2], E[eh * 5 + 3], E[eh * 5 + 4])
                          : ne_off(si, E[eh * 5 + 1] & 15, E[eh * 5 + 2], E[eh * 5 + 4]);
    eh += 1;
  );
  eh >= et ? eh = et = 0;
  // then the MIDI that came in at this sample
  while (qi < qn && Q[qi * 4] <= si) (
    m1 = Q[qi * 4 + 1];
    m2 = Q[qi * 4 + 2];
    m3 = Q[qi * 4 + 3];
    st = m1 & 0xF0;
    ch = m1 & 15;
    st == 0x90 && m3 > 0 ? (
      dry ? (
        ne_on(si, ch, m2, m3, next_id);
        ORG[ch * 128 + m2] = next_id;
        next_id += 1;
      );
      ne_note(now, ch, m2, m3);
    ) : st == 0x80 || st == 0x90 ? (
      dry ? ne_off(si, ch, m2, ORG[ch * 128 + m2]);
    ) : (
      st == 0xB0 && (m2 == 120 || m2 == 123) ? ne_flush(si, ch);
      midisend(si, m1, m2, m3);
    );
    qi += 1;
  );
  now += 1;
  si += 1;
  // the audio passes through
  spl0 = spl0;
  spl1 = spl1;

@gfx 480 380
  ng_knobs_begin("NOTE ECHO", "MIDI", 480, 120, 2, 0);

  // display: the note that comes in (dim, unless Dry is Off) and its echoes, one bar each at
  // its time, as high as its velocity, with its pitch step; the interval and the echoes sent
  ne_px = ng_vx + 8; ne_py = ng_vy + 18; ne_pw = ng_vw - 16; ne_ph = ng_vh - 34;
  ng_plot(ne_px, ne_py, ne_pw, ne_ph);
  ng_grid(reps + 1, 4, 0);
  ng_font(4, 8, 0);
  ne_k = 0;
  ne_go = 1;
  loop(reps + 1,
    ne_v = (1 - dec) ^ ne_k;
    ne_p = ne_k * pstep;
    ne_go && (ne_k == 0 || floor(100 * ne_v + 0.5) >= 1) && 60 + ne_p >= 0 && 60 + ne_p <= 127 ? (
      ne_x = ng_px + ng_pw * (ne_k + 0.1) / (reps + 1);
      ne_w = ng_pw * 0.8 * gate / (reps + 1);
      ne_k == 0 ? ng_col(dry ? NG_MUTED : NG_BORDER, 1) : ng_col(NG_ACCENT, 0.4 + 0.6 * ne_v);
      gfx_rect(ne_x, ng_py + ng_ph * (1 - ne_v), max(1, ne_w), ng_ph * ne_v);
      pstep != 0 && ne_k > 0 ? (
        ng_col(NG_MUTED, 1);
        sprintf(#ne_l, "%+d", ne_p);
        gfx_x = ne_x; gfx_y = ng_py + ng_ph * (1 - ne_v) - gfx_texth - 2 * ng_s;
        gfx_drawstr(#ne_l);
      );
    ) : ne_go = 0;
    ne_k += 1;
  );
  ng_font(1, 7, 1);
  ng_col(NG_ACCENT, 1);
  sprintf(#ne_s1, "%d REPEATS   %.0f MS", reps, iv / srate * 1000);
  ng_txt(#ne_s1, ne_px, ng_vy + 8, 0, 1);
  ng_col(NG_MUTED, 1);
  sprintf(#ne_s2, "ECHOES SENT %d", echoes);
  ng_txt(#ne_s2, ne_px + ne_pw, ng_vy + 8, 2, 1);

  ng_row(4);
  sprintf(#ne_v1, "%d", slider1);
  ng_knob_ctl(1, "REPEATS", #ne_v1, 1, 16, 3, 1, 0) ? update();
  sprintf(#ne_v2, "%d ms", slider2);
  ng_knob_ctl(2, "TIME", #ne_v2, 10, 2000, 250, 1, 0) ? update();
  ng_select_ctl(3, "SYNC", "OFF|ON", 0) ? update();
  ng_select_ctl(4, "NOTE", "1/4|1/8|1/16|1/32|1/2|1/8T|1/16T|1/8D", 0) ? update();
  ng_row(4);
  sprintf(#ne_v5, "%d%%", slider5);
  ng_knob_ctl(5, "DECAY", #ne_v5, 0, 100, 20, 1, 0) ? update();
  sprintf(#ne_v6, "%+d st", slider6);
  ng_knob_ctl(6, "PITCH", #ne_v6, -12, 12, 0, 1, 1) ? update();
  sprintf(#ne_v7, "%d%%", slider7);
  ng_knob_ctl(7, "GATE", #ne_v7, 5, 95, 50, 1, 0) ? update();
  ng_select_ctl(8, "DRY", "OFF|ON", 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
