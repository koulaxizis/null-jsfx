desc:NULL Multi-Tap Delay GFX
author: Christos Koulaxizis
tags: delay multi tap multitap rhythmic echo pattern dotted triplet swing accelerate scatter tempo sync stereo spread gui
//category: Essentials
//NULL JSFX v2.8 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:4<1,8,1>-Taps
slider2:0<0,6,1{Even,Dotted,Triplet,Swing,Speed Up,Slow Down,Scatter}>-Pattern
slider3:250<10,1000,1>-Time (ms)
slider4:0<0,1,1{Off,On}>-Tempo Sync
slider5:1<0,4,1{1/4,1/8,1/16,1/32,1/2}>-Subdivision
slider6:30<0,100,1>-Decay (%)
slider7:50<0,100,1>-Spread (%)
slider8:0<0,90,1>-Feedback (%)
slider9:20<20,2000,1:log>-Low Cut (Hz)
slider10:20000<1000,20000,1:log>-High Cut (Hz)
slider11:35<0,100,1>-Mix (%)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep the echoes, as in the VST3/CLAP
  // NULL Multi-Tap Delay (../multi_tap_delay.jsfx) with its own interface: same audio code, plus @gfx.
  // Up to eight echoes from one stereo delay line (4 s per channel). Time (or a tempo-synced
  // note) is the step; Pattern places tap k (1..Taps) at a multiple of it: Even k, Dotted
  // 1.5 k, Triplet 2/3 k, Swing k with every odd tap a third of a step late, Speed Up with
  // each gap 0.8 times the one before, Slow Down with each 1.25 times, and Scatter from a fixed
  // table. Taps past the 4 s line are held at its end. Tap k has the level (1 - Decay)^(k - 1)
  // and is panned left and right in turn, by Spread. Feedback sends the last tap back into the
  // line. Low Cut and High Cut (12 dB/oct) shape the echoes only, and Mix blends them with the
  // dry signal.
  bufn = floor(4 * srate);
  BL = 0;
  BR = bufn;
  TP = 2 * bufn;               // tap positions (8), then levels (8), left gains (8), right gains (8)
  memset(0, 0, 2 * bufn + 32);
  wp = 0;
  h1l = h2l = h1r = h2r = 0;
  l1l = l2l = l1r = l2r = 0;

  // RBJ biquad coefficients: kind 0 = high-pass, 1 = low-pass, Q = 1/sqrt(2)
  function mt_bq(kind, f) local(w0, cw, al, a0)
  (
    w0 = 2 * $pi * min(f, 0.45 * srate) / srate;
    cw = cos(w0);
    al = sin(w0) / (2 * 0.7071067811865476);
    a0 = 1 + al;
    this.b0 = (kind ? (1 - cw) / 2 : (1 + cw) / 2) / a0;
    this.b1 = (kind ? 1 - cw : -(1 + cw)) / a0;
    this.b2 = this.b0;
    this.a1 = -2 * cw / a0;
    this.a2 = (1 - al) / a0;
  );

  function mt_update() local(step, k, t, g, p, sp)
  (
    step = tsync && tempo > 0 ? 60000 / tempo * (slider5 == 0 ? 1 : slider5 == 1 ? 0.5 : slider5 == 2 ? 0.25 :
                                                  slider5 == 3 ? 0.125 : 2) : slider3;
    step = step * srate / 1000;
    ntap = slider1;
    k = 1;
    t = 0;
    g = 1;
    sp = slider7 / 100;
    loop(8,
      slider2 == 0 ? t = k :
      slider2 == 1 ? t = 1.5 * k :
      slider2 == 2 ? t = 2 * k / 3 :
      slider2 == 3 ? t = k + (k % 2 == 1 ? 1 / 3 : 0) :
      slider2 == 4 ? t = (1 - 0.8 ^ k) / 0.2 :
      slider2 == 5 ? t = (1.25 ^ k - 1) / 0.25 :
      t = k == 1 ? 0.75 : k == 2 ? 1.5 : k == 3 ? 2.75 : k == 4 ? 3 : k == 5 ? 4.25 : k == 6 ? 5.5 : k == 7 ? 6 : 7.25;
      TP[k - 1] = max(1, min(bufn - 2, floor(t * step + 0.5)));
      TP[8 + k - 1] = g;
      p = (k % 2 == 1 ? -1 : 1) * sp;
      TP[16 + k - 1] = g * (p <= 0 ? 1 : 1 - p);
      TP[24 + k - 1] = g * (p >= 0 ? 1 : 1 - p);
      g *= 1 - slider6 / 100;
      k += 1;
    );
  );
  gfx_ext_retina = 1;

  function update()
  (
    tsync = slider4;
    fb = slider8 / 100;
    lc_on = slider9 > 20;
    hc_on = slider10 < 20000;
    lc.mt_bq(0, slider9);
    hc.mt_bq(1, slider10);
    mix = slider11 / 100;
    mt_update();
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 10;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1); ng_hist_add(2); ng_hist_add(3); ng_hist_add(4); ng_hist_add(5); ng_hist_add(6); ng_hist_add(7); ng_hist_add(8); ng_hist_add(9); ng_hist_add(10); ng_hist_add(11);
  ng_hist_init();

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 4); ng_slider_set(2, 0); ng_slider_set(3, 250); ng_slider_set(4, 0); ng_slider_set(5, 1); ng_slider_set(6, 30); ng_slider_set(7, 50); ng_slider_set(8, 0); ng_slider_set(9, 20); ng_slider_set(10, 20000); ng_slider_set(11, 35); );
    p == 1 ? ( ng_slider_set(1, 4); ng_slider_set(2, 1); ng_slider_set(3, 250); ng_slider_set(4, 1); ng_slider_set(5, 1); ng_slider_set(6, 35); ng_slider_set(7, 50); ng_slider_set(8, 0); ng_slider_set(9, 20); ng_slider_set(10, 20000); ng_slider_set(11, 30); );
    p == 2 ? ( ng_slider_set(1, 6); ng_slider_set(2, 2); ng_slider_set(3, 250); ng_slider_set(4, 1); ng_slider_set(5, 0); ng_slider_set(6, 25); ng_slider_set(7, 50); ng_slider_set(8, 0); ng_slider_set(9, 20); ng_slider_set(10, 20000); ng_slider_set(11, 35); );
    p == 3 ? ( ng_slider_set(1, 6); ng_slider_set(2, 3); ng_slider_set(3, 250); ng_slider_set(4, 1); ng_slider_set(5, 1); ng_slider_set(6, 30); ng_slider_set(7, 70); ng_slider_set(8, 0); ng_slider_set(9, 20); ng_slider_set(10, 20000); ng_slider_set(11, 35); );
    p == 4 ? ( ng_slider_set(1, 8); ng_slider_set(2, 4); ng_slider_set(3, 400); ng_slider_set(4, 0); ng_slider_set(5, 1); ng_slider_set(6, 15); ng_slider_set(7, 30); ng_slider_set(8, 0); ng_slider_set(9, 20); ng_slider_set(10, 20000); ng_slider_set(11, 35); );
    p == 5 ? ( ng_slider_set(1, 7); ng_slider_set(2, 5); ng_slider_set(3, 90); ng_slider_set(4, 0); ng_slider_set(5, 1); ng_slider_set(6, 20); ng_slider_set(7, 50); ng_slider_set(8, 0); ng_slider_set(9, 20); ng_slider_set(10, 6000); ng_slider_set(11, 35); );
    p == 6 ? ( ng_slider_set(1, 8); ng_slider_set(2, 6); ng_slider_set(3, 120); ng_slider_set(4, 0); ng_slider_set(5, 1); ng_slider_set(6, 18); ng_slider_set(7, 100); ng_slider_set(8, 20); ng_slider_set(9, 20); ng_slider_set(10, 20000); ng_slider_set(11, 40); );
    p == 7 ? ( ng_slider_set(1, 2); ng_slider_set(2, 0); ng_slider_set(3, 90); ng_slider_set(4, 0); ng_slider_set(5, 1); ng_slider_set(6, 40); ng_slider_set(7, 80); ng_slider_set(8, 0); ng_slider_set(9, 20); ng_slider_set(10, 20000); ng_slider_set(11, 25); );
    p == 8 ? ( ng_slider_set(1, 3); ng_slider_set(2, 1); ng_slider_set(3, 250); ng_slider_set(4, 1); ng_slider_set(5, 0); ng_slider_set(6, 30); ng_slider_set(7, 50); ng_slider_set(8, 55); ng_slider_set(9, 200); ng_slider_set(10, 3500); ng_slider_set(11, 35); );
    p == 9 ? ( ng_slider_set(1, 8); ng_slider_set(2, 0); ng_slider_set(3, 250); ng_slider_set(4, 1); ng_slider_set(5, 2); ng_slider_set(6, 22); ng_slider_set(7, 100); ng_slider_set(8, 0); ng_slider_set(9, 20); ng_slider_set(10, 20000); ng_slider_set(11, 35); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 4) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 250) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 1) && ng_pre_eq(slider6, 30) && ng_pre_eq(slider7, 50) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 20) && ng_pre_eq(slider10, 20000) && ng_pre_eq(slider11, 35) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 4) && ng_pre_eq(slider2, 1) && ng_pre_eq(slider3, 250) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 1) && ng_pre_eq(slider6, 35) && ng_pre_eq(slider7, 50) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 20) && ng_pre_eq(slider10, 20000) && ng_pre_eq(slider11, 30) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 6) && ng_pre_eq(slider2, 2) && ng_pre_eq(slider3, 250) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 25) && ng_pre_eq(slider7, 50) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 20) && ng_pre_eq(slider10, 20000) && ng_pre_eq(slider11, 35) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 6) && ng_pre_eq(slider2, 3) && ng_pre_eq(slider3, 250) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 1) && ng_pre_eq(slider6, 30) && ng_pre_eq(slider7, 70) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 20) && ng_pre_eq(slider10, 20000) && ng_pre_eq(slider11, 35) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 8) && ng_pre_eq(slider2, 4) && ng_pre_eq(slider3, 400) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 1) && ng_pre_eq(slider6, 15) && ng_pre_eq(slider7, 30) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 20) && ng_pre_eq(slider10, 20000) && ng_pre_eq(slider11, 35) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 7) && ng_pre_eq(slider2, 5) && ng_pre_eq(slider3, 90) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 1) && ng_pre_eq(slider6, 20) && ng_pre_eq(slider7, 50) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 20) && ng_pre_eq(slider10, 6000) && ng_pre_eq(slider11, 35) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 8) && ng_pre_eq(slider2, 6) && ng_pre_eq(slider3, 120) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 1) && ng_pre_eq(slider6, 18) && ng_pre_eq(slider7, 100) && ng_pre_eq(slider8, 20) && ng_pre_eq(slider9, 20) && ng_pre_eq(slider10, 20000) && ng_pre_eq(slider11, 40) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 90) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 1) && ng_pre_eq(slider6, 40) && ng_pre_eq(slider7, 80) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 20) && ng_pre_eq(slider10, 20000) && ng_pre_eq(slider11, 25) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 3) && ng_pre_eq(slider2, 1) && ng_pre_eq(slider3, 250) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 30) && ng_pre_eq(slider7, 50) && ng_pre_eq(slider8, 55) && ng_pre_eq(slider9, 200) && ng_pre_eq(slider10, 3500) && ng_pre_eq(slider11, 35) ? m = 8;
    m < 0 && ng_pre_eq(slider1, 8) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 250) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 2) && ng_pre_eq(slider6, 22) && ng_pre_eq(slider7, 100) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 20) && ng_pre_eq(slider10, 20000) && ng_pre_eq(slider11, 35) ? m = 9;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Dotted Eighths";
    p == 2 ? s = "Triplet Bounce";
    p == 3 ? s = "Swing Echo";
    p == 4 ? s = "Bouncing Ball";
    p == 5 ? s = "Slow Down Tail";
    p == 6 ? s = "Scatter Cloud";
    p == 7 ? s = "Slapback Pair";
    p == 8 ? s = "Dub Space";
    p == 9 ? s = "Wide Rhythm";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@block
  tsync ? mt_update();

@sample
  // the echoes: every tap reads the line, panned; the last tap also feeds back
  wl = wr = 0;
  i = 0;
  loop(ntap,
    rp = wp - TP[i];
    rp < 0 ? rp += bufn;
    dl = BL[rp];
    dr = BR[rp];
    wl += dl * TP[16 + i];
    wr += dr * TP[24 + i];
    i += 1;
  );
  BL[wp] = spl0 + fb * dl;
  BR[wp] = spl1 + fb * dr;
  wp += 1;
  wp >= bufn ? wp = 0;
  lc_on ? (
    x = wl;
    wl = lc.b0 * x + h1l;
    h1l = lc.b1 * x - lc.a1 * wl + h2l;
    h2l = lc.b2 * x - lc.a2 * wl;
    x = wr;
    wr = lc.b0 * x + h1r;
    h1r = lc.b1 * x - lc.a1 * wr + h2r;
    h2r = lc.b2 * x - lc.a2 * wr;
  );
  hc_on ? (
    x = wl;
    wl = hc.b0 * x + l1l;
    l1l = hc.b1 * x - hc.a1 * wl + l2l;
    l2l = hc.b2 * x - hc.a2 * wl;
    x = wr;
    wr = hc.b0 * x + l1r;
    l1r = hc.b1 * x - hc.a1 * wr + l2r;
    l2r = hc.b2 * x - hc.a2 * wr;
  );
  spl0 += (wl - spl0) * mix;
  spl1 += (wr - spl1) * mix;

@gfx 480 380
  ng_knobs_begin("MULTI-TAP DELAY", "ESSENTIALS", 480, 120, 2, 0);

  // display: the taps on a time line (0 to the last tap), each as a bar up for its left level
  // and down for its right level
  ng_plot(ng_vx + 8, ng_vy + 14, ng_vw - 16, ng_vh - 28);
  ng_grid(8, 2, 0);
  mg_last = 1;
  mg_i = 0;
  loop(ntap, mg_last = max(mg_last, TP[mg_i]); mg_i += 1;);
  mg_mid = floor(ng_py + ng_ph * 0.5) + 0.5;
  ng_col(0x45433f, 1);
  gfx_line(ng_px, mg_mid, ng_px + ng_pw, mg_mid, 0);
  ng_col(NG_ACCENT, 1);
  mg_i = 0;
  loop(ntap,
    mg_x = ng_px + ng_pw * TP[mg_i] / mg_last - 2 * ng_s;
    mg_hl = ng_ph * 0.5 * TP[16 + mg_i];
    mg_hr = ng_ph * 0.5 * TP[24 + mg_i];
    mg_hl > 0 ? gfx_rect(mg_x, mg_mid - mg_hl, 4 * ng_s, mg_hl);
    mg_hr > 0 ? gfx_rect(mg_x, mg_mid, 4 * ng_s, mg_hr);
    mg_i += 1;
  );
  ng_font(1, 7, 1);
  ng_col(NG_ACCENT, 1);
  sprintf(#mg_s, "%d TAPS   %d MS", ntap, floor(mg_last * 1000 / srate + 0.5));
  ng_txt(#mg_s, ng_vx + 8, ng_vy + 6, 0, 1);
  ng_col(NG_MUTED, 1);
  ng_txt("L", ng_vx + ng_vw - 8, ng_vy + 6, 2, 1);
  ng_txt("R", ng_vx + ng_vw - 8, ng_vy + ng_vh - 6, 2, 1);

  ng_row(6);
  sprintf(#mg_v1, "%d", slider1);
  ng_knob_ctl(1, "TAPS", #mg_v1, 1, 8, 4, 1, 0) ? update();
  ng_select_ctl(2, "PATTERN", "EVEN|DOTTED|TRIPLET|SWING|SPEED UP|SLOW DOWN|SCATTER", 0) ? update();
  sprintf(#mg_v3, "%d ms", slider3);
  ng_knob_ctl(3, "TIME", #mg_v3, 10, 1000, 250, 1, 0) ? update();
  ng_select_ctl(4, "SYNC", "OFF|ON", 0) ? update();
  ng_select_ctl(5, "NOTE", "1/4|1/8|1/16|1/32|1/2", 0) ? update();
  sprintf(#mg_v6, "%d%%", slider6);
  ng_knob_ctl(6, "DECAY", #mg_v6, 0, 100, 30, 1, 0) ? update();
  ng_row(5);
  sprintf(#mg_v7, "%d%%", slider7);
  ng_knob_ctl(7, "SPREAD", #mg_v7, 0, 100, 50, 1, 0) ? update();
  sprintf(#mg_v8, "%d%%", slider8);
  ng_knob_ctl(8, "FEEDBACK", #mg_v8, 0, 90, 0, 1, 0) ? update();
  slider9 >= 1000 ? sprintf(#mg_v9, "%.1f kHz", slider9 / 1000) : sprintf(#mg_v9, "%d Hz", slider9);
  ng_knob_ctl_log(9, "LOW CUT", #mg_v9, 20, 2000, 20, 1) ? update();
  slider10 >= 1000 ? sprintf(#mg_v10, "%.1f kHz", slider10 / 1000) : sprintf(#mg_v10, "%d Hz", slider10);
  ng_knob_ctl_log(10, "HIGH CUT", #mg_v10, 1000, 20000, 20000, 1) ? update();
  sprintf(#mg_v11, "%d%%", slider11);
  ng_knob_ctl(11, "MIX", #mg_v11, 0, 100, 35, 1, 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
