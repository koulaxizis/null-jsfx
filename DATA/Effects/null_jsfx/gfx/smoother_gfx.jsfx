desc:NULL Smoother GFX
author: Christos Koulaxizis
tags: smoother smooth harsh harshness resonance dynamic eq soothe tame sibilance upper mids one knob gui
//category: One Slider
//NULL JSFX v4.2 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:40<0,100,1>-Amount

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // NULL Smoother (../smoother.jsfx) with its own interface: same audio code, plus @gfx.
  // One knob that softens harsh frequencies only while they poke out: four bands (2, 3.15, 5
  // and 8 kHz, Q 2) watch their share of the whole signal (mono sum, 2 ms attack, 80 ms
  // release). A band whose share rises above a threshold (-14 dB at 0, -20 dB at 100) is cut
  // by what it rises over it, as far as 10 dB at 100. Quiet, balanced material passes untouched.
  sm_att = 1 - exp(-1 / (0.002 * srate));
  sm_rel = 1 - exp(-1 / (0.08 * srate));
  // band k (0 to 3): band-pass biquad with 0 dB at its peak, coefficients at sm_c + 4 * k
  sm_c = 0;
  sm_k = 0;
  loop(4,
    sm_f = min(sm_k == 0 ? 2000 : sm_k == 1 ? 3150 : sm_k == 2 ? 5000 : 8000, 0.45 * srate);
    sm_w = 2 * $pi * sm_f / srate;
    sm_al = sin(sm_w) / (2 * 2);
    sm_c[4 * sm_k] = sm_al / (1 + sm_al);
    sm_c[4 * sm_k + 1] = -2 * cos(sm_w) / (1 + sm_al);
    sm_c[4 * sm_k + 2] = (1 - sm_al) / (1 + sm_al);
    sm_k += 1;
  );
  // filter states, 4 per filter: detection at 16, left at 32, right at 48 (+ 4 * band)
  memset(16, 0, 48);
  sm_e = 0;
  memset(64, 0, 4);            // band envelopes
  freembuf(68);

  // band k on the state at s: y = b0 x - b0 x2 - a1 y1 - a2 y2
  function sm_bp(s, k, x) local(y)
  (
    y = sm_c[4 * k] * (x - s[1]) - sm_c[4 * k + 1] * s[2] - sm_c[4 * k + 2] * s[3];
    s[1] = s[0]; s[0] = x;
    s[3] = s[2]; s[2] = y;
    y;
  );
  gfx_ext_retina = 1;

  function update()
  (
    sm_a = slider1 / 100;
    sm_thr = -14 - 6 * sm_a;
    sm_max = 10 * sm_a;
  );

  // the deepest the four cuts can go together, in dB at frequency f: |prod (1 - g H_k)|
  function sm_db(f) local(w, c1, s1, c2, s2, g, k, nr, ni, dr, di, d, hr, hi, pr, pi, tr, ti)
  (
    w = 2 * $pi * min(f, srate * 0.499) / srate;
    c1 = cos(w); s1 = sin(w); c2 = cos(2 * w); s2 = sin(2 * w);
    g = 1 - 10 ^ (-sm_max / 20);
    pr = 1; pi = 0;
    k = 0;
    loop(4,
      nr = sm_c[4 * k] * (1 - c2); ni = sm_c[4 * k] * s2;
      dr = 1 + sm_c[4 * k + 1] * c1 + sm_c[4 * k + 2] * c2; di = -(sm_c[4 * k + 1] * s1 + sm_c[4 * k + 2] * s2);
      d = max(dr * dr + di * di, 0.0000000001);
      hr = 1 - g * (nr * dr + ni * di) / d; hi = -g * (ni * dr - nr * di) / d;
      tr = pr * hr - pi * hi; ti = pr * hi + pi * hr;
      pr = tr; pi = ti;
      k += 1;
    );
    10 * log10(max(pr * pr + pi * pi, 0.0000000001));
  );

  // a text at pixel (x, y), vertically centred; align 0 left, 1 centre, 2 right
  function smo_lbl(str, x, y, align) local(w, h)
  (
    gfx_measurestr(str, w, h);
    gfx_x = align == 1 ? x - w / 2 : (align == 2 ? x - w : x);
    gfx_y = y - gfx_texth / 2;
    gfx_drawstr(str);
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 12;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1);
  ng_hist_init();
  ng_dice_add(1, 0, 100, 1, 0);

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 40); );
    p == 1 ? ( ng_slider_set(1, 15); );
    p == 2 ? ( ng_slider_set(1, 45); );
    p == 3 ? ( ng_slider_set(1, 70); );
    p == 4 ? ( ng_slider_set(1, 55); );
    p == 5 ? ( ng_slider_set(1, 60); );
    p == 6 ? ( ng_slider_set(1, 25); );
    p == 7 ? ( ng_slider_set(1, 20); );
    p == 8 ? ( ng_slider_set(1, 50); );
    p == 9 ? ( ng_slider_set(1, 35); );
    p == 10 ? ( ng_slider_set(1, 100); );
    p == 11 ? ( ng_slider_set(1, 65); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 40) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 15) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 45) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 70) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 55) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 60) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 25) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 20) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 50) ? m = 8;
    m < 0 && ng_pre_eq(slider1, 35) ? m = 9;
    m < 0 && ng_pre_eq(slider1, 100) ? m = 10;
    m < 0 && ng_pre_eq(slider1, 65) ? m = 11;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Light Polish";
    p == 2 ? s = "Vocal Smooth";
    p == 3 ? s = "Harsh Vocal Fix";
    p == 4 ? s = "Cymbal Tamer";
    p == 5 ? s = "Guitar Fizz Softener";
    p == 6 ? s = "Bright Mix Bus";
    p == 7 ? s = "Master Silk";
    p == 8 ? s = "Brass Edge Off";
    p == 9 ? s = "Strings Softener";
    p == 10 ? s = "Maximum Smooth";
    p == 11 ? s = "Podcast De-Harsh";
    s;
  );

  // the hint line under the controls: a short help text per slider (from tools/site_content.json)
  function ng_hint_text(i) local(s)
  (
    s = "";
    i == 1 ? s = "How much harshness to soften: 0 is off; higher values lower the threshold (-14 to -20 dB of a band's share";
    s;
  );

  function ng_presets() local(i)
  (
    ng_hint_i > 0 && !ng_pre_open ? ng_hint(ng_hint_text(ng_hint_i));
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  sm_m = (spl0 + spl1) * 0.5;
  sm_p = sm_m * sm_m;
  sm_e += (sm_p - sm_e) * (sm_p > sm_e ? sm_att : sm_rel);
  sm_l = spl0;
  sm_r = spl1;
  sm_k = 0;
  loop(4,
    sm_b = sm_bp(16 + 4 * sm_k, sm_k, sm_m);
    sm_b *= sm_b;
    sm_eb = 64[sm_k];
    sm_eb += (sm_b - sm_eb) * (sm_b > sm_eb ? sm_att : sm_rel);
    64[sm_k] = sm_eb;
    sm_rel_db = 10 * log10(max(sm_eb, 0.0000000001) / max(sm_e, 0.0000000001));
    sm_red = min(sm_max, max(0, (sm_rel_db - sm_thr) * sm_a));
    sm_g = 1 - 10 ^ (-sm_red / 20);
    sm_l -= sm_bp(32 + 4 * sm_k, sm_k, sm_l) * sm_g;
    sm_r -= sm_bp(48 + 4 * sm_k, sm_k, sm_r) * sm_g;
    sm_k += 1;
  );
  spl0 = sm_l;
  spl1 = sm_r;

@gfx 360 240
  ng_one_slider_begin("SMOOTHER");

  // display: the four bands (2, 3.15, 5 and 8 kHz) and the deepest they can cut together;
  // they only cut while a band pokes out of the mix
  ng_plot(46, 64, 284, 78);
  ng_grid_freq(18);
  ng_col(NG_ACCENT, 0.5);
  sm_i = 0;
  loop(4,
    xx = floor(ng_freq_x(sm_i == 0 ? 2000 : sm_i == 1 ? 3150 : sm_i == 2 ? 5000 : 8000)) + 0.5;
    yy = ng_py;
    while(
      gfx_line(xx, yy, xx, min(yy + 3 * ng_s, ng_py + ng_ph), 0);
      yy += 6 * ng_s;
      yy < ng_py + ng_ph;
    );
    sm_i += 1;
  );
  zy = ng_lin_y(0, -12, 12);
  ng_col(NG_ACCENT, 0.10);
  i = 0;
  loop(floor(ng_pw) + 1,
    gfx_line(ng_px + i, zy, ng_px + i, ng_lin_y(sm_db(20 * 1000 ^ (i / ng_pw)), -12, 12), 0);
    i += 1;
  );
  ng_col(NG_ACCENT, 1);
  i = 0;
  loop(floor(ng_pw) + 1,
    yy = ng_lin_y(sm_db(20 * 1000 ^ (i / ng_pw)), -12, 12);
    i == 0 ? ng_line_start(ng_px, yy) : ng_line_to(ng_px + i, yy);
    i += 1;
  );

  // slider card
  slider1 == 0 ? sprintf(#cap, "OFF") : sprintf(#cap, "4 BANDS  CUT UP TO %.1f dB", sm_max);
  sprintf(#val, "%d", floor(slider1 + 0.5));
  ng_set_slider(ng_one_slider_control("AMOUNT", #cap, #val, "OFF", "SMOOTH", slider1, 0, 100, 40, 0), 1) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
