  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Straight Sixteenths";
    p == 2 ? s = "Dotted Gallop";
    p == 3 ? s = "Quarter Pulse Gate";
    p == 4 ? s = "Soft Pad Pulse";
    p == 5 ? s = "Thirty Second Stutter";
    p == 6 ? s = "Sparse Accent Hits";
    p == 7 ? s = "Offbeat Chop";
    p == 8 ? s = "Free Rate Flutter";
    p == 9 ? s = "Random Sixteenths";
    p == 10 ? s = "Sparse Random Chop";
    p == 11 ? s = "Humanized Pulse";
    p == 12 ? s = "Glitchy Thirty Seconds";
    p == 13 ? s = "Soft Random Pad";
    p == 14 ? s = "Generated Trance Gate";
    p == 15 ? s = "Generated Offbeat Pump";
    p == 16 ? s = "Generated Stutter";
    p == 17 ? s = "Generated Half Time Chop";
    p == 18 ? s = "Generative Flow Gate";
    p == 19 ? s = "Generative Mutate Gate";
    s;
  );

  // the hint line under the controls: a short help text per slider (from tools/site_content.json)
  function ng_hint_text(i) local(s)
  (
    s = "";
    i == 1 ? s = "Step 1 open or closed";
    i == 2 ? s = "Step 2 open or closed";
    i == 3 ? s = "Step 3 open or closed";
    i == 4 ? s = "Step 4 open or closed";
    i == 5 ? s = "Step 5 open or closed";
    i == 6 ? s = "Step 6 open or closed";
    i == 7 ? s = "Step 7 open or closed";
    i == 8 ? s = "Step 8 open or closed";
    i == 9 ? s = "Step 9 open or closed";
    i == 10 ? s = "Step 10 open or closed";
    i == 11 ? s = "Step 11 open or closed";
    i == 12 ? s = "Step 12 open or closed";
    i == 13 ? s = "Step 13 open or closed";
    i == 14 ? s = "Step 14 open or closed";
    i == 15 ? s = "Step 15 open or closed";
    i == 16 ? s = "Step 16 open or closed";
    i == 17 ? s = "Sync: steps follow the host tempo and lock to the bar grid while playing; Free: steps run at Free Rate";
    i == 18 ? s = "Note value of one step in Sync mode (1/16 = classic trance gate)";
    i == 19 ? s = "Steps per second in Free mode (8 Hz = 16ths at 120 BPM)";
    i == 20 ? s = "Time for the gate to ramp open";
    i == 21 ? s = "Time for the gate to ramp closed";
    i == 22 ? s = "How far closed steps are turned down (0% = no gating, 100% = silence)";
    i == 23 ? s = "Chance that an open step actually opens the gate (100% = always, as programmed)";
    i == 24 ? s = "Picks a different random variation; the same Seed always gives the same choices at the same song position";
    i == 25 ? s = "On: plays a pattern made from Seed, Density and Style instead of the 16 Step switches (they keep their";
    i == 26 ? s = "How many steps the generated pattern opens; a higher Density only adds steps, the ones already there stay";
    i == 27 ? s = "The rhythm the generated pattern follows: Trance, Offbeat, Stutter, Half Time or Random";
    i == 28 ? s = "Hard: each step holds its level; Flow: the gain glides from each step to the next for a smooth, pulsing gate";
    i == 29 ? s = "How much of the pattern is drawn anew every Mutate Every cycles (0% = the pattern stays as it is)";
    i == 30 ? s = "How often Mutate draws a new variation, in cycles of 16 steps";
    s;
  );

  function ng_presets() local(i)
  (
    ng_hint_i > 0 && !ng_pre_open ? ng_hint(ng_hint_text(ng_hint_i));
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@block
  bpm = tempo > 0 ? tempo : 120;
  free_mode ? (
    step_inc = free_rate / srate;
  ) : (
    step_inc = bpm / 60 * steps_per_beat / srate;
    // lock to the host grid while playing
    play_state & 1 ? (
      step_pos = beat_position * steps_per_beat;
      rnd_pos = step_pos;
    );
  );

@sample
  step_pos += step_inc;
  rnd_pos += step_inc;
  // keep the free-running counter small (the synced one is re-read every block)
  step_pos >= 16 ? step_pos -= 16;
  s = floor(step_pos);
  cur_step = s - 16 * floor(s / 16);       // also correct for negative positions (pre-roll)
  mut > 0 ? (
    // Mutate: a new variation at every cycle block
    mb = floor(floor(rnd_pos) / (16 * mev));
    mb != mb_last ? ( mb_last = mb; tg_mut(mb); );
    on_c = PM[cur_step];
    on_n = PM[(cur_step + 1) % 16];
  ) : (
    on_c = pat[cur_step];
    on_n = pat[(cur_step + 1) % 16];
  );
  prob < 1 ? (
    // Probability: a new draw whenever the step changes
    rnd_i = floor(rnd_pos);
    rnd_i != rnd_last ? (
      rnd_last = rnd_i;
      rnd_keep = pm_step(rnd_i, rnd_seed) < prob;
      flow ? rnd_keep_n = pm_step(rnd_i + 1, rnd_seed) < prob;
    );
    k_c = rnd_keep;
    k_n = rnd_keep_n;
  ) : (
    k_c = 1;
    k_n = 1;
  );
  target = 1 - gate_depth * (1 - on_c * k_c);
  flow ? (
    // Flow: from this step's level to the next one's over the step
    t_n = 1 - gate_depth * (1 - on_n * k_n);
    t_f = step_pos - floor(step_pos);
    target += (t_n - target) * (0.5 - 0.5 * cos($pi * t_f));
  );

  target > gate_gain ? (
    gate_gain += attack_coef;
    gate_gain > target ? gate_gain = target;
  ) : (
    gate_gain -= release_coef;
    gate_gain < target ? gate_gain = target;
  );

  spl0 *= gate_gain;
  spl1 *= gate_gain;

@gfx 480 408
  ng_knobs_begin("TRANCE GATE", "ADVANCED", 480, 120, 2, 1);

  // display (pat[] holds the steps, see update()): the 16 steps (click one to switch it; with
  // Generate On they are the generated ones and a click does nothing), the playing step marked below, and the
  // gain over the pattern as Attack, Release and Depth shape it (an "on" step that Probability
  // skips this time is drawn as off while it plays)
  ng_plot(ng_vx + 26, ng_vy + 4, ng_vw - 30, ng_vh - 20);
  ng_font(4, 8, 0);
  ng_col(NG_MUTED, 1);
  ng_ptxt("100%", ng_px - 6 * ng_s, ng_py, 2);
  ng_ptxt("50%", ng_px - 6 * ng_s, ng_py + ng_ph / 2, 2);
  ng_ptxt("0", ng_px - 6 * ng_s, ng_py + ng_ph, 2);
  tg_cw = ng_pw / 16;
  tg_k = 0;
  loop(16,
    tg_x0 = ng_px + tg_k * tg_cw + ng_s;
    tg_w = tg_cw - 2 * ng_s;
    tg_on = pat[tg_k] >= 0.5;
    tg_on && (tg_k != cur_step || slider23 >= 100 || rnd_keep) ? ng_col(NG_ACCENT, tg_k == cur_step ? 0.40 : 0.22) : ng_col(tg_k == cur_step ? NG_BORDER : NG_BG, 1);
    gfx_rect(tg_x0, ng_py, tg_w, ng_ph);
    tg_k == cur_step ? (
      ng_col(NG_TEXT, 1);
      gfx_rect(tg_x0, ng_py + ng_ph + 2 * ng_s, tg_w, 2 * ng_s);
    );
    tg_k % 4 == 0 ? (
      sprintf(#tg_n, "%d", tg_k + 1);
      ng_col(NG_MUTED, 1);
      ng_ptxt(#tg_n, tg_x0 + tg_w / 2, ng_py + ng_ph + 11 * ng_s, 1);
    );
    ng_click && slider25 < 0.5 && mouse_x >= tg_x0 && mouse_x < tg_x0 + tg_w && mouse_y >= ng_py && mouse_y < ng_py + ng_ph ? (
      ng_slider_set(tg_k + 1, tg_on ? 0 : 1) ? update();
    );
    tg_k += 1;
  );

  // gain envelope: two passes over the pattern (the first settles the ramps), the second drawn
  tg_bpm = tempo > 0 ? tempo : 120;
  tg_dep = slider22 / 100;
  tg_st = slider17 ? 1 / slider19 : 60 / tg_bpm / (2 ^ slider18);
  tg_up = tg_st * 1000 / slider20;
  tg_dn = tg_st * 1000 / slider21;
  tg_g = 1;
  tg_pass = 0;
  ng_col(NG_ACCENT, 1);
  loop(2,
    tg_k = 0;
    loop(16,
      tg_tg = 1 - tg_dep * (pat[tg_k] >= 0.5 ? 0 : 1);
      tg_pass ? (
        tg_k == 0 ? ng_line_start(ng_px, ng_lin_y(tg_g, 0, 1)) : ng_line_to(ng_px + ng_pw * tg_k / 16, ng_lin_y(tg_g, 0, 1));
      );
      tg_rate = tg_tg > tg_g ? tg_up : tg_dn;
      tg_need = abs(tg_tg - tg_g) / tg_rate;
      tg_need < 1 ? (
        tg_pass ? ng_line_to(ng_px + ng_pw * (tg_k + tg_need) / 16, ng_lin_y(tg_tg, 0, 1));
        tg_g = tg_tg;
      ) : (
        tg_g += (tg_tg > tg_g ? tg_rate : -tg_rate);
      );
      tg_k += 1;
    );
    tg_pass += 1;
  );
  ng_line_to(ng_px + ng_pw, ng_lin_y(tg_g, 0, 1));

  tg_page = ng_tabs("GATE|STEPS 1-8|STEPS 9-16|GENERATE", tg_page);
  tg_page == 0 ? (
    ng_row(4);
    ng_select_ctl(17, "MODE", "SYNC|FREE", 0) ? update();
    ng_select_ctl(18, "NOTE", "1/4|1/8|1/16|1/32", 0) ? update();
    sprintf(#v19, "%.1f Hz", slider19);
    ng_knob_ctl(19, "FREE RATE", #v19, 0.5, 40, 8, 0.1, 0) ? update();
    sprintf(#v23, "%d%%", slider23);
    ng_knob_ctl(23, "PROBABILITY", #v23, 0, 100, 100, 1, 0) ? update();
    ng_row(4);
    sprintf(#v20, "%d ms", slider20);
    ng_knob_ctl(20, "ATTACK", #v20, 1, 100, 5, 1, 0) ? update();
    sprintf(#v21, "%d ms", slider21);
    ng_knob_ctl(21, "RELEASE", #v21, 10, 500, 40, 1, 0) ? update();
    sprintf(#v22, "%d%%", slider22);
    ng_knob_ctl(22, "DEPTH", #v22, 0, 100, 100, 1, 0) ? update();
    sprintf(#v24, "%d", slider24);
    ng_knob_ctl(24, "SEED", #v24, 0, 999, 0, 1, 0) ? update();
  ) : tg_page == 3 ? (
    // Generate (the pattern also uses SEED on the GATE tab)
    ng_row(3);
    ng_select_ctl(25, "GENERATE", "OFF|ON", 0) ? update();
    ng_select_ctl(27, "STYLE", "TRANCE|OFFBEAT|STUTTER|HALF TIME|RANDOM", 0) ? update();
    sprintf(#v26, "%d%%", slider26);
    ng_knob_ctl(26, "DENSITY", #v26, 0, 100, 50, 1, 0) ? update();
    // Shape and Mutate (appended 2026-11-18)
    ng_row(3);
    ng_select_ctl(28, "SHAPE", "HARD|FLOW", 0) ? update();
    slider29 > 0 ? sprintf(#v29, "%d%%", slider29) : strcpy(#v29, "OFF");
    ng_knob_ctl(29, "MUTATE", #v29, 0, 100, 0, 1, 0) ? update();
    ng_select_ctl(30, "EVERY", "1 CYCLE|2 CYCLES|4 CYCLES|8 CYCLES", 0) ? update();
  ) : tg_page == 1 ? (
    ng_row(4);
    ng_select_ctl(1, "STEP 1", "OFF|ON", 0) ? update();
    ng_select_ctl(2, "STEP 2", "OFF|ON", 0) ? update();
    ng_select_ctl(3, "STEP 3", "OFF|ON", 0) ? update();
    ng_select_ctl(4, "STEP 4", "OFF|ON", 0) ? update();
    ng_row(4);
    ng_select_ctl(5, "STEP 5", "OFF|ON", 0) ? update();
    ng_select_ctl(6, "STEP 6", "OFF|ON", 0) ? update();
    ng_select_ctl(7, "STEP 7", "OFF|ON", 0) ? update();
    ng_select_ctl(8, "STEP 8", "OFF|ON", 0) ? update();
  ) : (
    ng_row(4);
    ng_select_ctl(9, "STEP 9", "OFF|ON", 0) ? update();
    ng_select_ctl(10, "STEP 10", "OFF|ON", 0) ? update();
    ng_select_ctl(11, "STEP 11", "OFF|ON", 0) ? update();
    ng_select_ctl(12, "STEP 12", "OFF|ON", 0) ? update();
    ng_row(4);
    ng_select_ctl(13, "STEP 13", "OFF|ON", 0) ? update();
    ng_select_ctl(14, "STEP 14", "OFF|ON", 0) ? update();
    ng_select_ctl(15, "STEP 15", "OFF|ON", 0) ? update();
    ng_select_ctl(16, "STEP 16", "OFF|ON", 0) ? update();
  );

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
