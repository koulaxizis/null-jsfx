    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 1) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 1) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 1) && ng_pre_eq(slider9, 1) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 1) && ng_pre_eq(slider13, 1) && ng_pre_eq(slider14, 0) && ng_pre_eq(slider15, 0) && ng_pre_eq(slider16, 1) && ng_pre_eq(slider17, 0) && ng_pre_eq(slider18, 2) && ng_pre_eq(slider19, 8) && ng_pre_eq(slider20, 3) && ng_pre_eq(slider21, 60) && ng_pre_eq(slider22, 100) && ng_pre_eq(slider23, 100) && ng_pre_eq(slider24, 21) && ng_pre_eq(slider25, 1) && ng_pre_eq(slider26, 60) && ng_pre_eq(slider27, 1) && ng_pre_eq(slider28, 0) && ng_pre_eq(slider29, 0) && ng_pre_eq(slider30, 1) ? m = 15;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 1) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 1) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 1) && ng_pre_eq(slider9, 1) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 1) && ng_pre_eq(slider13, 1) && ng_pre_eq(slider14, 0) && ng_pre_eq(slider15, 0) && ng_pre_eq(slider16, 1) && ng_pre_eq(slider17, 0) && ng_pre_eq(slider18, 2) && ng_pre_eq(slider19, 8) && ng_pre_eq(slider20, 1) && ng_pre_eq(slider21, 15) && ng_pre_eq(slider22, 100) && ng_pre_eq(slider23, 100) && ng_pre_eq(slider24, 0) && ng_pre_eq(slider25, 1) && ng_pre_eq(slider26, 50) && ng_pre_eq(slider27, 2) && ng_pre_eq(slider28, 0) && ng_pre_eq(slider29, 0) && ng_pre_eq(slider30, 1) ? m = 16;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 1) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 1) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 1) && ng_pre_eq(slider9, 1) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 1) && ng_pre_eq(slider13, 1) && ng_pre_eq(slider14, 0) && ng_pre_eq(slider15, 0) && ng_pre_eq(slider16, 1) && ng_pre_eq(slider17, 0) && ng_pre_eq(slider18, 2) && ng_pre_eq(slider19, 8) && ng_pre_eq(slider20, 5) && ng_pre_eq(slider21, 120) && ng_pre_eq(slider22, 85) && ng_pre_eq(slider23, 100) && ng_pre_eq(slider24, 7) && ng_pre_eq(slider25, 1) && ng_pre_eq(slider26, 60) && ng_pre_eq(slider27, 3) && ng_pre_eq(slider28, 0) && ng_pre_eq(slider29, 0) && ng_pre_eq(slider30, 1) ? m = 17;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 1) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 1) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 1) && ng_pre_eq(slider9, 1) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 1) && ng_pre_eq(slider13, 1) && ng_pre_eq(slider14, 0) && ng_pre_eq(slider15, 0) && ng_pre_eq(slider16, 1) && ng_pre_eq(slider17, 0) && ng_pre_eq(slider18, 2) && ng_pre_eq(slider19, 8) && ng_pre_eq(slider20, 5) && ng_pre_eq(slider21, 40) && ng_pre_eq(slider22, 100) && ng_pre_eq(slider23, 100) && ng_pre_eq(slider24, 11) && ng_pre_eq(slider25, 1) && ng_pre_eq(slider26, 55) && ng_pre_eq(slider27, 0) && ng_pre_eq(slider28, 1) && ng_pre_eq(slider29, 0) && ng_pre_eq(slider30, 1) ? m = 18;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 1) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 1) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 1) && ng_pre_eq(slider9, 1) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 1) && ng_pre_eq(slider13, 1) && ng_pre_eq(slider14, 0) && ng_pre_eq(slider15, 0) && ng_pre_eq(slider16, 1) && ng_pre_eq(slider17, 0) && ng_pre_eq(slider18, 2) && ng_pre_eq(slider19, 8) && ng_pre_eq(slider20, 2) && ng_pre_eq(slider21, 30) && ng_pre_eq(slider22, 100) && ng_pre_eq(slider23, 100) && ng_pre_eq(slider24, 31) && ng_pre_eq(slider25, 1) && ng_pre_eq(slider26, 50) && ng_pre_eq(slider27, 1) && ng_pre_eq(slider28, 0) && ng_pre_eq(slider29, 35) && ng_pre_eq(slider30, 0) ? m = 19;
