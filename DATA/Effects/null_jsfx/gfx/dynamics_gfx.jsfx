desc:NULL Dynamics GFX
author: Christos Koulaxizis
tags: dynamics compressor expander gain reduction ratio threshold knee sidechain parallel bus fet opto gui
//category: Essentials
//NULL JSFX v2.4 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:0<0,1,1{Compressor,Expander}>-Mode
slider2:-20<-60,0,1>-Threshold (dB)
slider3:4<1,20,0.1>-Ratio
slider4:6<0,20,1>-Knee (dB)
slider5:10<0,200,1>-Attack (ms)
slider6:100<0,1000,1>-Release (ms)
slider7:0<0,20,1>-Makeup (dB)
slider8:0<0,3,1{Clean,Bus,FET,Opto}>-Style
slider9:20<20,500,1:log>-Sidechain HPF (Hz)
slider10:100<0,100,1>-Mix (%)
slider11:0<0,1,1{Internal,External}>-Sidechain

in_pin:Left
in_pin:Right
in_pin:Sidechain Left
in_pin:Sidechain Right
out_pin:Left
out_pin:Right

@init
  // NULL Dynamics (../dynamics.jsfx) with its own interface: same audio code, plus @gfx.
  // Style: Clean = peak detector, gain smoothed with Attack / Release (the original plugin).
  // Bus = crest-corrected RMS detector that partly listens to its own gain reduction (half
  // feedback, slope compensated so the static curve stays where the display draws it), a little
  // extra knee and an auto release: a slow second envelope holds the reduction after sustained
  // compression. FET = peak detector, attack 4x faster, half the knee, and odd-harmonic colour
  // that grows with the gain reduction. Opto = RMS detector, wide knee, program-dependent attack
  // (bigger jumps react faster) and a two-stage release whose slow half gets slower the more
  // reduction there has been. Sidechain HPF filters the detector only (off at 20 Hz); Mix blends
  // the dry signal back in (parallel compression); External listens to pins 3/4.
  gain_env = 1;
  ln10 = 2.302585;
  db_to_lin = ln10 / 20;
  gr_db = gr_f = gr_s = gr_o1 = gr_o2 = gr_mem = 0;
  det_ms = 0;
  hp_l1 = hp_l2 = hp_r1 = hp_r2 = 0;
  gfx_ext_retina = 1;
  // interface only: detector and output peak meters, 300 ms release
  dy_rel = exp(-1 / (0.3 * srate));
  dy_in = dy_out = 0;

  function update()
  (
    mode = slider1;
    threshold_db = slider2;
    ratio = slider3;
    knee_db = slider4;
    attack_ms = slider5;
    release_ms = slider6;
    makeup_db = slider7;
    style = slider8;
    hpf_on = slider9 > 20;
    mix_on = slider10 < 100;
    mix_amt = slider10 / 100;
    sc_ext = slider11 > 0.5;
  
    attack_ms > 0 ? (
      attack_tc = 1 - exp(-1 / (attack_ms * srate / 1000));
    ) : (
      attack_tc = 1;
    );
  
    release_ms > 0 ? (
      release_tc = 1 - exp(-1 / (release_ms * srate / 1000));
    ) : (
      release_tc = 1;
    );

    // gain computer: slope (1 - 1/ratio) and knee, per style
    slope = 1 - 1/ratio;
    kn = knee_db;
    style == 1 ? (
      kn = knee_db + 4;
      mode == 0 ? slope = slope / (1 - 0.5 * slope); // half feedback: steady state = the curve
    );
    style == 2 ? kn = knee_db * 0.5;
    style == 3 ? kn = max(knee_db, 10);
    fet_att = min(1, attack_tc * 4);
    opto_att = attack_tc * 0.5;
    rms_tc = 1 - exp(-1 / ((style == 3 ? 10 : 5) * srate / 1000));
    bus_satt = 1 - exp(-1 / (250 * srate / 1000));
    bus_srel = 1 - exp(-1 / ((200 + 4 * release_ms) * srate / 1000));
    opto_srel = release_tc * 0.1;
    mem_tc = 1 - exp(-1 / srate);

    // detector high-pass: 12 dB/oct (RBJ biquad, Q = 0.7071)
    hpf_on ? (
      hp_w = 2 * $pi * slider9 / srate;
      hp_cs = cos(hp_w);
      hp_al = sin(hp_w) / (2 * sqrt(0.5));
      hp_a0 = 1 + hp_al;
      hp_b0 = (1 + hp_cs) / 2 / hp_a0;
      hp_b1 = -(1 + hp_cs) / hp_a0;
      hp_a1 = -2 * hp_cs / hp_a0;
      hp_a2 = (1 - hp_al) / hp_a0;
    );
  );

  // static curve in dB: output level for input level d (the gain computer plus makeup, with
  // the style's knee; Bus: the steady state of its feedback, the plain 1 - 1/ratio slope)
  function dy_curve(d) local(x, r)
  (
    r = 0;
    mode == 0 ? (
      x = d - threshold_db;
    ) : (
      x = threshold_db - d;
    );
    x > 0 ? (
      kn > 0 && x < kn ? r = (1 - 1/ratio) * x * x / (2 * kn) : r = (1 - 1/ratio) * (x - kn / 2);
    );
    d - r + makeup_db;
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 14;

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 0); ng_slider_set(2, -20); ng_slider_set(3, 4); ng_slider_set(4, 6); ng_slider_set(5, 10); ng_slider_set(6, 100); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 20); ng_slider_set(10, 100); ng_slider_set(11, 0); );
    p == 1 ? ( ng_slider_set(1, 0); ng_slider_set(2, -20); ng_slider_set(3, 3); ng_slider_set(4, 6); ng_slider_set(5, 5); ng_slider_set(6, 120); ng_slider_set(7, 4); ng_slider_set(8, 0); ng_slider_set(9, 20); ng_slider_set(10, 100); ng_slider_set(11, 0); );
    p == 2 ? ( ng_slider_set(1, 0); ng_slider_set(2, -12); ng_slider_set(3, 2); ng_slider_set(4, 10); ng_slider_set(5, 30); ng_slider_set(6, 200); ng_slider_set(7, 2); ng_slider_set(8, 0); ng_slider_set(9, 20); ng_slider_set(10, 100); ng_slider_set(11, 0); );
    p == 3 ? ( ng_slider_set(1, 0); ng_slider_set(2, -18); ng_slider_set(3, 4); ng_slider_set(4, 6); ng_slider_set(5, 10); ng_slider_set(6, 150); ng_slider_set(7, 4); ng_slider_set(8, 0); ng_slider_set(9, 20); ng_slider_set(10, 100); ng_slider_set(11, 0); );
    p == 4 ? ( ng_slider_set(1, 0); ng_slider_set(2, -18); ng_slider_set(3, 4); ng_slider_set(4, 3); ng_slider_set(5, 15); ng_slider_set(6, 80); ng_slider_set(7, 3); ng_slider_set(8, 0); ng_slider_set(9, 20); ng_slider_set(10, 100); ng_slider_set(11, 0); );
    p == 5 ? ( ng_slider_set(1, 0); ng_slider_set(2, -24); ng_slider_set(3, 8); ng_slider_set(4, 3); ng_slider_set(5, 1); ng_slider_set(6, 60); ng_slider_set(7, 6); ng_slider_set(8, 0); ng_slider_set(9, 20); ng_slider_set(10, 100); ng_slider_set(11, 0); );
    p == 6 ? ( ng_slider_set(1, 0); ng_slider_set(2, -6); ng_slider_set(3, 20); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 50); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 20); ng_slider_set(10, 100); ng_slider_set(11, 0); );
    p == 7 ? ( ng_slider_set(1, 1); ng_slider_set(2, -45); ng_slider_set(3, 2); ng_slider_set(4, 6); ng_slider_set(5, 1); ng_slider_set(6, 150); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 20); ng_slider_set(10, 100); ng_slider_set(11, 0); );
    p == 8 ? ( ng_slider_set(1, 1); ng_slider_set(2, -30); ng_slider_set(3, 4); ng_slider_set(4, 3); ng_slider_set(5, 1); ng_slider_set(6, 100); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 20); ng_slider_set(10, 100); ng_slider_set(11, 0); );
    p == 9 ? ( ng_slider_set(1, 0); ng_slider_set(2, -18); ng_slider_set(3, 2); ng_slider_set(4, 6); ng_slider_set(5, 30); ng_slider_set(6, 200); ng_slider_set(7, 2); ng_slider_set(8, 1); ng_slider_set(9, 100); ng_slider_set(10, 100); ng_slider_set(11, 0); );
    p == 10 ? ( ng_slider_set(1, 0); ng_slider_set(2, -24); ng_slider_set(3, 4); ng_slider_set(4, 2); ng_slider_set(5, 4); ng_slider_set(6, 80); ng_slider_set(7, 6); ng_slider_set(8, 2); ng_slider_set(9, 80); ng_slider_set(10, 100); ng_slider_set(11, 0); );
    p == 11 ? ( ng_slider_set(1, 0); ng_slider_set(2, -22); ng_slider_set(3, 4); ng_slider_set(4, 10); ng_slider_set(5, 15); ng_slider_set(6, 300); ng_slider_set(7, 5); ng_slider_set(8, 3); ng_slider_set(9, 20); ng_slider_set(10, 100); ng_slider_set(11, 0); );
    p == 12 ? ( ng_slider_set(1, 0); ng_slider_set(2, -36); ng_slider_set(3, 20); ng_slider_set(4, 0); ng_slider_set(5, 1); ng_slider_set(6, 60); ng_slider_set(7, 12); ng_slider_set(8, 2); ng_slider_set(9, 20); ng_slider_set(10, 40); ng_slider_set(11, 0); );
    p == 13 ? ( ng_slider_set(1, 0); ng_slider_set(2, -30); ng_slider_set(3, 8); ng_slider_set(4, 3); ng_slider_set(5, 1); ng_slider_set(6, 120); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 20); ng_slider_set(10, 100); ng_slider_set(11, 1); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, -20) && ng_pre_eq(slider3, 4) && ng_pre_eq(slider4, 6) && ng_pre_eq(slider5, 10) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 20) && ng_pre_eq(slider10, 100) && ng_pre_eq(slider11, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, -20) && ng_pre_eq(slider3, 3) && ng_pre_eq(slider4, 6) && ng_pre_eq(slider5, 5) && ng_pre_eq(slider6, 120) && ng_pre_eq(slider7, 4) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 20) && ng_pre_eq(slider10, 100) && ng_pre_eq(slider11, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, -12) && ng_pre_eq(slider3, 2) && ng_pre_eq(slider4, 10) && ng_pre_eq(slider5, 30) && ng_pre_eq(slider6, 200) && ng_pre_eq(slider7, 2) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 20) && ng_pre_eq(slider10, 100) && ng_pre_eq(slider11, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, -18) && ng_pre_eq(slider3, 4) && ng_pre_eq(slider4, 6) && ng_pre_eq(slider5, 10) && ng_pre_eq(slider6, 150) && ng_pre_eq(slider7, 4) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 20) && ng_pre_eq(slider10, 100) && ng_pre_eq(slider11, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, -18) && ng_pre_eq(slider3, 4) && ng_pre_eq(slider4, 3) && ng_pre_eq(slider5, 15) && ng_pre_eq(slider6, 80) && ng_pre_eq(slider7, 3) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 20) && ng_pre_eq(slider10, 100) && ng_pre_eq(slider11, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, -24) && ng_pre_eq(slider3, 8) && ng_pre_eq(slider4, 3) && ng_pre_eq(slider5, 1) && ng_pre_eq(slider6, 60) && ng_pre_eq(slider7, 6) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 20) && ng_pre_eq(slider10, 100) && ng_pre_eq(slider11, 0) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, -6) && ng_pre_eq(slider3, 20) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 50) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 20) && ng_pre_eq(slider10, 100) && ng_pre_eq(slider11, 0) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, -45) && ng_pre_eq(slider3, 2) && ng_pre_eq(slider4, 6) && ng_pre_eq(slider5, 1) && ng_pre_eq(slider6, 150) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 20) && ng_pre_eq(slider10, 100) && ng_pre_eq(slider11, 0) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, -30) && ng_pre_eq(slider3, 4) && ng_pre_eq(slider4, 3) && ng_pre_eq(slider5, 1) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 20) && ng_pre_eq(slider10, 100) && ng_pre_eq(slider11, 0) ? m = 8;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, -18) && ng_pre_eq(slider3, 2) && ng_pre_eq(slider4, 6) && ng_pre_eq(slider5, 30) && ng_pre_eq(slider6, 200) && ng_pre_eq(slider7, 2) && ng_pre_eq(slider8, 1) && ng_pre_eq(slider9, 100) && ng_pre_eq(slider10, 100) && ng_pre_eq(slider11, 0) ? m = 9;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, -24) && ng_pre_eq(slider3, 4) && ng_pre_eq(slider4, 2) && ng_pre_eq(slider5, 4) && ng_pre_eq(slider6, 80) && ng_pre_eq(slider7, 6) && ng_pre_eq(slider8, 2) && ng_pre_eq(slider9, 80) && ng_pre_eq(slider10, 100) && ng_pre_eq(slider11, 0) ? m = 10;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, -22) && ng_pre_eq(slider3, 4) && ng_pre_eq(slider4, 10) && ng_pre_eq(slider5, 15) && ng_pre_eq(slider6, 300) && ng_pre_eq(slider7, 5) && ng_pre_eq(slider8, 3) && ng_pre_eq(slider9, 20) && ng_pre_eq(slider10, 100) && ng_pre_eq(slider11, 0) ? m = 11;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, -36) && ng_pre_eq(slider3, 20) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 1) && ng_pre_eq(slider6, 60) && ng_pre_eq(slider7, 12) && ng_pre_eq(slider8, 2) && ng_pre_eq(slider9, 20) && ng_pre_eq(slider10, 40) && ng_pre_eq(slider11, 0) ? m = 12;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, -30) && ng_pre_eq(slider3, 8) && ng_pre_eq(slider4, 3) && ng_pre_eq(slider5, 1) && ng_pre_eq(slider6, 120) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 20) && ng_pre_eq(slider10, 100) && ng_pre_eq(slider11, 1) ? m = 13;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Vocal Leveler";
    p == 2 ? s = "Gentle Bus Glue";
    p == 3 ? s = "Bass Control";
    p == 4 ? s = "Snare Punch";
    p == 5 ? s = "Drum Smash";
    p == 6 ? s = "Peak Catcher";
    p == 7 ? s = "Noise Expander";
    p == 8 ? s = "Drum Bleed Expander";
    p == 9 ? s = "Bus Glue";
    p == 10 ? s = "FET Vocal";
    p == 11 ? s = "Opto Bass";
    p == 12 ? s = "Parallel Smash";
    p == 13 ? s = "Kick Ducking";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  // detector input: the track, or pins 3/4 (External)
  sc_ext ? (
    det_l = spl2;
    det_r = spl3;
  ) : (
    det_l = spl0;
    det_r = spl1;
  );
  hpf_on ? (
    hp_y = hp_b0 * det_l + hp_l1;
    hp_l1 = hp_b1 * det_l - hp_a1 * hp_y + hp_l2;
    hp_l2 = hp_b0 * det_l - hp_a2 * hp_y;
    det_l = hp_y;
    hp_y = hp_b0 * det_r + hp_r1;
    hp_r1 = hp_b1 * det_r - hp_a1 * hp_y + hp_r2;
    hp_r2 = hp_b0 * det_r - hp_a2 * hp_y;
    det_r = hp_y;
  );
  input_abs = max(abs(det_l), abs(det_r));
  input_abs < 0.000001 ? input_abs = 0.000001;
  (style == 1 || style == 3) ? (
    // crest-corrected RMS (a sine reads its peak)
    det_ms += (input_abs * input_abs - det_ms) * rms_tc;
    det_lv = sqrt(2 * det_ms);
    det_lv < 0.000001 ? det_lv = 0.000001;
    input_db = log(det_lv) / ln10 * 20;
    style == 1 && mode == 0 ? input_db -= 0.5 * gr_db;
  ) : (
    input_db = log(input_abs) / ln10 * 20;
  );
  
  gr_target = 0;
  
  mode == 0 ? (
    // COMPRESSOR: above threshold
    excess = input_db - threshold_db;
    excess > 0 ? (
      kn > 0 && excess < kn ? (
        // quadratic soft knee: the slope rises smoothly from 1 to 1/ratio
        gr_target = slope * excess * excess / (2 * kn);
      ) : (
        gr_target = slope * (excess - kn / 2);
      );
    );
  ) : (
    // EXPANDER: below threshold
    deficit = threshold_db - input_db;
    deficit > 0 ? (
      kn > 0 && deficit < kn ? (
        gr_target = slope * deficit * deficit / (2 * kn);
      ) : (
        gr_target = slope * (deficit - kn / 2);
      );
    );
  );
  
  style == 0 ? (
    gain_target = exp(-gr_target * db_to_lin);
    
    gain_target < gain_env ? (
      gain_env = gain_env + (gain_target - gain_env) * attack_tc;
    ) : (
      gain_env = gain_env + (gain_target - gain_env) * release_tc;
    );
  ) : (
    // the other styles smooth the gain reduction in dB
    style == 1 ? (
      gr_f += (gr_target - gr_f) * (gr_target > gr_f ? attack_tc : release_tc);
      gr_s += (gr_f - gr_s) * (gr_f > gr_s ? bus_satt : bus_srel);
      gr_db = max(gr_f, gr_s);
    ) : style == 2 ? (
      gr_db += (gr_target - gr_db) * (gr_target > gr_db ? fet_att : release_tc);
    ) : (
      gr_target > gr_o1 ? (
        gr_o1 += (gr_target - gr_o1) * min(1, opto_att * (1 + (gr_target - gr_o1) / 6));
      ) : (
        gr_o1 += (gr_target - gr_o1) * release_tc;
      );
      gr_target > gr_o2 ? (
        gr_o2 += (gr_target - gr_o2) * min(1, opto_att * (1 + (gr_target - gr_o2) / 6));
      ) : (
        gr_o2 += (gr_target - gr_o2) * opto_srel / (1 + gr_mem / 6);
      );
      gr_db = 0.5 * (gr_o1 + gr_o2);
      gr_mem += (gr_db - gr_mem) * mem_tc;
    );
    gain_env = exp(-gr_db * db_to_lin);
  );
  
  makeup_linear = exp(makeup_db * db_to_lin);
  mix_on ? (
    dry_l = spl0;
    dry_r = spl1;
  );
  style == 2 ? (
    // FET colour: a cubic curve (6 dB of headroom, linear above) on the compressed signal,
    // odd harmonics only, from 3 dB of reduction, full at 18 dB
    fet_amt = 0.5 * min(1, max(0, gr_db - 3) / 15);
    fet_x = spl0 * gain_env * 2;
    abs(fet_x) < 1 ? (
      fet_x -= fet_amt * fet_x * fet_x * fet_x / 3;
    ) : (
      fet_x = sign(fet_x) * (1 - fet_amt / 3) + (fet_x - sign(fet_x)) * (1 - fet_amt);
    );
    spl0 = fet_x * 0.5 * makeup_linear;
    fet_x = spl1 * gain_env * 2;
    abs(fet_x) < 1 ? (
      fet_x -= fet_amt * fet_x * fet_x * fet_x / 3;
    ) : (
      fet_x = sign(fet_x) * (1 - fet_amt / 3) + (fet_x - sign(fet_x)) * (1 - fet_amt);
    );
    spl1 = fet_x * 0.5 * makeup_linear;
  ) : (
    spl0 = spl0 * gain_env * makeup_linear;
    spl1 = spl1 * gain_env * makeup_linear;
  );
  mix_on ? (
    // parallel compression: the dry signal under the compressed one
    spl0 = dry_l + (spl0 - dry_l) * mix_amt;
    spl1 = dry_r + (spl1 - dry_r) * mix_amt;
  );

  // interface only: meters (read the audio state, never change it)
  dy_lv = max(abs(spl0), abs(spl1));
  dy_out = dy_lv > dy_out ? dy_lv : dy_out * dy_rel;
  dy_in = input_abs > dy_in ? input_abs : dy_in * dy_rel;

@gfx 480 380
  ng_knobs_begin("DYNAMICS", "ESSENTIALS", 480, 120, 2, 0);

  // display, left: the static curve (input -60..0 dB across, output -60..0 dB up) with the
  // input level as a dot; right: input, gain-reduction and output meters
  ng_plot(64, 66, 92, 92);
  ng_grid(4, 4, 0);
  ng_font(4, 8, 0);
  ng_col(NG_MUTED, 1);
  dy_i = 0;
  loop(3, sprintf(#dy_l, "%d", -30 * dy_i); ng_ptxt(#dy_l, ng_px - 6 * ng_s, ng_py + ng_ph * dy_i / 2, 2); dy_i += 1;);
  ng_col(NG_ACCENT, 0.25);
  gfx_line(ng_px, ng_py + ng_ph, ng_px + ng_pw, ng_py, 1);
  ng_col(NG_ACCENT, 1);
  dy_i = 0;
  loop(93,
    dy_yy = ng_lin_y(dy_curve(-60 + 60 * dy_i / 92), -60, 0);
    dy_xx = ng_px + ng_pw * dy_i / 92;
    dy_i == 0 ? ng_line_start(dy_xx, dy_yy) : ng_line_to(dy_xx, dy_yy);
    dy_i += 1;
  );
  dy_db = ng_to_db(dy_in);
  dy_db > -60 ? (
    ng_col(NG_TEXT, 1);
    gfx_circle(ng_lin_x(min(0, dy_db), -60, 0), ng_lin_y(dy_curve(min(0, dy_db)), -60, 0), 2.5 * ng_s, 1, 1);
  );
  // status line: the style, plus what is switched on (detector high-pass, mix, external key)
  ng_font(1, 7, 1);
  ng_col(NG_ACCENT, 1);
  ng_txt(slider8 == 1 ? "BUS" : slider8 == 2 ? "FET" : slider8 == 3 ? "OPTO" : "CLEAN", 180, 66, 0, 1);
  strcpy(#dy_a, "");
  slider9 > 20 ? sprintf(#dy_a, "   HPF %d HZ", slider9);
  strcpy(#dy_b, "");
  slider10 < 100 ? sprintf(#dy_b, "   MIX %d%%", slider10);
  sprintf(#dy_st, "%s%s%s", #dy_a, #dy_b, slider11 > 0.5 ? "   EXT KEY" : "");
  ng_col(NG_MUTED, 1);
  ng_txt(#dy_st, 448, 66, 2, 1);
  ng_meter(180, 82, 268, 10, slider11 > 0.5 ? "KEY" : "IN", dy_db, slider2, -60);
  ng_gr_meter(180, 106, 268, 10, "GR", -20 * log10(max(gain_env, 0.0000001)), 24);
  ng_meter(180, 130, 268, 10, "OUT", ng_to_db(dy_out), -140, -60);

  ng_row(6);
  ng_select_ctl(1, "MODE", "COMP|EXPAND", 0) ? update();
  sprintf(#v2, "%d dB", slider2);
  ng_knob_ctl(2, "THRESHOLD", #v2, -60, 0, -20, 1, 0) ? update();
  sprintf(#v3, "%.1f:1", slider3);
  ng_knob_ctl(3, "RATIO", #v3, 1, 20, 4, 0.1, 0) ? update();
  sprintf(#v4, "%d dB", slider4);
  ng_knob_ctl(4, "KNEE", #v4, 0, 20, 6, 1, 0) ? update();
  sprintf(#v5, "%d ms", slider5);
  ng_knob_ctl(5, "ATTACK", #v5, 0, 200, 10, 1, 0) ? update();
  sprintf(#v6, "%d ms", slider6);
  ng_knob_ctl(6, "RELEASE", #v6, 0, 1000, 100, 1, 0) ? update();
  ng_row(5);
  ng_select_ctl(8, "STYLE", "CLEAN|BUS|FET|OPTO", 0) ? update();
  sprintf(#v7, "+%d dB", slider7);
  ng_knob_ctl(7, "MAKEUP", #v7, 0, 20, 0, 1, 0) ? update();
  sprintf(#v10, "%d%%", slider10);
  ng_knob_ctl(10, "MIX", #v10, 0, 100, 100, 1, 0) ? update();
  slider9 > 20 ? sprintf(#v9, "%d Hz", slider9) : strcpy(#v9, "OFF");
  ng_knob_ctl_log(9, "SC HPF", #v9, 20, 500, 20, 1) ? update();
  ng_select_ctl(11, "SIDECHAIN", "INT|EXT", 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
