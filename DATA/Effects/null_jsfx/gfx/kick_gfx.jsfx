desc:NULL Kick GFX
author: Christos Koulaxizis
tags: instrument kick drum bass drum 808 909 sub click punch pitch sweep synth midi gui
//category: Instruments
//NULL JSFX v3.0 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:50<30,120,0.1>-Pitch (Hz)
slider2:0<0,1,1{Off,On}>-Follow Notes
slider3:24<0,48,0.1>-Sweep (st)
slider4:40<2,300,0.1:log>-Sweep Time (ms)
slider5:450<20,3000,1:log>-Decay (ms)
slider6:30<0,100,1>-Click (%)
slider7:3000<500,12000,1:log>-Click Tone (Hz)
slider8:0<0,100,1>-Drive (%)
slider9:50<0,100,1>-Velocity (%)
slider10:0<-24,12,0.1>-Volume (dB)

in_pin:none
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails, as in the VST3/CLAP
  // NULL Kick (../kick.jsfx) with its own interface: same audio code, plus @gfx.
  // A kick drum synthesizer (no samples), played from MIDI: any note-on starts a kick.
  //   - the body is a sine whose pitch starts Sweep semitones above Pitch and falls back to it
  //     exponentially (time constant Sweep Time); its level falls by 60 dB over Decay
  //   - Click is a burst of white noise (Park-Miller) through a one-pole low-pass at Click
  //     Tone, falling by 60 dB in 20 ms: the beater
  //   - Follow Notes On tunes the kick to the note (C1, MIDI 36, plays Pitch); Off plays
  //     Pitch on every key
  //   - Velocity sets how much the key velocity changes the level (0 % = always full)
  //   - Drive is a soft clip tanh(g x) / tanh(g), g = 1 + 9 x Drive, so a full-level kick
  //     still peaks at 1
  // A new kick while one rings fades the old one out over 3 ms (two voices), so retriggers
  // do not click. The noise generator steps every sample, played or not.
  // Memory: 4000.. the MIDI of the block, 100.. the two voices (16 values each).
  ext_tail_size = -1;
  MQ = 4000;
  VB = 100;                    // voice k at VB + k * 16: on, phase, pitch env, amp env,
                               // click env, click filter, velocity gain, f0, fade, fade rate
  memset(VB, 0, 32);
  k_last = 1;                  // the voice that started last
  seed = 12345;

  // tanh (EEL2 has none): (e^2x - 1) / (e^2x + 1), clamped
  function k_tanh(x) local(e)
  (
    x > 20 ? 1 : x < -20 ? -1 : (e = exp(2 * x); (e - 1) / (e + 1));
  );

  // a MIDI message at this sample: a note-on starts a kick in the other voice
  function midi_ev(m1, m2, m3) local(st, v, o)
  (
    st = m1 & 0xF0;
    st == 0x90 && m3 > 0 ? (
      o = VB + k_last * 16;
      o[0] ? o[9] = 1 / (0.003 * srate);
      k_last = 1 - k_last;
      v = VB + k_last * 16;
      v[0] = 1;
      v[1] = 0;
      v[2] = 1;
      v[3] = 1;
      v[4] = 1;
      v[5] = 0;
      v[6] = 1 - vs + vs * m3 / 127;
      v[7] = follow ? pitch * 2 ^ ((m2 - 36) / 12) : pitch;
      v[8] = 1;
      v[9] = 0;
    );
  );

  gfx_ext_retina = 1;
  kk_pk = 0;                   // output peak (display only)

  function update()
  (
    pitch = slider1;
    follow = slider2 >= 0.5;
    sw = slider3 / 12;
    pek = exp(-1 / (slider4 / 1000 * srate));
    aek = exp(-6.907755278982137 / (slider5 / 1000 * srate));
    cek = exp(-6.907755278982137 / (0.02 * srate));
    click = slider6 / 100 * 2;
    ck = 1 - exp(-2 * $pi * slider7 / srate);
    dr = slider8 / 100;
    dg = 1 + 9 * dr;
    dn = k_tanh(dg);
    vs = slider9 / 100;
    og = 10 ^ (slider10 / 20);
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 11;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1); ng_hist_add(2); ng_hist_add(3); ng_hist_add(4); ng_hist_add(5); ng_hist_add(6); ng_hist_add(7); ng_hist_add(8); ng_hist_add(9); ng_hist_add(10);
  ng_hist_init();

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 50); ng_slider_set(2, 0); ng_slider_set(3, 24); ng_slider_set(4, 40); ng_slider_set(5, 450); ng_slider_set(6, 30); ng_slider_set(7, 3000); ng_slider_set(8, 0); ng_slider_set(9, 50); ng_slider_set(10, 0); );
    p == 1 ? ( ng_slider_set(1, 45); ng_slider_set(2, 1); ng_slider_set(3, 12); ng_slider_set(4, 60); ng_slider_set(5, 1500); ng_slider_set(6, 5); ng_slider_set(7, 3000); ng_slider_set(8, 0); ng_slider_set(9, 50); ng_slider_set(10, 0); );
    p == 2 ? ( ng_slider_set(1, 55); ng_slider_set(2, 0); ng_slider_set(3, 30); ng_slider_set(4, 25); ng_slider_set(5, 350); ng_slider_set(6, 45); ng_slider_set(7, 4000); ng_slider_set(8, 20); ng_slider_set(9, 50); ng_slider_set(10, 0); );
    p == 3 ? ( ng_slider_set(1, 62); ng_slider_set(2, 0); ng_slider_set(3, 20); ng_slider_set(4, 18); ng_slider_set(5, 220); ng_slider_set(6, 55); ng_slider_set(7, 2500); ng_slider_set(8, 0); ng_slider_set(9, 50); ng_slider_set(10, 0); );
    p == 4 ? ( ng_slider_set(1, 50); ng_slider_set(2, 0); ng_slider_set(3, 28); ng_slider_set(4, 35); ng_slider_set(5, 500); ng_slider_set(6, 25); ng_slider_set(7, 3000); ng_slider_set(8, 35); ng_slider_set(9, 50); ng_slider_set(10, 0); );
    p == 5 ? ( ng_slider_set(1, 52); ng_slider_set(2, 0); ng_slider_set(3, 36); ng_slider_set(4, 30); ng_slider_set(5, 600); ng_slider_set(6, 40); ng_slider_set(7, 3000); ng_slider_set(8, 80); ng_slider_set(9, 50); ng_slider_set(10, 0); );
    p == 6 ? ( ng_slider_set(1, 40); ng_slider_set(2, 0); ng_slider_set(3, 6); ng_slider_set(4, 80); ng_slider_set(5, 900); ng_slider_set(6, 0); ng_slider_set(7, 3000); ng_slider_set(8, 0); ng_slider_set(9, 50); ng_slider_set(10, 0); );
    p == 7 ? ( ng_slider_set(1, 70); ng_slider_set(2, 0); ng_slider_set(3, 10); ng_slider_set(4, 15); ng_slider_set(5, 180); ng_slider_set(6, 20); ng_slider_set(7, 900); ng_slider_set(8, 0); ng_slider_set(9, 50); ng_slider_set(10, 0); );
    p == 8 ? ( ng_slider_set(1, 48); ng_slider_set(2, 0); ng_slider_set(3, 48); ng_slider_set(4, 12); ng_slider_set(5, 400); ng_slider_set(6, 10); ng_slider_set(7, 3000); ng_slider_set(8, 0); ng_slider_set(9, 50); ng_slider_set(10, 0); );
    p == 9 ? ( ng_slider_set(1, 41.2); ng_slider_set(2, 1); ng_slider_set(3, 18); ng_slider_set(4, 45); ng_slider_set(5, 2000); ng_slider_set(6, 15); ng_slider_set(7, 3000); ng_slider_set(8, 0); ng_slider_set(9, 50); ng_slider_set(10, 0); );
    p == 10 ? ( ng_slider_set(1, 50); ng_slider_set(2, 0); ng_slider_set(3, 24); ng_slider_set(4, 40); ng_slider_set(5, 450); ng_slider_set(6, 30); ng_slider_set(7, 3000); ng_slider_set(8, 0); ng_slider_set(9, 0); ng_slider_set(10, 0); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 50) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 24) && ng_pre_eq(slider4, 40) && ng_pre_eq(slider5, 450) && ng_pre_eq(slider6, 30) && ng_pre_eq(slider7, 3000) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 50) && ng_pre_eq(slider10, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 45) && ng_pre_eq(slider2, 1) && ng_pre_eq(slider3, 12) && ng_pre_eq(slider4, 60) && ng_pre_eq(slider5, 1500) && ng_pre_eq(slider6, 5) && ng_pre_eq(slider7, 3000) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 50) && ng_pre_eq(slider10, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 55) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 30) && ng_pre_eq(slider4, 25) && ng_pre_eq(slider5, 350) && ng_pre_eq(slider6, 45) && ng_pre_eq(slider7, 4000) && ng_pre_eq(slider8, 20) && ng_pre_eq(slider9, 50) && ng_pre_eq(slider10, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 62) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 20) && ng_pre_eq(slider4, 18) && ng_pre_eq(slider5, 220) && ng_pre_eq(slider6, 55) && ng_pre_eq(slider7, 2500) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 50) && ng_pre_eq(slider10, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 50) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 28) && ng_pre_eq(slider4, 35) && ng_pre_eq(slider5, 500) && ng_pre_eq(slider6, 25) && ng_pre_eq(slider7, 3000) && ng_pre_eq(slider8, 35) && ng_pre_eq(slider9, 50) && ng_pre_eq(slider10, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 52) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 36) && ng_pre_eq(slider4, 30) && ng_pre_eq(slider5, 600) && ng_pre_eq(slider6, 40) && ng_pre_eq(slider7, 3000) && ng_pre_eq(slider8, 80) && ng_pre_eq(slider9, 50) && ng_pre_eq(slider10, 0) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 40) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 6) && ng_pre_eq(slider4, 80) && ng_pre_eq(slider5, 900) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 3000) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 50) && ng_pre_eq(slider10, 0) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 70) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 10) && ng_pre_eq(slider4, 15) && ng_pre_eq(slider5, 180) && ng_pre_eq(slider6, 20) && ng_pre_eq(slider7, 900) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 50) && ng_pre_eq(slider10, 0) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 48) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 48) && ng_pre_eq(slider4, 12) && ng_pre_eq(slider5, 400) && ng_pre_eq(slider6, 10) && ng_pre_eq(slider7, 3000) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 50) && ng_pre_eq(slider10, 0) ? m = 8;
    m < 0 && ng_pre_eq(slider1, 41.2) && ng_pre_eq(slider2, 1) && ng_pre_eq(slider3, 18) && ng_pre_eq(slider4, 45) && ng_pre_eq(slider5, 2000) && ng_pre_eq(slider6, 15) && ng_pre_eq(slider7, 3000) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 50) && ng_pre_eq(slider10, 0) ? m = 9;
    m < 0 && ng_pre_eq(slider1, 50) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 24) && ng_pre_eq(slider4, 40) && ng_pre_eq(slider5, 450) && ng_pre_eq(slider6, 30) && ng_pre_eq(slider7, 3000) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) ? m = 10;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Deep 808";
    p == 2 ? s = "Punchy 909";
    p == 3 ? s = "Tight Rock";
    p == 4 ? s = "Techno Thump";
    p == 5 ? s = "Hard Distorted";
    p == 6 ? s = "Soft Sub";
    p == 7 ? s = "Lo-Fi Thud";
    p == 8 ? s = "Zap";
    p == 9 ? s = "Tuned Bass Kick";
    p == 10 ? s = "Even Velocity";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@block
  // the MIDI of this block, played at its offsets in @sample
  mq_n = 0;
  while (midirecv(m_ofs, m_1, m_2, m_3)) (
    // every message goes on to the next plugin too, so instruments can be layered
    midisend(m_ofs, m_1, m_2, m_3);
    mq_n < 512 ? (
      MQ[mq_n * 4] = m_ofs;
      MQ[mq_n * 4 + 1] = m_1;
      MQ[mq_n * 4 + 2] = m_2;
      MQ[mq_n * 4 + 3] = m_3;
      mq_n += 1;
    );
  );
  mq_i = 0;
  si = 0;

@sample
  while (mq_i < mq_n && MQ[mq_i * 4] <= si) (
    midi_ev(MQ[mq_i * 4 + 1], MQ[mq_i * 4 + 2], MQ[mq_i * 4 + 3]);
    mq_i += 1;
  );
  si += 1;

  seed *= 16807; seed -= floor(seed / 2147483647) * 2147483647;
  w = seed / 1073741824 - 1;
  x = 0;
  k = 0;
  loop(2,
    v = VB + k * 16;
    v[0] ? (
      f = v[7] * 2 ^ (sw * v[2]);
      y = sin(2 * $pi * v[1]) * v[3];
      v[1] += f / srate;
      v[1] -= floor(v[1]);
      v[5] += (w - v[5]) * ck;
      y += v[5] * v[4] * click;
      x += y * v[6] * v[8];
      v[2] *= pek;
      v[3] *= aek;
      v[4] *= cek;
      v[8] -= v[9];
      v[8] <= 0 || (v[3] < 0.00001 && v[4] < 0.00001) ? v[0] = 0;
    );
    k += 1;
  );
  dr > 0 ? x = k_tanh(dg * x) / dn;
  x *= og;
  spl0 = x;
  spl1 = x;
  kk_pk = max(kk_pk, abs(x));

@gfx 560 410
  ng_knobs_begin("KICK", "INSTRUMENTS", 560, 150, 2, 0);

  // display: one kick over time: its level (filled) and its pitch (line, 20 Hz to 2 kHz on a
  // log scale), the start and end pitch, and the output level
  ng_plot(ng_vx + 4, ng_vy + 18, ng_vw - 170, ng_vh - 22);
  ng_grid(8, 4, 0);
  kk_len = max(0.2, slider5 / 1000 * 1.1);   // seconds shown
  kk_zy = ng_py + ng_ph;
  ng_col(NG_ACCENT, 0.16);
  kk_i = 0;
  loop(floor(ng_pw) + 1,
    kk_t = kk_len * kk_i / ng_pw;
    gfx_line(ng_px + kk_i, kk_zy, ng_px + kk_i, ng_py + ng_ph * (1 - exp(-6.907755278982137 * kk_t / (slider5 / 1000))), 0);
    kk_i += 1;
  );
  ng_col(NG_ACCENT, 1);
  kk_i = 0;
  loop(floor(ng_pw) + 1,
    kk_t = kk_len * kk_i / ng_pw;
    kk_f = slider1 * 2 ^ (sw * exp(-kk_t / (slider4 / 1000)));
    kk_y = ng_py + ng_ph * (1 - log(min(2000, max(20, kk_f)) / 20) / log(100));
    kk_i == 0 ? ng_line_start(ng_px, kk_y) : ng_line_to(ng_px + kk_i, kk_y);
    kk_i += 1;
  );
  ng_font(1, 7, 1);
  ng_col(NG_MUTED, 1);
  kk_len >= 1 ? sprintf(#kk_s, "%.1f S", kk_len) : sprintf(#kk_s, "%d MS", floor(kk_len * 1000 + 0.5));
  ng_txt(#kk_s, ng_vx + ng_vw - 170, ng_vy + 8, 2, 1);
  ng_txt(follow ? "FOLLOWS NOTES (C1 = PITCH)" : "EVERY KEY PLAYS PITCH", ng_vx + 6, ng_vy + 8, 0, 1);
  kk_tx = ng_vx + ng_vw - 150;
  ng_col(NG_ACCENT, 1);
  sprintf(#kk_p, "%.1f HZ", slider1);
  ng_txt(#kk_p, kk_tx, ng_vy + 30, 0, 1);
  ng_col(NG_MUTED, 1);
  sprintf(#kk_p, "FROM %.0f HZ", slider1 * 2 ^ sw);
  ng_txt(#kk_p, kk_tx, ng_vy + 46, 0, 1);
  sprintf(#kk_p, "CLICK %d%%", slider6);
  ng_txt(#kk_p, kk_tx, ng_vy + 62, 0, 1);
  ng_meter(kk_tx, ng_vy + ng_vh - 22, 140, 8, "OUT", ng_to_db(kk_pk), -140, -60);
  kk_pk = 0;

  ng_row(5);
  sprintf(#kk_v1, "%.1f Hz", slider1);
  ng_knob_ctl(1, "PITCH", #kk_v1, 30, 120, 50, 0.1, 0) ? update();
  ng_select_ctl(2, "FOLLOW", "OFF|ON", 0) ? update();
  sprintf(#kk_v3, "%.1f st", slider3);
  ng_knob_ctl(3, "SWEEP", #kk_v3, 0, 48, 24, 0.1, 0) ? update();
  sprintf(#kk_v4, "%.1f ms", slider4);
  ng_knob_ctl_log(4, "SWEEP TIME", #kk_v4, 2, 300, 40, 0.1) ? update();
  sprintf(#kk_v5, "%d ms", slider5);
  ng_knob_ctl_log(5, "DECAY", #kk_v5, 20, 3000, 450, 1) ? update();

  ng_row(5);
  sprintf(#kk_v6, "%d%%", slider6);
  ng_knob_ctl(6, "CLICK", #kk_v6, 0, 100, 30, 1, 0) ? update();
  slider7 >= 1000 ? sprintf(#kk_v7, "%.1f kHz", slider7 / 1000) : sprintf(#kk_v7, "%d Hz", slider7);
  ng_knob_ctl_log(7, "CLICK TONE", #kk_v7, 500, 12000, 3000, 1) ? update();
  sprintf(#kk_v8, "%d%%", slider8);
  ng_knob_ctl(8, "DRIVE", #kk_v8, 0, 100, 0, 1, 0) ? update();
  sprintf(#kk_v9, "%d%%", slider9);
  ng_knob_ctl(9, "VELOCITY", #kk_v9, 0, 100, 50, 1, 0) ? update();
  sprintf(#kk_v10, "%+.1f dB", slider10);
  ng_knob_ctl(10, "VOLUME", #kk_v10, -24, 12, 0, 0.1, 1) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
