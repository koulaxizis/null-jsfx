desc:NULL Delay GFX
author: Christos Koulaxizis
tags: delay echo slapback feedback pre-delay timing sync tempo gui
//category: Essentials
//NULL JSFX v2.3 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:250<0,2000,1>-Time (ms)
slider2:0<0,100,1>-Feedback (%)
slider3:30<0,100,1>-Mix (%)
slider4:0<0,1,1{OFF,ON}>-Tempo Sync
slider5:0<0,3,1{1/4,1/8,1/16,1/32}>-Subdivision
slider6:0<0,1,1{Stereo,Ping-Pong}>-Mode
slider7:20<20,2000,1:log>-Low Cut (Hz)
slider8:20000<1000,20000,1:log>-High Cut (Hz)
slider9:0<0,100,1>-Drive (%)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  // NULL Delay (../delay.jsfx) with its own interface: same audio code, plus @gfx.
  buf_size = ceil(srate * 2.1);
  buf_l = 0;
  buf_r = buf_l + buf_size;
  memset(buf_l, 0, 2 * buf_size);
  freembuf(buf_r + buf_size);
  wpos = 0;
  delay_samples = 1;
  // feedback-path filters (one-pole, per channel); off at their end stops (Low Cut 20 Hz,
  // High Cut 20 kHz), Drive off at 0%, so the defaults are the plain delay
  lc_l = lc_r = 0;
  hc_l = hc_r = 0;

  // soft saturation: a tanh-like curve, slope 1 at 0, flat at |x| = 3
  function dl_sat(x)
  (
    x = max(-3, min(3, x));
    x * (27 + x * x) / (27 + 9 * x * x);
  );
  gfx_ext_retina = 1;

  function update_time()
  (
    tempo_sync && tempo > 0 ? (
      delay_ms = 60000 / tempo * (slider5 == 0 ? 1 : slider5 == 1 ? 0.5 : slider5 == 2 ? 0.25 : 0.125);
    ) : (
      delay_ms = slider1;
    );
    delay_samples = floor(delay_ms * srate / 1000 + 0.5);
    delay_samples = max(1, min(buf_size - 1, delay_samples));
  );

  function update()
  (
    feedback = slider2 / 100 * 0.95;
    mix_amt = slider3 / 100;
    tempo_sync = slider4;
    ping = slider6;
    lc_on = slider7 > 20;
    lc_a = 1 - exp(-2 * $pi * slider7 / srate);
    hc_on = slider8 < 20000;
    hc_a = 1 - exp(-2 * $pi * slider8 / srate);
    drv_on = slider9 > 0;
    drv_g = 1 + slider9 / 100 * 3;
    update_time();
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 9;

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 250); ng_slider_set(2, 0); ng_slider_set(3, 30); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 20); ng_slider_set(8, 20000); ng_slider_set(9, 0); );
    p == 1 ? ( ng_slider_set(1, 110); ng_slider_set(2, 0); ng_slider_set(3, 20); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 20); ng_slider_set(8, 8000); ng_slider_set(9, 0); );
    p == 2 ? ( ng_slider_set(1, 25); ng_slider_set(2, 0); ng_slider_set(3, 30); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 20); ng_slider_set(8, 20000); ng_slider_set(9, 0); );
    p == 3 ? ( ng_slider_set(1, 250); ng_slider_set(2, 30); ng_slider_set(3, 20); ng_slider_set(4, 1); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 150); ng_slider_set(8, 6000); ng_slider_set(9, 0); );
    p == 4 ? ( ng_slider_set(1, 250); ng_slider_set(2, 40); ng_slider_set(3, 25); ng_slider_set(4, 1); ng_slider_set(5, 1); ng_slider_set(6, 1); ng_slider_set(7, 200); ng_slider_set(8, 8000); ng_slider_set(9, 0); );
    p == 5 ? ( ng_slider_set(1, 250); ng_slider_set(2, 25); ng_slider_set(3, 20); ng_slider_set(4, 1); ng_slider_set(5, 2); ng_slider_set(6, 0); ng_slider_set(7, 300); ng_slider_set(8, 7000); ng_slider_set(9, 0); );
    p == 6 ? ( ng_slider_set(1, 375); ng_slider_set(2, 50); ng_slider_set(3, 25); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 100); ng_slider_set(8, 3000); ng_slider_set(9, 40); );
    p == 7 ? ( ng_slider_set(1, 250); ng_slider_set(2, 70); ng_slider_set(3, 35); ng_slider_set(4, 1); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 300); ng_slider_set(8, 2500); ng_slider_set(9, 30); );
    p == 8 ? ( ng_slider_set(1, 750); ng_slider_set(2, 65); ng_slider_set(3, 25); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 250); ng_slider_set(8, 4000); ng_slider_set(9, 15); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 250) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 30) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 20) && ng_pre_eq(slider8, 20000) && ng_pre_eq(slider9, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 110) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 20) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 20) && ng_pre_eq(slider8, 8000) && ng_pre_eq(slider9, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 25) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 30) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 20) && ng_pre_eq(slider8, 20000) && ng_pre_eq(slider9, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 250) && ng_pre_eq(slider2, 30) && ng_pre_eq(slider3, 20) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 150) && ng_pre_eq(slider8, 6000) && ng_pre_eq(slider9, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 250) && ng_pre_eq(slider2, 40) && ng_pre_eq(slider3, 25) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 1) && ng_pre_eq(slider6, 1) && ng_pre_eq(slider7, 200) && ng_pre_eq(slider8, 8000) && ng_pre_eq(slider9, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 250) && ng_pre_eq(slider2, 25) && ng_pre_eq(slider3, 20) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 2) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 300) && ng_pre_eq(slider8, 7000) && ng_pre_eq(slider9, 0) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 375) && ng_pre_eq(slider2, 50) && ng_pre_eq(slider3, 25) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 100) && ng_pre_eq(slider8, 3000) && ng_pre_eq(slider9, 40) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 250) && ng_pre_eq(slider2, 70) && ng_pre_eq(slider3, 35) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 300) && ng_pre_eq(slider8, 2500) && ng_pre_eq(slider9, 30) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 750) && ng_pre_eq(slider2, 65) && ng_pre_eq(slider3, 25) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 250) && ng_pre_eq(slider8, 4000) && ng_pre_eq(slider9, 15) ? m = 8;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Vocal Slapback";
    p == 2 ? s = "Short Double";
    p == 3 ? s = "Quarter Note Echo";
    p == 4 ? s = "Ping-Pong Eighths";
    p == 5 ? s = "Sixteenth Rhythm";
    p == 6 ? s = "Dark Tape Echo";
    p == 7 ? s = "Dub Throw";
    p == 8 ? s = "Ambient Long Trail";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@block
  tempo_sync ? update_time();

@sample
  rpos = wpos - delay_samples;
  rpos < 0 ? rpos += buf_size;
  echo_l = buf_l[rpos];
  echo_r = buf_r[rpos];

  // inside the feedback loop: every repeat passes the filters and the drive again
  lc_on ? (
    lc_l += lc_a * (echo_l - lc_l); echo_l -= lc_l;
    lc_r += lc_a * (echo_r - lc_r); echo_r -= lc_r;
  ) : (
    lc_l = lc_r = 0;
  );
  hc_on ? (
    hc_l += hc_a * (echo_l - hc_l); echo_l = hc_l;
    hc_r += hc_a * (echo_r - hc_r); echo_r = hc_r;
  ) : (
    hc_l = echo_l; hc_r = echo_r;
  );
  drv_on ? (
    echo_l = dl_sat(echo_l * drv_g) / drv_g;
    echo_r = dl_sat(echo_r * drv_g) / drv_g;
  );

  ping ? (
    // ping-pong: the mono input enters the left line, the lines feed each other
    buf_l[wpos] = (spl0 + spl1) * 0.5 + echo_r * feedback;
    buf_r[wpos] = echo_l * feedback;
  ) : (
    buf_l[wpos] = spl0 + echo_l * feedback;
    buf_r[wpos] = spl1 + echo_r * feedback;
  );
  wpos += 1;
  wpos >= buf_size ? wpos = 0;

  spl0 = spl0 * (1 - mix_amt) + echo_l * mix_amt;
  spl1 = spl1 * (1 - mix_amt) + echo_r * mix_amt;

@gfx 480 380
  ng_knobs_begin("DELAY", "ESSENTIALS", 480, 120, 2, 0);

  // display: the dry signal at 0 and the echoes over 2.5 s, level in dB (0 to -48);
  // in Ping-Pong the right-channel echoes are dimmer, and what colours the loop is named
  ng_plot(ng_vx + 26, ng_vy + 4, ng_vw - 30, ng_vh - 20);
  ng_grid(5, 4, 0);
  ng_font(4, 8, 0);
  ng_col(NG_MUTED, 1);
  ng_ptxt("0", ng_px - 6 * ng_s, ng_py, 2);
  ng_ptxt("-24", ng_px - 6 * ng_s, ng_py + ng_ph / 2, 2);
  ng_ptxt("-48", ng_px - 6 * ng_s, ng_py + ng_ph, 2);
  dl_i = 1;
  loop(4, sprintf(#dl_t, "%.1f s", dl_i * 0.5); ng_ptxt(#dl_t, ng_px + ng_pw * dl_i / 5, ng_py + ng_ph + 10 * ng_s, 1); dl_i += 1;);
  strcpy(#dl_a, slider6 ? "PING-PONG" : "");
  slider7 > 20 ? sprintf(#dl_b, "  LC %d Hz", slider7) : strcpy(#dl_b, "");
  slider8 >= 20000 ? strcpy(#dl_c, "") : slider8 >= 1000 ? sprintf(#dl_c, "  HC %.1f kHz", slider8 / 1000) : sprintf(#dl_c, "  HC %d Hz", slider8);
  slider9 > 0 ? sprintf(#dl_d, "  DRIVE %d%%", slider9) : strcpy(#dl_d, "");
  sprintf(#dl_s, "%s%s%s%s", #dl_a, #dl_b, #dl_c, #dl_d);
  ng_ptxt(#dl_s, ng_px + ng_pw - 6 * ng_s, ng_py + 9 * ng_s, 2);
  dl_bw = max(2, 3 * ng_s);
  // dry
  slider3 < 100 ? (
    ng_col(NG_MUTED, 1);
    gfx_rect(ng_px, ng_lin_y(20 * log10(1 - slider3 / 100), -48, 0), dl_bw, ng_py + ng_ph - ng_lin_y(20 * log10(1 - slider3 / 100), -48, 0));
  );
  // echoes: the first at mix, each next one feedback lower
  slider3 > 0 && delay_ms > 0 ? (
    dl_g = slider3 / 100;
    dl_t = delay_ms;
    dl_n = 0;
    while (dl_t <= 2500 && dl_g > 0.004) (
      ng_col(NG_ACCENT, slider6 && dl_n % 2 ? 0.45 : 1);
      dl_y = ng_lin_y(20 * log10(dl_g), -48, 0);
      gfx_rect(ng_lin_x(dl_t, 0, 2500) - dl_bw / 2, dl_y, dl_bw, ng_py + ng_ph - dl_y);
      dl_g *= feedback;
      dl_t += delay_ms;
      dl_n += 1;
    );
  );

  ng_row(5);
  slider4 ? sprintf(#v1, "%d ms", floor(delay_ms + 0.5)) : sprintf(#v1, "%d ms", slider1);
  ng_knob_ctl(1, "TIME", #v1, 0, 2000, 250, 1, 0) ? update();
  sprintf(#v2, "%d%%", slider2);
  ng_knob_ctl(2, "FEEDBACK", #v2, 0, 100, 0, 1, 0) ? update();
  sprintf(#v3, "%d%%", slider3);
  ng_knob_ctl(3, "MIX", #v3, 0, 100, 30, 1, 0) ? update();
  ng_select_ctl(4, "SYNC", "OFF|ON", 0) ? update();
  ng_select_ctl(5, "NOTE", "1/4|1/8|1/16|1/32", 0) ? update();
  ng_row(4);
  ng_select_ctl(6, "MODE", "STEREO|PING", 0) ? update();
  slider7 > 20 ? sprintf(#v7, "%d Hz", slider7) : strcpy(#v7, "OFF");
  ng_knob_ctl_log(7, "LOW CUT", #v7, 20, 2000, 20, 1) ? update();
  slider8 >= 20000 ? strcpy(#v8, "OFF") : slider8 >= 1000 ? sprintf(#v8, "%.1f kHz", slider8 / 1000) : sprintf(#v8, "%d Hz", slider8);
  ng_knob_ctl_log(8, "HIGH CUT", #v8, 1000, 20000, 20000, 1) ? update();
  sprintf(#v9, "%d%%", slider9);
  ng_knob_ctl(9, "DRIVE", #v9, 0, 100, 0, 1, 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
