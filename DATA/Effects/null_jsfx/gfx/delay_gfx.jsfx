desc:NULL Delay GFX
author: Christos Koulaxizis
tags: delay echo slapback feedback pre-delay timing sync tempo tape modulation diffusion ducking freeze dotted triplet gui
//category: Essentials
//NULL JSFX v2.4 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:250<0,2000,1>-Time (ms)
slider2:0<0,100,1>-Feedback (%)
slider3:30<0,100,1>-Mix (%)
slider4:0<0,1,1{OFF,ON}>-Tempo Sync
slider5:0<0,11,1{1/4,1/8,1/16,1/32,1/2,1/1,1/4D,1/8D,1/16D,1/4T,1/8T,1/16T}>-Subdivision
slider6:0<0,1,1{Stereo,Ping-Pong}>-Mode
slider7:20<20,2000,1:log>-Low Cut (Hz)
slider8:20000<1000,20000,1:log>-High Cut (Hz)
slider9:0<0,100,1>-Drive (%)
slider10:0<0,100,1>-Modulation (%)
slider11:0<0,100,1>-Diffusion (%)
slider12:0<0,100,1>-Ducking (%)
slider13:0<0,1,1{Off,On}>-Freeze

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  // NULL Delay (../delay.jsfx) with its own interface: same audio code, plus @gfx.
  // 6.1 s per channel: a whole note (1/1) down to 40 bpm (6 s); slower tempos are clamped
  buf_size = ceil(srate * 6.1);
  buf_l = 0;
  buf_r = buf_l + buf_size;
  // diffusion: 4 all-passes per channel (up to 4.63 ms each) after the delay lines
  ap_size = ceil(srate * 0.005) + 1;
  ap_base = buf_r + buf_size;
  memset(buf_l, 0, 2 * buf_size + 8 * ap_size);
  freembuf(ap_base + 8 * ap_size);
  wpos = 0;
  delay_samples = 1;
  // feedback-path filters (one-pole, per channel); off at their end stops (Low Cut 20 Hz,
  // High Cut 20 kHz), Drive off at 0%, so the defaults are the plain delay
  lc_l = lc_r = 0;
  hc_l = hc_r = 0;
  // Modulation, Diffusion, Ducking and Freeze are skipped at their defaults (0, 0, 0, Off)
  md_p1 = md_p2 = 0;
  dk_env = 0;
  diff_was = 0;

  // soft saturation: a tanh-like curve, slope 1 at 0, flat at |x| = 3
  function dl_sat(x)
  (
    x = max(-3, min(3, x));
    x * (27 + x * x) / (27 + 9 * x * x);
  );

  // Schroeder all-pass of len samples at buf: (z^-len - g) / (1 - g z^-len)
  function dl_ap_init(b, n) instance(buf, len, p) ( buf = b; len = n; p = 0; );
  function dl_ap(x, g) instance(buf, len, p) local(d, y)
  (
    d = buf[p];
    y = d - g * x;
    buf[p] = x + g * y;
    p += 1;
    p >= len ? p = 0;
    y;
  );
  apl1.dl_ap_init(ap_base, floor(srate * 0.00113));
  apl2.dl_ap_init(ap_base + ap_size, floor(srate * 0.00187));
  apl3.dl_ap_init(ap_base + 2 * ap_size, floor(srate * 0.00307));
  apl4.dl_ap_init(ap_base + 3 * ap_size, floor(srate * 0.00441));
  apr1.dl_ap_init(ap_base + 4 * ap_size, floor(srate * 0.00129));
  apr2.dl_ap_init(ap_base + 5 * ap_size, floor(srate * 0.00203));
  apr3.dl_ap_init(ap_base + 6 * ap_size, floor(srate * 0.00323));
  apr4.dl_ap_init(ap_base + 7 * ap_size, floor(srate * 0.00463));

  function update_time()
  (
    tempo_sync && tempo > 0 ? (
      delay_ms = 60000 / tempo * (slider5 == 0 ? 1 : slider5 == 1 ? 0.5 : slider5 == 2 ? 0.25 : slider5 == 3 ? 0.125 :
                                  slider5 == 4 ? 2 : slider5 == 5 ? 4 : slider5 == 6 ? 1.5 : slider5 == 7 ? 0.75 :
                                  slider5 == 8 ? 0.375 : slider5 == 9 ? 2 / 3 : slider5 == 10 ? 1 / 3 : 1 / 6);
    ) : (
      delay_ms = slider1;
    );
    delay_samples = floor(delay_ms * srate / 1000 + 0.5);
    delay_samples = max(1, min(buf_size - 1, delay_samples));
  );
  gfx_ext_retina = 1;

  function update()
  (
    feedback = slider2 / 100 * 0.95;
    mix_amt = slider3 / 100;
    tempo_sync = slider4;
    ping = slider6;
    lc_on = slider7 > 20;
    lc_a = 1 - exp(-2 * $pi * slider7 / srate);
    hc_on = slider8 < 20000;
    hc_a = 1 - exp(-2 * $pi * slider8 / srate);
    drv_on = slider9 > 0;
    drv_g = 1 + slider9 / 100 * 3;
    // wow: two slow sines (0.5 and 1.3 Hz) push the read point back by up to 4 ms
    mod_on = slider10 > 0;
    md_dep = slider10 / 100 * 0.002 * srate;
    md_i1 = 0.5 / srate;
    md_i2 = 1.3 / srate;
    diff_on = slider11 > 0;
    diff_g = slider11 / 100 * 0.75;
    diff_on && !diff_was ? memset(ap_base, 0, 8 * ap_size);
    diff_was = diff_on;
    duck_on = slider12 > 0;
    duck_amt = slider12 / 100;
    dk_att = 1 - exp(-1 / (0.01 * srate));
    dk_rel = 1 - exp(-1 / (0.25 * srate));
    frz = slider13;
    update_time();
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 16;

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 250); ng_slider_set(2, 0); ng_slider_set(3, 30); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 20); ng_slider_set(8, 20000); ng_slider_set(9, 0); ng_slider_set(10, 0); ng_slider_set(11, 0); ng_slider_set(12, 0); ng_slider_set(13, 0); );
    p == 1 ? ( ng_slider_set(1, 110); ng_slider_set(2, 0); ng_slider_set(3, 20); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 20); ng_slider_set(8, 8000); ng_slider_set(9, 0); ng_slider_set(10, 0); ng_slider_set(11, 0); ng_slider_set(12, 0); ng_slider_set(13, 0); );
    p == 2 ? ( ng_slider_set(1, 25); ng_slider_set(2, 0); ng_slider_set(3, 30); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 20); ng_slider_set(8, 20000); ng_slider_set(9, 0); ng_slider_set(10, 0); ng_slider_set(11, 0); ng_slider_set(12, 0); ng_slider_set(13, 0); );
    p == 3 ? ( ng_slider_set(1, 250); ng_slider_set(2, 30); ng_slider_set(3, 20); ng_slider_set(4, 1); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 150); ng_slider_set(8, 6000); ng_slider_set(9, 0); ng_slider_set(10, 0); ng_slider_set(11, 0); ng_slider_set(12, 0); ng_slider_set(13, 0); );
    p == 4 ? ( ng_slider_set(1, 250); ng_slider_set(2, 40); ng_slider_set(3, 25); ng_slider_set(4, 1); ng_slider_set(5, 1); ng_slider_set(6, 1); ng_slider_set(7, 200); ng_slider_set(8, 8000); ng_slider_set(9, 0); ng_slider_set(10, 0); ng_slider_set(11, 0); ng_slider_set(12, 0); ng_slider_set(13, 0); );
    p == 5 ? ( ng_slider_set(1, 250); ng_slider_set(2, 25); ng_slider_set(3, 20); ng_slider_set(4, 1); ng_slider_set(5, 2); ng_slider_set(6, 0); ng_slider_set(7, 300); ng_slider_set(8, 7000); ng_slider_set(9, 0); ng_slider_set(10, 0); ng_slider_set(11, 0); ng_slider_set(12, 0); ng_slider_set(13, 0); );
    p == 6 ? ( ng_slider_set(1, 375); ng_slider_set(2, 50); ng_slider_set(3, 25); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 100); ng_slider_set(8, 3000); ng_slider_set(9, 40); ng_slider_set(10, 0); ng_slider_set(11, 0); ng_slider_set(12, 0); ng_slider_set(13, 0); );
    p == 7 ? ( ng_slider_set(1, 250); ng_slider_set(2, 70); ng_slider_set(3, 35); ng_slider_set(4, 1); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 300); ng_slider_set(8, 2500); ng_slider_set(9, 30); ng_slider_set(10, 0); ng_slider_set(11, 0); ng_slider_set(12, 0); ng_slider_set(13, 0); );
    p == 8 ? ( ng_slider_set(1, 750); ng_slider_set(2, 65); ng_slider_set(3, 25); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 250); ng_slider_set(8, 4000); ng_slider_set(9, 15); ng_slider_set(10, 0); ng_slider_set(11, 0); ng_slider_set(12, 0); ng_slider_set(13, 0); );
    p == 9 ? ( ng_slider_set(1, 250); ng_slider_set(2, 35); ng_slider_set(3, 25); ng_slider_set(4, 1); ng_slider_set(5, 7); ng_slider_set(6, 0); ng_slider_set(7, 150); ng_slider_set(8, 7000); ng_slider_set(9, 0); ng_slider_set(10, 0); ng_slider_set(11, 0); ng_slider_set(12, 0); ng_slider_set(13, 0); );
    p == 10 ? ( ng_slider_set(1, 250); ng_slider_set(2, 60); ng_slider_set(3, 30); ng_slider_set(4, 1); ng_slider_set(5, 4); ng_slider_set(6, 0); ng_slider_set(7, 200); ng_slider_set(8, 5000); ng_slider_set(9, 0); ng_slider_set(10, 25); ng_slider_set(11, 70); ng_slider_set(12, 0); ng_slider_set(13, 0); );
    p == 11 ? ( ng_slider_set(1, 250); ng_slider_set(2, 45); ng_slider_set(3, 25); ng_slider_set(4, 1); ng_slider_set(5, 10); ng_slider_set(6, 1); ng_slider_set(7, 250); ng_slider_set(8, 8000); ng_slider_set(9, 0); ng_slider_set(10, 0); ng_slider_set(11, 0); ng_slider_set(12, 0); ng_slider_set(13, 0); );
    p == 12 ? ( ng_slider_set(1, 420); ng_slider_set(2, 55); ng_slider_set(3, 30); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 150); ng_slider_set(8, 6000); ng_slider_set(9, 0); ng_slider_set(10, 0); ng_slider_set(11, 60); ng_slider_set(12, 0); ng_slider_set(13, 0); );
    p == 13 ? ( ng_slider_set(1, 250); ng_slider_set(2, 45); ng_slider_set(3, 40); ng_slider_set(4, 1); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 300); ng_slider_set(8, 5000); ng_slider_set(9, 0); ng_slider_set(10, 0); ng_slider_set(11, 0); ng_slider_set(12, 70); ng_slider_set(13, 0); );
    p == 14 ? ( ng_slider_set(1, 330); ng_slider_set(2, 45); ng_slider_set(3, 25); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 120); ng_slider_set(8, 3500); ng_slider_set(9, 30); ng_slider_set(10, 60); ng_slider_set(11, 0); ng_slider_set(12, 0); ng_slider_set(13, 0); );
    p == 15 ? ( ng_slider_set(1, 250); ng_slider_set(2, 50); ng_slider_set(3, 50); ng_slider_set(4, 1); ng_slider_set(5, 5); ng_slider_set(6, 0); ng_slider_set(7, 20); ng_slider_set(8, 20000); ng_slider_set(9, 0); ng_slider_set(10, 0); ng_slider_set(11, 0); ng_slider_set(12, 0); ng_slider_set(13, 1); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 250) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 30) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 20) && ng_pre_eq(slider8, 20000) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 110) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 20) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 20) && ng_pre_eq(slider8, 8000) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 25) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 30) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 20) && ng_pre_eq(slider8, 20000) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 250) && ng_pre_eq(slider2, 30) && ng_pre_eq(slider3, 20) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 150) && ng_pre_eq(slider8, 6000) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 250) && ng_pre_eq(slider2, 40) && ng_pre_eq(slider3, 25) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 1) && ng_pre_eq(slider6, 1) && ng_pre_eq(slider7, 200) && ng_pre_eq(slider8, 8000) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 250) && ng_pre_eq(slider2, 25) && ng_pre_eq(slider3, 20) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 2) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 300) && ng_pre_eq(slider8, 7000) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 0) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 375) && ng_pre_eq(slider2, 50) && ng_pre_eq(slider3, 25) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 100) && ng_pre_eq(slider8, 3000) && ng_pre_eq(slider9, 40) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 0) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 250) && ng_pre_eq(slider2, 70) && ng_pre_eq(slider3, 35) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 300) && ng_pre_eq(slider8, 2500) && ng_pre_eq(slider9, 30) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 0) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 750) && ng_pre_eq(slider2, 65) && ng_pre_eq(slider3, 25) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 250) && ng_pre_eq(slider8, 4000) && ng_pre_eq(slider9, 15) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 0) ? m = 8;
    m < 0 && ng_pre_eq(slider1, 250) && ng_pre_eq(slider2, 35) && ng_pre_eq(slider3, 25) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 7) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 150) && ng_pre_eq(slider8, 7000) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 0) ? m = 9;
    m < 0 && ng_pre_eq(slider1, 250) && ng_pre_eq(slider2, 60) && ng_pre_eq(slider3, 30) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 4) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 200) && ng_pre_eq(slider8, 5000) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 25) && ng_pre_eq(slider11, 70) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 0) ? m = 10;
    m < 0 && ng_pre_eq(slider1, 250) && ng_pre_eq(slider2, 45) && ng_pre_eq(slider3, 25) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 10) && ng_pre_eq(slider6, 1) && ng_pre_eq(slider7, 250) && ng_pre_eq(slider8, 8000) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 0) ? m = 11;
    m < 0 && ng_pre_eq(slider1, 420) && ng_pre_eq(slider2, 55) && ng_pre_eq(slider3, 30) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 150) && ng_pre_eq(slider8, 6000) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 60) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 0) ? m = 12;
    m < 0 && ng_pre_eq(slider1, 250) && ng_pre_eq(slider2, 45) && ng_pre_eq(slider3, 40) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 300) && ng_pre_eq(slider8, 5000) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 70) && ng_pre_eq(slider13, 0) ? m = 13;
    m < 0 && ng_pre_eq(slider1, 330) && ng_pre_eq(slider2, 45) && ng_pre_eq(slider3, 25) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 120) && ng_pre_eq(slider8, 3500) && ng_pre_eq(slider9, 30) && ng_pre_eq(slider10, 60) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 0) ? m = 14;
    m < 0 && ng_pre_eq(slider1, 250) && ng_pre_eq(slider2, 50) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 5) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 20) && ng_pre_eq(slider8, 20000) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 1) ? m = 15;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Vocal Slapback";
    p == 2 ? s = "Short Double";
    p == 3 ? s = "Quarter Note Echo";
    p == 4 ? s = "Ping-Pong Eighths";
    p == 5 ? s = "Sixteenth Rhythm";
    p == 6 ? s = "Dark Tape Echo";
    p == 7 ? s = "Dub Throw";
    p == 8 ? s = "Ambient Long Trail";
    p == 9 ? s = "Dotted Eighth";
    p == 10 ? s = "Half-Note Wash";
    p == 11 ? s = "Triplet Bounce";
    p == 12 ? s = "Diffused Echo";
    p == 13 ? s = "Ducked Vocal Throw";
    p == 14 ? s = "Wobbly Tape";
    p == 15 ? s = "Frozen Loop";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@block
  tempo_sync ? update_time();

@sample
  mod_on && !frz ? (
    // tape wow: a fractional read point, linearly interpolated
    md_p1 += md_i1;
    md_p1 >= 1 ? md_p1 -= 1;
    md_p2 += md_i2;
    md_p2 >= 1 ? md_p2 -= 1;
    md_off = delay_samples + md_dep * (1 + 0.75 * sin(2 * $pi * md_p1) + 0.25 * sin(2 * $pi * md_p2));
    md_off = min(buf_size - 2, md_off);
    rf = wpos - md_off;
    rf < 0 ? rf += buf_size;
    ri = floor(rf);
    rfr = rf - ri;
    ri >= buf_size ? ri -= buf_size;
    ri2 = ri + 1;
    ri2 >= buf_size ? ri2 = 0;
    echo_l = buf_l[ri] + (buf_l[ri2] - buf_l[ri]) * rfr;
    echo_r = buf_r[ri] + (buf_r[ri2] - buf_r[ri]) * rfr;
  ) : (
    rpos = wpos - delay_samples;
    rpos < 0 ? rpos += buf_size;
    echo_l = buf_l[rpos];
    echo_r = buf_r[rpos];
  );

  // diffusion: the all-pass chain smears every repeat a little more
  diff_on && !frz ? (
    echo_l = apl4.dl_ap(apl3.dl_ap(apl2.dl_ap(apl1.dl_ap(echo_l, diff_g), diff_g), diff_g), diff_g);
    echo_r = apr4.dl_ap(apr3.dl_ap(apr2.dl_ap(apr1.dl_ap(echo_r, diff_g), diff_g), diff_g), diff_g);
  );

  frz ? (
    // frozen: the loop repeats unchanged, filters and drive bypassed
    lc_l = lc_r = 0;
    hc_l = echo_l; hc_r = echo_r;
    ping ? (
      buf_l[wpos] = echo_r;
      buf_r[wpos] = echo_l;
    ) : (
      buf_l[wpos] = echo_l;
      buf_r[wpos] = echo_r;
    );
  ) : (
    // inside the feedback loop: every repeat passes the filters and the drive again
    lc_on ? (
      lc_l += lc_a * (echo_l - lc_l); echo_l -= lc_l;
      lc_r += lc_a * (echo_r - lc_r); echo_r -= lc_r;
    ) : (
      lc_l = lc_r = 0;
    );
    hc_on ? (
      hc_l += hc_a * (echo_l - hc_l); echo_l = hc_l;
      hc_r += hc_a * (echo_r - hc_r); echo_r = hc_r;
    ) : (
      hc_l = echo_l; hc_r = echo_r;
    );
    drv_on ? (
      echo_l = dl_sat(echo_l * drv_g) / drv_g;
      echo_r = dl_sat(echo_r * drv_g) / drv_g;
    );

    ping ? (
      // ping-pong: the mono input enters the left line, the lines feed each other
      buf_l[wpos] = (spl0 + spl1) * 0.5 + echo_r * feedback;
      buf_r[wpos] = echo_l * feedback;
    ) : (
      buf_l[wpos] = spl0 + echo_l * feedback;
      buf_r[wpos] = spl1 + echo_r * feedback;
    );
  );
  wpos += 1;
  wpos >= buf_size ? wpos = 0;

  duck_on ? (
    // ducking: the echoes dip while the dry input is loud (10 ms attack, 250 ms release)
    dk_x = max(abs(spl0), abs(spl1));
    dk_env += (dk_x > dk_env ? dk_att : dk_rel) * (dk_x - dk_env);
    dk_g = 1 - duck_amt * min(1, dk_env * 4);
    spl0 = spl0 * (1 - mix_amt) + echo_l * dk_g * mix_amt;
    spl1 = spl1 * (1 - mix_amt) + echo_r * dk_g * mix_amt;
  ) : (
    spl0 = spl0 * (1 - mix_amt) + echo_l * mix_amt;
    spl1 = spl1 * (1 - mix_amt) + echo_r * mix_amt;
  );

@gfx 480 408
  ng_knobs_begin("DELAY", "ESSENTIALS", 480, 120, 2, 1);

  // display: the dry signal at 0 and the echoes over 2.5 s (7.5 s for longer times), level in
  // dB (0 to -48); in Ping-Pong the right-channel echoes are dimmer, Diffusion smears each echo,
  // Freeze holds them level, and what colours the loop is named
  dl_win = delay_ms > 2000 ? 7500 : 2500;
  ng_plot(ng_vx + 26, ng_vy + 4, ng_vw - 30, ng_vh - 20);
  ng_grid(5, 4, 0);
  ng_font(4, 8, 0);
  ng_col(NG_MUTED, 1);
  ng_ptxt("0", ng_px - 6 * ng_s, ng_py, 2);
  ng_ptxt("-24", ng_px - 6 * ng_s, ng_py + ng_ph / 2, 2);
  ng_ptxt("-48", ng_px - 6 * ng_s, ng_py + ng_ph, 2);
  dl_i = 1;
  loop(4, sprintf(#dl_t, "%.1f s", dl_i * dl_win / 5000); ng_ptxt(#dl_t, ng_px + ng_pw * dl_i / 5, ng_py + ng_ph + 10 * ng_s, 1); dl_i += 1;);
  strcpy(#dl_a, slider13 ? (slider6 ? "FREEZE  PING-PONG" : "FREEZE") : (slider6 ? "PING-PONG" : ""));
  slider7 > 20 ? sprintf(#dl_b, "  LC %d Hz", slider7) : strcpy(#dl_b, "");
  slider8 >= 20000 ? strcpy(#dl_c, "") : slider8 >= 1000 ? sprintf(#dl_c, "  HC %.1f kHz", slider8 / 1000) : sprintf(#dl_c, "  HC %d Hz", slider8);
  slider9 > 0 ? sprintf(#dl_d, "  DRIVE %d%%", slider9) : strcpy(#dl_d, "");
  sprintf(#dl_s, "%s%s%s%s", #dl_a, #dl_b, #dl_c, #dl_d);
  ng_ptxt(#dl_s, ng_px + ng_pw - 6 * ng_s, ng_py + 9 * ng_s, 2);
  slider10 > 0 ? sprintf(#dl_a, "MOD %d%%", slider10) : strcpy(#dl_a, "");
  slider11 > 0 ? sprintf(#dl_b, "  DIFF %d%%", slider11) : strcpy(#dl_b, "");
  slider12 > 0 ? sprintf(#dl_c, "  DUCK %d%%", slider12) : strcpy(#dl_c, "");
  sprintf(#dl_s, "%s%s%s", #dl_a, #dl_b, #dl_c);
  ng_ptxt(#dl_s, ng_px + ng_pw - 6 * ng_s, ng_py + 21 * ng_s, 2);
  dl_bw = max(2, 3 * ng_s);
  // dry
  slider3 < 100 ? (
    ng_col(NG_MUTED, 1);
    gfx_rect(ng_px, ng_lin_y(20 * log10(1 - slider3 / 100), -48, 0), dl_bw, ng_py + ng_ph - ng_lin_y(20 * log10(1 - slider3 / 100), -48, 0));
  );
  // echoes: the first at mix, each next one feedback lower (level when frozen)
  slider3 > 0 && delay_ms > 0 ? (
    dl_g = slider3 / 100;
    dl_fb = slider13 ? 1 : feedback;
    dl_tw = slider11 / 100 * 36 * ng_s;
    dl_t = delay_ms;
    dl_n = 0;
    while (dl_t <= dl_win && dl_g > 0.004) (
      dl_x = ng_lin_x(dl_t, 0, dl_win);
      dl_y = ng_lin_y(20 * log10(dl_g), -48, 0);
      slider11 > 0 ? (
        // the smear: six fading steps after the echo
        dl_j = 0;
        loop(6,
          dl_h = (ng_py + ng_ph - dl_y) * 0.7 * (1 - dl_j / 6);
          ng_col(NG_ACCENT, 0.24 * (1 - dl_j / 6));
          dl_x + dl_tw * (dl_j + 1) / 6 <= ng_px + ng_pw ? gfx_rect(dl_x + dl_tw * dl_j / 6, ng_py + ng_ph - dl_h, dl_tw / 6, dl_h);
          dl_j += 1;
        );
      );
      ng_col(NG_ACCENT, slider6 && dl_n % 2 ? 0.45 : 1);
      gfx_rect(dl_x - dl_bw / 2, dl_y, dl_bw, ng_py + ng_ph - dl_y);
      dl_g *= dl_fb;
      dl_t += delay_ms;
      dl_n += 1;
    );
  );

  dl_tab = ng_tabs("ECHO|CHARACTER", dl_tab);
  dl_tab == 0 ? (
    ng_row(4);
    slider4 ? sprintf(#v1, "%d ms", floor(delay_ms + 0.5)) : sprintf(#v1, "%d ms", slider1);
    ng_knob_ctl(1, "TIME", #v1, 0, 2000, 250, 1, 0) ? update();
    sprintf(#v2, "%d%%", slider2);
    ng_knob_ctl(2, "FEEDBACK", #v2, 0, 100, 0, 1, 0) ? update();
    sprintf(#v3, "%d%%", slider3);
    ng_knob_ctl(3, "MIX", #v3, 0, 100, 30, 1, 0) ? update();
    ng_select_ctl(6, "MODE", "STEREO|PING", 0) ? update();
    ng_row(3);
    ng_select_ctl(4, "SYNC", "OFF|ON", 0) ? update();
    ng_select_ctl(5, "NOTE", "1/4|1/8|1/16|1/32|1/2|1/1|1/4D|1/8D|1/16D|1/4T|1/8T|1/16T", 0) ? update();
    ng_select_ctl(13, "FREEZE", "OFF|ON", 0) ? update();
  ) : (
    ng_row(3);
    slider7 > 20 ? sprintf(#v7, "%d Hz", slider7) : strcpy(#v7, "OFF");
    ng_knob_ctl_log(7, "LOW CUT", #v7, 20, 2000, 20, 1) ? update();
    slider8 >= 20000 ? strcpy(#v8, "OFF") : slider8 >= 1000 ? sprintf(#v8, "%.1f kHz", slider8 / 1000) : sprintf(#v8, "%d Hz", slider8);
    ng_knob_ctl_log(8, "HIGH CUT", #v8, 1000, 20000, 20000, 1) ? update();
    sprintf(#v9, "%d%%", slider9);
    ng_knob_ctl(9, "DRIVE", #v9, 0, 100, 0, 1, 0) ? update();
    ng_row(3);
    sprintf(#v10, "%d%%", slider10);
    ng_knob_ctl(10, "MODULATION", #v10, 0, 100, 0, 1, 0) ? update();
    sprintf(#v11, "%d%%", slider11);
    ng_knob_ctl(11, "DIFFUSION", #v11, 0, 100, 0, 1, 0) ? update();
    sprintf(#v12, "%d%%", slider12);
    ng_knob_ctl(12, "DUCKING", #v12, 0, 100, 0, 1, 0) ? update();
  );

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
