desc:NULL Console Channel GFX
author: Christos Koulaxizis
tags: console channel analog mixer summing saturation colour warm punchy bright drive harmonics gui
//category: Advanced
//NULL JSFX v2.9 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:1<0,3,1{Clean,Warm,Punchy,Bright}>-Character
slider2:30<0,100,1>-Drive (%)
slider3:0<-12,12,0.1>-Output (dB)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // NULL Console Channel (../console_channel.jsfx) with its own interface: same audio code, plus @gfx.
  // The colour of a mixing-console channel, for every track that feeds a bus with Console Buss.
  // Each channel goes through a pre-emphasis shelf, a soft saturator (Pade tanh, flat beyond
  // +-3) with 6 dB of headroom above full scale, and the exact inverse of the shelf, so small
  // signals come out with a flat response and only the saturation depends on frequency.
  // Character: Clean = no shelf, symmetric, up to 12 dB of drive; Warm = the lows (+6 dB below
  // 200 Hz) saturate first, with even harmonics, 15 dB; Punchy = the deep lows (+4 dB below
  // 80 Hz), a touch of even harmonics, 18 dB; Bright = the highs (+6 dB above 3 kHz), 12 dB.
  // A 5 Hz DC blocker follows (the even harmonics bring DC). States below 1e-15 are cleared
  // so silence stays free of denormals.

  // one channel: emphasis, saturation, de-emphasis, DC blocker
  function cc_ch(x) instance(xp, ep, sp, yp, dx, dy) local(e, u, v, s, y)
  (
    emph ? (
      e = b0 * x - b1 * xp + sc * ep;
      xp = x;
      ep = abs(e) < 0.000000000000001 ? 0 : e;
    ) : (
      e = x;
    );
    u = e * k;
    u = u > 3 ? 3 : u < -3 ? -3 : u;
    v = u * (27 + u * u) / (27 + 9 * u * u);
    s = (v + asym * v * v) * ik;
    emph ? (
      y = (s - sc * sp + b1 * yp) / b0;
      sp = s;
      yp = abs(y) < 0.000000000000001 ? 0 : y;
    ) : (
      y = s;
    );
    v = y - dx + dc * dy;
    dx = y;
    dy = abs(v) < 0.000000000000001 ? 0 : v;
    v * go;
  );

  cc_rel = exp(-1 / (0.3 * srate));
  cc_in = cc_out = 0;
  gfx_ext_retina = 1;

  function update()
  (
    ch = slider1;
    emph = ch > 0;
    sg = 10 ^ ((ch == 2 ? 4 : 6) / 20);
    sc = exp(-2 * $pi * min(ch == 1 ? 200 : ch == 2 ? 80 : 3000, 0.45 * srate) / srate);
    ch == 3 ? (
      b0 = 1 + sc * (sg - 1);
      b1 = sg * sc;
    ) : (
      b0 = 1 + (sg - 1) * (1 - sc);
      b1 = sc;
    );
    asym = ch == 1 ? 0.15 : ch == 2 ? 0.05 : 0;
    k = 10 ^ (slider2 / 100 * (ch == 1 ? 15 : ch == 2 ? 18 : 12) / 20) / 2;
    ik = 1 / k;
    go = 10 ^ (slider3 / 20);
    dc = 1 - 2 * $pi * 5 / srate;
  );

  // the static curve without the shelves: output for a steady input amplitude x
  function cc_curve(x) local(u, v)
  (
    u = x * k;
    u = u > 3 ? 3 : u < -3 ? -3 : u;
    v = u * (27 + u * u) / (27 + 9 * u * u);
    (v + asym * v * v) * ik * go;
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 7;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1); ng_hist_add(2); ng_hist_add(3);
  ng_hist_init();

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 1); ng_slider_set(2, 30); ng_slider_set(3, 0); );
    p == 1 ? ( ng_slider_set(1, 0); ng_slider_set(2, 40); ng_slider_set(3, 0); );
    p == 2 ? ( ng_slider_set(1, 1); ng_slider_set(2, 50); ng_slider_set(3, 0); );
    p == 3 ? ( ng_slider_set(1, 2); ng_slider_set(2, 60); ng_slider_set(3, 0); );
    p == 4 ? ( ng_slider_set(1, 3); ng_slider_set(2, 40); ng_slider_set(3, 0); );
    p == 5 ? ( ng_slider_set(1, 1); ng_slider_set(2, 90); ng_slider_set(3, -3); );
    p == 6 ? ( ng_slider_set(1, 1); ng_slider_set(2, 15); ng_slider_set(3, 0); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 30) && ng_pre_eq(slider3, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 40) && ng_pre_eq(slider3, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 50) && ng_pre_eq(slider3, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 60) && ng_pre_eq(slider3, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 3) && ng_pre_eq(slider2, 40) && ng_pre_eq(slider3, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 90) && ng_pre_eq(slider3, -3) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 15) && ng_pre_eq(slider3, 0) ? m = 6;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Clean Desk";
    p == 2 ? s = "Warm Tracks";
    p == 3 ? s = "Punchy Drums";
    p == 4 ? s = "Bright Vocals";
    p == 5 ? s = "Hot Channel";
    p == 6 ? s = "Subtle Colour";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  // interface only: the input meter (reads the input, never changes it)
  cc_lv = max(abs(spl0), abs(spl1));
  cc_in = cc_lv > cc_in ? cc_lv : cc_in * cc_rel;
  spl0 = l.cc_ch(spl0);
  spl1 = r.cc_ch(spl1);

  // interface only: the output meter
  cc_lv = max(abs(spl0), abs(spl1));
  cc_out = cc_lv > cc_out ? cc_lv : cc_out * cc_rel;

@gfx 480 294
  ng_knobs_begin("CONSOLE CHANNEL", "ADVANCED", 480, 120, 1, 0);

  // display, left: the saturation curve (input -2..+2 across, output up; full scale at +-1)
  // without the shelves; right: the character, the drive and input and output meters
  ng_plot(64, 66, 92, 92);
  ng_grid(4, 4, 1);
  ng_font(4, 8, 0);
  ng_col(NG_MUTED, 1);
  ng_ptxt("+2", ng_px - 6 * ng_s, ng_py, 2);
  ng_ptxt("0", ng_px - 6 * ng_s, ng_py + ng_ph / 2, 2);
  ng_ptxt("-2", ng_px - 6 * ng_s, ng_py + ng_ph, 2);
  ng_col(NG_ACCENT, 0.25);
  gfx_line(ng_px, ng_py + ng_ph, ng_px + ng_pw, ng_py, 1);
  ng_col(NG_ACCENT, 1);
  cc_i = 0;
  loop(93,
    cc_yy = ng_lin_y(cc_curve(-2 + 4 * cc_i / 92), -2, 2);
    cc_xx = ng_px + ng_pw * cc_i / 92;
    cc_i == 0 ? ng_line_start(cc_xx, cc_yy) : ng_line_to(cc_xx, cc_yy);
    cc_i += 1;
  );
  ng_font(1, 7, 1);
  ng_col(NG_ACCENT, 1);
  ng_txt(slider1 == 1 ? "WARM" : slider1 == 2 ? "PUNCHY" : slider1 == 3 ? "BRIGHT" : "CLEAN", 180, 66, 0, 1);
  sprintf(#cc_st, "+%.1f DB DRIVE", slider2 / 100 * (ch == 1 ? 15 : ch == 2 ? 18 : 12));
  ng_col(NG_MUTED, 1);
  ng_txt(#cc_st, 448, 66, 2, 1);
  ng_meter(180, 90, 268, 10, "IN", ng_to_db(cc_in), -140, -60);
  ng_meter(180, 118, 268, 10, "OUT", ng_to_db(cc_out), -140, -60);

  ng_row(3);
  ng_select_ctl(1, "CHARACTER", "CLEAN|WARM|PUNCHY|BRIGHT", 0) ? update();
  sprintf(#v2, "%d%%", slider2);
  ng_knob_ctl(2, "DRIVE", #v2, 0, 100, 30, 1, 0) ? update();
  sprintf(#v3, "%+.1f dB", slider3);
  ng_knob_ctl(3, "OUTPUT", #v3, -12, 12, 0, 0.1, 1) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
