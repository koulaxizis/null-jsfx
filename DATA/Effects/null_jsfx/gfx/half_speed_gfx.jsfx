desc:NULL Half Speed GFX
author: Christos Koulaxizis
tags: half speed halftime half-time slow down octave down tempo sync time stretch granular pitch creative gui
//category: Advanced
//NULL JSFX v2.5 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:2<0,3,1{1/4,1/2,1 Bar,2 Bars}>-Length
slider2:0<0,2,1{1/2,1/4,2/3}>-Speed
slider3:0<0,1,1{Off,On}>-Pitch Keep
slider4:20000<1000,20000,1:log>-Tone (Hz)
slider5:100<0,100,1>-Mix (%)
slider6:0<0,3,1>-Sync Offset (beats)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  // NULL Half Speed (../half_speed.jsfx) with its own interface: same audio code, plus @gfx.
  // Real-time halftime. A cycle lasts Length / Speed (two Lengths at 1/2): from its start the
  // input is recorded into the buffer while it is played back from the cycle's start at Speed,
  // so the first Length of every cycle fills the whole cycle (an octave down at 1/2). With
  // Pitch Keep the buffer is read by two overlapping Hann grains (40 ms) that move through it at
  // Speed but play at the original pitch, so only the tempo changes. While the transport plays,
  // the cycle is locked to the song position (bar 1 + Sync Offset beats); stopped, it free-runs
  // at the host tempo. A new cycle crossfades from the old playback over 5 ms. Tone is a
  // one-pole high cut on the slowed signal (off at 20 kHz). Tempo is clamped to 40..300 bpm.
  xf = max(1, floor(0.005 * srate));          // seam crossfade
  gl = 2 * max(8, floor(0.02 * srate));       // grain length (even, ~40 ms)
  margin = ceil(0.1 * srate);                 // recorded past the Length, for the seam and grains
  bsize = ceil(srate * 12) + margin;          // 2 bars at 40 bpm, plus the margin
  buf_l = 0;
  buf_r = bsize;
  memset(buf_l, 0, 2 * bsize);
  n = 0;               // sample within the cycle
  old_rd = 0;          // read point of the previous cycle during the crossfade
  xc = xf;             // crossfade counter (xf = idle)
  g1 = 0; g2 = gl / 2; // grain clocks
  s1 = s2 = 0;         // grain start points in the buffer
  lp_l = lp_r = 0;

  function rd(buf, p) local(i, f, i2)
  (
    i = min(bsize - 1, floor(p));
    f = p - i;
    i2 = min(bsize - 1, i + 1);
    buf[i] + (buf[i2] - buf[i]) * f;
  );

  // start a new cycle at sample m, crossfading from where the old one would read now
  function seam(m)
  (
    old_rd = speed * n;
    xc = 0;
    n = m;
  );

  // ---- interface (half_speed_gfx only; never changes the output) ----
  // the display's waveform: the peak of each 1/128 of the captured Length, taken in @sample
  hs_ov = 2 * bsize;
  memset(hs_ov, 0, 128);
  hs_lb = -1;
  gfx_ext_retina = 1;

  function update()
  (
    len_beats = slider1 == 0 ? 1 : slider1 == 1 ? 2 : slider1 == 2 ? 4 : 8;
    speed = slider2 == 0 ? 0.5 : slider2 == 1 ? 0.25 : 2 / 3;
    cyc_beats = len_beats / speed;
    keep = slider3;
    hc_on = slider4 < 20000;
    hc_a = 1 - exp(-2 * $pi * slider4 / srate);
    mix = slider5 / 100;
    offset = slider6;
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 6;

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 2); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 20000); ng_slider_set(5, 100); ng_slider_set(6, 0); );
    p == 1 ? ( ng_slider_set(1, 2); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 14000); ng_slider_set(5, 100); ng_slider_set(6, 0); );
    p == 2 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 20000); ng_slider_set(5, 100); ng_slider_set(6, 0); );
    p == 3 ? ( ng_slider_set(1, 3); ng_slider_set(2, 1); ng_slider_set(3, 0); ng_slider_set(4, 6000); ng_slider_set(5, 100); ng_slider_set(6, 0); );
    p == 4 ? ( ng_slider_set(1, 2); ng_slider_set(2, 0); ng_slider_set(3, 1); ng_slider_set(4, 20000); ng_slider_set(5, 100); ng_slider_set(6, 0); );
    p == 5 ? ( ng_slider_set(1, 1); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 2000); ng_slider_set(5, 100); ng_slider_set(6, 0); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 20000) && ng_pre_eq(slider5, 100) && ng_pre_eq(slider6, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 14000) && ng_pre_eq(slider5, 100) && ng_pre_eq(slider6, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 20000) && ng_pre_eq(slider5, 100) && ng_pre_eq(slider6, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 3) && ng_pre_eq(slider2, 1) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 6000) && ng_pre_eq(slider5, 100) && ng_pre_eq(slider6, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, 20000) && ng_pre_eq(slider5, 100) && ng_pre_eq(slider6, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 2000) && ng_pre_eq(slider5, 100) && ng_pre_eq(slider6, 0) ? m = 5;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Halftime Bar";
    p == 2 ? s = "Halftime Beat";
    p == 3 ? s = "Quarter Speed Drone";
    p == 4 ? s = "Pitch-Kept Halftime";
    p == 5 ? s = "Dark Halftime";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@block
  bpm = tempo > 0 ? tempo : 120;
  bpm = min(300, max(40, bpm));
  spb = srate * 60 / bpm;
  ls = len_beats * spb;
  clen = cyc_beats * spb;
  wlim = min(bsize - 1, floor(ls) + margin);
  play_state & 1 ? (
    // lock the cycle to the song position; small drift is corrected, a jump starts a new cycle
    hs_pos = beat_position - offset;
    hs_within = hs_pos - cyc_beats * floor(hs_pos / cyc_beats);
    nt = floor(hs_within * spb + 0.5);
    d = nt - n;
    d > clen / 2 ? (d -= clen) : (d < -clen / 2 ? d += clen);
    abs(d) > 2 ? seam(nt) : (abs(nt - n) <= 2 ? n = nt);
  );

@sample
  n >= clen ? seam(0);
  n < wlim ? (
    buf_l[n] = spl0;
    buf_r[n] = spl1;
  );
  keep ? (
    // two Hann grains half a grain apart, each starting where the slowed read point is now
    g1 == 0 ? s1 = speed * n;
    g2 == 0 ? s2 = speed * n;
    w1 = 0.5 - 0.5 * cos(2 * $pi * g1 / gl);
    w2 = 0.5 - 0.5 * cos(2 * $pi * g2 / gl);
    wl = rd(buf_l, s1 + g1) * w1 + rd(buf_l, s2 + g2) * w2;
    wr = rd(buf_r, s1 + g1) * w1 + rd(buf_r, s2 + g2) * w2;
    g1 += 1;
    g1 >= gl ? g1 = 0;
    g2 += 1;
    g2 >= gl ? g2 = 0;
  ) : (
    rp = speed * n;
    wl = rd(buf_l, rp);
    wr = rd(buf_r, rp);
  );
  xc < xf ? (
    // the seam: the previous cycle keeps playing and fades out
    keep ? xc = xf : (
      xk = (xc + 1) / (xf + 1);
      wl = wl * xk + rd(buf_l, old_rd) * (1 - xk);
      wr = wr * xk + rd(buf_r, old_rd) * (1 - xk);
      old_rd += speed;
      xc += 1;
    );
  );
  hc_on ? (
    lp_l += hc_a * (wl - lp_l);
    lp_r += hc_a * (wr - lp_r);
    wl = lp_l;
    wr = lp_r;
  );
  spl0 = spl0 * (1 - mix) + wl * mix;
  spl1 = spl1 * (1 - mix) + wr * mix;
  n += 1;

  // display only: the peak of each 1/128 of the captured Length (never changes the output)
  hs_i = n - 1;
  hs_i < ls ? (
    hs_b = floor(hs_i * 128 / ls);
    hs_b != hs_lb ? (hs_ov[hs_b] = 0; hs_lb = hs_b;);
    hs_v = max(abs(buf_l[hs_i]), abs(buf_r[hs_i]));
    hs_v > hs_ov[hs_b] ? hs_ov[hs_b] = hs_v;
  );

@gfx 480 294
  ng_knobs_begin("HALF SPEED", "ADVANCED", 480, 120, 1, 0);

  // display: the captured Length as a waveform (dimmer where this cycle has not written yet),
  // the write head (solid) and the slowed read head (dashed); below, the cycle (Length / Speed)
  // with the part already played filled and a tick where the capture ends
  hs_ls = max(1, ls);
  hs_cl = max(1, clen);
  hs_w = min(n, hs_ls) / hs_ls;
  hs_r = min(1, speed * n / hs_ls);
  ng_font(4, 8, 0);
  ng_col(NG_MUTED, 1);
  strcpy(#hs_a, slider1 == 0 ? "1/4 NOTE" : slider1 == 1 ? "1/2 NOTE" : slider1 == 2 ? "1 BAR" : "2 BARS");
  sprintf(#hs_s, "CAPTURE %s", #hs_a);
  ng_txt(#hs_s, 30, 70, 0, 0);
  strcpy(#hs_a, slider2 == 0 ? "1/2 SPEED" : slider2 == 1 ? "1/4 SPEED" : "2/3 SPEED");
  strcpy(#hs_b, slider3 ? "  PITCH KEPT" : "");
  slider4 >= 20000 ? strcpy(#hs_c, "") : sprintf(#hs_c, "  TONE %.1f kHz", slider4 / 1000);
  slider6 > 0 ? sprintf(#hs_d, "  OFFSET %d", slider6) : strcpy(#hs_d, "");
  sprintf(#hs_s, "%s%s%s%s", #hs_a, #hs_b, #hs_c, #hs_d);
  ng_txt(#hs_s, 450, 70, 2, 0);
  // waveform
  ng_col(NG_BG, 1);
  gfx_rect(X(30), Y(78), 420 * ng_s, 50 * ng_s);
  hs_k = 0;
  loop(128,
    hs_h = max(0.5, min(1, hs_ov[hs_k]) * 24);
    ng_col(NG_ACCENT, (hs_k + 1) / 128 <= hs_w ? 0.6 : 0.25);
    gfx_rect(X(30 + hs_k * 420 / 128), Y(103 - hs_h), max(1, (420 / 128 - 1) * ng_s), 2 * hs_h * ng_s);
    hs_k += 1;
  );
  ng_col(NG_ACCENT, 1);
  gfx_rect(floor(X(30 + 420 * hs_w)), Y(78), max(1, ng_s), 50 * ng_s);
  ng_col(NG_TEXT, 0.8);
  hs_y = 78;
  while (hs_y < 128) (
    gfx_rect(floor(X(30 + 420 * hs_r)), Y(hs_y), max(1, ng_s), (min(hs_y + 3, 128) - hs_y) * ng_s);
    hs_y += 6;
  );
  // cycle
  ng_col(NG_BG, 1);
  gfx_rect(X(30), Y(136), 420 * ng_s, 6 * ng_s);
  ng_col(NG_ACCENT, 0.35);
  gfx_rect(X(30), Y(136), 420 * min(1, n / hs_cl) * ng_s, 6 * ng_s);
  ng_col(NG_MUTED, 1);
  gfx_rect(floor(X(30 + 420 * min(1, hs_ls / hs_cl))), Y(134), max(1, ng_s), 10 * ng_s);
  // legend
  ng_col(NG_ACCENT, 1);
  gfx_rect(X(30), Y(154), 10 * ng_s, 2 * ng_s);
  ng_col(NG_MUTED, 1);
  ng_txt("WRITE", 44, 155, 0, 0);
  ng_col(NG_TEXT, 0.8);
  gfx_rect(X(90), Y(154), 3 * ng_s, 2 * ng_s);
  gfx_rect(X(96), Y(154), 3 * ng_s, 2 * ng_s);
  ng_col(NG_MUTED, 1);
  ng_txt("READ", 104, 155, 0, 0);
  hs_cb = (slider1 == 0 ? 1 : slider1 == 1 ? 2 : slider1 == 2 ? 4 : 8) / (slider2 == 0 ? 0.5 : slider2 == 1 ? 0.25 : 2 / 3);
  hs_cb == floor(hs_cb) ? sprintf(#hs_s, "CYCLE %d BEATS", hs_cb) : sprintf(#hs_s, "CYCLE %.1f BEATS", hs_cb);
  ng_txt(#hs_s, 450, 155, 2, 0);

  ng_row(6);
  ng_select_ctl(1, "LENGTH", "1/4|1/2|1 BAR|2 BARS", 0) ? update();
  ng_select_ctl(2, "SPEED", "1/2|1/4|2/3", 0) ? update();
  ng_select_ctl(3, "PITCH KEEP", "OFF|ON", 0) ? update();
  slider4 >= 20000 ? strcpy(#v4, "OFF") : sprintf(#v4, "%.1f kHz", slider4 / 1000);
  ng_knob_ctl_log(4, "TONE", #v4, 1000, 20000, 20000, 1) ? update();
  sprintf(#v5, "%d%%", slider5);
  ng_knob_ctl(5, "MIX", #v5, 0, 100, 100, 1, 0) ? update();
  sprintf(#v6, "%d beats", slider6);
  ng_knob_ctl(6, "OFFSET", #v6, 0, 3, 0, 1, 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
