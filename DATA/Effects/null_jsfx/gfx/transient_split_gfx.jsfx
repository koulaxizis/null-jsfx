desc:NULL Transient Split GFX
author: Christos Koulaxizis
tags: transient tonal split attack sustain body tail drums separate routing parallel reverb saturation gui
//category: Advanced
//NULL JSFX v3.0 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:0<0,1,1{Balance,Split}>-Mode
slider2:0<-24,12,0.1>-Transient (dB)
slider3:0<-24,12,0.1>-Tonal (dB)
slider4:50<0,100,1>-Sensitivity (%)
slider5:60<5,500,1>-Decay (ms)
slider6:0<-24,12,0.1>-Output (dB)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right
out_pin:Tonal Left
out_pin:Tonal Right

@init
  ext_noinit = 1;              // play and seek keep the detector, as in the VST3/CLAP
  // NULL Transient Split (../transient_split.jsfx) with its own interface: same audio code, plus @gfx.
  // Splits the signal into its transient part (the attack of each hit) and its tonal part
  // (the body and the tail), with no frequency bands: a weight w between 0 and 1 says how much
  // of each sample is transient, and the two parts are x * w and x * (1 - w), so they always
  // add up to the input. The weight comes from two linked peak envelopes of the louder channel:
  // a fast one (1 ms attack) and a slow one (25 ms attack), both with a 100 ms release. At an
  // onset the fast one leads, and (fast - slow) / fast, scaled by Sensitivity, is the target
  // weight; the weight jumps up to it at once and falls back over Decay.
  // Balance: both parts, each with its own level, come out on channels 1/2 (Transient and
  // Tonal at 0 dB give back the input). Split: the transient part on channels 1/2 and the tonal
  // part on channels 3/4, for processing them apart in REAPER (a reverb only on the tail).
  ef = es = w = 0;
  // interface only: a 2.6 s history of the transient weight and the input peak, one entry per
  // 10 ms (260 entries, one per display pixel) in memory from 1000000, and the weight held 50 ms
  ts_buf = 1000000; ts_len = 260; ts_w = 0;
  ts_chunk = max(1, floor(srate / 100));
  ts_n = 0;
  memset(ts_buf, 0, ts_len * 2);
  ts_hw = ts_hk = 0;
  ts_in = 0; ts_wm = 0;
  ts_rel = exp(-1 / (0.3 * srate));
  ts_wrel = exp(-1 / (0.05 * srate));
  gfx_ext_retina = 1;

  function update()
  (
    split = slider1;
    gt = 10 ^ (slider2 / 20);
    gn = 10 ^ (slider3 / 20);
    sens = 0.5 + slider4 / 100 * 3.5;
    af = 1 - exp(-1 / (0.001 * srate));
    as = 1 - exp(-1 / (0.025 * srate));
    ar = 1 - exp(-1 / (0.1 * srate));
    cd = 1 - exp(-1 / (slider5 * 0.001 * srate));
    og = 10 ^ (slider6 / 20);
  );

  // history: input level as dim bars (-60..0 dB), the transient weight as the line (0..1)
  function ts_history() local(i, k, h)
  (
    ng_plot(56, 68, 260, 88);
    ng_grid(8, 4, 0);
    ng_font(4, 8, 0);
    ng_col(NG_MUTED, 1);
    ng_ptxt("T", ng_px - 6 * ng_s, ng_py, 2);
    ng_ptxt("0", ng_px - 6 * ng_s, ng_py + ng_ph, 2);
    ng_col(NG_ACCENT, 0.15);
    i = 0;
    loop(ts_len,
      k = (ts_w + i) % ts_len;
      h = ng_ph * ng_db_norm(ng_to_db(ts_buf[k * 2 + 1]), -60);
      h > 0 ? gfx_rect(ng_px + i * ng_s, ng_py + ng_ph - h, ng_s, h);
      i += 1;
    );
    ng_col(NG_ACCENT, 1);
    i = 0;
    loop(ts_len,
      k = (ts_w + i) % ts_len;
      i == 0 ? ng_line_start(ng_px + 0.5 * ng_s, ng_lin_y(ts_buf[k * 2], 0, 1))
             : ng_line_to(ng_px + (i + 0.5) * ng_s, ng_lin_y(ts_buf[k * 2], 0, 1));
      i += 1;
    );
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 9;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1); ng_hist_add(2); ng_hist_add(3); ng_hist_add(4); ng_hist_add(5); ng_hist_add(6);
  ng_hist_init();

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 50); ng_slider_set(5, 60); ng_slider_set(6, 0); );
    p == 1 ? ( ng_slider_set(1, 0); ng_slider_set(2, 6); ng_slider_set(3, 0); ng_slider_set(4, 50); ng_slider_set(5, 60); ng_slider_set(6, 0); );
    p == 2 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, -6); ng_slider_set(4, 50); ng_slider_set(5, 120); ng_slider_set(6, 0); );
    p == 3 ? ( ng_slider_set(1, 0); ng_slider_set(2, 4); ng_slider_set(3, -2); ng_slider_set(4, 70); ng_slider_set(5, 40); ng_slider_set(6, 0); );
    p == 4 ? ( ng_slider_set(1, 0); ng_slider_set(2, -8); ng_slider_set(3, 0); ng_slider_set(4, 60); ng_slider_set(5, 60); ng_slider_set(6, 0); );
    p == 5 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, -24); ng_slider_set(4, 80); ng_slider_set(5, 30); ng_slider_set(6, 0); );
    p == 6 ? ( ng_slider_set(1, 0); ng_slider_set(2, -24); ng_slider_set(3, 0); ng_slider_set(4, 80); ng_slider_set(5, 80); ng_slider_set(6, 0); );
    p == 7 ? ( ng_slider_set(1, 1); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 50); ng_slider_set(5, 80); ng_slider_set(6, 0); );
    p == 8 ? ( ng_slider_set(1, 1); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 75); ng_slider_set(5, 25); ng_slider_set(6, 0); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 50) && ng_pre_eq(slider5, 60) && ng_pre_eq(slider6, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 6) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 50) && ng_pre_eq(slider5, 60) && ng_pre_eq(slider6, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, -6) && ng_pre_eq(slider4, 50) && ng_pre_eq(slider5, 120) && ng_pre_eq(slider6, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 4) && ng_pre_eq(slider3, -2) && ng_pre_eq(slider4, 70) && ng_pre_eq(slider5, 40) && ng_pre_eq(slider6, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, -8) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 60) && ng_pre_eq(slider5, 60) && ng_pre_eq(slider6, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, -24) && ng_pre_eq(slider4, 80) && ng_pre_eq(slider5, 30) && ng_pre_eq(slider6, 0) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, -24) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 80) && ng_pre_eq(slider5, 80) && ng_pre_eq(slider6, 0) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 50) && ng_pre_eq(slider5, 80) && ng_pre_eq(slider6, 0) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 75) && ng_pre_eq(slider5, 25) && ng_pre_eq(slider6, 0) ? m = 8;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "More Attack";
    p == 2 ? s = "Less Room";
    p == 3 ? s = "Snappy Drums";
    p == 4 ? s = "Soft Hits";
    p == 5 ? s = "Only Transients";
    p == 6 ? s = "Only Body";
    p == 7 ? s = "Split For Reverb";
    p == 8 ? s = "Split Tight";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  k = max(abs(spl0), abs(spl1));
  ef += (k - ef) * (k > ef ? af : ar);
  es += (k - es) * (k > es ? as : ar);
  tw = ef > 0.00001 ? min(1, max(0, (ef - es) / ef * sens)) : 0;
  tw > w ? w = tw : w += (tw - w) * cd;
  w < 0.000000001 ? w = 0;
  tl = spl0 * w;
  tr = spl1 * w;
  nl = spl0 - tl;
  nr = spl1 - tr;
  split ? (
    spl0 = tl * gt * og;
    spl1 = tr * gt * og;
    spl2 = nl * gn * og;
    spl3 = nr * gn * og;
  ) : (
    spl0 = (tl * gt + nl * gn) * og;
    spl1 = (tr * gt + nr * gn) * og;
    spl2 = 0;
    spl3 = 0;
  );

  // interface only: meters and history (read the audio state, never change it)
  ts_in = k > ts_in ? k : ts_in * ts_rel;
  ts_wm = w > ts_wm ? w : ts_wm * ts_wrel;
  ts_hw = max(ts_hw, w);
  ts_hk = max(ts_hk, k);
  ts_n += 1;
  ts_n >= ts_chunk ? (
    ts_buf[ts_w * 2] = ts_hw;
    ts_buf[ts_w * 2 + 1] = ts_hk;
    ts_w = (ts_w + 1) % ts_len;
    ts_hw = ts_hk = 0;
    ts_n = 0;
  );

@gfx 480 294
  ng_knobs_begin("TRANSIENT SPLIT", "ADVANCED", 480, 120, 1, 0);

  // display, left: the last 2.6 s of input level (bars) and transient weight (line); right: the
  // input meter, the weight now and where the two parts go
  ts_history();
  ng_meter(336, 82, 112, 10, "IN", ng_to_db(ts_in), -140, -60);
  ng_meter(336, 106, 112, 10, "TR", -60 + 60 * min(1, max(0, ts_wm)), -140, -60);
  ng_font(1, 7, 1);
  ng_col(NG_ACCENT, 1);
  ng_txt(split ? "SPLIT  1/2 T  3/4 N" : "BALANCE  1/2", 336, 135, 0, 1);

  ng_row(6);
  ng_select_ctl(1, "MODE", "BALANCE|SPLIT", 0) ? update();
  sprintf(#ts_v2, "%+.1f dB", slider2);
  ng_knob_ctl(2, "TRANSIENT", #ts_v2, -24, 12, 0, 0.1, 1) ? update();
  sprintf(#ts_v3, "%+.1f dB", slider3);
  ng_knob_ctl(3, "TONAL", #ts_v3, -24, 12, 0, 0.1, 1) ? update();
  sprintf(#ts_v4, "%d%%", slider4);
  ng_knob_ctl(4, "SENSITIVITY", #ts_v4, 0, 100, 50, 1, 0) ? update();
  sprintf(#ts_v5, "%d ms", slider5);
  ng_knob_ctl(5, "DECAY", #ts_v5, 5, 500, 60, 1, 0) ? update();
  sprintf(#ts_v6, "%+.1f dB", slider6);
  ng_knob_ctl(6, "OUTPUT", #ts_v6, -24, 12, 0, 0.1, 1) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
