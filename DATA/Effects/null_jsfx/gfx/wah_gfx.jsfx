desc:NULL Wah GFX
author: Christos Koulaxizis
tags: wah wah-wah pedal auto-wah envelope filter lfo funk guitar quack vocal formant band-pass sweep tempo sync gui
//category: Essentials
//NULL JSFX v2.5 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:50<0,100,1>-Pedal (%)
slider2:0<0,2,1{Manual,Auto,LFO}>-Mode
slider3:0<0,2,1{Classic,Vocal,Wide}>-Model
slider4:60<0,100,1>-Resonance (%)
slider5:50<0,100,1>-Sensitivity (%)
slider6:10<1,100,1>-Attack (ms)
slider7:150<20,1000,1>-Release (ms)
slider8:2<0.1,10,0.1>-Rate (Hz)
slider9:0<0,5,1{Off,1/1,1/2,1/4,1/8,1/16}>-Tempo Sync
slider10:100<0,100,1>-Mix (%)
slider11:0<-12,12,0.1>-Output (dB)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  // NULL Wah (../wah.jsfx) with its own interface: same audio code, plus @gfx.
  // A wah pedal: a resonant band-pass (TPT state-variable filter, normalised to 0 dB at its
  // peak, then lifted by the resonance) swept by the pedal on an exponential curve.
  // Classic: 400 Hz to 2.2 kHz, high Q. Vocal: two formant peaks (300-800 Hz and 900 Hz-2.4 kHz)
  // that move together like a vowel. Wide: 200 Hz to 3.5 kHz, broader.
  // Mode Manual: the Pedal slider (smoothed over 15 ms, for automation or a MIDI CC).
  // Auto: an envelope follower moves the pedal; at Sensitivity 0% the toe is reached at 0 dBFS,
  // at 100% at -42 dBFS, over a 30 dB range. LFO: a raised cosine at Rate, or one cycle per
  // note at the host tempo, locked to the beat position while the transport plays.
  // In Auto and LFO the Pedal slider is not used.
  ps = 0.5;
  ps_first = 1;
  env = 0;
  lfo_p = 0;
  fa_l.ic1 = fa_l.ic2 = fa_r.ic1 = fa_r.ic2 = 0;
  fb_l.ic1 = fb_l.ic2 = fb_r.ic1 = fb_r.ic2 = 0;
  ps_c = 1 - exp(-1 / (0.015 * srate));

  // TPT state-variable band-pass: returns the band-pass output v1 for coefficients
  // (a1, a2, a3) of the filter set g
  function wh_bp(x, a1, a2, a3) local(v1, v2, v3)
  (
    v3 = x - this.ic2;
    v1 = a1 * this.ic1 + a2 * v3;
    v2 = this.ic2 + a2 * this.ic1 + a3 * v3;
    this.ic1 = 2 * v1 - this.ic1;
    this.ic2 = 2 * v2 - this.ic2;
    v1;
  );

  function update()
  (
    pedal = slider1 / 100;
    mode = floor(slider2 + 0.5);
    model = floor(slider3 + 0.5);
    res = slider4 / 100;
    // Auto: the level (dBFS) that puts the pedal at the toe
    top_db = -slider5 / 100 * 42;
    att_c = 1 - exp(-1 / (slider6 * 0.001 * srate));
    rel_c = 1 - exp(-1 / (slider7 * 0.001 * srate));
    rate = slider8;
    sync = floor(slider9 + 0.5);
    // beats per LFO cycle: 1/1 = 4, 1/2 = 2, 1/4 = 1, 1/8 = 0.5, 1/16 = 0.25
    bpc = sync == 1 ? 4 : sync == 2 ? 2 : sync == 3 ? 1 : sync == 4 ? 0.5 : 0.25;
    mix = slider10 / 100;
    out_g = 10 ^ (slider11 / 20);
    // filter Q and peak lift by model
    q1 = model == 0 ? 2 + res * 8 : model == 1 ? 3 + res * 7 : 1.2 + res * 5;
    q2 = q1 * 1.3;
    k1 = 1 / q1;
    k2 = 1 / q2;
    pk = 1.5 + 1.5 * res;
  );

  gfx_ext_retina = 1;

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 7;

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 50); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 60); ng_slider_set(5, 50); ng_slider_set(6, 10); ng_slider_set(7, 150); ng_slider_set(8, 2); ng_slider_set(9, 0); ng_slider_set(10, 100); ng_slider_set(11, 0); );
    p == 1 ? ( ng_slider_set(1, 50); ng_slider_set(2, 1); ng_slider_set(3, 0); ng_slider_set(4, 70); ng_slider_set(5, 60); ng_slider_set(6, 4); ng_slider_set(7, 90); ng_slider_set(8, 2); ng_slider_set(9, 0); ng_slider_set(10, 100); ng_slider_set(11, 0); );
    p == 2 ? ( ng_slider_set(1, 50); ng_slider_set(2, 1); ng_slider_set(3, 0); ng_slider_set(4, 85); ng_slider_set(5, 75); ng_slider_set(6, 2); ng_slider_set(7, 60); ng_slider_set(8, 2); ng_slider_set(9, 0); ng_slider_set(10, 100); ng_slider_set(11, 1.5); );
    p == 3 ? ( ng_slider_set(1, 50); ng_slider_set(2, 2); ng_slider_set(3, 0); ng_slider_set(4, 65); ng_slider_set(5, 50); ng_slider_set(6, 10); ng_slider_set(7, 150); ng_slider_set(8, 2); ng_slider_set(9, 4); ng_slider_set(10, 100); ng_slider_set(11, 0); );
    p == 4 ? ( ng_slider_set(1, 50); ng_slider_set(2, 1); ng_slider_set(3, 1); ng_slider_set(4, 70); ng_slider_set(5, 55); ng_slider_set(6, 15); ng_slider_set(7, 200); ng_slider_set(8, 2); ng_slider_set(9, 0); ng_slider_set(10, 100); ng_slider_set(11, 0); );
    p == 5 ? ( ng_slider_set(1, 50); ng_slider_set(2, 2); ng_slider_set(3, 2); ng_slider_set(4, 55); ng_slider_set(5, 50); ng_slider_set(6, 10); ng_slider_set(7, 150); ng_slider_set(8, 0.2); ng_slider_set(9, 0); ng_slider_set(10, 85); ng_slider_set(11, 0); );
    p == 6 ? ( ng_slider_set(1, 42); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 75); ng_slider_set(5, 50); ng_slider_set(6, 10); ng_slider_set(7, 150); ng_slider_set(8, 2); ng_slider_set(9, 0); ng_slider_set(10, 100); ng_slider_set(11, 2); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 50) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 60) && ng_pre_eq(slider5, 50) && ng_pre_eq(slider6, 10) && ng_pre_eq(slider7, 150) && ng_pre_eq(slider8, 2) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 100) && ng_pre_eq(slider11, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 50) && ng_pre_eq(slider2, 1) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 70) && ng_pre_eq(slider5, 60) && ng_pre_eq(slider6, 4) && ng_pre_eq(slider7, 90) && ng_pre_eq(slider8, 2) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 100) && ng_pre_eq(slider11, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 50) && ng_pre_eq(slider2, 1) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 85) && ng_pre_eq(slider5, 75) && ng_pre_eq(slider6, 2) && ng_pre_eq(slider7, 60) && ng_pre_eq(slider8, 2) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 100) && ng_pre_eq(slider11, 1.5) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 50) && ng_pre_eq(slider2, 2) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 65) && ng_pre_eq(slider5, 50) && ng_pre_eq(slider6, 10) && ng_pre_eq(slider7, 150) && ng_pre_eq(slider8, 2) && ng_pre_eq(slider9, 4) && ng_pre_eq(slider10, 100) && ng_pre_eq(slider11, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 50) && ng_pre_eq(slider2, 1) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, 70) && ng_pre_eq(slider5, 55) && ng_pre_eq(slider6, 15) && ng_pre_eq(slider7, 200) && ng_pre_eq(slider8, 2) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 100) && ng_pre_eq(slider11, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 50) && ng_pre_eq(slider2, 2) && ng_pre_eq(slider3, 2) && ng_pre_eq(slider4, 55) && ng_pre_eq(slider5, 50) && ng_pre_eq(slider6, 10) && ng_pre_eq(slider7, 150) && ng_pre_eq(slider8, 0.2) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 85) && ng_pre_eq(slider11, 0) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 42) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 75) && ng_pre_eq(slider5, 50) && ng_pre_eq(slider6, 10) && ng_pre_eq(slider7, 150) && ng_pre_eq(slider8, 2) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 100) && ng_pre_eq(slider11, 2) ? m = 6;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Funk Rhythm";
    p == 2 ? s = "Auto Quack";
    p == 3 ? s = "Synced Wah";
    p == 4 ? s = "Vocal Talk";
    p == 5 ? s = "Slow Sweep";
    p == 6 ? s = "Half-Cocked";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@block
  // the first block sets the pedal without a glide
  ps_first ? ( ps = pedal; ps_first = 0; );
  bpm = tempo > 0 ? tempo : 120;
  sync > 0 ? (
    lfo_i = bpm / 60 / bpc / srate;
    // lock to the host grid while playing
    play_state & 1 ? lfo_p = beat_position / bpc - floor(beat_position / bpc);
  ) : (
    lfo_i = rate / srate;
  );

@sample
  // the pedal position
  mode == 0 ? (
    ps += ps_c * (pedal - ps);
  ) : mode == 1 ? (
    ex = max(abs(spl0), abs(spl1));
    env += (ex > env ? att_c : rel_c) * (ex - env);
    edb = env > 0.000000001 ? 20 * log10(env) : -180;
    ps = min(1, max(0, (edb - top_db + 30) / 30));
  ) : (
    lfo_p += lfo_i;
    lfo_p >= 1 ? lfo_p -= 1;
    ps = 0.5 - 0.5 * cos(2 * $pi * lfo_p);
  );

  // the filter(s) at that position
  f1 = model == 0 ? 400 * 5.5 ^ ps : model == 1 ? 300 * (800 / 300) ^ ps : 200 * 17.5 ^ ps;
  g = tan($pi * f1 / srate);
  c1 = 1 / (1 + g * (g + k1));
  c2 = g * c1;
  c3 = g * c2;
  w_l = fa_l.wh_bp(spl0, c1, c2, c3) * k1;
  w_r = fa_r.wh_bp(spl1, c1, c2, c3) * k1;
  model == 1 ? (
    f2 = 900 * (2400 / 900) ^ ps;
    g = tan($pi * f2 / srate);
    c1 = 1 / (1 + g * (g + k2));
    c2 = g * c1;
    c3 = g * c2;
    w_l += fb_l.wh_bp(spl0, c1, c2, c3) * k2 * 0.7;
    w_r += fb_r.wh_bp(spl1, c1, c2, c3) * k2 * 0.7;
  );

  spl0 = (spl0 * (1 - mix) + w_l * pk * mix) * out_g;
  spl1 = (spl1 * (1 - mix) + w_r * pk * mix) * out_g;

@gfx 480 380
  ng_knobs_begin("WAH", "ESSENTIALS", 480, 120, 2, 0);

  // display: the response at the live pedal position (the dashed line at the peak, two in
  // Vocal), and on the right the pedal itself (heel at the bottom, toe at the top)
  function wg_db(f, p) local(t, re, im, b, fc, k, w, a, d, c, mag)
  (
    t = tan($pi * min(f, 0.49 * srate) / srate);
    re = im = 0;
    b = 0;
    loop(model == 1 ? 2 : 1,
      fc = b == 0 ? (model == 0 ? 400 * 5.5 ^ p : model == 1 ? 300 * (800 / 300) ^ p : 200 * 17.5 ^ p) : 900 * (2400 / 900) ^ p;
      k = b == 0 ? k1 : k2;
      w = t / tan($pi * fc / srate);
      a = 1 - w * w;
      d = a * a + k * k * w * w;
      c = b == 0 ? 1 : 0.7;
      re += c * k * k * w * w / d;
      im += c * k * w * a / d;
      b += 1;
    );
    re = (1 - mix) + mix * pk * re;
    im = mix * pk * im;
    mag = sqrt(re * re + im * im) * out_g;
    mag > 0.0000001 ? 20 * log10(mag) : -140;
  );
  wg_p = max(0, min(1, ps));
  wg_f1 = model == 0 ? 400 * 5.5 ^ wg_p : model == 1 ? 300 * (800 / 300) ^ wg_p : 200 * 17.5 ^ wg_p;
  ng_plot(ng_vx + 26, ng_vy + 4, ng_vw - 86, ng_vh - 20);
  ng_grid_freq(36);
  function wg_dash(f) local(xx, yy)
  (
    xx = floor(ng_freq_x(f)) + 0.5;
    ng_col(NG_ACCENT, 0.5);
    yy = ng_py;
    while (
      gfx_line(xx, yy, xx, min(yy + 3 * ng_s, ng_py + ng_ph), 0);
      yy += 6 * ng_s;
      yy < ng_py + ng_ph;
    );
  );
  wg_dash(wg_f1);
  model == 1 ? wg_dash(900 * (2400 / 900) ^ wg_p);
  wg_zy = ng_lin_y(0, -24, 24);
  ng_col(NG_ACCENT, 0.10);
  wg_i = 0;
  loop(floor(ng_pw) + 1,
    gfx_line(ng_px + wg_i, wg_zy, ng_px + wg_i, ng_lin_y(wg_db(20 * 1000 ^ (wg_i / ng_pw), wg_p), -24, 24), 0);
    wg_i += 1;
  );
  ng_col(NG_ACCENT, 1);
  wg_i = 0;
  loop(floor(ng_pw) + 1,
    wg_y = ng_lin_y(wg_db(20 * 1000 ^ (wg_i / ng_pw), wg_p), -24, 24);
    wg_i == 0 ? ng_line_start(ng_px, wg_y) : ng_line_to(ng_px + wg_i, wg_y);
    wg_i += 1;
  );
  ng_font(4, 8, 0);
  ng_col(NG_MUTED, 1);
  strcpy(#wg_a, mode == 0 ? "MANUAL" : mode == 1 ? "AUTO" : "LFO");
  strcpy(#wg_b, model == 0 ? "CLASSIC" : model == 1 ? "VOCAL" : "WIDE");
  sprintf(#wg_s, "%s  %s", #wg_a, #wg_b);
  ng_ptxt(#wg_s, ng_px + ng_pw - 6 * ng_s, ng_py + 9 * ng_s, 2);

  // the pedal
  ng_font(1, 7, 1);
  ng_col(NG_MUTED, 1);
  ng_txt("PEDAL", 430, 69, 1, 1);
  wg_tx = floor(X(425)); wg_ty = floor(Y(77)); wg_tw = floor(10 * ng_s); wg_th = floor(58 * ng_s);
  ng_col(NG_BG, 1);
  gfx_roundrect(wg_tx, wg_ty, wg_tw, wg_th, 3 * ng_s, 1);
  gfx_rect(wg_tx + 1, wg_ty + 1, wg_tw - 1, wg_th - 1);
  ng_col(NG_ACCENT, 1);
  wg_fh = floor(wg_th * wg_p);
  wg_fh > 0 ? gfx_rect(wg_tx + 1, wg_ty + wg_th - wg_fh, wg_tw - 1, wg_fh);
  ng_col(NG_BORDER, 1);
  gfx_roundrect(wg_tx, wg_ty, wg_tw, wg_th, 3 * ng_s, 1);
  ng_font(3, 8.5, 0);
  ng_col(NG_TEXT, 1);
  sprintf(#wg_s, "%d%%", floor(wg_p * 100 + 0.5));
  ng_txt(#wg_s, 430, 146, 1, 0);
  ng_font(4, 8, 0);
  ng_col(NG_MUTED, 1);
  wg_f = floor(wg_f1 + 0.5);
  wg_f >= 1000 ? sprintf(#wg_s, "%.2fk", wg_f / 1000) : sprintf(#wg_s, "%d", wg_f);
  ng_txt(#wg_s, 430, 158, 1, 0);

  ng_row(6);
  sprintf(#v1, "%d%%", slider1);
  ng_knob_ctl(1, "PEDAL", #v1, 0, 100, 50, 1, 0) ? update();
  ng_select_ctl(2, "MODE", "MANUAL|AUTO|LFO", 0) ? update();
  ng_select_ctl(3, "MODEL", "CLASSIC|VOCAL|WIDE", 0) ? update();
  sprintf(#v4, "%d%%", slider4);
  ng_knob_ctl(4, "RESONANCE", #v4, 0, 100, 60, 1, 0) ? update();
  sprintf(#v10, "%d%%", slider10);
  ng_knob_ctl(10, "MIX", #v10, 0, 100, 100, 1, 0) ? update();
  slider11 > 0 ? sprintf(#v11, "+%.1f dB", slider11) : sprintf(#v11, "%.1f dB", slider11);
  ng_knob_ctl(11, "OUTPUT", #v11, -12, 12, 0, 0.1, 1) ? update();
  ng_row(5);
  sprintf(#v5, "%d%%", slider5);
  ng_knob_ctl(5, "SENSITIVITY", #v5, 0, 100, 50, 1, 0) ? update();
  sprintf(#v6, "%d ms", slider6);
  ng_knob_ctl(6, "ATTACK", #v6, 1, 100, 10, 1, 0) ? update();
  sprintf(#v7, "%d ms", slider7);
  ng_knob_ctl(7, "RELEASE", #v7, 20, 1000, 150, 1, 0) ? update();
  slider9 > 0 ? strcpy(#v8, slider9 == 1 ? "1/1" : slider9 == 2 ? "1/2" : slider9 == 3 ? "1/4" : slider9 == 4 ? "1/8" : "1/16")
              : sprintf(#v8, "%.1f Hz", slider8);
  ng_knob_ctl(8, "RATE", #v8, 0.1, 10, 2, 0.1, 0) ? update();
  ng_select_ctl(9, "SYNC", "OFF|1/1|1/2|1/4|1/8|1/16", 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
