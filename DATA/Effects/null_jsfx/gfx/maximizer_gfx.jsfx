desc:NULL Maximizer GFX
author: Christos Koulaxizis
tags: limiter maximizing loudness ceiling mastering peak protection dither gui
//category: Essentials
//NULL JSFX v2.4 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:0<-12,12,0.1>-Input Gain (dB)
slider2:-0.3<-3,-0.1,0.1>-Ceiling (dB)
slider3:50<10,200,1>-Release (ms)
slider4:2<0,5,1>-Lookahead (ms)
slider5:0<-12,0,0.1>-Output Gain (dB)
slider6:1<0,1,1{OFF,ON}>-Stereo Link
slider7:0<0,2,1{OFF,16-BIT,24-BIT}>-Dither
slider8:0<0,1,1{OFF,ON}>-Noise Shaping

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  // NULL Maximizer (../maximizer.jsfx) with its own interface: same audio code, plus @gfx.
  // Loudness maximizer: Input Gain pushes the mix into a look-ahead limiter that
  // holds the peaks at Ceiling. Stereo Link uses one gain for both channels so the
  // image does not shift; OFF limits each channel on its own. Dither, last in the chain,
  // quantises to 16 or 24 bits with TPDF noise, optionally noise-shaped.
  max_look = ceil(srate * 0.006) + 2;
  buf_l = 0;
  buf_r = buf_l + max_look;
  memset(buf_l, 0, 2 * max_look);
  freembuf(buf_r + max_look);
  wpos = 0;
  hv_l = hv_r = 0;
  hc_l = hc_r = 0;
  g_l = g_r = 1;
  seed = 12345;
  dt_el = dt_er = 0;
  pdc_bot_ch = 0;
  pdc_top_ch = 2;

  function detect(peak, hv*, hc*, g*) local(target)
  (
    peak >= hv ? (
      hv = peak;
      hc = look;
    ) : hc > 0 ? (
      hc -= 1;
    ) : (
      hv = max(peak, hv * rel);
    );
    target = hv > ceiling ? ceiling / hv : 1;
    g = target < g ? g + (target - g) * att : target + (g - target) * rel;
  );
  gfx_ext_retina = 1;

  // interface only: a 1.8 s history of the output level and the gain, one entry per
  // 7 ms (260 entries, one per display pixel) in memory from 4000000, and peak meters
  mx_buf = 4000000; mx_len = 260; mx_w = 0;
  mx_chunk = max(1, floor(srate * 0.007));
  mx_n = 0; mx_hl = 0; mx_hgh = 0; mx_hgl = 1000;
  mx_i = 0;
  loop(mx_len, mx_buf[mx_i * 2] = 0; mx_buf[mx_i * 2 + 1] = 1; mx_i += 1;);
  mx_rel = exp(-1 / (0.3 * srate));
  mx_in = mx_out = 0;

  function update()
  (
    in_gain = 10 ^ (slider1 / 20);
    ceiling = 10 ^ (slider2 / 20);
    rel = exp(-1 / (slider3 * srate / 1000));
    look = floor(slider4 * srate / 1000 + 0.5);
    pdc_delay = look;
    att = look < 1 ? 1 : 1 - exp(-5 / look);
    // Output Gain is a trim (cut only), applied after the ceiling clamp, so the
    // output can never exceed Ceiling; use Input Gain to make it louder.
    out_gain = 10 ^ (min(slider5, 0) / 20);
    link = slider6;
    dith = slider7;
    dt_q = slider7 == 1 ? 32768 : 8388608;
    nshape = slider8;
  );

  // history: output level as dim bars (-48..0 dB), the gain as the line (-24..0 dB)
  function mx_history() local(i, k, xx, yy, h)
  (
    ng_plot(56, 68, 260, 88);
    ng_grid(8, 4, 0);
    ng_font(4, 8, 0);
    ng_col(NG_MUTED, 1);
    i = 0;
    loop(5,
      0 - 6 * i > 0 ? sprintf(#mx_l, "+%d", 0 - 6 * i) : sprintf(#mx_l, "%d", 0 - 6 * i);
      ng_ptxt(#mx_l, ng_px - 6 * ng_s, ng_py + ng_ph * i / 4, 2);
      i += 1;
    );
    ng_col(NG_ACCENT, 0.15);
    i = 0;
    loop(mx_len,
      k = (mx_w + i) % mx_len;
      h = ng_ph * ng_db_norm(ng_to_db(mx_buf[k * 2]), -48);
      h > 0 ? gfx_rect(ng_px + i * ng_s, ng_py + ng_ph - h, ng_s, h);
      i += 1;
    );
    ng_col(NG_ACCENT, 1);
    i = 0;
    loop(mx_len,
      k = (mx_w + i) % mx_len;
      xx = ng_px + (i + 0.5) * ng_s;
      yy = ng_lin_y(ng_to_db(mx_buf[k * 2 + 1]), -24, 0);
      i == 0 ? ng_line_start(xx, yy) : ng_line_to(xx, yy);
      i += 1;
    );
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 9;

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 0); ng_slider_set(2, -0.3); ng_slider_set(3, 50); ng_slider_set(4, 2); ng_slider_set(5, 0); ng_slider_set(6, 1); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 1 ? ( ng_slider_set(1, 3); ng_slider_set(2, -1); ng_slider_set(3, 100); ng_slider_set(4, 5); ng_slider_set(5, 0); ng_slider_set(6, 1); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 2 ? ( ng_slider_set(1, 6); ng_slider_set(2, -1); ng_slider_set(3, 60); ng_slider_set(4, 5); ng_slider_set(5, 0); ng_slider_set(6, 1); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 3 ? ( ng_slider_set(1, 7); ng_slider_set(2, -0.5); ng_slider_set(3, 30); ng_slider_set(4, 2); ng_slider_set(5, 0); ng_slider_set(6, 1); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 4 ? ( ng_slider_set(1, 2); ng_slider_set(2, -1); ng_slider_set(3, 200); ng_slider_set(4, 5); ng_slider_set(5, 0); ng_slider_set(6, 1); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 5 ? ( ng_slider_set(1, 0); ng_slider_set(2, -1); ng_slider_set(3, 80); ng_slider_set(4, 3); ng_slider_set(5, 0); ng_slider_set(6, 1); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 6 ? ( ng_slider_set(1, 4); ng_slider_set(2, -0.3); ng_slider_set(3, 50); ng_slider_set(4, 2); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 7 ? ( ng_slider_set(1, 4); ng_slider_set(2, -0.3); ng_slider_set(3, 80); ng_slider_set(4, 5); ng_slider_set(5, 0); ng_slider_set(6, 1); ng_slider_set(7, 1); ng_slider_set(8, 1); );
    p == 8 ? ( ng_slider_set(1, 3); ng_slider_set(2, -1); ng_slider_set(3, 80); ng_slider_set(4, 5); ng_slider_set(5, 0); ng_slider_set(6, 1); ng_slider_set(7, 2); ng_slider_set(8, 0); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, -0.3) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 2) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 1) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 3) && ng_pre_eq(slider2, -1) && ng_pre_eq(slider3, 100) && ng_pre_eq(slider4, 5) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 1) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 6) && ng_pre_eq(slider2, -1) && ng_pre_eq(slider3, 60) && ng_pre_eq(slider4, 5) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 1) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 7) && ng_pre_eq(slider2, -0.5) && ng_pre_eq(slider3, 30) && ng_pre_eq(slider4, 2) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 1) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, -1) && ng_pre_eq(slider3, 200) && ng_pre_eq(slider4, 5) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 1) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, -1) && ng_pre_eq(slider3, 80) && ng_pre_eq(slider4, 3) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 1) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 4) && ng_pre_eq(slider2, -0.3) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 2) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 4) && ng_pre_eq(slider2, -0.3) && ng_pre_eq(slider3, 80) && ng_pre_eq(slider4, 5) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 1) && ng_pre_eq(slider7, 1) && ng_pre_eq(slider8, 1) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 3) && ng_pre_eq(slider2, -1) && ng_pre_eq(slider3, 80) && ng_pre_eq(slider4, 5) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 1) && ng_pre_eq(slider7, 2) && ng_pre_eq(slider8, 0) ? m = 8;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Transparent Master";
    p == 2 ? s = "Loud Master";
    p == 3 ? s = "Punchy Dance Master";
    p == 4 ? s = "Acoustic Gentle";
    p == 5 ? s = "Bus Peak Control";
    p == 6 ? s = "Stem Level Up";
    p == 7 ? s = "CD Master 16 Bit";
    p == 8 ? s = "Bounce 24 Bit";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  mx_x = max(abs(spl0), abs(spl1)); // interface only
  in_l = spl0 * in_gain;
  in_r = spl1 * in_gain;
  link ? (
    detect(max(abs(in_l), abs(in_r)), hv_l, hc_l, g_l);
    g_r = g_l;
  ) : (
    detect(abs(in_l), hv_l, hc_l, g_l);
    detect(abs(in_r), hv_r, hc_r, g_r);
  );

  buf_l[wpos] = in_l;
  buf_r[wpos] = in_r;
  rpos = wpos - look;
  rpos < 0 ? rpos += max_look;
  wpos += 1;
  wpos >= max_look ? wpos = 0;

  spl0 = max(-ceiling, min(ceiling, buf_l[rpos] * g_l)) * out_gain;
  spl1 = max(-ceiling, min(ceiling, buf_r[rpos] * g_r)) * out_gain;

  dith ? (
    // TPDF dither: half the sum of two uniform values in -1..1 (exact Park-Miller steps, as in
    // riser.jsfx) is triangular noise of +-1 LSB, added before rounding to the bit depth.
    // Noise Shaping subtracts the last error first (first order, 1 - z^-1): the noise moves
    // up the spectrum, away from where the ear is most sensitive.
    seed *= 16807; seed -= floor(seed / 2147483647) * 2147483647; dt_n1 = seed / 1073741824 - 1;
    seed *= 16807; seed -= floor(seed / 2147483647) * 2147483647; dt_n2 = seed / 1073741824 - 1;
    dt_v = nshape ? spl0 - dt_el : spl0;
    spl0 = floor(dt_v * dt_q + (dt_n1 + dt_n2) * 0.5 + 0.5) / dt_q;
    dt_el = nshape ? spl0 - dt_v : 0;
    seed *= 16807; seed -= floor(seed / 2147483647) * 2147483647; dt_n1 = seed / 1073741824 - 1;
    seed *= 16807; seed -= floor(seed / 2147483647) * 2147483647; dt_n2 = seed / 1073741824 - 1;
    dt_v = nshape ? spl1 - dt_er : spl1;
    spl1 = floor(dt_v * dt_q + (dt_n1 + dt_n2) * 0.5 + 0.5) / dt_q;
    dt_er = nshape ? spl1 - dt_v : 0;
  );

  // interface only: meters and history (read the audio state, never change it)
  mx_in = mx_x > mx_in ? mx_x : mx_in * mx_rel;
  mx_lv = max(abs(spl0), abs(spl1));
  mx_out = mx_lv > mx_out ? mx_lv : mx_out * mx_rel;
  mx_g = min(g_l, g_r);
  mx_hl = max(mx_hl, mx_lv);
  mx_hgh = max(mx_hgh, mx_g);
  mx_hgl = min(mx_hgl, mx_g);
  (mx_n += 1) >= mx_chunk ? (
    mx_buf[mx_w * 2] = mx_hl;
    mx_buf[mx_w * 2 + 1] = mx_hgh * mx_hgl > 1 ? mx_hgh : mx_hgl;
    mx_w = (mx_w + 1) % mx_len;
    mx_n = 0; mx_hl = 0; mx_hgh = 0; mx_hgl = 1000;
  );

@gfx 480 380
  ng_knobs_begin("MAXIMIZER", "ESSENTIALS", 480, 120, 2, 0);

  // display, left: the last 1.8 s of output level (bars) and gain (line, the lower channel
  // when unlinked); right: input (limiting point marked), gain-reduction and output (the
  // final ceiling marked) meters
  mx_history();
  ng_meter(336, 82, 112, 10, "IN", ng_to_db(mx_in), slider2 - slider1, -48);
  ng_gr_meter(336, 106, 112, 10, "GR", -20 * log10(max(mx_g, 0.0000001)), 24);
  ng_meter(336, 130, 112, 10, "OUT", ng_to_db(mx_out), slider2 + min(slider5, 0), -48);
  slider7 ? (
    ng_font(4, 8, 0);
    ng_col(NG_MUTED, 1);
    ng_ptxt(slider7 == 1 ? (slider8 ? "16-BIT TPDF + NS" : "16-BIT TPDF") : (slider8 ? "24-BIT TPDF + NS" : "24-BIT TPDF"), X(448), Y(152), 2);
  );

  ng_row(6);
  sprintf(#v1, "%+.1f dB", slider1);
  ng_knob_ctl(1, "INPUT", #v1, -12, 12, 0, 0.1, 1) ? update();
  sprintf(#v2, "%.1f dB", slider2);
  ng_knob_ctl(2, "CEILING", #v2, -3, -0.1, -0.3, 0.1, 0) ? update();
  sprintf(#v3, "%d ms", slider3);
  ng_knob_ctl(3, "RELEASE", #v3, 10, 200, 50, 1, 0) ? update();
  sprintf(#v4, "%d ms", slider4);
  ng_knob_ctl(4, "LOOKAHEAD", #v4, 0, 5, 2, 1, 0) ? update();
  sprintf(#v5, "%.1f dB", slider5);
  ng_knob_ctl(5, "OUTPUT", #v5, -12, 0, 0, 0.1, 0) ? update();
  ng_select_ctl(6, "LINK", "OFF|ON", 0) ? update();
  ng_row(2);
  ng_select_ctl(7, "DITHER", "OFF|16 BIT|24 BIT", 0) ? update();
  ng_select_ctl(8, "SHAPING", "OFF|ON", 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
