desc:NULL Bitcrusher GFX
author: Christos Koulaxizis
tags: bitcrusher bit crusher decimator sample rate reduction lo-fi lofi digital aliasing 8-bit 12-bit retro gui
//category: Essentials
//NULL JSFX v2.9 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:8<1,16,1>-Bits
slider2:8000<100,48000,1:log>-Sample Rate (Hz)
slider3:0<0,1,1{Off,On}>-Anti Alias
slider4:0<0,100,1>-Smooth (%)
slider5:0<0,24,0.1>-Drive (dB)
slider6:100<0,100,1>-Mix (%)
slider7:0<-24,12,0.1>-Output (dB)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep the held sample, as in the VST3/CLAP
  // NULL Bitcrusher (../bitcrusher.jsfx) with its own interface: same audio code, plus @gfx.
  // A digital degrader. Drive raises the level first. Anti Alias On puts a 12 dB/oct low-pass
  // at 0.45 x Sample Rate before the decimator, for the clean, filtered sound of an old sampler;
  // Off lets the aliasing through. The decimator holds each sample for 1 / Sample Rate seconds
  // (a phase that runs at Sample Rate / srate), then Bits rounds it to 2^(Bits - 1) steps on
  // each side of zero. Smooth sweeps a 12 dB/oct low-pass after it from 20 kHz (0 %) down to
  // 0.45 x Sample Rate (100 %), which takes the edge off the steps. Mix blends with the dry
  // signal and Output sets the level. A Sample Rate at or above srate holds nothing.
  ph = 1;
  hl = hr = 0;
  a1l = a2l = a1r = a2r = 0;
  s1l = s2l = s1r = s2r = 0;

  // RBJ low-pass coefficients, Q = 1/sqrt(2)
  function bc_lp(f) local(w0, cw, al, a0)
  (
    w0 = 2 * $pi * min(f, 0.45 * srate) / srate;
    cw = cos(w0);
    al = sin(w0) / (2 * 0.7071067811865476);
    a0 = 1 + al;
    this.b0 = (1 - cw) / 2 / a0;
    this.b1 = (1 - cw) / a0;
    this.b2 = this.b0;
    this.a1 = -2 * cw / a0;
    this.a2 = (1 - al) / a0;
  );
  gfx_ext_retina = 1;

  function update()
  (
    q = 2 ^ (slider1 - 1);
    inc = slider2 / srate;
    aa_on = slider3;
    aa.bc_lp(0.45 * slider2);
    sm_on = slider4 > 0;
    sm.bc_lp(20000 * (min(0.45 * slider2, 20000) / 20000) ^ (slider4 / 100));
    dg = 10 ^ (slider5 / 20);
    mix = slider6 / 100;
    og = 10 ^ (slider7 / 20);
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 10;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1); ng_hist_add(2); ng_hist_add(3); ng_hist_add(4); ng_hist_add(5); ng_hist_add(6); ng_hist_add(7);
  ng_hist_init();

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 8); ng_slider_set(2, 8000); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 100); ng_slider_set(7, 0); );
    p == 1 ? ( ng_slider_set(1, 12); ng_slider_set(2, 26040); ng_slider_set(3, 1); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 100); ng_slider_set(7, 0); );
    p == 2 ? ( ng_slider_set(1, 12); ng_slider_set(2, 22050); ng_slider_set(3, 1); ng_slider_set(4, 0); ng_slider_set(5, 3); ng_slider_set(6, 100); ng_slider_set(7, 0); );
    p == 3 ? ( ng_slider_set(1, 8); ng_slider_set(2, 11025); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 100); ng_slider_set(7, 0); );
    p == 4 ? ( ng_slider_set(1, 4); ng_slider_set(2, 8000); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 60); ng_slider_set(7, 0); );
    p == 5 ? ( ng_slider_set(1, 8); ng_slider_set(2, 6000); ng_slider_set(3, 1); ng_slider_set(4, 40); ng_slider_set(5, 0); ng_slider_set(6, 100); ng_slider_set(7, 0); );
    p == 6 ? ( ng_slider_set(1, 16); ng_slider_set(2, 3000); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 100); ng_slider_set(7, 0); );
    p == 7 ? ( ng_slider_set(1, 6); ng_slider_set(2, 16000); ng_slider_set(3, 0); ng_slider_set(4, 70); ng_slider_set(5, 0); ng_slider_set(6, 100); ng_slider_set(7, 0); );
    p == 8 ? ( ng_slider_set(1, 5); ng_slider_set(2, 9000); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 6); ng_slider_set(6, 35); ng_slider_set(7, 0); );
    p == 9 ? ( ng_slider_set(1, 3); ng_slider_set(2, 2500); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 9); ng_slider_set(6, 100); ng_slider_set(7, -6); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 8) && ng_pre_eq(slider2, 8000) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 12) && ng_pre_eq(slider2, 26040) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 12) && ng_pre_eq(slider2, 22050) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 3) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 8) && ng_pre_eq(slider2, 11025) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 4) && ng_pre_eq(slider2, 8000) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 60) && ng_pre_eq(slider7, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 8) && ng_pre_eq(slider2, 6000) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, 40) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 16) && ng_pre_eq(slider2, 3000) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 6) && ng_pre_eq(slider2, 16000) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 70) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 5) && ng_pre_eq(slider2, 9000) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 6) && ng_pre_eq(slider6, 35) && ng_pre_eq(slider7, 0) ? m = 8;
    m < 0 && ng_pre_eq(slider1, 3) && ng_pre_eq(slider2, 2500) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 9) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, -6) ? m = 9;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "12-Bit Sampler";
    p == 2 ? s = "Old Sampler Drums";
    p == 3 ? s = "8-Bit Console";
    p == 4 ? s = "4-Bit Grit";
    p == 5 ? s = "Telephone Lo-Fi";
    p == 6 ? s = "Aliasing Hash";
    p == 7 ? s = "Soft Steps";
    p == 8 ? s = "Parallel Crunch";
    p == 9 ? s = "Broken Toy";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  xl = spl0 * dg;
  xr = spl1 * dg;
  aa_on ? (
    y = aa.b0 * xl + a1l;
    a1l = aa.b1 * xl - aa.a1 * y + a2l;
    a2l = aa.b2 * xl - aa.a2 * y;
    xl = y;
    y = aa.b0 * xr + a1r;
    a1r = aa.b1 * xr - aa.a1 * y + a2r;
    a2r = aa.b2 * xr - aa.a2 * y;
    xr = y;
  );
  // the decimator: a new sample when the phase wraps
  ph += inc;
  ph >= 1 ? (
    ph -= floor(ph);
    hl = floor(xl * q + 0.5) / q;
    hr = floor(xr * q + 0.5) / q;
  );
  wl = hl;
  wr = hr;
  sm_on ? (
    y = sm.b0 * wl + s1l;
    s1l = sm.b1 * wl - sm.a1 * y + s2l;
    s2l = sm.b2 * wl - sm.a2 * y;
    wl = y;
    y = sm.b0 * wr + s1r;
    s1r = sm.b1 * wr - sm.a1 * y + s2r;
    s2r = sm.b2 * wr - sm.a2 * y;
    wr = y;
  );
  spl0 = (spl0 + (wl - spl0) * mix) * og;
  spl1 = (spl1 + (wr - spl1) * mix) * og;

@gfx 480 380
  ng_knobs_begin("BITCRUSHER", "ESSENTIALS", 480, 120, 2, 0);

  // display: one cycle of a 250 Hz sine at the Drive level (dim) and what the decimator and
  // Bits make of it (Anti-Alias and Smooth left out), with the levels and the rate
  bc_px = ng_vx + 8; bc_py = ng_vy + 6; bc_pw = ng_vw - 16; bc_ph = ng_vh - 22;
  ng_plot(bc_px, bc_py, bc_pw, bc_ph);
  ng_grid(4, 4, 0);
  bc_amp = min(1.5, 0.7 * dg);
  bc_hold = slider2 >= 250 * floor(ng_pw) ? 1 / floor(ng_pw) : 250 / slider2;
  ng_col(NG_MUTED, 1);
  bc_i = 0;
  loop(floor(ng_pw) + 1,
    bc_y = ng_lin_y(max(-1.6, min(1.6, bc_amp * sin(2 * $pi * bc_i / ng_pw))), -1.6, 1.6);
    bc_i == 0 ? ng_line_start(ng_px, bc_y) : ng_line_to(ng_px + bc_i, bc_y);
    bc_i += 1;
  );
  ng_col(NG_ACCENT, 1);
  bc_i = 0;
  loop(floor(ng_pw) + 1,
    bc_t = bc_hold * floor(bc_i / ng_pw / bc_hold);
    bc_v = floor(bc_amp * sin(2 * $pi * bc_t) * q + 0.5) / q;
    bc_y = ng_lin_y(max(-1.6, min(1.6, bc_v)), -1.6, 1.6);
    bc_i == 0 ? ng_line_start(ng_px, bc_y) : ng_line_to(ng_px + bc_i, bc_y);
    bc_i += 1;
  );
  ng_font(1, 7, 1);
  ng_col(NG_ACCENT, 1);
  sprintf(#bc_s, "%d BITS   %d LEVELS", slider1, 2 * q + 1 > 99999 ? 99999 : 2 * q + 1);
  ng_txt(#bc_s, bc_px + bc_pw - 4, bc_py + 8, 2, 1);
  ng_col(NG_MUTED, 1);
  slider2 >= 1000 ? sprintf(#bc_r, "%.2f kHz", slider2 / 1000) : sprintf(#bc_r, "%d Hz", slider2);
  ng_txt(#bc_r, bc_px + bc_pw - 4, bc_py + 20, 2, 1);

  ng_row(4);
  sprintf(#bc_v1, "%d", slider1);
  ng_knob_ctl(1, "BITS", #bc_v1, 1, 16, 8, 1, 0) ? update();
  slider2 >= 1000 ? sprintf(#bc_v2, "%.1f kHz", slider2 / 1000) : sprintf(#bc_v2, "%d Hz", slider2);
  ng_knob_ctl_log(2, "RATE", #bc_v2, 100, 48000, 8000, 1) ? update();
  ng_select_ctl(3, "ANTI-ALIAS", "OFF|ON", 0) ? update();
  sprintf(#bc_v4, "%d%%", slider4);
  ng_knob_ctl(4, "SMOOTH", #bc_v4, 0, 100, 0, 1, 0) ? update();
  ng_row(3);
  sprintf(#bc_v5, "%.1f dB", slider5);
  ng_knob_ctl(5, "DRIVE", #bc_v5, 0, 24, 0, 0.1, 0) ? update();
  sprintf(#bc_v6, "%d%%", slider6);
  ng_knob_ctl(6, "MIX", #bc_v6, 0, 100, 100, 1, 0) ? update();
  sprintf(#bc_v7, "%+.1f dB", slider7);
  ng_knob_ctl(7, "OUTPUT", #bc_v7, -24, 12, 0, 0.1, 1) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
