desc:NULL Cabinet Simulator GFX
author: Christos Koulaxizis
tags: cabinet cab speaker guitar bass amp simulation di re-amp gui
//category: Essentials
//NULL JSFX v2.6.1 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:2<0,7,1{1x12 Open Back,2x12 Combo,4x12 Closed Back,1x15 Bass,Small Radio,1x10 Tweed,2x10 Bass,4x10 Vintage}>-Cabinet
slider2:30<0,100,1>-Mic Position (%)
slider3:80<20,300,1>-Low Cut (Hz)
slider4:100<0,100,1>-Mix (%)
slider5:0<-12,12,0.1>-Output (dB)
slider6:70<0,100,1>-Mic 2 Position (%)
slider7:0<0,100,1>-Mic Blend (%)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // NULL Cabinet Simulator (../cabinet_simulator.jsfx) with its own interface: same audio code, plus @gfx.
  // Turns a DI or amp-output signal into the sound of a miked speaker cabinet, without
  // impulse files. Each cabinet is a set of filters: the low-end resonance of the box,
  // the cone's mid character and presence peak, and the steep roll-off of the speaker.
  // Mic Position: 0% = centre of the cone (bright), 100% = edge (darker, softer).
  // Mic Blend fades from that mic to a second one at Mic 2 Position (0% = only the first mic):
  // both share the cabinet's box and cone filters, each has its own presence and roll-off.

  function biquad(type, freq, q, gain) local(w, c, s, al, A, a0)
  (
    w = 2 * $pi * min(freq, srate * 0.45) / srate; c = cos(w); s = sin(w);
    al = s / (2 * q); A = 10 ^ (gain / 40);
    type == 0 ? (       // high-pass
      this.b0 = (1 + c) / 2; this.b1 = -(1 + c); this.b2 = this.b0; a0 = 1 + al; this.a1 = -2 * c; this.a2 = 1 - al;
    ) : type == 1 ? (   // low-pass
      this.b0 = (1 - c) / 2; this.b1 = 1 - c; this.b2 = this.b0; a0 = 1 + al; this.a1 = -2 * c; this.a2 = 1 - al;
    ) : (               // peaking
      this.b0 = 1 + al * A; this.b1 = -2 * c; this.b2 = 1 - al * A; a0 = 1 + al / A; this.a1 = -2 * c; this.a2 = 1 - al / A;
    );
    this.b0 /= a0; this.b1 /= a0; this.b2 /= a0; this.a1 /= a0; this.a2 /= a0;
  );
  function run(x) local(y)
  (
    y = this.b0 * x + this.b1 * this.x1 + this.b2 * this.x2 - this.a1 * this.y1 - this.a2 * this.y2;
    this.x2 = this.x1; this.x1 = x; this.y2 = this.y1; this.y1 = y; y;
  );
  // the same coefficients go to both channels
  function set_stage(type, freq, q, gain)
  (
    this.l.biquad(type, freq, q, gain);
    this.r.biquad(type, freq, q, gain);
  );

  function update()
  (
    cab = slider1;
    m = slider2 / 100;
    // per cabinet: box resonance, low-mid, mid scoop, presence, roll-off frequency
    cab == 0 ? (res = 110; res_g = 4;  lm = 400;  lm_g = 1;  sc = 900;  sc_g = -3; pr = 2500; pr_g = 5; lp = 5500; base_lc = 70);
    cab == 1 ? (res = 100; res_g = 5;  lm = 350;  lm_g = 2;  sc = 800;  sc_g = -4; pr = 2200; pr_g = 4; lp = 5000; base_lc = 60);
    cab == 2 ? (res = 85;  res_g = 7;  lm = 250;  lm_g = 2;  sc = 650;  sc_g = -6; pr = 2000; pr_g = 5; lp = 4500; base_lc = 50);
    cab == 3 ? (res = 60;  res_g = 6;  lm = 200;  lm_g = 3;  sc = 600;  sc_g = -5; pr = 1500; pr_g = 3; lp = 3000; base_lc = 30);
    cab == 4 ? (res = 300; res_g = 3;  lm = 800;  lm_g = 4;  sc = 1500; sc_g = -2; pr = 2500; pr_g = 6; lp = 3500; base_lc = 250);
    cab == 5 ? (res = 130; res_g = 3;  lm = 500;  lm_g = 2;  sc = 1100; sc_g = -2; pr = 3000; pr_g = 6; lp = 6000; base_lc = 90);
    cab == 6 ? (res = 75;  res_g = 5;  lm = 280;  lm_g = 2;  sc = 700;  sc_g = -3; pr = 1800; pr_g = 4; lp = 4500; base_lc = 40);
    cab == 7 ? (res = 95;  res_g = 6;  lm = 320;  lm_g = 3;  sc = 900;  sc_g = -2; pr = 2400; pr_g = 4; lp = 5000; base_lc = 55);
    // the second mic: the same cabinet at Mic 2 Position
    m2 = slider6 / 100;
    lp_b = lp * (1 - 0.45 * m2);
    pr_gb = pr_g * (1 - 0.7 * m2);
    blend = slider7 / 100;
    lp *= 1 - 0.45 * m;
    pr_g *= 1 - 0.7 * m;
    lc = max(slider3, base_lc);
    st1.set_stage(0, lc, 0.707, 0);
    st2.set_stage(2, res, 1.2, res_g);
    st3.set_stage(2, lm, 0.9, lm_g);
    st4.set_stage(2, sc, 1.0, sc_g);
    st5.set_stage(2, pr, 1.5, pr_g);
    st6.set_stage(1, lp, 0.6, 0);
    st7.set_stage(1, lp * 1.3, 0.9, 0);
    st5b.set_stage(2, pr, 1.5, pr_gb);
    st6b.set_stage(1, lp_b, 0.6, 0);
    st7b.set_stage(1, lp_b * 1.3, 0.9, 0);
    mix = slider4 / 100;
    out = 10 ^ (slider5 / 20);
  );

  // display: multiplies (cb_hr, cb_hi) by this biquad's response at w (radians per sample)
  function cb_mul(w) local(c1, s1, c2, s2, nr, ni, dr, di, d2, hr, hi, tr)
  (
    c1 = cos(w); s1 = sin(w); c2 = cos(2 * w); s2 = sin(2 * w);
    nr = this.b0 + this.b1 * c1 + this.b2 * c2; ni = -(this.b1 * s1 + this.b2 * s2);
    dr = 1 + this.a1 * c1 + this.a2 * c2; di = -(this.a1 * s1 + this.a2 * s2);
    d2 = max(dr * dr + di * di, 0.00000000000000000001);
    hr = (nr * dr + ni * di) / d2; hi = (ni * dr - nr * di) / d2;
    tr = cb_hr * hr - cb_hi * hi;
    cb_hi = cb_hr * hi + cb_hi * hr;
    cb_hr = tr;
  );
  // the whole plugin at f Hz in dB: the seven stages, blended with the dry signal, times Output
  function cb_db(f) local(w)
  (
    w = 2 * $pi * min(f, srate * 0.4999) / srate;
    cb_hr = 1; cb_hi = 0;
    st1.l.cb_mul(w); st2.l.cb_mul(w); st3.l.cb_mul(w); st4.l.cb_mul(w);
    blend > 0 ? (
      // the second mic's stages on (1, 0), blended with the first mic's
      cb_t1 = cb_hr; cb_t2 = cb_hi;
      cb_hr = 1; cb_hi = 0;
      st5b.l.cb_mul(w); st6b.l.cb_mul(w); st7b.l.cb_mul(w);
      cb_br = cb_hr; cb_bi = cb_hi;
      cb_hr = 1; cb_hi = 0;
      st5.l.cb_mul(w); st6.l.cb_mul(w); st7.l.cb_mul(w);
      cb_ar = cb_hr * (1 - blend) + cb_br * blend; cb_ai = cb_hi * (1 - blend) + cb_bi * blend;
      cb_hr = cb_t1 * cb_ar - cb_t2 * cb_ai; cb_hi = cb_t1 * cb_ai + cb_t2 * cb_ar;
    ) : (
      st5.l.cb_mul(w); st6.l.cb_mul(w); st7.l.cb_mul(w);
    );
    cb_hr = (1 - mix) + mix * cb_hr; cb_hi = mix * cb_hi;
    10 * log10(max(cb_hr * cb_hr + cb_hi * cb_hi, 0.00000000000000000001)) + 20 * log10(out);
  );

  gfx_ext_retina = 1;

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 13;

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 2); ng_slider_set(2, 30); ng_slider_set(3, 80); ng_slider_set(4, 100); ng_slider_set(5, 0); ng_slider_set(6, 70); ng_slider_set(7, 0); );
    p == 1 ? ( ng_slider_set(1, 1); ng_slider_set(2, 20); ng_slider_set(3, 80); ng_slider_set(4, 100); ng_slider_set(5, 0); ng_slider_set(6, 70); ng_slider_set(7, 0); );
    p == 2 ? ( ng_slider_set(1, 0); ng_slider_set(2, 10); ng_slider_set(3, 80); ng_slider_set(4, 100); ng_slider_set(5, 0); ng_slider_set(6, 70); ng_slider_set(7, 0); );
    p == 3 ? ( ng_slider_set(1, 2); ng_slider_set(2, 30); ng_slider_set(3, 90); ng_slider_set(4, 100); ng_slider_set(5, -1); ng_slider_set(6, 70); ng_slider_set(7, 0); );
    p == 4 ? ( ng_slider_set(1, 2); ng_slider_set(2, 70); ng_slider_set(3, 100); ng_slider_set(4, 100); ng_slider_set(5, -1); ng_slider_set(6, 70); ng_slider_set(7, 0); );
    p == 5 ? ( ng_slider_set(1, 1); ng_slider_set(2, 60); ng_slider_set(3, 100); ng_slider_set(4, 100); ng_slider_set(5, 0); ng_slider_set(6, 70); ng_slider_set(7, 0); );
    p == 6 ? ( ng_slider_set(1, 3); ng_slider_set(2, 40); ng_slider_set(3, 40); ng_slider_set(4, 50); ng_slider_set(5, 0); ng_slider_set(6, 70); ng_slider_set(7, 0); );
    p == 7 ? ( ng_slider_set(1, 4); ng_slider_set(2, 20); ng_slider_set(3, 250); ng_slider_set(4, 100); ng_slider_set(5, 2); ng_slider_set(6, 70); ng_slider_set(7, 0); );
    p == 8 ? ( ng_slider_set(1, 5); ng_slider_set(2, 25); ng_slider_set(3, 100); ng_slider_set(4, 100); ng_slider_set(5, 0); ng_slider_set(6, 70); ng_slider_set(7, 0); );
    p == 9 ? ( ng_slider_set(1, 2); ng_slider_set(2, 15); ng_slider_set(3, 90); ng_slider_set(4, 100); ng_slider_set(5, 0); ng_slider_set(6, 75); ng_slider_set(7, 40); );
    p == 10 ? ( ng_slider_set(1, 6); ng_slider_set(2, 20); ng_slider_set(3, 40); ng_slider_set(4, 80); ng_slider_set(5, 0); ng_slider_set(6, 70); ng_slider_set(7, 0); );
    p == 11 ? ( ng_slider_set(1, 7); ng_slider_set(2, 10); ng_slider_set(3, 70); ng_slider_set(4, 100); ng_slider_set(5, 0); ng_slider_set(6, 60); ng_slider_set(7, 50); );
    p == 12 ? ( ng_slider_set(1, 1); ng_slider_set(2, 50); ng_slider_set(3, 80); ng_slider_set(4, 100); ng_slider_set(5, 0); ng_slider_set(6, 100); ng_slider_set(7, 60); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 30) && ng_pre_eq(slider3, 80) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 70) && ng_pre_eq(slider7, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 20) && ng_pre_eq(slider3, 80) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 70) && ng_pre_eq(slider7, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 10) && ng_pre_eq(slider3, 80) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 70) && ng_pre_eq(slider7, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 30) && ng_pre_eq(slider3, 90) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, -1) && ng_pre_eq(slider6, 70) && ng_pre_eq(slider7, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 70) && ng_pre_eq(slider3, 100) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, -1) && ng_pre_eq(slider6, 70) && ng_pre_eq(slider7, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 60) && ng_pre_eq(slider3, 100) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 70) && ng_pre_eq(slider7, 0) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 3) && ng_pre_eq(slider2, 40) && ng_pre_eq(slider3, 40) && ng_pre_eq(slider4, 50) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 70) && ng_pre_eq(slider7, 0) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 4) && ng_pre_eq(slider2, 20) && ng_pre_eq(slider3, 250) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 2) && ng_pre_eq(slider6, 70) && ng_pre_eq(slider7, 0) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 5) && ng_pre_eq(slider2, 25) && ng_pre_eq(slider3, 100) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 70) && ng_pre_eq(slider7, 0) ? m = 8;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 15) && ng_pre_eq(slider3, 90) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 75) && ng_pre_eq(slider7, 40) ? m = 9;
    m < 0 && ng_pre_eq(slider1, 6) && ng_pre_eq(slider2, 20) && ng_pre_eq(slider3, 40) && ng_pre_eq(slider4, 80) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 70) && ng_pre_eq(slider7, 0) ? m = 10;
    m < 0 && ng_pre_eq(slider1, 7) && ng_pre_eq(slider2, 10) && ng_pre_eq(slider3, 70) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 60) && ng_pre_eq(slider7, 50) ? m = 11;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 50) && ng_pre_eq(slider3, 80) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 60) ? m = 12;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Clean Combo";
    p == 2 ? s = "Bright Open Back";
    p == 3 ? s = "Rock Rhythm Stack";
    p == 4 ? s = "Dark Lead Edge Mic";
    p == 5 ? s = "Fuzz Tamer";
    p == 6 ? s = "Bass DI Cab Blend";
    p == 7 ? s = "Small Radio Lo-Fi";
    p == 8 ? s = "Tweed 1x10";
    p == 9 ? s = "Double-Mic 4x12";
    p == 10 ? s = "Bass 2x10 Growl";
    p == 11 ? s = "Vintage 4x10 Blend";
    p == 12 ? s = "Dark Edge Pair";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  // left channel
  y = st1.l.run(spl0); y = st2.l.run(y); y = st3.l.run(y); y = st4.l.run(y);
  blend > 0 ? (y_b = st5b.l.run(y); y_b = st6b.l.run(y_b); y_b = st7b.l.run(y_b));
  y = st5.l.run(y); y = st6.l.run(y); wl = st7.l.run(y);
  blend > 0 ? wl = wl * (1 - blend) + y_b * blend;
  // right channel
  y = st1.r.run(spl1); y = st2.r.run(y); y = st3.r.run(y); y = st4.r.run(y);
  blend > 0 ? (y_b = st5b.r.run(y); y_b = st6b.r.run(y_b); y_b = st7b.r.run(y_b));
  y = st5.r.run(y); y = st6.r.run(y); wr = st7.r.run(y);
  blend > 0 ? wr = wr * (1 - blend) + y_b * blend;
  spl0 = (spl0 * (1 - mix) + wl * mix) * out;
  spl1 = (spl1 * (1 - mix) + wr * mix) * out;

@gfx 480 380
  ng_knobs_begin("CABINET SIMULATOR", "ESSENTIALS", 480, 120, 2, 0);

  // display: the cabinet's magnitude response with Mix and Output (-24..+24 dB), the low cut
  // dashed, the cabinet's name at the top right
  ng_plot(ng_vx + 26, ng_vy + 4, ng_vw - 30, ng_vh - 20);
  ng_grid_freq(36);
  cb_x = floor(ng_freq_x(lc)) + 0.5;
  ng_col(NG_ACCENT, 0.5);
  cb_y = ng_py;
  while (
    gfx_line(cb_x, cb_y, cb_x, min(cb_y + 3 * ng_s, ng_py + ng_ph), 0);
    cb_y += 6 * ng_s;
    cb_y < ng_py + ng_ph;
  );
  cb_zy = ng_lin_y(0, -24, 24);
  ng_col(NG_ACCENT, 0.10);
  cb_i = 0;
  loop(floor(ng_pw) + 1,
    gfx_line(ng_px + cb_i, cb_zy, ng_px + cb_i, ng_lin_y(cb_db(20 * 1000 ^ (cb_i / ng_pw)), -24, 24), 0);
    cb_i += 1;
  );
  ng_col(NG_ACCENT, 1);
  cb_i = 0;
  loop(floor(ng_pw) + 1,
    cb_y = ng_lin_y(cb_db(20 * 1000 ^ (cb_i / ng_pw)), -24, 24);
    cb_i == 0 ? ng_line_start(ng_px, cb_y) : ng_line_to(ng_px + cb_i, cb_y);
    cb_i += 1;
  );
  ng_font(4, 8, 0);
  ng_col(NG_MUTED, 1);
  ng_ptxt(slider1 == 0 ? "1x12 Open Back" : slider1 == 1 ? "2x12 Combo" : slider1 == 2 ? "4x12 Closed Back" :
          slider1 == 3 ? "1x15 Bass" : slider1 == 4 ? "Small Radio" : slider1 == 5 ? "1x10 Tweed" :
          slider1 == 6 ? "2x10 Bass" : "4x10 Vintage", ng_px + ng_pw - 6 * ng_s, ng_py + 8 * ng_s, 2);

  ng_row(4);
  ng_select_ctl(1, "CABINET", "1X12|2X12|4X12|1X15|RADIO|1X10|2X10|4X10", 0) ? update();
  sprintf(#cb_m, "%d%%", slider2);
  ng_knob_ctl(2, "MIC POS", #cb_m, 0, 100, 30, 1, 0) ? update();
  sprintf(#cb_m2, "%d%%", slider6);
  ng_knob_ctl(6, "MIC 2 POS", #cb_m2, 0, 100, 70, 1, 0) ? update();
  sprintf(#cb_b, "%d%%", slider7);
  ng_knob_ctl(7, "MIC BLEND", #cb_b, 0, 100, 0, 1, 0) ? update();
  ng_row(3);
  sprintf(#cb_l, "%d Hz", slider3);
  ng_knob_ctl(3, "LOW CUT", #cb_l, 20, 300, 80, 1, 0) ? update();
  sprintf(#cb_mx, "%d%%", slider4);
  ng_knob_ctl(4, "MIX", #cb_mx, 0, 100, 100, 1, 0) ? update();
  sprintf(#cb_o, "%+.1f dB", slider5);
  ng_knob_ctl(5, "OUTPUT", #cb_o, -12, 12, 0, 0.1, 1) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
