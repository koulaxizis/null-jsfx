desc:NULL Kick Shaper GFX
author: Christos Koulaxizis
tags: kick drum transient shaping punch body thump click decay gui
//category: Advanced
//NULL JSFX v3.0 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:0<-20,20,0.1>-Attack Shape (dB)
slider2:0<-12,12,0.1>-Body Tone (dB)
slider3:0<-12,12,0.1>-Thump (dB)
slider4:0<-12,12,0.1>-Click (dB)
slider5:250<50,500,1>-Decay (ms)
slider6:0<-12,12,0.1>-Output Gain (dB)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // NULL Kick Shaper (../kick_shaper.jsfx) with its own interface: same audio code, plus @gfx.
  // Shapes a kick drum in four parts:
  //   Thump (bell at 55 Hz), Body (bell at 120 Hz), Click (bell at 4 kHz),
  //   Attack Shape: boosts or softens the first milliseconds of each hit,
  //   Decay: each detected hit starts a timer; after 20 ms the tail fades out with
  //   this time constant, so lower values give a shorter, tighter kick.
  fast = slow = 0;
  t = 1000000;
  armed = 1;

  function peak(freq, q, gain) local(w, c, al, A, a0)
  (
    w = 2 * $pi * freq / srate; c = cos(w); al = sin(w) / (2 * q); A = 10 ^ (gain / 40);
    a0 = 1 + al / A;
    this.b0 = (1 + al * A) / a0; this.b1 = -2 * c / a0; this.b2 = (1 - al * A) / a0;
    this.a1 = -2 * c / a0; this.a2 = (1 - al / A) / a0;
  );
  function eq_l(x) local(y)
  (
    y = this.b0 * x + this.b1 * this.xl1 + this.b2 * this.xl2 - this.a1 * this.yl1 - this.a2 * this.yl2;
    this.xl2 = this.xl1; this.xl1 = x; this.yl2 = this.yl1; this.yl1 = y; y;
  );
  function eq_r(x) local(y)
  (
    y = this.b0 * x + this.b1 * this.xr1 + this.b2 * this.xr2 - this.a1 * this.yr1 - this.a2 * this.yr2;
    this.xr2 = this.xr1; this.xr1 = x; this.yr2 = this.yr1; this.yr1 = y; y;
  );
  gfx_ext_retina = 1;

  function update()
  (
    thump.peak(55, 0.8, slider3);
    body.peak(120, 1, slider2);
    click.peak(4000, 0.7, slider4);
    attack_db = slider1;
    decay_s = slider5 / 1000;
    out_gain = 10 ^ (slider6 / 20);
    fa = exp(-1 / (0.001 * srate)); fr = exp(-1 / (0.02 * srate));
    sa = exp(-1 / (0.015 * srate)); sr_ = exp(-1 / (0.02 * srate));
  );

  // magnitude of a bell at w radians per sample (for the display)
  function ks_mag(w) instance(b0, b1, b2, a1, a2) local(n, d)
  (
    n = b0 * b0 + b1 * b1 + b2 * b2 + 2 * (b0 * b1 + b1 * b2) * cos(w) + 2 * b0 * b2 * cos(2 * w);
    d = 1 + a1 * a1 + a2 * a2 + 2 * (a1 + a1 * a2) * cos(w) + 2 * a2 * cos(2 * w);
    sqrt(max(n, 0) / max(d, 0.0000000001));
  );

  // a value in dB with its sign
  function ks_db(str, v) ( v > 0 ? sprintf(str, "+%.1f dB", v) : sprintf(str, "%.1f dB", v); );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 8;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1); ng_hist_add(2); ng_hist_add(3); ng_hist_add(4); ng_hist_add(5); ng_hist_add(6);
  ng_hist_init();

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 250); ng_slider_set(6, 0); );
    p == 1 ? ( ng_slider_set(1, 6); ng_slider_set(2, 2); ng_slider_set(3, 2); ng_slider_set(4, 3); ng_slider_set(5, 300); ng_slider_set(6, -2); );
    p == 2 ? ( ng_slider_set(1, 4); ng_slider_set(2, -2); ng_slider_set(3, 3); ng_slider_set(4, 2); ng_slider_set(5, 180); ng_slider_set(6, -2); );
    p == 3 ? ( ng_slider_set(1, 2); ng_slider_set(2, -2); ng_slider_set(3, -3); ng_slider_set(4, 1); ng_slider_set(5, 120); ng_slider_set(6, 1); );
    p == 4 ? ( ng_slider_set(1, 0); ng_slider_set(2, 1); ng_slider_set(3, 4); ng_slider_set(4, -2); ng_slider_set(5, 500); ng_slider_set(6, -3); );
    p == 5 ? ( ng_slider_set(1, 8); ng_slider_set(2, -3); ng_slider_set(3, 1); ng_slider_set(4, 6); ng_slider_set(5, 200); ng_slider_set(6, -3); );
    p == 6 ? ( ng_slider_set(1, -6); ng_slider_set(2, 2); ng_slider_set(3, 0); ng_slider_set(4, -3); ng_slider_set(5, 350); ng_slider_set(6, 1); );
    p == 7 ? ( ng_slider_set(1, 3); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 1); ng_slider_set(5, 80); ng_slider_set(6, 0); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 250) && ng_pre_eq(slider6, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 6) && ng_pre_eq(slider2, 2) && ng_pre_eq(slider3, 2) && ng_pre_eq(slider4, 3) && ng_pre_eq(slider5, 300) && ng_pre_eq(slider6, -2) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 4) && ng_pre_eq(slider2, -2) && ng_pre_eq(slider3, 3) && ng_pre_eq(slider4, 2) && ng_pre_eq(slider5, 180) && ng_pre_eq(slider6, -2) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, -2) && ng_pre_eq(slider3, -3) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 120) && ng_pre_eq(slider6, 1) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 1) && ng_pre_eq(slider3, 4) && ng_pre_eq(slider4, -2) && ng_pre_eq(slider5, 500) && ng_pre_eq(slider6, -3) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 8) && ng_pre_eq(slider2, -3) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, 6) && ng_pre_eq(slider5, 200) && ng_pre_eq(slider6, -3) ? m = 5;
    m < 0 && ng_pre_eq(slider1, -6) && ng_pre_eq(slider2, 2) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, -3) && ng_pre_eq(slider5, 350) && ng_pre_eq(slider6, 1) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 3) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 80) && ng_pre_eq(slider6, 0) ? m = 7;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Punchy Rock Kick";
    p == 2 ? s = "Tight Dance Kick";
    p == 3 ? s = "Boomy Kick Tamer";
    p == 4 ? s = "Deep 808 Tail";
    p == 5 ? s = "Metal Beater Click";
    p == 6 ? s = "Soft Vintage Kick";
    p == 7 ? s = "Live Kick Bleed Cut";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  l = click.eq_l(body.eq_l(thump.eq_l(spl0)));
  r = click.eq_r(body.eq_r(thump.eq_r(spl1)));

  lev = max(abs(l), abs(r));
  fast = lev > fast ? fa * fast + (1 - fa) * lev : fr * fast + (1 - fr) * lev;
  slow = lev > slow ? sa * slow + (1 - sa) * lev : sr_ * slow + (1 - sr_) * lev;

  // transient = how far the fast envelope is ahead of the slow one (0..1)
  trans = fast > 0.000001 ? max(0, min(1, (fast - slow) / fast)) : 0;
  g = 10 ^ (attack_db * trans / 20);

  // hit detection re-arms once the transient has passed
  armed && trans > 0.5 && fast > 0.01 ? (t = 0; armed = 0);
  trans < 0.2 ? armed = 1;
  t += 1 / srate;
  tail = t < 0.02 ? 1 : exp(-(t - 0.02) / decay_s);
  // Decay at its maximum (500 ms) leaves the kick almost untouched
  tail = tail + (1 - tail) * (decay_s - 0.05) / 0.45 * 0.9;

  spl0 = l * g * tail * out_gain;
  spl1 = r * g * tail * out_gain;

@gfx 480 294
  ng_knobs_begin("KICK SHAPER", "ADVANCED", 480, 120, 1, 0);

  // display, left: the frequency response of Thump, Body and Click plus Output Gain
  ng_plot(50, 66, 256, 84);
  ng_grid_freq(24);
  ng_col(NG_ACCENT, 1);
  ks_i = 0;
  loop(floor(ng_pw) + 1,
    ks_f = 20 * 1000 ^ (ks_i / floor(ng_pw));
    ks_w = 2 * $pi * min(ks_f, 0.49 * srate) / srate;
    ks_g = thump.ks_mag(ks_w) * body.ks_mag(ks_w) * click.ks_mag(ks_w);
    ks_y = ng_lin_y(20 * log10(max(ks_g, 0.0000001)) + slider6, -16, 16);
    ks_i == 0 ? ng_line_start(ng_px, ks_y) : ng_line_to(ng_px + ks_i, ks_y);
    ks_i += 1;
  );

  // display, right: the level of a hit over 0.5 s (Attack Shape at the start, then Decay)
  ng_plot(344, 66, 108, 84);
  ng_grid(2, 4, 1);
  ng_font(4, 8, 0);
  ng_col(NG_MUTED, 1);
  ng_ptxt("+24", ng_px - 6 * ng_s, ng_py, 2);
  ng_ptxt("0", ng_px - 6 * ng_s, ng_py + ng_ph / 2, 2);
  ng_ptxt("-24", ng_px - 6 * ng_s, ng_py + ng_ph, 2);
  ng_ptxt("0.25 s", ng_px + ng_pw / 2, ng_py + ng_ph + 11 * ng_s, 1);
  ng_col(NG_ACCENT, 1);
  ks_ds = slider5 / 1000;
  ks_i = 0;
  loop(floor(ng_pw) + 1,
    ks_t = 0.5 * ks_i / floor(ng_pw);
    ks_tail = ks_t < 0.02 ? 1 : exp(-(ks_t - 0.02) / ks_ds);
    ks_tail = ks_tail + (1 - ks_tail) * (ks_ds - 0.05) / 0.45 * 0.9;
    ks_y = ng_lin_y(20 * log10(max(ks_tail, 0.0000001)) + slider1 * max(0, 1 - ks_t / 0.015), -24, 24);
    ks_i == 0 ? ng_line_start(ng_px, ks_y) : ng_line_to(ng_px + ks_i, ks_y);
    ks_i += 1;
  );

  ng_row(6);
  ks_db(#v1, slider1);
  ng_knob_ctl(1, "ATTACK", #v1, -20, 20, 0, 0.1, 1) ? update();
  ks_db(#v2, slider2);
  ng_knob_ctl(2, "BODY", #v2, -12, 12, 0, 0.1, 1) ? update();
  ks_db(#v3, slider3);
  ng_knob_ctl(3, "THUMP", #v3, -12, 12, 0, 0.1, 1) ? update();
  ks_db(#v4, slider4);
  ng_knob_ctl(4, "CLICK", #v4, -12, 12, 0, 0.1, 1) ? update();
  sprintf(#v5, "%d ms", slider5);
  ng_knob_ctl(5, "DECAY", #v5, 50, 500, 250, 1, 0) ? update();
  ks_db(#v6, slider6);
  ng_knob_ctl(6, "OUTPUT", #v6, -12, 12, 0, 0.1, 1) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
