desc:NULL Envelope Follower GFX
author: Christos Koulaxizis
tags: envelope follower auto wah filter dynamic modulation funk touch gui
//category: Essentials
//NULL JSFX v2.9 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:0<0,3,1{Lowpass,Bandpass,Highpass,Volume}>-Target
slider2:5<0.1,100,0.1>-Attack (ms)
slider3:150<10,2000,1>-Release (ms)
slider4:0<-24,24,0.5>-Sensitivity (dB)
slider5:200<20,2000,1:log>-Low Freq (Hz)
slider6:3000<500,15000,10:log>-High Freq (Hz)
slider7:3<0.5,10,0.1>-Resonance
slider8:0<0,1,1{Up,Down}>-Direction
slider9:100<0,100,1>-Mix (%)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // NULL Envelope Follower (../envelope_follower.jsfx) with its own interface: same audio code, plus @gfx.
  // Follows the loudness of the input and uses it to move a filter (auto-wah) or the
  // volume. Louder playing opens the filter from Low Freq toward High Freq (Direction
  // Up) or closes it (Down). Sensitivity sets how hard you need to play to reach the end.
  env = 0;

  // TPT state-variable filter; returns low, band or high output
  function svf(x) local(v1, v2, v3, hp)
  (
    v3 = x - this.ic2;
    v1 = a1 * this.ic1 + a2 * v3;
    v2 = this.ic2 + a2 * this.ic1 + a3 * v3;
    this.ic1 = 2 * v1 - this.ic1;
    this.ic2 = 2 * v2 - this.ic2;
    hp = x - k * v1 - v2;
    target == 0 ? v2 : target == 1 ? v1 : hp;
  );
  gfx_ext_retina = 1;

  // interface only: a 2.6 s history of the input level and the envelope position, one entry
  // per 10 ms (260 entries, one per display pixel) in memory from 4000000, and a peak meter
  ef_buf = 4000000; ef_len = 260; ef_w = 0;
  ef_chunk = max(1, floor(srate * 0.01));
  ef_n = 0; ef_hl = 0;
  ef_i = 0;
  loop(ef_len, ef_buf[ef_i * 2] = 0; ef_buf[ef_i * 2 + 1] = 0; ef_i += 1;);
  ef_rel = exp(-1 / (0.3 * srate));
  ef_in = 0;

  function update()
  (
    target = slider1;
    att = exp(-1 / (slider2 / 1000 * srate));
    rel = exp(-1 / (slider3 / 1000 * srate));
    sens = 10 ^ (slider4 / 20);
    f_lo = slider5;
    f_hi = max(slider6, slider5);
    k = 1 / slider7;
    down = slider8;
    mix = slider9 / 100;
  );

  // frequency label: "200", "3.0k"
  function ef_flabel(f) ( f >= 1000 ? sprintf(#ef_l, "%.1fk", f / 1000) : sprintf(#ef_l, "%d", floor(f + 0.5)); );

  // history: input level as dim bars (-48..0 dB), the envelope position as the line (bottom =
  // Low Freq or silence, top = High Freq or full volume)
  function ef_history() local(i, k, xx, yy, h)
  (
    ng_plot(56, 68, 260, 88);
    ng_grid(8, 4, 0);
    ng_font(4, 8, 0);
    ng_col(NG_MUTED, 1);
    i = 0;
    loop(3,
      slider1 == 3 ? sprintf(#ef_l, "%d%%", 100 - 50 * i) : ef_flabel(slider5 * (max(slider6, slider5) / slider5) ^ (1 - i / 2));
      ng_ptxt(#ef_l, ng_px - 6 * ng_s, ng_py + ng_ph * i / 2, 2);
      i += 1;
    );
    ng_col(NG_ACCENT, 0.15);
    i = 0;
    loop(ef_len,
      k = (ef_w + i) % ef_len;
      h = ng_ph * ng_db_norm(ng_to_db(ef_buf[k * 2]), -48);
      h > 0 ? gfx_rect(ng_px + i * ng_s, ng_py + ng_ph - h, ng_s, h);
      i += 1;
    );
    ng_col(NG_ACCENT, 1);
    i = 0;
    loop(ef_len,
      k = (ef_w + i) % ef_len;
      xx = ng_px + (i + 0.5) * ng_s;
      yy = ng_lin_y(ef_buf[k * 2 + 1], 0, 1);
      i == 0 ? ng_line_start(xx, yy) : ng_line_to(xx, yy);
      i += 1;
    );
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 7;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1); ng_hist_add(2); ng_hist_add(3); ng_hist_add(4); ng_hist_add(5); ng_hist_add(6); ng_hist_add(7); ng_hist_add(8); ng_hist_add(9);
  ng_hist_init();

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 0); ng_slider_set(2, 5); ng_slider_set(3, 150); ng_slider_set(4, 0); ng_slider_set(5, 200); ng_slider_set(6, 3000); ng_slider_set(7, 3); ng_slider_set(8, 0); ng_slider_set(9, 100); );
    p == 1 ? ( ng_slider_set(1, 1); ng_slider_set(2, 3); ng_slider_set(3, 120); ng_slider_set(4, 6); ng_slider_set(5, 300); ng_slider_set(6, 2500); ng_slider_set(7, 4); ng_slider_set(8, 0); ng_slider_set(9, 100); );
    p == 2 ? ( ng_slider_set(1, 1); ng_slider_set(2, 5); ng_slider_set(3, 200); ng_slider_set(4, 6); ng_slider_set(5, 400); ng_slider_set(6, 3000); ng_slider_set(7, 4); ng_slider_set(8, 1); ng_slider_set(9, 100); );
    p == 3 ? ( ng_slider_set(1, 0); ng_slider_set(2, 5); ng_slider_set(3, 150); ng_slider_set(4, 6); ng_slider_set(5, 150); ng_slider_set(6, 1500); ng_slider_set(7, 3); ng_slider_set(8, 0); ng_slider_set(9, 100); );
    p == 4 ? ( ng_slider_set(1, 0); ng_slider_set(2, 1); ng_slider_set(3, 300); ng_slider_set(4, 0); ng_slider_set(5, 200); ng_slider_set(6, 8000); ng_slider_set(7, 2); ng_slider_set(8, 0); ng_slider_set(9, 100); );
    p == 5 ? ( ng_slider_set(1, 0); ng_slider_set(2, 1); ng_slider_set(3, 80); ng_slider_set(4, 0); ng_slider_set(5, 500); ng_slider_set(6, 12000); ng_slider_set(7, 1.5); ng_slider_set(8, 0); ng_slider_set(9, 100); );
    p == 6 ? ( ng_slider_set(1, 3); ng_slider_set(2, 80); ng_slider_set(3, 400); ng_slider_set(4, 12); ng_slider_set(5, 200); ng_slider_set(6, 3000); ng_slider_set(7, 3); ng_slider_set(8, 0); ng_slider_set(9, 100); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 5) && ng_pre_eq(slider3, 150) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 200) && ng_pre_eq(slider6, 3000) && ng_pre_eq(slider7, 3) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 100) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 3) && ng_pre_eq(slider3, 120) && ng_pre_eq(slider4, 6) && ng_pre_eq(slider5, 300) && ng_pre_eq(slider6, 2500) && ng_pre_eq(slider7, 4) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 100) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 5) && ng_pre_eq(slider3, 200) && ng_pre_eq(slider4, 6) && ng_pre_eq(slider5, 400) && ng_pre_eq(slider6, 3000) && ng_pre_eq(slider7, 4) && ng_pre_eq(slider8, 1) && ng_pre_eq(slider9, 100) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 5) && ng_pre_eq(slider3, 150) && ng_pre_eq(slider4, 6) && ng_pre_eq(slider5, 150) && ng_pre_eq(slider6, 1500) && ng_pre_eq(slider7, 3) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 100) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 1) && ng_pre_eq(slider3, 300) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 200) && ng_pre_eq(slider6, 8000) && ng_pre_eq(slider7, 2) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 100) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 1) && ng_pre_eq(slider3, 80) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 500) && ng_pre_eq(slider6, 12000) && ng_pre_eq(slider7, 1.5) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 100) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 3) && ng_pre_eq(slider2, 80) && ng_pre_eq(slider3, 400) && ng_pre_eq(slider4, 12) && ng_pre_eq(slider5, 200) && ng_pre_eq(slider6, 3000) && ng_pre_eq(slider7, 3) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 100) ? m = 6;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Funk Guitar Wah";
    p == 2 ? s = "Reverse Guitar Wah";
    p == 3 ? s = "Bass Auto-Wah";
    p == 4 ? s = "Touch Synth Filter";
    p == 5 ? s = "Drum Filter Breathe";
    p == 6 ? s = "Soft Volume Swells";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  ef_x = max(abs(spl0), abs(spl1)); // interface only
  lev = max(abs(spl0), abs(spl1)) * sens;
  env = lev > env ? att * env + (1 - att) * lev : rel * env + (1 - rel) * lev;
  // -48 dB .. 0 dB of envelope maps to 0 .. 1
  e = env > 0.004 ? min(1, 1 + log10(env) * 20 / 48) : 0;
  e = max(0, e);
  down ? e = 1 - e;

  target == 3 ? (
    w_l = spl0 * e;
    w_r = spl1 * e;
  ) : (
    fc = min(f_lo * (f_hi / f_lo) ^ e, srate * 0.45);
    g = tan($pi * fc / srate);
    a1 = 1 / (1 + g * (g + k));
    a2 = g * a1;
    a3 = g * a2;
    w_l = L.svf(spl0);
    w_r = R.svf(spl1);
  );
  spl0 = spl0 * (1 - mix) + w_l * mix;
  spl1 = spl1 * (1 - mix) + w_r * mix;

  // interface only: meter and history (read the audio state, never change it)
  ef_in = ef_x > ef_in ? ef_x : ef_in * ef_rel;
  ef_hl = max(ef_hl, ef_x);
  (ef_n += 1) >= ef_chunk ? (
    ef_buf[ef_w * 2] = ef_hl;
    ef_buf[ef_w * 2 + 1] = e;
    ef_w = (ef_w + 1) % ef_len;
    ef_n = 0; ef_hl = 0;
  );

@gfx 480 380
  ng_knobs_begin("ENVELOPE FOLLOWER", "ESSENTIALS", 480, 120, 2, 0);

  // display, left: the last 2.6 s of input level (bars) and envelope position (line) on the
  // Low..High Freq axis (or 0..100% volume); right: input and envelope meters, and the cutoff
  // (or volume) now
  ef_history();
  ng_meter(336, 82, 112, 10, "IN", ng_to_db(ef_in), -140, -48);
  ng_meter(336, 106, 112, 10, "ENV", -48 + 48 * e, -140, -48);
  ng_font(1, 7, 1);
  ng_col(NG_MUTED, 1);
  ng_txt(slider1 == 3 ? "GAIN" : "CUTOFF", 336, 135, 0, 1);
  slider1 == 3 ? sprintf(#ef_v, "%d%%", floor(e * 100 + 0.5)) : (
    fc >= 1000 ? sprintf(#ef_v, "%.2f kHz", fc / 1000) : sprintf(#ef_v, "%d Hz", floor(fc + 0.5));
  );
  ng_font(3, 8.5, 0);
  ng_col(NG_TEXT, 1);
  ng_txt(#ef_v, 448, 135, 2, 0);

  ng_row(5);
  ng_select_ctl(1, "TARGET", "LPF|BPF|HPF|VOLUME", 0) ? update();
  sprintf(#v2, "%.1f ms", slider2);
  ng_knob_ctl(2, "ATTACK", #v2, 0.1, 100, 5, 0.1, 0) ? update();
  sprintf(#v3, "%d ms", slider3);
  ng_knob_ctl(3, "RELEASE", #v3, 10, 2000, 150, 1, 0) ? update();
  sprintf(#v4, "%+.1f dB", slider4);
  ng_knob_ctl(4, "SENSITIVITY", #v4, -24, 24, 0, 0.5, 1) ? update();
  ng_select_ctl(8, "DIRECTION", "UP|DOWN", 0) ? update();
  ng_row(4);
  slider5 >= 1000 ? sprintf(#v5, "%.2f kHz", slider5 / 1000) : sprintf(#v5, "%d Hz", slider5);
  ng_knob_ctl_log(5, "LOW FREQ", #v5, 20, 2000, 200, 1) ? update();
  slider6 >= 1000 ? sprintf(#v6, "%.2f kHz", slider6 / 1000) : sprintf(#v6, "%d Hz", slider6);
  ng_knob_ctl_log(6, "HIGH FREQ", #v6, 500, 15000, 3000, 10) ? update();
  sprintf(#v7, "%.1f", slider7);
  ng_knob_ctl(7, "RESONANCE", #v7, 0.5, 10, 3, 0.1, 0) ? update();
  sprintf(#v9, "%d%%", slider9);
  ng_knob_ctl(9, "MIX", #v9, 0, 100, 100, 1, 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
