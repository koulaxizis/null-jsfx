desc:NULL Phaser GFX
author: Christos Koulaxizis
tags: phaser modulation sweep notch moving filter allpass feedback stereo tempo sync gui
//category: Essentials
//NULL JSFX v2.9 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:0.5<0.1,5,0.1>-Rate (Hz)
slider2:4<1,8,1>-Stages
slider3:30<0,100,1>-Mix (%)
slider4:57<0,100,1>-Depth (%)
slider5:30<-95,95,1>-Feedback (%)
slider6:1020<200,5000,1:log>-Center (Hz)
slider7:0<0,180,1>-Stereo Phase (deg)
slider8:0<0,11,1{Off,1/1,1/2,1/4,1/8,1/16,2/1,4/1,1/4T,1/8T,1/4D,1/8D}>-Tempo Sync
slider9:0<0,2,1{Off,Up,Down}>-Barber Pole

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // NULL Phaser (../phaser.jsfx) with its own interface: same audio code, plus @gfx.
  lfo_phase = 0;
  ly1=0; ly2=0; ly3=0; ly4=0; ly5=0; ly6=0; ly7=0; ly8=0;
  lx1=0; lx2=0; lx3=0; lx4=0; lx5=0; lx6=0; lx7=0; lx8=0;
  ry1=0; ry2=0; ry3=0; ry4=0; ry5=0; ry6=0; ry7=0; ry8=0;
  rx1=0; rx2=0; rx3=0; rx4=0; rx5=0; rx6=0; rx7=0; rx8=0;
  last_l = 0;
  last_r = 0;

  // one allpass voice of the barber pole: up to 8 stages in a loop with feedback
  function pb_run(x, c) local(w)
  (
    w = x + this.last * feedback;
    this.y1 = c * (this.y1 + w) - this.x1;  this.x1 = w;  w = this.y1;
    stages >= 2 ? (this.y2 = c * (this.y2 + w) - this.x2;  this.x2 = w;  w = this.y2;);
    stages >= 3 ? (this.y3 = c * (this.y3 + w) - this.x3;  this.x3 = w;  w = this.y3;);
    stages >= 4 ? (this.y4 = c * (this.y4 + w) - this.x4;  this.x4 = w;  w = this.y4;);
    stages >= 5 ? (this.y5 = c * (this.y5 + w) - this.x5;  this.x5 = w;  w = this.y5;);
    stages >= 6 ? (this.y6 = c * (this.y6 + w) - this.x6;  this.x6 = w;  w = this.y6;);
    stages >= 7 ? (this.y7 = c * (this.y7 + w) - this.x7;  this.x7 = w;  w = this.y7;);
    stages >= 8 ? (this.y8 = c * (this.y8 + w) - this.x8;  this.x8 = w;  w = this.y8;);
    this.last = w;
  );
  // the two voices of a channel at sweep position p (0..1), half a sweep apart and faded in and
  // out with sin(pi p), so their powers always add up to one
  function pb_pair(x, p) local(q, da, db)
  (
    q = p + 0.5;
    q >= 1 ? q -= 1;
    da = d_min + 2 * d_sc * p;
    db = d_min + 2 * d_sc * q;
    sin($pi * p) * this.a.pb_run(x, (1 - da) / (1 + da)) + sin($pi * q) * this.b.pb_run(x, (1 - db) / (1 + db));
  );
  gfx_ext_retina = 1;

  function update()
  (
    rate = slider1;
    stages = floor(slider2);
    mix_amt = slider3 / 100;
    lfo_inc = 2 * $pi * rate / srate;
    // the sweep: Center +- a half-width that grows with Depth; the defaults (57%, 1020 Hz)
    // give 580 Hz, the classic 440 Hz to 1.6 kHz sweep
    sw_hw = 580 * (slider6 / 1020) * (slider4 / 57);
    d_min = (slider6 - sw_hw) * 2 / srate;
    d_max = (slider6 + sw_hw) * 2 / srate;
    d_sc = abs(d_max - d_min) * 0.5;
    d_min = d_min < d_max ? d_min : d_max;
    feedback = slider5 / 100;
    // above 30% the wet level is pulled down so the feedback peaks stay near the 30% level
    mix_w = abs(feedback) > 0.3 ? mix_amt * (1 - abs(feedback)) / 0.7 : mix_amt;
    st_on = slider7 > 0;
    st_off = slider7 / 180 * $pi;
    // Tempo Sync: one LFO cycle in beats
    sync_on = slider8 > 0;
    sync_beats = slider8 == 1 ? 4 : slider8 == 2 ? 2 : slider8 == 3 ? 1 : slider8 == 4 ? 0.5 :
                 slider8 == 5 ? 0.25 : slider8 == 6 ? 8 : slider8 == 7 ? 16 : slider8 == 8 ? 2 / 3 :
                 slider8 == 9 ? 1 / 3 : slider8 == 10 ? 1.5 : 0.75;
    bp = slider9;
  );

  // ---- display: the response at the current LFO position ----
  // |dry + mix * wet| in dB at f Hz for the allpass coefficient c: each stage is
  // (c - z^-1) / (1 - c z^-1), the chain sits in a loop with feedback over one sample
  function ph_db(f, c) local(w, th, dr, di, mg, cr, ci)
  (
    w = 2 * $pi * f / srate;
    th = stages * (atan2(sin(w), c - cos(w)) - atan2(c * sin(w), 1 - c * cos(w)));
    dr = 1 - feedback * cos(th - w);
    di = -feedback * sin(th - w);
    mg = dr * dr + di * di;
    cr = 1 + mix_w * (cos(th) * dr + sin(th) * di) / mg;
    ci = mix_w * (sin(th) * dr - cos(th) * di) / mg;
    10 * log10(max(cr * cr + ci * ci, 0.000000000001));
  );

  // the response curve for coefficient c in colour alpha a
  function ph_curve(c, a) local(i)
  (
    ng_col(NG_ACCENT, a);
    i = 0;
    loop(floor(ng_pw) + 1,
      ph_y = ng_lin_y(ph_db(20 * 1000 ^ (i / ng_pw), c), -16, 16);
      i == 0 ? ng_line_start(ng_px, ph_y) : ng_line_to(ng_px + i, ph_y);
      i += 1;
    );
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 16;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1); ng_hist_add(2); ng_hist_add(3); ng_hist_add(4); ng_hist_add(5); ng_hist_add(6); ng_hist_add(7); ng_hist_add(8); ng_hist_add(9);
  ng_hist_init();

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 0.5); ng_slider_set(2, 4); ng_slider_set(3, 30); ng_slider_set(4, 57); ng_slider_set(5, 30); ng_slider_set(6, 1020); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); );
    p == 1 ? ( ng_slider_set(1, 0.2); ng_slider_set(2, 6); ng_slider_set(3, 40); ng_slider_set(4, 57); ng_slider_set(5, 30); ng_slider_set(6, 1020); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); );
    p == 2 ? ( ng_slider_set(1, 0.8); ng_slider_set(2, 4); ng_slider_set(3, 50); ng_slider_set(4, 57); ng_slider_set(5, 30); ng_slider_set(6, 1020); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); );
    p == 3 ? ( ng_slider_set(1, 0.4); ng_slider_set(2, 2); ng_slider_set(3, 30); ng_slider_set(4, 57); ng_slider_set(5, 30); ng_slider_set(6, 1020); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); );
    p == 4 ? ( ng_slider_set(1, 4); ng_slider_set(2, 4); ng_slider_set(3, 45); ng_slider_set(4, 57); ng_slider_set(5, 30); ng_slider_set(6, 1020); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); );
    p == 5 ? ( ng_slider_set(1, 0.3); ng_slider_set(2, 8); ng_slider_set(3, 60); ng_slider_set(4, 57); ng_slider_set(5, 30); ng_slider_set(6, 1020); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); );
    p == 6 ? ( ng_slider_set(1, 1.5); ng_slider_set(2, 6); ng_slider_set(3, 25); ng_slider_set(4, 57); ng_slider_set(5, 30); ng_slider_set(6, 1020); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); );
    p == 7 ? ( ng_slider_set(1, 0.6); ng_slider_set(2, 8); ng_slider_set(3, 45); ng_slider_set(4, 57); ng_slider_set(5, 30); ng_slider_set(6, 1020); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); );
    p == 8 ? ( ng_slider_set(1, 0.1); ng_slider_set(2, 6); ng_slider_set(3, 45); ng_slider_set(4, 80); ng_slider_set(5, 40); ng_slider_set(6, 800); ng_slider_set(7, 90); ng_slider_set(8, 0); ng_slider_set(9, 0); );
    p == 9 ? ( ng_slider_set(1, 0.2); ng_slider_set(2, 8); ng_slider_set(3, 60); ng_slider_set(4, 95); ng_slider_set(5, 80); ng_slider_set(6, 1500); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); );
    p == 10 ? ( ng_slider_set(1, 0.5); ng_slider_set(2, 4); ng_slider_set(3, 45); ng_slider_set(4, 70); ng_slider_set(5, 50); ng_slider_set(6, 1020); ng_slider_set(7, 60); ng_slider_set(8, 2); ng_slider_set(9, 0); );
    p == 11 ? ( ng_slider_set(1, 0.3); ng_slider_set(2, 8); ng_slider_set(3, 55); ng_slider_set(4, 75); ng_slider_set(5, 90); ng_slider_set(6, 700); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); );
    p == 12 ? ( ng_slider_set(1, 0.5); ng_slider_set(2, 6); ng_slider_set(3, 50); ng_slider_set(4, 60); ng_slider_set(5, -75); ng_slider_set(6, 1200); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); );
    p == 13 ? ( ng_slider_set(1, 0.4); ng_slider_set(2, 4); ng_slider_set(3, 40); ng_slider_set(4, 57); ng_slider_set(5, 30); ng_slider_set(6, 1020); ng_slider_set(7, 180); ng_slider_set(8, 0); ng_slider_set(9, 0); );
    p == 14 ? ( ng_slider_set(1, 0.5); ng_slider_set(2, 6); ng_slider_set(3, 50); ng_slider_set(4, 85); ng_slider_set(5, 60); ng_slider_set(6, 1020); ng_slider_set(7, 0); ng_slider_set(8, 3); ng_slider_set(9, 0); );
    p == 15 ? ( ng_slider_set(1, 0.8); ng_slider_set(2, 4); ng_slider_set(3, 50); ng_slider_set(4, 70); ng_slider_set(5, 70); ng_slider_set(6, 300); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 0.5) && ng_pre_eq(slider2, 4) && ng_pre_eq(slider3, 30) && ng_pre_eq(slider4, 57) && ng_pre_eq(slider5, 30) && ng_pre_eq(slider6, 1020) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 0.2) && ng_pre_eq(slider2, 6) && ng_pre_eq(slider3, 40) && ng_pre_eq(slider4, 57) && ng_pre_eq(slider5, 30) && ng_pre_eq(slider6, 1020) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 0.8) && ng_pre_eq(slider2, 4) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 57) && ng_pre_eq(slider5, 30) && ng_pre_eq(slider6, 1020) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 0.4) && ng_pre_eq(slider2, 2) && ng_pre_eq(slider3, 30) && ng_pre_eq(slider4, 57) && ng_pre_eq(slider5, 30) && ng_pre_eq(slider6, 1020) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 4) && ng_pre_eq(slider2, 4) && ng_pre_eq(slider3, 45) && ng_pre_eq(slider4, 57) && ng_pre_eq(slider5, 30) && ng_pre_eq(slider6, 1020) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 0.3) && ng_pre_eq(slider2, 8) && ng_pre_eq(slider3, 60) && ng_pre_eq(slider4, 57) && ng_pre_eq(slider5, 30) && ng_pre_eq(slider6, 1020) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 1.5) && ng_pre_eq(slider2, 6) && ng_pre_eq(slider3, 25) && ng_pre_eq(slider4, 57) && ng_pre_eq(slider5, 30) && ng_pre_eq(slider6, 1020) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 0.6) && ng_pre_eq(slider2, 8) && ng_pre_eq(slider3, 45) && ng_pre_eq(slider4, 57) && ng_pre_eq(slider5, 30) && ng_pre_eq(slider6, 1020) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 0.1) && ng_pre_eq(slider2, 6) && ng_pre_eq(slider3, 45) && ng_pre_eq(slider4, 80) && ng_pre_eq(slider5, 40) && ng_pre_eq(slider6, 800) && ng_pre_eq(slider7, 90) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) ? m = 8;
    m < 0 && ng_pre_eq(slider1, 0.2) && ng_pre_eq(slider2, 8) && ng_pre_eq(slider3, 60) && ng_pre_eq(slider4, 95) && ng_pre_eq(slider5, 80) && ng_pre_eq(slider6, 1500) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) ? m = 9;
    m < 0 && ng_pre_eq(slider1, 0.5) && ng_pre_eq(slider2, 4) && ng_pre_eq(slider3, 45) && ng_pre_eq(slider4, 70) && ng_pre_eq(slider5, 50) && ng_pre_eq(slider6, 1020) && ng_pre_eq(slider7, 60) && ng_pre_eq(slider8, 2) && ng_pre_eq(slider9, 0) ? m = 10;
    m < 0 && ng_pre_eq(slider1, 0.3) && ng_pre_eq(slider2, 8) && ng_pre_eq(slider3, 55) && ng_pre_eq(slider4, 75) && ng_pre_eq(slider5, 90) && ng_pre_eq(slider6, 700) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) ? m = 11;
    m < 0 && ng_pre_eq(slider1, 0.5) && ng_pre_eq(slider2, 6) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 60) && ng_pre_eq(slider5, -75) && ng_pre_eq(slider6, 1200) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) ? m = 12;
    m < 0 && ng_pre_eq(slider1, 0.4) && ng_pre_eq(slider2, 4) && ng_pre_eq(slider3, 40) && ng_pre_eq(slider4, 57) && ng_pre_eq(slider5, 30) && ng_pre_eq(slider6, 1020) && ng_pre_eq(slider7, 180) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) ? m = 13;
    m < 0 && ng_pre_eq(slider1, 0.5) && ng_pre_eq(slider2, 6) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 85) && ng_pre_eq(slider5, 60) && ng_pre_eq(slider6, 1020) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 3) && ng_pre_eq(slider9, 0) ? m = 14;
    m < 0 && ng_pre_eq(slider1, 0.8) && ng_pre_eq(slider2, 4) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 70) && ng_pre_eq(slider5, 70) && ng_pre_eq(slider6, 300) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) ? m = 15;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Slow Pad Swirl";
    p == 2 ? s = "Classic Guitar Phase";
    p == 3 ? s = "Keys Gentle Motion";
    p == 4 ? s = "Fast Wobble";
    p == 5 ? s = "Deep Eight Stage";
    p == 6 ? s = "Drum Bus Shimmer";
    p == 7 ? s = "Psychedelic Vocal";
    p == 8 ? s = "Slow Phase Pad";
    p == 9 ? s = "Jet Phase";
    p == 10 ? s = "Synced Swirl";
    p == 11 ? s = "Deep Feedback";
    p == 12 ? s = "Negative Resonance";
    p == 13 ? s = "Wide Stereo Phase";
    p == 14 ? s = "Quarter Note Pulse";
    p == 15 ? s = "Low Growl";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@block
  // synced: the rate follows the host tempo, and while playing the phase is locked to
  // beat_position at the start of every block
  sync_on ? (
    lfo_inc = 2 * $pi * (tempo > 0 ? tempo : 120) / 60 / sync_beats / srate;
    play_state & 1 ? (
      sync_ph = beat_position / sync_beats;
      lfo_phase = 2 * $pi * (sync_ph - floor(sync_ph));
    );
  );

@sample
  lfo_phase += lfo_inc;
  lfo_phase >= 2 * $pi ? lfo_phase -= 2 * $pi;

  // Barber Pole: the LFO becomes a ramp (up or down) and two voices take turns, so the
  // sweep seems to rise or fall for ever; Stereo Phase moves the right channel's ramp
  bp ? (
    bp_p = lfo_phase / (2 * $pi);
    bp == 2 ? bp_p = 1 - bp_p;
    bp_p >= 1 ? bp_p -= 1;
    bp_r = bp_p + slider7 / 360;
    bp_r >= 1 ? bp_r -= 1;
    spl0 += vl.pb_pair(spl0, bp_p) * mix_w;
    spl1 += vr.pb_pair(spl1, st_on ? bp_r : bp_p) * mix_w;
  ) : (
  d = d_min + d_sc * (sin(lfo_phase) + 1);
  coef = (1 - d) / (1 + d);
  st_on ? (
    // the right channel's LFO runs Stereo Phase ahead
    d_r = d_min + d_sc * (sin(lfo_phase + st_off) + 1);
    coef_r = (1 - d_r) / (1 + d_r);
  ) : (
    coef_r = coef;
  );
  
  // Left channel
  wet_l = spl0 + last_l * feedback;
  
  ly1 = coef * (ly1 + wet_l) - lx1;  lx1 = wet_l;  wet_l = ly1;
  stages >= 2 ? (ly2 = coef * (ly2 + wet_l) - lx2;  lx2 = wet_l;  wet_l = ly2;);
  stages >= 3 ? (ly3 = coef * (ly3 + wet_l) - lx3;  lx3 = wet_l;  wet_l = ly3;);
  stages >= 4 ? (ly4 = coef * (ly4 + wet_l) - lx4;  lx4 = wet_l;  wet_l = ly4;);
  stages >= 5 ? (ly5 = coef * (ly5 + wet_l) - lx5;  lx5 = wet_l;  wet_l = ly5;);
  stages >= 6 ? (ly6 = coef * (ly6 + wet_l) - lx6;  lx6 = wet_l;  wet_l = ly6;);
  stages >= 7 ? (ly7 = coef * (ly7 + wet_l) - lx7;  lx7 = wet_l;  wet_l = ly7;);
  stages >= 8 ? (ly8 = coef * (ly8 + wet_l) - lx8;  lx8 = wet_l;  wet_l = ly8;);
  
  last_l = wet_l;
  spl0 += wet_l * mix_w;
  
  // Right channel
  wet_r = spl1 + last_r * feedback;
  
  ry1 = coef_r * (ry1 + wet_r) - rx1;  rx1 = wet_r;  wet_r = ry1;
  stages >= 2 ? (ry2 = coef_r * (ry2 + wet_r) - rx2;  rx2 = wet_r;  wet_r = ry2;);
  stages >= 3 ? (ry3 = coef_r * (ry3 + wet_r) - rx3;  rx3 = wet_r;  wet_r = ry3;);
  stages >= 4 ? (ry4 = coef_r * (ry4 + wet_r) - rx4;  rx4 = wet_r;  wet_r = ry4;);
  stages >= 5 ? (ry5 = coef_r * (ry5 + wet_r) - rx5;  rx5 = wet_r;  wet_r = ry5;);
  stages >= 6 ? (ry6 = coef_r * (ry6 + wet_r) - rx6;  rx6 = wet_r;  wet_r = ry6;);
  stages >= 7 ? (ry7 = coef_r * (ry7 + wet_r) - rx7;  rx7 = wet_r;  wet_r = ry7;);
  stages >= 8 ? (ry8 = coef_r * (ry8 + wet_r) - rx8;  rx8 = wet_r;  wet_r = ry8;);
  
  last_r = wet_r;
  spl1 += wet_r * mix_w;
  );

@gfx 480 380
  ng_knobs_begin("PHASER", "ESSENTIALS", 480, 120, 2, 0);

  // display: the response (dry plus wet) at the current LFO position, the sweep range shaded;
  // with Stereo Phase the right channel's curve is dimmer
  ng_plot(ng_vx + 26, ng_vy + 4, ng_vw - 30, ng_vh - 20);
  ng_grid_freq(24);
  ph_xl = ng_freq_x(d_min * srate / 2);
  ph_xh = ng_freq_x((d_min + 2 * d_sc) * srate / 2);
  ng_col(NG_ACCENT, 0.07);
  gfx_rect(ph_xl, ng_py, max(1, ph_xh - ph_xl), ng_ph);
  ph_n = floor(slider2 / 2);
  slider2 < 2 ? strcpy(#ph_s, "1 STAGE, NO NOTCH") :
  ph_n == 1 ? sprintf(#ph_s, "%d STAGES, 1 NOTCH", slider2) : sprintf(#ph_s, "%d STAGES, %d NOTCHES", slider2, ph_n);
  ng_font(4, 8, 0);
  ng_col(NG_MUTED, 1);
  ng_ptxt(#ph_s, ng_px + ng_pw - 6 * ng_s, ng_py + 9 * ng_s, 2);
  slider7 > 0 ? (
    ph_d = bp ? d_min + 2 * d_sc * bp_r : d_min + d_sc * (sin(lfo_phase + st_off) + 1);
    ph_curve((1 - ph_d) / (1 + ph_d), 0.45);
  );
  ph_d = bp ? d_min + 2 * d_sc * bp_p : d_min + d_sc * (sin(lfo_phase) + 1);
  ph_curve((1 - ph_d) / (1 + ph_d), 1);

  ng_row(4);
  slider8 ? strcpy(#v1, "SYNC") : sprintf(#v1, "%.1f Hz", slider1);
  ng_knob_ctl(1, "RATE", #v1, 0.1, 5, 0.5, 0.1, 0) ? update();
  sprintf(#v2, "%d", slider2);
  ng_knob_ctl(2, "STAGES", #v2, 1, 8, 4, 1, 0) ? update();
  sprintf(#v3, "%d%%", slider3);
  ng_knob_ctl(3, "MIX", #v3, 0, 100, 30, 1, 0) ? update();
  sprintf(#v4, "%d%%", slider4);
  ng_knob_ctl(4, "DEPTH", #v4, 0, 100, 57, 1, 0) ? update();
  ng_row(5);
  sprintf(#v5, "%d%%", slider5);
  ng_knob_ctl(5, "FEEDBACK", #v5, -95, 95, 30, 1, 1) ? update();
  slider6 >= 1000 ? sprintf(#v6, "%.2f kHz", slider6 / 1000) : sprintf(#v6, "%d Hz", slider6);
  ng_knob_ctl_log(6, "CENTER", #v6, 200, 5000, 1020, 1) ? update();
  sprintf(#v7, "%d deg", slider7);
  ng_knob_ctl(7, "STEREO", #v7, 0, 180, 0, 1, 0) ? update();
  ng_select_ctl(8, "SYNC", "OFF|1/1|1/2|1/4|1/8|1/16|2/1|4/1|1/4T|1/8T|1/4D|1/8D", 0) ? update();
  ng_select_ctl(9, "BARBER", "OFF|UP|DOWN", 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
