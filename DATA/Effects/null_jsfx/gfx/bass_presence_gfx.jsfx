desc:NULL Bass Presence GFX
author: Christos Koulaxizis
tags: bass presence harmonics small speakers phone laptop psychoacoustic missing fundamental low end audible one knob gui
//category: One Slider
//NULL JSFX v4.2.1 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:40<0,100,1>-Amount

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // NULL Bass Presence (../bass_presence.jsfx) with its own interface: same audio code, plus @gfx.
  // One-knob bass presence for small speakers: the lows below 120 Hz (the mono sum) drive a
  // curve that makes both odd and even harmonics, and only those harmonics (180 Hz to 1.8 kHz)
  // are added back to both channels. A phone or laptop that cannot play the fundamental still
  // plays its harmonics, and the ear hears the bass note from them. The bass itself is not
  // touched. Quiet bass makes fewer harmonics, loud bass more, as in a real circuit.
  // At 0 the signal is untouched.
  bp_k = 2; bp_g = 0;

  // RBJ biquads (normalised), transposed direct form II; f is held below 0.45 x srate
  function bq_lp(f, q) local(w, al) instance(b0, b1, b2, a1, a2)
  (
    w = 2 * $pi * min(f, 0.45 * srate) / srate; al = sin(w) / (2 * q);
    b0 = (1 - cos(w)) / 2 / (1 + al); b1 = (1 - cos(w)) / (1 + al); b2 = b0;
    a1 = -2 * cos(w) / (1 + al); a2 = (1 - al) / (1 + al);
  );
  function bq_hp(f, q) local(w, al) instance(b0, b1, b2, a1, a2)
  (
    w = 2 * $pi * min(f, 0.45 * srate) / srate; al = sin(w) / (2 * q);
    b0 = (1 + cos(w)) / 2 / (1 + al); b1 = -(1 + cos(w)) / (1 + al); b2 = b0;
    a1 = -2 * cos(w) / (1 + al); a2 = (1 - al) / (1 + al);
  );
  function bq(x) local(y) instance(b0, b1, b2, a1, a2, z1, z2)
  (
    y = b0 * x + z1;
    z1 = b1 * x - a1 * y + z2;
    z2 = b2 * x - a2 * y;
    abs(z1) < 0.000000000000000000001 ? z1 = 0;
    abs(z2) < 0.000000000000000000001 ? z2 = 0;
    y;
  );
  // the harmonic curve: a soft clip (odd harmonics) plus a smooth rectifier (even ones),
  // scaled back by the drive so its small-signal level follows the input
  function bp_curve(x) local(v)
  (
    v = bp_k * x;
    (0.6 * v / sqrt(1 + v * v) + 0.8 * (sqrt(1 + v * v) - 1)) / bp_k;
  );

  bp_lo.bq_lp(120, 0.707);
  bp_lo2.bq_lp(120, 0.707);
  bp_hp.bq_hp(180, 0.707);
  bp_hp2.bq_hp(180, 0.707);
  bp_lp.bq_lp(1800, 0.707);

  gfx_ext_retina = 1;

  function update()
  (
    bp_a = slider1 / 100;
    bp_k = 2 + 10 * bp_a;        // drive into the curve
    bp_g = 6 * bp_a;             // level of the harmonics added
  );

  // a text at pixel (x, y), vertically centred; align 0 left, 1 centre, 2 right
  function bp_lbl(str, x, y, align) local(w, h)
  (
    gfx_measurestr(str, w, h);
    gfx_x = align == 1 ? x - w / 2 : (align == 2 ? x - w : x);
    gfx_y = y - gfx_texth / 2;
    gfx_drawstr(str);
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 12;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1);
  ng_hist_init();
  ng_dice_add(1, 0, 100, 1, 0);

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 40); );
    p == 1 ? ( ng_slider_set(1, 50); );
    p == 2 ? ( ng_slider_set(1, 75); );
    p == 3 ? ( ng_slider_set(1, 20); );
    p == 4 ? ( ng_slider_set(1, 35); );
    p == 5 ? ( ng_slider_set(1, 65); );
    p == 6 ? ( ng_slider_set(1, 45); );
    p == 7 ? ( ng_slider_set(1, 55); );
    p == 8 ? ( ng_slider_set(1, 40); );
    p == 9 ? ( ng_slider_set(1, 15); );
    p == 10 ? ( ng_slider_set(1, 90); );
    p == 11 ? ( ng_slider_set(1, 100); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 40) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 50) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 75) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 20) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 35) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 65) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 45) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 55) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 40) ? m = 8;
    m < 0 && ng_pre_eq(slider1, 15) ? m = 9;
    m < 0 && ng_pre_eq(slider1, 90) ? m = 10;
    m < 0 && ng_pre_eq(slider1, 100) ? m = 11;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Laptop Bass";
    p == 2 ? s = "Phone Speaker";
    p == 3 ? s = "Subtle Lift";
    p == 4 ? s = "Earbud Check";
    p == 5 ? s = "808 Presence";
    p == 6 ? s = "Bass Guitar Growl";
    p == 7 ? s = "Synth Bass Edge";
    p == 8 ? s = "Kick Readable";
    p == 9 ? s = "Mix Bus Touch";
    p == 10 ? s = "Small Radio";
    p == 11 ? s = "Full Harmonics";
    s;
  );

  // the hint line under the controls: a short help text per slider (from tools/site_content.json)
  function ng_hint_text(i) local(s)
  (
    s = "";
    i == 1 ? s = "How much of the bass's harmonics is added (0% = off)";
    s;
  );

  function ng_presets() local(i)
  (
    ng_hint_i > 0 && !ng_pre_open ? ng_hint(ng_hint_text(ng_hint_i));
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----
@slider
  update();

@sample
  bp_a > 0 ? (
    bp_x = bp_lo2.bq(bp_lo.bq((spl0 + spl1) * 0.5));
    bp_h = bp_lp.bq(bp_hp2.bq(bp_hp.bq(bp_curve(bp_x)))) * bp_g;
    spl0 += bp_h;
    spl1 += bp_h;
  );

@gfx 360 240
  ng_one_slider_begin("BASS PRESENCE");

  // display: the harmonic curve (the low band in across, what it makes up, before the
  // 180 Hz to 1.8 kHz band-pass and the level of Amount)
  ng_plot(46, 64, 284, 78);
  ng_grid(4, 4, 0);
  ng_font(4, 8, 0);
  ng_col(NG_MUTED, 1);
  bp_lbl("1", ng_px - 6 * ng_s, floor(ng_py) + 0.5, 2);
  bp_lbl("0", ng_px - 6 * ng_s, floor(ng_py + ng_ph / 2) + 0.5, 2);
  bp_lbl("-1", ng_px - 6 * ng_s, floor(ng_py + ng_ph) + 0.5, 2);
  bp_lbl("-0.5", ng_px + ng_pw / 4, ng_py + ng_ph + 11 * ng_s, 1);
  bp_lbl("LOWS IN", ng_px + ng_pw / 2, ng_py + ng_ph + 11 * ng_s, 1);
  bp_lbl("0.5", ng_px + ng_pw * 3 / 4, ng_py + ng_ph + 11 * ng_s, 1);
  ng_col(NG_MUTED, 0.6);
  ng_line_start(ng_px, ng_py + ng_ph);
  ng_line_to(ng_px + ng_pw, ng_py);
  ng_col(NG_ACCENT, 1);
  bp_i = 0;
  loop(floor(ng_pw) + 1,
    bp_y = ng_lin_y(bp_curve(2 * bp_i / ng_pw - 1), -1, 1);
    bp_i == 0 ? ng_line_start(ng_px, bp_y) : ng_line_to(ng_px + bp_i, bp_y);
    bp_i += 1;
  );

  // slider card
  slider1 == 0 ? sprintf(#cap, "CLEAN") : sprintf(#cap, "HARMONICS 180 HZ - 1.8 KHZ  %+.1f DB", 20 * log10(bp_g));
  sprintf(#val, "%d", floor(slider1 + 0.5));
  ng_set_slider(ng_one_slider_control("AMOUNT", #cap, #val, "CLEAN", "PRESENT", slider1, 0, 100, 40, 0), 1) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
