desc:NULL De-Hum GFX
author: Christos Koulaxizis
tags: hum mains notch noise reduction repair restoration ground loop buzz rumble gui
//category: Essentials
//NULL JSFX v2.1 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:0<0,1,1{50 Hz,60 Hz}>-Frequency
slider2:4<1,8,1>-Harmonics
slider3:30<5,100,1>-Q
slider4:40<0,60,1>-Depth (dB)
slider5:0<-2,2,0.01>-Fine (Hz)
slider6:0<0,3,1{Off,20 Hz,30 Hz,40 Hz}>-Low Cut

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  // NULL De-Hum (../de_hum.jsfx) with its own interface: same audio code, plus @gfx.
  // Removes mains hum: a cascade of narrow notches at the mains frequency (50 or 60 Hz, plus
  // Fine) and at its multiples, Harmonics notches in all (1 = the fundamental only). Q sets
  // the notch width (bandwidth = frequency / Q), Depth how deep each notch cuts. Low Cut adds
  // a 24 dB/oct high-pass below the hum for rumble.
  co = 0;      // 8 notches x 5 coefficients: b0, b1, b2, a1, a2
  st = 40;     // 8 notches x 4 states: z1, z2 left, z1, z2 right
  memset(st, 0, 32);
  freembuf(st + 32);
  l_lc1.ic1 = l_lc1.ic2 = l_lc2.ic1 = l_lc2.ic2 = 0;
  r_lc1.ic1 = r_lc1.ic2 = r_lc2.ic1 = r_lc2.ic2 = 0;

  // TPT state-variable high-pass stage (state in this.ic1 / this.ic2)
  function svf_hp(x, a1, a2, a3, k) local(v1, v2, v3)
  (
    v3 = x - this.ic2;
    v1 = a1 * this.ic1 + a2 * v3;
    v2 = this.ic2 + a2 * this.ic1 + a3 * v3;
    this.ic1 = 2 * v1 - this.ic1;
    this.ic2 = 2 * v2 - this.ic2;
    x - k * v1 - v2;
  );

  // coefficients of one stage for g = tan(pi fc / srate) and q, into this.a1 .. this.k
  function stage(g, q)
  (
    this.k = 1 / q;
    this.a1 = 1 / (1 + g * (g + this.k));
    this.a2 = g * this.a1;
    this.a3 = g * this.a2;
  );

  // flushes a stage's state once it decays below -300 dB (no denormals in silence)
  function flush()
  (
    abs(this.ic1) < 0.000000000000001 ? this.ic1 = 0;
    abs(this.ic2) < 0.000000000000001 ? this.ic2 = 0;
  );

  function update()
  (
    f0 = (slider1 < 0.5 ? 50 : 60) + slider5;
    nh = slider2;
    gd = 10 ^ (0 - slider4 / 20);
    // notch h: poles of a band of width f / Q, zeros pulled in to gain gd at the centre
    h = 0;
    loop(8,
      w = 2 * $pi * min(f0 * (h + 1), srate * 0.45) / srate;
      al = sin(w) / (2 * slider3);
      cw = cos(w);
      a0 = 1 + al;
      co[h * 5] = (1 + al * gd) / a0;
      co[h * 5 + 1] = -2 * cw / a0;
      co[h * 5 + 2] = (1 - al * gd) / a0;
      co[h * 5 + 3] = -2 * cw / a0;
      co[h * 5 + 4] = (1 - al) / a0;
      // notches that are off start from silence when they come back
      h >= nh ? memset(st + h * 4, 0, 4);
      h += 1;
    );
    lc = slider6;
    lc > 0 ? (
      g = tan($pi * (10 + 10 * lc) / srate);
      lc1.stage(g, 0.5412);
      lc2.stage(g, 1.3066);
    ) : (
      l_lc1.ic1 = l_lc1.ic2 = l_lc2.ic1 = l_lc2.ic2 = 0;
      r_lc1.ic1 = r_lc1.ic2 = r_lc2.ic1 = r_lc2.ic2 = 0;
    );
  );

  // display: magnitude (dB) of the whole chain at f: the notches from their coefficients,
  // the Low Cut stages as the bilinear transform of s^2 / (s^2 + k s + 1)
  function dh_db(f) local(w, cr, ci, c2r, c2i, m, j, br, bi, ar, ai, o)
  (
    w = 2 * $pi * min(f, srate * 0.4999) / srate;
    cr = cos(w); ci = 0 - sin(w);
    c2r = cos(2 * w); c2i = 0 - sin(2 * w);
    m = 0;
    j = 0;
    loop(nh,
      br = co[j] + co[j + 1] * cr + co[j + 2] * c2r;
      bi = co[j + 1] * ci + co[j + 2] * c2i;
      ar = 1 + co[j + 3] * cr + co[j + 4] * c2r;
      ai = co[j + 3] * ci + co[j + 4] * c2i;
      m += 10 * log10(max(br * br + bi * bi, 0.000000000000000000000000000001) / max(ar * ar + ai * ai, 0.000000000000000000000000000001));
      j += 5;
    );
    lc > 0 ? (
      o = tan($pi * min(f, srate * 0.4999) / srate) / tan($pi * (10 + 10 * lc) / srate);
      o *= o;
      m += 10 * log10(max(o * o / ((1 - o) * (1 - o) + o / (0.5412 * 0.5412)), 0.000000000000000000000000000001));
      m += 10 * log10(max(o * o / ((1 - o) * (1 - o) + o / (1.3066 * 1.3066)), 0.000000000000000000000000000001));
    );
    m;
  );

  // display: design x of f on the 20 Hz .. 2 kHz axis
  function dh_x(f) ( dh_px + dh_pw * log(max(f, 20) / 20) / log(100); );

  gfx_ext_retina = 1;

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 8;

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 0); ng_slider_set(2, 4); ng_slider_set(3, 30); ng_slider_set(4, 40); ng_slider_set(5, 0); ng_slider_set(6, 0); );
    p == 1 ? ( ng_slider_set(1, 0); ng_slider_set(2, 6); ng_slider_set(3, 40); ng_slider_set(4, 40); ng_slider_set(5, 0); ng_slider_set(6, 1); );
    p == 2 ? ( ng_slider_set(1, 1); ng_slider_set(2, 6); ng_slider_set(3, 40); ng_slider_set(4, 40); ng_slider_set(5, 0); ng_slider_set(6, 1); );
    p == 3 ? ( ng_slider_set(1, 0); ng_slider_set(2, 8); ng_slider_set(3, 30); ng_slider_set(4, 35); ng_slider_set(5, 0); ng_slider_set(6, 0); );
    p == 4 ? ( ng_slider_set(1, 1); ng_slider_set(2, 8); ng_slider_set(3, 30); ng_slider_set(4, 35); ng_slider_set(5, 0); ng_slider_set(6, 0); );
    p == 5 ? ( ng_slider_set(1, 0); ng_slider_set(2, 3); ng_slider_set(3, 60); ng_slider_set(4, 30); ng_slider_set(5, 0); ng_slider_set(6, 0); );
    p == 6 ? ( ng_slider_set(1, 1); ng_slider_set(2, 3); ng_slider_set(3, 60); ng_slider_set(4, 30); ng_slider_set(5, 0); ng_slider_set(6, 0); );
    p == 7 ? ( ng_slider_set(1, 0); ng_slider_set(2, 4); ng_slider_set(3, 25); ng_slider_set(4, 50); ng_slider_set(5, 0); ng_slider_set(6, 3); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 4) && ng_pre_eq(slider3, 30) && ng_pre_eq(slider4, 40) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 6) && ng_pre_eq(slider3, 40) && ng_pre_eq(slider4, 40) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 1) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 6) && ng_pre_eq(slider3, 40) && ng_pre_eq(slider4, 40) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 1) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 8) && ng_pre_eq(slider3, 30) && ng_pre_eq(slider4, 35) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 8) && ng_pre_eq(slider3, 30) && ng_pre_eq(slider4, 35) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 3) && ng_pre_eq(slider3, 60) && ng_pre_eq(slider4, 30) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 3) && ng_pre_eq(slider3, 60) && ng_pre_eq(slider4, 30) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 4) && ng_pre_eq(slider3, 25) && ng_pre_eq(slider4, 50) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 3) ? m = 7;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Mains Clean 50 Hz";
    p == 2 ? s = "Mains Clean 60 Hz";
    p == 3 ? s = "Amp Buzz 50 Hz";
    p == 4 ? s = "Amp Buzz 60 Hz";
    p == 5 ? s = "Vocal Safe 50 Hz";
    p == 6 ? s = "Vocal Safe 60 Hz";
    p == 7 ? s = "Heavy Hum And Rumble";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----


@slider
  update();

@block
  l_lc1.flush(); l_lc2.flush(); r_lc1.flush(); r_lc2.flush();
  h = 0;
  loop(32,
    abs(st[h]) < 0.000000000000001 ? st[h] = 0;
    h += 1;
  );

@sample
  xl = spl0;
  xr = spl1;
  lc > 0 ? (
    xl = l_lc2.svf_hp(l_lc1.svf_hp(xl, lc1.a1, lc1.a2, lc1.a3, lc1.k), lc2.a1, lc2.a2, lc2.a3, lc2.k);
    xr = r_lc2.svf_hp(r_lc1.svf_hp(xr, lc1.a1, lc1.a2, lc1.a3, lc1.k), lc2.a1, lc2.a2, lc2.a3, lc2.k);
  );
  c = co;
  s = st;
  loop(nh,
    yo = c[0] * xl + s[0];
    s[0] = c[1] * xl - c[3] * yo + s[1];
    s[1] = c[2] * xl - c[4] * yo;
    xl = yo;
    yo = c[0] * xr + s[2];
    s[2] = c[1] * xr - c[3] * yo + s[3];
    s[3] = c[2] * xr - c[4] * yo;
    xr = yo;
    c += 5;
    s += 4;
  );
  spl0 = xl;
  spl1 = xr;

@gfx 480 294
  ng_knobs_begin("DE-HUM", "ESSENTIALS", 480, 120, 1, 0);

  // display: the response of the whole chain from 20 Hz to 2 kHz, notches at the mains
  // frequency and its harmonics; where a notch is narrower than a column it shows its depth
  dh_px = ng_vx + 26; dh_py = ng_vy + 4; dh_pw = ng_vw - 30; dh_ph = ng_vh - 20;
  ng_plot(dh_px, dh_py, dh_pw, dh_ph);
  dh_d = 10;
  loop(3,
    dh_m = 1;
    loop(9,
      dh_f = dh_m * dh_d;
      dh_f >= 20 && dh_f <= 2000 ? (
        dh_xx = floor(X(dh_x(dh_f))) + 0.5;
        ng_col(NG_BORDER, dh_m == 1 ? 1 : 0.5);
        gfx_line(dh_xx, ng_py, dh_xx, ng_py + ng_ph, 0);
      );
      dh_m += 1;
    );
    dh_d *= 10;
  );
  ng_font(4, 8, 0);
  dh_db0 = 0;
  loop(3,
    dh_yy = floor(ng_lin_y(dh_db0, -64, 8)) + 0.5;
    ng_col(dh_db0 == 0 ? 0x45433f : NG_BORDER, dh_db0 == 0 ? 1 : 0.6);
    gfx_line(ng_px, dh_yy, ng_px + ng_pw, dh_yy, 0);
    ng_col(NG_MUTED, 1);
    sprintf(#dh_l, "%d", dh_db0);
    ng_txt(#dh_l, dh_px - 6, (dh_yy - ng_oy) / ng_s, 2, 0);
    dh_db0 -= 24;
  );
  ng_txt("50", dh_x(50), dh_py + dh_ph + 11, 1, 0);
  ng_txt("100", dh_x(100), dh_py + dh_ph + 11, 1, 0);
  ng_txt("200", dh_x(200), dh_py + dh_ph + 11, 1, 0);
  ng_txt("500", dh_x(500), dh_py + dh_ph + 11, 1, 0);
  ng_txt("1k", dh_x(1000), dh_py + dh_ph + 11, 1, 0);

  dh_zy = ng_lin_y(0, -64, 8);
  dh_i = 0;
  loop(floor(ng_pw),
    dh_mn = 1000; dh_mx = -1000;
    dh_j = 0;
    loop(7,
      dh_v = dh_db(20 * 100 ^ ((dh_i + dh_j / 6) / ng_pw));
      dh_mn = min(dh_mn, dh_v); dh_mx = max(dh_mx, dh_v);
      dh_j += 1;
    );
    // a notch centre inside this column
    dh_j = 1;
    loop(nh,
      dh_f = min(f0 * dh_j, srate * 0.45);
      dh_c = log(dh_f / 20) / log(100) * ng_pw;
      dh_c >= dh_i && dh_c < dh_i + 1 ? dh_mn = min(dh_mn, dh_db(dh_f));
      dh_j += 1;
    );
    dh_y1 = ng_lin_y(dh_mx, -64, 8);
    dh_y2 = ng_lin_y(dh_mn, -64, 8);
    ng_col(NG_ACCENT, 0.10);
    dh_y2 > dh_zy ? gfx_rect(ng_px + dh_i, dh_zy, 1, dh_y2 - dh_zy);
    ng_col(NG_ACCENT, 1);
    gfx_rect(ng_px + dh_i, dh_y1 - ng_s, 1, dh_y2 - dh_y1 + 2 * ng_s);
    dh_i += 1;
  );

  ng_row(6);
  ng_select_ctl(1, "MAINS", "50 HZ|60 HZ", 0) ? update();
  sprintf(#v2, "%d", slider2);
  ng_knob_ctl(2, "HARMONICS", #v2, 1, 8, 4, 1, 0) ? update();
  sprintf(#v3, "%d", slider3);
  ng_knob_ctl(3, "Q", #v3, 5, 100, 30, 1, 0) ? update();
  sprintf(#v4, "%d dB", slider4);
  ng_knob_ctl(4, "DEPTH", #v4, 0, 60, 40, 1, 0) ? update();
  sprintf(#v5, "%+.2f Hz", slider5);
  ng_knob_ctl(5, "FINE", #v5, -2, 2, 0, 0.01, 1) ? update();
  ng_select_ctl(6, "LOW CUT", "OFF|20 HZ|30 HZ|40 HZ", 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
