desc:NULL Octaver GFX
author: Christos Koulaxizis
tags: octave octaver octave divider sub octave bass guitar analog flip-flop synth gui
//category: Essentials
//NULL JSFX v2.0 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:100<0,100,1>-Dry (%)
slider2:70<0,100,1>-Oct -1 (%)
slider3:35<0,100,1>-Oct -2 (%)
slider4:0<0,100,1>-Up (%)
slider5:900<100,5000,1:log>-Tone (Hz)
slider6:300<60,1000,1:log>-Tracking (Hz)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  // NULL Octaver (../octaver.jsfx) with its own interface: same audio code, plus @gfx.
  // Analog-style octave divider (the OC-2 idea) for monophonic bass and guitar, zero latency:
  //   the input (mono sum, DC removed) is low-passed at Tracking (two one-poles) so only the
  //   fundamental crosses zero; a Schmitt trigger (hysteresis 20% of its peak) clocks a
  //   flip-flop that toggles on every rising crossing (half the frequency, -1 octave), which
  //   clocks a second flip-flop (-2 octaves). The square waves follow the input's envelope.
  //   Up: the tracked signal full-wave rectified (twice the frequency), normalised, DC removed
  //   and also following the envelope.
  // The voices are mixed, low-passed at Tone (two one-poles, round) and added to the dry signal.
  dc_r = 1 - 2 * $pi * 20 / srate;
  up_r = 1 - 2 * $pi * 30 / srate;
  env_a = 1 - exp(-1 / (0.001 * srate));
  env_r = 1 - exp(-1 / (0.06 * srate));
  env_s = 1 - exp(-1 / (0.008 * srate));
  trk_rel = exp(-1 / (0.1 * srate));
  sm_k = 1 - exp(-1 / (0.01 * srate));
  dc_x1 = dc_y = 0;
  env1 = env = 0;
  t1 = t2 = tenv = 0;
  sch = -1;
  ff1 = ff2 = 1;
  up_x1 = up_y = 0;
  lp1 = lp2 = 0;
  sm_first = 1;

  // one-pole glide of v to t, snapped when it is there
  function glide(v, t) ( v += sm_k * (t - v); abs(t - v) < 0.000000000001 ? t : v; );
  gfx_ext_retina = 1;
  // display only: scope taps of the output, level meters per voice and the tracked pitch
  ng_tap_init(4000000, 2048);
  oc_rel = exp(-1 / (0.3 * srate));
  oc_min = oc_m1 = oc_m2 = oc_mu = oc_mout = 0;
  oc_ff = ff1;
  oc_cnt = 0;
  oc_hz = 0;

  function update()
  (
    t_gd = slider1 / 100;
    t_g1 = slider2 / 100 * 0.7;
    t_g2 = slider3 / 100 * 0.7;
    t_gu = slider4 / 100;
    tone_k = 1 - exp(-2 * $pi * slider5 / srate);
    trk_k = 1 - exp(-2 * $pi * slider6 / srate);
    sm_first ? (
      gd = t_gd; g1 = t_g1; g2 = t_g2; gu = t_gu;
      sm_first = 0;
    );
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 8;

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 100); ng_slider_set(2, 70); ng_slider_set(3, 35); ng_slider_set(4, 0); ng_slider_set(5, 900); ng_slider_set(6, 300); );
    p == 1 ? ( ng_slider_set(1, 100); ng_slider_set(2, 60); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 600); ng_slider_set(6, 200); );
    p == 2 ? ( ng_slider_set(1, 100); ng_slider_set(2, 60); ng_slider_set(3, 25); ng_slider_set(4, 0); ng_slider_set(5, 500); ng_slider_set(6, 100); );
    p == 3 ? ( ng_slider_set(1, 100); ng_slider_set(2, 70); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 1500); ng_slider_set(6, 500); );
    p == 4 ? ( ng_slider_set(1, 80); ng_slider_set(2, 60); ng_slider_set(3, 50); ng_slider_set(4, 0); ng_slider_set(5, 400); ng_slider_set(6, 150); );
    p == 5 ? ( ng_slider_set(1, 0); ng_slider_set(2, 80); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 300); ng_slider_set(6, 200); );
    p == 6 ? ( ng_slider_set(1, 80); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 60); ng_slider_set(5, 4000); ng_slider_set(6, 600); );
    p == 7 ? ( ng_slider_set(1, 90); ng_slider_set(2, 50); ng_slider_set(3, 30); ng_slider_set(4, 40); ng_slider_set(5, 2500); ng_slider_set(6, 400); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 100) && ng_pre_eq(slider2, 70) && ng_pre_eq(slider3, 35) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 900) && ng_pre_eq(slider6, 300) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 100) && ng_pre_eq(slider2, 60) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 600) && ng_pre_eq(slider6, 200) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 100) && ng_pre_eq(slider2, 60) && ng_pre_eq(slider3, 25) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 500) && ng_pre_eq(slider6, 100) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 100) && ng_pre_eq(slider2, 70) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 1500) && ng_pre_eq(slider6, 500) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 80) && ng_pre_eq(slider2, 60) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 400) && ng_pre_eq(slider6, 150) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 80) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 300) && ng_pre_eq(slider6, 200) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 80) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 60) && ng_pre_eq(slider5, 4000) && ng_pre_eq(slider6, 600) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 90) && ng_pre_eq(slider2, 50) && ng_pre_eq(slider3, 30) && ng_pre_eq(slider4, 40) && ng_pre_eq(slider5, 2500) && ng_pre_eq(slider6, 400) ? m = 7;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Bass Sub Octave";
    p == 2 ? s = "Five String Bass";
    p == 3 ? s = "Guitar Octave Down";
    p == 4 ? s = "Deep Synth Bass";
    p == 5 ? s = "Sub Only Layer";
    p == 6 ? s = "Octave Up Lead";
    p == 7 ? s = "Organ Stack";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  in_x = (spl0 + spl1) * 0.5;
  dc_y = in_x - dc_x1 + dc_r * dc_y;
  dc_x1 = in_x;

  // envelope the voices follow: 1 ms attack, 60 ms release, 8 ms smoothing
  env_x = abs(dc_y);
  env1 += (env_x > env1 ? env_a : env_r) * (env_x - env1);
  env += env_s * (env1 - env);

  // tracking filter, its peak, and the Schmitt trigger clocking the flip-flops
  t1 += trk_k * (dc_y - t1);
  t2 += trk_k * (t1 - t2);
  trk_x = abs(t2);
  tenv = trk_x > tenv ? trk_x : tenv * trk_rel;
  hyst = tenv * 0.2 + 0.00001;
  sch > 0 ? (
    t2 < -hyst ? sch = -1;
  ) : (
    t2 > hyst ? (
      sch = 1;
      ff1 = -ff1;
      ff1 > 0 ? ff2 = -ff2;
    );
  );

  // up: rectified tracked signal, normalised to its peak, DC removed
  up_x = trk_x / max(tenv, 0.00001);
  up_y = up_x - up_x1 + up_r * up_y;
  up_x1 = up_x;

  gd = glide(gd, t_gd); g1 = glide(g1, t_g1);
  g2 = glide(g2, t_g2); gu = glide(gu, t_gu);
  sq1 = ff1 * env;
  sq2 = ff2 * env;
  upv = 2 * up_y * env;
  vox = g1 * sq1 + g2 * sq2 + gu * upv;
  lp1 += tone_k * (vox - lp1);
  lp2 += tone_k * (lp1 - lp2);

  abs(env1) < 0.000000000000001 ? env1 = 0;
  abs(env) < 0.000000000000001 ? env = 0;
  abs(t1) < 0.000000000000001 ? t1 = 0;
  abs(t2) < 0.000000000000001 ? t2 = 0;
  abs(dc_y) < 0.000000000000001 ? dc_y = 0;
  abs(lp1) < 0.000000000000001 ? lp1 = 0;
  abs(lp2) < 0.000000000000001 ? lp2 = 0;
  abs(tenv) < 0.000000000000001 ? tenv = 0;
  abs(up_y) < 0.000000000000001 ? up_y = 0;

  spl0 = spl0 * gd + lp2;
  spl1 = spl1 * gd + lp2;

  // display only (reads the signals, never changes them): peak levels, and the input period
  // from the flip-flop (it toggles once per input cycle)
  oc_v = abs(in_x); oc_v > oc_min ? oc_min = oc_v : oc_min *= oc_rel;
  oc_v = abs(g1 * sq1); oc_v > oc_m1 ? oc_m1 = oc_v : oc_m1 *= oc_rel;
  oc_v = abs(g2 * sq2); oc_v > oc_m2 ? oc_m2 = oc_v : oc_m2 *= oc_rel;
  oc_v = abs(gu * upv); oc_v > oc_mu ? oc_mu = oc_v : oc_mu *= oc_rel;
  oc_v = max(abs(spl0), abs(spl1)); oc_v > oc_mout ? oc_mout = oc_v : oc_mout *= oc_rel;
  oc_cnt += 1;
  ff1 != oc_ff ? (
    oc_ff = ff1;
    oc_hz = env > 0.001 && oc_cnt > 0 ? srate / oc_cnt : 0;
    oc_cnt = 0;
  );
  oc_cnt > srate * 0.1 ? oc_hz = 0;
  ng_tap(spl0, spl1);

@gfx 480 294
  ng_knobs_begin("OCTAVER", "ESSENTIALS", 480, 120, 1, 0);

  // display, left: the output waveform and the tracked pitch; right: levels per voice
  ng_plot(28, 66, 226, 74);
  ng_grid(8, 2, 1);
  ng_scope(1);
  ng_font(1, 7, 1);
  ng_col(NG_MUTED, 1);
  ng_txt("TRACKING", 28, 155, 0, 1.2);
  ng_font(3, 8.5, 0);
  ng_col(NG_TEXT, 1);
  oc_hz > 0 ? (
    // nearest note name and octave (A4 = 440 Hz)
    oc_n = floor(12 * log(oc_hz / 440) / log(2) + 69.5);
    oc_k = oc_n - 12 * floor(oc_n / 12);
    strcpy(#oc_nm, oc_k == 0 ? "C" : oc_k == 1 ? "C#" : oc_k == 2 ? "D" : oc_k == 3 ? "D#" : oc_k == 4 ? "E" : oc_k == 5 ? "F" :
                   oc_k == 6 ? "F#" : oc_k == 7 ? "G" : oc_k == 8 ? "G#" : oc_k == 9 ? "A" : oc_k == 10 ? "A#" : "B");
    sprintf(#oc_t, "%.1f Hz   %s%d", oc_hz, #oc_nm, floor(oc_n / 12) - 1);
  ) : strcpy(#oc_t, "--");
  ng_txt(#oc_t, 92, 155, 0, 0);

  ng_meter(278, 70, 174, 8, "IN", ng_to_db(oc_min), -140, -60);
  ng_meter(278, 89, 174, 8, "-1", ng_to_db(oc_m1), -140, -60);
  ng_meter(278, 108, 174, 8, "-2", ng_to_db(oc_m2), -140, -60);
  ng_meter(278, 127, 174, 8, "UP", ng_to_db(oc_mu), -140, -60);
  ng_meter(278, 146, 174, 8, "OUT", ng_to_db(oc_mout), -140, -60);

  ng_row(6);
  sprintf(#v1, "%d%%", slider1);
  ng_knob_ctl(1, "DRY", #v1, 0, 100, 100, 1, 0) ? update();
  sprintf(#v2, "%d%%", slider2);
  ng_knob_ctl(2, "OCT -1", #v2, 0, 100, 70, 1, 0) ? update();
  sprintf(#v3, "%d%%", slider3);
  ng_knob_ctl(3, "OCT -2", #v3, 0, 100, 35, 1, 0) ? update();
  sprintf(#v4, "%d%%", slider4);
  ng_knob_ctl(4, "UP", #v4, 0, 100, 0, 1, 0) ? update();
  slider5 >= 1000 ? sprintf(#v5, "%.2f kHz", slider5 / 1000) : sprintf(#v5, "%d Hz", slider5);
  ng_knob_ctl_log(5, "TONE", #v5, 100, 5000, 900, 1) ? update();
  sprintf(#v6, "%d Hz", slider6);
  ng_knob_ctl_log(6, "TRACKING", #v6, 60, 1000, 300, 1) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
