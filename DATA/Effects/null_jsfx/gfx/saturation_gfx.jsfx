desc:NULL Saturation GFX
author: Christos Koulaxizis
tags: saturation distortion tape tube overdrive fuzz bitcrush waveshaper wavefolder drive gui
//category: Essentials
//NULL JSFX v2.3 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:30<0,100,1>-Drive (%)
slider2:0<-12,12,0.1>-Tone (dB)
slider3:50<0,100,1>-Mix (%)
slider4:0<0,6,1{Tape,Tube,Overdrive,Fuzz,Bitcrush,Waveshaper,Fold}>-Mode

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  // NULL Saturation (../saturation.jsfx) with its own interface: same audio code, plus @gfx.
  // Tone is a tilt EQ on the wet signal: a one-pole split at 800 Hz, with the
  // highs raised by Tone/2 dB and the lows lowered by Tone/2 dB (and the reverse
  // for negative values). 0 dB is flat; -12 dB is dark, +12 dB is bright.
  tone_l = 0;
  tone_r = 0;
  tone_alpha = 1 - exp(-2 * 3.14159265358979 * 800 / srate);

  gfx_ext_retina = 1;

  function update()
  (
    drive = slider1 / 100;
    mix = slider3 / 100;
    sat_mode = slider4;
    tone_alpha = 1 - exp(-2 * 3.14159265358979 * 800 / srate);
    tone_hi = 10 ^ (slider2 / 40);
    tone_lo = 1 / tone_hi;
  );

  // the shaper of @sample for one driven input x (a copy for the display, own variables)
  function st_shape(x) local(y, q)
  (
    sat_mode == 0 ? (
      x = max(-1 / 0.6, min(1 / 0.6, x));
      y = x * (1 - abs(x) * 0.3);
    ) : sat_mode == 1 ? (
      y = max(-1, min(1, x - x * x * x / 3));
    ) : sat_mode == 2 ? (
      y = abs(x) > 1 ? (x < 0 ? -1 : 1) : x;
      y > 0.5 ? y = 1 - (1 - y) * (1 - y);
      y < -0.5 ? y = -1 + (1 + y) * (1 + y);
    ) : sat_mode == 3 ? (
      y = abs(x) > 0.1 ? (x > 0 ? 1 : -1) : 0;
    ) : sat_mode == 4 ? (
      q = pow(2, max(2, 8 - floor(drive * 6))) - 1;
      y = floor(x * q + 0.5) / q;
    ) : sat_mode == 5 ? (
      y = x;
      y > 1 ? y = 2 - y; y < -1 ? y = -2 - y;
      y > 1 ? y = 2 - y; y < -1 ? y = -2 - y;
    ) : (
      y = sin(x * (1 + drive) * $pi / 2);
    );
    y;
  );
  // static transfer curve (Tone left out): output for input x, after the dry/wet mix
  function st_curve(x) ( x * (1 - mix) + st_shape(x * (1 + drive * 3)) * mix; );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 9;

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 30); ng_slider_set(2, 0); ng_slider_set(3, 50); ng_slider_set(4, 0); );
    p == 1 ? ( ng_slider_set(1, 15); ng_slider_set(2, 0); ng_slider_set(3, 40); ng_slider_set(4, 0); );
    p == 2 ? ( ng_slider_set(1, 20); ng_slider_set(2, 1); ng_slider_set(3, 35); ng_slider_set(4, 1); );
    p == 3 ? ( ng_slider_set(1, 40); ng_slider_set(2, -2); ng_slider_set(3, 35); ng_slider_set(4, 2); );
    p == 4 ? ( ng_slider_set(1, 60); ng_slider_set(2, 2); ng_slider_set(3, 30); ng_slider_set(4, 2); );
    p == 5 ? ( ng_slider_set(1, 50); ng_slider_set(2, -4); ng_slider_set(3, 50); ng_slider_set(4, 3); );
    p == 6 ? ( ng_slider_set(1, 60); ng_slider_set(2, -3); ng_slider_set(3, 50); ng_slider_set(4, 4); );
    p == 7 ? ( ng_slider_set(1, 50); ng_slider_set(2, 0); ng_slider_set(3, 60); ng_slider_set(4, 6); );
    p == 8 ? ( ng_slider_set(1, 70); ng_slider_set(2, -2); ng_slider_set(3, 40); ng_slider_set(4, 5); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 30) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 15) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 40) && ng_pre_eq(slider4, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 20) && ng_pre_eq(slider2, 1) && ng_pre_eq(slider3, 35) && ng_pre_eq(slider4, 1) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 40) && ng_pre_eq(slider2, -2) && ng_pre_eq(slider3, 35) && ng_pre_eq(slider4, 2) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 60) && ng_pre_eq(slider2, 2) && ng_pre_eq(slider3, 30) && ng_pre_eq(slider4, 2) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 50) && ng_pre_eq(slider2, -4) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 3) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 60) && ng_pre_eq(slider2, -3) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 4) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 50) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 60) && ng_pre_eq(slider4, 6) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 70) && ng_pre_eq(slider2, -2) && ng_pre_eq(slider3, 40) && ng_pre_eq(slider4, 5) ? m = 8;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Bus Warmth";
    p == 2 ? s = "Vocal Tube Glow";
    p == 3 ? s = "Bass Grit";
    p == 4 ? s = "Drum Crunch";
    p == 5 ? s = "Guitar Fuzz";
    p == 6 ? s = "Lo-Fi Bitcrush";
    p == 7 ? s = "Synth Wavefolder";
    p == 8 ? s = "Hard Fold Lead";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  dry_l = spl0;
  dry_r = spl1;
  
  in_l = spl0 * (1 + drive * 3);
  in_r = spl1 * (1 + drive * 3);

  /* MODE 0 - TAPE: Soft clipping (αντί για tanh που δεν υποστηρίζεται) */
  sat_mode == 0 ? (
    // the curve x(1 - 0.3|x|) peaks at |x| = 1/0.6; hold it there instead of folding back
    in_l = max(-1 / 0.6, min(1 / 0.6, in_l)); in_r = max(-1 / 0.6, min(1 / 0.6, in_r));
    wet_l = in_l * (1 - abs(in_l) * 0.3);
    wet_r = in_r * (1 - abs(in_r) * 0.3);
  ) : (
    
    /* MODE 1 - TUBE: Polynomial approximation */
    sat_mode == 1 ? (
      wet_l = in_l - (in_l * in_l * in_l) / 3;
      wet_r = in_r - (in_r * in_r * in_r) / 3;
      wet_l > 1 ? wet_l = 1 : (wet_l < -1 ? wet_l = -1);
      wet_r > 1 ? wet_r = 1 : (wet_r < -1 ? wet_r = -1);
    ) : (
      
      /* MODE 2 - OVERDRIVE */
      sat_mode == 2 ? (
        a = in_l < 0 ? -in_l : in_l;
        a > 1 ? wet_l = (in_l < 0 ? -1 : 1) : (wet_l = in_l);
        wet_l > 0.5 ? wet_l = 1 - (1 - wet_l) * (1 - wet_l);
        wet_l < -0.5 ? wet_l = -1 + (1 + wet_l) * (1 + wet_l);
        
        a = in_r < 0 ? -in_r : in_r;
        a > 1 ? wet_r = (in_r < 0 ? -1 : 1) : (wet_r = in_r);
        wet_r > 0.5 ? wet_r = 1 - (1 - wet_r) * (1 - wet_r);
        wet_r < -0.5 ? wet_r = -1 + (1 + wet_r) * (1 + wet_r);
      ) : (
        
        /* MODE 3 - FUZZ */
        sat_mode == 3 ? (
          a = in_l < 0 ? -in_l : in_l;
          a > 0.1 ? (in_l > 0 ? wet_l = 1 : wet_l = -1) : (wet_l = 0);
          
          a = in_r < 0 ? -in_r : in_r;
          a > 0.1 ? (in_r > 0 ? wet_r = 1 : wet_r = -1) : (wet_r = 0);
        ) : (
          
          /* MODE 4 - BITCRUSH */
          sat_mode == 4 ? (
            bits = 8 - floor(drive * 6);
            bits < 2 ? bits = 2;
            quants = pow(2, bits) - 1;
            wet_l = floor(in_l * quants + 0.5) / quants;
            wet_r = floor(in_r * quants + 0.5) / quants;
          ) : (
            
            sat_mode == 5 ? (
              /* MODE 5 - WAVESHAPER */
              wet_l = in_l;
              wet_l > 1 ? wet_l = 2 - wet_l;
              wet_l < -1 ? wet_l = -2 - wet_l;
              wet_l > 1 ? wet_l = 2 - wet_l;
              wet_l < -1 ? wet_l = -2 - wet_l;
              
              wet_r = in_r;
              wet_r > 1 ? wet_r = 2 - wet_r;
              wet_r < -1 ? wet_r = -2 - wet_r;
              wet_r > 1 ? wet_r = 2 - wet_r;
              wet_r < -1 ? wet_r = -2 - wet_r;
            ) : (
              
              /* MODE 6 - FOLD: sine wavefolder, Drive adds folds (1x to 2x on top of the drive) */
              wet_l = sin(in_l * (1 + drive) * $pi / 2);
              wet_r = sin(in_r * (1 + drive) * $pi / 2);
            );
          );
        );
      );
    );
  );

  /* Tone: tilt EQ on the wet signal (low band + high band, opposite gains) */
  tone_l += tone_alpha * (wet_l - tone_l);
  tone_r += tone_alpha * (wet_r - tone_r);
  wet_l = tone_l * tone_lo + (wet_l - tone_l) * tone_hi;
  wet_r = tone_r * tone_lo + (wet_r - tone_r) * tone_hi;

  /* Dry/Wet mix */
  spl0 = dry_l * (1 - mix) + wet_l * mix;
  spl1 = dry_r * (1 - mix) + wet_r * mix;

@gfx 480 294
  ng_knobs_begin("SATURATION", "ESSENTIALS", 480, 120, 1, 0);

  // display: the transfer curve (input -1..+1 across, output -1..+1 up) after the mix
  ng_plot(ng_vx + 26, ng_vy + 4, ng_vw - 30, ng_vh - 20);
  ng_grid(8, 4, 1);
  ng_font(4, 8, 0);
  ng_col(NG_MUTED, 1);
  ng_ptxt("+1", ng_px - 6 * ng_s, ng_py, 2);
  ng_ptxt("0", ng_px - 6 * ng_s, ng_py + ng_ph / 2, 2);
  ng_ptxt("-1", ng_px - 6 * ng_s, ng_py + ng_ph, 2);
  ng_ptxt("IN", ng_px + ng_pw / 2, ng_py + ng_ph + 10 * ng_s, 1);
  sprintf(#st_t, "DRIVE %.1fx", 1 + slider1 / 100 * 3);
  ng_ptxt(#st_t, ng_px + ng_pw - 6 * ng_s, ng_py + 9 * ng_s, 2);
  ng_col(NG_ACCENT, 0.25);
  gfx_line(ng_px, ng_py + ng_ph, ng_px + ng_pw, ng_py, 1);
  st_zy = ng_lin_y(0, -1, 1);
  ng_col(NG_ACCENT, 0.10);
  st_i = 0;
  loop(floor(ng_pw) + 1,
    gfx_line(ng_px + st_i, st_zy, ng_px + st_i, ng_lin_y(st_curve(-1 + 2 * st_i / ng_pw), -1, 1), 0);
    st_i += 1;
  );
  ng_col(NG_ACCENT, 1);
  st_i = 0;
  loop(floor(ng_pw) + 1,
    st_y = ng_lin_y(st_curve(-1 + 2 * st_i / ng_pw), -1, 1);
    st_i == 0 ? ng_line_start(ng_px, st_y) : ng_line_to(ng_px + st_i, st_y);
    st_i += 1;
  );

  ng_row(4);
  sprintf(#v1, "%d%%", slider1);
  ng_knob_ctl(1, "DRIVE", #v1, 0, 100, 30, 1, 0) ? update();
  abs(slider2) < 0.05 ? sprintf(#v2, "0.0 dB") : sprintf(#v2, "%+.1f dB", slider2);
  ng_knob_ctl(2, "TONE", #v2, -12, 12, 0, 0.1, 1) ? update();
  sprintf(#v3, "%d%%", slider3);
  ng_knob_ctl(3, "MIX", #v3, 0, 100, 50, 1, 0) ? update();
  ng_select_ctl(4, "MODE", "TAPE|TUBE|DRIVE|FUZZ|CRUSH|SHAPE|FOLD", 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
