desc:NULL Saturation GFX
author: Christos Koulaxizis
tags: saturation distortion tape tube overdrive fuzz bitcrush waveshaper wavefolder drive oversampling emphasis gui
//category: Essentials
//NULL JSFX v2.4 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:30<0,100,1>-Drive (%)
slider2:0<-12,12,0.1>-Tone (dB)
slider3:50<0,100,1>-Mix (%)
slider4:0<0,6,1{Tape,Tube,Overdrive,Fuzz,Bitcrush,Waveshaper,Fold}>-Mode
slider5:0<-12,12,0.1>-Input (dB)
slider6:0<-24,12,0.1>-Output (dB)
slider7:0<0,2,1{Off,2x,4x}>-Oversampling
slider8:0<-12,12,0.1>-Emphasis (dB)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  // NULL Saturation (../saturation.jsfx) with its own interface: same audio code, plus @gfx.
  // Tone is a tilt EQ on the wet signal: a one-pole split at 800 Hz, with the
  // highs raised by Tone/2 dB and the lows lowered by Tone/2 dB (and the reverse
  // for negative values). 0 dB is flat; -12 dB is dark, +12 dB is bright.
  tone_l = 0;
  tone_r = 0;
  tone_alpha = 1 - exp(-2 * 3.14159265358979 * 800 / srate);

  // Input (dB) drives the shaper harder or softer, Output (dB) sets the level after the mix;
  // both are skipped at 0 dB. Emphasis is a first-order tilt around 800 Hz before the shaper
  // (highs up and lows down by Emphasis/2 dB, or the reverse) and its exact inverse after it,
  // so the saturation bites the highs (or the lows) harder while the clean tone stays the
  // same; skipped at 0 dB. Oversampling runs the shaper at 2x or 4x the sample rate through
  // the linear-phase halfband FIR stages of NULL Clipper (63 and 23 taps) so its harmonics
  // do not fold back as aliasing; the dry signal is delayed to match.
  // Latency (reported to the host): 0, 31 or 37 samples for Off, 2x and 4x.
  E1 = 0;  D1 = 32;  // stage 1 (63 taps): 32 even-phase taps, x2 for the upsampler
  E2 = 64; D2 = 76;  // stage 2 (23 taps): 12

  // modified Bessel function I0 (series), for the Kaiser window
  function bessel_i0(x) local(s, t, k, q)
  (
    s = 1; t = 1; k = 1;
    loop(40,
      q = x / (2 * k);
      t *= q * q;
      s += t;
      k += 1;
    );
    s;
  );

  // the n = (taps + 1) / 2 nonzero side taps of a halfband lowpass (Kaiser beta), normalised
  // so they sum to 0.5 (the centre tap is 0.5): e = 2 h for the upsampler, d = h for the
  // downsampler
  function hb_design(e, d, taps, beta) local(c, i, dd, a, sg, r, w, s)
  (
    c = (taps - 1) / 2;
    s = 0;
    i = 0;
    loop((taps + 1) / 2,
      dd = 2 * i - c;
      a = abs(dd);
      sg = ((a - 1) / 2) % 2 ? -1 : 1;
      r = 2 * dd / (taps - 1);
      w = bessel_i0(beta * sqrt(max(0, 1 - r * r))) / bessel_i0(beta);
      d[i] = sg / ($pi * a) * w;
      s += d[i];
      i += 1;
    );
    i = 0;
    loop((taps + 1) / 2,
      d[i] = 0.5 * d[i] / s;
      e[i] = 2 * d[i];
      i += 1;
    );
  );

  hb_design(E1, D1, 63, 7.5);
  hb_design(E2, D2, 23, 8);

  // 2x upsampler, polyphase: one input sample in, hb_o0 (even) and hb_o1 (odd) out.
  // s[0] = write position, s[1 ..] = the last n inputs, stored twice
  function hb_up(x, s, e, n, m) local(p, q, acc, i)
  (
    p = s[0];
    p = p > 0 ? p - 1 : n - 1;
    s[0] = p;
    q = s + 1 + p;
    q[0] = x;
    q[n] = x;
    acc = 0;
    i = 0;
    loop(n, acc += e[i] * q[i]; i += 1;);
    hb_o0 = acc;
    hb_o1 = q[m];
  );

  // 2x downsampler, polyphase: an even and an odd sample in, one sample out.
  // s[0] = write position, s[1] = position in the odd delay, s[2 ..] = the last n even
  // samples stored twice, then m + 1 odd samples
  function hb_down(v0, v1, s, d, n, m) local(p, q, acc, i, o)
  (
    p = s[0];
    p = p > 0 ? p - 1 : n - 1;
    s[0] = p;
    q = s + 2 + p;
    q[0] = v0;
    q[n] = v0;
    acc = 0;
    i = 0;
    loop(n, acc += d[i] * q[i]; i += 1;);
    o = s + 2 + 2 * n + s[1];
    acc += 0.5 * o[0];
    o[0] = v1;
    s[1] = s[1] < m ? s[1] + 1 : 0;
    acc;
  );

  // per channel: filter states, the sample arrays of each rate, the pad and dry delays
  function ch_init(b)
  (
    this.u1 = b;              // 1 + 64
    this.u2 = b + 65;         // 1 + 24
    this.d1 = b + 107;        // 2 + 64 + 16
    this.d2 = b + 189;        // 2 + 24 + 6
    this.a1 = b + 244;        // 2
    this.a2 = b + 246;        // 4
    this.pd = b + 258;        // 8
    this.dr = b + 266;        // 64
  );
  chl.ch_init(128);
  chr.ch_init(512);
  freembuf(896);

  // the shaper for one driven sample: mode sat_mode, drive 0..1
  function sat_shape(x) local(a, y, bits, quants)
  (
    /* MODE 0 - TAPE: Soft clipping (αντί για tanh που δεν υποστηρίζεται) */
    sat_mode == 0 ? (
      // the curve x(1 - 0.3|x|) peaks at |x| = 1/0.6; hold it there instead of folding back
      x = max(-1 / 0.6, min(1 / 0.6, x));
      y = x * (1 - abs(x) * 0.3);
    ) : (

      /* MODE 1 - TUBE: Polynomial approximation */
      sat_mode == 1 ? (
        y = x - (x * x * x) / 3;
        y > 1 ? y = 1 : (y < -1 ? y = -1);
      ) : (

        /* MODE 2 - OVERDRIVE */
        sat_mode == 2 ? (
          a = x < 0 ? -x : x;
          a > 1 ? y = (x < 0 ? -1 : 1) : (y = x);
          y > 0.5 ? y = 1 - (1 - y) * (1 - y);
          y < -0.5 ? y = -1 + (1 + y) * (1 + y);
        ) : (

          /* MODE 3 - FUZZ */
          sat_mode == 3 ? (
            a = x < 0 ? -x : x;
            a > 0.1 ? (x > 0 ? y = 1 : y = -1) : (y = 0);
          ) : (

            /* MODE 4 - BITCRUSH */
            sat_mode == 4 ? (
              bits = 8 - floor(drive * 6);
              bits < 2 ? bits = 2;
              quants = pow(2, bits) - 1;
              y = floor(x * quants + 0.5) / quants;
            ) : (

              sat_mode == 5 ? (
                /* MODE 5 - WAVESHAPER */
                y = x;
                y > 1 ? y = 2 - y;
                y < -1 ? y = -2 - y;
                y > 1 ? y = 2 - y;
                y < -1 ? y = -2 - y;
              ) : (

                /* MODE 6 - FOLD: sine wavefolder, Drive adds folds (1x to 2x on top of the drive) */
                y = sin(x * (1 + drive) * $pi / 2);
              );
            );
          );
        );
      );
    );
    y;
  );

  em_xl = em_yl = em_xr = em_yr = 0;
  de_xl = de_yl = de_xr = de_yr = 0;
  os_prev = -1;
  pw = 0;
  dw = 0;
  pdc_bot_ch = 0;
  pdc_top_ch = 2;

  gfx_ext_retina = 1;

  function update()
  (
    drive = slider1 / 100;
    mix = slider3 / 100;
    sat_mode = slider4;
    tone_alpha = 1 - exp(-2 * 3.14159265358979 * 800 / srate);
    tone_hi = 10 ^ (slider2 / 40);
    tone_lo = 1 / tone_hi;
    in_on = slider5 != 0;
    gin = 10 ^ (slider5 / 20);
    out_on = slider6 != 0;
    gout = 10 ^ (slider6 / 20);
    // Emphasis: H(s) = (hi s + lo w) / (s + w) at w = 2 pi 800 Hz (bilinear, prewarped), lo = 1 / hi
    em_on = slider8 != 0;
    em_hi = 10 ^ (slider8 / 40);
    em_lo = 1 / em_hi;
    em_t = tan($pi * 800 / srate);
    em_b0 = em_hi + em_lo * em_t;
    em_b1 = em_lo * em_t - em_hi;
    em_a0 = 1 + em_t;
    em_a1 = em_t - 1;
    em_on ? 0 : ( em_xl = em_yl = em_xr = em_yr = 0; de_xl = de_yl = de_xr = de_yr = 0; );
    os = slider7;
    os < 0.5 ? ( osf = 1; lat = 0; pad = 0; ) :
    os < 1.5 ? ( osf = 2; lat = 31; pad = 0; ) :
               ( osf = 4; lat = 37; pad = 2; );
    pdc_delay = lat;
    // a new rate starts every filter and delay from silence
    osf != os_prev ? (
      memset(128, 0, 768);
      pw = 0;
      dw = 0;
      os_prev = osf;
    );
  );

  // the shaper of @sample for one driven input x (a copy for the display, own variables)
  function st_shape(x) local(y, q)
  (
    sat_mode == 0 ? (
      x = max(-1 / 0.6, min(1 / 0.6, x));
      y = x * (1 - abs(x) * 0.3);
    ) : sat_mode == 1 ? (
      y = max(-1, min(1, x - x * x * x / 3));
    ) : sat_mode == 2 ? (
      y = abs(x) > 1 ? (x < 0 ? -1 : 1) : x;
      y > 0.5 ? y = 1 - (1 - y) * (1 - y);
      y < -0.5 ? y = -1 + (1 + y) * (1 + y);
    ) : sat_mode == 3 ? (
      y = abs(x) > 0.1 ? (x > 0 ? 1 : -1) : 0;
    ) : sat_mode == 4 ? (
      q = pow(2, max(2, 8 - floor(drive * 6))) - 1;
      y = floor(x * q + 0.5) / q;
    ) : sat_mode == 5 ? (
      y = x;
      y > 1 ? y = 2 - y; y < -1 ? y = -2 - y;
      y > 1 ? y = 2 - y; y < -1 ? y = -2 - y;
    ) : (
      y = sin(x * (1 + drive) * $pi / 2);
    );
    y;
  );
  // static transfer curve (Tone and Emphasis left out): output for input x with Input, after
  // the dry/wet mix and Output, held in the plot (-1..+1)
  function st_curve(x) local(y)
  (
    y = (x * (1 - mix) + st_shape(x * gin * (1 + drive * 3)) * mix) * gout;
    max(-1, min(1, y));
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 14;

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 30); ng_slider_set(2, 0); ng_slider_set(3, 50); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 1 ? ( ng_slider_set(1, 15); ng_slider_set(2, 0); ng_slider_set(3, 40); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 2 ? ( ng_slider_set(1, 20); ng_slider_set(2, 1); ng_slider_set(3, 35); ng_slider_set(4, 1); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 3 ? ( ng_slider_set(1, 40); ng_slider_set(2, -2); ng_slider_set(3, 35); ng_slider_set(4, 2); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 4 ? ( ng_slider_set(1, 60); ng_slider_set(2, 2); ng_slider_set(3, 30); ng_slider_set(4, 2); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 5 ? ( ng_slider_set(1, 50); ng_slider_set(2, -4); ng_slider_set(3, 50); ng_slider_set(4, 3); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 6 ? ( ng_slider_set(1, 60); ng_slider_set(2, -3); ng_slider_set(3, 50); ng_slider_set(4, 4); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 7 ? ( ng_slider_set(1, 50); ng_slider_set(2, 0); ng_slider_set(3, 60); ng_slider_set(4, 6); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 8 ? ( ng_slider_set(1, 70); ng_slider_set(2, -2); ng_slider_set(3, 40); ng_slider_set(4, 5); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 9 ? ( ng_slider_set(1, 25); ng_slider_set(2, 0); ng_slider_set(3, 60); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, -1); ng_slider_set(7, 1); ng_slider_set(8, 0); );
    p == 10 ? ( ng_slider_set(1, 35); ng_slider_set(2, -1); ng_slider_set(3, 50); ng_slider_set(4, 1); ng_slider_set(5, 0); ng_slider_set(6, -2); ng_slider_set(7, 1); ng_slider_set(8, 6); );
    p == 11 ? ( ng_slider_set(1, 40); ng_slider_set(2, -2); ng_slider_set(3, 30); ng_slider_set(4, 3); ng_slider_set(5, 0); ng_slider_set(6, -4); ng_slider_set(7, 0); ng_slider_set(8, -8); );
    p == 12 ? ( ng_slider_set(1, 50); ng_slider_set(2, 0); ng_slider_set(3, 100); ng_slider_set(4, 2); ng_slider_set(5, 3); ng_slider_set(6, -7); ng_slider_set(7, 2); ng_slider_set(8, 0); );
    p == 13 ? ( ng_slider_set(1, 20); ng_slider_set(2, 0); ng_slider_set(3, 25); ng_slider_set(4, 1); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 1); ng_slider_set(8, 10); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 30) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 15) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 40) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 20) && ng_pre_eq(slider2, 1) && ng_pre_eq(slider3, 35) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 40) && ng_pre_eq(slider2, -2) && ng_pre_eq(slider3, 35) && ng_pre_eq(slider4, 2) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 60) && ng_pre_eq(slider2, 2) && ng_pre_eq(slider3, 30) && ng_pre_eq(slider4, 2) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 50) && ng_pre_eq(slider2, -4) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 3) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 60) && ng_pre_eq(slider2, -3) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 4) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 50) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 60) && ng_pre_eq(slider4, 6) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 70) && ng_pre_eq(slider2, -2) && ng_pre_eq(slider3, 40) && ng_pre_eq(slider4, 5) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 8;
    m < 0 && ng_pre_eq(slider1, 25) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 60) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, -1) && ng_pre_eq(slider7, 1) && ng_pre_eq(slider8, 0) ? m = 9;
    m < 0 && ng_pre_eq(slider1, 35) && ng_pre_eq(slider2, -1) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, -2) && ng_pre_eq(slider7, 1) && ng_pre_eq(slider8, 6) ? m = 10;
    m < 0 && ng_pre_eq(slider1, 40) && ng_pre_eq(slider2, -2) && ng_pre_eq(slider3, 30) && ng_pre_eq(slider4, 3) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, -4) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, -8) ? m = 11;
    m < 0 && ng_pre_eq(slider1, 50) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 100) && ng_pre_eq(slider4, 2) && ng_pre_eq(slider5, 3) && ng_pre_eq(slider6, -7) && ng_pre_eq(slider7, 2) && ng_pre_eq(slider8, 0) ? m = 12;
    m < 0 && ng_pre_eq(slider1, 20) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 25) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 1) && ng_pre_eq(slider8, 10) ? m = 13;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Bus Warmth";
    p == 2 ? s = "Vocal Tube Glow";
    p == 3 ? s = "Bass Grit";
    p == 4 ? s = "Drum Crunch";
    p == 5 ? s = "Guitar Fuzz";
    p == 6 ? s = "Lo-Fi Bitcrush";
    p == 7 ? s = "Synth Wavefolder";
    p == 8 ? s = "Hard Fold Lead";
    p == 9 ? s = "Tape Glue";
    p == 10 ? s = "Tube Push Highs";
    p == 11 ? s = "Fuzz Lows";
    p == 12 ? s = "Clean Drive 4x";
    p == 13 ? s = "Bright Exciter";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  dry_l = spl0;
  dry_r = spl1;

  in_l = spl0;
  in_r = spl1;
  in_on ? (
    in_l *= gin;
    in_r *= gin;
  );
  em_on ? (
    // pre-emphasis: (b0 x + b1 x1 - a1 y1) / a0
    em_v = (em_b0 * in_l + em_b1 * em_xl - em_a1 * em_yl) / em_a0;
    em_xl = in_l; em_yl = em_v; in_l = em_v;
    em_v = (em_b0 * in_r + em_b1 * em_xr - em_a1 * em_yr) / em_a0;
    em_xr = in_r; em_yr = em_v; in_r = em_v;
  );
  in_l = in_l * (1 + drive * 3);
  in_r = in_r * (1 + drive * 3);

  osf > 1 ? (
    // up to the shaper's rate
    hb_up(in_l, chl.u1, E1, 32, 15); chl.a1[0] = hb_o0; chl.a1[1] = hb_o1;
    hb_up(in_r, chr.u1, E1, 32, 15); chr.a1[0] = hb_o0; chr.a1[1] = hb_o1;
    osf > 2 ? (
      i = 0;
      loop(2,
        hb_up(chl.a1[i], chl.u2, E2, 12, 5); chl.a2[2 * i] = hb_o0; chl.a2[2 * i + 1] = hb_o1;
        hb_up(chr.a1[i], chr.u2, E2, 12, 5); chr.a2[2 * i] = hb_o0; chr.a2[2 * i + 1] = hb_o1;
        i += 1;
      );
    );
    tl = osf > 2 ? chl.a2 : chl.a1;
    tr = osf > 2 ? chr.a2 : chr.a1;
    // pad delay (whole latency in samples) and the shaper, at the top rate
    i = 0;
    loop(osf,
      cxl = tl[i];
      cxr = tr[i];
      pad > 0 ? (
        chl.pd[pw] = cxl;
        chr.pd[pw] = cxr;
        j = (pw - pad + 8) % 8;
        cxl = chl.pd[j];
        cxr = chr.pd[j];
        pw = (pw + 1) % 8;
      );
      tl[i] = sat_shape(cxl);
      tr[i] = sat_shape(cxr);
      i += 1;
    );
    // back down to the sample rate
    osf > 2 ? (
      i = 0;
      loop(2,
        chl.a1[i] = hb_down(chl.a2[2 * i], chl.a2[2 * i + 1], chl.d2, D2, 12, 5);
        chr.a1[i] = hb_down(chr.a2[2 * i], chr.a2[2 * i + 1], chr.d2, D2, 12, 5);
        i += 1;
      );
    );
    wet_l = hb_down(chl.a1[0], chl.a1[1], chl.d1, D1, 32, 15);
    wet_r = hb_down(chr.a1[0], chr.a1[1], chr.d1, D1, 32, 15);
    // dry signal delayed by the latency
    chl.dr[dw] = dry_l;
    chr.dr[dw] = dry_r;
    j = (dw - lat + 64) % 64;
    dry_l = chl.dr[j];
    dry_r = chr.dr[j];
    dw = (dw + 1) % 64;
  ) : (
    wet_l = sat_shape(in_l);
    wet_r = sat_shape(in_r);
  );

  em_on ? (
    // de-emphasis, the exact inverse: (a0 y + a1 y1 - b1 x1) / b0
    em_v = (em_a0 * wet_l + em_a1 * de_yl - em_b1 * de_xl) / em_b0;
    de_yl = wet_l; de_xl = em_v; wet_l = em_v;
    em_v = (em_a0 * wet_r + em_a1 * de_yr - em_b1 * de_xr) / em_b0;
    de_yr = wet_r; de_xr = em_v; wet_r = em_v;
  );

  /* Tone: tilt EQ on the wet signal (low band + high band, opposite gains) */
  tone_l += tone_alpha * (wet_l - tone_l);
  tone_r += tone_alpha * (wet_r - tone_r);
  wet_l = tone_l * tone_lo + (wet_l - tone_l) * tone_hi;
  wet_r = tone_r * tone_lo + (wet_r - tone_r) * tone_hi;

  /* Dry/Wet mix */
  spl0 = dry_l * (1 - mix) + wet_l * mix;
  spl1 = dry_r * (1 - mix) + wet_r * mix;
  out_on ? (
    spl0 *= gout;
    spl1 *= gout;
  );

@gfx 480 380
  ng_knobs_begin("SATURATION", "ESSENTIALS", 480, 120, 2, 0);

  // display: the transfer curve (input -1..+1 across, output -1..+1 up) after the mix
  ng_plot(ng_vx + 26, ng_vy + 4, ng_vw - 30, ng_vh - 20);
  ng_grid(8, 4, 1);
  ng_font(4, 8, 0);
  ng_col(NG_MUTED, 1);
  ng_ptxt("+1", ng_px - 6 * ng_s, ng_py, 2);
  ng_ptxt("0", ng_px - 6 * ng_s, ng_py + ng_ph / 2, 2);
  ng_ptxt("-1", ng_px - 6 * ng_s, ng_py + ng_ph, 2);
  ng_ptxt("IN", ng_px + ng_pw / 2, ng_py + ng_ph + 10 * ng_s, 1);
  sprintf(#st_t, "DRIVE %.1fx", 1 + slider1 / 100 * 3);
  ng_ptxt(#st_t, ng_px + ng_pw - 6 * ng_s, ng_py + 9 * ng_s, 2);
  strcpy(#st_a, slider7 == 1 ? "OS 2X" : slider7 == 2 ? "OS 4X" : "");
  abs(slider8) >= 0.05 ? sprintf(#st_b, "EMPH %+.1f dB", slider8) : strcpy(#st_b, "");
  sprintf(#st_t, "%s%s%s", #st_a, slider7 > 0 && abs(slider8) >= 0.05 ? "  " : "", #st_b);
  ng_ptxt(#st_t, ng_px + ng_pw - 6 * ng_s, ng_py + 21 * ng_s, 2);
  ng_col(NG_ACCENT, 0.25);
  gfx_line(ng_px, ng_py + ng_ph, ng_px + ng_pw, ng_py, 1);
  st_zy = ng_lin_y(0, -1, 1);
  ng_col(NG_ACCENT, 0.10);
  st_i = 0;
  loop(floor(ng_pw) + 1,
    gfx_line(ng_px + st_i, st_zy, ng_px + st_i, ng_lin_y(st_curve(-1 + 2 * st_i / ng_pw), -1, 1), 0);
    st_i += 1;
  );
  ng_col(NG_ACCENT, 1);
  st_i = 0;
  loop(floor(ng_pw) + 1,
    st_y = ng_lin_y(st_curve(-1 + 2 * st_i / ng_pw), -1, 1);
    st_i == 0 ? ng_line_start(ng_px, st_y) : ng_line_to(ng_px + st_i, st_y);
    st_i += 1;
  );

  ng_row(4);
  sprintf(#v1, "%d%%", slider1);
  ng_knob_ctl(1, "DRIVE", #v1, 0, 100, 30, 1, 0) ? update();
  abs(slider2) < 0.05 ? sprintf(#v2, "0.0 dB") : sprintf(#v2, "%+.1f dB", slider2);
  ng_knob_ctl(2, "TONE", #v2, -12, 12, 0, 0.1, 1) ? update();
  sprintf(#v3, "%d%%", slider3);
  ng_knob_ctl(3, "MIX", #v3, 0, 100, 50, 1, 0) ? update();
  ng_select_ctl(4, "MODE", "TAPE|TUBE|DRIVE|FUZZ|CRUSH|SHAPE|FOLD", 0) ? update();
  ng_row(4);
  abs(slider5) < 0.05 ? sprintf(#v5, "0.0 dB") : sprintf(#v5, "%+.1f dB", slider5);
  ng_knob_ctl(5, "INPUT", #v5, -12, 12, 0, 0.1, 1) ? update();
  abs(slider8) < 0.05 ? sprintf(#v8, "0.0 dB") : sprintf(#v8, "%+.1f dB", slider8);
  ng_knob_ctl(8, "EMPHASIS", #v8, -12, 12, 0, 0.1, 1) ? update();
  ng_select_ctl(7, "OVERSAMPLE", "OFF|2X|4X", 0) ? update();
  abs(slider6) < 0.05 ? sprintf(#v6, "0.0 dB") : sprintf(#v6, "%+.1f dB", slider6);
  ng_knob_ctl(6, "OUTPUT", #v6, -24, 12, 0, 0.1, 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
