desc:NULL Auto-Leveler GFX
author: Christos Koulaxizis
tags: auto leveler gain riding loudness level agc volume dialogue podcast gui
//category: Essentials
//NULL JSFX v2.6 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:-18<-36,-6,0.5>-Target (dB)
slider2:1000<100,5000,10>-Speed (ms)
slider3:12<0,24,0.5>-Max Boost (dB)
slider4:12<0,24,0.5>-Max Cut (dB)
slider5:-50<-80,-30,1>-Gate (dB)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // NULL Auto-Leveler (../auto_leveler.jsfx) with its own interface: same audio code, plus @gfx.
  // Rides the gain like an engineer on a fader: the average (RMS) level is measured
  // over ~300 ms and the gain moves slowly, at Speed, toward whatever brings that level
  // to Target. Gain changes are limited to Max Boost / Max Cut, and when the signal
  // falls below Gate (pauses, room noise) the gain holds still instead of pumping up.
  ms = 0;
  gain_db = 0;
  gfx_ext_retina = 1;

  // interface only: a 5.2 s history of the input RMS level and the gain, one entry per 20 ms
  // (260 entries, one per display pixel) in memory from 4000000, and the output RMS level
  al_buf = 4000000; al_len = 260; al_w = 0;
  al_chunk = max(1, floor(srate * 0.02));
  al_n = 0;
  al_i = 0;
  loop(al_len, al_buf[al_i * 2] = 0; al_buf[al_i * 2 + 1] = 0; al_i += 1;);
  al_ms = 0;

  function update()
  (
    target = slider1;
    rms_c = exp(-1 / (0.3 * srate));
    speed_c = exp(-1 / (slider2 / 1000 * srate));
    max_up = slider3;
    max_down = slider4;
    gate = slider5;
  );

  // history: input RMS level as dim bars (-60..0 dB), the gain as the line (-24..+24 dB)
  // between faint lines at Max Boost and Max Cut
  function al_history() local(i, k, xx, yy, h)
  (
    ng_plot(56, 68, 260, 88);
    ng_grid(8, 4, 0);
    yy = floor(ng_lin_y(0, -24, 24)) + 0.5;
    ng_col(0x45433f, 1);
    gfx_line(ng_px, yy, ng_px + ng_pw, yy, 0);
    ng_font(4, 8, 0);
    ng_col(NG_MUTED, 1);
    i = 0;
    loop(5,
      24 - 12 * i > 0 ? sprintf(#al_l, "+%d", 24 - 12 * i) : sprintf(#al_l, "%d", 24 - 12 * i);
      ng_ptxt(#al_l, ng_px - 6 * ng_s, ng_py + ng_ph * i / 4, 2);
      i += 1;
    );
    ng_col(NG_ACCENT, 0.15);
    i = 0;
    loop(al_len,
      k = (al_w + i) % al_len;
      h = ng_ph * ng_db_norm(ng_to_db(al_buf[k * 2]), -60);
      h > 0 ? gfx_rect(ng_px + i * ng_s, ng_py + ng_ph - h, ng_s, h);
      i += 1;
    );
    ng_col(NG_TEXT, 0.35);
    yy = floor(ng_lin_y(slider3, -24, 24)) + 0.5;
    gfx_line(ng_px, yy, ng_px + ng_pw, yy, 0);
    yy = floor(ng_lin_y(-slider4, -24, 24)) + 0.5;
    gfx_line(ng_px, yy, ng_px + ng_pw, yy, 0);
    ng_col(NG_ACCENT, 1);
    i = 0;
    loop(al_len,
      k = (al_w + i) % al_len;
      xx = ng_px + (i + 0.5) * ng_s;
      yy = ng_lin_y(al_buf[k * 2 + 1], -24, 24);
      i == 0 ? ng_line_start(xx, yy) : ng_line_to(xx, yy);
      i += 1;
    );
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 7;

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, -18); ng_slider_set(2, 1000); ng_slider_set(3, 12); ng_slider_set(4, 12); ng_slider_set(5, -50); );
    p == 1 ? ( ng_slider_set(1, -20); ng_slider_set(2, 1500); ng_slider_set(3, 10); ng_slider_set(4, 10); ng_slider_set(5, -50); );
    p == 2 ? ( ng_slider_set(1, -18); ng_slider_set(2, 600); ng_slider_set(3, 6); ng_slider_set(4, 6); ng_slider_set(5, -45); );
    p == 3 ? ( ng_slider_set(1, -20); ng_slider_set(2, 3000); ng_slider_set(3, 9); ng_slider_set(4, 9); ng_slider_set(5, -55); );
    p == 4 ? ( ng_slider_set(1, -16); ng_slider_set(2, 800); ng_slider_set(3, 12); ng_slider_set(4, 12); ng_slider_set(5, -45); );
    p == 5 ? ( ng_slider_set(1, -20); ng_slider_set(2, 400); ng_slider_set(3, 15); ng_slider_set(4, 12); ng_slider_set(5, -40); );
    p == 6 ? ( ng_slider_set(1, -14); ng_slider_set(2, 5000); ng_slider_set(3, 3); ng_slider_set(4, 3); ng_slider_set(5, -60); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, -18) && ng_pre_eq(slider2, 1000) && ng_pre_eq(slider3, 12) && ng_pre_eq(slider4, 12) && ng_pre_eq(slider5, -50) ? m = 0;
    m < 0 && ng_pre_eq(slider1, -20) && ng_pre_eq(slider2, 1500) && ng_pre_eq(slider3, 10) && ng_pre_eq(slider4, 10) && ng_pre_eq(slider5, -50) ? m = 1;
    m < 0 && ng_pre_eq(slider1, -18) && ng_pre_eq(slider2, 600) && ng_pre_eq(slider3, 6) && ng_pre_eq(slider4, 6) && ng_pre_eq(slider5, -45) ? m = 2;
    m < 0 && ng_pre_eq(slider1, -20) && ng_pre_eq(slider2, 3000) && ng_pre_eq(slider3, 9) && ng_pre_eq(slider4, 9) && ng_pre_eq(slider5, -55) ? m = 3;
    m < 0 && ng_pre_eq(slider1, -16) && ng_pre_eq(slider2, 800) && ng_pre_eq(slider3, 12) && ng_pre_eq(slider4, 12) && ng_pre_eq(slider5, -45) ? m = 4;
    m < 0 && ng_pre_eq(slider1, -20) && ng_pre_eq(slider2, 400) && ng_pre_eq(slider3, 15) && ng_pre_eq(slider4, 12) && ng_pre_eq(slider5, -40) ? m = 5;
    m < 0 && ng_pre_eq(slider1, -14) && ng_pre_eq(slider2, 5000) && ng_pre_eq(slider3, 3) && ng_pre_eq(slider4, 3) && ng_pre_eq(slider5, -60) ? m = 6;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Podcast Dialogue";
    p == 2 ? s = "Vocal Rider";
    p == 3 ? s = "Live Recording";
    p == 4 ? s = "Broadcast Speech";
    p == 5 ? s = "Field Interview";
    p == 6 ? s = "Gentle Mix Bus";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  ms = rms_c * ms + (1 - rms_c) * 0.5 * (spl0 * spl0 + spl1 * spl1);
  level_db = 10 * log10(max(ms, 0.000000000001));
  level_db > gate ? (
    want = max(-max_down, min(max_up, target - level_db));
    gain_db = speed_c * gain_db + (1 - speed_c) * want;
  );
  g = 10 ^ (gain_db / 20);
  spl0 *= g;
  spl1 *= g;

  // interface only: output RMS and history (reads the audio state, never changes it)
  al_ms = rms_c * al_ms + (1 - rms_c) * 0.5 * (spl0 * spl0 + spl1 * spl1);
  (al_n += 1) >= al_chunk ? (
    al_buf[al_w * 2] = sqrt(ms);
    al_buf[al_w * 2 + 1] = gain_db;
    al_w = (al_w + 1) % al_len;
    al_n = 0;
  );

@gfx 480 294
  ng_knobs_begin("AUTO-LEVELER", "ESSENTIALS", 480, 120, 1, 0);

  // display, left: the last 5.2 s of input level (bars) and gain (line); right: input and
  // output RMS meters with Target marked, and the gain now (HOLD below Gate)
  al_history();
  ng_meter(336, 82, 112, 10, "IN", ng_to_db(sqrt(ms)), slider1, -60);
  ng_meter(336, 106, 112, 10, "OUT", ng_to_db(sqrt(al_ms)), slider1, -60);
  ng_font(1, 7, 1);
  ng_col(NG_MUTED, 1);
  ng_txt(ng_to_db(sqrt(ms)) > slider5 ? "GAIN" : "HOLD", 336, 135, 0, 1);
  sprintf(#al_g, "%+.1f dB", gain_db);
  ng_font(3, 8.5, 0);
  ng_col(NG_TEXT, 1);
  ng_txt(#al_g, 448, 135, 2, 0);

  ng_row(5);
  sprintf(#v1, "%.1f dB", slider1);
  ng_knob_ctl(1, "TARGET", #v1, -36, -6, -18, 0.5, 0) ? update();
  sprintf(#v2, "%d ms", slider2);
  ng_knob_ctl(2, "SPEED", #v2, 100, 5000, 1000, 10, 0) ? update();
  sprintf(#v3, "%.1f dB", slider3);
  ng_knob_ctl(3, "MAX BOOST", #v3, 0, 24, 12, 0.5, 0) ? update();
  sprintf(#v4, "%.1f dB", slider4);
  ng_knob_ctl(4, "MAX CUT", #v4, 0, 24, 12, 0.5, 0) ? update();
  sprintf(#v5, "%d dB", slider5);
  ng_knob_ctl(5, "GATE", #v5, -80, -30, -50, 1, 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
