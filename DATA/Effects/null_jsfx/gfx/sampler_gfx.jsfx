  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "One-Shot Hits";
    p == 2 ? s = "Plucked Keys";
    p == 3 ? s = "Staccato";
    p == 4 ? s = "Looped Sustain";
    p == 5 ? s = "Soft Pad";
    p == 6 ? s = "Reverse Swell";
    p == 7 ? s = "Dark Keys";
    p == 8 ? s = "Resonant Sweep";
    p == 9 ? s = "Lo-Fi Soft";
    p == 10 ? s = "Late Start";
    p == 11 ? s = "Octave Down";
    p == 12 ? s = "Octave Up";
    p == 13 ? s = "Wide Bend";
    p == 14 ? s = "Fixed Velocity";
    p == 15 ? s = "Beat Slicer (16 Slices)";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@block
  // MIDI of this block, played at its offsets in @sample
  mq_n = 0;
  while (midirecv(m_ofs, m_1, m_2, m_3)) (
    // every message goes on to the next plugin too, so instruments can be layered
    midisend(m_ofs, m_1, m_2, m_3);
    mq_n < 256 ? (
      MQ[mq_n * 4] = m_ofs;
      MQ[mq_n * 4 + 1] = m_1;
      MQ[mq_n * 4 + 2] = m_2;
      MQ[mq_n * 4 + 3] = m_3;
      mq_n += 1;
    );
  );
  mq_i = 0;
  si = 0;

  // a note heard from the interface (GFX version): the root key, held for 0.4 s
  sm_preview > 0 ? (
    sm_pv_note = sl_n > 0 ? skey : root; // with Slices: the first slice
    note_on(sm_pv_note, 0.8); sm_pv_left = floor(0.4 * srate); sm_preview = 0;
  );

@sample
  while (mq_i < mq_n && MQ[mq_i * 4] <= si) (
    m_s = MQ[mq_i * 4 + 1] & 0xF0;
    m_n = MQ[mq_i * 4 + 2];
    m_v = MQ[mq_i * 4 + 3];
    m_s == 0x90 && m_v > 0 ? note_on(m_n, m_v / 127) :
    m_s == 0x80 || m_s == 0x90 ? note_off(m_n) :
    m_s == 0xE0 ? (
      bend = m_v * 128;
      bend = (bend + m_n - 8192) / 8192;
      x = slider5 / 100;
      y = bend * slider20;
      g_st = slider4 + x + y;
      rates();
    ) :
    m_s == 0xB0 ? (
      m_n == 64 ? ( ped = m_v >= 64; !ped ? release_free(0); ) :
      m_n == 123 ? release_free(1) :
      m_n == 120 ? kill_all();
    );
    mq_i += 1;
  );
  sm_pv_left > 0 ? ( sm_pv_left -= 1; sm_pv_left < 0.5 ? note_off(sm_pv_note); );
  si += 1;

  outl = outr = 0;
  i = 0;
  loop(NV,
    vb = VOX + i * 32;
    vb[V_ON] ? (
      // the envelope: a linear attack, then towards Sustain, then the release
      st = vb[V_ST];
      e = vb[V_ENV];
      st == 1 ? (
        e += att_inc;
        e >= 1 ? ( e = 1; vb[V_ST] = 2; );
      ) : st == 2 ? (
        e = sus + (e - sus) * dec_c;
      ) : (
        e *= rel_c;
      );
      vb[V_ENV] = e;

      p = vb[V_POS];
      xl = rd(p, 0) + vb[V_TL];
      xr = rd(p, 1) + vb[V_TR];
      vb[V_TL] *= kt; vb[V_TR] *= kt;
      g = e * vb[V_GAIN];
      // the last 3 ms of the sample (or of the slice) fade out
      !lp_on || !vb[V_IN] ? (
        x = vb[V_END] - p;
        x /= vb[V_RATE];
        x < fade_n ? g *= x / fade_n;
      );
      xl *= g; xr *= g;

      f_on ? (
        vb[V_FC] <= 0 ? ( v_filter(vb); vb[V_FC] = 16; );
        vb[V_FC] -= 1;
        // two TPT state-variable low-passes (Q from Resonance)
        v3 = xl - vb[V_S2L];
        v1 = vb[V_A1] * vb[V_S1L] + vb[V_A2] * v3;
        v2 = vb[V_S2L] + vb[V_A2] * vb[V_S1L] + vb[V_A3] * v3;
        vb[V_S1L] = 2 * v1 - vb[V_S1L];
        vb[V_S2L] = 2 * v2 - vb[V_S2L];
        xl = v2;
        v3 = xr - vb[V_S2R];
        v1 = vb[V_A1] * vb[V_S1R] + vb[V_A2] * v3;
        v2 = vb[V_S2R] + vb[V_A2] * vb[V_S1R] + vb[V_A3] * v3;
        vb[V_S1R] = 2 * v1 - vb[V_S1R];
        vb[V_S2R] = 2 * v2 - vb[V_S2R];
        xr = v2;
        vb[V_FE] *= fe_c;
      );
      vb[V_LL] = xl; vb[V_LR] = xr;
      outl += xl; outr += xr;

      // on to the next position; the loop jumps back, its step fading out (loop declick)
      p += vb[V_RATE];
      lp_on && vb[V_IN] && p >= le ? (
        x = p - (le - ls);
        vb[V_TL] += rd(p, 0) - rd(x, 0);
        vb[V_TR] += rd(p, 1) - rd(x, 1);
        p = x;
      );
      vb[V_POS] = p;
      p >= vb[V_END] || (st == 3 && e < 0.0001) || (st == 2 && sus == 0 && e < 0.0001) ? vb[V_ON] = 0;
    );
    i += 1;
  );

  outl += tl; outr += tr;
  tl *= kt; tr *= kt;
  spl0 = outl * vol;
  spl1 = outr * vol;

@gfx 640 448
  ng_knobs_begin("SAMPLER", "INSTRUMENTS", 640, 160, 2, 1);

  // display: the sample's waveform, the start (and with Loop the loop) marked, where each
  // voice plays; a click plays the root key
  sm_ov_id != smp_id ? sm_overview();
  file_ok ? (
    sprintf(#sm_h, "FILE %d: %s, %.1f KHZ, %.2f S", slider1 + 1, nch == 1 ? "MONO" : nch == 2 ? "STEREO" : "MULTI", fsr / 1000, nfr / fsr);
  ) : (
    strcpy(#sm_h, "BUILT-IN SOUND: SOFT PIANO, C4, 1.50 S");
  );
  ng_font(1, 7, 1);
  ng_col(NG_MUTED, 0.6);
  ng_txt(#sm_h, 28, 71, 0, 1);
  sm_note(#sm_r, root);
  sl_n > 0 ? (
    sm_note(#sm_r, skey);
    sprintf(#sm_m, "%s, %d SLICES FROM %s", chrom ? "CHROMATIC" : "ONE-SHOT", sl_n, #sm_r);
  ) : sprintf(#sm_m, "%s, ROOT %s", chrom ? "CHROMATIC" : "ONE-SHOT", #sm_r);
  ng_txt(#sm_m, 612, 71, 2, 1);

  sm_x0 = 28; sm_w = 584; sm_y0 = 82; sm_ht = 116;
  sm_mid = sm_y0 + sm_ht / 2;
  ng_col(NG_BG, 1);
  gfx_rect(X(sm_x0), Y(sm_y0), sm_w * ng_s, sm_ht * ng_s);
  // the loop's part
  lp_on ? (
    ng_col(NG_ACCENT, 0.12);
    sm_a = rev ? nfr - le : ls;
    sm_b = rev ? nfr - ls : le;
    gfx_rect(X(sm_x0 + sm_w * sm_a / nfr), Y(sm_y0), max(1, sm_w * (sm_b - sm_a) / nfr * ng_s), sm_ht * ng_s);
  );
  ng_col(NG_BORDER, 1);
  gfx_line(X(sm_x0), Y(sm_mid), X(sm_x0 + sm_w), Y(sm_mid));
  // the waveform (its peak at 90% of the height); before Start dimmed
  sm_st = rev ? nfr - 1 - p0 : p0;
  sm_k = sm_ov_pk > 0 ? 0.9 / sm_ov_pk : 0;
  sm_j = 0;
  loop(OVN,
    sm_fx = sm_j * nfr / OVN;
    sm_on = rev ? sm_fx <= sm_st : sm_fx >= sm_st;
    ng_col(NG_ACCENT, sm_on ? 0.85 : 0.3);
    sm_a = OV[sm_j] * sm_k * sm_ht / 2;
    gfx_rect(X(sm_x0 + sm_j * sm_w / OVN), Y(sm_mid - sm_a), sm_w / OVN * ng_s + 1, max(1, 2 * sm_a * ng_s));
    sm_j += 1;
  );
  // Start, and the loop's ends
  ng_col(NG_TEXT, 0.9);
  sm_xx = X(sm_x0 + sm_w * sm_st / nfr);
  gfx_line(sm_xx, Y(sm_y0), sm_xx, Y(sm_y0 + sm_ht));
  ng_font(1, 6.5, 1);
  ng_txt("S", sm_x0 + sm_w * sm_st / nfr + (rev ? -5 : 5), sm_y0 + 7, 1, 0);
  lp_on ? (
    ng_col(NG_TEXT, 0.5);
    sm_xx = X(sm_x0 + sm_w * (rev ? nfr - le : ls) / nfr);
    gfx_line(sm_xx, Y(sm_y0), sm_xx, Y(sm_y0 + sm_ht));
    sm_xx = X(sm_x0 + sm_w * (rev ? nfr - ls : le) / nfr);
    gfx_line(sm_xx, Y(sm_y0), sm_xx, Y(sm_y0 + sm_ht));
  );
  // the slices' borders
  sl_n > 0 ? (
    ng_col(NG_TEXT, 0.35);
    sm_j = 1;
    loop(sl_n - 1,
      sm_xx = X(sm_x0 + sm_w * sm_j / sl_n);
      gfx_line(sm_xx, Y(sm_y0), sm_xx, Y(sm_y0 + sm_ht));
      sm_j += 1;
    );
  );
  // the voices that play
  sm_nv = 0;
  sm_i = 0;
  loop(NV,
    sm_vb = VOX + sm_i * 32;
    sm_vb[V_ON] ? (
      sm_nv += 1;
      sm_p = rev ? nfr - 1 - sm_vb[V_POS] : sm_vb[V_POS];
      ng_col(NG_TEXT, 0.3 + 0.7 * min(1, sm_vb[V_ENV]));
      sm_xx = X(sm_x0 + sm_w * sm_p / nfr);
      gfx_rect(sm_xx, Y(sm_y0), max(1, 2 * ng_s), sm_ht * ng_s);
    );
    sm_i += 1;
  );
  ng_col(NG_BORDER, 1);
  gfx_rect(X(sm_x0), Y(sm_y0), sm_w * ng_s, sm_ht * ng_s, 0);
  ng_font(1, 7, 1);
  ng_col(NG_MUTED, 0.6);
  sprintf(#sm_v, "%d / 16 VOICES", sm_nv);
  ng_txt(#sm_v, 28, 206, 0, 1);
  ng_txt(sl_n > 0 ? "CLICK THE WAVE TO HEAR THE FIRST SLICE" : "CLICK THE WAVE TO HEAR THE ROOT KEY", 612, 206, 2, 1);
  ng_click && mouse_x >= X(sm_x0) && mouse_x < X(sm_x0 + sm_w) && mouse_y >= Y(sm_y0) && mouse_y < Y(sm_y0 + sm_ht) ? sm_preview = 1;

  // controls
  sm_tab = ng_tabs("SAMPLE|SHAPE", sm_tab);
  sm_tab == 0 ? (
    ng_row(6);
    sm_file_ctl() ? update();
    ng_select_ctl(2, "MODE", "ONE-SHOT|CHROMATIC", 0) ? update();
    sm_note(#v3, slider3);
    ng_knob_ctl(3, "ROOT", #v3, 0, 127, 60, 1, 0) ? update();
    sprintf(#v4, "%+d st", slider4);
    ng_knob_ctl(4, "TRANSPOSE", #v4, -24, 24, 0, 1, 1) ? update();
    sprintf(#v5, "%+d ct", slider5);
    ng_knob_ctl(5, "FINE", #v5, -100, 100, 0, 1, 1) ? update();
    sprintf(#v21, "%+.1f dB", slider21);
    ng_knob_ctl(21, "VOLUME", #v21, -24, 12, 0, 0.1, 0) ? update();
    ng_row(6);
    sprintf(#v17, "%.1f%%", slider17);
    ng_knob_ctl(17, "START", #v17, 0, 100, 0, 0.1, 0) ? update();
    ng_select_ctl(18, "REVERSE", "OFF|ON", 0) ? update();
    ng_select_ctl(14, "LOOP", "OFF|ON", 0) ? update();
    sprintf(#v15, "%.1f%%", slider15);
    ng_knob_ctl(15, "LOOP START", #v15, 0, 100, 0, 0.1, 0) ? update();
    sprintf(#v16, "%.1f%%", slider16);
    ng_knob_ctl(16, "LOOP END", #v16, 0, 100, 100, 0.1, 0) ? update();
    sprintf(#v20, "%d st", slider20);
    ng_knob_ctl(20, "BEND", #v20, 0, 24, 2, 1, 0) ? update();
  ) : (
    ng_row(5);
    sm_ms(#v6, slider6);
    ng_knob_ctl_log(6, "ATTACK", #v6, 1, 5000, 1, 1) ? update();
    sm_ms(#v7, slider7);
    ng_knob_ctl_log(7, "DECAY", #v7, 1, 5000, 800, 1) ? update();
    sprintf(#v8, "%d%%", slider8);
    ng_knob_ctl(8, "SUSTAIN", #v8, 0, 100, 100, 1, 0) ? update();
    sm_ms(#v9, slider9);
    ng_knob_ctl_log(9, "RELEASE", #v9, 1, 5000, 250, 1) ? update();
    sprintf(#v19, "%d%%", slider19);
    ng_knob_ctl(19, "VELOCITY", #v19, 0, 100, 100, 1, 0) ? update();
    ng_row(6);
    slider10 >= 1000 ? sprintf(#v10, "%.1f kHz", slider10 / 1000) : sprintf(#v10, "%d Hz", slider10);
    ng_knob_ctl_log(10, "CUTOFF", #v10, 20, 20000, 20000, 1) ? update();
    sprintf(#v11, "%d%%", slider11);
    ng_knob_ctl(11, "RESONANCE", #v11, 0, 100, 0, 1, 0) ? update();
    sprintf(#v12, "%+d%%", slider12);
    ng_knob_ctl(12, "FILTER ENV", #v12, -100, 100, 0, 1, 1) ? update();
    sm_ms(#v13, slider13);
    ng_knob_ctl_log(13, "FILTER DECAY", #v13, 1, 5000, 300, 1) ? update();
    ng_select_ctl(22, "SLICES", "OFF|4|8|16|32|64", 0) ? update();
    sm_note(#v23, slider23);
    ng_knob_ctl(23, "SLICE KEY", #v23, 0, 127, 36, 1, 0) ? update();
  );

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
