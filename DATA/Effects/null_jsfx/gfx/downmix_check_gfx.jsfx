desc:NULL Downmix Check GFX
author: Christos Koulaxizis
tags: surround downmix fold down check 5.1 7.1 7.1.4 atmos bed lo ro stereo mono solo itu bs775 monitoring post production gui
//category: Advanced
//NULL JSFX v2.9 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:2<0,2,1{5.1,7.1,7.1.4}>-Bed
slider2:2<0,3,1{Bed,5.1,Stereo Lo/Ro,Mono}>-Monitor
slider3:-3<-6,0,0.5>-Center Mix (dB)
slider4:-3<-6,0,0.5>-Surround Mix (dB)
slider5:-3<-6,0,0.5>-Height Mix (dB)
slider6:-60<-60,10,0.5>-LFE Mix (dB)
slider7:0<0,12,1{Off,L,R,C,LFE,Ls,Rs,Lrs,Rrs,Ltf,Rtf,Ltr,Rtr}>-Solo
slider8:0<-24,12,0.1>-Output (dB)

in_pin:L
in_pin:R
in_pin:C
in_pin:LFE
in_pin:Ls
in_pin:Rs
in_pin:Lrs
in_pin:Rrs
in_pin:Ltf
in_pin:Rtf
in_pin:Ltr
in_pin:Rtr
out_pin:L
out_pin:R
out_pin:C
out_pin:LFE
out_pin:Ls
out_pin:Rs
out_pin:Lrs
out_pin:Rrs
out_pin:Ltf
out_pin:Rtf
out_pin:Ltr
out_pin:Rtr

@init
  // Hears a surround bed the way smaller systems will: the Bed as it is, folded to 5.1, to
  // stereo (Lo/Ro, ITU-R BS.775) or to mono, on the first pins (Stereo and Mono on L and R, the
  // other pins silent). Bed says which pins carry the mix (L R C LFE Ls Rs | Lrs Rrs | Ltf Rtf
  // Ltr Rtr); the pins it does not use are ignored. The folds:
  //   7.1.4 to 7.1: each top into the ear-level speaker below it (Ltf to L, Ltr to Lss), at
  //     Height Mix
  //   7.1 to 5.1: the side and the rear of each side summed at -3 dB into Ls/Rs
  //   5.1 to Lo/Ro: Lo = L + C x Center Mix + Ls x Surround Mix (Ro likewise), the LFE at LFE
  //     Mix (Off at -60 dB, as BS.775 drops it)
  //   Mono: (Lo + Ro) / 2
  // Solo plays one pin of the bed alone, through the same fold. The audio is only re-routed:
  // gains, no filters, no latency.
  dm_pk = 0;   // the folded stereo's peak, for the display
  MTR = 0;      // the display: each bed pin's peak (after Solo), and each output's
  MTO = 16;
  memset(0, 0, 32);
  dm_hold = 0;

  gfx_ext_retina = 1;
  function update()
  (
    bed = slider1;
    mon = slider2;
    cmix = 10 ^ (slider3 / 20);
    smix = 10 ^ (slider4 / 20);
    hmix = 10 ^ (slider5 / 20);
    lmix = slider6 > -60 ? 10 ^ (slider6 / 20) : 0;
    solo = slider7;
    outg = 10 ^ (slider8 / 20);
    g71 = bed >= 1 ? sqrt(0.5) : 1;
  dm_hold = 0;
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 12;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1); ng_hist_add(2); ng_hist_add(3); ng_hist_add(4); ng_hist_add(5); ng_hist_add(6); ng_hist_add(7); ng_hist_add(8);
  ng_hist_init();

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 2); ng_slider_set(2, 2); ng_slider_set(3, -3); ng_slider_set(4, -3); ng_slider_set(5, -3); ng_slider_set(6, -60); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 1 ? ( ng_slider_set(1, 2); ng_slider_set(2, 2); ng_slider_set(3, -3); ng_slider_set(4, -3); ng_slider_set(5, -3); ng_slider_set(6, -10); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 2 ? ( ng_slider_set(1, 2); ng_slider_set(2, 2); ng_slider_set(3, 0); ng_slider_set(4, -3); ng_slider_set(5, -3); ng_slider_set(6, -60); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 3 ? ( ng_slider_set(1, 2); ng_slider_set(2, 2); ng_slider_set(3, -3); ng_slider_set(4, -6); ng_slider_set(5, -3); ng_slider_set(6, -60); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 4 ? ( ng_slider_set(1, 2); ng_slider_set(2, 3); ng_slider_set(3, -3); ng_slider_set(4, -3); ng_slider_set(5, -3); ng_slider_set(6, -60); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 5 ? ( ng_slider_set(1, 2); ng_slider_set(2, 1); ng_slider_set(3, -3); ng_slider_set(4, -3); ng_slider_set(5, -3); ng_slider_set(6, -60); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 6 ? ( ng_slider_set(1, 1); ng_slider_set(2, 1); ng_slider_set(3, -3); ng_slider_set(4, -3); ng_slider_set(5, -3); ng_slider_set(6, -60); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 7 ? ( ng_slider_set(1, 0); ng_slider_set(2, 2); ng_slider_set(3, -3); ng_slider_set(4, -3); ng_slider_set(5, -3); ng_slider_set(6, -60); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 8 ? ( ng_slider_set(1, 2); ng_slider_set(2, 0); ng_slider_set(3, -3); ng_slider_set(4, -3); ng_slider_set(5, -3); ng_slider_set(6, -60); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 9 ? ( ng_slider_set(1, 2); ng_slider_set(2, 0); ng_slider_set(3, -3); ng_slider_set(4, -3); ng_slider_set(5, -3); ng_slider_set(6, -60); ng_slider_set(7, 3); ng_slider_set(8, 0); );
    p == 10 ? ( ng_slider_set(1, 2); ng_slider_set(2, 0); ng_slider_set(3, -3); ng_slider_set(4, -3); ng_slider_set(5, -3); ng_slider_set(6, -60); ng_slider_set(7, 4); ng_slider_set(8, 0); );
    p == 11 ? ( ng_slider_set(1, 2); ng_slider_set(2, 2); ng_slider_set(3, -6); ng_slider_set(4, -3); ng_slider_set(5, 0); ng_slider_set(6, -60); ng_slider_set(7, 0); ng_slider_set(8, 0); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 2) && ng_pre_eq(slider3, -3) && ng_pre_eq(slider4, -3) && ng_pre_eq(slider5, -3) && ng_pre_eq(slider6, -60) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 2) && ng_pre_eq(slider3, -3) && ng_pre_eq(slider4, -3) && ng_pre_eq(slider5, -3) && ng_pre_eq(slider6, -10) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 2) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, -3) && ng_pre_eq(slider5, -3) && ng_pre_eq(slider6, -60) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 2) && ng_pre_eq(slider3, -3) && ng_pre_eq(slider4, -6) && ng_pre_eq(slider5, -3) && ng_pre_eq(slider6, -60) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 3) && ng_pre_eq(slider3, -3) && ng_pre_eq(slider4, -3) && ng_pre_eq(slider5, -3) && ng_pre_eq(slider6, -60) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 1) && ng_pre_eq(slider3, -3) && ng_pre_eq(slider4, -3) && ng_pre_eq(slider5, -3) && ng_pre_eq(slider6, -60) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 1) && ng_pre_eq(slider3, -3) && ng_pre_eq(slider4, -3) && ng_pre_eq(slider5, -3) && ng_pre_eq(slider6, -60) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 2) && ng_pre_eq(slider3, -3) && ng_pre_eq(slider4, -3) && ng_pre_eq(slider5, -3) && ng_pre_eq(slider6, -60) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, -3) && ng_pre_eq(slider4, -3) && ng_pre_eq(slider5, -3) && ng_pre_eq(slider6, -60) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 8;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, -3) && ng_pre_eq(slider4, -3) && ng_pre_eq(slider5, -3) && ng_pre_eq(slider6, -60) && ng_pre_eq(slider7, 3) && ng_pre_eq(slider8, 0) ? m = 9;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, -3) && ng_pre_eq(slider4, -3) && ng_pre_eq(slider5, -3) && ng_pre_eq(slider6, -60) && ng_pre_eq(slider7, 4) && ng_pre_eq(slider8, 0) ? m = 10;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 2) && ng_pre_eq(slider3, -6) && ng_pre_eq(slider4, -3) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, -60) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 11;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Stereo Lo/Ro with LFE";
    p == 2 ? s = "Stereo Dialogue Forward";
    p == 3 ? s = "Stereo Soft Surrounds";
    p == 4 ? s = "Mono Check";
    p == 5 ? s = "7.1.4 to 5.1";
    p == 6 ? s = "7.1 to 5.1";
    p == 7 ? s = "5.1 to Stereo";
    p == 8 ? s = "Bed Pass";
    p == 9 ? s = "Solo Center";
    p == 10 ? s = "Solo LFE";
    p == 11 ? s = "Heights in Stereo";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  // the pins of the Bed, or the soloed one
  i0 = spl0; i1 = spl1; i2 = spl2; i3 = spl3; i4 = spl4; i5 = spl5;
  i6 = bed >= 1 ? spl6 : 0; i7 = bed >= 1 ? spl7 : 0;
  i8 = bed == 2 ? spl8 : 0; i9 = bed == 2 ? spl9 : 0; i10 = bed == 2 ? spl10 : 0; i11 = bed == 2 ? spl11 : 0;
  solo > 0 ? (
    solo != 1 ? i0 = 0; solo != 2 ? i1 = 0; solo != 3 ? i2 = 0; solo != 4 ? i3 = 0;
    solo != 5 ? i4 = 0; solo != 6 ? i5 = 0; solo != 7 ? i6 = 0; solo != 8 ? i7 = 0;
    solo != 9 ? i8 = 0; solo != 10 ? i9 = 0; solo != 11 ? i10 = 0; solo != 12 ? i11 = 0;
  );
  MTR[0] = max(MTR[0], abs(i0)); MTR[1] = max(MTR[1], abs(i1)); MTR[2] = max(MTR[2], abs(i2));
  MTR[3] = max(MTR[3], abs(i3)); MTR[4] = max(MTR[4], abs(i4)); MTR[5] = max(MTR[5], abs(i5));
  MTR[6] = max(MTR[6], abs(i6)); MTR[7] = max(MTR[7], abs(i7)); MTR[8] = max(MTR[8], abs(i8));
  MTR[9] = max(MTR[9], abs(i9)); MTR[10] = max(MTR[10], abs(i10)); MTR[11] = max(MTR[11], abs(i11));
  // 7.1.4 to 7.1, 7.1 to 5.1
  f0 = i0 + i8 * hmix;
  f1 = i1 + i9 * hmix;
  f4 = (i4 + i10 * hmix + i6) * g71;
  f5 = (i5 + i11 * hmix + i7) * g71;
  // 5.1 to Lo/Ro
  lo = f0 + i2 * cmix + f4 * smix + i3 * lmix;
  ro = f1 + i2 * cmix + f5 * smix + i3 * lmix;
  dm_pk = max(dm_pk, max(abs(lo), abs(ro)) * outg);
  mon == 0 ? (
    spl0 = i0 * outg; spl1 = i1 * outg; spl2 = i2 * outg; spl3 = i3 * outg;
    spl4 = i4 * outg; spl5 = i5 * outg; spl6 = i6 * outg; spl7 = i7 * outg;
    spl8 = i8 * outg; spl9 = i9 * outg; spl10 = i10 * outg; spl11 = i11 * outg;
  ) : mon == 1 ? (
    spl0 = f0 * outg; spl1 = f1 * outg; spl2 = i2 * outg; spl3 = i3 * outg;
    spl4 = f4 * outg; spl5 = f5 * outg;
    spl6 = spl7 = spl8 = spl9 = spl10 = spl11 = 0;
  ) : (
    mon == 3 ? lo = ro = (lo + ro) * 0.5;
    spl0 = lo * outg; spl1 = ro * outg;
    spl2 = spl3 = spl4 = spl5 = spl6 = spl7 = spl8 = spl9 = spl10 = spl11 = 0;
  );
  k = 0;
  loop(12, MTO[k] = max(MTO[k], abs(spl(k))); k += 1;);

@gfx 480 460
  ng_knobs_begin("DOWNMIX CHECK", "ADVANCED", 480, 200, 2, 0);

  // a meter row: the pin's name, then its peak on a -60..0 dB bar (silver, white over 0 dB)
  function dm_row(x, y, w, name, pk, on) local(f)
  (
    ng_font(1, 6, 1);
    ng_col(on ? NG_MUTED : NG_BORDER, 1);
    ng_txt(name, x, y + 4.5, 0, 0.5);
    ng_col(NG_CARD, 1);
    gfx_rect(X(x + 26), Y(y), (w - 26) * ng_s, 9 * ng_s);
    on ? (
      f = ng_db_norm(ng_to_db(pk), -60);
      ng_col(pk > 1 ? NG_TEXT : NG_ACCENT, 1);
      gfx_rect(X(x + 26), Y(y), (w - 26) * f * ng_s, 9 * ng_s);
    );
  );
  function dm_pin(k) ( strcpy(#dm_n, k == 0 ? "L" : k == 1 ? "R" : k == 2 ? "C" : k == 3 ? "LFE" : k == 4 ? (bed ? "LSS" : "LS") :
                       k == 5 ? (bed ? "RSS" : "RS") : k == 6 ? "LRS" : k == 7 ? "RRS" : k == 8 ? "LTF" : k == 9 ? "RTF" :
                       k == 10 ? "LTR" : "RTR"); );

  // left, the bed coming in (after Solo); right, what the Monitor plays, and the fold's peak
  ng_col(NG_BG, 1);
  gfx_rect(X(24), Y(62), 208 * ng_s, 180 * ng_s);
  gfx_rect(X(244), Y(62), 212 * ng_s, 180 * ng_s);
  ng_font(1, 7, 1);
  ng_col(NG_MUTED, 1);
  ng_txt(bed == 0 ? "BED 5.1" : bed == 1 ? "BED 7.1" : "BED 7.1.4", 32, 70, 0, 1.2);
  ng_txt(mon == 0 ? "MONITOR BED" : mon == 1 ? "MONITOR 5.1" : mon == 2 ? "MONITOR LO/RO" : "MONITOR MONO", 252, 70, 0, 1.2);
  g_k = 0;
  loop(12,
    dm_pin(g_k);
    g_on = g_k < 6 || (g_k < 8 && bed >= 1) || bed == 2;
    dm_row(32, 82 + g_k * 13, 192, #dm_n, MTR[g_k], g_on);
    g_on = mon == 0 ? g_on : mon == 1 ? g_k < 6 : g_k < 2;
    mon >= 2 && g_k < 2 ? strcpy(#dm_n, g_k ? "RO" : "LO");
    mon == 3 && g_k < 2 ? strcpy(#dm_n, "M");
    dm_row(252, 82 + g_k * 13, 196, #dm_n, MTO[g_k], g_on);
    MTR[g_k] *= 0.85;
    MTO[g_k] *= 0.85;
    g_k += 1;
  );
  // the fold to Lo/Ro: its highest peak since the last change (over 0 dBFS it would clip)
  dm_hold = max(dm_hold, dm_pk);
  dm_pk = 0;
  ng_font(1, 7, 1);
  ng_col(dm_hold > 1 ? NG_TEXT : NG_MUTED, 1);
  dm_hold > 0.0000001 ? sprintf(#g_m, "FOLD PEAK %+.1f%s", ng_to_db(dm_hold), dm_hold > 1 ? " CLIPS" : "") : strcpy(#g_m, "FOLD PEAK -INF");
  ng_txt(#g_m, 448, 70, 2, 1);

  ng_row(4);
  ng_select_ctl(1, "BED", "5.1|7.1|7.1.4", 0) ? update();
  ng_select_ctl(2, "MONITOR", "BED|5.1|LO/RO|MONO", 0) ? update();
  ng_select_ctl(7, "SOLO", "OFF|L|R|C|LFE|LS|RS|LRS|RRS|LTF|RTF|LTR|RTR", 0) ? update();
  sprintf(#v8, "%+.1f dB", slider8);
  ng_knob_ctl(8, "OUTPUT", #v8, -24, 12, 0, 0.1, 1) ? update();
  ng_row(4);
  sprintf(#v3, "%.1f dB", slider3);
  ng_knob_ctl(3, "CENTER MIX", #v3, -6, 0, -3, 0.5, 0) ? update();
  sprintf(#v4, "%.1f dB", slider4);
  ng_knob_ctl(4, "SURROUND MIX", #v4, -6, 0, -3, 0.5, 0) ? update();
  sprintf(#v5, "%.1f dB", slider5);
  ng_knob_ctl(5, "HEIGHT MIX", #v5, -6, 0, -3, 0.5, 0) ? update();
  slider6 <= -60 ? strcpy(#v6, "OFF") : sprintf(#v6, "%+.1f dB", slider6);
  ng_knob_ctl(6, "LFE MIX", #v6, -60, 10, -60, 0.5, 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
