desc:NULL Chords GFX
author: Christos Koulaxizis
tags: midi chords chord generator one finger triad seventh ninth sus power inversion voicing strum progression key scale diatonic gui
//category: MIDI
//NULL JSFX v2.6.1 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:0<0,1,1{Chord,Progression}>-Mode
slider2:0<0,11,1{C,C#,D,D#,E,F,F#,G,G#,A,A#,B}>-Key
slider3:0<0,8,1{Major,Minor,Harmonic Minor,Melodic Minor,Dorian,Phrygian,Lydian,Mixolydian,Locrian}>-Scale
slider4:0<0,5,1{Triad,7th,9th,Sus2,Sus4,Power}>-Chord Type
slider5:0<0,3,1{Root,1st,2nd,3rd}>-Inversion
slider6:0<0,3,1{Close,Drop 2,Open,Wide}>-Voicing
slider7:0<-2,2,1>-Octave
slider8:0<0,200,1>-Strum (ms)
slider9:0<0,2,1{Up,Down,Alternate}>-Strum Direction
slider10:0<-100,100,1>-Velocity Curve (%)
slider11:0<0,8,1{I-V-vi-IV,I-vi-IV-V,vi-IV-I-V,I-IV-vi-V,ii-V-I,Canon,i-VI-III-VII,i-VII-VI-V,i-iv-V-i}>-Progression

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  // A MIDI effect: every key plays a chord of the chosen key and scale (Chord mode), or every
  // white key from C plays the next step of a progression (Progression mode). The audio passes
  // through untouched. Every note-on that goes out is remembered with the key that made it, so
  // the key's note-off always ends exactly those notes; strummed notes still waiting when the
  // key is released are never sent. A pitch two keys share stays on until both are released.
  ext_noinit = 1;
  ACT = 0;       // per input channel * 128 + note: 1 while the key is held
  SN = 2048;     // how many notes the key sounds
  SO = 4096;     // the notes (8 per key)
  SON = 20480;   // when each of them starts (in samples since the start)
  CNT = 36864;   // per output channel * 128 + note: how many keys hold it
  Q = 38912;     // the queue of outgoing messages: time, status, data 1, data 2, key (5 each)
  QMAX = 1024;
  SCL = 44100;   // scales: 8 per scale, [0] = size, then the semitones
  PRG = 44200;   // progressions: 20 per progression, [0] = steps, then degree and scale per step
  CT = 44400;    // a chord being built (see cd_build)
  memset(0, 0, 44500);
  qn = 0;
  bpos = 0;
  alt_dir = 0;
  last_note = -1;

  function cd_scl(s, a, b, c, d, e, f, g)
  (
    SCL[s * 8] = 7;
    SCL[s * 8 + 1] = a; SCL[s * 8 + 2] = b; SCL[s * 8 + 3] = c; SCL[s * 8 + 4] = d;
    SCL[s * 8 + 5] = e; SCL[s * 8 + 6] = f; SCL[s * 8 + 7] = g;
  );
  cd_scl(0, 0, 2, 4, 5, 7, 9, 11);  // Major
  cd_scl(1, 0, 2, 3, 5, 7, 8, 10);  // Minor (natural)
  cd_scl(2, 0, 2, 3, 5, 7, 8, 11);  // Harmonic Minor
  cd_scl(3, 0, 2, 3, 5, 7, 9, 11);  // Melodic Minor
  cd_scl(4, 0, 2, 3, 5, 7, 9, 10);  // Dorian
  cd_scl(5, 0, 1, 3, 5, 7, 8, 10);  // Phrygian
  cd_scl(6, 0, 2, 4, 6, 7, 9, 11);  // Lydian
  cd_scl(7, 0, 2, 4, 5, 7, 9, 10);  // Mixolydian
  cd_scl(8, 0, 1, 3, 5, 6, 8, 10);  // Locrian

  // a progression step: degree (0 = I) in a scale (0 major, 1 minor, 2 harmonic minor for a major V)
  function cd_step(p, k, d, s)
  (
    PRG[p * 20 + 1 + 2 * k] = d;
    PRG[p * 20 + 2 + 2 * k] = s;
    PRG[p * 20] = max(PRG[p * 20], k + 1);
  );
  function cd_prog4(p, d1, d2, d3, d4, s)
  (
    cd_step(p, 0, d1, s); cd_step(p, 1, d2, s); cd_step(p, 2, d3, s); cd_step(p, 3, d4, s);
  );
  cd_prog4(0, 0, 4, 5, 3, 0);  // I-V-vi-IV
  cd_prog4(1, 0, 5, 3, 4, 0);  // I-vi-IV-V
  cd_prog4(2, 5, 3, 0, 4, 0);  // vi-IV-I-V
  cd_prog4(3, 0, 3, 5, 4, 0);  // I-IV-vi-V
  cd_step(4, 0, 1, 0); cd_step(4, 1, 4, 0); cd_step(4, 2, 0, 0);  // ii-V-I
  cd_prog4(5, 0, 4, 5, 2, 0);  // Canon: I-V-vi-iii-IV-I-IV-V
  cd_step(5, 4, 3, 0); cd_step(5, 5, 0, 0); cd_step(5, 6, 3, 0); cd_step(5, 7, 4, 0);
  cd_prog4(6, 0, 5, 2, 6, 1);  // i-VI-III-VII
  cd_prog4(7, 0, 6, 5, 4, 1);  // i-VII-VI-V, the V major
  cd_step(7, 3, 4, 2);
  cd_prog4(8, 0, 3, 4, 0, 1);  // i-iv-V-i, the V major
  cd_step(8, 2, 4, 2);

  // semitones of degree j (0 = the tonic, 7 = the tonic an octave up) of scale s
  function cd_semi(s, j) local(m)
  (
    m = SCL[s * 8];
    SCL[s * 8 + 1 + j % m] + 12 * floor(j / m);
  );

  function cd_sort(o, n) local(i, j, t)
  (
    i = 1;
    loop(n - 1,
      t = o[i];
      j = i - 1;
      while (j >= 0 && o[j] > t) ( o[j + 1] = o[j]; j -= 1; );
      o[j + 1] = t;
      i += 1;
    );
  );

  // The chord input note n plays, into o: o[0..7] the notes (ascending), o[8] how many (0 =
  // none), o[9] the root note, o[10] its degree (0..6), o[11] the scale, o[12..15] the root
  // position intervals of the third, fifth, seventh and ninth (for the name in the display).
  function cd_build(n, o) local(pc, d, s, root, w, k, m, i, j, c, sd, iv)
  (
    o[8] = 0;
    d = -1;
    mode == 0 ? (
      // the scale note at or below the key
      s = scale;
      pc = (n - key + 120) % 12;
      d = 6;
      while (d > 0 && SCL[s * 8 + 1 + d] > pc) ( d -= 1; );
      root = n - pc + SCL[s * 8 + 1 + d];
    ) : (
      // the white keys from C play the steps, over and over
      pc = n % 12;
      w = pc == 0 ? 0 : pc == 2 ? 1 : pc == 4 ? 2 : pc == 5 ? 3 : pc == 7 ? 4 : pc == 9 ? 5 : pc == 11 ? 6 : -1;
      w >= 0 ? (
        k = w % PRG[prog * 20];
        d = PRG[prog * 20 + 1 + 2 * k];
        s = PRG[prog * 20 + 2 + 2 * k];
        root = n - pc + key + SCL[s * 8 + 1 + d];
      );
    );
    d >= 0 ? (
      o[9] = root; o[10] = d; o[11] = s;
      sd = SCL[s * 8 + 1 + d];
      ctype == 5 ? (
        // power chord: root, fifth, octave
        o[0] = root; o[1] = root + cd_semi(s, d + 4) - sd; o[2] = root + 12;
        c = 3;
        o[12] = 0; o[13] = o[1] - root; o[14] = 0; o[15] = 0;
      ) : (
        // stacked thirds (sus: the second or the fourth for the third)
        c = ctype == 1 ? 4 : ctype == 2 ? 5 : 3;
        k = 0;
        loop(c,
          iv = k == 1 && ctype == 3 ? 1 : k == 1 && ctype == 4 ? 3 : 2 * k;
          o[k] = root + cd_semi(s, d + iv) - sd;
          k += 1;
        );
        o[12] = o[1] - root; o[13] = o[2] - root;
        o[14] = c > 3 ? o[3] - root : 0;
        o[15] = c > 4 ? o[4] - root - 12 : 0;
      );
      // inversion: the lowest notes up an octave
      loop(inv % c, o[0] += 12; cd_sort(o, c););
      // voicing
      voicing == 1 && c >= 3 ? ( o[c - 2] -= 12; cd_sort(o, c); );
      voicing >= 2 ? (
        i = 1;
        while (i < c) ( o[i] += 12; i += 2; );
        cd_sort(o, c);
        voicing == 3 ? o[0] -= 12;
      );
      // octave, then the notes MIDI has, each once
      j = 0;
      i = 0;
      loop(c,
        m = o[i] + 12 * octv;
        m >= 0 && m <= 127 && (j == 0 || m != o[j - 1]) ? ( o[j] = m; j += 1; );
        i += 1;
      );
      o[8] = j;
    );
  );

  function cd_vel(v)
  (
    max(1, min(127, floor(127 * (v / 127) ^ vexp + 0.5)));
  );

  // queue a message at time t (after every one already queued for t or earlier)
  function cd_put(t, a, b, c, s) local(i, k)
  (
    qn < QMAX ? (
      i = qn;
      while (i > 0 && Q[(i - 1) * 5] > t) (
        k = 0;
        loop(5, Q[i * 5 + k] = Q[(i - 1) * 5 + k]; k += 1;);
        i -= 1;
      );
      Q[i * 5] = t; Q[i * 5 + 1] = a; Q[i * 5 + 2] = b; Q[i * 5 + 3] = c; Q[i * 5 + 4] = s;
      qn += 1;
    );
  );

  // take back the note-on of note p that key s still has waiting
  function cd_drop(s, p) local(i, f, k)
  (
    f = -1;
    i = 0;
    while (f < 0 && i < qn) (
      Q[i * 5 + 4] == s && Q[i * 5 + 2] == p && (Q[i * 5 + 1] & 0xF0) == 0x90 ? f = i;
      i += 1;
    );
    f >= 0 ? (
      i = f;
      loop(qn - 1 - f,
        k = 0;
        loop(5, Q[i * 5 + k] = Q[(i + 1) * 5 + k]; k += 1;);
        i += 1;
      );
      qn -= 1;
    );
  );

  // key s released at time t: note-offs for what it sounds, its strummed notes still waiting dropped
  function cd_release(t, s, v) local(i, p)
  (
    i = 0;
    loop(SN[s],
      p = SO[s * 8 + i];
      SON[s * 8 + i] <= t ? cd_put(t, 0x80 | floor(s / 128), p, v, s) : cd_drop(s, p);
      i += 1;
    );
    ACT[s] = 0;
    SN[s] = 0;
  );

  function cd_note_on(t, ch, n, v) local(s, c, i, k, vo, dn)
  (
    s = ch * 128 + n;
    ACT[s] ? cd_release(t, s, 0);
    cd_build(n, CT);
    c = CT[8];
    ACT[s] = 1;
    SN[s] = c;
    c > 0 ? (
      last_note = n;
      vo = cd_vel(v);
      dn = sdir == 1 || (sdir == 2 && alt_dir);
      sdir == 2 ? alt_dir = 1 - alt_dir;
      i = 0;
      loop(c,
        k = dn ? c - 1 - i : i;
        SO[s * 8 + i] = CT[k];
        SON[s * 8 + i] = t + i * st_samp;
        cd_put(t + i * st_samp, 0x90 | ch, CT[k], vo, s);
        i += 1;
      );
    );
  );

  // one incoming message at time t
  function cd_in(t, a, b, c) local(st, ch, s, i)
  (
    st = a & 0xF0;
    ch = a & 0x0F;
    s = ch * 128 + b;
    st == 0x90 && c > 0 ? (
      cd_note_on(t, ch, b, c);
    ) : st == 0x80 || st == 0x90 ? (
      ACT[s] ? cd_release(t, s, st == 0x80 ? c : 0);
    ) : st == 0xA0 ? (
      // poly pressure goes to every note the key sounds
      i = 0;
      loop(SN[s],
        SON[s * 8 + i] <= t ? cd_put(t, a, SO[s * 8 + i], c, -1);
        i += 1;
      );
    ) : st == 0xB0 && (b == 120 || b == 123) ? (
      // all notes off: release every key of the channel first
      i = 0;
      loop(128, ACT[ch * 128 + i] ? cd_release(t, ch * 128 + i, 0); i += 1;);
      cd_put(t, a, b, c, -1);
    ) : (
      cd_put(t, a, b, c, -1);
    );
  );

  // send one queued message; a note shared by several keys starts again and ends with the last
  function cd_emit(ofs, a, b, c) local(st, k)
  (
    st = a & 0xF0;
    k = (a & 0x0F) * 128 + b;
    st == 0x90 ? (
      CNT[k] > 0 ? midisend(ofs, 0x80 | (a & 0x0F), b, 0);
      midisend(ofs, a, b, c);
      CNT[k] += 1;
    ) : st == 0x80 ? (
      CNT[k] > 0 ? (
        CNT[k] -= 1;
        CNT[k] == 0 ? midisend(ofs, a, b, c);
      );
    ) : (
      midisend(ofs, a, b, c);
    );
  );

  gfx_ext_retina = 1;
  function update()
  (
    mode = slider1;
    key = slider2;
    scale = slider3;
    ctype = slider4;
    inv = slider5;
    voicing = slider6;
    octv = slider7;
    sdir = slider9;
    vexp = 2 ^ (-slider10 / 50);
    prog = slider11;
  );

  // ---- the display (memory past what the audio uses) -----------------------------------------
  GT = 45000;   // the chord shown (as cd_build's o[])
  GK = 45100;   // per note: 1 while it sounds (any channel)
  GH = 45300;   // per note: 1 while its key is held (any channel)
  GP = 45500;   // per note: 1 in the chord shown
  GS = 45700;   // per semitone from the key: 1 in the scale shown

  function kb_white(pc) ( pc == 0 || pc == 2 || pc == 4 || pc == 5 || pc == 7 || pc == 9 || pc == 11; );

  function kb_scan() local(n, ch)
  (
    n = 0;
    loop(128,
      GK[n] = 0;
      GH[n] = 0;
      ch = 0;
      loop(16, CNT[ch * 128 + n] > 0 ? GK[n] = 1; ACT[ch * 128 + n] ? GH[n] = 1; ch += 1;);
      n += 1;
    );
  );

  // a keyboard from note lo to hi in design units: scale notes tinted, the tonic underlined,
  // sounding notes silver, held keys marked on top, the chord shown dotted
  function kb_draw(x, y, w, h, lo, hi, tonic) local(n, nw, ww, i, xx, pc, bw, bh, in)
  (
    nw = 0;
    n = lo;
    loop(hi - lo + 1, kb_white(n % 12) ? nw += 1; n += 1;);
    ww = w / nw;
    bw = ww * 0.62;
    bh = h * 0.6;
    i = 0;
    n = lo;
    loop(hi - lo + 1,
      pc = n % 12;
      kb_white(pc) ? (
        xx = x + i * ww;
        in = GS[(pc - tonic + 12) % 12];
        GK[n] ? ng_col(NG_ACCENT, 1) : ng_col(in ? 0x55534f : 0x2d2b28, 1);
        gfx_rect(X(xx + 0.5), Y(y), (ww - 1) * ng_s, h * ng_s);
        pc == tonic ? ( ng_col(GK[n] ? NG_BG : NG_MUTED, 1); gfx_rect(X(xx + 2.5), Y(y + h - 4), (ww - 5) * ng_s, 2 * ng_s); );
        GP[n] ? ( ng_col(GK[n] ? NG_BG : NG_ACCENT, 1); gfx_circle(X(xx + ww / 2), Y(y + h - 13), 2.6 * ng_s, 1, 1); );
        GH[n] ? ( ng_col(GK[n] ? NG_BG : NG_TEXT, 1); gfx_rect(X(xx + 2.5), Y(y + 2), (ww - 5) * ng_s, 3 * ng_s); );
        i += 1;
      );
      n += 1;
    );
    i = 0;
    n = lo;
    loop(hi - lo + 1,
      pc = n % 12;
      kb_white(pc) ? i += 1 : (
        xx = x + i * ww - bw / 2;
        in = GS[(pc - tonic + 12) % 12];
        ng_col(NG_CARD, 1);
        gfx_rect(X(xx - 1), Y(y), (bw + 2) * ng_s, (bh + 1) * ng_s);
        GK[n] ? ng_col(NG_ACCENT, 1) : ng_col(in ? 0x3e3c39 : 0x131211, 1);
        gfx_rect(X(xx), Y(y), bw * ng_s, bh * ng_s);
        pc == tonic ? ( ng_col(GK[n] ? NG_BG : NG_MUTED, 1); gfx_rect(X(xx + 1.5), Y(y + bh - 4), (bw - 3) * ng_s, 2 * ng_s); );
        GP[n] ? ( ng_col(GK[n] ? NG_BG : NG_ACCENT, 1); gfx_circle(X(xx + bw / 2), Y(y + bh - 11), 2.2 * ng_s, 1, 1); );
        GH[n] ? ( ng_col(GK[n] ? NG_BG : NG_TEXT, 1); gfx_rect(X(xx + 1.5), Y(y + 2), (bw - 3) * ng_s, 3 * ng_s); );
      );
      n += 1;
    );
  );

  function kb_name(pc) ( pc == 0 ? "C" : pc == 1 ? "C#" : pc == 2 ? "D" : pc == 3 ? "D#" : pc == 4 ? "E" : pc == 5 ? "F" :
                         pc == 6 ? "F#" : pc == 7 ? "G" : pc == 8 ? "G#" : pc == 9 ? "A" : pc == 10 ? "A#" : "B"; );

  function cd_scale_name(s) ( s == 0 ? "MAJOR" : s == 1 ? "MINOR" : s == 2 ? "HARMONIC MINOR" : s == 3 ? "MELODIC MINOR" :
                              s == 4 ? "DORIAN" : s == 5 ? "PHRYGIAN" : s == 6 ? "LYDIAN" : s == 7 ? "MIXOLYDIAN" : "LOCRIAN"; );

  // Roman numeral of degree d: upper case major, lower case minor, o diminished, + augmented
  function cd_roman(dst, d, mi, di, au)
  (
    sprintf(dst, "%s%s",
      mi ? (d == 0 ? "i" : d == 1 ? "ii" : d == 2 ? "iii" : d == 3 ? "iv" : d == 4 ? "v" : d == 5 ? "vi" : "vii")
         : (d == 0 ? "I" : d == 1 ? "II" : d == 2 ? "III" : d == 3 ? "IV" : d == 4 ? "V" : d == 5 ? "VI" : "VII"),
      di ? "o" : au ? "+" : "");
  );

  // the chord symbol of o (cd_build's o[]), e.g. "Am7/G"
  function cd_name(dst, o) local(f5, maj, aug, dim, pre, post, nine, rp, bp)
  (
    o[8] == 0 ? strcpy(dst, "-") : (
      f5 = o[13] == 6;
      ctype == 5 ? strcpy(#cd_suf, f5 ? "(b5)" : "5") :
      ctype == 3 || ctype == 4 ? sprintf(#cd_suf, "%s%s", ctype == 3 ? "sus2" : "sus4", f5 ? "(b5)" : "") : (
        maj = o[12] == 4;
        aug = maj && o[13] == 8;
        dim = !maj && f5;
        ctype == 0 ? strcpy(#cd_suf, aug ? "aug" : dim ? "dim" : maj ? "" : "m") : (
          pre = aug ? (o[14] == 11 ? "+maj" : "+") : dim ? (o[14] == 9 ? "dim" : "m") : maj ? (o[14] == 11 ? "maj" : "") : (o[14] == 11 ? "mMaj" : "m");
          post = dim && o[14] != 9 ? "b5" : "";
          nine = ctype == 2 && o[15] == 2;
          sprintf(#cd_suf, "%s%s%s%s", pre, nine ? "9" : "7", post, ctype == 2 && !nine ? (o[15] == 1 ? "b9" : "#9") : "");
        );
      );
      rp = o[9] - 12 * floor(o[9] / 12);
      bp = o[0] - 12 * floor(o[0] / 12);
      bp != rp ? sprintf(dst, "%s%s/%s", kb_name(rp), #cd_suf, kb_name(bp)) : sprintf(dst, "%s%s", kb_name(rp), #cd_suf);
    );
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 16;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1); ng_hist_add(2); ng_hist_add(3); ng_hist_add(4); ng_hist_add(5); ng_hist_add(6); ng_hist_add(7); ng_hist_add(8); ng_hist_add(9); ng_hist_add(10); ng_hist_add(11);
  ng_hist_init();

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); ng_slider_set(10, 0); ng_slider_set(11, 0); );
    p == 1 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 1); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); ng_slider_set(10, 0); ng_slider_set(11, 0); );
    p == 2 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 2); ng_slider_set(5, 0); ng_slider_set(6, 2); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); ng_slider_set(10, -20); ng_slider_set(11, 0); );
    p == 3 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 1); ng_slider_set(5, 1); ng_slider_set(6, 1); ng_slider_set(7, 0); ng_slider_set(8, 12); ng_slider_set(9, 0); ng_slider_set(10, -30); ng_slider_set(11, 0); );
    p == 4 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 3); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); ng_slider_set(10, 0); ng_slider_set(11, 0); );
    p == 5 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 2); ng_slider_set(7, 0); ng_slider_set(8, 30); ng_slider_set(9, 1); ng_slider_set(10, 20); ng_slider_set(11, 0); );
    p == 6 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 1); ng_slider_set(5, 0); ng_slider_set(6, 2); ng_slider_set(7, 0); ng_slider_set(8, 25); ng_slider_set(9, 2); ng_slider_set(10, 0); ng_slider_set(11, 0); );
    p == 7 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 2); ng_slider_set(5, 0); ng_slider_set(6, 3); ng_slider_set(7, 0); ng_slider_set(8, 90); ng_slider_set(9, 0); ng_slider_set(10, 0); ng_slider_set(11, 0); );
    p == 8 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 5); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, -1); ng_slider_set(8, 0); ng_slider_set(9, 0); ng_slider_set(10, 40); ng_slider_set(11, 0); );
    p == 9 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 3); ng_slider_set(5, 0); ng_slider_set(6, 2); ng_slider_set(7, 1); ng_slider_set(8, 20); ng_slider_set(9, 0); ng_slider_set(10, 0); ng_slider_set(11, 0); );
    p == 10 ? ( ng_slider_set(1, 1); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); ng_slider_set(10, 0); ng_slider_set(11, 0); );
    p == 11 ? ( ng_slider_set(1, 1); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 1); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 15); ng_slider_set(9, 0); ng_slider_set(10, 0); ng_slider_set(11, 1); );
    p == 12 ? ( ng_slider_set(1, 1); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 2); ng_slider_set(5, 0); ng_slider_set(6, 1); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); ng_slider_set(10, 0); ng_slider_set(11, 4); );
    p == 13 ? ( ng_slider_set(1, 1); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 2); ng_slider_set(7, 0); ng_slider_set(8, 120); ng_slider_set(9, 0); ng_slider_set(10, 0); ng_slider_set(11, 5); );
    p == 14 ? ( ng_slider_set(1, 1); ng_slider_set(2, 9); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 3); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); ng_slider_set(10, 30); ng_slider_set(11, 6); );
    p == 15 ? ( ng_slider_set(1, 1); ng_slider_set(2, 9); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 40); ng_slider_set(9, 1); ng_slider_set(10, 0); ng_slider_set(11, 7); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 2) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 2) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, -20) && ng_pre_eq(slider11, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 1) && ng_pre_eq(slider6, 1) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 12) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, -30) && ng_pre_eq(slider11, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 3) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 2) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 30) && ng_pre_eq(slider9, 1) && ng_pre_eq(slider10, 20) && ng_pre_eq(slider11, 0) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 2) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 25) && ng_pre_eq(slider9, 2) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 2) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 3) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 90) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 5) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, -1) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 40) && ng_pre_eq(slider11, 0) ? m = 8;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 3) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 2) && ng_pre_eq(slider7, 1) && ng_pre_eq(slider8, 20) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) ? m = 9;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) ? m = 10;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 15) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 1) ? m = 11;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 2) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 1) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 4) ? m = 12;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 2) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 120) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 5) ? m = 13;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 9) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 3) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 30) && ng_pre_eq(slider11, 6) ? m = 14;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 9) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 40) && ng_pre_eq(slider9, 1) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 7) ? m = 15;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Seventh Chords";
    p == 2 ? s = "Lush Ninths";
    p == 3 ? s = "Neo Soul Drop 2";
    p == 4 ? s = "Wide Pad";
    p == 5 ? s = "Guitar Strum Down";
    p == 6 ? s = "Alternating Strum";
    p == 7 ? s = "Harp Roll";
    p == 8 ? s = "Power Chords";
    p == 9 ? s = "Sus2 Shimmer";
    p == 10 ? s = "Pop Progression";
    p == 11 ? s = "Doo-Wop Ballad";
    p == 12 ? s = "Jazz ii-V-I";
    p == 13 ? s = "Canon Roll";
    p == 14 ? s = "Epic Minor";
    p == 15 ? s = "Spanish Cadence";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@block
  st_samp = floor(slider8 * srate / 1000 + 0.5);
  while (midirecv(m_ofs, m_1, m_2, m_3)) (
    cd_in(bpos + m_ofs, m_1, m_2, m_3);
  );
  b_end = bpos + samplesblock;
  q_i = 0;
  while (q_i < qn && Q[q_i * 5] < b_end) (
    cd_emit(Q[q_i * 5] - bpos, Q[q_i * 5 + 1], Q[q_i * 5 + 2], Q[q_i * 5 + 3]);
    q_i += 1;
  );
  q_i > 0 ? (
    q_j = 0;
    loop((qn - q_i) * 5, Q[q_j] = Q[q_j + q_i * 5]; q_j += 1;);
    qn -= q_i;
  );
  bpos = b_end;

@sample
  // the audio passes through
  spl0 = spl0;
  spl1 = spl1;

@gfx 480 400
  ng_knobs_begin("CHORDS", "MIDI", 480, 140, 2, 0);

  // display: the chord of the last key (before any, the tonic's from C4 as a preview, dimmed),
  // its symbol and degree, the scale's degrees (Chord) or the progression's steps (Progression)
  // with the chord's lit, and a keyboard C2..C7: scale notes tinted, the chord dotted, the notes
  // sounding silver, the held keys marked on top
  kb_scan();
  g_n = last_note >= 0 ? last_note : mode ? 60 : 60 + key;
  cd_build(g_n, GT);
  memset(GP, 0, 128);
  g_i = 0;
  loop(GT[8], GP[GT[g_i]] = 1; g_i += 1;);
  g_s = mode ? PRG[prog * 20 + 2] : scale;
  memset(GS, 0, 12);
  g_i = 0;
  loop(SCL[g_s * 8], GS[SCL[g_s * 8 + 1 + g_i]] = 1; g_i += 1;);

  cd_name(#g_name, GT);
  ng_font(5, 22, 1);
  ng_col(last_note >= 0 ? NG_TEXT : NG_MUTED, 1);
  ng_txt(#g_name, 30, 80, 0, 0.5);
  g_mi = ctype < 3 && GT[12] == 3;
  cd_roman(#g_num, GT[10], g_mi, g_mi && GT[13] == 6, ctype < 3 && GT[12] == 4 && GT[13] == 8);
  sprintf(#g_line, "%s   %s %s%s", GT[8] ? #g_num : "-", kb_name(key), cd_scale_name(g_s), last_note >= 0 ? "" : "   PLAY A KEY");
  ng_font(1, 8, 1);
  ng_col(NG_MUTED, 1);
  ng_txt(#g_line, 30, 103, 0, 1.2);

  // the chips: the 7 degrees, or the steps
  g_c = mode ? PRG[prog * 20] : 7;
  g_hi = -1;
  mode ? (
    g_w = g_n % 12;
    g_w = g_w == 0 ? 0 : g_w == 2 ? 1 : g_w == 4 ? 2 : g_w == 5 ? 3 : g_w == 7 ? 4 : g_w == 9 ? 5 : g_w == 11 ? 6 : -1;
    g_w >= 0 ? g_hi = g_w % g_c;
  ) : (
    GT[8] ? g_hi = GT[10];
  );
  g_x = 456 - g_c * 31 + 3;
  g_i = 0;
  loop(g_c,
    g_d = mode ? PRG[prog * 20 + 1 + 2 * g_i] : g_i;
    g_ss = mode ? PRG[prog * 20 + 2 + 2 * g_i] : scale;
    g_sd = SCL[g_ss * 8 + 1 + g_d];
    g_3 = cd_semi(g_ss, g_d + 2) - g_sd;
    g_5 = cd_semi(g_ss, g_d + 4) - g_sd;
    cd_roman(#g_chip, g_d, g_3 == 3, g_3 == 3 && g_5 == 6, g_3 == 4 && g_5 == 8);
    ng_col(g_i == g_hi ? NG_ACCENT : NG_BG, 1);
    gfx_roundrect(X(g_x), Y(70), 28 * ng_s, 18 * ng_s, 4 * ng_s, 1);
    gfx_rect(X(g_x) + 1, Y(70) + 1, 28 * ng_s - 1, 18 * ng_s - 1);
    ng_col(g_i == g_hi ? NG_ACCENT : NG_BORDER, 1);
    gfx_roundrect(X(g_x), Y(70), 28 * ng_s, 18 * ng_s, 4 * ng_s, 1);
    ng_font(1, 7.5, 1);
    ng_col(g_i == g_hi ? NG_BG : NG_TEXT, 1);
    ng_txt(#g_chip, g_x + 14, 79, 1, 0);
    g_x += 31;
    g_i += 1;
  );
  sprintf(#g_line, "%s  %s  %s", ctype == 0 ? "TRIAD" : ctype == 1 ? "7TH" : ctype == 2 ? "9TH" : ctype == 3 ? "SUS2" : ctype == 4 ? "SUS4" : "POWER",
          inv == 0 ? "ROOT" : inv == 1 ? "1ST INV" : inv == 2 ? "2ND INV" : "3RD INV",
          voicing == 0 ? "CLOSE" : voicing == 1 ? "DROP 2" : voicing == 2 ? "OPEN" : "WIDE");
  slider8 > 0 ? sprintf(#g_l2, "%s  STRUM %d MS %s", #g_line, slider8, sdir == 0 ? "UP" : sdir == 1 ? "DOWN" : "ALT") : strcpy(#g_l2, #g_line);
  ng_font(1, 7.5, 1);
  ng_col(NG_MUTED, 1);
  ng_txt(#g_l2, 456, 101, 2, 1.2);

  kb_draw(24, 116, 432, 68, 36, 96, key);

  ng_row(6);
  ng_select_ctl(1, "MODE", "CHORD|PROG", 0) ? update();
  ng_select_ctl(2, "KEY", "C|C#|D|D#|E|F|F#|G|G#|A|A#|B", 0) ? update();
  ng_select_ctl(3, "SCALE", "MAJOR|MINOR|HARM|MELODIC|DORIAN|PHRYG|LYDIAN|MIXO|LOCRIAN", 0) ? update();
  ng_select_ctl(4, "CHORD", "TRIAD|7TH|9TH|SUS2|SUS4|POWER", 0) ? update();
  ng_select_ctl(5, "INVERSION", "ROOT|1ST|2ND|3RD", 0) ? update();
  ng_select_ctl(6, "VOICING", "CLOSE|DROP 2|OPEN|WIDE", 0) ? update();
  ng_row(5);
  sprintf(#v7, slider7 > 0 ? "+%d" : "%d", slider7);
  ng_knob_ctl(7, "OCTAVE", #v7, -2, 2, 0, 1, 1) ? update();
  sprintf(#v8, "%d ms", slider8);
  ng_knob_ctl(8, "STRUM", #v8, 0, 200, 0, 1, 0) ? update();
  ng_select_ctl(9, "DIRECTION", "UP|DOWN|ALT", 0) ? update();
  sprintf(#v10, slider10 > 0 ? "+%d%%" : "%d%%", slider10);
  ng_knob_ctl(10, "VELOCITY", #v10, -100, 100, 0, 1, 1) ? update();
  ng_select_ctl(11, "PROGRESSION", "POP|DOO-WOP|SAD POP|POP 2|JAZZ|CANON|EPIC|SPANISH|MINOR", 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
