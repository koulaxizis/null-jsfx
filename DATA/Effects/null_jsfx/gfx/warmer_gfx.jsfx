desc:NULL Warmer GFX
author: Christos Koulaxizis
tags: warm warmth tape tube saturation analog low mids soft top mix bus one knob gui
//category: One Slider
//NULL JSFX v4.2 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:40<0,100,1>-Amount

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // NULL Warmer (../warmer.jsfx) with its own interface: same audio code, plus @gfx.
  // One-knob warmth: the lows and low mids (below 600 Hz) go through a gentle, slightly
  // asymmetric tape/tube curve (even harmonics, its DC removed) and rise a little, the top is
  // eased down and a soft low-pass falls from 20 to 9 kHz. At 0 the signal is untouched;
  // the level stays close to the input.
  function sat(x) local(e) ( e = exp(2 * max(-20, min(20, x))); (e - 1) / (e + 1); );
  function dcb(x) local(y) ( y = x - this.x1 + wm_dcr * this.y1; this.x1 = x; this.y1 = y; y; );
  function band(x) ( this.lo += (x - this.lo) * wm_lpc; );
  wm_lpc = 1 - exp(-2 * $pi * min(600, 0.45 * srate) / srate);
  wm_dcr = exp(-2 * $pi * 10 / srate);
  gfx_ext_retina = 1;

  function update()
  (
    wm_a = slider1 / 100;
    wm_d = 1 + wm_a * 2;
    wm_b = 0.15 * wm_a;
    wm_z = sat(wm_b);
    wm_norm = 1 / (wm_d * (1 - wm_z * wm_z));
    wm_lo = 1 + 0.3 * wm_a;
    wm_hi = 1 - 0.2 * wm_a;
    wm_tc = 1 - exp(-2 * $pi * min(20000 - 11000 * wm_a, 0.45 * srate) / srate);
    wm_tm = min(1, wm_a * 2);
    wm_trim = 1 - 0.08 * wm_a;
  );

  // the low band's curve for an input x, as in @sample (DC blocker left out)
  function wm_curve(x) ( x + wm_a * ((sat(wm_d * x + wm_b) - wm_z) * wm_norm - x); );

  // a text at pixel (x, y), vertically centred; align 0 left, 1 centre, 2 right
  function war_lbl(str, x, y, align) local(w, h)
  (
    gfx_measurestr(str, w, h);
    gfx_x = align == 1 ? x - w / 2 : (align == 2 ? x - w : x);
    gfx_y = y - gfx_texth / 2;
    gfx_drawstr(str);
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 12;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1);
  ng_hist_init();
  ng_dice_add(1, 0, 100, 1, 0);

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 40); );
    p == 1 ? ( ng_slider_set(1, 15); );
    p == 2 ? ( ng_slider_set(1, 30); );
    p == 3 ? ( ng_slider_set(1, 35); );
    p == 4 ? ( ng_slider_set(1, 55); );
    p == 5 ? ( ng_slider_set(1, 50); );
    p == 6 ? ( ng_slider_set(1, 20); );
    p == 7 ? ( ng_slider_set(1, 85); );
    p == 8 ? ( ng_slider_set(1, 70); );
    p == 9 ? ( ng_slider_set(1, 45); );
    p == 10 ? ( ng_slider_set(1, 100); );
    p == 11 ? ( ng_slider_set(1, 60); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 40) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 15) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 30) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 35) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 55) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 50) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 20) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 85) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 70) ? m = 8;
    m < 0 && ng_pre_eq(slider1, 45) ? m = 9;
    m < 0 && ng_pre_eq(slider1, 100) ? m = 10;
    m < 0 && ng_pre_eq(slider1, 60) ? m = 11;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Touch of Warmth";
    p == 2 ? s = "Vocal Warmth";
    p == 3 ? s = "Acoustic Body";
    p == 4 ? s = "Bass Round";
    p == 5 ? s = "Drum Bus Tape";
    p == 6 ? s = "Master Glow";
    p == 7 ? s = "Lo-Fi Blanket";
    p == 8 ? s = "Vintage Tape";
    p == 9 ? s = "Soft Piano";
    p == 10 ? s = "Full Warmth";
    p == 11 ? s = "Synth Pad Velvet";
    s;
  );

  // the hint line under the controls: a short help text per slider (from tools/site_content.json)
  function ng_hint_text(i) local(s)
  (
    s = "";
    i == 1 ? s = "Warmth in one move: 0 leaves the signal untouched";
    s;
  );

  function ng_presets() local(i)
  (
    ng_hint_i > 0 && !ng_pre_open ? ng_hint(ng_hint_text(ng_hint_i));
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  wm_l = bl.band(spl0);
  wm_r = br.band(spl1);
  wm_sl = wm_l + wm_a * (dl.dcb((sat(wm_d * wm_l + wm_b) - wm_z) * wm_norm) - wm_l);
  wm_sr = wm_r + wm_a * (dr.dcb((sat(wm_d * wm_r + wm_b) - wm_z) * wm_norm) - wm_r);
  wm_yl = wm_sl * wm_lo + (spl0 - wm_l) * wm_hi;
  wm_yr = wm_sr * wm_lo + (spl1 - wm_r) * wm_hi;
  wm_tl += (wm_yl - wm_tl) * wm_tc;
  wm_tr += (wm_yr - wm_tr) * wm_tc;
  spl0 = (wm_yl + (wm_tl - wm_yl) * wm_tm) * wm_trim;
  spl1 = (wm_yr + (wm_tr - wm_yr) * wm_tm) * wm_trim;

@gfx 360 240
  ng_one_slider_begin("WARMER");

  // display: the curve of the lows and low mids, input -1 to 1 across, output up (the
  // straight line is the untouched signal)
  ng_plot(46, 64, 284, 78);
  ng_grid(4, 4, 0);
  ng_font(4, 8, 0);
  ng_col(NG_MUTED, 1);
  war_lbl("1", ng_px - 6 * ng_s, floor(ng_py) + 0.5, 2);
  war_lbl("0", ng_px - 6 * ng_s, floor(ng_py + ng_ph / 2) + 0.5, 2);
  war_lbl("-1", ng_px - 6 * ng_s, floor(ng_py + ng_ph) + 0.5, 2);
  war_lbl("-0.5", ng_px + ng_pw / 4, ng_py + ng_ph + 11 * ng_s, 1);
  war_lbl("IN", ng_px + ng_pw / 2, ng_py + ng_ph + 11 * ng_s, 1);
  war_lbl("0.5", ng_px + ng_pw * 3 / 4, ng_py + ng_ph + 11 * ng_s, 1);
  ng_col(NG_MUTED, 0.6);
  ng_line_start(ng_px, ng_py + ng_ph);
  ng_line_to(ng_px + ng_pw, ng_py);
  ng_col(NG_ACCENT, 1);
  wm_i = 0;
  loop(floor(ng_pw) + 1,
    wm_y = ng_lin_y(wm_curve(2 * wm_i / ng_pw - 1), -1, 1);
    wm_i == 0 ? ng_line_start(ng_px, wm_y) : ng_line_to(ng_px + wm_i, wm_y);
    wm_i += 1;
  );

  // slider card
  slider1 == 0 ? sprintf(#cap, "CLEAN") : sprintf(#cap, "LOWS %+.1f dB  TOP %d kHz", 20 * log10(wm_lo), floor((20000 - 11000 * wm_a) / 1000 + 0.5));
  sprintf(#val, "%d", floor(slider1 + 0.5));
  ng_set_slider(ng_one_slider_control("AMOUNT", #cap, #val, "CLEAN", "WARM", slider1, 0, 100, 40, 0), 1) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
