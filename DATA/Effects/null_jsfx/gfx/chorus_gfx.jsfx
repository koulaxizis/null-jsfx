desc:NULL Chorus GFX
author: Christos Koulaxizis
tags: chorus modulation thickening detune lfo stereo width ensemble dimension tempo sync gui
//category: Essentials
//NULL JSFX v2.6 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:5<0.1,20,0.1>-Rate (Hz)
slider2:3<0,10,0.1>-Depth (ms)
slider3:50<0,100,1>-Mix (%)
slider4:1<1,4,1>-Voices
slider5:0<0,100,1>-Stereo Spread (%)
slider6:0<0,90,1>-Feedback (%)
slider7:0<0,11,1{Off,1/1,1/2,1/4,1/8,1/16,2/1,4/1,1/4T,1/8T,1/4D,1/8D}>-Tempo Sync
slider8:20000<1000,20000,1:log>-High Cut (Hz)
slider9:0<0,1,1{Classic,Dimension}>-Mode

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // NULL Chorus (../chorus.jsfx) with its own interface: same audio code, plus @gfx.
  // Classic: Voices taps on one delay line per channel, their sine LFOs spread evenly in
  // phase; Stereo Spread shifts the right channel's LFOs by up to half the voice spacing.
  // Dimension: two taps (left and right line) swept in opposite phase by a triangle, so the
  // pitch shifts cancel between the sides; the wet is spread as mid/side (Stereo Spread
  // widens it from half to full), so L + R stays the plain sum of both taps (mono-safe).
  // Feedback sends the wet back into the lines; High Cut (off at 20 kHz) is a one-pole
  // low-pass on the wet. Tempo Sync sets one LFO cycle to a note at the host tempo, locked
  // to beat_position while the transport plays. The defaults are the original chorus.
  buf_size = ceil(srate * 0.1);
  delay_l = 0;
  delay_r = delay_l + buf_size;
  memset(delay_l, 0, 2 * buf_size);
  freembuf(delay_r + buf_size);
  wpos = 0;
  phase = 0;
  hc_l = hc_r = 0;

  // the delay line buf read lfo (-1..1) along the sweep, linearly interpolated
  function ch_tap(buf, lfo) local(rp, ri, rf, a, b)
  (
    rp = wpos - (base_delay + lfo * mod_amount) * srate / 1000;
    rp = rp < 0 ? rp + buf_size : rp;
    ri = floor(rp);
    rf = rp - ri;
    a = buf[ri];
    b = buf[ri >= buf_size - 1 ? 0 : ri + 1];
    a + (b - a) * rf;
  );

  // the cycle in beats of Tempo Sync option s (1..11)
  function ch_cycle(s)
  (
    s == 1 ? 4 : s == 2 ? 2 : s == 3 ? 1 : s == 4 ? 0.5 : s == 5 ? 0.25 : s == 6 ? 8 : s == 7 ? 16 :
    s == 8 ? 2 / 3 : s == 9 ? 1 / 3 : s == 10 ? 1.5 : 0.75;
  );
  gfx_ext_retina = 1;

  function update()
  (
    rate = slider1;
    depth = slider2;
    mix_amt = slider3 / 100;
    phase_inc = 6.28318530717958 * rate / srate;
    nv = max(1, min(4, floor(slider4 + 0.5)));
    v_off = 6.28318530717958 / nv;
    sp_off = slider5 / 100 * $pi / nv;
    fb_amt = slider6 / 100;
    sync = floor(slider7 + 0.5);
    cyc = ch_cycle(sync);
    hc_on = slider8 < 20000;
    hc_a = 1 - exp(-2 * $pi * slider8 / srate);
    dim = slider9 >= 0.5;
  );

  // ---- modulation view: an info line over a plot of two LFO cycles ----
  // the delay time (0 to 16 ms) at u (0..1 = two cycles), as a plot y: a sine shifted by
  // md_off (radians), or with md_tri a triangle (-1 at phase 0) times md_sgn
  function md_val(u) local(p, l)
  (
    md_tri ? (
      p = 2 * u - floor(2 * u);
      l = md_sgn * (1 - 2 * abs(p * 2 - 1));
    ) : (
      l = sin(4 * $pi * u + md_off);
    );
    ng_lin_y(5 + slider2 * 0.5 + l * slider2 * 0.5, 0, 16);
  );

  function md_view(left, right)
  (
    ng_plot(ng_vx + 26, ng_vy + 14, ng_vw - 30, ng_vh - 30);
    ng_grid(4, 4, 0);
    ng_font(4, 8, 0);
    ng_col(NG_MUTED, 1);
    ng_ptxt(left, ng_px, Y(ng_vy + 4), 0);
    ng_ptxt(right, ng_px + ng_pw, Y(ng_vy + 4), 2);
  );

  // labels at the top, middle and bottom of the plot
  function md_ylabels(top, mid, bot)
  (
    ng_col(NG_MUTED, 1);
    ng_ptxt(top, ng_px - 6 * ng_s, ng_py, 2);
    ng_ptxt(mid, ng_px - 6 * ng_s, ng_py + ng_ph / 2, 2);
    ng_ptxt(bot, ng_px - 6 * ng_s, ng_py + ng_ph, 2);
  );

  // times under the plot at 1/4, 1/2 and 3/4 of its width for a cycle of period seconds
  function md_xlabels(period) local(i, t)
  (
    ng_col(NG_MUTED, 1);
    i = 1;
    loop(3,
      t = period * i / 2;
      t < 1 ? sprintf(#md_t, "%d ms", floor(t * 1000 + 0.5)) : sprintf(#md_t, "%.2f s", t);
      ng_ptxt(#md_t, ng_px + ng_pw * i / 4, ng_py + ng_ph + 10 * ng_s, 1);
      i += 1;
    );
  );

  // md_val across the plot in colour rgb at alpha a, shaded down to the bottom when fill = 1
  function md_curve(rgb, a, fill) local(i)
  (
    fill ? (
      ng_col(NG_ACCENT, 0.10);
      i = 0;
      loop(floor(ng_pw) + 1, gfx_line(ng_px + i, ng_py + ng_ph, ng_px + i, md_val(i / ng_pw), 0); i += 1;);
    );
    ng_col(rgb, a);
    i = 0;
    loop(floor(ng_pw) + 1,
      i == 0 ? ng_line_start(ng_px, md_val(0)) : ng_line_to(ng_px + i, md_val(i / ng_pw));
      i += 1;
    );
  );

  // dashed playhead at u (0..1) of the plot width
  function md_playhead(u) local(x, y)
  (
    x = floor(ng_px + max(0, min(1, u)) * ng_pw) + 0.5;
    ng_col(NG_ACCENT, 0.5);
    y = ng_py;
    while (
      gfx_line(x, y, x, min(y + 3 * ng_s, ng_py + ng_ph), 0);
      y += 6 * ng_s;
      y < ng_py + ng_ph;
    );
  );

  // the name of Tempo Sync option s
  function md_note(s)
  (
    s == 1 ? "1/1" : s == 2 ? "1/2" : s == 3 ? "1/4" : s == 4 ? "1/8" : s == 5 ? "1/16" : s == 6 ? "2/1" :
    s == 7 ? "4/1" : s == 8 ? "1/4T" : s == 9 ? "1/8T" : s == 10 ? "1/4D" : "1/8D";
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 15;

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 5); ng_slider_set(2, 3); ng_slider_set(3, 50); ng_slider_set(4, 1); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 20000); ng_slider_set(9, 0); );
    p == 1 ? ( ng_slider_set(1, 0.8); ng_slider_set(2, 3); ng_slider_set(3, 40); ng_slider_set(4, 1); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 20000); ng_slider_set(9, 0); );
    p == 2 ? ( ng_slider_set(1, 0.3); ng_slider_set(2, 6); ng_slider_set(3, 50); ng_slider_set(4, 1); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 20000); ng_slider_set(9, 0); );
    p == 3 ? ( ng_slider_set(1, 0.5); ng_slider_set(2, 1.5); ng_slider_set(3, 30); ng_slider_set(4, 1); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 20000); ng_slider_set(9, 0); );
    p == 4 ? ( ng_slider_set(1, 1.2); ng_slider_set(2, 2.5); ng_slider_set(3, 30); ng_slider_set(4, 1); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 20000); ng_slider_set(9, 0); );
    p == 5 ? ( ng_slider_set(1, 0.7); ng_slider_set(2, 2); ng_slider_set(3, 35); ng_slider_set(4, 1); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 20000); ng_slider_set(9, 0); );
    p == 6 ? ( ng_slider_set(1, 1.5); ng_slider_set(2, 4); ng_slider_set(3, 45); ng_slider_set(4, 1); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 20000); ng_slider_set(9, 0); );
    p == 7 ? ( ng_slider_set(1, 6); ng_slider_set(2, 2); ng_slider_set(3, 100); ng_slider_set(4, 1); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 20000); ng_slider_set(9, 0); );
    p == 8 ? ( ng_slider_set(1, 0.5); ng_slider_set(2, 2); ng_slider_set(3, 50); ng_slider_set(4, 1); ng_slider_set(5, 60); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 12000); ng_slider_set(9, 1); );
    p == 9 ? ( ng_slider_set(1, 0.3); ng_slider_set(2, 1.2); ng_slider_set(3, 35); ng_slider_set(4, 1); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 20000); ng_slider_set(9, 1); );
    p == 10 ? ( ng_slider_set(1, 0.6); ng_slider_set(2, 5); ng_slider_set(3, 50); ng_slider_set(4, 4); ng_slider_set(5, 100); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 20000); ng_slider_set(9, 0); );
    p == 11 ? ( ng_slider_set(1, 0.8); ng_slider_set(2, 3.5); ng_slider_set(3, 45); ng_slider_set(4, 2); ng_slider_set(5, 100); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 20000); ng_slider_set(9, 0); );
    p == 12 ? ( ng_slider_set(1, 5); ng_slider_set(2, 2); ng_slider_set(3, 40); ng_slider_set(4, 2); ng_slider_set(5, 80); ng_slider_set(6, 20); ng_slider_set(7, 4); ng_slider_set(8, 20000); ng_slider_set(9, 0); );
    p == 13 ? ( ng_slider_set(1, 0.4); ng_slider_set(2, 6); ng_slider_set(3, 55); ng_slider_set(4, 3); ng_slider_set(5, 70); ng_slider_set(6, 15); ng_slider_set(7, 0); ng_slider_set(8, 3500); ng_slider_set(9, 0); );
    p == 14 ? ( ng_slider_set(1, 0.3); ng_slider_set(2, 2.5); ng_slider_set(3, 45); ng_slider_set(4, 1); ng_slider_set(5, 50); ng_slider_set(6, 60); ng_slider_set(7, 0); ng_slider_set(8, 20000); ng_slider_set(9, 0); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 5) && ng_pre_eq(slider2, 3) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 20000) && ng_pre_eq(slider9, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 0.8) && ng_pre_eq(slider2, 3) && ng_pre_eq(slider3, 40) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 20000) && ng_pre_eq(slider9, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 0.3) && ng_pre_eq(slider2, 6) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 20000) && ng_pre_eq(slider9, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 0.5) && ng_pre_eq(slider2, 1.5) && ng_pre_eq(slider3, 30) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 20000) && ng_pre_eq(slider9, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 1.2) && ng_pre_eq(slider2, 2.5) && ng_pre_eq(slider3, 30) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 20000) && ng_pre_eq(slider9, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 0.7) && ng_pre_eq(slider2, 2) && ng_pre_eq(slider3, 35) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 20000) && ng_pre_eq(slider9, 0) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 1.5) && ng_pre_eq(slider2, 4) && ng_pre_eq(slider3, 45) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 20000) && ng_pre_eq(slider9, 0) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 6) && ng_pre_eq(slider2, 2) && ng_pre_eq(slider3, 100) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 20000) && ng_pre_eq(slider9, 0) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 0.5) && ng_pre_eq(slider2, 2) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 60) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 12000) && ng_pre_eq(slider9, 1) ? m = 8;
    m < 0 && ng_pre_eq(slider1, 0.3) && ng_pre_eq(slider2, 1.2) && ng_pre_eq(slider3, 35) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 20000) && ng_pre_eq(slider9, 1) ? m = 9;
    m < 0 && ng_pre_eq(slider1, 0.6) && ng_pre_eq(slider2, 5) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 4) && ng_pre_eq(slider5, 100) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 20000) && ng_pre_eq(slider9, 0) ? m = 10;
    m < 0 && ng_pre_eq(slider1, 0.8) && ng_pre_eq(slider2, 3.5) && ng_pre_eq(slider3, 45) && ng_pre_eq(slider4, 2) && ng_pre_eq(slider5, 100) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 20000) && ng_pre_eq(slider9, 0) ? m = 11;
    m < 0 && ng_pre_eq(slider1, 5) && ng_pre_eq(slider2, 2) && ng_pre_eq(slider3, 40) && ng_pre_eq(slider4, 2) && ng_pre_eq(slider5, 80) && ng_pre_eq(slider6, 20) && ng_pre_eq(slider7, 4) && ng_pre_eq(slider8, 20000) && ng_pre_eq(slider9, 0) ? m = 12;
    m < 0 && ng_pre_eq(slider1, 0.4) && ng_pre_eq(slider2, 6) && ng_pre_eq(slider3, 55) && ng_pre_eq(slider4, 3) && ng_pre_eq(slider5, 70) && ng_pre_eq(slider6, 15) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 3500) && ng_pre_eq(slider9, 0) ? m = 13;
    m < 0 && ng_pre_eq(slider1, 0.3) && ng_pre_eq(slider2, 2.5) && ng_pre_eq(slider3, 45) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 50) && ng_pre_eq(slider6, 60) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 20000) && ng_pre_eq(slider9, 0) ? m = 14;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Clean Guitar Shimmer";
    p == 2 ? s = "Lush Pad";
    p == 3 ? s = "Subtle Synth Detune";
    p == 4 ? s = "Backing Vocal Double";
    p == 5 ? s = "Bass Thickener";
    p == 6 ? s = "Keys Wide Wash";
    p == 7 ? s = "Vibrato Warble";
    p == 8 ? s = "Juno Dimension";
    p == 9 ? s = "Subtle Dimension";
    p == 10 ? s = "Lush 4-Voice";
    p == 11 ? s = "Wide Stereo Chorus";
    p == 12 ? s = "Synced Shimmer";
    p == 13 ? s = "Dark Ensemble";
    p == 14 ? s = "Resonant Chorus";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@block
  sync > 0 ? (
    bpm = tempo > 0 ? tempo : 120;
    phase_inc = 6.28318530717958 * bpm / 60 / cyc / srate;
    // lock to the host grid while playing
    play_state & 1 ? phase = 6.28318530717958 * (beat_position / cyc - floor(beat_position / cyc));
  );

@sample
  phase >= 6.28318530717958 ? (phase = phase - 6.28318530717958;);
  ch_ph = phase;
  lfo = sin(phase);
  phase = phase + phase_inc;
  
  // The delay sweeps between 5 ms and 5 ms + Depth, so the read position is
  // always at least 5 ms behind the write position (never negative or ahead).
  mod_amount = depth * 0.5;
  base_delay = 5 + mod_amount;
  
  dim ? (
    // triangle, -1 at phase 0, +1 at half a cycle; the right tap in opposite phase
    tri = 1 - 2 * abs(ch_ph / 6.28318530717958 * 2 - 1);
    d_l = ch_tap(delay_l, tri);
    d_r = ch_tap(delay_r, -tri);
  ) : (
    d_l = ch_tap(delay_l, lfo);
    d_r = sp_off > 0 ? ch_tap(delay_r, sin(ch_ph + sp_off)) : ch_tap(delay_r, lfo);
    nv > 1 ? (
      ch_v = 1;
      loop(nv - 1,
        ch_p = ch_ph + ch_v * v_off;
        d_l += ch_tap(delay_l, sin(ch_p));
        d_r += ch_tap(delay_r, sin(ch_p + sp_off));
        ch_v += 1;
      );
      d_l /= nv;
      d_r /= nv;
    );
  );
  
  hc_on ? (
    hc_l += hc_a * (d_l - hc_l); d_l = hc_l;
    hc_r += hc_a * (d_r - hc_r); d_r = hc_r;
  );
  
  fb_amt > 0 ? (
    delay_l[wpos] = spl0 + d_l * fb_amt;
    delay_r[wpos] = spl1 + d_r * fb_amt;
  ) : (
    delay_l[wpos] = spl0;
    delay_r[wpos] = spl1;
  );
  wpos = wpos + 1;
  wpos = wpos >= buf_size ? 0 : wpos;
  
  dim ? (
    // mid/side spread of the two taps: half width at 0%, the taps hard left/right at 100%
    ch_m = (d_l + d_r) * 0.5;
    ch_s = (d_l - d_r) * 0.5 * (0.5 + slider5 / 200);
    d_l = ch_m + ch_s;
    d_r = ch_m - ch_s;
  );
  
  out_l = spl0 * (1 - mix_amt) + d_l * mix_amt;
  out_r = spl1 * (1 - mix_amt) + d_r * mix_amt;
  
  spl0 = out_l;
  spl1 = out_r;

@gfx 480 380
  ng_knobs_begin("CHORUS", "ESSENTIALS", 480, 120, 2, 0);

  // display: the delay time of every voice over two LFO cycles (0 to 16 ms), the LFO
  // position dashed; Classic: the first voice shaded, the others thinner, the right channel's
  // first voice grey when spread; Dimension: the two opposite triangles
  md_bpm = tempo > 0 ? tempo : 120;
  md_sync = floor(slider7 + 0.5);
  md_period = md_sync > 0 ? ch_cycle(md_sync) * 60 / md_bpm : 1 / slider1;
  slider9 >= 0.5 ? strcpy(#md_a, "DIMENSION  ") : slider4 > 1 ? sprintf(#md_a, "%d VOICES  ", slider4) : strcpy(#md_a, "");
  md_sync > 0 ? sprintf(#md_b, "%s  ", md_note(md_sync)) : strcpy(#md_b, "");
  sprintf(#md_r, "%s%s%.1f TO %.1f ms", #md_a, #md_b, 5, 5 + slider2);
  md_view("DELAY (ms)", #md_r);
  md_ylabels("16", "8", "0");
  md_xlabels(md_period);
  slider9 >= 0.5 ? (
    md_tri = 1;
    md_sgn = -1; md_curve(NG_ACCENT, 0.45, 0);
    md_sgn = 1; md_curve(NG_ACCENT, 1, 1);
  ) : (
    md_tri = 0;
    md_nv = max(1, min(4, floor(slider4 + 0.5)));
    slider5 > 0 ? ( md_off = slider5 / 100 * $pi / md_nv; md_curve(NG_MUTED, 1, 0); );
    md_v = 1;
    loop(md_nv - 1, md_off = md_v * 2 * $pi / md_nv; md_curve(NG_ACCENT, 0.45, 0); md_v += 1;);
    md_off = 0;
    md_curve(NG_ACCENT, 1, 1);
  );
  md_playhead(phase / 6.28318530717958 / 2);

  ng_row(6);
  md_sync > 0 ? strcpy(#v1, md_note(md_sync)) : sprintf(#v1, "%.1f Hz", slider1);
  ng_knob_ctl(1, "RATE", #v1, 0.1, 20, 5, 0.1, 0) ? update();
  sprintf(#v2, "%.1f ms", slider2);
  ng_knob_ctl(2, "DEPTH", #v2, 0, 10, 3, 0.1, 0) ? update();
  sprintf(#v3, "%d%%", slider3);
  ng_knob_ctl(3, "MIX", #v3, 0, 100, 50, 1, 0) ? update();
  sprintf(#v4, "%d", slider4);
  ng_knob_ctl(4, "VOICES", #v4, 1, 4, 1, 1, 0) ? update();
  sprintf(#v5, "%d%%", slider5);
  ng_knob_ctl(5, "SPREAD", #v5, 0, 100, 0, 1, 0) ? update();
  sprintf(#v6, "%d%%", slider6);
  ng_knob_ctl(6, "FEEDBACK", #v6, 0, 90, 0, 1, 0) ? update();
  ng_row(3);
  ng_select_ctl(7, "SYNC", "OFF|1/1|1/2|1/4|1/8|1/16|2/1|4/1|1/4T|1/8T|1/4D|1/8D", 0) ? update();
  slider8 >= 20000 ? strcpy(#v8, "OFF") : slider8 >= 1000 ? sprintf(#v8, "%.1f kHz", slider8 / 1000) : sprintf(#v8, "%d Hz", slider8);
  ng_knob_ctl_log(8, "HIGH CUT", #v8, 1000, 20000, 20000, 1) ? update();
  ng_select_ctl(9, "MODE", "CLASSIC|DIM", 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
