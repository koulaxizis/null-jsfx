desc:NULL Limiter GFX
author: Christos Koulaxizis
tags: limiter ceiling clipper brickwall peak protection mastering gui
//category: Essentials
//NULL JSFX v2.7 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:0<0,2,1{Limiter,Clipper,Brickwall}>-Mode
slider2:0<-30,0,0.1>-Threshold (dB)
slider3:-0.1<-6,-0.1,0.1>-Ceiling (dB)
slider4:200<0,1000,1>-Release (ms)
slider5:2<0,10,0.1>-Lookahead (ms)
slider6:0<0,1,1{Off,On}>-True Peak
slider7:0<0,1,1{Output,Delta}>-Listen

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // NULL Limiter (../limiter.jsfx) with its own interface: same audio code, plus @gfx.
  // Limiter:   look-ahead limiter; the gain starts falling before a peak arrives.
  // Clipper:   soft clipper, no delay.
  // Brickwall: like Limiter but the gain drops instantly, so nothing passes the ceiling.
  // Threshold sets how hard the signal is pushed: the level at Threshold comes out at Ceiling.
  // True Peak (appended in 2.7, Limiter and Brickwall) feeds the detector the true peak instead
  // of the sample peak: the BS.1770-4 Annex 2 interpolator (4x, as loudness_meter.jsfx) finds
  // the peaks between the samples. It sees the signal 6 samples late, so the audio waits 6
  // samples more (pdc_delay = Lookahead + 6). Listen Delta plays what is taken away: the driven
  // input minus the output.
  max_look = ceil(srate * 0.011) + 2 + 6;
  buf_l = 0;
  buf_r = buf_l + max_look;
  memset(buf_l, 0, 2 * max_look);
  freembuf(buf_r + max_look);
  wpos = 0;
  hold_val = 0;
  hold_cnt = 0;
  gain = 1;
  pdc_bot_ch = 0;
  pdc_top_ch = 2;
  // True Peak: the interpolator (4 phases x 12 taps) and the last 12 inputs per channel,
  // mirrored 12 slots on so the taps read straight
  tp_c = buf_r + max_look;
  tp_xl = tp_c + 48;
  tp_xr = tp_xl + 24;
  memset(tp_xl, 0, 48);
  freembuf(tp_xr + 24);
  tp_i = 0;
  loop(48,
    tp_c[tp_i] =
      tp_i ==  0 ?  0.0017089843750 : tp_i ==  1 ?  0.0109863281250 : tp_i ==  2 ? -0.0196533203125 :
      tp_i ==  3 ?  0.0332031250000 : tp_i ==  4 ? -0.0594482421875 : tp_i ==  5 ?  0.1373291015625 :
      tp_i ==  6 ?  0.9721679687500 : tp_i ==  7 ? -0.1022949218750 : tp_i ==  8 ?  0.0476074218750 :
      tp_i ==  9 ? -0.0266113281250 : tp_i == 10 ?  0.0148925781250 : tp_i == 11 ? -0.0083007812500 :
      tp_i == 12 ? -0.0291748046875 : tp_i == 13 ?  0.0292968750000 : tp_i == 14 ? -0.0517578125000 :
      tp_i == 15 ?  0.0891113281250 : tp_i == 16 ? -0.1665039062500 : tp_i == 17 ?  0.4650878906250 :
      tp_i == 18 ?  0.7797851562500 : tp_i == 19 ? -0.2003173828125 : tp_i == 20 ?  0.1015625000000 :
      tp_i == 21 ? -0.0582275390625 : tp_i == 22 ?  0.0330810546875 : tp_i == 23 ? -0.0189208984375 :
      tp_c[47 - tp_i];   // phases 2 and 3 are phases 1 and 0 reversed
    tp_i += 1;
  );
  tp_w = 0;

  // the true peak of the stereo pair, 6 samples late: the larger of the sample 6 back and the
  // four interpolated values around it
  function tpeak(xl, xr) local(pk, ph, al, ar, j)
  (
    tp_w -= 1;
    tp_w < 0 ? tp_w = 11;
    tp_xl[tp_w] = tp_xl[tp_w + 12] = xl;
    tp_xr[tp_w] = tp_xr[tp_w + 12] = xr;
    pk = max(abs(tp_xl[tp_w + 6]), abs(tp_xr[tp_w + 6]));
    ph = 0;
    loop(4,
      al = ar = 0;
      j = 0;
      loop(12,
        al += tp_c[ph + j] * tp_xl[tp_w + j];
        ar += tp_c[ph + j] * tp_xr[tp_w + j];
        j += 1;
      );
      pk = max(pk, max(abs(al), abs(ar)));
      ph += 12;
    );
    pk;
  );
  gfx_ext_retina = 1;

  // interface only: a 1.8 s history of the output level and the gain, one entry per
  // 7 ms (260 entries, one per display pixel) in memory from 4000000, and peak meters
  lm_buf = 4000000; lm_len = 260; lm_w = 0;
  lm_chunk = max(1, floor(srate * 0.007));
  lm_n = 0; lm_hl = 0; lm_hgh = 0; lm_hgl = 1000;
  lm_i = 0;
  loop(lm_len, lm_buf[lm_i * 2] = 0; lm_buf[lm_i * 2 + 1] = 1; lm_i += 1;);
  lm_rel = exp(-1 / (0.3 * srate));
  lm_in = lm_out = 0;

  function update()
  (
    mode = slider1;
    ceiling = 10 ^ (slider3 / 20);
    drive = 10 ^ ((slider3 - slider2) / 20);
    look = mode == 1 ? 0 : floor(slider5 * srate / 1000 + 0.5);
    tpk = mode != 1 && slider6;
    delta = slider7;
    pdc_delay = look + (tpk ? 6 : 0);
    rel = exp(-1 / max(1, slider4 * srate / 1000));
    att = mode == 2 || look < 1 ? 1 : 1 - exp(-5 / look);
  );

  // history: output level as dim bars (-48..0 dB), the gain as the line (-24..0 dB)
  function lm_history() local(i, k, xx, yy, h)
  (
    ng_plot(56, 68, 260, 88);
    ng_grid(8, 4, 0);
    ng_font(4, 8, 0);
    ng_col(NG_MUTED, 1);
    i = 0;
    loop(5,
      0 - 6 * i > 0 ? sprintf(#lm_l, "+%d", 0 - 6 * i) : sprintf(#lm_l, "%d", 0 - 6 * i);
      ng_ptxt(#lm_l, ng_px - 6 * ng_s, ng_py + ng_ph * i / 4, 2);
      i += 1;
    );
    ng_col(NG_ACCENT, 0.15);
    i = 0;
    loop(lm_len,
      k = (lm_w + i) % lm_len;
      h = ng_ph * ng_db_norm(ng_to_db(lm_buf[k * 2]), -48);
      h > 0 ? gfx_rect(ng_px + i * ng_s, ng_py + ng_ph - h, ng_s, h);
      i += 1;
    );
    ng_col(NG_ACCENT, 1);
    i = 0;
    loop(lm_len,
      k = (lm_w + i) % lm_len;
      xx = ng_px + (i + 0.5) * ng_s;
      yy = ng_lin_y(ng_to_db(lm_buf[k * 2 + 1]), -24, 0);
      i == 0 ? ng_line_start(xx, yy) : ng_line_to(xx, yy);
      i += 1;
    );
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 9;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1); ng_hist_add(2); ng_hist_add(3); ng_hist_add(4); ng_hist_add(5); ng_hist_add(6); ng_hist_add(7);
  ng_hist_init();

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, -0.1); ng_slider_set(4, 200); ng_slider_set(5, 2); ng_slider_set(6, 0); ng_slider_set(7, 0); );
    p == 1 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, -1); ng_slider_set(4, 200); ng_slider_set(5, 2); ng_slider_set(6, 0); ng_slider_set(7, 0); );
    p == 2 ? ( ng_slider_set(1, 0); ng_slider_set(2, -2); ng_slider_set(3, -0.3); ng_slider_set(4, 300); ng_slider_set(5, 3); ng_slider_set(6, 0); ng_slider_set(7, 0); );
    p == 3 ? ( ng_slider_set(1, 0); ng_slider_set(2, -6); ng_slider_set(3, -1); ng_slider_set(4, 150); ng_slider_set(5, 5); ng_slider_set(6, 0); ng_slider_set(7, 0); );
    p == 4 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, -3); ng_slider_set(4, 60); ng_slider_set(5, 1); ng_slider_set(6, 0); ng_slider_set(7, 0); );
    p == 5 ? ( ng_slider_set(1, 1); ng_slider_set(2, -3); ng_slider_set(3, -0.3); ng_slider_set(4, 200); ng_slider_set(5, 2); ng_slider_set(6, 0); ng_slider_set(7, 0); );
    p == 6 ? ( ng_slider_set(1, 1); ng_slider_set(2, -5); ng_slider_set(3, -1); ng_slider_set(4, 200); ng_slider_set(5, 2); ng_slider_set(6, 0); ng_slider_set(7, 0); );
    p == 7 ? ( ng_slider_set(1, 2); ng_slider_set(2, -3); ng_slider_set(3, -1); ng_slider_set(4, 250); ng_slider_set(5, 5); ng_slider_set(6, 0); ng_slider_set(7, 0); );
    p == 8 ? ( ng_slider_set(1, 2); ng_slider_set(2, -4); ng_slider_set(3, -2); ng_slider_set(4, 400); ng_slider_set(5, 5); ng_slider_set(6, 0); ng_slider_set(7, 0); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, -0.1) && ng_pre_eq(slider4, 200) && ng_pre_eq(slider5, 2) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, -1) && ng_pre_eq(slider4, 200) && ng_pre_eq(slider5, 2) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, -2) && ng_pre_eq(slider3, -0.3) && ng_pre_eq(slider4, 300) && ng_pre_eq(slider5, 3) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, -6) && ng_pre_eq(slider3, -1) && ng_pre_eq(slider4, 150) && ng_pre_eq(slider5, 5) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, -3) && ng_pre_eq(slider4, 60) && ng_pre_eq(slider5, 1) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, -3) && ng_pre_eq(slider3, -0.3) && ng_pre_eq(slider4, 200) && ng_pre_eq(slider5, 2) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, -5) && ng_pre_eq(slider3, -1) && ng_pre_eq(slider4, 200) && ng_pre_eq(slider5, 2) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, -3) && ng_pre_eq(slider3, -1) && ng_pre_eq(slider4, 250) && ng_pre_eq(slider5, 5) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, -4) && ng_pre_eq(slider3, -2) && ng_pre_eq(slider4, 400) && ng_pre_eq(slider5, 5) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) ? m = 8;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Master Safety";
    p == 2 ? s = "Gentle Mix Bus";
    p == 3 ? s = "Mastering Loud";
    p == 4 ? s = "Track Peak Catcher";
    p == 5 ? s = "Drum Bus Clipper";
    p == 6 ? s = "Snare Soft Clip";
    p == 7 ? s = "Streaming Brickwall";
    p == 8 ? s = "Broadcast Brickwall";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  lm_x = max(abs(spl0), abs(spl1)); // interface only
  in_l = spl0 * drive;
  in_r = spl1 * drive;

  mode == 1 ? (
    // soft clip: linear up to 70% of the ceiling, then a smooth knee into the ceiling
    knee = 0.7 * ceiling;
    a = abs(in_l);
    a > knee ? in_l = sign(in_l) * (knee + (ceiling - knee) * (1 - exp(-(a - knee) / (ceiling - knee))));
    a = abs(in_r);
    a > knee ? in_r = sign(in_r) * (knee + (ceiling - knee) * (1 - exp(-(a - knee) / (ceiling - knee))));
    delta ? (
      spl0 = spl0 * drive - in_l;
      spl1 = spl1 * drive - in_r;
    ) : (
      spl0 = in_l;
      spl1 = in_r;
    );
  ) : (
    // peak detector on the incoming (not yet delayed) signal, held for the look-ahead time
    peak = tpk ? tpeak(in_l, in_r) : max(abs(in_l), abs(in_r));
    peak >= hold_val ? (
      hold_val = peak;
      hold_cnt = look;
    ) : hold_cnt > 0 ? (
      hold_cnt -= 1;
    ) : (
      hold_val = max(peak, hold_val * rel);
    );
    target = hold_val > ceiling ? ceiling / hold_val : 1;
    gain = target < gain ? gain + (target - gain) * att : target + (gain - target) * rel;

    buf_l[wpos] = in_l;
    buf_r[wpos] = in_r;
    rpos = wpos - look - (tpk ? 6 : 0);
    rpos < 0 ? rpos += max_look;
    wpos += 1;
    wpos >= max_look ? wpos = 0;

    spl0 = max(-ceiling, min(ceiling, buf_l[rpos] * gain));
    spl1 = max(-ceiling, min(ceiling, buf_r[rpos] * gain));
    delta ? (
      spl0 = buf_l[rpos] - spl0;
      spl1 = buf_r[rpos] - spl1;
    );
  );

  // interface only: meters and history (read the audio state, never change it)
  lm_in = lm_x > lm_in ? lm_x : lm_in * lm_rel;
  lm_lv = max(abs(spl0), abs(spl1));
  lm_out = lm_lv > lm_out ? lm_lv : lm_out * lm_rel;
  lm_g = mode == 1 ? (lm_x * drive > lm_lv ? lm_lv / (lm_x * drive) : 1) : gain;
  lm_hl = max(lm_hl, lm_lv);
  lm_hgh = max(lm_hgh, lm_g);
  lm_hgl = min(lm_hgl, lm_g);
  (lm_n += 1) >= lm_chunk ? (
    lm_buf[lm_w * 2] = lm_hl;
    lm_buf[lm_w * 2 + 1] = lm_hgh * lm_hgl > 1 ? lm_hgh : lm_hgl;
    lm_w = (lm_w + 1) % lm_len;
    lm_n = 0; lm_hl = 0; lm_hgh = 0; lm_hgl = 1000;
  );

@gfx 480 380
  ng_knobs_begin("LIMITER", "ESSENTIALS", 480, 120, 2, 0);

  // display, left: the last 1.8 s of output level (bars) and gain (line; in Clipper mode the
  // output against the driven input); right: input (Threshold marked), gain-reduction and
  // output (Ceiling marked) meters
  lm_history();
  ng_meter(336, 82, 112, 10, "IN", ng_to_db(lm_in), slider2, -48);
  ng_gr_meter(336, 106, 112, 10, "GR", -20 * log10(max(lm_g, 0.0000001)), 24);
  ng_meter(336, 130, 112, 10, "OUT", ng_to_db(lm_out), slider3, -48);

  ng_row(5);
  ng_select_ctl(1, "MODE", "LIMITER|CLIPPER|BRICK", 0) ? update();
  sprintf(#v2, "%.1f dB", slider2);
  ng_knob_ctl(2, "THRESHOLD", #v2, -30, 0, 0, 0.1, 0) ? update();
  sprintf(#v3, "%.1f dB", slider3);
  ng_knob_ctl(3, "CEILING", #v3, -6, -0.1, -0.1, 0.1, 0) ? update();
  sprintf(#v4, "%d ms", slider4);
  ng_knob_ctl(4, "RELEASE", #v4, 0, 1000, 200, 1, 0) ? update();
  sprintf(#v5, "%.1f ms", slider5);
  ng_knob_ctl(5, "LOOKAHEAD", #v5, 0, 10, 2, 0.1, 0) ? update();
  ng_row(2);
  ng_select_ctl(6, "TRUE PEAK", "OFF|ON", 0) ? update();
  ng_select_ctl(7, "LISTEN", "OUTPUT|DELTA", 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
