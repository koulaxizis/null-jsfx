desc:NULL Tone GFX
author: Christos Koulaxizis
tags: eq tone bass treble baxandall shelf low high console hi-fi warm bright simple gui
//category: Essentials
//NULL JSFX v2.7 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:0<-12,12,0.1>-Bass (dB)
slider2:0<-12,12,0.1>-Treble (dB)
slider3:100<40,400,1:log>-Bass Freq (Hz)
slider4:8000<2000,16000,10:log>-Treble Freq (Hz)
slider5:0<-12,12,0.1>-Output (dB)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // NULL Tone (../tone.jsfx) with its own interface: same audio code, plus @gfx.
  // Two broad first-order shelves, the gentle bass and treble controls of a hi-fi amplifier
  // or a console channel. Each shelf is a one-pole low-pass at its corner: the bass shelf
  // adds (gain - 1) of the low band, the treble shelf adds (gain - 1) of what lies above
  // its corner. The slopes are 6 dB per octave, so the curves are wide and never ring.
  // At 0 dB both shelves are flat and the plugin passes the signal unchanged.
  lbl = lbr = 0;
  ltl = ltr = 0;
  gfx_ext_retina = 1;

  function update()
  (
    gb = 10 ^ (slider1 / 20);
    gt = 10 ^ (slider2 / 20);
    go = 10 ^ (slider5 / 20);
    cb = exp(-2 * $pi * min(slider3, 0.45 * srate) / srate);
    ct = exp(-2 * $pi * min(slider4, 0.45 * srate) / srate);
  );

  // the response in dB at frequency f: (1 + (gb - 1) Lb + (gt - 1) (1 - Lt)) * go, where
  // L(z) = (1 - c) / (1 - c z^-1) is the one-pole low-pass of @sample
  function tn_db(f) local(w, cw, sw, d, lbr_, lbi_, ltr_, lti_, hr, hi)
  (
    w = 2 * $pi * min(f, srate * 0.499) / srate;
    cw = cos(w); sw = sin(w);
    d = 1 - 2 * cb * cw + cb * cb;
    lbr_ = (1 - cb) * (1 - cb * cw) / d;
    lbi_ = -(1 - cb) * cb * sw / d;
    d = 1 - 2 * ct * cw + ct * ct;
    ltr_ = (1 - ct) * (1 - ct * cw) / d;
    lti_ = -(1 - ct) * ct * sw / d;
    hr = 1 + (gb - 1) * lbr_ + (gt - 1) * (1 - ltr_);
    hi = (gb - 1) * lbi_ - (gt - 1) * lti_;
    10 * log10(max((hr * hr + hi * hi) * go * go, 0.0000000001));
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 8;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1); ng_hist_add(2); ng_hist_add(3); ng_hist_add(4); ng_hist_add(5);
  ng_hist_init();

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, 100); ng_slider_set(4, 8000); ng_slider_set(5, 0); );
    p == 1 ? ( ng_slider_set(1, 3); ng_slider_set(2, -2); ng_slider_set(3, 100); ng_slider_set(4, 8000); ng_slider_set(5, 0); );
    p == 2 ? ( ng_slider_set(1, 0); ng_slider_set(2, 4); ng_slider_set(3, 100); ng_slider_set(4, 6000); ng_slider_set(5, 0); );
    p == 3 ? ( ng_slider_set(1, 6); ng_slider_set(2, 3); ng_slider_set(3, 120); ng_slider_set(4, 6000); ng_slider_set(5, -3); );
    p == 4 ? ( ng_slider_set(1, -6); ng_slider_set(2, 0); ng_slider_set(3, 200); ng_slider_set(4, 8000); ng_slider_set(5, 0); );
    p == 5 ? ( ng_slider_set(1, 0); ng_slider_set(2, -4); ng_slider_set(3, 100); ng_slider_set(4, 5000); ng_slider_set(5, 0); );
    p == 6 ? ( ng_slider_set(1, -12); ng_slider_set(2, -9); ng_slider_set(3, 400); ng_slider_set(4, 3000); ng_slider_set(5, 4); );
    p == 7 ? ( ng_slider_set(1, 4); ng_slider_set(2, 0); ng_slider_set(3, 60); ng_slider_set(4, 8000); ng_slider_set(5, 0); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 100) && ng_pre_eq(slider4, 8000) && ng_pre_eq(slider5, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 3) && ng_pre_eq(slider2, -2) && ng_pre_eq(slider3, 100) && ng_pre_eq(slider4, 8000) && ng_pre_eq(slider5, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 4) && ng_pre_eq(slider3, 100) && ng_pre_eq(slider4, 6000) && ng_pre_eq(slider5, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 6) && ng_pre_eq(slider2, 3) && ng_pre_eq(slider3, 120) && ng_pre_eq(slider4, 6000) && ng_pre_eq(slider5, -3) ? m = 3;
    m < 0 && ng_pre_eq(slider1, -6) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 200) && ng_pre_eq(slider4, 8000) && ng_pre_eq(slider5, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, -4) && ng_pre_eq(slider3, 100) && ng_pre_eq(slider4, 5000) && ng_pre_eq(slider5, 0) ? m = 5;
    m < 0 && ng_pre_eq(slider1, -12) && ng_pre_eq(slider2, -9) && ng_pre_eq(slider3, 400) && ng_pre_eq(slider4, 3000) && ng_pre_eq(slider5, 4) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 4) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 60) && ng_pre_eq(slider4, 8000) && ng_pre_eq(slider5, 0) ? m = 7;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Warm";
    p == 2 ? s = "Bright";
    p == 3 ? s = "Loudness";
    p == 4 ? s = "Thin Out Lows";
    p == 5 ? s = "Tame Highs";
    p == 6 ? s = "Telephone Lite";
    p == 7 ? s = "Sub Weight";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  lbl = (1 - cb) * spl0 + cb * lbl;
  ltl = (1 - ct) * spl0 + ct * ltl;
  lbr = (1 - cb) * spl1 + cb * lbr;
  ltr = (1 - ct) * spl1 + ct * ltr;
  spl0 = (spl0 + (gb - 1) * lbl + (gt - 1) * (spl0 - ltl)) * go;
  spl1 = (spl1 + (gb - 1) * lbr + (gt - 1) * (spl1 - ltr)) * go;

@gfx 480 294
  ng_knobs_begin("TONE", "ESSENTIALS", 480, 120, 1, 0);

  // display: the response from 20 Hz to 20 kHz (Output included), both corners dashed
  tn_px = ng_vx + 26; tn_py = ng_vy + 4; tn_pw = ng_vw - 30; tn_ph = ng_vh - 20;
  ng_plot(tn_px, tn_py, tn_pw, tn_ph);
  ng_grid_freq(24);
  tn_k = 0;
  loop(2,
    tn_xx = floor(ng_freq_x(tn_k == 0 ? slider3 : slider4)) + 0.5;
    ng_col(NG_ACCENT, 0.5);
    tn_yy = ng_py;
    while (
      gfx_line(tn_xx, tn_yy, tn_xx, min(tn_yy + 3 * ng_s, ng_py + ng_ph), 0);
      tn_yy += 6 * ng_s;
      tn_yy < ng_py + ng_ph;
    );
    tn_k += 1;
  );
  tn_zy = ng_lin_y(0, -16, 16);
  ng_col(NG_ACCENT, 0.10);
  tn_i = 0;
  loop(floor(ng_pw) + 1,
    gfx_line(ng_px + tn_i, tn_zy, ng_px + tn_i, ng_lin_y(tn_db(20 * 1000 ^ (tn_i / ng_pw)), -16, 16), 0);
    tn_i += 1;
  );
  ng_col(NG_ACCENT, 1);
  tn_i = 0;
  loop(floor(ng_pw) + 1,
    tn_yy = ng_lin_y(tn_db(20 * 1000 ^ (tn_i / ng_pw)), -16, 16);
    tn_i == 0 ? ng_line_start(ng_px, tn_yy) : ng_line_to(ng_px + tn_i, tn_yy);
    tn_i += 1;
  );

  ng_row(5);
  sprintf(#tn_v1, "%+.1f dB", slider1);
  ng_knob_ctl(1, "BASS", #tn_v1, -12, 12, 0, 0.1, 1) ? update();
  sprintf(#tn_v2, "%+.1f dB", slider2);
  ng_knob_ctl(2, "TREBLE", #tn_v2, -12, 12, 0, 0.1, 1) ? update();
  sprintf(#tn_v3, "%d Hz", slider3);
  ng_knob_ctl_log(3, "BASS FREQ", #tn_v3, 40, 400, 100, 1) ? update();
  sprintf(#tn_v4, "%.1f kHz", slider4 / 1000);
  ng_knob_ctl_log(4, "TREBLE FREQ", #tn_v4, 2000, 16000, 8000, 10) ? update();
  sprintf(#tn_v5, "%+.1f dB", slider5);
  ng_knob_ctl(5, "OUTPUT", #tn_v5, -12, 12, 0, 0.1, 1) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
