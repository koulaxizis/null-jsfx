desc:NULL De-Clip GFX
author: Christos Koulaxizis
tags: de-clip declip clipping repair restoration reconstruct peaks overload distortion gui
//category: Essentials
//NULL JSFX v2.6 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:-0.3<-24,0,0.1>-Clip Level (dB)
slider2:3<2,8,1>-Min Length (Samples)
slider3:0<-24,12,0.1>-Output (dB)
slider4:0<0,1,1{Output,Delta}>-Listen

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // NULL De-Clip (../de_clip.jsfx) with its own interface: same audio code, plus @gfx.
  // Rebuilds clipped peaks. A run of at least Min Length samples in a row at or above Clip
  // Level (one channel at a time) counts as clipped; it is redrawn with the cubic through the
  // two good samples on either side of it, kept on the side of the clip level it was on and
  // at most 12 dB above it. The output runs 128 samples late (reported for delay
  // compensation) so a run up to 120 samples long can be seen whole before it is played;
  // longer runs stay as they are. The rebuilt peaks pass 0 dBFS: lower Output, or follow with
  // a limiter, before a fixed-point export.
  DC_R = 256;                  // ring length
  DC_L = 128;                  // look-ahead = latency
  DC_XL = 0;                   // input, left / right
  DC_XR = DC_XL + DC_R;
  DC_YL = DC_XR + DC_R;        // output (input with the rebuilt runs), left / right
  DC_YR = DC_YL + DC_R;
  freembuf(DC_YR + DC_R);
  memset(0, 0, DC_YR + DC_R);
  dc_w = 0;
  dc_runs = 0;
  pdc_delay = DC_L;
  pdc_bot_ch = 0;
  pdc_top_ch = 2;

  // A run that ended 3 samples ago (its last sample at c, then two good ones): find where it
  // began and redraw it. Nodes at -2, -1 (before) and m, m + 1 (after), the run at 0 .. m - 1.
  function dc_fix(x, y) local(c, s, m, k, sg, a0, a1, b0, b1, t, v, d0, d1)
  (
    c = (dc_w - 3 + DC_R) % DC_R;
    abs(x[c]) >= dc_thr && abs(x[(c + 1) % DC_R]) < dc_thr ? (
      sg = x[c] > 0 ? 1 : -1;
      m = 1;
      s = c;
      while (k = (s - 1 + DC_R) % DC_R; m <= DC_L - 8 && x[k] * sg >= dc_thr ? (s = k; m += 1; 1) : 0);
      m >= dc_min && m <= DC_L - 8 ? (
        a0 = x[(s - 2 + DC_R) % DC_R];
        a1 = x[(s - 1 + DC_R) % DC_R];
        b0 = x[(c + 1) % DC_R];
        b1 = x[(c + 2) % DC_R];
        d0 = (m + 2) * (m + 3);
        d1 = (m + 1) * (m + 2);
        t = 0;
        loop(m,
          v = -(t + 1) * (t - m) * (t - m - 1) / d0 * a0
              + (t + 2) * (t - m) * (t - m - 1) / d1 * a1
              - (t + 2) * (t + 1) * (t - m - 1) / d1 * b0
              + (t + 2) * (t + 1) * (t - m) / d0 * b1;
          v = sg * min(max(v * sg, dc_thr), dc_thr * 4);
          y[(s + t) % DC_R] = v;
          t += 1;
        );
        dc_runs += 1;
      );
    );
  );

  gfx_ext_retina = 1;
  // display: the input and the output (mid) at the output's moment, and the runs rebuilt
  ng_tap_init(4000000, 2048);

  function update()
  (
    dc_thr = 10 ^ (slider1 / 20);
    dc_min = max(2, min(8, floor(slider2 + 0.5)));
    dc_gain = 10 ^ (slider3 / 20);
    dc_delta = slider4 >= 0.5;
  );

  // waveform of one tap channel (0 = input, 1 = output) across the plot, +-2 full height
  function dg_scope(ch) local(i, j, k, n, per, v, mn, mx, xx)
  (
    n = floor(ng_pw);
    per = max(1, floor(ng_tl / n));
    i = 0;
    loop(n,
      mn = 2; mx = -2;
      j = 0;
      loop(per,
        k = (ng_tw + i * per + j) % ng_tl;
        v = ng_tb[k * 2 + ch];
        mn = min(mn, v); mx = max(mx, v);
        j += 1;
      );
      xx = ng_px + i;
      gfx_line(xx, ng_py + ng_ph * (0.5 - min(2, mx) * 0.25), xx, ng_py + ng_ph * (0.5 - max(-2, mn) * 0.25), 0);
      i += 1;
    );
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 6;

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, -0.3); ng_slider_set(2, 3); ng_slider_set(3, 0); ng_slider_set(4, 0); );
    p == 1 ? ( ng_slider_set(1, -0.1); ng_slider_set(2, 2); ng_slider_set(3, -6); ng_slider_set(4, 0); );
    p == 2 ? ( ng_slider_set(1, -1); ng_slider_set(2, 3); ng_slider_set(3, -6); ng_slider_set(4, 0); );
    p == 3 ? ( ng_slider_set(1, -0.5); ng_slider_set(2, 3); ng_slider_set(3, -3); ng_slider_set(4, 0); );
    p == 4 ? ( ng_slider_set(1, -0.1); ng_slider_set(2, 4); ng_slider_set(3, 0); ng_slider_set(4, 0); );
    p == 5 ? ( ng_slider_set(1, -0.3); ng_slider_set(2, 3); ng_slider_set(3, 0); ng_slider_set(4, 1); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, -0.3) && ng_pre_eq(slider2, 3) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, -0.1) && ng_pre_eq(slider2, 2) && ng_pre_eq(slider3, -6) && ng_pre_eq(slider4, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, -1) && ng_pre_eq(slider2, 3) && ng_pre_eq(slider3, -6) && ng_pre_eq(slider4, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, -0.5) && ng_pre_eq(slider2, 3) && ng_pre_eq(slider3, -3) && ng_pre_eq(slider4, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, -0.1) && ng_pre_eq(slider2, 4) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, -0.3) && ng_pre_eq(slider2, 3) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 1) ? m = 5;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Hard Clipped Master";
    p == 2 ? s = "Normalized Clip";
    p == 3 ? s = "Clipped Recorder";
    p == 4 ? s = "Gentle";
    p == 5 ? s = "Hear What Returns";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  DC_XL[dc_w] = DC_YL[dc_w] = spl0;
  DC_XR[dc_w] = DC_YR[dc_w] = spl1;
  dc_w = (dc_w + 1) % DC_R;
  dc_fix(DC_XL, DC_YL);
  dc_fix(DC_XR, DC_YR);
  dc_o = (dc_w - 1 - DC_L + DC_R) % DC_R;
  dc_delta ? (
    spl0 = (DC_YL[dc_o] - DC_XL[dc_o]) * dc_gain;
    spl1 = (DC_YR[dc_o] - DC_XR[dc_o]) * dc_gain;
  ) : (
    spl0 = DC_YL[dc_o] * dc_gain;
    spl1 = DC_YR[dc_o] * dc_gain;
  );
  dc_o2 = (dc_w - 1 - DC_L + DC_R) % DC_R;
  ng_tap((DC_XL[dc_o2] + DC_XR[dc_o2]) * 0.5, (spl0 + spl1) * 0.5);

@gfx 480 294
  ng_knobs_begin("DE-CLIP", "ESSENTIALS", 480, 120, 1, 0);

  // display: the last 2048 samples, input (muted) under output (accent), mid of L and R, on a
  // +-2 scale with the clip level dashed
  ng_plot(ng_vx + 4, ng_vy + 4, ng_vw - 8, ng_vh - 8);
  ng_grid(8, 4, 1);
  ng_col(NG_TEXT, 0.35);
  dg_y = floor(ng_py + ng_ph * (0.5 - dc_thr * 0.25)) + 0.5;
  dg_x = ng_px;
  while (gfx_line(dg_x, dg_y, min(dg_x + 3 * ng_s, ng_px + ng_pw), dg_y, 0); dg_x += 6 * ng_s; dg_x < ng_px + ng_pw);
  dg_y = floor(ng_py + ng_ph * (0.5 + dc_thr * 0.25)) + 0.5;
  dg_x = ng_px;
  while (gfx_line(dg_x, dg_y, min(dg_x + 3 * ng_s, ng_px + ng_pw), dg_y, 0); dg_x += 6 * ng_s; dg_x < ng_px + ng_pw);
  ng_col(NG_MUTED, 0.8);
  dg_scope(0);
  ng_col(NG_ACCENT, 1);
  dg_scope(1);
  ng_font(4, 8, 0);
  ng_col(NG_MUTED, 1);
  sprintf(#dg_t, "RUNS REBUILT %d", dc_runs);
  ng_ptxt(#dg_t, ng_px + 6 * ng_s, ng_py + 9 * ng_s, 0);
  sprintf(#dg_t, "LATENCY %d SAMPLES (%.2f ms)", DC_L, DC_L / srate * 1000);
  ng_ptxt(#dg_t, ng_px + ng_pw - 6 * ng_s, ng_py + 9 * ng_s, 2);

  ng_row(4);
  sprintf(#v1, "%.1f dB", slider1);
  ng_knob_ctl(1, "CLIP LEVEL", #v1, -24, 0, -0.3, 0.1, 0) ? update();
  sprintf(#v2, "%d smp", slider2);
  ng_knob_ctl(2, "MIN LENGTH", #v2, 2, 8, 3, 1, 0) ? update();
  sprintf(#v3, "%+.1f dB", slider3);
  ng_knob_ctl(3, "OUTPUT", #v3, -24, 12, 0, 0.1, 1) ? update();
  ng_select_ctl(4, "LISTEN", "OUTPUT|DELTA", 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
