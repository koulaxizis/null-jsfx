desc:NULL Reverb GFX
author: Christos Koulaxizis
tags: reverb room space ambience hall plate decay pre-delay freeze modulation gui
//category: Essentials
//NULL JSFX v2.6 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:50<10,100,1>-Room Size (%)
slider2:50<0,100,1>-Decay (%)
slider3:30<0,100,1>-Damping (%)
slider4:30<0,100,1>-Mix (%)
slider5:0<0,1,1>-Bypass
slider6:0<0,250,1>-Pre-Delay (ms)
slider7:20<20,1000,1:log>-Low Cut (Hz)
slider8:20000<1000,20000,1:log>-High Cut (Hz)
slider9:100<0,200,1>-Width (%)
slider10:0<0,100,1>-Modulation (%)
slider11:0<0,1,1{Off,On}>-Freeze
slider12:0<0,2,1{Classic,Plate,Hall}>-Character

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // NULL Reverb (../reverb.jsfx) with its own interface: same audio code, plus @gfx.
  // Stereo Schroeder/Freeverb-style reverb: the mono sum feeds four damped
  // feedback combs per side (the right side's delays are 23 samples longer at
  // 44.1 kHz), then two series all-passes per side. All lengths are scaled by
  // srate/44100 so the room sounds the same at every sample rate.
  // Damping is a one-pole low-pass inside each comb's feedback loop: more Damping
  // absorbs more high frequencies, so the tail gets darker as it decays.
  // Character: Classic is the plain algorithm; Plate and Hall first smear the input
  // through four series all-passes (Dattorro-style diffusion lengths, scaled from
  // 29761 Hz); Plate keeps the combs a little shorter and the loop brighter, Hall makes
  // them 45% longer with a wider left/right spread. Every extra stage (pre-delay,
  // diffusion, modulation, width, low/high cut) is skipped at its off setting, so the
  // defaults are the plain reverb.
  sc = srate / 44100;
  spread = 23;
  // sized for the largest case: Hall combs (x1.45, spread 47)
  blen = ceil((1687 + 47) * 1.45 * sc) + 4;
  // buffer and state memory: 8 combs, 4 all-passes, 4 diffusers, the pre-delay line
  cbl1 = 0;          cbl2 = cbl1 + blen; cbl3 = cbl2 + blen; cbl4 = cbl3 + blen;
  cbr1 = cbl4 + blen; cbr2 = cbr1 + blen; cbr3 = cbr2 + blen; cbr4 = cbr3 + blen;
  apl1 = cbr4 + blen; apl2 = apl1 + blen; apr1 = apl2 + blen; apr2 = apr1 + blen;
  dsc = srate / 29761;
  dl1 = max(1, floor(142 * dsc)); dl2 = max(1, floor(107 * dsc));
  dl3 = max(1, floor(379 * dsc)); dl4 = max(1, floor(277 * dsc));
  dfb1 = apr2 + blen; dfb2 = dfb1 + dl1; dfb3 = dfb2 + dl2; dfb4 = dfb3 + dl3;
  pd_size = ceil(0.25 * srate) + 2;
  pd_buf = dfb4 + dl4;
  memset(0, 0, pd_buf + pd_size);
  freembuf(pd_buf + pd_size);
  wl1 = wl2 = wl3 = wl4 = wr1 = wr2 = wr3 = wr4 = 0;
  wal1 = wal2 = war1 = war2 = 0;
  fl1 = fl2 = fl3 = fl4 = fr1 = fr2 = fr3 = fr4 = 0;
  dw1 = dw2 = dw3 = dw4 = 0;
  pd_w = 0;
  mod_a = mod_b = 0;
  lc_x1l = lc_x2l = lc_y1l = lc_y2l = lc_x1r = lc_x2r = lc_y1r = lc_y2r = 0;
  hc_x1l = hc_x2l = hc_y1l = hc_y2l = hc_x1r = hc_x2r = hc_y1r = hc_y2r = 0;

  function comb(buf, size, w*, f*, x) local(y)
  (
    y = buf[w];
    f = y * damp_a + f * damp;
    buf[w] = x + f * fb;
    w += 1;
    w >= size ? w = 0;
    y;
  );

  function allpass(buf, size, w*, x) local(b, y)
  (
    b = buf[w];
    y = b - x;
    buf[w] = x + b * 0.5;
    w += 1;
    w >= size ? w = 0;
    y;
  );

  // the line read m samples newer than its full length (fractional, linear interpolation)
  function rv_tap(buf, size, w, m) local(p, i, j)
  (
    m = min(m, size - 2);
    p = w + max(0, m);
    p >= size ? p -= size;
    i = floor(p);
    j = i + 1;
    j >= size ? j = 0;
    buf[i] + (buf[j] - buf[i]) * (p - i);
  );

  // comb() and allpass() with a modulated delay: m samples shorter
  function combm(buf, size, w*, f*, x, m) local(y)
  (
    y = rv_tap(buf, size, w, m);
    f = y * damp_a + f * damp;
    buf[w] = x + f * fb;
    w += 1;
    w >= size ? w = 0;
    y;
  );

  function allpassm(buf, size, w*, x, m) local(b, y)
  (
    b = rv_tap(buf, size, w, m);
    y = b - x;
    buf[w] = x + b * 0.5;
    w += 1;
    w >= size ? w = 0;
    y;
  );

  // input diffuser: Schroeder all-pass with gain g
  function diffuse(buf, size, w*, g, x) local(d, v)
  (
    d = buf[w];
    v = x - g * d;
    buf[w] = v;
    w += 1;
    w >= size ? w = 0;
    d + g * v;
  );

  // biquad (direct form I) with the coefficients b0..a2 given
  function rv_bq(x, x1*, x2*, y1*, y2*, b0, b1, b2, a1, a2) local(y)
  (
    y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2;
    x2 = x1; x1 = x;
    y2 = y1; y1 = y;
    y;
  );

  gfx_ext_retina = 1;

  function update()
  (
    room = 0.25 + 0.75 * (slider1 / 100);
    k = room * sc;
    // Character: comb length scale, stereo spread, diffusion
    chr = slider12;
    cf = chr == 2 ? 1.45 : (chr == 1 ? 0.9 : 1);
    sp = chr == 2 ? 47 : spread;
    diff_on = chr > 0;
    kc = k * cf;
    ll1 = max(1, floor(1557 * kc)); lr1 = max(1, floor((1557 + sp) * kc));
    ll2 = max(1, floor(1617 * kc)); lr2 = max(1, floor((1617 + sp) * kc));
    ll3 = max(1, floor(1491 * kc)); lr3 = max(1, floor((1491 + sp) * kc));
    ll4 = max(1, floor(1687 * kc)); lr4 = max(1, floor((1687 + sp) * kc));
    la1 = max(1, floor(556 * k));  lar1 = max(1, floor((556 + sp) * k));
    la2 = max(1, floor(441 * k));  lar2 = max(1, floor((441 + sp) * k));
    wl1 >= ll1 ? wl1 = 0; wl2 >= ll2 ? wl2 = 0; wl3 >= ll3 ? wl3 = 0; wl4 >= ll4 ? wl4 = 0;
    wr1 >= lr1 ? wr1 = 0; wr2 >= lr2 ? wr2 = 0; wr3 >= lr3 ? wr3 = 0; wr4 >= lr4 ? wr4 = 0;
    wal1 >= la1 ? wal1 = 0; wal2 >= la2 ? wal2 = 0;
    war1 >= lar1 ? war1 = 0; war2 >= lar2 ? war2 = 0;
    // Decay: comb feedback 0.70 .. 0.97 (short room .. long hall)
    fb = 0.7 + 0.27 * (slider2 / 100);
    // Damping: cutoff of the in-loop low-pass, 16 kHz at 0% (bright) down to
    // 1.2 kHz at 100% (dark), defined in Hz so it is the same at every sample rate
    // (Plate: twice the cutoff, a brighter tail)
    damp_fc = min(16000 * (1200 / 16000) ^ (slider3 / 100), 0.45 * srate);
    chr == 1 ? damp_fc = min(damp_fc * 2, 0.45 * srate);
    damp = exp(-2 * 3.14159265358979 * damp_fc / srate);
    damp_a = 1 - damp;
    // Freeze: lossless loop (feedback 1, no damping) and no new input
    frz = slider11 > 0;
    frz ? ( fb = 1; damp = 0; damp_a = 1; );
    mix = slider4 / 100;
    // Pre-delay of the reverb's input
    pd_on = slider6 > 0;
    pd_len = max(1, min(pd_size - 1, floor(slider6 * srate / 1000 + 0.5)));
    // Width of the wet signal (mid/side)
    wd_on = slider9 != 100;
    wd = slider9 / 100;
    // Modulation: slow sines move the comb (up to 24 samples at 44.1 kHz) and all-pass
    // (up to 12) delays
    mod_on = slider10 > 0;
    mod_c = slider10 / 100 * 24 * sc;
    mod_p = slider10 / 100 * 12 * sc;
    mod_ia = 2 * $pi * 0.73 / srate;
    mod_ib = 2 * $pi * 1.13 / srate;
    // Low Cut / High Cut on the wet signal: 12 dB/oct Butterworth biquads
    lc_on = slider7 > 20;
    lc_w = 2 * $pi * min(slider7, 0.45 * srate) / srate;
    lc_al = sin(lc_w) / (2 * 0.7071067811865476);
    lc_c = cos(lc_w);
    lc_a0 = 1 + lc_al;
    lc_b0 = (1 + lc_c) / 2 / lc_a0; lc_b1 = -(1 + lc_c) / lc_a0; lc_b2 = lc_b0;
    lc_a1 = -2 * lc_c / lc_a0; lc_a2 = (1 - lc_al) / lc_a0;
    hc_on = slider8 < 20000;
    hc_w = 2 * $pi * min(slider8, 0.45 * srate) / srate;
    hc_al = sin(hc_w) / (2 * 0.7071067811865476);
    hc_c = cos(hc_w);
    hc_a0 = 1 + hc_al;
    hc_b0 = (1 - hc_c) / 2 / hc_a0; hc_b1 = (1 - hc_c) / hc_a0; hc_b2 = hc_b0;
    hc_a1 = -2 * hc_c / hc_a0; hc_a2 = (1 - hc_al) / hc_a0;
  );

  // decay display: seconds to fall 60 dB for a comb loop gain g (the combs average 1588
  // samples at 44.1 kHz times the room and Character scale)
  function rv_rt60(g) ( g > 0 && g < 1 ? -60 / (20 * log10(g)) * 1588 * room * cf / 44100 : 99; );
  // magnitude of the in-loop damping low-pass at f Hz
  function rv_lp(f) local(w) ( w = 2 * $pi * f / srate; damp_a / sqrt(1 - 2 * damp * cos(w) + damp * damp); );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 16;

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 50); ng_slider_set(2, 50); ng_slider_set(3, 30); ng_slider_set(4, 30); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 20); ng_slider_set(8, 20000); ng_slider_set(9, 100); ng_slider_set(10, 0); ng_slider_set(11, 0); ng_slider_set(12, 0); );
    p == 1 ? ( ng_slider_set(1, 35); ng_slider_set(2, 30); ng_slider_set(3, 40); ng_slider_set(4, 18); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 20); ng_slider_set(8, 20000); ng_slider_set(9, 100); ng_slider_set(10, 0); ng_slider_set(11, 0); ng_slider_set(12, 0); );
    p == 2 ? ( ng_slider_set(1, 20); ng_slider_set(2, 15); ng_slider_set(3, 50); ng_slider_set(4, 12); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 20); ng_slider_set(8, 20000); ng_slider_set(9, 100); ng_slider_set(10, 0); ng_slider_set(11, 0); ng_slider_set(12, 0); );
    p == 3 ? ( ng_slider_set(1, 50); ng_slider_set(2, 35); ng_slider_set(3, 30); ng_slider_set(4, 20); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 20); ng_slider_set(8, 20000); ng_slider_set(9, 100); ng_slider_set(10, 0); ng_slider_set(11, 0); ng_slider_set(12, 0); );
    p == 4 ? ( ng_slider_set(1, 60); ng_slider_set(2, 55); ng_slider_set(3, 5); ng_slider_set(4, 22); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 20); ng_slider_set(8, 20000); ng_slider_set(9, 100); ng_slider_set(10, 0); ng_slider_set(11, 0); ng_slider_set(12, 0); );
    p == 5 ? ( ng_slider_set(1, 70); ng_slider_set(2, 60); ng_slider_set(3, 20); ng_slider_set(4, 18); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 20); ng_slider_set(8, 20000); ng_slider_set(9, 100); ng_slider_set(10, 0); ng_slider_set(11, 0); ng_slider_set(12, 0); );
    p == 6 ? ( ng_slider_set(1, 100); ng_slider_set(2, 80); ng_slider_set(3, 35); ng_slider_set(4, 25); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 20); ng_slider_set(8, 20000); ng_slider_set(9, 100); ng_slider_set(10, 0); ng_slider_set(11, 0); ng_slider_set(12, 0); );
    p == 7 ? ( ng_slider_set(1, 90); ng_slider_set(2, 92); ng_slider_set(3, 80); ng_slider_set(4, 40); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 20); ng_slider_set(8, 20000); ng_slider_set(9, 100); ng_slider_set(10, 0); ng_slider_set(11, 0); ng_slider_set(12, 0); );
    p == 8 ? ( ng_slider_set(1, 80); ng_slider_set(2, 70); ng_slider_set(3, 40); ng_slider_set(4, 100); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 20); ng_slider_set(8, 20000); ng_slider_set(9, 100); ng_slider_set(10, 0); ng_slider_set(11, 0); ng_slider_set(12, 0); );
    p == 9 ? ( ng_slider_set(1, 30); ng_slider_set(2, 25); ng_slider_set(3, 45); ng_slider_set(4, 20); ng_slider_set(5, 0); ng_slider_set(6, 5); ng_slider_set(7, 120); ng_slider_set(8, 20000); ng_slider_set(9, 90); ng_slider_set(10, 0); ng_slider_set(11, 0); ng_slider_set(12, 0); );
    p == 10 ? ( ng_slider_set(1, 55); ng_slider_set(2, 55); ng_slider_set(3, 15); ng_slider_set(4, 22); ng_slider_set(5, 0); ng_slider_set(6, 40); ng_slider_set(7, 150); ng_slider_set(8, 12000); ng_slider_set(9, 120); ng_slider_set(10, 15); ng_slider_set(11, 0); ng_slider_set(12, 1); );
    p == 11 ? ( ng_slider_set(1, 60); ng_slider_set(2, 45); ng_slider_set(3, 35); ng_slider_set(4, 22); ng_slider_set(5, 0); ng_slider_set(6, 10); ng_slider_set(7, 200); ng_slider_set(8, 9000); ng_slider_set(9, 110); ng_slider_set(10, 0); ng_slider_set(11, 0); ng_slider_set(12, 1); );
    p == 12 ? ( ng_slider_set(1, 90); ng_slider_set(2, 80); ng_slider_set(3, 40); ng_slider_set(4, 28); ng_slider_set(5, 0); ng_slider_set(6, 30); ng_slider_set(7, 80); ng_slider_set(8, 20000); ng_slider_set(9, 140); ng_slider_set(10, 25); ng_slider_set(11, 0); ng_slider_set(12, 2); );
    p == 13 ? ( ng_slider_set(1, 75); ng_slider_set(2, 70); ng_slider_set(3, 45); ng_slider_set(4, 30); ng_slider_set(5, 0); ng_slider_set(6, 20); ng_slider_set(7, 20); ng_slider_set(8, 10000); ng_slider_set(9, 130); ng_slider_set(10, 70); ng_slider_set(11, 0); ng_slider_set(12, 2); );
    p == 14 ? ( ng_slider_set(1, 40); ng_slider_set(2, 30); ng_slider_set(3, 20); ng_slider_set(4, 15); ng_slider_set(5, 0); ng_slider_set(6, 15); ng_slider_set(7, 250); ng_slider_set(8, 20000); ng_slider_set(9, 180); ng_slider_set(10, 0); ng_slider_set(11, 0); ng_slider_set(12, 0); );
    p == 15 ? ( ng_slider_set(1, 100); ng_slider_set(2, 100); ng_slider_set(3, 30); ng_slider_set(4, 60); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 100); ng_slider_set(8, 20000); ng_slider_set(9, 150); ng_slider_set(10, 40); ng_slider_set(11, 1); ng_slider_set(12, 2); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 50) && ng_pre_eq(slider2, 50) && ng_pre_eq(slider3, 30) && ng_pre_eq(slider4, 30) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 20) && ng_pre_eq(slider8, 20000) && ng_pre_eq(slider9, 100) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 35) && ng_pre_eq(slider2, 30) && ng_pre_eq(slider3, 40) && ng_pre_eq(slider4, 18) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 20) && ng_pre_eq(slider8, 20000) && ng_pre_eq(slider9, 100) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 20) && ng_pre_eq(slider2, 15) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 12) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 20) && ng_pre_eq(slider8, 20000) && ng_pre_eq(slider9, 100) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 50) && ng_pre_eq(slider2, 35) && ng_pre_eq(slider3, 30) && ng_pre_eq(slider4, 20) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 20) && ng_pre_eq(slider8, 20000) && ng_pre_eq(slider9, 100) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 60) && ng_pre_eq(slider2, 55) && ng_pre_eq(slider3, 5) && ng_pre_eq(slider4, 22) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 20) && ng_pre_eq(slider8, 20000) && ng_pre_eq(slider9, 100) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 70) && ng_pre_eq(slider2, 60) && ng_pre_eq(slider3, 20) && ng_pre_eq(slider4, 18) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 20) && ng_pre_eq(slider8, 20000) && ng_pre_eq(slider9, 100) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 0) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 100) && ng_pre_eq(slider2, 80) && ng_pre_eq(slider3, 35) && ng_pre_eq(slider4, 25) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 20) && ng_pre_eq(slider8, 20000) && ng_pre_eq(slider9, 100) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 0) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 90) && ng_pre_eq(slider2, 92) && ng_pre_eq(slider3, 80) && ng_pre_eq(slider4, 40) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 20) && ng_pre_eq(slider8, 20000) && ng_pre_eq(slider9, 100) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 0) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 80) && ng_pre_eq(slider2, 70) && ng_pre_eq(slider3, 40) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 20) && ng_pre_eq(slider8, 20000) && ng_pre_eq(slider9, 100) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 0) ? m = 8;
    m < 0 && ng_pre_eq(slider1, 30) && ng_pre_eq(slider2, 25) && ng_pre_eq(slider3, 45) && ng_pre_eq(slider4, 20) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 5) && ng_pre_eq(slider7, 120) && ng_pre_eq(slider8, 20000) && ng_pre_eq(slider9, 90) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 0) ? m = 9;
    m < 0 && ng_pre_eq(slider1, 55) && ng_pre_eq(slider2, 55) && ng_pre_eq(slider3, 15) && ng_pre_eq(slider4, 22) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 40) && ng_pre_eq(slider7, 150) && ng_pre_eq(slider8, 12000) && ng_pre_eq(slider9, 120) && ng_pre_eq(slider10, 15) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 1) ? m = 10;
    m < 0 && ng_pre_eq(slider1, 60) && ng_pre_eq(slider2, 45) && ng_pre_eq(slider3, 35) && ng_pre_eq(slider4, 22) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 10) && ng_pre_eq(slider7, 200) && ng_pre_eq(slider8, 9000) && ng_pre_eq(slider9, 110) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 1) ? m = 11;
    m < 0 && ng_pre_eq(slider1, 90) && ng_pre_eq(slider2, 80) && ng_pre_eq(slider3, 40) && ng_pre_eq(slider4, 28) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 30) && ng_pre_eq(slider7, 80) && ng_pre_eq(slider8, 20000) && ng_pre_eq(slider9, 140) && ng_pre_eq(slider10, 25) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 2) ? m = 12;
    m < 0 && ng_pre_eq(slider1, 75) && ng_pre_eq(slider2, 70) && ng_pre_eq(slider3, 45) && ng_pre_eq(slider4, 30) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 20) && ng_pre_eq(slider7, 20) && ng_pre_eq(slider8, 10000) && ng_pre_eq(slider9, 130) && ng_pre_eq(slider10, 70) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 2) ? m = 13;
    m < 0 && ng_pre_eq(slider1, 40) && ng_pre_eq(slider2, 30) && ng_pre_eq(slider3, 20) && ng_pre_eq(slider4, 15) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 15) && ng_pre_eq(slider7, 250) && ng_pre_eq(slider8, 20000) && ng_pre_eq(slider9, 180) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 0) ? m = 14;
    m < 0 && ng_pre_eq(slider1, 100) && ng_pre_eq(slider2, 100) && ng_pre_eq(slider3, 30) && ng_pre_eq(slider4, 60) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 100) && ng_pre_eq(slider8, 20000) && ng_pre_eq(slider9, 150) && ng_pre_eq(slider10, 40) && ng_pre_eq(slider11, 1) && ng_pre_eq(slider12, 2) ? m = 15;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Small Vocal Room";
    p == 2 ? s = "Tight Ambience";
    p == 3 ? s = "Drum Room";
    p == 4 ? s = "Bright Vocal Space";
    p == 5 ? s = "Snare Splash";
    p == 6 ? s = "Large Hall";
    p == 7 ? s = "Dark Pad Wash";
    p == 8 ? s = "Send Return Full Wet";
    p == 9 ? s = "Small Room";
    p == 10 ? s = "Vocal Plate";
    p == 11 ? s = "Drum Chamber";
    p == 12 ? s = "Big Hall";
    p == 13 ? s = "Modulated Space";
    p == 14 ? s = "Wide Ambience";
    p == 15 ? s = "Frozen Pad";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  orig_l = spl0;
  orig_r = spl1;
  x = (spl0 + spl1) * 0.015;

  // pre-delay (the line is always written, read only when on)
  pd_buf[pd_w] = x;
  pd_on ? (
    pd_r = pd_w - pd_len;
    pd_r < 0 ? pd_r += pd_size;
    x = pd_buf[pd_r];
  );
  pd_w += 1;
  pd_w >= pd_size ? pd_w = 0;
  diff_on ? (
    x = diffuse(dfb1, dl1, dw1, 0.75, x);
    x = diffuse(dfb2, dl2, dw2, 0.75, x);
    x = diffuse(dfb3, dl3, dw3, 0.625, x);
    x = diffuse(dfb4, dl4, dw4, 0.625, x);
  );
  frz ? x = 0;

  mod_on ? (
    mod_a += mod_ia; mod_a >= 2 * $pi ? mod_a -= 2 * $pi;
    mod_b += mod_ib; mod_b >= 2 * $pi ? mod_b -= 2 * $pi;
    ms_a = sin(mod_a); mc_a = cos(mod_a);
    ms_b = sin(mod_b); mc_b = cos(mod_b);
    wet_l = combm(cbl1, ll1, wl1, fl1, x, mod_c * (0.5 + 0.5 * ms_a)) + combm(cbl2, ll2, wl2, fl2, x, mod_c * (0.5 + 0.5 * mc_a))
          + combm(cbl3, ll3, wl3, fl3, x, mod_c * (0.5 - 0.5 * ms_a)) + combm(cbl4, ll4, wl4, fl4, x, mod_c * (0.5 - 0.5 * mc_a));
    wet_r = combm(cbr1, lr1, wr1, fr1, x, mod_c * (0.5 + 0.5 * mc_a)) + combm(cbr2, lr2, wr2, fr2, x, mod_c * (0.5 - 0.5 * ms_a))
          + combm(cbr3, lr3, wr3, fr3, x, mod_c * (0.5 - 0.5 * mc_a)) + combm(cbr4, lr4, wr4, fr4, x, mod_c * (0.5 + 0.5 * ms_a));
    wet_l = allpassm(apl2, la2, wal2, allpassm(apl1, la1, wal1, wet_l, mod_p * (0.5 + 0.5 * ms_b)), mod_p * (0.5 + 0.5 * mc_b));
    wet_r = allpassm(apr2, lar2, war2, allpassm(apr1, lar1, war1, wet_r, mod_p * (0.5 - 0.5 * ms_b)), mod_p * (0.5 - 0.5 * mc_b));
  ) : (
    wet_l = comb(cbl1, ll1, wl1, fl1, x) + comb(cbl2, ll2, wl2, fl2, x)
          + comb(cbl3, ll3, wl3, fl3, x) + comb(cbl4, ll4, wl4, fl4, x);
    wet_r = comb(cbr1, lr1, wr1, fr1, x) + comb(cbr2, lr2, wr2, fr2, x)
          + comb(cbr3, lr3, wr3, fr3, x) + comb(cbr4, lr4, wr4, fr4, x);
    wet_l = allpass(apl2, la2, wal2, allpass(apl1, la1, wal1, wet_l));
    wet_r = allpass(apr2, lar2, war2, allpass(apr1, lar1, war1, wet_r));
  );

  wd_on ? (
    wd_m = (wet_l + wet_r) * 0.5;
    wd_s = (wet_l - wet_r) * 0.5 * wd;
    wet_l = wd_m + wd_s;
    wet_r = wd_m - wd_s;
  );
  lc_on ? (
    wet_l = rv_bq(wet_l, lc_x1l, lc_x2l, lc_y1l, lc_y2l, lc_b0, lc_b1, lc_b2, lc_a1, lc_a2);
    wet_r = rv_bq(wet_r, lc_x1r, lc_x2r, lc_y1r, lc_y2r, lc_b0, lc_b1, lc_b2, lc_a1, lc_a2);
  ) : (
    lc_x1l = lc_x2l = lc_y1l = lc_y2l = lc_x1r = lc_x2r = lc_y1r = lc_y2r = 0;
  );
  hc_on ? (
    wet_l = rv_bq(wet_l, hc_x1l, hc_x2l, hc_y1l, hc_y2l, hc_b0, hc_b1, hc_b2, hc_a1, hc_a2);
    wet_r = rv_bq(wet_r, hc_x1r, hc_x2r, hc_y1r, hc_y2r, hc_b0, hc_b1, hc_b2, hc_a1, hc_a2);
  ) : (
    hc_x1l = hc_x2l = hc_y1l = hc_y2l = hc_x1r = hc_x2r = hc_y1r = hc_y2r = 0;
  );

  out_l = orig_l * (1 - mix) + wet_l * 3 * mix;
  out_r = orig_r * (1 - mix) + wet_r * 3 * mix;

  spl0 = slider5 > 0 ? orig_l : out_l;
  spl1 = slider5 > 0 ? orig_r : out_r;

@gfx 480 380
  ng_knobs_begin("REVERB", "ESSENTIALS", 480, 120, 2, 0);

  // display: the tail's decay over 3 s, level in dB (0 to -60), starting after the pre-delay:
  // lows (the comb feedback) in the accent, highs at 5 kHz (feedback times the damping
  // low-pass) muted; frozen, the tail holds at 0 dB
  ng_plot(ng_vx + 26, ng_vy + 4, ng_vw - 30, ng_vh - 20);
  ng_grid(6, 4, 0);
  ng_font(4, 8, 0);
  ng_col(NG_MUTED, 1);
  ng_ptxt("0", ng_px - 6 * ng_s, ng_py, 2);
  ng_ptxt("-30", ng_px - 6 * ng_s, ng_py + ng_ph / 2, 2);
  ng_ptxt("-60", ng_px - 6 * ng_s, ng_py + ng_ph, 2);
  rv_i = 1;
  loop(5, sprintf(#rv_t, "%.1f s", rv_i * 0.5); ng_ptxt(#rv_t, ng_px + ng_pw * rv_i / 6, ng_py + ng_ph + 10 * ng_s, 1); rv_i += 1;);
  rv_pd = slider6 / 1000;
  rv_x0 = ng_lin_x(rv_pd, 0, 3);
  rv_lo = frz ? 99 : rv_rt60(fb);
  rv_hi = frz ? 99 : rv_rt60(fb * rv_lp(5000));
  rv_a = slider5 > 0 ? 0.35 : 1;
  // the pre-delay gap: a dashed line where the tail starts
  slider6 > 0 ? (
    ng_col(NG_MUTED, 0.6 * rv_a);
    rv_y = ng_py;
    while (
      gfx_line(floor(rv_x0) + 0.5, rv_y, floor(rv_x0) + 0.5, min(rv_y + 3 * ng_s, ng_py + ng_ph), 0);
      rv_y += 6 * ng_s;
      rv_y < ng_py + ng_ph;
    );
    ng_col(NG_MUTED, rv_a);
    sprintf(#rv_t, "PRE %d ms", slider6);
    ng_ptxt(#rv_t, rv_x0 + 5 * ng_s, ng_py + ng_ph - 8 * ng_s, 0);
  );
  // highs
  rv_te = min(rv_hi, 3 - rv_pd);
  ng_col(NG_MUTED, rv_a);
  ng_line_start(rv_x0, ng_py);
  ng_line_to(ng_lin_x(rv_pd + rv_te, 0, 3), ng_lin_y(-60 * rv_te / rv_hi, -60, 0));
  // lows, shaded down to -60
  rv_te = min(rv_lo, 3 - rv_pd);
  rv_x2 = ng_lin_x(rv_pd + rv_te, 0, 3);
  rv_y2 = ng_lin_y(-60 * rv_te / rv_lo, -60, 0);
  ng_col(NG_ACCENT, 0.10 * rv_a);
  rv_i = 0;
  loop(floor(rv_x2 - rv_x0) + 1,
    gfx_line(rv_x0 + rv_i, ng_py + (rv_y2 - ng_py) * rv_i / max(1, rv_x2 - rv_x0), rv_x0 + rv_i, ng_py + ng_ph, 0);
    rv_i += 1;
  );
  ng_col(NG_ACCENT, rv_a);
  ng_line_start(rv_x0, ng_py);
  ng_line_to(rv_x2, rv_y2);
  ng_col(NG_MUTED, 1);
  strcpy(#rv_c, slider12 == 2 ? "HALL   " : (slider12 == 1 ? "PLATE   " : ""));
  slider10 > 0 ? sprintf(#rv_m, "MOD %d%%   ", slider10) : strcpy(#rv_m, "");
  slider5 > 0 ? sprintf(#rv_t, "BYPASSED") : (
    frz ? sprintf(#rv_t, "%s%sFROZEN", #rv_c, #rv_m) : sprintf(#rv_t, "%s%sRT60 %.2f s   5 kHz %.2f s", #rv_c, #rv_m, rv_lo, rv_hi);
  );
  ng_ptxt(#rv_t, ng_px + ng_pw - 6 * ng_s, ng_py + 9 * ng_s, 2);

  ng_row(6);
  sprintf(#v1, "%d%%", slider1);
  ng_knob_ctl(1, "SIZE", #v1, 10, 100, 50, 1, 0) ? update();
  sprintf(#v2, "%d%%", slider2);
  ng_knob_ctl(2, "DECAY", #v2, 0, 100, 50, 1, 0) ? update();
  sprintf(#v3, "%d%%", slider3);
  ng_knob_ctl(3, "DAMPING", #v3, 0, 100, 30, 1, 0) ? update();
  sprintf(#v6, "%d ms", slider6);
  ng_knob_ctl(6, "PRE-DELAY", #v6, 0, 250, 0, 1, 0) ? update();
  sprintf(#v4, "%d%%", slider4);
  ng_knob_ctl(4, "MIX", #v4, 0, 100, 30, 1, 0) ? update();
  ng_select_ctl(5, "BYPASS", "OFF|ON", 0) ? update();
  ng_row(6);
  ng_select_ctl(12, "CHARACTER", "CLASSIC|PLATE|HALL", 0) ? update();
  slider7 > 20 ? sprintf(#v7, "%d Hz", slider7) : strcpy(#v7, "OFF");
  ng_knob_ctl_log(7, "LOW CUT", #v7, 20, 1000, 20, 1) ? update();
  slider8 >= 20000 ? strcpy(#v8, "OFF") : sprintf(#v8, "%.1f kHz", slider8 / 1000);
  ng_knob_ctl_log(8, "HIGH CUT", #v8, 1000, 20000, 20000, 1) ? update();
  sprintf(#v9, "%d%%", slider9);
  ng_knob_ctl(9, "WIDTH", #v9, 0, 200, 100, 1, 1) ? update();
  sprintf(#v10, "%d%%", slider10);
  ng_knob_ctl(10, "MODULATION", #v10, 0, 100, 0, 1, 0) ? update();
  ng_select_ctl(11, "FREEZE", "OFF|ON", 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
