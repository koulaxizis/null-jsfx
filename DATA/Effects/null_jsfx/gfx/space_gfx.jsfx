desc:NULL Space GFX
author: Christos Koulaxizis
tags: reverb space room chamber hall galaxy fdn feedback delay network algorithmic modulation ambience long decay pre-delay gui
//category: Essentials
//NULL JSFX v2.8 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:2<0,3,1{Room,Chamber,Hall,Galaxy}>-Type
slider2:50<0,100,1>-Size (%)
slider3:50<0,100,1>-Decay (%)
slider4:30<0,100,1>-Damping (%)
slider5:30<0,100,1>-Detune (%)
slider6:0<0,250,1>-Pre-Delay (ms)
slider7:30<0,100,1>-Mix (%)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // NULL Space (../space.jsfx) with its own interface: same audio code, plus @gfx.
  // An algorithmic reverb built on an 8-line feedback delay network. Each side goes through a
  // pre-delay and two Schroeder all-passes (input diffusion), then feeds every other line of
  // the network. Each line is read with a slowly moving length (Detune: eight sine LFOs from
  // 0.13 to 0.48 Hz, linear interpolation), damped by a one-pole low-pass (Damping: 20 kHz
  // down to 1.5 kHz) and scaled so it decays by 60 dB in the decay time, then the eight
  // outputs are mixed by an 8x8 Hadamard matrix and written back with the input. The left
  // output sums lines 0, 2, 4, 6 and the right 1, 3, 5, 7 with alternating signs.
  // Type sets the line lengths (Room 9.7-24.7 ms, Chamber x1.7, Hall x3, Galaxy x5, each
  // times Size: x0.5 to x2), the decay range (Room 0.2-1.5 s, Chamber 0.5-3 s, Hall 1-8 s,
  // Galaxy 3-30 s, exponential over Decay), the detune depth (0.5 ms, Galaxy 1.5 ms) and the
  // diffusion (0.6, Galaxy 0.7). Line lengths glide (50 ms) so Type and Size do not click.
  // States below 1e-15 are cleared so silence stays free of denormals.
  lmax = ceil(0.26 * srate) + 8;
  pmax = ceil(0.25 * srate) + 8;
  amax = ceil(0.03 * srate) + 8;
  pb = 8 * lmax;
  ab = pb + 2 * pmax;
  st = ab + 4 * amax;
  // st: 0-7 line lengths (gliding), 8-15 their targets, 16-23 line gains, 24-31 damping
  // states, 32-39 LFO phases, 40-47 the lines' outputs, 48-55 line lengths at Size 1 in the
  // Room (ms), 56-63 LFO steps, 64-67 all-pass lengths (gliding), 68-71 their targets,
  // 72-75 all-pass lengths at Size 1 in the Room (ms)
  memset(0, 0, st + 76);
  freembuf(st + 76);
  st[48] = 9.7; st[49] = 11.3; st[50] = 13.1; st[51] = 14.9;
  st[52] = 17.3; st[53] = 19.9; st[54] = 22.1; st[55] = 24.7;
  st[72] = 1.31; st[73] = 1.97; st[74] = 1.43; st[75] = 2.11;
  wp = pw = aw = 0;
  ks = 1 - exp(-1 / (0.05 * srate));
  snap = 1;
  gfx_ext_retina = 1;

  // Schroeder all-pass of n samples on the buffer at b
  function sp_ap(x, b, n) local(rp, d, w)
  (
    rp = aw - n;
    rp < 0 ? rp += amax;
    d = b[rp];
    w = x + apg * d;
    w = abs(w) < 0.000000000000001 ? 0 : w;
    b[aw] = w;
    d - apg * w;
  );

  function update()
  (
    typ = slider1;
    tm = typ == 0 ? 1 : typ == 1 ? 1.7 : typ == 2 ? 3 : 5;
    sz = 0.5 * 2 ^ (slider2 / 50);
    rt = typ == 0 ? 0.2 * 7.5 ^ (slider3 / 100) : typ == 1 ? 0.5 * 6 ^ (slider3 / 100) :
         typ == 2 ? 8 ^ (slider3 / 100) : 3 * 10 ^ (slider3 / 100);
    da = 1 - exp(-2 * $pi * min(20000 * 0.075 ^ (slider4 / 100), 0.45 * srate) / srate);
    md = slider5 / 100 * (typ == 3 ? 1.5 : 0.5) * srate / 1000;
    pd = floor(slider6 / 1000 * srate + 0.5);
    mx = slider7 / 100;
    apg = typ == 3 ? 0.7 : 0.6;
    i = 0;
    loop(8,
      st[8 + i] = st[48 + i] * tm * sz * srate / 1000;
      st[16 + i] = 10 ^ (-3 * st[8 + i] / (rt * srate));
      st[56 + i] = (0.13 + 0.05 * i) * 2 * $pi / srate;
      i += 1;
    );
    i = 0;
    loop(4,
      st[68 + i] = st[72 + i] * tm * sz * srate / 1000;
      i += 1;
    );
    snap ? (
      memcpy(st, st + 8, 8);
      memcpy(st + 64, st + 68, 4);
      snap = 0;
    );
  );

  // decay time at 8 kHz: the damping low-pass takes its loss once per pass through a line
  function sp_rt8() local(w, q, lp, ml)
  (
    w = 2 * $pi * min(8000, 0.45 * srate) / srate;
    q = 1 - da;
    lp = -10 * log10(da * da / (1 - 2 * q * cos(w) + q * q));
    ml = (st[8] + st[9] + st[10] + st[11] + st[12] + st[13] + st[14] + st[15]) / 8;
    60 / (60 / rt + lp * srate / ml);
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 9;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1); ng_hist_add(2); ng_hist_add(3); ng_hist_add(4); ng_hist_add(5); ng_hist_add(6); ng_hist_add(7);
  ng_hist_init();

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 2); ng_slider_set(2, 50); ng_slider_set(3, 50); ng_slider_set(4, 30); ng_slider_set(5, 30); ng_slider_set(6, 0); ng_slider_set(7, 30); );
    p == 1 ? ( ng_slider_set(1, 0); ng_slider_set(2, 40); ng_slider_set(3, 40); ng_slider_set(4, 40); ng_slider_set(5, 30); ng_slider_set(6, 0); ng_slider_set(7, 20); );
    p == 2 ? ( ng_slider_set(1, 0); ng_slider_set(2, 70); ng_slider_set(3, 60); ng_slider_set(4, 25); ng_slider_set(5, 30); ng_slider_set(6, 0); ng_slider_set(7, 25); );
    p == 3 ? ( ng_slider_set(1, 1); ng_slider_set(2, 50); ng_slider_set(3, 50); ng_slider_set(4, 35); ng_slider_set(5, 30); ng_slider_set(6, 25); ng_slider_set(7, 25); );
    p == 4 ? ( ng_slider_set(1, 1); ng_slider_set(2, 35); ng_slider_set(3, 30); ng_slider_set(4, 45); ng_slider_set(5, 30); ng_slider_set(6, 0); ng_slider_set(7, 20); );
    p == 5 ? ( ng_slider_set(1, 2); ng_slider_set(2, 60); ng_slider_set(3, 55); ng_slider_set(4, 30); ng_slider_set(5, 30); ng_slider_set(6, 20); ng_slider_set(7, 30); );
    p == 6 ? ( ng_slider_set(1, 2); ng_slider_set(2, 70); ng_slider_set(3, 70); ng_slider_set(4, 70); ng_slider_set(5, 30); ng_slider_set(6, 30); ng_slider_set(7, 30); );
    p == 7 ? ( ng_slider_set(1, 3); ng_slider_set(2, 80); ng_slider_set(3, 70); ng_slider_set(4, 40); ng_slider_set(5, 70); ng_slider_set(6, 40); ng_slider_set(7, 45); );
    p == 8 ? ( ng_slider_set(1, 3); ng_slider_set(2, 100); ng_slider_set(3, 100); ng_slider_set(4, 30); ng_slider_set(5, 60); ng_slider_set(6, 0); ng_slider_set(7, 50); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 50) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 30) && ng_pre_eq(slider5, 30) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 30) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 40) && ng_pre_eq(slider3, 40) && ng_pre_eq(slider4, 40) && ng_pre_eq(slider5, 30) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 20) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 70) && ng_pre_eq(slider3, 60) && ng_pre_eq(slider4, 25) && ng_pre_eq(slider5, 30) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 25) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 50) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 35) && ng_pre_eq(slider5, 30) && ng_pre_eq(slider6, 25) && ng_pre_eq(slider7, 25) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 35) && ng_pre_eq(slider3, 30) && ng_pre_eq(slider4, 45) && ng_pre_eq(slider5, 30) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 20) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 60) && ng_pre_eq(slider3, 55) && ng_pre_eq(slider4, 30) && ng_pre_eq(slider5, 30) && ng_pre_eq(slider6, 20) && ng_pre_eq(slider7, 30) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 70) && ng_pre_eq(slider3, 70) && ng_pre_eq(slider4, 70) && ng_pre_eq(slider5, 30) && ng_pre_eq(slider6, 30) && ng_pre_eq(slider7, 30) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 3) && ng_pre_eq(slider2, 80) && ng_pre_eq(slider3, 70) && ng_pre_eq(slider4, 40) && ng_pre_eq(slider5, 70) && ng_pre_eq(slider6, 40) && ng_pre_eq(slider7, 45) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 3) && ng_pre_eq(slider2, 100) && ng_pre_eq(slider3, 100) && ng_pre_eq(slider4, 30) && ng_pre_eq(slider5, 60) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 50) ? m = 8;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Small Room";
    p == 2 ? s = "Live Room";
    p == 3 ? s = "Vocal Chamber";
    p == 4 ? s = "Drum Chamber";
    p == 5 ? s = "Concert Hall";
    p == 6 ? s = "Dark Hall";
    p == 7 ? s = "Galaxy Pad";
    p == 8 ? s = "Infinite Space";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  // pre-delay (the buffer is always written, so switching it on starts clean)
  pd > 0 ? (
    rp = pw - pd;
    rp < 0 ? rp += pmax;
    xl = pb[rp];
    xr = pb[pmax + rp];
  ) : (
    xl = spl0;
    xr = spl1;
  );
  pb[pw] = spl0;
  pb[pmax + pw] = spl1;
  pw += 1;
  pw >= pmax ? pw = 0;

  // input diffusion: two all-passes per side
  i = 0;
  loop(4,
    st[64 + i] += (st[68 + i] - st[64 + i]) * ks;
    i += 1;
  );
  xl = sp_ap(sp_ap(xl, ab, floor(st[64] + 0.5)), ab + amax, floor(st[65] + 0.5));
  xr = sp_ap(sp_ap(xr, ab + 2 * amax, floor(st[66] + 0.5)), ab + 3 * amax, floor(st[67] + 0.5));
  aw += 1;
  aw >= amax ? aw = 0;

  // read the eight lines (moving, interpolated), damp and scale them
  i = 0;
  loop(8,
    st[i] += (st[8 + i] - st[i]) * ks;
    st[32 + i] += st[56 + i];
    st[32 + i] >= 2 * $pi ? st[32 + i] -= 2 * $pi;
    rp = wp - (st[i] + md * sin(st[32 + i]));
    rp < 0 ? rp += lmax;
    i0 = floor(rp);
    fr = rp - i0;
    i1 = i0 + 1;
    i1 >= lmax ? i1 = 0;
    b = i * lmax;
    o = b[i0] + fr * (b[i1] - b[i0]);
    o = st[24 + i] + (o - st[24 + i]) * da;
    st[24 + i] = abs(o) < 0.000000000000001 ? 0 : o;
    st[40 + i] = st[24 + i] * st[16 + i];
    i += 1;
  );
  wl = st[40] - st[42] + st[44] - st[46];
  wr = st[41] - st[43] + st[45] - st[47];

  // 8x8 Hadamard (three butterfly stages, then 1/sqrt(8)), write back with the input
  h = 1;
  loop(3,
    j = 0;
    loop(8,
      (j & h) == 0 ? (
        a = st[40 + j];
        c = st[40 + j + h];
        st[40 + j] = a + c;
        st[40 + j + h] = a - c;
      );
      j += 1;
    );
    h *= 2;
  );
  i = 0;
  loop(8,
    w = st[40 + i] * 0.35355339059327373 + (i & 1 ? xr : xl);
    b = i * lmax;
    b[wp] = abs(w) < 0.000000000000001 ? 0 : w;
    i += 1;
  );
  wp += 1;
  wp >= lmax ? wp = 0;

  spl0 = spl0 * (1 - mx) + wl * 0.5 * mx;
  spl1 = spl1 * (1 - mx) + wr * 0.5 * mx;

@gfx 480 380
  ng_knobs_begin("SPACE", "ESSENTIALS", 480, 120, 2, 0);

  // display: the decay (level in dB over time) after the pre-delay, at low and middle
  // frequencies (bright) and at 8 kHz (dim), on a time scale that fits it
  sp_px = ng_vx + 26; sp_py = ng_vy + 16; sp_pw = ng_vw - 34; sp_ph = ng_vh - 32;
  ng_plot(sp_px, sp_py, sp_pw, sp_ph);
  ng_grid(4, 2, 0);
  sp_pre = slider6 / 1000;
  sp_r8 = sp_rt8();
  sp_top = 0.1; sp_m = 1;
  while (sp_top < (sp_pre + rt) * 1.1) (
    sp_top *= sp_m == 2 ? 2.5 : 2;
    sp_m = sp_m == 1 ? 2 : sp_m == 2 ? 5 : 1;
  );
  ng_font(4, 8, 0);
  ng_col(NG_MUTED, 1);
  ng_ptxt("0", ng_px - 6 * ng_s, ng_py, 2);
  ng_ptxt("-30", ng_px - 6 * ng_s, ng_py + ng_ph / 2, 2);
  ng_ptxt("-60", ng_px - 6 * ng_s, ng_py + ng_ph, 2);
  sp_i = 0;
  loop(3,
    sp_t = sp_top * sp_i / 2;
    sp_t >= 1 || sp_t == 0 ? sprintf(#sp_l, "%g s", sp_t) : sprintf(#sp_l, "%d ms", floor(sp_t * 1000 + 0.5));
    sp_w = sp_h = 0;
    gfx_measurestr(#sp_l, sp_w, sp_h);
    gfx_x = ng_px + ng_pw * sp_i / 2 - (sp_i == 0 ? 0 : sp_i == 1 ? sp_w / 2 : sp_w);
    gfx_y = ng_py + ng_ph + 4 * ng_s;
    gfx_drawstr(#sp_l);
    sp_i += 1;
  );
  sp_x0 = ng_lin_x(sp_pre, 0, sp_top);
  sp_pre > 0 ? (
    ng_col(NG_ACCENT, 0.5);
    sp_yy = ng_py;
    while (
      gfx_line(floor(sp_x0) + 0.5, sp_yy, floor(sp_x0) + 0.5, min(sp_yy + 3 * ng_s, ng_py + ng_ph), 0);
      sp_yy += 6 * ng_s;
      sp_yy < ng_py + ng_ph;
    );
  );
  ng_col(NG_ACCENT, 0.45);
  ng_line_start(sp_x0, ng_py);
  ng_line_to(ng_lin_x(sp_pre + sp_r8, 0, sp_top), ng_py + ng_ph);
  sp_x1 = ng_lin_x(sp_pre + rt, 0, sp_top);
  ng_col(NG_ACCENT, 0.10);
  sp_i = floor(sp_x0);
  while (sp_i <= sp_x1) (
    gfx_line(sp_i, ng_py + ng_ph, sp_i, ng_py + ng_ph * (sp_i - sp_x0) / max(sp_x1 - sp_x0, 1), 0);
    sp_i += 1;
  );
  ng_col(NG_ACCENT, 1);
  ng_line_start(sp_x0, ng_py);
  ng_line_to(sp_x1, ng_py + ng_ph);
  // status line: the type and the decay times
  ng_font(1, 7, 1);
  ng_col(NG_ACCENT, 1);
  ng_txt(slider1 == 0 ? "ROOM" : slider1 == 1 ? "CHAMBER" : slider1 == 2 ? "HALL" : "GALAXY", ng_vx + 26, ng_vy + 4, 0, 1);
  sprintf(#sp_st, "RT60 %.2f S   8 KHZ %.2f S", rt, sp_r8);
  ng_col(NG_MUTED, 1);
  ng_txt(#sp_st, ng_vx + ng_vw - 8, ng_vy + 4, 2, 1);

  ng_row(4);
  ng_select_ctl(1, "TYPE", "ROOM|CHAMBER|HALL|GALAXY", 0) ? update();
  sprintf(#v2, "%d%%", slider2);
  ng_knob_ctl(2, "SIZE", #v2, 0, 100, 50, 1, 0) ? update();
  sprintf(#v3, "%d%%", slider3);
  ng_knob_ctl(3, "DECAY", #v3, 0, 100, 50, 1, 0) ? update();
  sprintf(#v4, "%d%%", slider4);
  ng_knob_ctl(4, "DAMPING", #v4, 0, 100, 30, 1, 0) ? update();
  ng_row(3);
  sprintf(#v5, "%d%%", slider5);
  ng_knob_ctl(5, "DETUNE", #v5, 0, 100, 30, 1, 0) ? update();
  sprintf(#v6, "%d ms", slider6);
  ng_knob_ctl(6, "PRE-DELAY", #v6, 0, 250, 0, 1, 0) ? update();
  sprintf(#v7, "%d%%", slider7);
  ng_knob_ctl(7, "MIX", #v7, 0, 100, 30, 1, 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
