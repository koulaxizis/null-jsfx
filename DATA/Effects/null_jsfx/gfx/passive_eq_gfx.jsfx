desc:NULL Passive EQ GFX
author: Christos Koulaxizis
tags: eq equalizer passive program tube vintage low boost attenuate shelf air bandwidth mastering color gui
//category: Essentials
//NULL JSFX v3.0 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:2<0,3,1{20 Hz,30 Hz,60 Hz,100 Hz}>-Low Freq
slider2:0<0,10,0.1>-Low Boost
slider3:0<0,10,0.1>-Low Atten
slider4:3<0,6,1{3 kHz,4 kHz,5 kHz,8 kHz,10 kHz,12 kHz,16 kHz}>-High Freq
slider5:0<0,10,0.1>-High Boost
slider6:5<0,10,0.1>-Bandwidth
slider7:1<0,2,1{5 kHz,10 kHz,20 kHz}>-Atten Freq
slider8:0<0,10,0.1>-High Atten
slider9:0<0,100,1>-Tube (%)
slider10:0<-12,12,0.1>-Output (dB)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep the filters, as in the VST3/CLAP
  // NULL Passive EQ (../passive_eq.jsfx) with its own interface: same audio code, plus @gfx.
  // A program EQ in the passive style, with broad, musical curves and no frequency knobs to
  // hunt with. Low Boost is a low shelf at 1.2 x Low Freq (up to +13.5 dB) and Low Atten a
  // gentler shelf at 2.2 x Low Freq (down to -17.5 dB): both together give the classic bump
  // under the frequency with a dip just above it. High Boost is a peak at High Freq (up to
  // +18 dB) whose width is Bandwidth (0 sharp, 10 broad); High Atten is a high shelf at Atten
  // Freq (down to -20 dB). Tube drives a slightly asymmetric tanh stage (even harmonics) with
  // a 10 Hz DC blocker after it. Every band at 0 and Tube at 0 % leave the sound untouched.
  ST = 0;                      // filter state: 4 biquads x 2 channels x 2 values
  memset(ST, 0, 16);
  dcl = dcr = dxl = dxr = 0;

  // tanh (EEL2 has none): (e^2x - 1) / (e^2x + 1), clamped
  function pe_tanh(x) local(e)
  (
    x > 20 ? 1 : x < -20 ? -1 : (e = exp(2 * x); (e - 1) / (e + 1));
  );

  // RBJ biquads: kind 0 = low shelf (slope S), 1 = high shelf (slope S), 2 = peaking (Q)
  function pe_bq(kind, f, sq, g) local(w0, cw, sw, A, al, a0, b2a)
  (
    w0 = 2 * $pi * min(f, 0.45 * srate) / srate;
    cw = cos(w0);
    sw = sin(w0);
    A = 10 ^ (g / 40);
    kind == 2 ? (
      al = sw / (2 * sq);
      a0 = 1 + al / A;
      this.b0 = (1 + al * A) / a0;
      this.b1 = -2 * cw / a0;
      this.b2 = (1 - al * A) / a0;
      this.a1 = this.b1;
      this.a2 = (1 - al / A) / a0;
    ) : (
      al = sw / 2 * sqrt((A + 1 / A) * (1 / sq - 1) + 2);
      b2a = 2 * sqrt(A) * al;
      kind == 0 ? (
        a0 = (A + 1) + (A - 1) * cw + b2a;
        this.b0 = A * ((A + 1) - (A - 1) * cw + b2a) / a0;
        this.b1 = 2 * A * ((A - 1) - (A + 1) * cw) / a0;
        this.b2 = A * ((A + 1) - (A - 1) * cw - b2a) / a0;
        this.a1 = -2 * ((A - 1) + (A + 1) * cw) / a0;
        this.a2 = ((A + 1) + (A - 1) * cw - b2a) / a0;
      ) : (
        a0 = (A + 1) - (A - 1) * cw + b2a;
        this.b0 = A * ((A + 1) + (A - 1) * cw + b2a) / a0;
        this.b1 = -2 * A * ((A - 1) + (A + 1) * cw) / a0;
        this.b2 = A * ((A + 1) + (A - 1) * cw - b2a) / a0;
        this.a1 = 2 * ((A - 1) - (A + 1) * cw) / a0;
        this.a2 = ((A + 1) - (A - 1) * cw - b2a) / a0;
      );
    );
  );

  function pe_run(x, s) local(y)
  (
    y = this.b0 * x + ST[s];
    ST[s] = this.b1 * x - this.a1 * y + ST[s + 1];
    ST[s + 1] = this.b2 * x - this.a2 * y;
    y;
  );

  function pe_chain(x, c)
  (
    lb_on ? x = lb.pe_run(x, c * 8);
    la_on ? x = la.pe_run(x, c * 8 + 2);
    hb_on ? x = hb.pe_run(x, c * 8 + 4);
    ha_on ? x = ha.pe_run(x, c * 8 + 6);
    x;
  );
  gfx_ext_retina = 1;

  function update()
  (
    lf = slider1 == 0 ? 20 : slider1 == 1 ? 30 : slider1 == 2 ? 60 : 100;
    hf = slider4 == 0 ? 3000 : slider4 == 1 ? 4000 : slider4 == 2 ? 5000 : slider4 == 3 ? 8000 :
         slider4 == 4 ? 10000 : slider4 == 5 ? 12000 : 16000;
    af = slider7 == 0 ? 5000 : slider7 == 1 ? 10000 : 20000;
    lb_on = slider2 > 0;
    la_on = slider3 > 0;
    hb_on = slider5 > 0;
    ha_on = slider8 > 0;
    lb.pe_bq(0, 1.2 * lf, 0.7, 1.35 * slider2);
    la.pe_bq(0, 2.2 * lf, 0.4, -1.75 * slider3);
    hb.pe_bq(2, hf, 2.2 - 0.19 * slider6, 1.8 * slider5);
    ha.pe_bq(1, af, 0.6, -2 * slider8);
    tube = slider9 / 100;
    tk = 1 + 3 * tube;
    tb = 0.2 * tube;
    tz = pe_tanh(tb);
    dca = exp(-2 * $pi * 10 / srate);
    og = 10 ^ (slider10 / 20);
  );

  // |H|^2 of this biquad at angular frequency w
  function pe_pow(w) local(c1, s1, c2, s2, nr, ni, dr, di)
  (
    c1 = cos(w); s1 = sin(w); c2 = cos(2 * w); s2 = sin(2 * w);
    nr = this.b0 + this.b1 * c1 + this.b2 * c2;
    ni = -(this.b1 * s1 + this.b2 * s2);
    dr = 1 + this.a1 * c1 + this.a2 * c2;
    di = -(this.a1 * s1 + this.a2 * s2);
    (nr * nr + ni * ni) / (dr * dr + di * di);
  );

  // the EQ's response in dB at f (Output included, Tube left out)
  function pe_db(f) local(w, p)
  (
    w = 2 * $pi * min(f, srate * 0.499) / srate;
    p = og * og;
    lb_on ? p *= lb.pe_pow(w);
    la_on ? p *= la.pe_pow(w);
    hb_on ? p *= hb.pe_pow(w);
    ha_on ? p *= ha.pe_pow(w);
    10 * log10(max(p, 0.0000000001));
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 9;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1); ng_hist_add(2); ng_hist_add(3); ng_hist_add(4); ng_hist_add(5); ng_hist_add(6); ng_hist_add(7); ng_hist_add(8); ng_hist_add(9); ng_hist_add(10);
  ng_hist_init();

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 2); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 3); ng_slider_set(5, 0); ng_slider_set(6, 5); ng_slider_set(7, 1); ng_slider_set(8, 0); ng_slider_set(9, 0); ng_slider_set(10, 0); );
    p == 1 ? ( ng_slider_set(1, 2); ng_slider_set(2, 5); ng_slider_set(3, 3); ng_slider_set(4, 2); ng_slider_set(5, 2); ng_slider_set(6, 4); ng_slider_set(7, 1); ng_slider_set(8, 0); ng_slider_set(9, 0); ng_slider_set(10, 0); );
    p == 2 ? ( ng_slider_set(1, 3); ng_slider_set(2, 3); ng_slider_set(3, 1.5); ng_slider_set(4, 3); ng_slider_set(5, 0); ng_slider_set(6, 5); ng_slider_set(7, 1); ng_slider_set(8, 0); ng_slider_set(9, 20); ng_slider_set(10, 0); );
    p == 3 ? ( ng_slider_set(1, 2); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 5); ng_slider_set(5, 3.5); ng_slider_set(6, 7); ng_slider_set(7, 2); ng_slider_set(8, 1); ng_slider_set(9, 0); ng_slider_set(10, 0); );
    p == 4 ? ( ng_slider_set(1, 3); ng_slider_set(2, 0); ng_slider_set(3, 2); ng_slider_set(4, 2); ng_slider_set(5, 2.5); ng_slider_set(6, 3); ng_slider_set(7, 1); ng_slider_set(8, 0); ng_slider_set(9, 0); ng_slider_set(10, 0); );
    p == 5 ? ( ng_slider_set(1, 1); ng_slider_set(2, 2); ng_slider_set(3, 1); ng_slider_set(4, 6); ng_slider_set(5, 2); ng_slider_set(6, 8); ng_slider_set(7, 1); ng_slider_set(8, 0); ng_slider_set(9, 15); ng_slider_set(10, 0); );
    p == 6 ? ( ng_slider_set(1, 2); ng_slider_set(2, 1.5); ng_slider_set(3, 0); ng_slider_set(4, 3); ng_slider_set(5, 0); ng_slider_set(6, 5); ng_slider_set(7, 0); ng_slider_set(8, 4); ng_slider_set(9, 40); ng_slider_set(10, 0); );
    p == 7 ? ( ng_slider_set(1, 3); ng_slider_set(2, 0); ng_slider_set(3, 3); ng_slider_set(4, 1); ng_slider_set(5, 4); ng_slider_set(6, 2.5); ng_slider_set(7, 1); ng_slider_set(8, 0); ng_slider_set(9, 0); ng_slider_set(10, 0); );
    p == 8 ? ( ng_slider_set(1, 2); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 3); ng_slider_set(5, 0); ng_slider_set(6, 5); ng_slider_set(7, 1); ng_slider_set(8, 0); ng_slider_set(9, 60); ng_slider_set(10, -1); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 3) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 5) && ng_pre_eq(slider7, 1) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 5) && ng_pre_eq(slider3, 3) && ng_pre_eq(slider4, 2) && ng_pre_eq(slider5, 2) && ng_pre_eq(slider6, 4) && ng_pre_eq(slider7, 1) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 3) && ng_pre_eq(slider2, 3) && ng_pre_eq(slider3, 1.5) && ng_pre_eq(slider4, 3) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 5) && ng_pre_eq(slider7, 1) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 20) && ng_pre_eq(slider10, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 5) && ng_pre_eq(slider5, 3.5) && ng_pre_eq(slider6, 7) && ng_pre_eq(slider7, 2) && ng_pre_eq(slider8, 1) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 3) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 2) && ng_pre_eq(slider4, 2) && ng_pre_eq(slider5, 2.5) && ng_pre_eq(slider6, 3) && ng_pre_eq(slider7, 1) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 2) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, 6) && ng_pre_eq(slider5, 2) && ng_pre_eq(slider6, 8) && ng_pre_eq(slider7, 1) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 15) && ng_pre_eq(slider10, 0) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 1.5) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 3) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 5) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 4) && ng_pre_eq(slider9, 40) && ng_pre_eq(slider10, 0) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 3) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 3) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 4) && ng_pre_eq(slider6, 2.5) && ng_pre_eq(slider7, 1) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 3) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 5) && ng_pre_eq(slider7, 1) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 60) && ng_pre_eq(slider10, -1) ? m = 8;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Kick Weight";
    p == 2 ? s = "Bass Body";
    p == 3 ? s = "Vocal Air";
    p == 4 ? s = "Vocal Presence";
    p == 5 ? s = "Master Sheen";
    p == 6 ? s = "Dark Tape";
    p == 7 ? s = "Snare Crack";
    p == 8 ? s = "Warm Tube";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  l = pe_chain(spl0, 0);
  r = pe_chain(spl1, 1);
  tube > 0 ? (
    l = (pe_tanh(tk * l + tb) - tz) / tk;
    r = (pe_tanh(tk * r + tb) - tz) / tk;
    // DC blocker: y = x - x1 + a * y1
    yl = l - dxl + dca * dcl;
    dxl = l;
    dcl = yl;
    l = yl;
    yr = r - dxr + dca * dcr;
    dxr = r;
    dcr = yr;
    r = yr;
  );
  spl0 = l * og;
  spl1 = r * og;

@gfx 480 380
  ng_knobs_begin("PASSIVE EQ", "ESSENTIALS", 480, 120, 2, 0);

  // display: the response from 20 Hz to 20 kHz (Output included), the three frequencies dashed
  pq_px = ng_vx + 26; pq_py = ng_vy + 4; pq_pw = ng_vw - 30; pq_ph = ng_vh - 20;
  ng_plot(pq_px, pq_py, pq_pw, pq_ph);
  ng_grid_freq(36);
  pq_k = 0;
  loop(3,
    pq_xx = floor(ng_freq_x(pq_k == 0 ? lf : pq_k == 1 ? hf : af)) + 0.5;
    ng_col(NG_ACCENT, 0.5);
    pq_yy = ng_py;
    while (
      gfx_line(pq_xx, pq_yy, pq_xx, min(pq_yy + 3 * ng_s, ng_py + ng_ph), 0);
      pq_yy += 6 * ng_s;
      pq_yy < ng_py + ng_ph;
    );
    pq_k += 1;
  );
  pq_zy = ng_lin_y(0, -24, 24);
  ng_col(NG_ACCENT, 0.10);
  pq_i = 0;
  loop(floor(ng_pw) + 1,
    gfx_line(ng_px + pq_i, pq_zy, ng_px + pq_i, ng_lin_y(pe_db(20 * 1000 ^ (pq_i / ng_pw)), -24, 24), 0);
    pq_i += 1;
  );
  ng_col(NG_ACCENT, 1);
  pq_i = 0;
  loop(floor(ng_pw) + 1,
    pq_yy = ng_lin_y(pe_db(20 * 1000 ^ (pq_i / ng_pw)), -24, 24);
    pq_i == 0 ? ng_line_start(ng_px, pq_yy) : ng_line_to(ng_px + pq_i, pq_yy);
    pq_i += 1;
  );

  ng_row(6);
  ng_select_ctl(1, "LOW FREQ", "20|30|60|100", 0) ? update();
  sprintf(#pq_v2, "%.1f", slider2);
  ng_knob_ctl(2, "LOW BOOST", #pq_v2, 0, 10, 0, 0.1, 0) ? update();
  sprintf(#pq_v3, "%.1f", slider3);
  ng_knob_ctl(3, "LOW ATTEN", #pq_v3, 0, 10, 0, 0.1, 0) ? update();
  ng_select_ctl(4, "HIGH FREQ", "3K|4K|5K|8K|10K|12K|16K", 0) ? update();
  sprintf(#pq_v5, "%.1f", slider5);
  ng_knob_ctl(5, "HIGH BOOST", #pq_v5, 0, 10, 0, 0.1, 0) ? update();
  sprintf(#pq_v6, "%.1f", slider6);
  ng_knob_ctl(6, "BANDWIDTH", #pq_v6, 0, 10, 5, 0.1, 0) ? update();
  ng_row(4);
  ng_select_ctl(7, "ATTEN FREQ", "5K|10K|20K", 0) ? update();
  sprintf(#pq_v8, "%.1f", slider8);
  ng_knob_ctl(8, "HIGH ATTEN", #pq_v8, 0, 10, 0, 0.1, 0) ? update();
  sprintf(#pq_v9, "%d%%", slider9);
  ng_knob_ctl(9, "TUBE", #pq_v9, 0, 100, 0, 1, 0) ? update();
  sprintf(#pq_v10, "%+.1f dB", slider10);
  ng_knob_ctl(10, "OUTPUT", #pq_v10, -12, 12, 0, 0.1, 1) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
