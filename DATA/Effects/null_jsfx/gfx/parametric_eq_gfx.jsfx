desc:NULL Parametric EQ GFX
author: Christos Koulaxizis
tags: equalizer parametric eq 5-band shelving filter mixing mastering gui
//category: Essentials
//NULL JSFX v2.6 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:77<20,300,1>-Low Freq (Hz)
slider2:0<-18,18,0.1>-Low Gain (dB)
slider3:1.0<0.1,10.0,0.1>-Low Q
slider4:2<0,7,1{Low Shelf,High Shelf,Peaking,Low Pass,High Pass,Notch,Band Pass,All Pass}>-Low Type
slider5:0<0,2,1{Active,Bypass,Solo}>-Low Mode
slider6:548<300,1000,1>-Low Mid Freq (Hz)
slider7:0<-18,18,0.1>-Low Mid Gain (dB)
slider8:1.0<0.1,10.0,0.1>-Low Mid Q
slider9:2<0,7,1{Low Shelf,High Shelf,Peaking,Low Pass,High Pass,Notch,Band Pass,All Pass}>-Low Mid Type
slider10:0<0,2,1{Active,Bypass,Solo}>-Low Mid Mode
slider11:2236<1000,5000,1>-Mid High Freq (Hz)
slider12:0<-18,18,0.1>-Mid High Gain (dB)
slider13:1.0<0.1,10.0,0.1>-Mid High Q
slider14:2<0,7,1{Low Shelf,High Shelf,Peaking,Low Pass,High Pass,Notch,Band Pass,All Pass}>-Mid High Type
slider15:0<0,2,1{Active,Bypass,Solo}>-Mid High Mode
slider16:10000<5000,20000,1>-High Freq (Hz)
slider17:0<-18,18,0.1>-High Gain (dB)
slider18:1.0<0.1,10.0,0.1>-High Q
slider19:2<0,7,1{Low Shelf,High Shelf,Peaking,Low Pass,High Pass,Notch,Band Pass,All Pass}>-High Type
slider20:0<0,2,1{Active,Bypass,Solo}>-High Mode
slider21:15000<10000,24000,1>-Ultra High Freq (Hz)
slider22:0<-18,18,0.1>-Ultra High Gain (dB)
slider23:1.0<0.1,10.0,0.1>-Ultra High Q
slider24:2<0,7,1{Low Shelf,High Shelf,Peaking,Low Pass,High Pass,Notch,Band Pass,All Pass}>-Ultra High Type
slider25:0<0,2,1{Active,Bypass,Solo}>-Ultra High Mode

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // NULL Parametric EQ (../parametric_eq.jsfx) with its own interface: same audio code, plus @gfx.
  // Five fully parametric bands in series. Each band can be any of eight RBJ filter
  // shapes. Mode: Bypass skips the band; Solo plays only what that band's frequency
  // and Q select (band-pass), to find problem frequencies.

  // coefficients for one band: this.b0 .. this.a2
  function design(freq, gain, q, type) local(w, c, s, al, A, sq, a0)
  (
    w = 2 * $pi * min(freq, srate * 0.49) / srate;
    c = cos(w); s = sin(w);
    al = s / (2 * max(q, 0.05));
    A = 10 ^ (gain / 40); sq = sqrt(A);
    type == 0 ? (       // low shelf
      this.b0 = A * ((A + 1) - (A - 1) * c + 2 * sq * al);
      this.b1 = 2 * A * ((A - 1) - (A + 1) * c);
      this.b2 = A * ((A + 1) - (A - 1) * c - 2 * sq * al);
      a0 = (A + 1) + (A - 1) * c + 2 * sq * al;
      this.a1 = -2 * ((A - 1) + (A + 1) * c);
      this.a2 = (A + 1) + (A - 1) * c - 2 * sq * al;
    ) : type == 1 ? (   // high shelf
      this.b0 = A * ((A + 1) + (A - 1) * c + 2 * sq * al);
      this.b1 = -2 * A * ((A - 1) + (A + 1) * c);
      this.b2 = A * ((A + 1) + (A - 1) * c - 2 * sq * al);
      a0 = (A + 1) - (A - 1) * c + 2 * sq * al;
      this.a1 = 2 * ((A - 1) - (A + 1) * c);
      this.a2 = (A + 1) - (A - 1) * c - 2 * sq * al;
    ) : type == 2 ? (   // peaking
      this.b0 = 1 + al * A; this.b1 = -2 * c; this.b2 = 1 - al * A;
      a0 = 1 + al / A; this.a1 = -2 * c; this.a2 = 1 - al / A;
    ) : type == 3 ? (   // low pass
      this.b0 = (1 - c) / 2; this.b1 = 1 - c; this.b2 = (1 - c) / 2;
      a0 = 1 + al; this.a1 = -2 * c; this.a2 = 1 - al;
    ) : type == 4 ? (   // high pass
      this.b0 = (1 + c) / 2; this.b1 = -(1 + c); this.b2 = (1 + c) / 2;
      a0 = 1 + al; this.a1 = -2 * c; this.a2 = 1 - al;
    ) : type == 5 ? (   // notch
      this.b0 = 1; this.b1 = -2 * c; this.b2 = 1;
      a0 = 1 + al; this.a1 = -2 * c; this.a2 = 1 - al;
    ) : type == 6 ? (   // band pass (0 dB peak)
      this.b0 = al; this.b1 = 0; this.b2 = -al;
      a0 = 1 + al; this.a1 = -2 * c; this.a2 = 1 - al;
    ) : (               // all pass
      this.b0 = 1 - al; this.b1 = -2 * c; this.b2 = 1 + al;
      a0 = 1 + al; this.a1 = -2 * c; this.a2 = 1 - al;
    );
    this.b0 /= a0; this.b1 /= a0; this.b2 /= a0; this.a1 /= a0; this.a2 /= a0;
  );

  function setup(freq, gain, q, type, mode)
  (
    this.design(freq, gain, q, mode == 2 ? 6 : type);
    this.on = mode != 1;
    this.solo = mode == 2;
  );

  // run one channel through one band; state is per band and per channel (this.xl1 ...)
  function run_l(x) local(y)
  (
    y = this.b0 * x + this.b1 * this.xl1 + this.b2 * this.xl2 - this.a1 * this.yl1 - this.a2 * this.yl2;
    this.xl2 = this.xl1; this.xl1 = x; this.yl2 = this.yl1; this.yl1 = y;
    y;
  );
  function run_r(x) local(y)
  (
    y = this.b0 * x + this.b1 * this.xr1 + this.b2 * this.xr2 - this.a1 * this.yr1 - this.a2 * this.yr2;
    this.xr2 = this.xr1; this.xr1 = x; this.yr2 = this.yr1; this.yr1 = y;
    y;
  );
  function band(xl*, xr*, active)
  (
    active ? (xl = this.run_l(xl); xr = this.run_r(xr));
  );

  function update()
  (
    b1.setup(slider1, slider2, slider3, slider4, slider5);
    b2.setup(slider6, slider7, slider8, slider9, slider10);
    b3.setup(slider11, slider12, slider13, slider14, slider15);
    b4.setup(slider16, slider17, slider18, slider19, slider20);
    b5.setup(slider21, slider22, slider23, slider24, slider25);
    solo_any = b1.solo || b2.solo || b3.solo || b4.solo || b5.solo;
  );

  // display: magnitude in dB of this band's biquad at w (radians per sample)
  function pe_db(w) local(c1, s1, c2, s2, nr, ni, dr, di)
  (
    c1 = cos(w); s1 = sin(w); c2 = cos(2 * w); s2 = sin(2 * w);
    nr = this.b0 + this.b1 * c1 + this.b2 * c2; ni = -(this.b1 * s1 + this.b2 * s2);
    dr = 1 + this.a1 * c1 + this.a2 * c2; di = -(this.a1 * s1 + this.a2 * s2);
    10 * log10(max(nr * nr + ni * ni, 0.00000000000000000001) / max(dr * dr + di * di, 0.00000000000000000001));
  );
  // the whole EQ at f Hz: the bands the audio runs (solo / bypass as in @sample)
  function pe_total(f) local(w)
  (
    w = 2 * $pi * min(f, srate * 0.4999) / srate;
    ((solo_any ? b1.solo : b1.on) ? b1.pe_db(w)) + ((solo_any ? b2.solo : b2.on) ? b2.pe_db(w)) +
    ((solo_any ? b3.solo : b3.on) ? b3.pe_db(w)) + ((solo_any ? b4.solo : b4.on) ? b4.pe_db(w)) +
    ((solo_any ? b5.solo : b5.on) ? b5.pe_db(w));
  );
  // value text for a frequency: Hz below 1 kHz, else kHz
  function pe_freq_txt(f) ( f >= 1000 ? sprintf(#pe_v, "%.2f kHz", f / 1000) : sprintf(#pe_v, "%d Hz", f); #pe_v; );

  // the value of slider i (1-based)
  function pe_slider(i)
  (
    i == 1 ? slider1 : i == 2 ? slider2 : i == 3 ? slider3 : i == 4 ? slider4 : i == 5 ? slider5 :
    i == 6 ? slider6 : i == 7 ? slider7 : i == 8 ? slider8 : i == 9 ? slider9 :
    i == 10 ? slider10 : i == 11 ? slider11 : i == 12 ? slider12 : i == 13 ? slider13 :
    i == 14 ? slider14 : i == 15 ? slider15 : i == 16 ? slider16 : i == 17 ? slider17 :
    i == 18 ? slider18 : i == 19 ? slider19 : i == 20 ? slider20 : i == 21 ? slider21 :
    i == 22 ? slider22 : i == 23 ? slider23 : i == 24 ? slider24 : slider25;
  );

  // ---- spectrum (display only, never changes the audio) ----
  // the spectrum behind the curve: @sample writes the mono input (pre) and output (post) into
  // two rings, @gfx takes the last 4096 samples of one, a Hann window and an FFT each frame;
  // each bin's power (0 dB = a full-scale sine) rises at once and falls over 300 ms. The
  // selector at the top right of the display picks POST, PRE or OFF (an interface setting).
  PE_PRE = 0;        // 4096
  PE_POST = 4096;    // 4096
  PE_BUF = 8192;     // FFT buffer, 8192 (does not cross a 65536 boundary)
  PE_WIN = 16384;    // Hann window, 4096
  PE_SP = 20480;     // smoothed power, 2049
  memset(0, 0, 22529);
  pe_i = 0;
  loop(4096, PE_WIN[pe_i] = 0.5 - 0.5 * cos(2 * $pi * pe_i / 4096); pe_i += 1;);
  pe_wp = 0;
  pe_an = 0;         // 0 = post, 1 = pre, 2 = off
  pe_an_last = 0;

  function pe_analyze(ring) local(i, p, k, re, im, pw, s, dt, rc)
  (
    dt = max(0, min(0.5, ng_now - pe_an_last));
    pe_an_last = ng_now;
    rc = exp(-dt / 0.3);
    p = pe_wp;
    i = 0;
    loop(4096,
      PE_BUF[2 * i] = ring[p] * PE_WIN[i];
      PE_BUF[2 * i + 1] = 0;
      p = (p + 1) & 4095;
      i += 1;
    );
    fft(PE_BUF, 4096);
    fft_permute(PE_BUF, 4096);
    k = 0;
    loop(2049,
      re = PE_BUF[2 * k];
      im = PE_BUF[2 * k + 1];
      pw = (re * re + im * im) * 16 / (4096 * 4096);
      s = PE_SP[k];
      PE_SP[k] = pw > s ? pw : s * rc + pw * (1 - rc);
      k += 1;
    );
  );

  // the spectrum in the plot: per design unit the loudest bin under it (or the nearest two
  // interpolated), tilted 4.5 dB/oct around 1 kHz, -90..0 dB over the plot height
  function pe_spectrum(cols) local(c, f0, f1, k0, k1, a, b, p, kc, ci, db, y, xl, xr, lx, ly)
  (
    c = 0;
    loop(cols,
      f0 = 20 * 1000 ^ (c / cols);
      f1 = 20 * 1000 ^ ((c + 1) / cols);
      k0 = f0 * 4096 / srate;
      k1 = min(2048, f1 * 4096 / srate);
      a = ceil(k0);
      b = floor(k1);
      a <= b ? (
        p = 0;
        while (a <= b) ( p = max(p, PE_SP[a]); a += 1; );
      ) : (
        kc = min(2047, (k0 + k1) / 2);
        ci = floor(kc);
        p = PE_SP[ci] + (PE_SP[ci + 1] - PE_SP[ci]) * (kc - ci);
      );
      db = 10 * log10(p + 0.00000000000000000001) + 4.5 * log(sqrt(f0 * f1) / 1000) / log(2);
      y = ng_lin_y(db, -90, 0);
      xl = floor(ng_px + ng_pw * c / cols);
      xr = floor(ng_px + ng_pw * (c + 1) / cols);
      ng_col(NG_MUTED, 0.13);
      y < ng_py + ng_ph ? gfx_rect(xl, y, max(1, xr - xl), ng_py + ng_ph - y);
      ng_col(NG_MUTED, 0.45);
      c > 0 ? gfx_line(lx, ly, ng_px + ng_pw * (c + 0.5) / cols, y, 1);
      lx = ng_px + ng_pw * (c + 0.5) / cols;
      ly = y;
      c += 1;
    );
  );

  gfx_ext_retina = 1;

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 8;

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 77); ng_slider_set(2, 0); ng_slider_set(3, 1); ng_slider_set(4, 2); ng_slider_set(5, 0); ng_slider_set(6, 548); ng_slider_set(7, 0); ng_slider_set(8, 1); ng_slider_set(9, 2); ng_slider_set(10, 0); ng_slider_set(11, 2236); ng_slider_set(12, 0); ng_slider_set(13, 1); ng_slider_set(14, 2); ng_slider_set(15, 0); ng_slider_set(16, 10000); ng_slider_set(17, 0); ng_slider_set(18, 1); ng_slider_set(19, 2); ng_slider_set(20, 0); ng_slider_set(21, 15000); ng_slider_set(22, 0); ng_slider_set(23, 1); ng_slider_set(24, 2); ng_slider_set(25, 0); );
    p == 1 ? ( ng_slider_set(1, 80); ng_slider_set(2, 0); ng_slider_set(3, 0.7); ng_slider_set(4, 4); ng_slider_set(5, 0); ng_slider_set(6, 350); ng_slider_set(7, -2); ng_slider_set(8, 1.2); ng_slider_set(9, 2); ng_slider_set(10, 0); ng_slider_set(11, 3000); ng_slider_set(12, 2); ng_slider_set(13, 1); ng_slider_set(14, 2); ng_slider_set(15, 0); ng_slider_set(16, 10000); ng_slider_set(17, 2); ng_slider_set(18, 0.7); ng_slider_set(19, 1); ng_slider_set(20, 0); ng_slider_set(21, 15000); ng_slider_set(22, 0); ng_slider_set(23, 1); ng_slider_set(24, 2); ng_slider_set(25, 0); );
    p == 2 ? ( ng_slider_set(1, 60); ng_slider_set(2, 3); ng_slider_set(3, 1.2); ng_slider_set(4, 2); ng_slider_set(5, 0); ng_slider_set(6, 400); ng_slider_set(7, -4); ng_slider_set(8, 1.5); ng_slider_set(9, 2); ng_slider_set(10, 0); ng_slider_set(11, 3500); ng_slider_set(12, 3); ng_slider_set(13, 1.4); ng_slider_set(14, 2); ng_slider_set(15, 0); ng_slider_set(16, 10000); ng_slider_set(17, 0); ng_slider_set(18, 1); ng_slider_set(19, 2); ng_slider_set(20, 0); ng_slider_set(21, 15000); ng_slider_set(22, 0); ng_slider_set(23, 1); ng_slider_set(24, 2); ng_slider_set(25, 0); );
    p == 3 ? ( ng_slider_set(1, 200); ng_slider_set(2, 2); ng_slider_set(3, 1.2); ng_slider_set(4, 2); ng_slider_set(5, 0); ng_slider_set(6, 800); ng_slider_set(7, -3); ng_slider_set(8, 4); ng_slider_set(9, 2); ng_slider_set(10, 0); ng_slider_set(11, 4000); ng_slider_set(12, 2.5); ng_slider_set(13, 1); ng_slider_set(14, 2); ng_slider_set(15, 0); ng_slider_set(16, 10000); ng_slider_set(17, 1.5); ng_slider_set(18, 0.7); ng_slider_set(19, 1); ng_slider_set(20, 0); ng_slider_set(21, 15000); ng_slider_set(22, 0); ng_slider_set(23, 1); ng_slider_set(24, 2); ng_slider_set(25, 0); );
    p == 4 ? ( ng_slider_set(1, 90); ng_slider_set(2, 0); ng_slider_set(3, 0.7); ng_slider_set(4, 4); ng_slider_set(5, 0); ng_slider_set(6, 300); ng_slider_set(7, -3); ng_slider_set(8, 1); ng_slider_set(9, 2); ng_slider_set(10, 0); ng_slider_set(11, 2500); ng_slider_set(12, 1.5); ng_slider_set(13, 1); ng_slider_set(14, 2); ng_slider_set(15, 0); ng_slider_set(16, 12000); ng_slider_set(17, 2); ng_slider_set(18, 0.7); ng_slider_set(19, 1); ng_slider_set(20, 0); ng_slider_set(21, 15000); ng_slider_set(22, 0); ng_slider_set(23, 1); ng_slider_set(24, 2); ng_slider_set(25, 0); );
    p == 5 ? ( ng_slider_set(1, 80); ng_slider_set(2, 2); ng_slider_set(3, 1); ng_slider_set(4, 2); ng_slider_set(5, 0); ng_slider_set(6, 500); ng_slider_set(7, -2); ng_slider_set(8, 1.2); ng_slider_set(9, 2); ng_slider_set(10, 0); ng_slider_set(11, 1200); ng_slider_set(12, 2.5); ng_slider_set(13, 1.2); ng_slider_set(14, 2); ng_slider_set(15, 0); ng_slider_set(16, 6000); ng_slider_set(17, 0); ng_slider_set(18, 0.7); ng_slider_set(19, 3); ng_slider_set(20, 0); ng_slider_set(21, 15000); ng_slider_set(22, 0); ng_slider_set(23, 1); ng_slider_set(24, 2); ng_slider_set(25, 0); );
    p == 6 ? ( ng_slider_set(1, 25); ng_slider_set(2, 0); ng_slider_set(3, 0.7); ng_slider_set(4, 4); ng_slider_set(5, 0); ng_slider_set(6, 300); ng_slider_set(7, -1); ng_slider_set(8, 0.8); ng_slider_set(9, 2); ng_slider_set(10, 0); ng_slider_set(11, 2236); ng_slider_set(12, 0); ng_slider_set(13, 1); ng_slider_set(14, 2); ng_slider_set(15, 0); ng_slider_set(16, 12000); ng_slider_set(17, 1.5); ng_slider_set(18, 0.7); ng_slider_set(19, 1); ng_slider_set(20, 0); ng_slider_set(21, 15000); ng_slider_set(22, 0); ng_slider_set(23, 1); ng_slider_set(24, 2); ng_slider_set(25, 0); );
    p == 7 ? ( ng_slider_set(1, 300); ng_slider_set(2, 0); ng_slider_set(3, 0.7); ng_slider_set(4, 4); ng_slider_set(5, 0); ng_slider_set(6, 1000); ng_slider_set(7, 3); ng_slider_set(8, 0.8); ng_slider_set(9, 2); ng_slider_set(10, 0); ng_slider_set(11, 3400); ng_slider_set(12, 0); ng_slider_set(13, 0.7); ng_slider_set(14, 3); ng_slider_set(15, 0); ng_slider_set(16, 5000); ng_slider_set(17, 0); ng_slider_set(18, 0.7); ng_slider_set(19, 3); ng_slider_set(20, 0); ng_slider_set(21, 15000); ng_slider_set(22, 0); ng_slider_set(23, 1); ng_slider_set(24, 2); ng_slider_set(25, 0); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 77) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, 2) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 548) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 1) && ng_pre_eq(slider9, 2) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 2236) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 1) && ng_pre_eq(slider14, 2) && ng_pre_eq(slider15, 0) && ng_pre_eq(slider16, 10000) && ng_pre_eq(slider17, 0) && ng_pre_eq(slider18, 1) && ng_pre_eq(slider19, 2) && ng_pre_eq(slider20, 0) && ng_pre_eq(slider21, 15000) && ng_pre_eq(slider22, 0) && ng_pre_eq(slider23, 1) && ng_pre_eq(slider24, 2) && ng_pre_eq(slider25, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 80) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0.7) && ng_pre_eq(slider4, 4) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 350) && ng_pre_eq(slider7, -2) && ng_pre_eq(slider8, 1.2) && ng_pre_eq(slider9, 2) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 3000) && ng_pre_eq(slider12, 2) && ng_pre_eq(slider13, 1) && ng_pre_eq(slider14, 2) && ng_pre_eq(slider15, 0) && ng_pre_eq(slider16, 10000) && ng_pre_eq(slider17, 2) && ng_pre_eq(slider18, 0.7) && ng_pre_eq(slider19, 1) && ng_pre_eq(slider20, 0) && ng_pre_eq(slider21, 15000) && ng_pre_eq(slider22, 0) && ng_pre_eq(slider23, 1) && ng_pre_eq(slider24, 2) && ng_pre_eq(slider25, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 60) && ng_pre_eq(slider2, 3) && ng_pre_eq(slider3, 1.2) && ng_pre_eq(slider4, 2) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 400) && ng_pre_eq(slider7, -4) && ng_pre_eq(slider8, 1.5) && ng_pre_eq(slider9, 2) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 3500) && ng_pre_eq(slider12, 3) && ng_pre_eq(slider13, 1.4) && ng_pre_eq(slider14, 2) && ng_pre_eq(slider15, 0) && ng_pre_eq(slider16, 10000) && ng_pre_eq(slider17, 0) && ng_pre_eq(slider18, 1) && ng_pre_eq(slider19, 2) && ng_pre_eq(slider20, 0) && ng_pre_eq(slider21, 15000) && ng_pre_eq(slider22, 0) && ng_pre_eq(slider23, 1) && ng_pre_eq(slider24, 2) && ng_pre_eq(slider25, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 200) && ng_pre_eq(slider2, 2) && ng_pre_eq(slider3, 1.2) && ng_pre_eq(slider4, 2) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 800) && ng_pre_eq(slider7, -3) && ng_pre_eq(slider8, 4) && ng_pre_eq(slider9, 2) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 4000) && ng_pre_eq(slider12, 2.5) && ng_pre_eq(slider13, 1) && ng_pre_eq(slider14, 2) && ng_pre_eq(slider15, 0) && ng_pre_eq(slider16, 10000) && ng_pre_eq(slider17, 1.5) && ng_pre_eq(slider18, 0.7) && ng_pre_eq(slider19, 1) && ng_pre_eq(slider20, 0) && ng_pre_eq(slider21, 15000) && ng_pre_eq(slider22, 0) && ng_pre_eq(slider23, 1) && ng_pre_eq(slider24, 2) && ng_pre_eq(slider25, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 90) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0.7) && ng_pre_eq(slider4, 4) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 300) && ng_pre_eq(slider7, -3) && ng_pre_eq(slider8, 1) && ng_pre_eq(slider9, 2) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 2500) && ng_pre_eq(slider12, 1.5) && ng_pre_eq(slider13, 1) && ng_pre_eq(slider14, 2) && ng_pre_eq(slider15, 0) && ng_pre_eq(slider16, 12000) && ng_pre_eq(slider17, 2) && ng_pre_eq(slider18, 0.7) && ng_pre_eq(slider19, 1) && ng_pre_eq(slider20, 0) && ng_pre_eq(slider21, 15000) && ng_pre_eq(slider22, 0) && ng_pre_eq(slider23, 1) && ng_pre_eq(slider24, 2) && ng_pre_eq(slider25, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 80) && ng_pre_eq(slider2, 2) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, 2) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 500) && ng_pre_eq(slider7, -2) && ng_pre_eq(slider8, 1.2) && ng_pre_eq(slider9, 2) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 1200) && ng_pre_eq(slider12, 2.5) && ng_pre_eq(slider13, 1.2) && ng_pre_eq(slider14, 2) && ng_pre_eq(slider15, 0) && ng_pre_eq(slider16, 6000) && ng_pre_eq(slider17, 0) && ng_pre_eq(slider18, 0.7) && ng_pre_eq(slider19, 3) && ng_pre_eq(slider20, 0) && ng_pre_eq(slider21, 15000) && ng_pre_eq(slider22, 0) && ng_pre_eq(slider23, 1) && ng_pre_eq(slider24, 2) && ng_pre_eq(slider25, 0) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 25) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0.7) && ng_pre_eq(slider4, 4) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 300) && ng_pre_eq(slider7, -1) && ng_pre_eq(slider8, 0.8) && ng_pre_eq(slider9, 2) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 2236) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 1) && ng_pre_eq(slider14, 2) && ng_pre_eq(slider15, 0) && ng_pre_eq(slider16, 12000) && ng_pre_eq(slider17, 1.5) && ng_pre_eq(slider18, 0.7) && ng_pre_eq(slider19, 1) && ng_pre_eq(slider20, 0) && ng_pre_eq(slider21, 15000) && ng_pre_eq(slider22, 0) && ng_pre_eq(slider23, 1) && ng_pre_eq(slider24, 2) && ng_pre_eq(slider25, 0) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 300) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0.7) && ng_pre_eq(slider4, 4) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 1000) && ng_pre_eq(slider7, 3) && ng_pre_eq(slider8, 0.8) && ng_pre_eq(slider9, 2) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 3400) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 0.7) && ng_pre_eq(slider14, 3) && ng_pre_eq(slider15, 0) && ng_pre_eq(slider16, 5000) && ng_pre_eq(slider17, 0) && ng_pre_eq(slider18, 0.7) && ng_pre_eq(slider19, 3) && ng_pre_eq(slider20, 0) && ng_pre_eq(slider21, 15000) && ng_pre_eq(slider22, 0) && ng_pre_eq(slider23, 1) && ng_pre_eq(slider24, 2) && ng_pre_eq(slider25, 0) ? m = 7;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Vocal Clarity";
    p == 2 ? s = "Kick Punch";
    p == 3 ? s = "Snare Body And Snap";
    p == 4 ? s = "Acoustic Guitar";
    p == 5 ? s = "Bass Guitar Definition";
    p == 6 ? s = "Mix Bus Air";
    p == 7 ? s = "Telephone Voice";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  PE_PRE[pe_wp] = (spl0 + spl1) * 0.5; // display only: the input for the spectrum
  l = spl0; r = spl1;
  b1.band(l, r, solo_any ? b1.solo : b1.on);
  b2.band(l, r, solo_any ? b2.solo : b2.on);
  b3.band(l, r, solo_any ? b3.solo : b3.on);
  b4.band(l, r, solo_any ? b4.solo : b4.on);
  b5.band(l, r, solo_any ? b5.solo : b5.on);
  spl0 = l; spl1 = r;
  // display only: the output for the spectrum
  PE_POST[pe_wp] = (spl0 + spl1) * 0.5;
  pe_wp = (pe_wp + 1) & 4095;

@gfx 480 342
  ng_knobs_begin("PARAMETRIC EQ", "ESSENTIALS", 480, 140, 1, 1);

  // display: the response of the bands the audio runs (-24..+24 dB), the selected band dashed,
  // a dot per band (filled = selected, hollow = bypassed or not soloed)
  ng_plot(ng_vx + 26, ng_vy + 4, ng_vw - 30, ng_vh - 20);
  // the spectrum behind it (POST, PRE or OFF: the selector at the top right)
  pe_an < 2 ? (
    pe_analyze(pe_an == 0 ? PE_POST : PE_PRE);
    pe_spectrum(ng_vw - 30);
  );
  ng_grid_freq(36);
  pe_f = pe_slider(1 + pe_tab * 5);
  pe_x = floor(ng_freq_x(pe_f)) + 0.5;
  ng_col(NG_ACCENT, 0.5);
  pe_y = ng_py;
  while (
    gfx_line(pe_x, pe_y, pe_x, min(pe_y + 3 * ng_s, ng_py + ng_ph), 0);
    pe_y += 6 * ng_s;
    pe_y < ng_py + ng_ph;
  );
  pe_zy = ng_lin_y(0, -24, 24);
  ng_col(NG_ACCENT, 0.10);
  pe_i = 0;
  loop(floor(ng_pw) + 1,
    gfx_line(ng_px + pe_i, pe_zy, ng_px + pe_i, ng_lin_y(pe_total(20 * 1000 ^ (pe_i / ng_pw)), -24, 24), 0);
    pe_i += 1;
  );
  ng_col(NG_ACCENT, 1);
  pe_i = 0;
  loop(floor(ng_pw) + 1,
    pe_y = ng_lin_y(pe_total(20 * 1000 ^ (pe_i / ng_pw)), -24, 24);
    pe_i == 0 ? ng_line_start(ng_px, pe_y) : ng_line_to(ng_px + pe_i, pe_y);
    pe_i += 1;
  );
  pe_k = 0;
  loop(5,
    pe_f = min(20000, pe_slider(1 + pe_k * 5));
    pe_x = ng_freq_x(pe_f);
    pe_y = ng_lin_y(pe_total(pe_f), -24, 24);
    pe_on = solo_any ? pe_slider(5 + pe_k * 5) == 2 : pe_slider(5 + pe_k * 5) != 1;
    pe_k == pe_tab ? (
      ng_col(NG_ACCENT, 1);
      gfx_circle(pe_x, pe_y, 4 * ng_s, 1, 1);
    ) : (
      ng_col(pe_on ? NG_ACCENT : NG_MUTED, 1);
      gfx_circle(pe_x, pe_y, 3 * ng_s, pe_on, 1);
    );
    pe_k += 1;
  );

  // the spectrum selector: a click steps POST, PRE, OFF
  pe_bx = ng_vx + ng_vw - 62; pe_by = ng_vy + 7;
  pe_hov = mouse_x >= X(pe_bx) && mouse_x < X(pe_bx + 58) && mouse_y >= Y(pe_by) && mouse_y < Y(pe_by + 14);
  ng_click && pe_hov ? pe_an = (pe_an + 1) % 3;
  ng_col(NG_BG, 0.85);
  gfx_roundrect(X(pe_bx), Y(pe_by), 58 * ng_s, 14 * ng_s, 3 * ng_s, 1);
  gfx_rect(X(pe_bx) + 1, Y(pe_by) + 1, 58 * ng_s - 1, 14 * ng_s - 1);
  ng_col(pe_hov ? 0x45433f : NG_BORDER, 1);
  gfx_roundrect(X(pe_bx), Y(pe_by), 58 * ng_s, 14 * ng_s, 3 * ng_s, 1);
  ng_font(1, 6.5, 1);
  ng_col(pe_an < 2 ? NG_TEXT : NG_MUTED, 1);
  ng_txt(pe_an == 0 ? "FFT POST" : pe_an == 1 ? "FFT PRE" : "FFT OFF", pe_bx + 29, pe_by + 7, 1, 1);

  pe_tab = ng_tabs("LOW|LOW MID|MID HIGH|HIGH|ULTRA HIGH", pe_tab);
  pe_b = pe_tab * 5;
  ng_row(5);
  pe_tab == 0 ? ng_knob_ctl(1, "FREQ", pe_freq_txt(slider1), 20, 300, 77, 1, 0) ? update();
  pe_tab == 1 ? ng_knob_ctl(6, "FREQ", pe_freq_txt(slider6), 300, 1000, 548, 1, 0) ? update();
  pe_tab == 2 ? ng_knob_ctl(11, "FREQ", pe_freq_txt(slider11), 1000, 5000, 2236, 1, 0) ? update();
  pe_tab == 3 ? ng_knob_ctl(16, "FREQ", pe_freq_txt(slider16), 5000, 20000, 10000, 1, 0) ? update();
  pe_tab == 4 ? ng_knob_ctl(21, "FREQ", pe_freq_txt(slider21), 10000, 24000, 15000, 1, 0) ? update();
  sprintf(#pe_g, "%+.1f dB", pe_slider(pe_b + 2));
  ng_knob_ctl(pe_b + 2, "GAIN", #pe_g, -18, 18, 0, 0.1, 1) ? update();
  sprintf(#pe_q, "%.1f", pe_slider(pe_b + 3));
  ng_knob_ctl(pe_b + 3, "Q", #pe_q, 0.1, 10, 1, 0.1, 0) ? update();
  ng_select_ctl(pe_b + 4, "TYPE", "L SHELF|H SHELF|PEAK|LO PASS|HI PASS|NOTCH|BAND|ALLPASS", 0) ? update();
  ng_select_ctl(pe_b + 5, "MODE", "ACTIVE|BYPASS|SOLO", 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
