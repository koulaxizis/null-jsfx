desc:NULL Spectral Blur GFX
author: Christos Koulaxizis
tags: spectral blur smear shift frequency shifter tilt spectral gate fft texture ambient sound design gui
//category: Advanced
//NULL JSFX v4.0 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:30<0,100,1>-Smear (%)
slider2:0<-2000,2000,1>-Shift (Hz)
slider3:0<-6,6,0.1>-Tilt (dB/oct)
slider4:-90<-90,0,1>-Gate (dB)
slider5:100<0,100,1>-Mix (%)
slider6:0<-24,12,0.1>-Output (dB)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // NULL Spectral Blur (../spectral_blur.jsfx) with its own interface: same audio code, plus @gfx.
  // Blurs the sound in the frequency domain (2048-point FFT, Hann windows, 4x overlap). Each
  // bin's magnitude is smoothed over time (Smear: up to 150 ms on the way up, 3 s on the way
  // down): rising bins keep their own phase, fading bins keep turning at their own speed
  // with a little random drift, so a tail grows out of the sound. Shift moves every bin up or
  // down by a fixed number of Hz (an inharmonic, metallic frequency shift), Tilt leans the
  // spectrum around 1 kHz (flat below 100 Hz and above 10 kHz, so 20 dB at most), Gate pushes
  // down the bins below it (a 1:3 expander per bin, off at -90). With Smear, Shift, Tilt and
  // Gate at zero the sound comes back unchanged, 2047 samples late; the dry signal of Mix is
  // delayed to match and the delay is reported to REAPER.
  sp_n = 2048; sp_h = sp_n / 4; sp_nb = sp_n / 2 + 1;
  sp_fft = 0;                        // 2N slots, aligned so it never crosses 65536
  sp_win = 2 * sp_n;
  sp_il = sp_win + sp_n; sp_ir = sp_il + sp_n;
  sp_ol = sp_ir + sp_n; sp_or = sp_ol + sp_n;
  sp_sl = sp_or + sp_n; sp_sr = sp_sl + sp_nb;
  sp_pl = sp_sr + sp_nb; sp_pr = sp_pl + sp_nb;
  sp_mi = sp_pr + sp_nb; sp_pi = sp_mi + sp_nb;
  sp_tg = sp_pi + sp_nb;
  freembuf(sp_tg + sp_nb);
  memset(sp_win, 0, sp_tg + sp_nb - sp_win);
  sp_i = 0;
  loop(sp_n, sp_win[sp_i] = 0.5 - 0.5 * cos(2 * $pi * sp_i / sp_n); sp_i += 1);
  // Park-Miller generator in exact double arithmetic (0 < value < 1), so every CPU and the
  // VST3/CLAP version drift the same way
  sp_seed = 12345;
  function sp_rand()
  (
    sp_seed *= 16807; sp_seed -= floor(sp_seed / 2147483647) * 2147483647;
    sp_seed / 2147483647;
  );
  sp_ip = 0; sp_op = 0; sp_cnt = 0;
  sp_rq = 0;                         // shift rotation in quarter turns (H = N/4)
  pdc_bot_ch = 0;
  pdc_top_ch = 2;
  pdc_delay = sp_n - 1;

  // one frame of one channel: analyse the last N samples, blur, shift, tilt, gate, overlap-add
  function sp_frame(inb, smb, phb, outb) local(i, j, re, im, m, p, s, r, g)
  (
    i = 0;
    loop(sp_n,
      sp_fft[2 * i] = inb[(sp_ip + i) % sp_n] * sp_win[i];
      sp_fft[2 * i + 1] = 0;
      i += 1;
    );
    fft(sp_fft, sp_n);
    fft_permute(sp_fft, sp_n);
    i = 0;
    loop(sp_nb,
      re = sp_fft[2 * i]; im = sp_fft[2 * i + 1];
      sp_mi[i] = sqrt(re * re + im * im);
      sp_pi[i] = atan2(im, re);
      i += 1;
    );
    i = 0;
    loop(sp_nb,
      j = i - sp_sb;
      j >= 0 && j < sp_nb ? (
        m = sp_mi[j] * sp_tg[i];
        p = sp_pi[j] + sp_rq * 0.5 * $pi;
      ) : (
        m = 0;
        p = 0;
      );
      s = smb[i];
      s += (m - s) * (m > s ? sp_sa : sp_sc);
      smb[i] = s;
      r = sp_rand() * 2 - 1;
      m < 0.5 * s ? p = phb[i] + 2 * $pi * i * sp_h / sp_n + r * 0.5 * $pi;
      p -= floor(p / (2 * $pi)) * 2 * $pi;
      phb[i] = p;
      g = s < sp_gl ? s * (s / sp_gl) * (s / sp_gl) : s;
      sp_fft[2 * i] = g * cos(p);
      sp_fft[2 * i + 1] = g * sin(p);
      i > 0 && i < sp_n / 2 ? (
        sp_fft[2 * (sp_n - i)] = g * cos(p);
        sp_fft[2 * (sp_n - i) + 1] = -g * sin(p);
      );
      i += 1;
    );
    sp_fft[1] = 0; sp_fft[sp_n + 1] = 0;
    fft_ipermute(sp_fft, sp_n);
    ifft(sp_fft, sp_n);
    i = 0;
    loop(sp_n,
      // synthesis window: Hann squared overlap-adds to 1.5 at 4x
      outb[(sp_op + i) % sp_n] += sp_fft[2 * i] * sp_win[i] / (sp_n * 1.5);
      i += 1;
    );
  );
  gfx_ext_retina = 1;

  function update()
  (
    sp_s = slider1 / 100;
    sp_sa = 1 - exp(-sp_h / max(1, 0.15 * sp_s * sp_s * srate));
    sp_sc = 1 - exp(-sp_h / max(1, 3 * sp_s * sp_s * srate));
    sp_sb = floor(slider2 * sp_n / srate + 0.5);
    sp_te = slider3 / (20 * log10(2));
    sp_i = 0;
    loop(sp_nb,
      sp_tg[sp_i] = (min(10000, max(100, sp_i * srate / sp_n)) / 1000) ^ sp_te;
      sp_i += 1;
    );
    sp_gl = slider4 <= -90 ? 0 : 10 ^ (slider4 / 20) * sp_n / 4;
    sp_mix = slider5 / 100;
    sp_out = 10 ^ (slider6 / 20);
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 13;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1); ng_hist_add(2); ng_hist_add(3); ng_hist_add(4); ng_hist_add(5); ng_hist_add(6);
  ng_hist_init();

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 30); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, -90); ng_slider_set(5, 100); ng_slider_set(6, 0); );
    p == 1 ? ( ng_slider_set(1, 20); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, -90); ng_slider_set(5, 100); ng_slider_set(6, 0); );
    p == 2 ? ( ng_slider_set(1, 60); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, -90); ng_slider_set(5, 50); ng_slider_set(6, 1.5); );
    p == 3 ? ( ng_slider_set(1, 100); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, -90); ng_slider_set(5, 60); ng_slider_set(6, 2); );
    p == 4 ? ( ng_slider_set(1, 85); ng_slider_set(2, 0); ng_slider_set(3, -1); ng_slider_set(4, -90); ng_slider_set(5, 70); ng_slider_set(6, -1.5); );
    p == 5 ? ( ng_slider_set(1, 10); ng_slider_set(2, 150); ng_slider_set(3, 0); ng_slider_set(4, -90); ng_slider_set(5, 100); ng_slider_set(6, 1.5); );
    p == 6 ? ( ng_slider_set(1, 0); ng_slider_set(2, -100); ng_slider_set(3, 0); ng_slider_set(4, -90); ng_slider_set(5, 100); ng_slider_set(6, 6); );
    p == 7 ? ( ng_slider_set(1, 70); ng_slider_set(2, 400); ng_slider_set(3, 1); ng_slider_set(4, -90); ng_slider_set(5, 40); ng_slider_set(6, 4.5); );
    p == 8 ? ( ng_slider_set(1, 50); ng_slider_set(2, 0); ng_slider_set(3, -1.5); ng_slider_set(4, -90); ng_slider_set(5, 100); ng_slider_set(6, -5); );
    p == 9 ? ( ng_slider_set(1, 40); ng_slider_set(2, 0); ng_slider_set(3, 1.5); ng_slider_set(4, -90); ng_slider_set(5, 100); ng_slider_set(6, 4.5); );
    p == 10 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, -45); ng_slider_set(5, 100); ng_slider_set(6, 2); );
    p == 11 ? ( ng_slider_set(1, 30); ng_slider_set(2, 0); ng_slider_set(3, 1.5); ng_slider_set(4, -50); ng_slider_set(5, 100); ng_slider_set(6, 5); );
    p == 12 ? ( ng_slider_set(1, 100); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, -60); ng_slider_set(5, 100); ng_slider_set(6, 1); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 30) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, -90) && ng_pre_eq(slider5, 100) && ng_pre_eq(slider6, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 20) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, -90) && ng_pre_eq(slider5, 100) && ng_pre_eq(slider6, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 60) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, -90) && ng_pre_eq(slider5, 50) && ng_pre_eq(slider6, 1.5) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 100) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, -90) && ng_pre_eq(slider5, 60) && ng_pre_eq(slider6, 2) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 85) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, -1) && ng_pre_eq(slider4, -90) && ng_pre_eq(slider5, 70) && ng_pre_eq(slider6, -1.5) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 10) && ng_pre_eq(slider2, 150) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, -90) && ng_pre_eq(slider5, 100) && ng_pre_eq(slider6, 1.5) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, -100) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, -90) && ng_pre_eq(slider5, 100) && ng_pre_eq(slider6, 6) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 70) && ng_pre_eq(slider2, 400) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, -90) && ng_pre_eq(slider5, 40) && ng_pre_eq(slider6, 4.5) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 50) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, -1.5) && ng_pre_eq(slider4, -90) && ng_pre_eq(slider5, 100) && ng_pre_eq(slider6, -5) ? m = 8;
    m < 0 && ng_pre_eq(slider1, 40) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 1.5) && ng_pre_eq(slider4, -90) && ng_pre_eq(slider5, 100) && ng_pre_eq(slider6, 4.5) ? m = 9;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, -45) && ng_pre_eq(slider5, 100) && ng_pre_eq(slider6, 2) ? m = 10;
    m < 0 && ng_pre_eq(slider1, 30) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 1.5) && ng_pre_eq(slider4, -50) && ng_pre_eq(slider5, 100) && ng_pre_eq(slider6, 5) ? m = 11;
    m < 0 && ng_pre_eq(slider1, 100) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, -60) && ng_pre_eq(slider5, 100) && ng_pre_eq(slider6, 1) ? m = 12;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Soft Blur";
    p == 2 ? s = "Spectral Tail";
    p == 3 ? s = "Endless Wash";
    p == 4 ? s = "Ghost Pad";
    p == 5 ? s = "Metallic Shift Up";
    p == 6 ? s = "Robot Down";
    p == 7 ? s = "Shimmer Smear";
    p == 8 ? s = "Dark Blur";
    p == 9 ? s = "Airy Blur";
    p == 10 ? s = "Spectral Gate";
    p == 11 ? s = "Sparkle Gate";
    p == 12 ? s = "Frozen Noise Bed";
    s;
  );

  // the hint line under the controls: a short help text per slider (from tools/site_content.json)
  function ng_hint_text(i) local(s)
  (
    s = "";
    i == 1 ? s = "How long each frequency lingers: rising bins follow within up to 150 ms, fading bins hang on for up to 3";
    i == 2 ? s = "Moves every frequency up or down by the same number of Hz: an inharmonic, metallic frequency shift";
    i == 3 ? s = "Leans the spectrum around 1 kHz, in dB per octave (flat below 100 Hz and above 10 kHz): negative is";
    i == 4 ? s = "Pushes down every frequency bin quieter than this level (a 1:3 expander per bin); at -90 it is off";
    i == 5 ? s = "Blend with the dry signal, which is delayed to match";
    i == 6 ? s = "Output level";
    s;
  );

  function ng_presets() local(i)
  (
    ng_hint_i > 0 && !ng_pre_open ? ng_hint(ng_hint_text(ng_hint_i));
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  sp_il[sp_ip] = spl0;
  sp_ir[sp_ip] = spl1;
  sp_ip += 1; sp_ip >= sp_n ? sp_ip = 0;
  sp_dl = sp_il[sp_ip];
  sp_dr = sp_ir[sp_ip];
  sp_cnt += 1;
  sp_cnt >= sp_h ? (
    sp_cnt = 0;
    sp_frame(sp_il, sp_sl, sp_pl, sp_ol);
    sp_frame(sp_ir, sp_sr, sp_pr, sp_or);
    sp_rq += sp_sb; sp_rq -= floor(sp_rq / 4) * 4;
  );
  sp_wl = sp_ol[sp_op]; sp_ol[sp_op] = 0;
  sp_wr = sp_or[sp_op]; sp_or[sp_op] = 0;
  sp_op += 1; sp_op >= sp_n ? sp_op = 0;
  spl0 = (sp_dl + (sp_wl - sp_dl) * sp_mix) * sp_out;
  spl1 = (sp_dr + (sp_wr - sp_dr) * sp_mix) * sp_out;

@gfx 480 294
  ng_knobs_begin("SPECTRAL BLUR", "ADVANCED", 480, 120, 1, 0);

  // display: the blurred spectrum (average of both channels, 0 dB = a full-scale sine, down
  // to -84 dB) on a log-frequency axis, with the Gate threshold as a line while it is on
  ng_plot(ng_vx + 26, ng_vy + 4, ng_vw - 30, ng_vh - 20);
  ng_grid(1, 4, 0);
  ng_font(4, 8, 0);
  ng_col(NG_MUTED, 1);
  ng_ptxt("0", ng_px - 6 * ng_s, ng_py, 2);
  ng_ptxt("-42", ng_px - 6 * ng_s, ng_py + ng_ph / 2, 2);
  ng_ptxt("-84", ng_px - 6 * ng_s, ng_py + ng_ph, 2);
  ng_ptxt("100", ng_freq_x(100), ng_py + ng_ph + 10 * ng_s, 1);
  ng_ptxt("1k", ng_freq_x(1000), ng_py + ng_ph + 10 * ng_s, 1);
  ng_ptxt("10k", ng_freq_x(10000), ng_py + ng_ph + 10 * ng_s, 1);
  slider4 > -90 ? (
    ng_col(NG_MUTED, 0.6);
    sp_gy = ng_lin_y(slider4, -84, 0);
    gfx_line(ng_px, sp_gy, ng_px + ng_pw, sp_gy);
  );
  ng_col(NG_ACCENT, 1);
  sp_j = 0;
  loop(201,
    sp_b0 = min(sp_nb - 1, floor(20 * 1000 ^ (sp_j / 200) * sp_n / srate));
    sp_b1 = max(sp_b0, min(sp_nb - 1, floor(20 * 1000 ^ ((sp_j + 1) / 200) * sp_n / srate)));
    sp_m = 0;
    sp_b = sp_b0;
    loop(sp_b1 - sp_b0 + 1, sp_m = max(sp_m, (sp_sl[sp_b] + sp_sr[sp_b]) / 2); sp_b += 1;);
    sp_y = ng_lin_y(20 * log10(max(sp_m / (sp_n / 4), 0.0000001)), -84, 0);
    sp_j == 0 ? ng_line_start(ng_px, sp_y) : ng_line_to(ng_px + ng_pw * sp_j / 200, sp_y);
    sp_j += 1;
  );

  ng_row(6);
  sprintf(#v1, "%d%%", slider1);
  ng_knob_ctl(1, "SMEAR", #v1, 0, 100, 30, 1, 0) ? update();
  sprintf(#v2, "%+d Hz", slider2);
  ng_knob_ctl(2, "SHIFT", #v2, -2000, 2000, 0, 1, 0) ? update();
  sprintf(#v3, "%+.1f dB/oct", slider3);
  ng_knob_ctl(3, "TILT", #v3, -6, 6, 0, 0.1, 0) ? update();
  slider4 <= -90 ? strcpy(#v4, "OFF") : sprintf(#v4, "%d dB", slider4);
  ng_knob_ctl(4, "GATE", #v4, -90, 0, -90, 1, 0) ? update();
  sprintf(#v5, "%d%%", slider5);
  ng_knob_ctl(5, "MIX", #v5, 0, 100, 100, 1, 0) ? update();
  sprintf(#v6, "%.1f dB", slider6);
  ng_knob_ctl(6, "OUTPUT", #v6, -24, 12, 0, 0.1, 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
