desc:NULL Air GFX
author: Christos Koulaxizis
tags: eq air high shelf top end sheen brightness presence open gui
//category: One Slider
//NULL JSFX v2.9 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:0<0,100,1>-Amount

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // NULL Air (../air.jsfx) with its own interface: same audio code, plus @gfx.
  // A broad high shelf for the very top of the spectrum. At 100 it lifts 9 dB, and its
  // corner moves from 16 kHz down to 10 kHz as the amount grows, so small amounts only
  // open the top octave. The shelf slope is 0.5 (gentler than a standard shelf), so it
  // never peaks and leaves the 2-5 kHz presence region alone. At 0 it is flat.
  xl1 = xl2 = yl1 = yl2 = 0;
  xr1 = xr2 = yr1 = yr2 = 0;
  gfx_ext_retina = 1;

  function update()
  (
    t = slider1 / 100;
    f = min(16000 - 6000 * t, 0.45 * srate);
    gdb = 9 * t;
    A = 10 ^ (gdb / 40);
    w = 2 * $pi * f / srate;
    cw = cos(w);
    sa = sqrt(A) * sin(w) * sqrt((A + 1 / A) * (1 / 0.5 - 1) + 2);
    a0 = (A + 1) - (A - 1) * cw + sa;
    b0 = A * ((A + 1) + (A - 1) * cw + sa) / a0;
    b1 = -2 * A * ((A - 1) + (A + 1) * cw) / a0;
    b2 = A * ((A + 1) + (A - 1) * cw - sa) / a0;
    a1 = 2 * ((A - 1) - (A + 1) * cw) / a0;
    a2 = ((A + 1) - (A - 1) * cw - sa) / a0;
  );

  // the shelf's response in dB at frequency f (the biquad of @sample)
  function air_db(f) local(w, c1, s1, c2, s2, nr, ni, dr, di)
  (
    w = 2 * $pi * min(f, srate * 0.499) / srate;
    c1 = cos(w); s1 = sin(w);
    c2 = cos(2 * w); s2 = sin(2 * w);
    nr = b0 + b1 * c1 + b2 * c2;
    ni = -(b1 * s1 + b2 * s2);
    dr = 1 + a1 * c1 + a2 * c2;
    di = -(a1 * s1 + a2 * s2);
    10 * log10(max((nr * nr + ni * ni) / max(dr * dr + di * di, 0.0000000001), 0.0000000001));
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 6;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1);
  ng_hist_init();

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 0); );
    p == 1 ? ( ng_slider_set(1, 15); );
    p == 2 ? ( ng_slider_set(1, 25); );
    p == 3 ? ( ng_slider_set(1, 45); );
    p == 4 ? ( ng_slider_set(1, 60); );
    p == 5 ? ( ng_slider_set(1, 100); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 15) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 25) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 45) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 60) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 100) ? m = 5;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Open Mix";
    p == 2 ? s = "Gentle Sheen";
    p == 3 ? s = "Vocal Air";
    p == 4 ? s = "Bright Acoustic";
    p == 5 ? s = "Maximum Air";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  yl = b0 * spl0 + b1 * xl1 + b2 * xl2 - a1 * yl1 - a2 * yl2;
  xl2 = xl1; xl1 = spl0;
  yl2 = yl1; yl1 = yl;
  yr = b0 * spl1 + b1 * xr1 + b2 * xr2 - a1 * yr1 - a2 * yr2;
  xr2 = xr1; xr1 = spl1;
  yr2 = yr1; yr1 = yr;
  spl0 = yl;
  spl1 = yr;

@gfx 360 240
  ng_one_slider_begin("AIR");

  // display: the shelf's magnitude response, its corner dashed
  ng_plot(46, 64, 284, 78);
  ng_grid_freq(12);
  xx = floor(ng_freq_x(f)) + 0.5;
  ng_col(NG_ACCENT, 0.5);
  yy = ng_py;
  while(
    gfx_line(xx, yy, xx, min(yy + 3 * ng_s, ng_py + ng_ph), 0);
    yy += 6 * ng_s;
    yy < ng_py + ng_ph;
  );
  zy = ng_lin_y(0, -2, 10);
  ng_col(NG_ACCENT, 0.10);
  i = 0;
  loop(floor(ng_pw) + 1,
    gfx_line(ng_px + i, zy, ng_px + i, ng_lin_y(air_db(20 * 1000 ^ (i / ng_pw)), -2, 10), 0);
    i += 1;
  );
  ng_col(NG_ACCENT, 1);
  i = 0;
  loop(floor(ng_pw) + 1,
    yy = ng_lin_y(air_db(20 * 1000 ^ (i / ng_pw)), -2, 10);
    i == 0 ? ng_line_start(ng_px, yy) : ng_line_to(ng_px + i, yy);
    i += 1;
  );

  // slider card
  slider1 == 0 ? sprintf(#cap, "FLAT") : sprintf(#cap, "+%.1f dB ABOVE %.1f kHz", gdb, f / 1000);
  sprintf(#val, "%d", floor(slider1 + 0.5));
  ng_set_slider(ng_one_slider_control("AMOUNT", #cap, #val, "FLAT", "AIRY", slider1, 0, 100, 0, 0), 1) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
