desc:NULL Draw EQ GFX
author: Christos Koulaxizis
tags: equalizer eq draw drawable curve graphic 10-band smooth tone shaping mixing mastering gui
//category: Essentials
//NULL JSFX v2.6.1 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:0<-18,18,0.1>-31 Hz (dB)
slider2:0<-18,18,0.1>-63 Hz (dB)
slider3:0<-18,18,0.1>-125 Hz (dB)
slider4:0<-18,18,0.1>-250 Hz (dB)
slider5:0<-18,18,0.1>-500 Hz (dB)
slider6:0<-18,18,0.1>-1 kHz (dB)
slider7:0<-18,18,0.1>-2 kHz (dB)
slider8:0<-18,18,0.1>-4 kHz (dB)
slider9:0<-18,18,0.1>-8 kHz (dB)
slider10:0<-18,18,0.1>-16 kHz (dB)
slider11:50<0,100,1>-Smoothness (%)
slider12:0<-18,18,0.1>-Output (dB)
slider13:100<0,100,1>-Mix (%)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // NULL Draw EQ (../draw_eq.jsfx) with its own interface: same audio code, plus @gfx.
  // An EQ you draw: ten points at fixed octave-spaced frequencies (31.25 Hz .. 16 kHz), each
  // a gain of -18..+18 dB. The curve through them is a cascade of ten peaking filters, one per
  // point, whose gains are solved so the response passes through every point: a linear model
  // of how each filter reaches the other points (the response of a 12 dB filter, scaled), a
  // solve, then two corrections with the true response. Between the points the filters
  // overlap smoothly; Smoothness widens them (Q 1.5 .. 0.6), so the curve flows rather than
  // bumps from point to point. A point at or above 45% of the sample rate is left out. With
  // every point at 0 dB the filters are bypassed and the plugin is transparent. Mix blends
  // with the dry signal, Output sets the level. Zero latency.
  NB = 10;
  FQ = 0;     // point frequencies (10)
  GB = 16;    // filter gains in dB (10)
  CO = 32;    // coefficients, 5 per filter: b0 b1 b2 a1 a2 (50)
  ST = 96;    // filter states, 8 per filter: x1 x2 y1 y2 left, then right (80)
  MT = 192;   // interaction matrix, row = point, column = filter, stride 10 (100)
  WM = 320;   // solver work matrix (100)
  RH = 448;   // right-hand side (10)
  SX = 464;   // solution (10)
  TG = 480;   // targets (10)
  ER = 496;   // error at the points (10)
  i = 0;
  loop(NB, FQ[i] = 1000 * 2 ^ (i - 5); i += 1;);
  memset(ST, 0, 80);

  // peaking filter (RBJ) at f Hz, g dB, quality q into de_b0 .. de_a2
  function de_design(f, g, q) local(w, c, s, al, A, a0)
  (
    w = 2 * $pi * f / srate;
    c = cos(w); s = sin(w);
    al = s / (2 * q);
    A = 10 ^ (g / 40);
    a0 = 1 + al / A;
    de_b0 = (1 + al * A) / a0;
    de_b1 = -2 * c / a0;
    de_b2 = (1 - al * A) / a0;
    de_a1 = -2 * c / a0;
    de_a2 = (1 - al / A) / a0;
  );

  // magnitude in dB of the filter in de_b0 .. de_a2 at f Hz
  function de_db(f) local(w, c1, s1, c2, s2, nr, ni, dr, di)
  (
    w = 2 * $pi * f / srate;
    c1 = cos(w); s1 = sin(w); c2 = cos(2 * w); s2 = sin(2 * w);
    nr = de_b0 + de_b1 * c1 + de_b2 * c2; ni = -(de_b1 * s1 + de_b2 * s2);
    dr = 1 + de_a1 * c1 + de_a2 * c2; di = -(de_a1 * s1 + de_a2 * s2);
    10 * log10(max(nr * nr + ni * ni, 0.00000000000000000001) / max(dr * dr + di * di, 0.00000000000000000001));
  );

  // solves MT x = RH for the first n points and filters (Gaussian elimination with partial
  // pivoting) into SX; RH is used up
  function de_solve(n) local(i, j, k, p, mx, t, f)
  (
    i = 0;
    loop(100, WM[i] = MT[i]; i += 1;);
    k = 0;
    loop(n,
      p = k;
      mx = abs(WM[k * 10 + k]);
      i = k + 1;
      loop(n - k - 1,
        abs(WM[i * 10 + k]) > mx ? ( mx = abs(WM[i * 10 + k]); p = i; );
        i += 1;
      );
      p > k ? (
        j = 0;
        loop(n,
          t = WM[k * 10 + j]; WM[k * 10 + j] = WM[p * 10 + j]; WM[p * 10 + j] = t;
          j += 1;
        );
        t = RH[k]; RH[k] = RH[p]; RH[p] = t;
      );
      i = k + 1;
      loop(n - k - 1,
        f = WM[i * 10 + k] / WM[k * 10 + k];
        j = k;
        loop(n - k, WM[i * 10 + j] -= f * WM[k * 10 + j]; j += 1;);
        RH[i] -= f * RH[k];
        i += 1;
      );
      k += 1;
    );
    i = n - 1;
    loop(n,
      t = RH[i];
      j = i + 1;
      loop(n - i - 1, t -= WM[i * 10 + j] * SX[j]; j += 1;);
      SX[i] = t / WM[i * 10 + i];
      i -= 1;
    );
  );

  // ER = TG minus the response of the filters with the gains in GB, at the points
  function de_error(n) local(i, j)
  (
    i = 0;
    loop(n, ER[i] = TG[i]; i += 1;);
    j = 0;
    loop(n,
      de_design(FQ[j], GB[j], de_q);
      i = 0;
      loop(n, ER[i] -= de_db(FQ[i]); i += 1;);
      j += 1;
    );
  );

  function update()
  (
    TG[0] = slider1; TG[1] = slider2; TG[2] = slider3; TG[3] = slider4; TG[4] = slider5;
    TG[5] = slider6; TG[6] = slider7; TG[7] = slider8; TG[8] = slider9; TG[9] = slider10;
    de_q = 1.5 * 0.4 ^ (slider11 / 100);
    de_n = 0;
    loop(NB, FQ[de_n] < srate * 0.45 ? de_n += 1;);
    de_flat = 1;
    de_i = 0;
    loop(de_n, TG[de_i] != 0 ? de_flat = 0; de_i += 1;);
    de_flat ? (
      memset(GB, 0, NB);
      memset(ST, 0, 80);
    ) : (
      // how filter j at +12 dB reaches point i, per dB of gain
      de_j = 0;
      loop(de_n,
        de_design(FQ[de_j], 12, de_q);
        de_i = 0;
        loop(de_n, MT[de_i * 10 + de_j] = de_db(FQ[de_i]) / 12; de_i += 1;);
        de_j += 1;
      );
      de_i = 0;
      loop(de_n, RH[de_i] = TG[de_i]; de_i += 1;);
      de_solve(de_n);
      de_i = 0;
      loop(de_n, GB[de_i] = max(-30, min(30, SX[de_i])); de_i += 1;);
      loop(2,
        de_error(de_n);
        de_i = 0;
        loop(de_n, RH[de_i] = ER[de_i]; de_i += 1;);
        de_solve(de_n);
        de_i = 0;
        loop(de_n, GB[de_i] = max(-30, min(30, GB[de_i] + SX[de_i])); de_i += 1;);
      );
      de_j = 0;
      loop(de_n,
        de_design(FQ[de_j], GB[de_j], de_q);
        CO[de_j * 5] = de_b0; CO[de_j * 5 + 1] = de_b1; CO[de_j * 5 + 2] = de_b2;
        CO[de_j * 5 + 3] = de_a1; CO[de_j * 5 + 4] = de_a2;
        de_j += 1;
      );
    );
    de_out = 10 ^ (slider12 / 20);
    de_mix = slider13 / 100;
  );

  // ---- display only (never changes the audio) ----
  // spectrum of the output behind the curve: @sample writes the mono output into a ring, @gfx
  // takes the last 4096 samples, a Hann window and an FFT each frame; each bin's power
  // (0 dB = a full-scale sine) rises at once and falls over 300 ms
  DG_RING = 1024;    // 4096
  DG_BUF = 8192;     // FFT buffer, 8192 (does not cross a 65536 boundary)
  DG_WIN = 16384;    // Hann window, 4096
  DG_SP = 20480;     // smoothed power, 2049
  memset(DG_RING, 0, 4096);
  memset(DG_SP, 0, 2049);
  dg_i = 0;
  loop(4096, DG_WIN[dg_i] = 0.5 - 0.5 * cos(2 * $pi * dg_i / 4096); dg_i += 1;);
  dg_wp = 0;

  function dg_analyze() local(i, p, k, re, im, pw, s, dt, rc)
  (
    dt = max(0, min(0.5, ng_now - dg_last));
    dg_last = ng_now;
    rc = exp(-dt / 0.3);
    p = dg_wp;
    i = 0;
    loop(4096,
      DG_BUF[2 * i] = DG_RING[p] * DG_WIN[i];
      DG_BUF[2 * i + 1] = 0;
      p = (p + 1) & 4095;
      i += 1;
    );
    fft(DG_BUF, 4096);
    fft_permute(DG_BUF, 4096);
    k = 0;
    loop(2049,
      re = DG_BUF[2 * k];
      im = DG_BUF[2 * k + 1];
      pw = (re * re + im * im) * 16 / (4096 * 4096);
      s = DG_SP[k];
      DG_SP[k] = pw > s ? pw : s * rc + pw * (1 - rc);
      k += 1;
    );
  );

  // the spectrum in the plot: per design unit the loudest bin under it (or the nearest two
  // interpolated), tilted 4.5 dB/oct around 1 kHz, -90..0 dB over the plot height
  function dg_spectrum(cols) local(c, f0, f1, k0, k1, a, b, p, kc, ci, db, y, xl, xr)
  (
    c = 0;
    loop(cols,
      f0 = 20 * 1000 ^ (c / cols);
      f1 = 20 * 1000 ^ ((c + 1) / cols);
      k0 = f0 * 4096 / srate;
      k1 = min(2048, f1 * 4096 / srate);
      a = ceil(k0);
      b = floor(k1);
      a <= b ? (
        p = 0;
        while (a <= b) ( p = max(p, DG_SP[a]); a += 1; );
      ) : (
        kc = min(2047, (k0 + k1) / 2);
        ci = floor(kc);
        p = DG_SP[ci] + (DG_SP[ci + 1] - DG_SP[ci]) * (kc - ci);
      );
      db = 10 * log10(p + 0.00000000000000000001) + 4.5 * log(sqrt(f0 * f1) / 1000) / log(2);
      y = ng_lin_y(db, -90, 0);
      xl = floor(ng_px + ng_pw * c / cols);
      xr = floor(ng_px + ng_pw * (c + 1) / cols);
      ng_col(NG_MUTED, 0.13);
      y < ng_py + ng_ph ? gfx_rect(xl, y, max(1, xr - xl), ng_py + ng_ph - y);
      ng_col(NG_MUTED, 0.45);
      c > 0 ? gfx_line(dg_lx, dg_ly, ng_px + ng_pw * (c + 0.5) / cols, y, 1);
      dg_lx = ng_px + ng_pw * (c + 0.5) / cols;
      dg_ly = y;
      c += 1;
    );
  );

  // the whole bank at f Hz in dB (as the audio runs it), with display-only variables
  function dg_total(f) local(j, c, w, c1, s1, c2, s2, nr, ni, dr, di, s)
  (
    s = 0;
    !de_flat ? (
      w = 2 * $pi * min(f, srate * 0.4999) / srate;
      c1 = cos(w); s1 = sin(w); c2 = cos(2 * w); s2 = sin(2 * w);
      j = 0;
      loop(de_n,
        c = CO + j * 5;
        nr = c[0] + c[1] * c1 + c[2] * c2; ni = -(c[1] * s1 + c[2] * s2);
        dr = 1 + c[3] * c1 + c[4] * c2; di = -(c[3] * s1 + c[4] * s2);
        s += 10 * log10(max(nr * nr + ni * ni, 0.00000000000000000001) / max(dr * dr + di * di, 0.00000000000000000001));
        j += 1;
      );
    );
    s;
  );

  // point k's slider value and name
  function dg_gain(k)
  (
    k == 0 ? slider1 : k == 1 ? slider2 : k == 2 ? slider3 : k == 3 ? slider4 : k == 4 ? slider5 :
    k == 5 ? slider6 : k == 6 ? slider7 : k == 7 ? slider8 : k == 8 ? slider9 : slider10;
  );
  function dg_name(k)
  (
    k == 0 ? "31 Hz" : k == 1 ? "63 Hz" : k == 2 ? "125 Hz" : k == 3 ? "250 Hz" : k == 4 ? "500 Hz" :
    k == 5 ? "1 kHz" : k == 6 ? "2 kHz" : k == 7 ? "4 kHz" : k == 8 ? "8 kHz" : "16 kHz";
  );
  // the plot in design units: x of point k, dB of a design y
  DG_PX = 50; DG_PY = 66; DG_PW = 402; DG_PH = 184;
  function dg_x(k) ( DG_PX + DG_PW * log(FQ[k] / 20) / log(1000); );
  function dg_db_at(y) ( max(-18, min(18, floor((24 - 48 * (y - DG_PY) / DG_PH) * 10 + 0.5) / 10)); );
  // the point nearest to design x
  function dg_near(x) local(k, best, d, i)
  (
    k = 0; best = 10000; i = 0;
    loop(10, d = abs(x - dg_x(i)); d < best ? ( best = d; k = i; ); i += 1;);
    k;
  );
  dg_drag = 0;
  dg_last = 0;
  dg_lastk = -1;
  dg_lastc = 0;

  gfx_ext_retina = 1;

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 15;

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); ng_slider_set(10, 0); ng_slider_set(11, 50); ng_slider_set(12, 0); ng_slider_set(13, 100); );
    p == 1 ? ( ng_slider_set(1, 4); ng_slider_set(2, 3); ng_slider_set(3, 1); ng_slider_set(4, -0.5); ng_slider_set(5, -1.5); ng_slider_set(6, -1.5); ng_slider_set(7, -0.5); ng_slider_set(8, 1); ng_slider_set(9, 3); ng_slider_set(10, 4); ng_slider_set(11, 50); ng_slider_set(12, 0); ng_slider_set(13, 100); );
    p == 2 ? ( ng_slider_set(1, 3); ng_slider_set(2, 2.5); ng_slider_set(3, 2); ng_slider_set(4, 1.5); ng_slider_set(5, 0.5); ng_slider_set(6, 0); ng_slider_set(7, -0.5); ng_slider_set(8, -1.5); ng_slider_set(9, -2.5); ng_slider_set(10, -3); ng_slider_set(11, 50); ng_slider_set(12, 0); ng_slider_set(13, 100); );
    p == 3 ? ( ng_slider_set(1, -3); ng_slider_set(2, -2.5); ng_slider_set(3, -2); ng_slider_set(4, -1.5); ng_slider_set(5, -0.5); ng_slider_set(6, 0); ng_slider_set(7, 0.5); ng_slider_set(8, 1.5); ng_slider_set(9, 2.5); ng_slider_set(10, 3); ng_slider_set(11, 50); ng_slider_set(12, 0); ng_slider_set(13, 100); );
    p == 4 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0.5); ng_slider_set(9, 2); ng_slider_set(10, 4.5); ng_slider_set(11, 80); ng_slider_set(12, 0); ng_slider_set(13, 100); );
    p == 5 ? ( ng_slider_set(1, 3.5); ng_slider_set(2, 4); ng_slider_set(3, 2); ng_slider_set(4, -1); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); ng_slider_set(10, 0); ng_slider_set(11, 50); ng_slider_set(12, 0); ng_slider_set(13, 100); );
    p == 6 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, -1); ng_slider_set(4, -3.5); ng_slider_set(5, -2.5); ng_slider_set(6, -0.5); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); ng_slider_set(10, 0); ng_slider_set(11, 50); ng_slider_set(12, 0); ng_slider_set(13, 100); );
    p == 7 ? ( ng_slider_set(1, 0); ng_slider_set(2, -3); ng_slider_set(3, -1.5); ng_slider_set(4, -1); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 1.5); ng_slider_set(8, 3); ng_slider_set(9, 1.5); ng_slider_set(10, 2); ng_slider_set(11, 50); ng_slider_set(12, 0); ng_slider_set(13, 100); );
    p == 8 ? ( ng_slider_set(1, -18); ng_slider_set(2, -18); ng_slider_set(3, -12); ng_slider_set(4, -4); ng_slider_set(5, 0); ng_slider_set(6, 4); ng_slider_set(7, 3); ng_slider_set(8, -6); ng_slider_set(9, -18); ng_slider_set(10, -18); ng_slider_set(11, 30); ng_slider_set(12, 0); ng_slider_set(13, 100); );
    p == 9 ? ( ng_slider_set(1, -18); ng_slider_set(2, -15); ng_slider_set(3, -8); ng_slider_set(4, -1); ng_slider_set(5, 3); ng_slider_set(6, 4); ng_slider_set(7, 1); ng_slider_set(8, -5); ng_slider_set(9, -14); ng_slider_set(10, -18); ng_slider_set(11, 50); ng_slider_set(12, 0); ng_slider_set(13, 100); );
    p == 10 ? ( ng_slider_set(1, 0); ng_slider_set(2, -6); ng_slider_set(3, 2); ng_slider_set(4, 1); ng_slider_set(5, -3); ng_slider_set(6, -4); ng_slider_set(7, -1); ng_slider_set(8, 2.5); ng_slider_set(9, 1); ng_slider_set(10, -4); ng_slider_set(11, 50); ng_slider_set(12, 0); ng_slider_set(13, 100); );
    p == 11 ? ( ng_slider_set(1, 2); ng_slider_set(2, 5); ng_slider_set(3, 1); ng_slider_set(4, -4); ng_slider_set(5, -2); ng_slider_set(6, 0); ng_slider_set(7, 1); ng_slider_set(8, 3); ng_slider_set(9, 0.5); ng_slider_set(10, 0); ng_slider_set(11, 50); ng_slider_set(12, 0); ng_slider_set(13, 100); );
    p == 12 ? ( ng_slider_set(1, 1); ng_slider_set(2, 1.5); ng_slider_set(3, 0.5); ng_slider_set(4, -0.5); ng_slider_set(5, -0.5); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0.5); ng_slider_set(9, 1); ng_slider_set(10, 1.5); ng_slider_set(11, 90); ng_slider_set(12, 0); ng_slider_set(13, 100); );
    p == 13 ? ( ng_slider_set(1, 0); ng_slider_set(2, 6); ng_slider_set(3, 3); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, -3); ng_slider_set(7, 0); ng_slider_set(8, 4); ng_slider_set(9, 6); ng_slider_set(10, 4); ng_slider_set(11, 50); ng_slider_set(12, 0); ng_slider_set(13, 40); );
    p == 14 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, -1); ng_slider_set(8, -4); ng_slider_set(9, -8); ng_slider_set(10, -12); ng_slider_set(11, 70); ng_slider_set(12, 1); ng_slider_set(13, 100); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 50) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 100) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 4) && ng_pre_eq(slider2, 3) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, -0.5) && ng_pre_eq(slider5, -1.5) && ng_pre_eq(slider6, -1.5) && ng_pre_eq(slider7, -0.5) && ng_pre_eq(slider8, 1) && ng_pre_eq(slider9, 3) && ng_pre_eq(slider10, 4) && ng_pre_eq(slider11, 50) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 100) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 3) && ng_pre_eq(slider2, 2.5) && ng_pre_eq(slider3, 2) && ng_pre_eq(slider4, 1.5) && ng_pre_eq(slider5, 0.5) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, -0.5) && ng_pre_eq(slider8, -1.5) && ng_pre_eq(slider9, -2.5) && ng_pre_eq(slider10, -3) && ng_pre_eq(slider11, 50) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 100) ? m = 2;
    m < 0 && ng_pre_eq(slider1, -3) && ng_pre_eq(slider2, -2.5) && ng_pre_eq(slider3, -2) && ng_pre_eq(slider4, -1.5) && ng_pre_eq(slider5, -0.5) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0.5) && ng_pre_eq(slider8, 1.5) && ng_pre_eq(slider9, 2.5) && ng_pre_eq(slider10, 3) && ng_pre_eq(slider11, 50) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 100) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0.5) && ng_pre_eq(slider9, 2) && ng_pre_eq(slider10, 4.5) && ng_pre_eq(slider11, 80) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 100) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 3.5) && ng_pre_eq(slider2, 4) && ng_pre_eq(slider3, 2) && ng_pre_eq(slider4, -1) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 50) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 100) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, -1) && ng_pre_eq(slider4, -3.5) && ng_pre_eq(slider5, -2.5) && ng_pre_eq(slider6, -0.5) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 50) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 100) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, -3) && ng_pre_eq(slider3, -1.5) && ng_pre_eq(slider4, -1) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 1.5) && ng_pre_eq(slider8, 3) && ng_pre_eq(slider9, 1.5) && ng_pre_eq(slider10, 2) && ng_pre_eq(slider11, 50) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 100) ? m = 7;
    m < 0 && ng_pre_eq(slider1, -18) && ng_pre_eq(slider2, -18) && ng_pre_eq(slider3, -12) && ng_pre_eq(slider4, -4) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 4) && ng_pre_eq(slider7, 3) && ng_pre_eq(slider8, -6) && ng_pre_eq(slider9, -18) && ng_pre_eq(slider10, -18) && ng_pre_eq(slider11, 30) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 100) ? m = 8;
    m < 0 && ng_pre_eq(slider1, -18) && ng_pre_eq(slider2, -15) && ng_pre_eq(slider3, -8) && ng_pre_eq(slider4, -1) && ng_pre_eq(slider5, 3) && ng_pre_eq(slider6, 4) && ng_pre_eq(slider7, 1) && ng_pre_eq(slider8, -5) && ng_pre_eq(slider9, -14) && ng_pre_eq(slider10, -18) && ng_pre_eq(slider11, 50) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 100) ? m = 9;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, -6) && ng_pre_eq(slider3, 2) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, -3) && ng_pre_eq(slider6, -4) && ng_pre_eq(slider7, -1) && ng_pre_eq(slider8, 2.5) && ng_pre_eq(slider9, 1) && ng_pre_eq(slider10, -4) && ng_pre_eq(slider11, 50) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 100) ? m = 10;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 5) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, -4) && ng_pre_eq(slider5, -2) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 1) && ng_pre_eq(slider8, 3) && ng_pre_eq(slider9, 0.5) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 50) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 100) ? m = 11;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 1.5) && ng_pre_eq(slider3, 0.5) && ng_pre_eq(slider4, -0.5) && ng_pre_eq(slider5, -0.5) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0.5) && ng_pre_eq(slider9, 1) && ng_pre_eq(slider10, 1.5) && ng_pre_eq(slider11, 90) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 100) ? m = 12;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 6) && ng_pre_eq(slider3, 3) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, -3) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 4) && ng_pre_eq(slider9, 6) && ng_pre_eq(slider10, 4) && ng_pre_eq(slider11, 50) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 40) ? m = 13;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, -1) && ng_pre_eq(slider8, -4) && ng_pre_eq(slider9, -8) && ng_pre_eq(slider10, -12) && ng_pre_eq(slider11, 70) && ng_pre_eq(slider12, 1) && ng_pre_eq(slider13, 100) ? m = 14;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Smile";
    p == 2 ? s = "Warm Tilt";
    p == 3 ? s = "Bright Tilt";
    p == 4 ? s = "Air Lift";
    p == 5 ? s = "Low End Weight";
    p == 6 ? s = "Mud Cut";
    p == 7 ? s = "Vocal Presence";
    p == 8 ? s = "Telephone";
    p == 9 ? s = "Old Radio";
    p == 10 ? s = "Scooped Guitar";
    p == 11 ? s = "Kick Shape";
    p == 12 ? s = "Master Polish";
    p == 13 ? s = "Parallel Color";
    p == 14 ? s = "Dark Room";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  de_l = spl0; de_r = spl1;
  !de_flat ? (
    de_c = CO; de_s = ST;
    loop(de_n,
      de_y = de_c[0] * de_l + de_c[1] * de_s[0] + de_c[2] * de_s[1] - de_c[3] * de_s[2] - de_c[4] * de_s[3];
      de_s[1] = de_s[0]; de_s[0] = de_l; de_s[3] = de_s[2]; de_s[2] = de_y; de_l = de_y;
      de_y = de_c[0] * de_r + de_c[1] * de_s[4] + de_c[2] * de_s[5] - de_c[3] * de_s[6] - de_c[4] * de_s[7];
      de_s[5] = de_s[4]; de_s[4] = de_r; de_s[7] = de_s[6]; de_s[6] = de_y; de_r = de_y;
      de_c += 5; de_s += 8;
    );
  );
  spl0 = (spl0 * (1 - de_mix) + de_l * de_mix) * de_out;
  spl1 = (spl1 * (1 - de_mix) + de_r * de_mix) * de_out;
  // display only: the mono output into the spectrum ring
  DG_RING[dg_wp] = (spl0 + spl1) * 0.5;
  dg_wp = (dg_wp + 1) & 4095;

@gfx 480 394
  ng_knobs_begin("DRAW EQ", "ESSENTIALS", 480, 220, 1, 0);

  // display: the output spectrum, the response of the filters (-24..+24 dB) and the ten points
  // as handles; drag across the plot to draw the curve (every point you pass takes the mouse
  // height), double-click a point to set it back to 0 dB
  dg_analyze();
  ng_plot(DG_PX, DG_PY, DG_PW, DG_PH);
  dg_spectrum(DG_PW);
  ng_grid_freq(36);
  dg_zy = ng_lin_y(0, -24, 24);
  ng_col(NG_ACCENT, 0.10);
  dg_i = 0;
  loop(floor(ng_pw) + 1,
    gfx_line(ng_px + dg_i, dg_zy, ng_px + dg_i, ng_lin_y(dg_total(20 * 1000 ^ (dg_i / ng_pw)), -24, 24), 0);
    dg_i += 1;
  );
  ng_col(NG_ACCENT, 1);
  dg_i = 0;
  loop(floor(ng_pw) + 1,
    dg_y = ng_lin_y(dg_total(20 * 1000 ^ (dg_i / ng_pw)), -24, 24);
    dg_i == 0 ? ng_line_start(ng_px, dg_y) : ng_line_to(ng_px + dg_i, dg_y);
    dg_i += 1;
  );

  // mouse
  dg_mx = (mouse_x - ng_ox) / ng_s;
  dg_my = (mouse_y - ng_oy) / ng_s;
  dg_inside = dg_mx >= DG_PX - 6 && dg_mx <= DG_PX + DG_PW + 6 && dg_my >= DG_PY - 6 && dg_my <= DG_PY + DG_PH + 6;
  dg_hover = dg_inside && !ng_pre_open ? dg_near(dg_mx) : -1;
  ng_click && dg_inside ? (
    ng_now - dg_lastc < 0.3 && dg_lastk == dg_hover ? (
      ng_slider_set(dg_hover + 1, 0);
      update();
      dg_lastc = 0;
      dg_drag = 0;
    ) : (
      dg_drag = 1;
      dg_pmx = dg_mx;
      dg_pmy = dg_my;
      dg_lastc = ng_now;
      dg_lastk = dg_hover;
    );
  );
  !ng_lmb ? dg_drag = 0;
  dg_drag ? (
    // every point between the last and this mouse position takes the height on the line between
    dg_ch = 0;
    dg_i = 0;
    loop(10,
      dg_xx = dg_x(dg_i);
      dg_xx >= min(dg_pmx, dg_mx) && dg_xx <= max(dg_pmx, dg_mx) && abs(dg_mx - dg_pmx) > 0.001 ? (
        dg_ch += ng_slider_set(dg_i + 1, dg_db_at(dg_pmy + (dg_my - dg_pmy) * (dg_xx - dg_pmx) / (dg_mx - dg_pmx)));
      );
      dg_i += 1;
    );
    dg_ch += ng_slider_set(dg_near(dg_mx) + 1, dg_db_at(dg_my));
    dg_ch ? update();
    dg_pmx = dg_mx;
    dg_pmy = dg_my;
  );

  // the points
  dg_i = 0;
  loop(10,
    dg_xx = X(dg_x(dg_i));
    dg_yy = ng_lin_y(dg_gain(dg_i), -24, 24);
    dg_on = FQ[dg_i] < srate * 0.45;
    ng_col(dg_drag && dg_near(dg_mx) == dg_i ? NG_ACCENT : NG_CARD, 1);
    gfx_circle(dg_xx, dg_yy, 4 * ng_s, 1);
    ng_col(dg_hover == dg_i ? NG_TEXT : dg_on ? NG_ACCENT : NG_MUTED, 1);
    gfx_circle(dg_xx, dg_yy, 4 * ng_s, 0);
    dg_i += 1;
  );

  // readout of the point under the mouse, and the hint
  ng_font(1, 7, 1);
  dg_hover >= 0 ? (
    ng_col(NG_TEXT, 1);
    sprintf(#dg_t, "%s  %+.1f dB", dg_name(dg_hover), dg_gain(dg_hover));
    ng_txt(#dg_t, DG_PX + 6, DG_PY + 8, 0, 0.5);
  );
  ng_font(4, 7, 0);
  ng_col(NG_MUTED, 1);
  ng_txt("Drag to draw. Double-click: 0 dB.", DG_PX + DG_PW - 6, DG_PY + 8, 2, 0);

  ng_row(3);
  sprintf(#v11, "%d%%", slider11);
  ng_knob_ctl(11, "SMOOTH", #v11, 0, 100, 50, 1, 0) ? update();
  abs(slider12) < 0.05 ? sprintf(#v12, "0.0 dB") : sprintf(#v12, "%+.1f dB", slider12);
  ng_knob_ctl(12, "OUTPUT", #v12, -18, 18, 0, 0.1, 1) ? update();
  sprintf(#v13, "%d%%", slider13);
  ng_knob_ctl(13, "MIX", #v13, 0, 100, 100, 1, 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
