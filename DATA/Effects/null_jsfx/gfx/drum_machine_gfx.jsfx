  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "808 Classic";
    p == 2 ? s = "909 Punch";
    p == 3 ? s = "House Groove";
    p == 4 ? s = "Minimal Techno";
    p == 5 ? s = "Boom Bap Dusty";
    p == 6 ? s = "Generated Breaks";
    p == 7 ? s = "Garage Shuffle";
    p == 8 ? s = "Breaks";
    p == 9 ? s = "Trap 808";
    p == 10 ? s = "Disco Night";
    p == 11 ? s = "Pop Studio";
    p == 12 ? s = "Industrial Steel";
    p == 13 ? s = "Dembow";
    p == 14 ? s = "Bossa Clave";
    p == 15 ? s = "MIDI Kit";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@serialize
  // version 1 holds the User pattern; version 2 adds the song (sections, then bars)
  ser_ver = 2;
  file_var(0, ser_ver);
  file_mem(0, 0, 170);
  ser_ver >= 2 ? file_mem(0, SONG, 16);
  ser_ver = 2;

@slider
  update();

@block
  // MIDI note-ons of this block, played at their offsets in @sample
  mq_n = 0;
  while (midirecv(m_ofs, m_1, m_2, m_3)) (
    // every message goes on to the next plugin too, so instruments can be layered
    midisend(m_ofs, m_1, m_2, m_3);
    (m_1 & 0xF0) == 0x90 && m_3 > 0 && mq_n < 128 ? (
      MQ[mq_n * 3] = m_ofs;
      MQ[mq_n * 3 + 1] = m_2;
      MQ[mq_n * 3 + 2] = m_3 / 127;
      mq_n += 1;
    );
  );
  mq_i = 0;

  // the song's sections up to the first End (none: Song Off) and its length in bars
  song_n = 0;
  song_len = 0;
  song_on ? (
    sg_i = 0;
    loop(8, SONG[sg_i] >= 1 && song_n == sg_i ? song_n += 1; sg_i += 1;);
    sg_i = 0;
    loop(song_n, SBAR[sg_i] = max(1, min(16, floor(SBAR[sg_i] + 0.5))); song_len += SBAR[sg_i]; sg_i += 1;);
  );

  // the sequencer runs while the host plays; the pattern is the User one (memory 0) or a factory
  // one, or in the song the section's (play_step picks it)
  seq_on = (play_state & 1) && (pat > 0 || song_n > 0);
  !seq_on ? ( last_s = -1000; song_k = 0; );
  pb = gen_on && pat > 0 ? GEN : pat <= 1 ? 0 : FACT + (pat - 2) * 170;
  b_inc = tempo / (60 * srate);
  b_0 = beat_position;
  flam_n = max(1, floor(0.018 * srate));
  roll_n = max(1, floor(7.5 / tempo * srate));
  si = 0;

  // a voice heard from the interface (GFX version)
  dm_preview > 0 ? ( trig(dm_preview - 1, 1); dm_preview = 0; );

@sample
  while (mq_i < mq_n && MQ[mq_i * 3] <= si) (
    note_on(MQ[mq_i * 3 + 1], MQ[mq_i * 3 + 2]);
    mq_i += 1;
  );

  // delayed hits (flam, roll)
  t = 0;
  loop(NT,
    PEND[t] > 0 ? (
      PEND[t] -= 1;
      PEND[t] < 0.5 ? trig(t, PVEL[t]);
    );
    t += 1;
  );

  // sixteenths, the odd ones moved later by Swing; a step plays when the position enters it
  seq_on ? (
    bb = b_0 + si * b_inc;
    bb >= 0 ? (
      p8 = floor(bb * 2 + 0.000001);
      s = p8 * 2 + (bb * 2 - p8 + 0.000001 >= sw ? 1 : 0);
      s != last_s ? (
        // at transport start, only when it starts on the step's beginning
        last_s > -1000 || bb - (s & 1 ? p8 + sw : p8) / 2 < 0.001 ? play_step(s);
        last_s = s;
      );
    );
  );
  dm_step = seq_on ? last_s : -1;
  si += 1;

  // white noise (Park-Miller), shared by the voices
  seed *= 16807; seed -= floor(seed / 2147483647) * 2147483647;
  nz = seed / 1073741824 - 1;
  outl = outr = 0;

  k_on ? (
    k_ph += k_f0 * (1 + k_sw * k_pe) / srate;
    k_ph -= floor(k_ph);
    y = sin(2 * $pi * k_ph) * k_env + nz * k_ce * k_cl;
    k_pe *= k_pc; k_env *= k_ac; k_ce *= k_cc;
    k_env < 0.000001 ? k_on = 0;
    y *= 0.45 * VL[0]; outl += y * VPL[0]; outr += y * VPR[0];
  );
  outs ? ( GO[0] = outl; GO[1] = outr; outl = outr = 0; );

  s_on ? (
    s_ph1 += s_f1 * (1 + 0.6 * s_pe) / srate; s_ph1 -= floor(s_ph1);
    s_ph2 += s_f2 * (1 + 0.6 * s_pe) / srate; s_ph2 -= floor(s_ph2);
    s_hp.svf(nz);
    y = (sin(2 * $pi * s_ph1) + 0.6 * sin(2 * $pi * s_ph2)) * 0.6 * s_be * s_bg + s_hp.hp * s_ne * s_ng;
    s_pe *= s_pc; s_be *= s_bc; s_ne *= s_nc;
    s_be + s_ne < 0.000001 ? s_on = 0;
    y *= 0.35 * VL[1]; outl += y * VPL[1]; outr += y * VPR[1];
  );

  c_on ? (
    c_t < 3 * c_per ? (
      c_t == 0 || c_t == c_per || c_t == 2 * c_per ? c_env = 1;
      g = c_env; c_env *= c_bc;
    ) : (
      c_t == 3 * c_per ? c_env = c_tail;
      g = c_env; c_env *= c_tc;
      c_env < 0.000001 ? c_on = 0;
    );
    c_t += 1;
    c_bp.svf(nz);
    y = c_bp.bp * g * c_vel * 1.2 * VL[2]; outl += y * VPL[2]; outr += y * VPR[2];
  );

  r_on ? (
    r_ph1 += r_d1; r_ph1 -= floor(r_ph1);
    r_ph2 += r_d2; r_ph2 -= floor(r_ph2);
    r_ph3 += r_d3; r_ph3 -= floor(r_ph3);
    y = ((1 - r_m) * (0.6 * sin(2 * $pi * r_ph1) + 0.5 * sin(2 * $pi * r_ph2) + 0.4 * nz * r_env)
         + r_m * sin(2 * $pi * r_ph3)) * r_env;
    r_env *= r_c;
    r_env < 0.000001 ? r_on = 0;
    y *= 0.24 * VL[3]; outl += y * VPL[3]; outr += y * VPR[3];
  );
  outs ? ( GO[2] = outl; GO[3] = outr; outl = outr = 0; );

  h_on ? (
    h_bp.svf((1 - h_mx) * h_m.metal() + h_mx * nz);
    h_hp.svf(h_bp.bp);
    y = h_hp.hp * h_env;
    h_env *= h_c;
    h_env < 0.000001 ? h_on = 0;
    y *= 0.68 * VL[4]; outl += y * VPL[4]; outr += y * VPR[4];
  );

  o_on ? (
    o_bp.svf((1 - o_mx) * o_m.metal() + o_mx * nz);
    o_hp.svf(o_bp.bp);
    y = o_hp.hp * o_env;
    o_env *= o_choke ? o_kc : o_c;
    o_env < 0.000001 ? o_on = 0;
    y *= 0.68 * VL[5]; outl += y * VPL[5]; outr += y * VPR[5];
  );
  outs ? ( GO[4] = outl; GO[5] = outr; outl = outr = 0; );

  lt.on ? ( y = lt.tom(nz) * 0.38 * VL[6]; outl += y * VPL[6]; outr += y * VPR[6]; );
  ht.on ? ( y = ht.tom(nz) * 0.38 * VL[7]; outl += y * VPL[7]; outr += y * VPR[7]; );

  b_on ? (
    b_bp.svf(square(b_p1, b_d1) + square(b_p2, b_d2));
    b_p1 += b_d1; b_p1 -= floor(b_p1);
    b_p2 += b_d2; b_p2 -= floor(b_p2);
    y = b_bp.bp * (b_e1 + b_e2);
    b_e1 *= b_c1; b_e2 *= b_c2;
    b_e2 < 0.000001 ? b_on = 0;
    y *= 0.13 * VL[8]; outl += y * VPL[8]; outr += y * VPR[8];
  );
  outs ? ( GO[6] = outl; GO[7] = outr; outl = outr = 0; );

  y_on ? (
    y_bp.svf((1 - y_mx) * y_m.metal() + y_mx * nz);
    y_hp.svf(y_bp.bp);
    y = y_hp.hp * y_env;
    y_env *= y_c;
    y_env < 0.000001 ? y_on = 0;
    y *= 0.6 * VL[9]; outl += y * VPL[9]; outr += y * VPR[9];
  );
  outs ? ( GO[4] += outl; GO[5] += outr; );

  outs ? (
    // Outputs Groups: each group through Drive, Grit and Volume on its own pair of pins
    grit > 0 ? ( gr_ph += gr_step; gr_t = gr_ph >= 1; gr_t ? gr_ph -= floor(gr_ph); );
    gi = 0;
    loop(8,
      u = GO[gi];
      drv > 0 ? ( u = max(-3, min(3, u * drv_g)); u = u * (27 + u * u) / (27 + 9 * u * u) / (1 + drv); );
      grit > 0 ? ( gr_t ? GH[gi] = floor(u * gr_q + 0.5) / gr_q; u = GH[gi]; );
      GO[gi] = u * vol;
      gi += 1;
    );
    spl0 = GO[0]; spl1 = GO[1]; spl2 = GO[2]; spl3 = GO[3];
    spl4 = GO[4]; spl5 = GO[5]; spl6 = GO[6]; spl7 = GO[7];
  ) : (
    // Drive: soft clipping of the whole kit
    drv > 0 ? (
      u = max(-3, min(3, outl * drv_g)); outl = u * (27 + u * u) / (27 + 9 * u * u) / (1 + drv);
      u = max(-3, min(3, outr * drv_g)); outr = u * (27 + u * u) / (27 + 9 * u * u) / (1 + drv);
    );

    // Grit: sample-and-hold at a lower rate (48 kHz down to 8 kHz) and fewer bits (15 down to 4)
    grit > 0 ? (
      gr_ph += gr_step;
      gr_ph >= 1 ? (
        gr_ph -= floor(gr_ph);
        gr_hl = floor(outl * gr_q + 0.5) / gr_q;
        gr_hr = floor(outr * gr_q + 0.5) / gr_q;
      );
      outl = gr_hl; outr = gr_hr;
    );

    spl0 = outl * vol;
    spl1 = outr * vol;
    spl2 = spl3 = spl4 = spl5 = spl6 = spl7 = 0;
  );

@gfx 640 614
  ng_knobs_begin("DRUM MACHINE", "INSTRUMENTS", 640, 240, 3, 1);
  dm_rmb = mouse_cap & 2;
  dm_rclick = dm_rmb && !dm_prmb && !ng_pre_open;
  dm_prmb = dm_rmb;

  // display: the step grid of the pattern that plays (Off shows the User pattern, which an
  // edit switches to; in the song, the section's); a click on a name selects the track and plays it
  dm_gb = song_n > 0 ? (SONG[song_k] <= 1 ? 0 : FACT + (SONG[song_k] - 2) * 170) :
          gen_on && pat > 0 ? GEN : pat <= 1 ? 0 : FACT + (pat - 2) * 170;
  ng_font(1, 7, 1);
  i = 0;
  loop(16,
    ng_col(i - floor(i / 4) * 4 == 0 ? NG_TEXT : NG_MUTED, i - floor(i / 4) * 4 == 0 ? 0.9 : 0.6);
    sprintf(#dm_n, "%d", i + 1);
    ng_txt(#dm_n, dm_cell_x(i) + 12.5, 71, 1, 0);
    i += 1;
  );
  ng_col(NG_MUTED, 0.6);
  ng_txt("STEPS", 591, 71, 1, 1);
  song_n > 0 ? (
    sprintf(#dm_n, "SONG %d", song_k + 1);
    ng_txt(#dm_n, 28, 71, 0, 1);
  ) : ng_txt(pat == 0 ? "OFF: MIDI ONLY" : gen_on ? "GENERATED" : pat == 1 ? "USER" : "FACTORY", 28, 71, 0, 1);

  t = 0;
  loop(NT,
    yy = 82 + t * 17;
    len = max(1, min(16, floor(dm_gb[160 + t] + 0.5)));
    // name: brighter while the voice sounds, a bar on the selected track
    dm_fl = max(0, min(1, HIT[t]));
    HIT[t] = HIT[t] * 0.8;
    t == dm_sel ? ( ng_col(NG_ACCENT, 1); gfx_rect(X(24), Y(yy + 2), max(2, 2 * ng_s), 11 * ng_s); );
    t == dm_sel ? ng_col(NG_TEXT, 1) : ng_mix(NG_MUTED, NG_TEXT, dm_fl, 1);
    ng_font(1, 7.5, 1);
    ng_txt(dm_name(t), 31, yy + 7.5, 0, 1);
    hover = mouse_x >= X(24) && mouse_x < X(104) && mouse_y >= Y(yy) && mouse_y < Y(yy + 15);
    hover && ng_click ? ( dm_sel = t; dm_preview = t + 1; );

    i = 0;
    loop(16,
      xx = dm_cell_x(i);
      v = floor(dm_gb[t * 16 + i] + 0.5);
      on = i < len;
      ng_col(v > 0 ? NG_ACCENT : NG_BG, (v > 0 ? (v == 1 ? 0.55 : v == 2 ? 1 : v == 5 ? 0.3 : 0.8) : 1) * (on ? 1 : 0.35));
      gfx_rect(X(xx), Y(yy), 25 * ng_s, 15 * ng_s);
      ng_col(NG_BG, on ? 1 : 0.6);
      v == 3 ? gfx_rect(X(xx + 9), Y(yy + 3), max(1, 2 * ng_s), 9 * ng_s);
      v == 4 ? ( gfx_rect(X(xx + 8), Y(yy + 6), 2 * ng_s, 3 * ng_s); gfx_rect(X(xx + 12), Y(yy + 6), 2 * ng_s, 3 * ng_s); gfx_rect(X(xx + 16), Y(yy + 6), 2 * ng_s, 3 * ng_s); );
      v == 2 ? gfx_rect(X(xx + 11), Y(yy + 6), 3 * ng_s, 3 * ng_s);
      v == 5 ? gfx_rect(X(xx + 10), Y(yy + 5), 5 * ng_s, 5 * ng_s, 0);
      hover = mouse_x >= X(xx) && mouse_x < X(xx + 25) && mouse_y >= Y(yy) && mouse_y < Y(yy + 15);
      ng_col(hover ? 0x45433f : NG_BORDER, 1);
      gfx_rect(X(xx), Y(yy), 25 * ng_s, 15 * ng_s, 0);
      // the playhead, at the track's own position
      dm_step >= 0 && on && i == dm_step - floor(dm_step / len) * len ? (
        ng_col(NG_TEXT, 1);
        gfx_rect(X(xx), Y(yy), 25 * ng_s, 15 * ng_s, 0);
        gfx_rect(X(xx) + 1, Y(yy) + 1, 25 * ng_s - 2, 15 * ng_s - 2, 0);
      );
      hover && ng_click ? dm_edit(t, i, v >= 5 ? 0 : v + 1);
      hover && dm_rclick ? dm_edit(t, i, 0);
      i += 1;
    );

    // length of the track: click the left half for one step less, the right half for one more
    hover = mouse_x >= X(566) && mouse_x < X(616) && mouse_y >= Y(yy) && mouse_y < Y(yy + 15);
    ng_col(NG_BG, 1);
    gfx_rect(X(566), Y(yy), 50 * ng_s, 15 * ng_s);
    ng_col(hover ? 0x45433f : NG_BORDER, 1);
    gfx_rect(X(566), Y(yy), 50 * ng_s, 15 * ng_s, 0);
    ng_font(3, 7.5, 0);
    ng_col(len < 16 ? NG_TEXT : NG_MUTED, 1);
    sprintf(#dm_n, "%d", len);
    ng_txt(#dm_n, 591, yy + 7.5, 1, 0);
    ng_col(NG_MUTED, 1);
    ng_arrow(572, yy + 7.5, -1);
    ng_arrow(610, yy + 7.5, 1);
    hover && ng_click ? dm_len(t, mouse_x < X(591) ? len - 1 : len + 1);
    hover && mouse_wheel != 0 ? dm_len(t, mouse_wheel > 0 ? len + 1 : len - 1);
    t += 1;
  );

  // the song: Song on or off, then 8 sections (a click on the left half steps back, on the right
  // half forward, the wheel too; a right click on a pattern ends the song there)
  hover = mouse_x >= X(24) && mouse_x < X(104) && mouse_y >= Y(262) && mouse_y < Y(294);
  ng_col(song_on ? NG_ACCENT : NG_BG, 1);
  gfx_rect(X(24), Y(262), 80 * ng_s, 32 * ng_s);
  ng_col(hover ? 0x45433f : NG_BORDER, 1);
  gfx_rect(X(24), Y(262), 80 * ng_s, 32 * ng_s, 0);
  ng_font(1, 7, 1);
  ng_col(song_on ? NG_BG : NG_MUTED, 1);
  ng_txt("SONG", 64, 271, 1, 1);
  ng_font(1, 7.5, 1);
  ng_col(song_on ? NG_BG : NG_TEXT, 1);
  ng_txt(song_on ? "ON" : "OFF", 64, 285, 1, 1);
  hover && ng_click ? ( ng_slider_set(64, !song_on); update(); );
  dm_live = 0;
  k = 0;
  loop(8,
    xx = 112 + k * 63;
    SONG[k] >= 1 && dm_live == k ? dm_live += 1;
    on = k < dm_live || k == dm_live;
    dm_p = SONG[k];
    dm_b = SBAR[k];
    ng_col(NG_BG, 1);
    gfx_rect(X(xx), Y(262), 59 * ng_s, 15 * ng_s);
    gfx_rect(X(xx), Y(279), 59 * ng_s, 15 * ng_s);
    hover = mouse_x >= X(xx) && mouse_x < X(xx + 59) && mouse_y >= Y(262) && mouse_y < Y(277);
    ng_col(hover ? 0x45433f : NG_BORDER, 1);
    gfx_rect(X(xx), Y(262), 59 * ng_s, 15 * ng_s, 0);
    hover && ng_click ? dm_song_set(k, mouse_x < X(xx + 29.5) ? dm_p - 1 : dm_p + 1, dm_b);
    hover && dm_rclick ? dm_song_set(k, 0, dm_b);
    hover && mouse_wheel != 0 ? dm_song_set(k, mouse_wheel > 0 ? dm_p + 1 : dm_p - 1, dm_b);
    hover = mouse_x >= X(xx) && mouse_x < X(xx + 59) && mouse_y >= Y(279) && mouse_y < Y(294);
    ng_col(hover ? 0x45433f : NG_BORDER, 1);
    gfx_rect(X(xx), Y(279), 59 * ng_s, 15 * ng_s, 0);
    hover && ng_click ? dm_song_set(k, dm_p, mouse_x < X(xx + 29.5) ? dm_b - 1 : dm_b + 1);
    hover && mouse_wheel != 0 ? dm_song_set(k, dm_p, mouse_wheel > 0 ? dm_b + 1 : dm_b - 1);
    // the section that plays
    song_n > 0 && dm_step >= 0 && k == song_k ? (
      ng_col(NG_TEXT, 1);
      gfx_rect(X(xx), Y(262), 59 * ng_s, 15 * ng_s, 0);
      gfx_rect(X(xx) + 1, Y(262) + 1, 59 * ng_s - 2, 15 * ng_s - 2, 0);
    );
    ng_font(1, 6.5, 1);
    ng_col(dm_p >= 1 ? NG_TEXT : NG_MUTED, on ? 1 : 0.35);
    ng_txt(dm_pat_name(dm_p), xx + 29.5, 269.5, 1, 0.5);
    ng_font(3, 7.5, 0);
    ng_col(dm_p >= 1 ? NG_TEXT : NG_MUTED, on ? 1 : 0.35);
    sprintf(#dm_n, dm_b == 1 ? "%d BAR" : "%d BARS", dm_b);
    ng_txt(#dm_n, xx + 29.5, 286.5, 1, 0);
    ng_col(NG_MUTED, on ? 1 : 0.35);
    ng_arrow(xx + 6, 286.5, -1);
    ng_arrow(xx + 53, 286.5, 1);
    k += 1;
  );

  // controls: the selected voice, then the kit
  dm_sel = ng_tabs("KICK|SNARE|CLAP|RIM|C HAT|O HAT|LO TOM|HI TOM|BELL|CYMBAL", dm_sel);
  ng_row(6);
  b = 7 + 5 * dm_sel;
  sprintf(#dm_v1, "%.1f dB", dm_slider(b));
  ng_knob_ctl(b, "LEVEL", #dm_v1, -40, 6, 0, 0.1, 0) ? update();
  sprintf(#dm_v2, "%+.1f st", dm_slider(b + 1));
  ng_knob_ctl(b + 1, "TUNE", #dm_v2, -12, 12, 0, 0.1, 1) ? update();
  sprintf(#dm_v3, "%d%%", dm_slider(b + 2));
  ng_knob_ctl(b + 2, "DECAY", #dm_v3, 0, 100, 50, 1, 0) ? update();
  sprintf(#dm_v4, "%d%%", dm_slider(b + 3));
  ng_knob_ctl(b + 3, dm_tone_name(dm_sel), #dm_v4, 0, 100, dm_tone_def(dm_sel), 1, 0) ? update();
  dm_p = dm_slider(b + 4);
  dm_p == 0 ? strcpy(#dm_v5, "C") : sprintf(#dm_v5, dm_p < 0 ? "L%d" : "R%d", abs(dm_p));
  ng_knob_ctl(b + 4, "PAN", #dm_v5, -100, 100, dm_pan_def(dm_sel), 1, 1) ? update();
  ng_select_ctl(62, "KIT", "MANUAL|DEEP BOOM|PUNCH BOX|VINTAGE|POP STUDIO|LO-FI DUST|INDUSTRIAL|MINIMAL|BIG ROOM", 0) ? update();

  ng_row(6);
  ng_select_ctl(1, "PATTERN", "OFF|USER|HOUSE|TECHNO|BOOM BAP|ELECTRO|BREAKBEAT|TRAP|DISCO|SYNTH POP|DEMBOW|BOSSA|ROCK|FUNK|UK GARAGE|JUNGLE|AFROBEAT|REGGAE|FOOTWORK|INDUSTRIAL", 0) ? update();
  sprintf(#dm_g2, "%d%%", slider2);
  ng_knob_ctl(2, "SWING", #dm_g2, 50, 75, 50, 1, 0) ? update();
  sprintf(#dm_g3, "%d%%", slider3);
  ng_knob_ctl(3, "ACCENT", #dm_g3, 0, 100, 50, 1, 0) ? update();
  sprintf(#dm_g4, "%d%%", slider4);
  ng_knob_ctl(4, "DRIVE", #dm_g4, 0, 100, 0, 1, 0) ? update();
  sprintf(#dm_g5, "%d%%", slider5);
  ng_knob_ctl(5, "GRIT", #dm_g5, 0, 100, 0, 1, 0) ? update();
  sprintf(#dm_g6, "%+.1f dB", slider6);
  ng_knob_ctl(6, "VOLUME", #dm_g6, -24, 12, 0, 0.1, 0) ? update();

  ng_row(6);
  sprintf(#dm_g7, "%d%%", slider57);
  ng_knob_ctl(57, "PROBABILITY", #dm_g7, 0, 100, 100, 1, 0) ? update();
  sprintf(#dm_g8, "%d", slider58);
  ng_knob_ctl(58, "SEED", #dm_g8, 1, 999, 1, 1, 0) ? update();
  ng_select_ctl(59, "GENERATE", "OFF|ON", 0) ? update();
  sprintf(#dm_g10, "%d%%", slider60);
  ng_knob_ctl(60, "DENSITY", #dm_g10, 0, 100, 50, 1, 0) ? update();
  ng_select_ctl(61, "STYLE", "FOUR FLOOR|BREAKBEAT|HALF TIME|ELECTRO|LATIN|RANDOM", 0) ? update();
  ng_select_ctl(63, "OUTPUTS", "MAIN|GROUPS", 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
