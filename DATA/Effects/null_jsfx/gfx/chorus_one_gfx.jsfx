desc:NULL Chorus One GFX
author: Christos Koulaxizis
tags: chorus thickening detune stereo lfo width gui
//category: One Slider
//NULL JSFX v2.0 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:50<0,100,1>-Chorus Amount

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
// NULL Chorus One (../chorus_one.jsfx) with its own interface: same audio code, plus @gfx.
// Two delay lines (left/right) long enough for the deepest modulation at any sample rate
buf_size = ceil(srate * 0.05);
delay_buf_l = 0;
delay_buf_r = delay_buf_l + buf_size;
memset(delay_buf_l, 0, 2 * buf_size);
freembuf(delay_buf_r + buf_size);
delay_head_l = delay_head_r = 0;
lfo_phase = 0;
fb_l = fb_r = 0;
gfx_ext_retina = 1;

function update()
(
    // Map slider to chorus parameters
    chorus_val = slider1 / 100;

    // === CHORUS-OPTIMIZED PARAMETERS ===
    lfo_rate = 0.3 + chorus_val * 2.5;      // 0.3 to 2.8 Hz (slower, warmer)
    lfo_depth = 1 + chorus_val * 7;          // 1 to 8 ms (proper chorus depth!)
    delay_base = 5 + chorus_val * 7;         // 5 to 12 ms (classic chorus range)
    feedback_level = chorus_val * 0.15;      // 0 to 0.15 (less feedback for chorus)

    ms_to_samples = srate / 1000;
);

// display: delay time (ms) of the left (sgn 1) or right (sgn -1) line at time t (s)
function chorus_view_ms(t, sgn) local(p, tv)
(
  p = t * lfo_rate;
  p -= floor(p);
  tv = p * 4 - 2;
  delay_base + sgn * (abs(tv) - 1) * lfo_depth;
);

@slider
update();

@sample
// === LFO UPDATE (Triangle Wave) ===
lfo_phase = lfo_phase + lfo_rate / srate;
(lfo_phase >= 1) ? (lfo_phase = lfo_phase - 1);

// Triangle wave using conditional instead of abs()
temp_val = lfo_phase * 4 - 2;
(temp_val < 0) ? (lfo_output = -temp_val - 1);
(temp_val >= 0) ? (lfo_output = temp_val - 1);

// === CALCULATE STEREO DELAY TIMES ===
delay_l_ms = delay_base + lfo_output * lfo_depth;
delay_r_ms = delay_base - lfo_output * lfo_depth;
delay_l_samples = delay_l_ms * ms_to_samples;
delay_r_samples = delay_r_ms * ms_to_samples;

// === LEFT CHANNEL ===
delay_int_l = floor(delay_l_samples);
delay_frac_l = delay_l_samples - delay_int_l;

delay_head_l = (delay_head_l + 1) % buf_size;

read_pos_l = (delay_head_l - delay_int_l);
(read_pos_l < 0) ? (read_pos_l = buf_size + read_pos_l);
(read_pos_l >= buf_size) ? (read_pos_l = read_pos_l - buf_size);

read_pos_l2 = (read_pos_l - 1);
(read_pos_l2 < 0) ? (read_pos_l2 = buf_size + read_pos_l2);

delay_out_l = delay_buf_l[read_pos_l] * (1 - delay_frac_l) + delay_buf_l[read_pos_l2] * delay_frac_l;

delay_buf_l[delay_head_l] = spl0 + fb_l * feedback_level;
fb_l = delay_out_l;

// === RIGHT CHANNEL ===
delay_int_r = floor(delay_r_samples);
delay_frac_r = delay_r_samples - delay_int_r;

delay_head_r = (delay_head_r + 1) % buf_size;

read_pos_r = (delay_head_r - delay_int_r);
(read_pos_r < 0) ? (read_pos_r = buf_size + read_pos_r);
(read_pos_r >= buf_size) ? (read_pos_r = read_pos_r - buf_size);

read_pos_r2 = (read_pos_r - 1);
(read_pos_r2 < 0) ? (read_pos_r2 = buf_size + read_pos_r2);

delay_out_r = delay_buf_r[read_pos_r] * (1 - delay_frac_r) + delay_buf_r[read_pos_r2] * delay_frac_r;

delay_buf_r[delay_head_r] = spl1 + fb_r * feedback_level;
fb_r = delay_out_r;

// === MIX DRY/WET ===
wet_mix = chorus_val * 0.85;            // Max 85% wet (keep some dry signal)
dry_mix = 1 - wet_mix;

spl0 = spl0 * dry_mix + delay_out_l * wet_mix;
spl1 = spl1 * dry_mix + delay_out_r * wet_mix;

@gfx 360 240
ng_one_slider_begin("CHORUS ONE");

// display: left (bright) and right (dim) delay times over 2 s of the triangle LFO
ng_plot(46, 64, 284, 78);
ng_grid(8, 4, 0);
ng_font(4, 8, 0);
g_tw = g_th = 0;
ng_col(NG_MUTED, 1);
g_k = 0;
loop(3,
  sprintf(#g_lbl, "%d", 20 - g_k * 10);
  gfx_measurestr(#g_lbl, g_tw, g_th);
  gfx_x = ng_px - 6 * ng_s - g_tw;
  gfx_y = floor(ng_py + ng_ph * g_k / 2 - gfx_texth / 2 + 0.5);
  gfx_drawstr(#g_lbl);
  g_k += 1;
);
g_k = 1;
loop(3,
  g_k == 1 ? sprintf(#g_lbl, "0.5 s") : g_k == 2 ? sprintf(#g_lbl, "1 s") : sprintf(#g_lbl, "1.5 s");
  gfx_measurestr(#g_lbl, g_tw, g_th);
  gfx_x = ng_lin_x(g_k / 4, 0, 1) - g_tw / 2;
  gfx_y = ng_py + ng_ph + 5 * ng_s;
  gfx_drawstr(#g_lbl);
  g_k += 1;
);
g_sgn = -1;
loop(2,
  ng_col(NG_ACCENT, g_sgn > 0 ? 1 : 0.45);
  g_i = 0;
  loop(floor(ng_pw) + 1,
    g_y = ng_lin_y(chorus_view_ms(2 * g_i / ng_pw, g_sgn), 0, 20);
    g_i == 0 ? ng_line_start(ng_px, g_y) : ng_line_to(ng_px + g_i, g_y);
    g_i += 1;
  );
  g_sgn += 2;
);

// slider card
sprintf(#g_cap, "RATE %.2f Hz  DEPTH %.1f ms", 0.3 + slider1 / 100 * 2.5, 1 + slider1 / 100 * 7);
sprintf(#g_val, "%d", floor(slider1 + 0.5));
ng_set_slider(ng_one_slider_control("AMOUNT", #g_cap, #g_val, "SUBTLE", "LUSH", slider1, 0, 100, 50, 0), 1) ? update();

ng_end();
