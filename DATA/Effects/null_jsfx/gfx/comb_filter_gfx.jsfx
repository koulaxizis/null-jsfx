desc:NULL Comb Filter GFX
author: Christos Koulaxizis
tags: filter comb delay feedback metallic frequency resonant gui
//category: Advanced
//NULL JSFX v3.0 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:500<20,20000,1:log>-Frequency (Hz)
slider2:0.5<0,0.99,0.01>-Feedback
slider3:0<0,1,1{Feed-Forward,Feed-Backward}>-Mode
slider4:0<-12,12,0.1>-Gain (dB)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // NULL Comb Filter (../comb_filter.jsfx) with its own interface: same audio code, plus @gfx.
  // Adds a copy of the signal delayed by one period of Frequency, which puts peaks at
  // Frequency and its harmonics. Feed-Backward recirculates the delay for a ringing,
  // pitched tone. The output is level-compensated so high Feedback does not blow up.
  buf_size = ceil(srate / 20) + 4;
  buf_l = 0;
  buf_r = buf_l + buf_size;
  memset(buf_l, 0, 2 * buf_size);
  freembuf(buf_r + buf_size);
  wpos = 0;
  gfx_ext_retina = 1;

  function tap(buf) local(rp, i, fr, i2)
  (
    rp = wpos - delay;
    rp < 0 ? rp += buf_size;
    i = floor(rp);
    fr = rp - i;
    i2 = i + 1;
    i2 >= buf_size ? i2 = 0;
    buf[i] + (buf[i2] - buf[i]) * fr;
  );

  function update()
  (
    fb = slider2;
    mode = slider3;
    delay = max(1, min(buf_size - 2, srate / slider1));
    // peak gain of the comb is 1 + fb (feed-forward) or 1 / (1 - fb) (feed-backward)
    norm = mode == 0 ? 1 / (1 + fb) : (1 - fb);
    gain_lin = 10 ^ (slider4 / 20) * norm;
  );

  // display only: response in dB at frequency f (the comb without the interpolation)
  function cf_db(f) local(th, m)
  (
    th = 2 * $pi * f / srate * delay;
    m = mode == 0 ? 1 + 2 * fb * cos(th) + fb * fb : 1 / (1 - 2 * fb * cos(th) + fb * fb);
    10 * log10(max(m, 0.0000000001)) + 20 * log10(max(gain_lin, 0.00001));
  );

  // display only: dashed vertical marker at pixel x
  function cf_dash(x) local(yy)
  (
    x = floor(x) + 0.5;
    yy = ng_py;
    while (
      gfx_line(x, yy, x, min(yy + 3 * ng_s, ng_py + ng_ph), 0);
      yy += 6 * ng_s;
      yy < ng_py + ng_ph;
    );
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 8;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1); ng_hist_add(2); ng_hist_add(3); ng_hist_add(4);
  ng_hist_init();

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 500); ng_slider_set(2, 0.5); ng_slider_set(3, 0); ng_slider_set(4, 0); );
    p == 1 ? ( ng_slider_set(1, 800); ng_slider_set(2, 0.4); ng_slider_set(3, 0); ng_slider_set(4, 2); );
    p == 2 ? ( ng_slider_set(1, 2500); ng_slider_set(2, 0.3); ng_slider_set(3, 0); ng_slider_set(4, 1.5); );
    p == 3 ? ( ng_slider_set(1, 220); ng_slider_set(2, 0.85); ng_slider_set(3, 1); ng_slider_set(4, 4); );
    p == 4 ? ( ng_slider_set(1, 1760); ng_slider_set(2, 0.7); ng_slider_set(3, 1); ng_slider_set(4, 3); );
    p == 5 ? ( ng_slider_set(1, 110); ng_slider_set(2, 0.97); ng_slider_set(3, 1); ng_slider_set(4, 4); );
    p == 6 ? ( ng_slider_set(1, 330); ng_slider_set(2, 0.6); ng_slider_set(3, 1); ng_slider_set(4, 3); );
    p == 7 ? ( ng_slider_set(1, 100); ng_slider_set(2, 0.9); ng_slider_set(3, 1); ng_slider_set(4, 4); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 500) && ng_pre_eq(slider2, 0.5) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 800) && ng_pre_eq(slider2, 0.4) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 2) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 2500) && ng_pre_eq(slider2, 0.3) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 1.5) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 220) && ng_pre_eq(slider2, 0.85) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, 4) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 1760) && ng_pre_eq(slider2, 0.7) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, 3) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 110) && ng_pre_eq(slider2, 0.97) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, 4) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 330) && ng_pre_eq(slider2, 0.6) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, 3) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 100) && ng_pre_eq(slider2, 0.9) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, 4) ? m = 7;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Hollow Pad Color";
    p == 2 ? s = "Subtle Phasey Tone";
    p == 3 ? s = "Metallic Snare Ring";
    p == 4 ? s = "Tuned Hat Shimmer";
    p == 5 ? s = "Karplus Pluck A2";
    p == 6 ? s = "Tube Resonance";
    p == 7 ? s = "Robotic Buzz";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  d_l = tap(buf_l);
  d_r = tap(buf_r);
  out_l = spl0 + fb * d_l;
  out_r = spl1 + fb * d_r;
  buf_l[wpos] = mode == 0 ? spl0 : out_l;
  buf_r[wpos] = mode == 0 ? spl1 : out_r;
  wpos += 1;
  wpos >= buf_size ? wpos = 0;
  spl0 = out_l * gain_lin;
  spl1 = out_r * gain_lin;

@gfx 480 294
  ng_knobs_begin("COMB FILTER", "ADVANCED", 480, 120, 1, 0);

  // display: the magnitude response (peaks at Frequency and its harmonics) with the level
  // compensation and Gain; where the teeth get denser than a pixel it shows their range
  ng_plot(ng_vx + 26, ng_vy + 4, ng_vw - 30, ng_vh - 20);
  ng_grid_freq(24);
  ng_col(NG_ACCENT, 0.5);
  cf_dash(ng_freq_x(slider1));
  cf_zy = ng_lin_y(0, -16, 16);
  cf_i = 0;
  loop(floor(ng_pw),
    cf_mn = 1000; cf_mx = -1000;
    cf_j = 0;
    loop(7,
      cf_d = cf_db(20 * 1000 ^ ((cf_i + cf_j / 6) / ng_pw));
      cf_mn = min(cf_mn, cf_d); cf_mx = max(cf_mx, cf_d);
      cf_j += 1;
    );
    cf_y1 = ng_lin_y(cf_mx, -16, 16);
    cf_y2 = ng_lin_y(cf_mn, -16, 16);
    ng_col(NG_ACCENT, 0.10);
    cf_y1 < cf_zy ? gfx_rect(ng_px + cf_i, cf_y1, 1, cf_zy - cf_y1);
    ng_col(NG_ACCENT, 1);
    gfx_rect(ng_px + cf_i, cf_y1 - ng_s, 1, cf_y2 - cf_y1 + 2 * ng_s);
    cf_i += 1;
  );

  ng_row(4);
  slider1 >= 1000 ? sprintf(#v1, "%.2f kHz", slider1 / 1000) : sprintf(#v1, "%d Hz", slider1);
  ng_knob_ctl_log(1, "FREQ", #v1, 20, 20000, 500, 1) ? update();
  sprintf(#v2, "%.2f", slider2);
  ng_knob_ctl(2, "FEEDBACK", #v2, 0, 0.99, 0.5, 0.01, 0) ? update();
  ng_select_ctl(3, "MODE", "FWD|BACK", 0) ? update();
  sprintf(#v4, "%+.1f dB", slider4);
  ng_knob_ctl(4, "GAIN", #v4, -12, 12, 0, 0.1, 1) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
