desc:NULL Comb Filter GFX
author: Christos Koulaxizis
tags: filter comb delay feedback metallic frequency resonant gui
//category: Advanced
//NULL JSFX v2.0 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:500<20,20000,1:log>-Frequency (Hz)
slider2:0.5<0,0.99,0.01>-Feedback
slider3:0<0,1,1{Feed-Forward,Feed-Backward}>-Mode
slider4:0<-12,12,0.1>-Gain (dB)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  // NULL Comb Filter (../comb_filter.jsfx) with its own interface: same audio code, plus @gfx.
  // Adds a copy of the signal delayed by one period of Frequency, which puts peaks at
  // Frequency and its harmonics. Feed-Backward recirculates the delay for a ringing,
  // pitched tone. The output is level-compensated so high Feedback does not blow up.
  buf_size = ceil(srate / 20) + 4;
  buf_l = 0;
  buf_r = buf_l + buf_size;
  memset(buf_l, 0, 2 * buf_size);
  freembuf(buf_r + buf_size);
  wpos = 0;
  gfx_ext_retina = 1;

  function tap(buf) local(rp, i, fr, i2)
  (
    rp = wpos - delay;
    rp < 0 ? rp += buf_size;
    i = floor(rp);
    fr = rp - i;
    i2 = i + 1;
    i2 >= buf_size ? i2 = 0;
    buf[i] + (buf[i2] - buf[i]) * fr;
  );

  function update()
  (
    fb = slider2;
    mode = slider3;
    delay = max(1, min(buf_size - 2, srate / slider1));
    // peak gain of the comb is 1 + fb (feed-forward) or 1 / (1 - fb) (feed-backward)
    norm = mode == 0 ? 1 / (1 + fb) : (1 - fb);
    gain_lin = 10 ^ (slider4 / 20) * norm;
  );

  // display only: response in dB at frequency f (the comb without the interpolation)
  function cf_db(f) local(th, m)
  (
    th = 2 * $pi * f / srate * delay;
    m = mode == 0 ? 1 + 2 * fb * cos(th) + fb * fb : 1 / (1 - 2 * fb * cos(th) + fb * fb);
    10 * log10(max(m, 0.0000000001)) + 20 * log10(max(gain_lin, 0.00001));
  );

  // display only: dashed vertical marker at pixel x
  function cf_dash(x) local(yy)
  (
    x = floor(x) + 0.5;
    yy = ng_py;
    while (
      gfx_line(x, yy, x, min(yy + 3 * ng_s, ng_py + ng_ph), 0);
      yy += 6 * ng_s;
      yy < ng_py + ng_ph;
    );
  );

@slider
  update();

@sample
  d_l = tap(buf_l);
  d_r = tap(buf_r);
  out_l = spl0 + fb * d_l;
  out_r = spl1 + fb * d_r;
  buf_l[wpos] = mode == 0 ? spl0 : out_l;
  buf_r[wpos] = mode == 0 ? spl1 : out_r;
  wpos += 1;
  wpos >= buf_size ? wpos = 0;
  spl0 = out_l * gain_lin;
  spl1 = out_r * gain_lin;

@gfx 480 294
  ng_knobs_begin("COMB FILTER", "ADVANCED", 480, 120, 1, 0);

  // display: the magnitude response (peaks at Frequency and its harmonics) with the level
  // compensation and Gain; where the teeth get denser than a pixel it shows their range
  ng_plot(ng_vx + 26, ng_vy + 4, ng_vw - 30, ng_vh - 20);
  ng_grid_freq(24);
  ng_col(NG_ACCENT, 0.5);
  cf_dash(ng_freq_x(slider1));
  cf_zy = ng_lin_y(0, -16, 16);
  cf_i = 0;
  loop(floor(ng_pw),
    cf_mn = 1000; cf_mx = -1000;
    cf_j = 0;
    loop(7,
      cf_d = cf_db(20 * 1000 ^ ((cf_i + cf_j / 6) / ng_pw));
      cf_mn = min(cf_mn, cf_d); cf_mx = max(cf_mx, cf_d);
      cf_j += 1;
    );
    cf_y1 = ng_lin_y(cf_mx, -16, 16);
    cf_y2 = ng_lin_y(cf_mn, -16, 16);
    ng_col(NG_ACCENT, 0.10);
    cf_y1 < cf_zy ? gfx_rect(ng_px + cf_i, cf_y1, 1, cf_zy - cf_y1);
    ng_col(NG_ACCENT, 1);
    gfx_rect(ng_px + cf_i, cf_y1 - ng_s, 1, cf_y2 - cf_y1 + 2 * ng_s);
    cf_i += 1;
  );

  ng_row(4);
  slider1 >= 1000 ? sprintf(#v1, "%.2f kHz", slider1 / 1000) : sprintf(#v1, "%d Hz", slider1);
  ng_knob_ctl(1, "FREQ", #v1, 20, 20000, 500, 1, 0) ? update();
  sprintf(#v2, "%.2f", slider2);
  ng_knob_ctl(2, "FEEDBACK", #v2, 0, 0.99, 0.5, 0.01, 0) ? update();
  ng_select_ctl(3, "MODE", "FWD|BACK", 0) ? update();
  sprintf(#v4, "%+.1f dB", slider4);
  ng_knob_ctl(4, "GAIN", #v4, -12, 12, 0, 0.1, 1) ? update();

  ng_end();
