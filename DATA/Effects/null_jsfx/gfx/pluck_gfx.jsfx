desc:NULL Pluck GFX
author: Christos Koulaxizis
tags: instrument pluck plucked string karplus strong guitar nylon steel harp koto pipa lute banjo dulcimer strum strummer chord rhythm body midi gui
//category: Instruments
//NULL JSFX v2.6.1 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:0<0,7,1{Nylon Guitar,Steel Guitar,Harp,Koto,Pipa,Banjo,Muted Guitar,Dulcimer}>-Model
slider2:18<5,50,1>-Pick Position (%)
slider3:50<0,100,1>-Brightness (%)
slider4:100<10,300,1>-Decay (%)
slider5:150<10,2000,1:log>-Release (ms)
slider6:50<0,100,1>-Body (%)
slider7:50<0,100,1>-Width (%)
slider8:60<0,100,1>-Velocity (%)
slider9:0<0,5,1{Off,Down,Up,Down-Up,Folk,Offbeat}>-Strum
slider10:1<0,3,1{Quarters,Eighths,Sixteenths,Eighth Triplets}>-Strum Rate
slider11:20<0,100,1>-Strum Spread (ms)
slider12:0<-24,12,0.1>-Volume (dB)

in_pin:none
out_pin:Left
out_pin:Right

@init
  // NULL Pluck (../pluck.jsfx) with its own interface: same audio code, plus @gfx.
  // Plucked strings (no samples), 12 voices. Every note is a Karplus-Strong string: a delay
  // line one period long (the read interpolated, its length corrected for the loop filter so
  // the string is in tune) with a one-pole low-pass and a loop gain set from the decay time at
  // the pitch. The pluck is low-passed noise mixed with the triangle of a string pulled at Pick
  // Position, combed at that position (a pluck near the bridge is thin, at the middle hollow),
  // its brightness from Brightness and the velocity. Koto, Pipa and Banjo start a little sharp
  // and settle (the string's tension), and the sum goes through the model's body (three
  // resonances, Body = how much) and a DC blocker. Width spreads the strings by pitch and
  // detunes the right channel's body. A note played again lets go of the string that still
  // sounds (40 ms) and takes a new voice; a 13th takes the oldest voice (released ones first)
  // after a 2 ms fade. Keys up fade over Release; the sustain pedal (CC 64) holds them.
  // Strum: the keys held (or held by the pedal) are strummed on the host's beat (or at its
  // tempo while stopped, from the first key) at Strum Rate: Down (low to high), Up, Down-Up
  // and Folk (whose up strums hit the top four strings), and Offbeat; Strum Spread is the
  // time from one string to the next, the beat's strums are louder. All notes off (CC 123/120)
  // stops everything.
  //
  // Memory: 0.. the MIDI of the block (4 per message), 2048.. keys down, 2176.. keys held
  // (with the pedal), 2304.. per-voice values, 3072.. the models, 3584.. the strum patterns,
  // 8192.. the strings' delay lines, then the plucks.
  ext_noinit = 1;
  ext_tail_size = -1;
  NV = 12;
  MQ = 0;
  KD = 2048; HL = 2176;
  v_note = 2304; v_gate = 2320; v_env = 2336; v_rel = 2352; v_pend = 2368; v_pvel = 2384;
  v_age = 2400; v_fast = 2416; v_w = 2432; v_d0 = 2448; v_tw = 2464; v_twk = 2480;
  v_lp = 2496; v_b = 2512; v_g = 2528; v_ek = 2544; v_en = 2560; v_pp = 2576; v_amp = 2592;
  v_gl = 2608; v_gr = 2624; v_pk = 2640;
  MT = 3072;
  PT = 3584;
  SB = 8192;
  tpi = 2 * $pi;

  // the models, 24 values each: decay (s at C3), decay factor per octave, loop low-pass,
  // pluck brightness (Hz), the start sharp (cents) and how fast it settles (s), three body
  // resonances (Hz, Q, level), the triangle's share of the pluck, level
  function mrow(a, b, c, d, e, f)
  (
    MT[mw] = a; MT[mw + 1] = b; MT[mw + 2] = c; MT[mw + 3] = d; MT[mw + 4] = e; MT[mw + 5] = f;
    mw += 6;
  );
  function mbody(a, b, c, d, e, f, g, h, i)
  (
    MT[mw] = a; MT[mw + 1] = b; MT[mw + 2] = c; MT[mw + 3] = d; MT[mw + 4] = e; MT[mw + 5] = f;
    MT[mw + 6] = g; MT[mw + 7] = h; MT[mw + 8] = i;
    mw += 9;
  );
  function mend(a, b)
  (
    MT[mw] = a; MT[mw + 1] = b;
    mw += 9;
  );
  mw = 0;
  // Nylon Guitar
  mrow(3.5, 0.75, 0.35, 2500, 0, 0.05); mbody(100, 2, 1, 200, 3, 0.6, 400, 3, 0.3); mend(0.6, 1.25);
  // Steel Guitar
  mrow(5, 0.75, 0.18, 5000, 3, 0.03); mbody(110, 2, 0.8, 230, 3, 0.5, 2600, 2, 0.3); mend(0.4, 0.8);
  // Harp
  mrow(7, 0.7, 0.3, 1800, 0, 0.05); mbody(90, 1.5, 1, 180, 2, 0.5, 360, 2, 0.3); mend(0.8, 0.85);
  // Koto
  mrow(3, 0.75, 0.15, 6000, 25, 0.08); mbody(160, 3, 0.8, 450, 3, 0.6, 1400, 3, 0.3); mend(0.3, 0.75);
  // Pipa
  mrow(2, 0.7, 0.12, 7000, 18, 0.05); mbody(250, 3, 0.9, 700, 3, 0.6, 2000, 3, 0.3); mend(0.3, 0.7);
  // Banjo
  mrow(1.5, 0.8, 0.1, 8000, 6, 0.02); mbody(350, 4, 1.2, 1100, 4, 0.7, 3000, 3, 0.4); mend(0.2, 0.6);
  // Muted Guitar
  mrow(0.25, 0.9, 0.5, 1500, 0, 0.05); mbody(110, 2, 1, 220, 3, 0.6, 440, 3, 0.3); mend(0.7, 1.4);
  // Dulcimer
  mrow(6, 0.75, 0.12, 6000, 2, 0.02); mbody(200, 2, 0.6, 600, 3, 0.5, 1800, 3, 0.3); mend(0.1, 0.6);

  // the strum patterns, 8 steps (0 rest, 1 down, 2 up): Down, Up, Down-Up, Folk, Offbeat
  function prow(a, b, c, d, e, f, g, h)
  (
    PT[pw] = a; PT[pw + 1] = b; PT[pw + 2] = c; PT[pw + 3] = d;
    PT[pw + 4] = e; PT[pw + 5] = f; PT[pw + 6] = g; PT[pw + 7] = h;
    pw += 8;
  );
  pw = 8;
  prow(1, 1, 1, 1, 1, 1, 1, 1);
  prow(2, 2, 2, 2, 2, 2, 2, 2);
  prow(1, 2, 1, 2, 1, 2, 1, 2);
  prow(1, 0, 1, 2, 0, 2, 1, 2);
  prow(0, 1, 0, 1, 0, 1, 0, 1);

  function v_start(v, n, vel) local(f, d0, d, w0, b, t, tt, pd, hlp, hm, fr, g, vn, gv, fc, c, nn, ebp, z, s, k, pos, tri, e, p)
  (
    v_note[v] = n; v_pend[v] = -1;
    v_gate[v] = HL[n] > 0 ? 1 : 0;
    v_env[v] = 0; v_rel[v] = 1; v_fast[v] = 0;
    age += 1;
    v_age[v] = age;
    f = 440 * 2 ^ ((n - 69) / 12);
    f = max(30, min(srate / 8, f));
    d0 = srate / f;
    w0 = tpi * f;
    w0 /= srate;
    // the loop filter's phase delay and gain at the pitch, the read's gain
    b = lpb_e;
    t = b * sin(w0);
    tt = 1 - b * cos(w0);
    pd = atan2(t, tt) / w0;
    hlp = (1 - b) / sqrt(t * t + tt * tt);
    d = d0 - pd;
    fr = d - floor(d);
    t = 2 * fr;
    t *= 1 - fr;
    t *= cos(w0);
    hm = sqrt((1 - fr) * (1 - fr) + fr * fr + t);
    v_d0[v] = d;
    // the loop gain for the decay time at this pitch
    t = m_t60 * dsc;
    t *= m_kt ^ ((n - 48) / 12);
    tt = t * f;
    g = exp(-6.907755 / tt);
    t = hlp * hm;
    g = min(0.9999, g / t);
    v_g[v] = g;
    v_b[v] = b;
    v_lp[v] = 0;
    vn = vel / 127;
    gv = vn * vn;
    gv = 1 - vs + vs * gv;
    gv *= m_gain;
    v_tw[v] = 1;
    v_twk[v] = tw_k * (0.5 + vn);
    memset(SB + v * lb, 0, lb);
    v_w[v] = 0;
    // the pluck: low-passed noise and the triangle, without DC
    fc = exb_e * (0.5 + vn);
    t = tpi * min(0.45 * srate, fc);
    c = exp(-t / srate);
    nn = max(2, floor(d0 + 0.5));
    ebp = EB + v * lb;
    z = 0; s = 0; k = 0;
    loop(nn,
      seed *= 16807; seed -= floor(seed / 2147483647) * 2147483647;
      z = (1 - c) * (seed / 1073741824 - 1) + c * z;
      pos = (k + 0.5) / nn;
      tri = pos < pp ? pos / pp : (1 - pos) / (1 - pp);
      e = 2 * z;
      e *= 1 - tri_m;
      e += tri_m * tri;
      ebp[k] = e;
      s += e;
      k += 1;
    );
    s /= nn;
    k = 0;
    loop(nn, ebp[k] -= s; k += 1;);
    v_ek[v] = 0;
    v_en[v] = nn;
    v_pp[v] = max(1, floor(pp * nn + 0.5));
    v_amp[v] = gv;
    v_pk[v] = 0;
    p = max(-1, min(1, (n - 60) / 24));
    p *= wid;
    v_gl[v] = 1 - p;
    v_gr[v] = 1 + p;
  );

  // a string plucked: the same note still sounding lets go (fast), a free voice, else the
  // oldest released one, else the oldest after a fade
  function pluck(n, vel) local(v, f, ba)
  (
    f = -1;
    v = 0;
    loop(NV,
      v_pend[v] == n ? ( f = v; v_pvel[v] = vel; );
      v += 1;
    );
    f < 0 ? (
      v = 0;
      loop(NV, v_pend[v] < 0 && v_note[v] == n && v_fast[v] == 0 ? ( v_gate[v] = 0; v_fast[v] = 1; ); v += 1;);
      v = 0;
      loop(NV, f < 0 && v_note[v] < 0 ? f = v; v += 1;);
      f < 0 ? (
        ba = 0;
        v = 0;
        loop(NV,
          v_gate[v] == 0 && v_pend[v] < 0 && (f < 0 || v_age[v] < ba) ? ( f = v; ba = v_age[v]; );
          v += 1;
        );
      );
      f < 0 ? (
        v = 0;
        loop(NV,
          f < 0 || v_age[v] < ba ? ( f = v; ba = v_age[v]; );
          v += 1;
        );
      );
      v_note[f] < 0 ? v_start(f, n, vel) : (
        v_gate[f] = 0;
        v_pend[f] = n;
        v_pvel[f] = vel;
        age += 1;
        v_age[f] = age;
      );
    );
  );

  function count_held() local(k)
  (
    nheld = 0;
    k = 0;
    loop(128, nheld += HL[k] > 0; k += 1;);
  );
  function release(n) local(v)
  (
    v = 0;
    loop(NV, v_pend[v] < 0 && v_note[v] == n ? v_gate[v] = 0; v += 1;);
  );
  function note_on(n, vel)
  (
    nheld == 0 ? st_clock = 0;
    KD[n] = 1;
    HL[n] = 1;
    count_held();
    last_vel = vel;
    st_mode == 0 ? pluck(n, vel);
  );
  function note_off(n)
  (
    KD[n] = 0;
    !sus ? (
      HL[n] = 0;
      release(n);
      count_held();
    );
  );
  function sus_off() local(k)
  (
    sus = 0;
    k = 0;
    loop(128,
      KD[k] == 0 && HL[k] > 0 ? ( HL[k] = 0; release(k); );
      k += 1;
    );
    count_held();
  );
  function all_off() local(v)
  (
    memset(KD, 0, 128);
    memset(HL, 0, 128);
    nheld = 0;
    sus = 0;
    st_on = 0;
    v = 0;
    loop(NV, v_gate[v] = 0; v += 1;);
  );
  function midi_ev(st, d1, d2) local(t)
  (
    t = st & 0xF0;
    t == 0x90 && d2 > 0 ? note_on(d1, d2) :
    t == 0x80 || t == 0x90 ? note_off(d1) :
    t == 0xB0 ? (
      d1 == 64 ? ( d2 >= 64 ? sus = 1 : sus ? sus_off(); ) :
      d1 == 123 || d1 == 120 ? all_off();
    );
  );

  // a strum step: the pattern's stroke, louder on the beat
  function st_step(s) local(k, c, a)
  (
    k = s - floor(s / 8) * 8;
    c = PT[st_mode * 8 + k];
    c > 0 ? (
      st_dir = c == 1 ? 1 : -1;
      st_max = c == 2 && (st_mode == 3 || st_mode == 4) ? 4 : 128;
      a = s - floor(s / spb) * spb;
      a = a == 0 ? 1 : 0.85;
      c == 2 ? a *= 0.8;
      st_vel = last_vel * a;
      st_t0 = sc;
      st_i = 0;
      st_on = 1;
    );
  );
  // the next string of the strum: the st_i-th key held from the low (down) or high (up) end
  function st_next() local(k, j, n)
  (
    n = -1;
    st_i < st_max ? (
      j = 0;
      k = st_dir > 0 ? 0 : 127;
      loop(128,
        n < 0 && HL[k] > 0 ? ( j == st_i ? n = k : j += 1; );
        k += st_dir;
      );
    );
    n >= 0 ? (
      pluck(n, st_vel * (1 - 0.04 * st_i));
      st_i += 1;
    ) : st_on = 0;
  );

  // a filter state that has died away is zero (no denormals)
  function flush(x) ( abs(x) < 0.000000000000001 ? 0 : x; );
  // a band-pass of the body (state-variable)
  function bp_set(f, q) local(g)
  (
    g = tan($pi * min(0.45 * srate, f) / srate);
    bp_k = 1 / q;
    bp_a1 = 1 / (1 + g * (g + bp_k));
    bp_a2 = g * bp_a1;
    bp_a3 = g * bp_a2;
  );

  v = 0;
  loop(NV, v_note[v] = -1; v_gate[v] = 0; v_env[v] = 0; v_pend[v] = -1; v += 1;);
  memset(KD, 0, 128);
  memset(HL, 0, 128);
  nheld = 0; sus = 0; age = 0; last_vel = 100;
  seed = 4711;
  lb = ceil(srate / 30) + 8;
  EB = SB + NV * lb;
  memset(SB, 0, 2 * NV * lb);
  st_s = -1000; st_clock = 0; st_on = 0; sc = 0;
  bl_s1 = bl_s2 = bl_s3 = br_s1 = br_s2 = br_s3 = 0;
  bl_t1 = bl_t2 = bl_t3 = br_t1 = br_t2 = br_t3 = 0;
  dc_xl = dc_yl = dc_xr = dc_yr = 0;
  m_ofs = m_1 = m_2 = m_3 = 0;

  gfx_ext_retina = 1;

  // the interface: a string held and sounding, white keys
  function pk_snd(n) local(v, r) ( r = 0; v = 0; loop(NV, v_note[v] == n && v_pend[v] < 0 && v_gate[v] > 0 ? r = 1; v += 1;); r; );
  function pk_white(pc) ( pc == 0 || pc == 2 || pc == 4 || pc == 5 || pc == 7 || pc == 9 || pc == 11; );

  function update()
  (
    model = max(0, min(7, floor(slider1 + 0.5)));
    mb = MT + model * 24;
    m_t60 = mb[0]; m_kt = mb[1]; m_lpb = mb[2]; m_exb = mb[3]; m_tw = mb[4]; m_twt = mb[5];
    tri_m = mb[15]; m_gain = mb[16];
    pp = slider2 / 100;
    lpb_e = min(0.9, m_lpb * 2 ^ ((50 - slider3) / 30));
    exb_e = m_exb * 2 ^ ((slider3 - 50) / 25);
    dsc = slider4 / 100;
    r_c = exp(-6.907755 / (slider5 * 0.001 * srate));
    rf_c = exp(-6.907755 / (0.04 * srate));
    bm = slider6 / 100;
    wid = 0.006 * slider7;
    vs = slider8 / 100;
    st_mode = floor(slider9 + 0.5);
    st_rate = floor(slider10 + 0.5);
    spb = st_rate == 0 ? 1 : st_rate == 1 ? 2 : st_rate == 2 ? 4 : 3;
    t = slider11 * 0.001;
    spread_s = floor(t * srate + 0.5);
    vol = 10 ^ (slider12 / 20);
    tw_k = 1 - 2 ^ (-m_tw / 1200);
    twc = exp(-1 / (m_twt * srate));
    a_inc = 1 / (0.0005 * srate);
    s_inc = 1 / (0.002 * srate);
    pkc = exp(-1 / (0.03 * srate));
    t = tpi * 20;
    dc_r = 1 - t / srate;
    // the body: three band-passes per side, the right one detuned by Width
    t = 1 + 0.0006 * slider7;
    bp_set(mb[6], mb[7]); bl_k1 = bp_k * mb[8]; bl_a11 = bp_a1; bl_a21 = bp_a2; bl_a31 = bp_a3;
    bp_set(mb[9], mb[10]); bl_k2 = bp_k * mb[11]; bl_a12 = bp_a1; bl_a22 = bp_a2; bl_a32 = bp_a3;
    bp_set(mb[12], mb[13]); bl_k3 = bp_k * mb[14]; bl_a13 = bp_a1; bl_a23 = bp_a2; bl_a33 = bp_a3;
    bp_set(mb[6] * t, mb[7]); br_k1 = bp_k * mb[8]; br_a11 = bp_a1; br_a21 = bp_a2; br_a31 = bp_a3;
    bp_set(mb[9] * t, mb[10]); br_k2 = bp_k * mb[11]; br_a12 = bp_a1; br_a22 = bp_a2; br_a32 = bp_a3;
    bp_set(mb[12] * t, mb[13]); br_k3 = bp_k * mb[14]; br_a13 = bp_a1; br_a23 = bp_a2; br_a33 = bp_a3;
    b_dry = 1 - 0.5 * bm;
    b_wet = 1.5 * bm;
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 16;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1); ng_hist_add(2); ng_hist_add(3); ng_hist_add(4); ng_hist_add(5); ng_hist_add(6); ng_hist_add(7); ng_hist_add(8); ng_hist_add(9); ng_hist_add(10); ng_hist_add(11); ng_hist_add(12);
  ng_hist_init();

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 0); ng_slider_set(2, 18); ng_slider_set(3, 50); ng_slider_set(4, 100); ng_slider_set(5, 150); ng_slider_set(6, 50); ng_slider_set(7, 50); ng_slider_set(8, 60); ng_slider_set(9, 0); ng_slider_set(10, 1); ng_slider_set(11, 20); ng_slider_set(12, 0); );
    p == 1 ? ( ng_slider_set(1, 0); ng_slider_set(2, 25); ng_slider_set(3, 40); ng_slider_set(4, 100); ng_slider_set(5, 150); ng_slider_set(6, 50); ng_slider_set(7, 50); ng_slider_set(8, 60); ng_slider_set(9, 0); ng_slider_set(10, 1); ng_slider_set(11, 20); ng_slider_set(12, 0); );
    p == 2 ? ( ng_slider_set(1, 0); ng_slider_set(2, 18); ng_slider_set(3, 50); ng_slider_set(4, 100); ng_slider_set(5, 150); ng_slider_set(6, 50); ng_slider_set(7, 50); ng_slider_set(8, 60); ng_slider_set(9, 3); ng_slider_set(10, 1); ng_slider_set(11, 18); ng_slider_set(12, 0); );
    p == 3 ? ( ng_slider_set(1, 1); ng_slider_set(2, 12); ng_slider_set(3, 60); ng_slider_set(4, 100); ng_slider_set(5, 150); ng_slider_set(6, 50); ng_slider_set(7, 50); ng_slider_set(8, 60); ng_slider_set(9, 0); ng_slider_set(10, 1); ng_slider_set(11, 20); ng_slider_set(12, 0); );
    p == 4 ? ( ng_slider_set(1, 1); ng_slider_set(2, 18); ng_slider_set(3, 50); ng_slider_set(4, 100); ng_slider_set(5, 150); ng_slider_set(6, 50); ng_slider_set(7, 50); ng_slider_set(8, 60); ng_slider_set(9, 4); ng_slider_set(10, 1); ng_slider_set(11, 22); ng_slider_set(12, -2); );
    p == 5 ? ( ng_slider_set(1, 1); ng_slider_set(2, 18); ng_slider_set(3, 65); ng_slider_set(4, 40); ng_slider_set(5, 60); ng_slider_set(6, 50); ng_slider_set(7, 50); ng_slider_set(8, 60); ng_slider_set(9, 3); ng_slider_set(10, 2); ng_slider_set(11, 8); ng_slider_set(12, 0); );
    p == 6 ? ( ng_slider_set(1, 1); ng_slider_set(2, 18); ng_slider_set(3, 65); ng_slider_set(4, 30); ng_slider_set(5, 60); ng_slider_set(6, 50); ng_slider_set(7, 50); ng_slider_set(8, 60); ng_slider_set(9, 5); ng_slider_set(10, 1); ng_slider_set(11, 6); ng_slider_set(12, 0); );
    p == 7 ? ( ng_slider_set(1, 6); ng_slider_set(2, 18); ng_slider_set(3, 50); ng_slider_set(4, 100); ng_slider_set(5, 150); ng_slider_set(6, 50); ng_slider_set(7, 50); ng_slider_set(8, 60); ng_slider_set(9, 0); ng_slider_set(10, 1); ng_slider_set(11, 20); ng_slider_set(12, 0); );
    p == 8 ? ( ng_slider_set(1, 2); ng_slider_set(2, 18); ng_slider_set(3, 50); ng_slider_set(4, 100); ng_slider_set(5, 150); ng_slider_set(6, 50); ng_slider_set(7, 80); ng_slider_set(8, 60); ng_slider_set(9, 0); ng_slider_set(10, 1); ng_slider_set(11, 20); ng_slider_set(12, 0); );
    p == 9 ? ( ng_slider_set(1, 2); ng_slider_set(2, 18); ng_slider_set(3, 50); ng_slider_set(4, 100); ng_slider_set(5, 150); ng_slider_set(6, 50); ng_slider_set(7, 80); ng_slider_set(8, 60); ng_slider_set(9, 2); ng_slider_set(10, 0); ng_slider_set(11, 60); ng_slider_set(12, 0); );
    p == 10 ? ( ng_slider_set(1, 3); ng_slider_set(2, 18); ng_slider_set(3, 50); ng_slider_set(4, 100); ng_slider_set(5, 150); ng_slider_set(6, 50); ng_slider_set(7, 50); ng_slider_set(8, 60); ng_slider_set(9, 0); ng_slider_set(10, 1); ng_slider_set(11, 20); ng_slider_set(12, 0); );
    p == 11 ? ( ng_slider_set(1, 4); ng_slider_set(2, 10); ng_slider_set(3, 50); ng_slider_set(4, 100); ng_slider_set(5, 150); ng_slider_set(6, 50); ng_slider_set(7, 50); ng_slider_set(8, 60); ng_slider_set(9, 0); ng_slider_set(10, 1); ng_slider_set(11, 20); ng_slider_set(12, 0); );
    p == 12 ? ( ng_slider_set(1, 5); ng_slider_set(2, 18); ng_slider_set(3, 50); ng_slider_set(4, 100); ng_slider_set(5, 150); ng_slider_set(6, 50); ng_slider_set(7, 50); ng_slider_set(8, 60); ng_slider_set(9, 0); ng_slider_set(10, 1); ng_slider_set(11, 20); ng_slider_set(12, 0); );
    p == 13 ? ( ng_slider_set(1, 5); ng_slider_set(2, 18); ng_slider_set(3, 50); ng_slider_set(4, 100); ng_slider_set(5, 150); ng_slider_set(6, 50); ng_slider_set(7, 50); ng_slider_set(8, 60); ng_slider_set(9, 1); ng_slider_set(10, 2); ng_slider_set(11, 40); ng_slider_set(12, 0); );
    p == 14 ? ( ng_slider_set(1, 7); ng_slider_set(2, 18); ng_slider_set(3, 50); ng_slider_set(4, 100); ng_slider_set(5, 150); ng_slider_set(6, 50); ng_slider_set(7, 70); ng_slider_set(8, 60); ng_slider_set(9, 0); ng_slider_set(10, 1); ng_slider_set(11, 20); ng_slider_set(12, 0); );
    p == 15 ? ( ng_slider_set(1, 1); ng_slider_set(2, 18); ng_slider_set(3, 80); ng_slider_set(4, 100); ng_slider_set(5, 150); ng_slider_set(6, 50); ng_slider_set(7, 90); ng_slider_set(8, 60); ng_slider_set(9, 2); ng_slider_set(10, 2); ng_slider_set(11, 30); ng_slider_set(12, -2); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 18) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 150) && ng_pre_eq(slider6, 50) && ng_pre_eq(slider7, 50) && ng_pre_eq(slider8, 60) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 1) && ng_pre_eq(slider11, 20) && ng_pre_eq(slider12, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 25) && ng_pre_eq(slider3, 40) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 150) && ng_pre_eq(slider6, 50) && ng_pre_eq(slider7, 50) && ng_pre_eq(slider8, 60) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 1) && ng_pre_eq(slider11, 20) && ng_pre_eq(slider12, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 18) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 150) && ng_pre_eq(slider6, 50) && ng_pre_eq(slider7, 50) && ng_pre_eq(slider8, 60) && ng_pre_eq(slider9, 3) && ng_pre_eq(slider10, 1) && ng_pre_eq(slider11, 18) && ng_pre_eq(slider12, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 12) && ng_pre_eq(slider3, 60) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 150) && ng_pre_eq(slider6, 50) && ng_pre_eq(slider7, 50) && ng_pre_eq(slider8, 60) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 1) && ng_pre_eq(slider11, 20) && ng_pre_eq(slider12, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 18) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 150) && ng_pre_eq(slider6, 50) && ng_pre_eq(slider7, 50) && ng_pre_eq(slider8, 60) && ng_pre_eq(slider9, 4) && ng_pre_eq(slider10, 1) && ng_pre_eq(slider11, 22) && ng_pre_eq(slider12, -2) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 18) && ng_pre_eq(slider3, 65) && ng_pre_eq(slider4, 40) && ng_pre_eq(slider5, 60) && ng_pre_eq(slider6, 50) && ng_pre_eq(slider7, 50) && ng_pre_eq(slider8, 60) && ng_pre_eq(slider9, 3) && ng_pre_eq(slider10, 2) && ng_pre_eq(slider11, 8) && ng_pre_eq(slider12, 0) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 18) && ng_pre_eq(slider3, 65) && ng_pre_eq(slider4, 30) && ng_pre_eq(slider5, 60) && ng_pre_eq(slider6, 50) && ng_pre_eq(slider7, 50) && ng_pre_eq(slider8, 60) && ng_pre_eq(slider9, 5) && ng_pre_eq(slider10, 1) && ng_pre_eq(slider11, 6) && ng_pre_eq(slider12, 0) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 6) && ng_pre_eq(slider2, 18) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 150) && ng_pre_eq(slider6, 50) && ng_pre_eq(slider7, 50) && ng_pre_eq(slider8, 60) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 1) && ng_pre_eq(slider11, 20) && ng_pre_eq(slider12, 0) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 18) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 150) && ng_pre_eq(slider6, 50) && ng_pre_eq(slider7, 80) && ng_pre_eq(slider8, 60) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 1) && ng_pre_eq(slider11, 20) && ng_pre_eq(slider12, 0) ? m = 8;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 18) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 150) && ng_pre_eq(slider6, 50) && ng_pre_eq(slider7, 80) && ng_pre_eq(slider8, 60) && ng_pre_eq(slider9, 2) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 60) && ng_pre_eq(slider12, 0) ? m = 9;
    m < 0 && ng_pre_eq(slider1, 3) && ng_pre_eq(slider2, 18) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 150) && ng_pre_eq(slider6, 50) && ng_pre_eq(slider7, 50) && ng_pre_eq(slider8, 60) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 1) && ng_pre_eq(slider11, 20) && ng_pre_eq(slider12, 0) ? m = 10;
    m < 0 && ng_pre_eq(slider1, 4) && ng_pre_eq(slider2, 10) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 150) && ng_pre_eq(slider6, 50) && ng_pre_eq(slider7, 50) && ng_pre_eq(slider8, 60) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 1) && ng_pre_eq(slider11, 20) && ng_pre_eq(slider12, 0) ? m = 11;
    m < 0 && ng_pre_eq(slider1, 5) && ng_pre_eq(slider2, 18) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 150) && ng_pre_eq(slider6, 50) && ng_pre_eq(slider7, 50) && ng_pre_eq(slider8, 60) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 1) && ng_pre_eq(slider11, 20) && ng_pre_eq(slider12, 0) ? m = 12;
    m < 0 && ng_pre_eq(slider1, 5) && ng_pre_eq(slider2, 18) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 150) && ng_pre_eq(slider6, 50) && ng_pre_eq(slider7, 50) && ng_pre_eq(slider8, 60) && ng_pre_eq(slider9, 1) && ng_pre_eq(slider10, 2) && ng_pre_eq(slider11, 40) && ng_pre_eq(slider12, 0) ? m = 13;
    m < 0 && ng_pre_eq(slider1, 7) && ng_pre_eq(slider2, 18) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 150) && ng_pre_eq(slider6, 50) && ng_pre_eq(slider7, 70) && ng_pre_eq(slider8, 60) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 1) && ng_pre_eq(slider11, 20) && ng_pre_eq(slider12, 0) ? m = 14;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 18) && ng_pre_eq(slider3, 80) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 150) && ng_pre_eq(slider6, 50) && ng_pre_eq(slider7, 90) && ng_pre_eq(slider8, 60) && ng_pre_eq(slider9, 2) && ng_pre_eq(slider10, 2) && ng_pre_eq(slider11, 30) && ng_pre_eq(slider12, -2) ? m = 15;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Nylon Fingerpick";
    p == 2 ? s = "Nylon Strum";
    p == 3 ? s = "Steel Picking";
    p == 4 ? s = "Steel Folk Strum";
    p == 5 ? s = "Funk Sixteenths";
    p == 6 ? s = "Reggae Skank";
    p == 7 ? s = "Muted Pluck";
    p == 8 ? s = "Harp";
    p == 9 ? s = "Harp Rolls";
    p == 10 ? s = "Koto";
    p == 11 ? s = "Pipa";
    p == 12 ? s = "Banjo";
    p == 13 ? s = "Banjo Roll";
    p == 14 ? s = "Dulcimer";
    p == 15 ? s = "Cascade";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@block
  // the MIDI of this block, played at its offsets in @sample
  mq_n = 0;
  while (midirecv(m_ofs, m_1, m_2, m_3)) (
    // every message goes on to the next plugin too, so instruments can be layered
    midisend(m_ofs, m_1, m_2, m_3);
    mq_n < 512 ? (
      MQ[mq_n * 4] = m_ofs;
      MQ[mq_n * 4 + 1] = m_1;
      MQ[mq_n * 4 + 2] = m_2;
      MQ[mq_n * 4 + 3] = m_3;
      mq_n += 1;
    );
  );
  mq_i = 0;
  playing = play_state & 1;
  b_inc = tempo / (60 * srate);
  b_0 = beat_position;
  si = 0;

@sample
  while (mq_i < mq_n && MQ[mq_i * 4] <= si) (
    midi_ev(MQ[mq_i * 4 + 1], MQ[mq_i * 4 + 2], MQ[mq_i * 4 + 3]);
    mq_i += 1;
  );

  // the strum: a step plays when the position enters it (on the first key, also when the key
  // comes in the first half of the step; a key on the half itself waits, however the host
  // rounds the beat), its strings Strum Spread apart
  st_mode > 0 ? (
    nheld > 0 ? (
      bb = playing ? b_0 + si * b_inc : st_clock;
      st_clock = bb + b_inc;
      t = bb * spb;
      s = floor(t + 0.000001);
      s != st_s ? (
        st_s > -1000 || t - s < 0.499999 ? st_step(s);
        st_s = s;
      );
    ) : (
      st_s = -1000;
      st_on = 0;
    );
    while (st_on && sc >= st_t0 + st_i * spread_s) ( st_next(); );
  );
  si += 1;
  sc += 1;

  // the strings
  sl = 0; sr = 0;
  v = 0;
  loop(NV,
    v_note[v] >= 0 ? (
      tw = v_tw[v];
      t = v_twk[v] * tw;
      d = v_d0[v] * (1 - t);
      v_tw[v] = tw * twc;
      v_tw[v] < 0.000001 ? v_tw[v] = 0;
      sbuf = SB + v * lb;
      w = v_w[v];
      rp = w - d;
      rp < 0 ? rp += lb;
      i = floor(rp); fr = rp - i;
      i2 = i + 1; i2 >= lb ? i2 = 0;
      x = sbuf[i] + (sbuf[i2] - sbuf[i]) * fr;
      b = v_b[v];
      lp = (1 - b) * x + b * v_lp[v];
      v_lp[v] = lp;
      sv = lp * v_g[v];
      k = v_ek[v];
      k < v_en[v] ? (
        ebuf = EB + v * lb;
        ex = ebuf[k];
        k >= v_pp[v] ? ex -= ebuf[k - v_pp[v]];
        sv += ex * v_amp[v];
        v_ek[v] = k + 1;
      );
      sbuf[w] = sv;
      w += 1;
      w >= lb ? w = 0;
      v_w[v] = w;
      pk = max(abs(sv), v_pk[v] * pkc);
      v_pk[v] = pk;
      e = v_env[v];
      v_pend[v] >= 0 ? e = max(0, e - s_inc) : e = min(1, e + a_inc);
      v_env[v] = e;
      q = v_rel[v];
      v_gate[v] <= 0 ? ( q *= v_fast[v] > 0 ? rf_c : r_c; v_rel[v] = q; );
      y = sv * e;
      y *= q;
      sl += y * v_gl[v];
      sr += y * v_gr[v];
      v_pend[v] >= 0 ? (
        e <= 0 ? v_start(v, v_pend[v], v_pvel[v]);
      ) : (
        q < 0.0001 || (v_ek[v] >= v_en[v] && pk < 0.00002) ? v_note[v] = -1;
      );
    );
    v += 1;
  );

  // the body: three resonances per side (state-variable band-passes)
  x = sl;
  t = x - bl_t1;
  u = bl_a11 * bl_s1 + bl_a21 * t;
  u2 = bl_t1 + bl_a21 * bl_s1 + bl_a31 * t;
  bl_s1 = flush(2 * u - bl_s1);
  bl_t1 = flush(2 * u2 - bl_t1);
  y = bl_k1 * u;
  t = x - bl_t2;
  u = bl_a12 * bl_s2 + bl_a22 * t;
  u2 = bl_t2 + bl_a22 * bl_s2 + bl_a32 * t;
  bl_s2 = flush(2 * u - bl_s2);
  bl_t2 = flush(2 * u2 - bl_t2);
  y += bl_k2 * u;
  t = x - bl_t3;
  u = bl_a13 * bl_s3 + bl_a23 * t;
  u2 = bl_t3 + bl_a23 * bl_s3 + bl_a33 * t;
  bl_s3 = flush(2 * u - bl_s3);
  bl_t3 = flush(2 * u2 - bl_t3);
  y += bl_k3 * u;
  l = x * b_dry + y * b_wet;
  x = sr;
  t = x - br_t1;
  u = br_a11 * br_s1 + br_a21 * t;
  u2 = br_t1 + br_a21 * br_s1 + br_a31 * t;
  br_s1 = flush(2 * u - br_s1);
  br_t1 = flush(2 * u2 - br_t1);
  y = br_k1 * u;
  t = x - br_t2;
  u = br_a12 * br_s2 + br_a22 * t;
  u2 = br_t2 + br_a22 * br_s2 + br_a32 * t;
  br_s2 = flush(2 * u - br_s2);
  br_t2 = flush(2 * u2 - br_t2);
  y += br_k2 * u;
  t = x - br_t3;
  u = br_a13 * br_s3 + br_a23 * t;
  u2 = br_t3 + br_a23 * br_s3 + br_a33 * t;
  br_s3 = flush(2 * u - br_s3);
  br_t3 = flush(2 * u2 - br_t3);
  y += br_k3 * u;
  r = x * b_dry + y * b_wet;

  // DC blocker, level
  y = l - dc_xl + dc_r * dc_yl; dc_xl = l; dc_yl = flush(y); l = y;
  y = r - dc_xr + dc_r * dc_yr; dc_xr = r; dc_yr = flush(y); r = y;
  l *= 0.35;
  r *= 0.35;
  spl0 = l * vol;
  spl1 = r * vol;

@gfx 560 416
  ng_knobs_begin("PLUCK", "INSTRUMENTS", 560, 156, 2, 0);

  // display: the strum pattern (8 steps, the one playing outlined), the body's response
  // (50 Hz to 5 kHz), the strings and the strum, and a keyboard from C2 to C7 with the keys
  // held (marked) and the strings sounding (lit)
  pk_step = st_mode > 0 && nheld > 0 && st_s > -1000 ? st_s - floor(st_s / 8) * 8 : -1;
  st_mode > 0 ? (
    pk_i = 0;
    loop(8,
      pk_x = 24 + pk_i * 64.57;
      pk_c = PT[st_mode * 8 + pk_i];
      ng_col(NG_BG, 1);
      gfx_rect(X(pk_x), Y(66), 60 * ng_s, 30 * ng_s);
      ng_col(pk_i == pk_step ? NG_TEXT : NG_BORDER, 1);
      gfx_rect(X(pk_x), Y(66), 60 * ng_s, 30 * ng_s, 0);
      pk_i == pk_step ? gfx_rect(X(pk_x) + 1, Y(66) + 1, 60 * ng_s - 2, 30 * ng_s - 2, 0);
      pk_c == 1 ? (
        ng_col(NG_ACCENT, 1);
        gfx_triangle(X(pk_x + 22), Y(75), X(pk_x + 38), Y(75), X(pk_x + 30), Y(88));
      ) : pk_c == 2 ? (
        ng_col(NG_ACCENT, 0.75);
        gfx_triangle(X(pk_x + 22), Y(88), X(pk_x + 38), Y(88), X(pk_x + 30), Y(75));
      ) : (
        ng_col(NG_MUTED, 0.6);
        gfx_rect(X(pk_x + 25), Y(80), 10 * ng_s, max(1, 2 * ng_s));
      );
      ng_font(1, 6, 1);
      ng_col(NG_MUTED, 1);
      sprintf(#pk_num, "%d", pk_i + 1);
      ng_txt(#pk_num, pk_x + 5, 72, 0, 0);
      pk_i += 1;
    );
  ) : (
    ng_col(NG_BG, 1);
    gfx_rect(X(24), Y(66), 512 * ng_s, 30 * ng_s);
    ng_col(NG_BORDER, 1);
    gfx_rect(X(24), Y(66), 512 * ng_s, 30 * ng_s, 0);
    ng_font(1, 7.5, 1);
    ng_col(NG_MUTED, 1);
    ng_txt("STRUM OFF: EVERY KEY PLUCKS ITS STRING", 280, 81, 1, 1);
  );

  // the body: the three resonances (as analog band-passes) and the dry sound, -18 to +12 dB
  ng_plot(24, 102, 512, 36);
  ng_grid(8, 2, 0);
  ng_col(NG_ACCENT, 1);
  pk_i = 0;
  loop(97,
    pk_f = 50 * 100 ^ (pk_i / 96);
    pk_re = b_dry; pk_im = 0;
    pk_j = 0;
    loop(3,
      pk_q = pk_f / mb[6 + pk_j * 3];
      pk_a = pk_q / mb[7 + pk_j * 3];
      pk_d = (1 - pk_q * pk_q) ^ 2 + pk_a * pk_a;
      pk_re += b_wet * mb[8 + pk_j * 3] * pk_a * pk_a / pk_d;
      pk_im += b_wet * mb[8 + pk_j * 3] * pk_a * (1 - pk_q * pk_q) / pk_d;
      pk_j += 1;
    );
    pk_x = ng_px + ng_pw * pk_i / 96;
    pk_y = ng_lin_y(10 * log10(max(pk_re * pk_re + pk_im * pk_im, 0.000001)), -12, 12);
    pk_i == 0 ? ng_line_start(pk_x, pk_y) : ng_line_to(pk_x, pk_y);
    pk_i += 1;
  );
  ng_font(1, 6.5, 1);
  ng_col(NG_MUTED, 1);
  ng_txt("BODY", 30, 108, 0, 0.5);
  ng_txt("50 HZ - 5 KHZ", 530, 108, 2, 0.5);

  // the strings and the strum
  pk_cnt = 0;
  pk_i = 0;
  loop(NV, v_note[pk_i] >= 0 ? pk_cnt += 1; pk_i += 1;);
  ng_font(1, 7, 1);
  ng_col(NG_TEXT, 1);
  sprintf(#pk_info, "STRINGS %d / 12", pk_cnt);
  ng_txt(#pk_info, 24, 146, 0, 1);
  ng_col(NG_MUTED, 1);
  st_mode > 0 ? (
    sprintf(#pk_st, "STRUM %s %s, %d MS", st_mode == 1 ? "DOWN" : st_mode == 2 ? "UP" : st_mode == 3 ? "DOWN-UP" : st_mode == 4 ? "FOLK" : "OFFBEAT",
            st_rate == 0 ? "1/4" : st_rate == 1 ? "1/8" : st_rate == 2 ? "1/16" : "1/8 T", slider11);
  ) : strcpy(#pk_st, "STRUM OFF");
  ng_txt(#pk_st, 536, 146, 2, 1);

  // the keyboard from C2 to C7
  pk_ww = 512 / 36; pk_bw = pk_ww * 0.62; pk_bh = 44 * 0.6;
  pk_i = 0; pk_nn = 36;
  loop(61,
    pk_pc = pk_nn - floor(pk_nn / 12) * 12;
    pk_white(pk_pc) ? (
      pk_x = 24 + pk_i * pk_ww;
      pk_on = pk_snd(pk_nn);
      ng_col(pk_on ? NG_ACCENT : 0x2d2b28, 1);
      gfx_rect(X(pk_x + 0.5), Y(156), (pk_ww - 1) * ng_s, 44 * ng_s);
      HL[pk_nn] > 0 ? ( ng_col(pk_on ? NG_BG : NG_TEXT, 1); gfx_rect(X(pk_x + 2.5), Y(158), (pk_ww - 5) * ng_s, 3 * ng_s); );
      pk_pc == 0 ? (
        ng_font(1, 6, 1);
        ng_col(pk_on ? NG_BG : NG_MUTED, 1);
        sprintf(#pk_cl, "C%d", floor(pk_nn / 12) - 1);
        ng_txt(#pk_cl, pk_x + pk_ww / 2, 156 + 44 - 5, 1, 0);
      );
      pk_i += 1;
    );
    pk_nn += 1;
  );
  pk_i = 0; pk_nn = 36;
  loop(61,
    pk_pc = pk_nn - floor(pk_nn / 12) * 12;
    pk_white(pk_pc) ? pk_i += 1 : (
      pk_x = 24 + pk_i * pk_ww - pk_bw / 2;
      pk_on = pk_snd(pk_nn);
      ng_col(NG_CARD, 1);
      gfx_rect(X(pk_x - 1), Y(156), (pk_bw + 2) * ng_s, (pk_bh + 1) * ng_s);
      ng_col(pk_on ? NG_ACCENT : 0x131211, 1);
      gfx_rect(X(pk_x), Y(156), pk_bw * ng_s, pk_bh * ng_s);
      HL[pk_nn] > 0 ? ( ng_col(pk_on ? NG_BG : NG_TEXT, 1); gfx_rect(X(pk_x + 1.5), Y(158), (pk_bw - 3) * ng_s, 3 * ng_s); );
    );
    pk_nn += 1;
  );

  // controls
  ng_row(6);
  ng_select_ctl(1, "MODEL", "NYLON|STEEL|HARP|KOTO|PIPA|BANJO|MUTED|DULCIMER", 0) ? update();
  sprintf(#pk_v2, "%d%%", slider2);
  ng_knob_ctl(2, "PICK POSITION", #pk_v2, 5, 50, 18, 1, 0) ? update();
  sprintf(#pk_v3, "%d%%", slider3);
  ng_knob_ctl(3, "BRIGHTNESS", #pk_v3, 0, 100, 50, 1, 0) ? update();
  sprintf(#pk_v4, "%d%%", slider4);
  ng_knob_ctl(4, "DECAY", #pk_v4, 10, 300, 100, 1, 0) ? update();
  slider5 >= 1000 ? sprintf(#pk_v5, "%.2f s", slider5 / 1000) : sprintf(#pk_v5, "%d ms", slider5);
  ng_knob_ctl_log(5, "RELEASE", #pk_v5, 10, 2000, 150, 1) ? update();
  sprintf(#pk_v6, "%d%%", slider6);
  ng_knob_ctl(6, "BODY", #pk_v6, 0, 100, 50, 1, 0) ? update();

  ng_row(6);
  sprintf(#pk_v7, "%d%%", slider7);
  ng_knob_ctl(7, "WIDTH", #pk_v7, 0, 100, 50, 1, 0) ? update();
  sprintf(#pk_v8, "%d%%", slider8);
  ng_knob_ctl(8, "VELOCITY", #pk_v8, 0, 100, 60, 1, 0) ? update();
  ng_select_ctl(9, "STRUM", "OFF|DOWN|UP|DOWN-UP|FOLK|OFFBEAT", 0) ? update();
  ng_select_ctl(10, "STRUM RATE", "1/4|1/8|1/16|1/8 T", 0) ? update();
  sprintf(#pk_v11, "%d ms", slider11);
  ng_knob_ctl(11, "SPREAD", #pk_v11, 0, 100, 20, 1, 0) ? update();
  sprintf(#pk_v12, "%+.1f dB", slider12);
  ng_knob_ctl(12, "VOLUME", #pk_v12, -24, 12, 0, 0.1, 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
