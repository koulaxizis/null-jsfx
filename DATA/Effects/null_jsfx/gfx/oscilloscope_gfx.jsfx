desc:NULL Oscilloscope GFX
author: Christos Koulaxizis
tags: oscilloscope scope waveform trigger time domain wave shape phase meter analyzer metering tempo sync gui
//category: Advanced
//NULL JSFX v2.9 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:20<1,2000,0.1:log>-Time (ms)
slider2:0<0,6,1{Off,1/16,1/8,1/4,1/2,1 Bar,2 Bars}>-Sync
slider3:0<0,2,1{Auto,Normal,Free}>-Trigger
slider4:0<0,1,1{Rising,Falling}>-Edge
slider5:0<-1,1,0.01>-Trigger Level
slider6:0<0,2,1{Mid,Left/Right,Side}>-View
slider7:0<-24,24,0.5>-Gain (dB)
slider8:0<0,1,1{Off,On}>-Hold
slider9:0<0,1,1{Stereo,View}>-Listen

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  // NULL Oscilloscope (../oscilloscope.jsfx) with its own interface: same audio code, plus the
  // capture in @sample and @gfx.
  // Waveform display. The audio passes through untouched (bit-exact); every slider but Listen
  // only changes what the interface shows:
  //   - Time is the width of the screen, or Sync sets it from the tempo (1/16 to 2 bars of 4/4)
  //   - Trigger Auto waits for the signal to cross Trigger Level in the Edge direction, and
  //     draws anyway when nothing crosses for two screens; Normal only draws on a crossing (a
  //     steady picture of a periodic wave); Free draws screen after screen
  //   - View shows the mid ((L + R) / 2), left and right over each other, or the side
  //     ((L - R) / 2); Gain scales the picture (and the trigger compares after it)
  //   - Hold freezes the last screen
  //   - Listen View plays what the screen shows: the mid or the side on both channels (Left/Right
  //     plays the stereo signal); Stereo leaves the audio untouched

  // The capture: the screen is OS_N columns, each the minimum and maximum of its samples (trace
  // A = mid, left or side, trace B = right); a finished screen is copied to the display arrays.
  OS_N = 512;
  CAN = 1000000; CAX = CAN + OS_N; CBN = CAX + OS_N; CBX = CBN + OS_N;   // capturing
  DAN = CBX + OS_N; DAX = DAN + OS_N; DBN = DAX + OS_N; DBX = DBN + OS_N; // on screen
  memset(CAN, 0, OS_N * 8);
  os_cap = 0;                  // capturing a screen
  os_n = 0;                    // samples into it
  os_col = 0;                  // its column now
  os_wait = 0;                 // samples since the last screen
  os_prev = 0;                 // the trigger signal one sample ago
  os_pa = os_pb = 0;           // the last captured values (to fill skipped columns)
  os_seen = 0;                 // a screen was triggered by a crossing (for the status text)
  gfx_ext_retina = 1;

  function update()
  (
    os_view = floor(slider6 + 0.5);
    os_listen = slider9 >= 0.5 && os_view != 1;
    os_g = 10 ^ (slider7 / 20);
    os_trig = floor(slider3 + 0.5);
    os_lvl = slider5;
    os_fall = slider4 >= 0.5;
    os_hold = slider8 >= 0.5;
    os_sync = floor(slider2 + 0.5);
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 11;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1); ng_hist_add(2); ng_hist_add(3); ng_hist_add(4); ng_hist_add(5); ng_hist_add(6); ng_hist_add(7); ng_hist_add(8); ng_hist_add(9);
  ng_hist_init();

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 20); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); );
    p == 1 ? ( ng_slider_set(1, 5); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); );
    p == 2 ? ( ng_slider_set(1, 50); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); );
    p == 3 ? ( ng_slider_set(1, 200); ng_slider_set(2, 0); ng_slider_set(3, 1); ng_slider_set(4, 0); ng_slider_set(5, 0.3); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); );
    p == 4 ? ( ng_slider_set(1, 2000); ng_slider_set(2, 0); ng_slider_set(3, 2); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); );
    p == 5 ? ( ng_slider_set(1, 20); ng_slider_set(2, 3); ng_slider_set(3, 2); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); );
    p == 6 ? ( ng_slider_set(1, 20); ng_slider_set(2, 5); ng_slider_set(3, 2); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); );
    p == 7 ? ( ng_slider_set(1, 10); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 1); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); );
    p == 8 ? ( ng_slider_set(1, 20); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 2); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 1); );
    p == 9 ? ( ng_slider_set(1, 20); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 18); ng_slider_set(8, 0); ng_slider_set(9, 0); );
    p == 10 ? ( ng_slider_set(1, 20); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 1); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 20) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 5) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 50) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 200) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0.3) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 2000) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 2) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 20) && ng_pre_eq(slider2, 3) && ng_pre_eq(slider3, 2) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 20) && ng_pre_eq(slider2, 5) && ng_pre_eq(slider3, 2) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 10) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 1) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 20) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 2) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 1) ? m = 8;
    m < 0 && ng_pre_eq(slider1, 20) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 18) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) ? m = 9;
    m < 0 && ng_pre_eq(slider1, 20) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) ? m = 10;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Waveform Close-Up";
    p == 2 ? s = "Bass Cycle";
    p == 3 ? s = "Kick Shape";
    p == 4 ? s = "Envelope Overview";
    p == 5 ? s = "One Beat";
    p == 6 ? s = "One Bar";
    p == 7 ? s = "Stereo Phase Check";
    p == 8 ? s = "Side Only";
    p == 9 ? s = "Quiet Signal";
    p == 10 ? s = "Falling Edge";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@block
  // the screen's width in samples: Time, or Sync beats (1/16 note = 0.25) at the tempo
  os_win = os_sync > 0 ? (0.25 * 2 ^ (os_sync - 1)) * 60 / max(tempo, 1) * srate : slider1 / 1000 * srate;
  os_win = max(16, floor(os_win));

@sample
  // capture (display only; the audio is not touched)
  os_l = spl0 * os_g; os_r = spl1 * os_g;
  os_src = os_view == 1 ? os_l : os_view == 2 ? (os_l - os_r) * 0.5 : (os_l + os_r) * 0.5;
  !os_cap && !os_hold ? (
    os_wait += 1;
    os_edge = os_fall ? os_prev > os_lvl && os_src <= os_lvl : os_prev < os_lvl && os_src >= os_lvl;
    os_trig == 2 || os_edge || (os_trig == 0 && os_wait >= 2 * os_win) ? (
      os_cap = 1; os_n = 0; os_col = 0; os_seen = os_edge;
      CAN[0] = CAX[0] = os_pa = os_src; CBN[0] = CBX[0] = os_pb = os_r;
    );
  );
  os_cap ? (
    os_c = min(OS_N - 1, floor(os_n * OS_N / os_win));
    os_c > os_col ? (
      // into a new column; columns skipped (a screen shorter than OS_N samples) get the line
      // from the last value to this one
      os_k = os_col + 1;
      loop(os_c - os_col,
        os_t = (os_k - os_col) / (os_c - os_col);
        CAN[os_k] = CAX[os_k] = os_pa + (os_src - os_pa) * os_t;
        CBN[os_k] = CBX[os_k] = os_pb + (os_r - os_pb) * os_t;
        os_k += 1;
      );
      os_col = os_c;
    ) : (
      CAN[os_c] = min(CAN[os_c], os_src); CAX[os_c] = max(CAX[os_c], os_src);
      CBN[os_c] = min(CBN[os_c], os_r); CBX[os_c] = max(CBX[os_c], os_r);
    );
    os_pa = os_src; os_pb = os_r;
    os_n += 1;
    os_n >= os_win ? (
      // a full screen: the columns after the last sample keep its value, then to the display
      os_k = os_col + 1;
      loop(OS_N - 1 - os_col, CAN[os_k] = CAX[os_k] = os_pa; CBN[os_k] = CBX[os_k] = os_pb; os_k += 1;);
      memcpy(DAN, CAN, OS_N * 4);
      os_cap = 0; os_wait = 0;
    );
  );
  os_prev = os_src;
  os_listen ? (
    os_o = os_view == 2 ? (spl0 - spl1) * 0.5 : (spl0 + spl1) * 0.5;
    spl0 = os_o;
    spl1 = os_o;
  );

@gfx 560 500
  ng_knobs_begin("OSCILLOSCOPE", "ADVANCED", 560, 240, 2, 0);

  // the screen: 10 x 8 divisions, the trigger level, trace A (and B in Left/Right)
  ng_plot(ng_vx + 4, ng_vy + 18, ng_vw - 8, ng_vh - 22);
  ng_grid(10, 8, 1);
  ng_col(NG_MUTED, 0.5);
  os_y = ng_py + ng_ph * (0.5 - os_lvl * 0.5);
  os_trig != 2 ? gfx_line(ng_px, os_y, ng_px + ng_pw, os_y, 0);
  os_tr = 0;
  loop(os_view == 1 ? 2 : 1,
    os_bn = os_tr ? DBN : DAN; os_bx = os_tr ? DBX : DAX;
    ng_col(os_tr ? NG_TEXT : NG_ACCENT, os_tr ? 0.55 : 1);
    os_k = 0;
    loop(OS_N,
      os_xx = ng_px + ng_pw * os_k / (OS_N - 1);
      os_y1 = ng_py + ng_ph * (0.5 - max(-1, min(1, os_bx[os_k])) * 0.5);
      os_y2 = ng_py + ng_ph * (0.5 - max(-1, min(1, os_bn[os_k])) * 0.5);
      os_ym = (os_y1 + os_y2) * 0.5;
      os_k > 0 ? gfx_line(os_lx, os_ly, os_xx, os_ym, 1);
      os_y2 - os_y1 >= 1 ? gfx_line(os_xx, os_y1, os_xx, os_y2, 0);
      os_lx = os_xx; os_ly = os_ym;
      os_k += 1;
    );
    os_tr += 1;
  );

  // the time per division, what is shown and the trigger's state
  ng_font(1, 7, 1);
  ng_col(NG_ACCENT, 1);
  os_div = os_win / srate * 100;   // ms per division (10 divisions)
  os_div >= 100 ? sprintf(#os_t, "%.2f S/DIV", os_div / 1000) : os_div >= 1 ? sprintf(#os_t, "%.1f MS/DIV", os_div) : sprintf(#os_t, "%.2f MS/DIV", os_div);
  ng_txt(#os_t, ng_vx + 6, ng_vy + 8, 0, 1);
  ng_col(NG_MUTED, 1);
  ng_txt(os_view == 1 ? "LEFT / RIGHT" : os_view == 2 ? "SIDE" : "MID", ng_vx + ng_vw / 2, ng_vy + 8, 1, 1);
  ng_txt(os_hold ? "HOLD" : os_trig == 2 ? "FREE" : os_cap ? "RUN" : os_trig == 1 || os_wait < os_win ? "WAIT" : "AUTO", ng_vx + ng_vw - 6, ng_vy + 8, 2, 1);

  ng_row(5);
  slider1 >= 100 ? sprintf(#os_v1, "%d ms", slider1) : sprintf(#os_v1, "%.1f ms", slider1);
  ng_knob_ctl_log(1, "TIME", #os_v1, 1, 2000, 20, 0.1) ? update();
  ng_select_ctl(2, "SYNC", "OFF|1/16|1/8|1/4|1/2|1 BAR|2 BARS", 0) ? update();
  ng_select_ctl(3, "TRIGGER", "AUTO|NORMAL|FREE", 0) ? update();
  ng_select_ctl(4, "EDGE", "RISING|FALLING", 0) ? update();
  sprintf(#os_v5, "%+.2f", slider5);
  ng_knob_ctl(5, "LEVEL", #os_v5, -1, 1, 0, 0.01, 1) ? update();

  ng_row(4);
  ng_select_ctl(6, "VIEW", "MID|L / R|SIDE", 0) ? update();
  sprintf(#os_v7, "%+.1f dB", slider7);
  ng_knob_ctl(7, "GAIN", #os_v7, -24, 24, 0, 0.5, 1) ? update();
  ng_select_ctl(8, "HOLD", "OFF|ON", 0) ? update();
  ng_select_ctl(9, "LISTEN", "STEREO|VIEW", 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
