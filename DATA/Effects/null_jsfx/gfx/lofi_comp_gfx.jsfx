desc:NULL Lo-Fi Comp GFX
author: Christos Koulaxizis
tags: lofi lo-fi compressor pumping squash sample rate reduction bitcrusher wow drift beats vintage sampler gui
//category: Essentials
//NULL JSFX v4.2.1 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:50<0,100,1>-Squash (%)
slider2:150<20,1000,1>-Release (ms)
slider3:32000<4000,48000,10>-Sample Rate (Hz)
slider4:12<4,16,1>-Bits
slider5:20<0,100,1>-Wow (%)
slider6:100<0,100,1>-Mix (%)
slider7:0<-24,12,0.1>-Output (dB)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // NULL Lo-Fi Comp (../lofi_comp.jsfx) with its own interface: same audio code, plus @gfx.
  // The lo-fi beat sound in one effect: an over-the-top pumping compressor (threshold -10 to
  // -40 dBFS, ratio 2:1 to 20:1, 1 ms attack, its own make-up), then a slow pitch drift (Wow:
  // two slow LFOs move a short delay, up to 4 ms), then an old sampler: a low-pass and a
  // sample-and-hold at Sample Rate (off at or above the project rate) and quantising to Bits.
  lf_n = ceil(srate * 0.01) + 4;
  lf_bl = 0;
  lf_br = lf_n;
  memset(0, 0, lf_n * 2); freembuf(lf_n * 2);
  lf_wp = 0;
  lf_att = 1 - exp(-1 / (0.001 * srate));
  lf_e = 0;
  lf_p1 = lf_p2 = 0;
  lf_ph = 1;
  lf_hl = lf_hr = 0;
  lf_al = lf_ar = 0;

  // the value d samples behind the write position (0 = the sample just written), interpolated
  function lf_read(b, d) local(rp, i0, i1, fr)
  (
    rp = lf_wp - d;
    rp < 0 ? rp += lf_n;
    rp >= lf_n ? rp -= lf_n;     // a tiny negative rp can round up to lf_n
    i0 = floor(rp);
    fr = rp - i0;
    i1 = i0 + 1;
    i1 >= lf_n ? i1 = 0;
    b[i0] + (b[i1] - b[i0]) * fr;
  );
  gfx_ext_retina = 1;

  function update()
  (
    lf_s = slider1 / 100;
    lf_thr = -10 - 30 * lf_s;
    lf_ratio = 2 + 18 * lf_s;
    lf_mu = 10 ^ (-lf_thr * (1 - 1 / lf_ratio) * (0.35 + 0.35 * lf_s) / 20);
    lf_rel = 1 - exp(-1 / (slider2 * 0.001 * srate));
    lf_on = slider3 < srate;
    lf_step = slider3 / srate;
    lf_lpc = 1 - exp(-2 * $pi * min(0.45 * slider3, 0.45 * srate) / srate);
    lf_q = 2 ^ (slider4 - 1);
    lf_depth = slider5 / 100 * 0.002 * srate;
    lf_mix = slider6 / 100;
    lf_out = 10 ^ (slider7 / 20);
  );

  // the display: the level out (dB) for a steady level in (dB), make-up included
  function lf_curve(x) ( (x > lf_thr ? lf_thr + (x - lf_thr) / lf_ratio : x) + 20 * log10(lf_mu); );
  function lf_hz_txt(f) ( f >= srate ? strcpy(#lf_v, "OFF") : sprintf(#lf_v, "%.1f kHz", f / 1000); #lf_v; );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 13;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1); ng_hist_add(2); ng_hist_add(3); ng_hist_add(4); ng_hist_add(5); ng_hist_add(6); ng_hist_add(7);
  ng_hist_init();
  ng_dice_add(1, 0, 100, 1, 0); ng_dice_add(2, 20, 1000, 1, 0); ng_dice_add(3, 4000, 48000, 10, 0); ng_dice_add(4, 4, 16, 1, 0); ng_dice_add(5, 0, 100, 1, 0);

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 50); ng_slider_set(2, 150); ng_slider_set(3, 32000); ng_slider_set(4, 12); ng_slider_set(5, 20); ng_slider_set(6, 100); ng_slider_set(7, 0); );
    p == 1 ? ( ng_slider_set(1, 70); ng_slider_set(2, 120); ng_slider_set(3, 26000); ng_slider_set(4, 12); ng_slider_set(5, 10); ng_slider_set(6, 100); ng_slider_set(7, 0); );
    p == 2 ? ( ng_slider_set(1, 45); ng_slider_set(2, 250); ng_slider_set(3, 22000); ng_slider_set(4, 10); ng_slider_set(5, 45); ng_slider_set(6, 100); ng_slider_set(7, 0); );
    p == 3 ? ( ng_slider_set(1, 90); ng_slider_set(2, 80); ng_slider_set(3, 32000); ng_slider_set(4, 14); ng_slider_set(5, 0); ng_slider_set(6, 100); ng_slider_set(7, 0); );
    p == 4 ? ( ng_slider_set(1, 55); ng_slider_set(2, 150); ng_slider_set(3, 26040); ng_slider_set(4, 12); ng_slider_set(5, 15); ng_slider_set(6, 100); ng_slider_set(7, 0); );
    p == 5 ? ( ng_slider_set(1, 35); ng_slider_set(2, 300); ng_slider_set(3, 48000); ng_slider_set(4, 16); ng_slider_set(5, 60); ng_slider_set(6, 100); ng_slider_set(7, 0); );
    p == 6 ? ( ng_slider_set(1, 80); ng_slider_set(2, 100); ng_slider_set(3, 11000); ng_slider_set(4, 8); ng_slider_set(5, 20); ng_slider_set(6, 100); ng_slider_set(7, 0); );
    p == 7 ? ( ng_slider_set(1, 60); ng_slider_set(2, 180); ng_slider_set(3, 16000); ng_slider_set(4, 10); ng_slider_set(5, 10); ng_slider_set(6, 70); ng_slider_set(7, 0); );
    p == 8 ? ( ng_slider_set(1, 100); ng_slider_set(2, 60); ng_slider_set(3, 48000); ng_slider_set(4, 16); ng_slider_set(5, 0); ng_slider_set(6, 40); ng_slider_set(7, 0); );
    p == 9 ? ( ng_slider_set(1, 75); ng_slider_set(2, 120); ng_slider_set(3, 8000); ng_slider_set(4, 8); ng_slider_set(5, 5); ng_slider_set(6, 100); ng_slider_set(7, 0); );
    p == 10 ? ( ng_slider_set(1, 30); ng_slider_set(2, 400); ng_slider_set(3, 22000); ng_slider_set(4, 12); ng_slider_set(5, 85); ng_slider_set(6, 100); ng_slider_set(7, 0); );
    p == 11 ? ( ng_slider_set(1, 50); ng_slider_set(2, 150); ng_slider_set(3, 6000); ng_slider_set(4, 6); ng_slider_set(5, 25); ng_slider_set(6, 100); ng_slider_set(7, 0); );
    p == 12 ? ( ng_slider_set(1, 20); ng_slider_set(2, 200); ng_slider_set(3, 36000); ng_slider_set(4, 14); ng_slider_set(5, 8); ng_slider_set(6, 100); ng_slider_set(7, 0); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 50) && ng_pre_eq(slider2, 150) && ng_pre_eq(slider3, 32000) && ng_pre_eq(slider4, 12) && ng_pre_eq(slider5, 20) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 70) && ng_pre_eq(slider2, 120) && ng_pre_eq(slider3, 26000) && ng_pre_eq(slider4, 12) && ng_pre_eq(slider5, 10) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 45) && ng_pre_eq(slider2, 250) && ng_pre_eq(slider3, 22000) && ng_pre_eq(slider4, 10) && ng_pre_eq(slider5, 45) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 90) && ng_pre_eq(slider2, 80) && ng_pre_eq(slider3, 32000) && ng_pre_eq(slider4, 14) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 55) && ng_pre_eq(slider2, 150) && ng_pre_eq(slider3, 26040) && ng_pre_eq(slider4, 12) && ng_pre_eq(slider5, 15) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 35) && ng_pre_eq(slider2, 300) && ng_pre_eq(slider3, 48000) && ng_pre_eq(slider4, 16) && ng_pre_eq(slider5, 60) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 80) && ng_pre_eq(slider2, 100) && ng_pre_eq(slider3, 11000) && ng_pre_eq(slider4, 8) && ng_pre_eq(slider5, 20) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 60) && ng_pre_eq(slider2, 180) && ng_pre_eq(slider3, 16000) && ng_pre_eq(slider4, 10) && ng_pre_eq(slider5, 10) && ng_pre_eq(slider6, 70) && ng_pre_eq(slider7, 0) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 100) && ng_pre_eq(slider2, 60) && ng_pre_eq(slider3, 48000) && ng_pre_eq(slider4, 16) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 40) && ng_pre_eq(slider7, 0) ? m = 8;
    m < 0 && ng_pre_eq(slider1, 75) && ng_pre_eq(slider2, 120) && ng_pre_eq(slider3, 8000) && ng_pre_eq(slider4, 8) && ng_pre_eq(slider5, 5) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) ? m = 9;
    m < 0 && ng_pre_eq(slider1, 30) && ng_pre_eq(slider2, 400) && ng_pre_eq(slider3, 22000) && ng_pre_eq(slider4, 12) && ng_pre_eq(slider5, 85) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) ? m = 10;
    m < 0 && ng_pre_eq(slider1, 50) && ng_pre_eq(slider2, 150) && ng_pre_eq(slider3, 6000) && ng_pre_eq(slider4, 6) && ng_pre_eq(slider5, 25) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) ? m = 11;
    m < 0 && ng_pre_eq(slider1, 20) && ng_pre_eq(slider2, 200) && ng_pre_eq(slider3, 36000) && ng_pre_eq(slider4, 14) && ng_pre_eq(slider5, 8) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) ? m = 12;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Lo-Fi Drum Bus";
    p == 2 ? s = "Dusty Keys";
    p == 3 ? s = "Pumping Beat";
    p == 4 ? s = "SP Style Sampler";
    p == 5 ? s = "Cassette Drift";
    p == 6 ? s = "Crushed Loop";
    p == 7 ? s = "Vocal Chop Grit";
    p == 8 ? s = "Parallel Squash";
    p == 9 ? s = "Telephone Beat";
    p == 10 ? s = "Warbly Pad";
    p == 11 ? s = "Toy Sampler";
    p == 12 ? s = "Gentle Lo-Fi Master";
    s;
  );

  // the hint line under the controls: a short help text per slider (from tools/site_content.json)
  function ng_hint_text(i) local(s)
  (
    s = "";
    i == 1 ? s = "How hard it pumps: threshold from -10 to -40 dBFS and ratio from 2:1 to 20:1 together, with its own";
    i == 2 ? s = "How fast the compressor lets go: short values pump with the beat, long values hold the sound down";
    i == 3 ? s = "Sample rate of the old sampler (low-pass and sample-and-hold); at or above the project rate it is off";
    i == 4 ? s = "Bit depth of the quantiser: lower values add grain and noise";
    i == 5 ? s = "Slow pitch drift from two slow LFOs moving a short delay (up to 4 ms)";
    i == 6 ? s = "Blend with the dry signal";
    i == 7 ? s = "Output level";
    s;
  );

  function ng_presets() local(i)
  (
    ng_hint_i > 0 && !ng_pre_open ? ng_hint(ng_hint_text(ng_hint_i));
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  lf_xl = spl0;
  lf_xr = spl1;
  // compressor (stereo-linked peak detector)
  lf_in = max(abs(lf_xl), abs(lf_xr));
  lf_e += (lf_in - lf_e) * (lf_in > lf_e ? lf_att : lf_rel);
  lf_over = 20 * log10(max(lf_e, 0.000001)) - lf_thr;
  lf_g = (lf_over > 0 ? 10 ^ (-lf_over * (1 - 1 / lf_ratio) / 20) : 1) * lf_mu;
  // wow: two slow LFOs (0.6 and 0.17 Hz) move a short delay
  lf_bl[lf_wp] = lf_xl * lf_g;
  lf_br[lf_wp] = lf_xr * lf_g;
  lf_p1 += 0.6 / srate; lf_p1 >= 1 ? lf_p1 -= 1;
  lf_p2 += 0.17 / srate; lf_p2 >= 1 ? lf_p2 -= 1;
  lf_d = lf_depth * (1 + 0.6 * sin(2 * $pi * lf_p1) + 0.4 * sin(2 * $pi * lf_p2));
  lf_l = lf_read(lf_bl, lf_d);
  lf_r = lf_read(lf_br, lf_d);
  lf_wp += 1;
  lf_wp >= lf_n ? lf_wp = 0;
  // old sampler: low-pass, sample-and-hold, bits
  lf_on ? (
    lf_al += (lf_l - lf_al) * lf_lpc;
    lf_ar += (lf_r - lf_ar) * lf_lpc;
    lf_ph += lf_step;
    lf_ph >= 1 ? ( lf_ph -= 1; lf_hl = lf_al; lf_hr = lf_ar; );
    lf_l = lf_hl;
    lf_r = lf_hr;
  );
  lf_l = floor(lf_l * lf_q + 0.5) / lf_q;
  lf_r = floor(lf_r * lf_q + 0.5) / lf_q;
  spl0 = (lf_xl + (lf_l - lf_xl) * lf_mix) * lf_out;
  spl1 = (lf_xr + (lf_r - lf_xr) * lf_mix) * lf_out;

@gfx 480 380
  ng_knobs_begin("LO-FI COMP", "ESSENTIALS", 480, 120, 2, 0);

  // display, left: the compressor's curve, level in across and out up (-60 to 0 dB, make-up
  // included); right: the gain reduction now
  ng_plot(ng_vx + 26, ng_vy + 4, 210, ng_vh - 20);
  ng_grid(4, 4, 0);
  ng_font(4, 8, 0);
  ng_col(NG_MUTED, 1);
  ng_ptxt("0", ng_px - 6 * ng_s, ng_py, 2);
  ng_ptxt("-30", ng_px - 6 * ng_s, ng_py + ng_ph / 2, 2);
  ng_ptxt("-60", ng_px - 6 * ng_s, ng_py + ng_ph, 2);
  ng_ptxt("IN", ng_px, ng_py + ng_ph + 10 * ng_s, 0);
  sprintf(#lf_t, "%d:1", floor(lf_ratio + 0.5));
  ng_ptxt(#lf_t, ng_px + ng_pw, ng_py + ng_ph + 10 * ng_s, 2);
  ng_col(NG_ACCENT, 1);
  lf_i = 0;
  loop(floor(ng_pw) + 1,
    lf_y = ng_lin_y(lf_curve(-60 + 60 * lf_i / ng_pw), -60, 0);
    lf_i == 0 ? ng_line_start(ng_px, lf_y) : ng_line_to(ng_px + lf_i, lf_y);
    lf_i += 1;
  );
  ng_meter(276, 84, 180, 10, "IN", ng_to_db(lf_e), lf_thr, -60);
  ng_gr_meter(276, 114, 180, 10, "GR", max(0, (20 * log10(max(lf_e, 0.000001)) - lf_thr) * (1 - 1 / lf_ratio)), 40);

  ng_row(4);
  sprintf(#v1, "%d%%", slider1);
  ng_knob_ctl(1, "SQUASH", #v1, 0, 100, 50, 1, 0) ? update();
  sprintf(#v2, "%d ms", slider2);
  ng_knob_ctl(2, "RELEASE", #v2, 20, 1000, 150, 1, 0) ? update();
  ng_knob_ctl(3, "RATE", lf_hz_txt(slider3), 4000, 48000, 32000, 10, 0) ? update();
  sprintf(#v4, "%d", slider4);
  ng_knob_ctl(4, "BITS", #v4, 4, 16, 12, 1, 0) ? update();
  ng_row(3);
  sprintf(#v5, "%d%%", slider5);
  ng_knob_ctl(5, "WOW", #v5, 0, 100, 20, 1, 0) ? update();
  sprintf(#v6, "%d%%", slider6);
  ng_knob_ctl(6, "MIX", #v6, 0, 100, 100, 1, 0) ? update();
  sprintf(#v7, "%.1f dB", slider7);
  ng_knob_ctl(7, "OUTPUT", #v7, -24, 12, 0, 0.1, 1) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
