desc:NULL Glue Comp GFX
author: Christos Koulaxizis
tags: compressor bus glue mix buss console stereo link auto release parallel sidechain hpf gui
//category: Essentials
//NULL JSFX v2.7 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:-10<-40,0,0.1>-Threshold (dB)
slider2:0<0,2,1{2,4,10}>-Ratio
slider3:4<0,5,1{0.1 ms,0.3 ms,1 ms,3 ms,10 ms,30 ms}>-Attack
slider4:4<0,4,1{0.1 s,0.3 s,0.6 s,1.2 s,Auto}>-Release
slider5:0<0,20,0.1>-Makeup (dB)
slider6:100<0,100,1>-Mix (%)
slider7:0<0,300,1>-Sidechain HPF (Hz)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // NULL Glue Comp (../glue_comp.jsfx) with its own interface: same audio code, plus @gfx.
  // A stereo bus compressor for gluing a mix or a group together. Both channels share one
  // peak detector (stereo linked, so the image never shifts), the gain computer has a 4 dB
  // soft knee, and the gain reduction is smoothed in dB with stepped attack and release
  // times. Auto release follows the program: a fast envelope (80 ms) recovers from short
  // peaks while a slow one (0.5 s in, 1.5 s out) holds the reduction under dense passages,
  // and the deeper of the two wins. Sidechain HPF (0 = off) keeps the low end from pumping
  // the detector; Mix blends the dry signal back in (parallel compression) after Makeup.
  hl = hr = 0;
  grf = grs = gr = 0;
  gc_rel = exp(-1 / (0.3 * srate));
  gc_in = gc_out = 0;
  gfx_ext_retina = 1;

  function update()
  (
    thr = slider1;
    slope = 1 - 1 / (slider2 == 0 ? 2 : slider2 == 1 ? 4 : 10);
    att = slider3 == 0 ? 0.1 : slider3 == 1 ? 0.3 : slider3 == 2 ? 1 : slider3 == 3 ? 3 : slider3 == 4 ? 10 : 30;
    rel = slider4 == 0 ? 0.1 : slider4 == 1 ? 0.3 : slider4 == 2 ? 0.6 : slider4 == 3 ? 1.2 : 0.08;
    rel_auto = slider4 >= 4;
    ca = 1 - exp(-1 / (att * 0.001 * srate));
    cr = 1 - exp(-1 / (rel * srate));
    csa = 1 - exp(-1 / (0.5 * srate));
    csr = 1 - exp(-1 / (1.5 * srate));
    mk = 10 ^ (slider5 / 20);
    mix = slider6 / 100;
    hpf = slider7 > 0;
    ch = exp(-2 * $pi * min(max(slider7, 1), 0.45 * srate) / srate);
  );

  // the static curve: output level in dB for a steady input level d (Makeup included)
  function gc_curve(d) local(x)
  (
    x = d - thr;
    d - (x <= -2 ? 0 : x < 2 ? slope * (x + 2) * (x + 2) / 8 : slope * x) + slider5;
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 7;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1); ng_hist_add(2); ng_hist_add(3); ng_hist_add(4); ng_hist_add(5); ng_hist_add(6); ng_hist_add(7);
  ng_hist_init();

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, -10); ng_slider_set(2, 0); ng_slider_set(3, 4); ng_slider_set(4, 4); ng_slider_set(5, 0); ng_slider_set(6, 100); ng_slider_set(7, 0); );
    p == 1 ? ( ng_slider_set(1, -12); ng_slider_set(2, 0); ng_slider_set(3, 4); ng_slider_set(4, 4); ng_slider_set(5, 2); ng_slider_set(6, 100); ng_slider_set(7, 0); );
    p == 2 ? ( ng_slider_set(1, -18); ng_slider_set(2, 1); ng_slider_set(3, 5); ng_slider_set(4, 1); ng_slider_set(5, 4); ng_slider_set(6, 100); ng_slider_set(7, 80); );
    p == 3 ? ( ng_slider_set(1, -30); ng_slider_set(2, 2); ng_slider_set(3, 1); ng_slider_set(4, 1); ng_slider_set(5, 8); ng_slider_set(6, 40); ng_slider_set(7, 0); );
    p == 4 ? ( ng_slider_set(1, -8); ng_slider_set(2, 0); ng_slider_set(3, 5); ng_slider_set(4, 4); ng_slider_set(5, 1); ng_slider_set(6, 100); ng_slider_set(7, 100); );
    p == 5 ? ( ng_slider_set(1, -16); ng_slider_set(2, 1); ng_slider_set(3, 3); ng_slider_set(4, 2); ng_slider_set(5, 3); ng_slider_set(6, 100); ng_slider_set(7, 0); );
    p == 6 ? ( ng_slider_set(1, -24); ng_slider_set(2, 2); ng_slider_set(3, 3); ng_slider_set(4, 0); ng_slider_set(5, 6); ng_slider_set(6, 100); ng_slider_set(7, 0); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, -10) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 4) && ng_pre_eq(slider4, 4) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, -12) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 4) && ng_pre_eq(slider4, 4) && ng_pre_eq(slider5, 2) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, -18) && ng_pre_eq(slider2, 1) && ng_pre_eq(slider3, 5) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 4) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 80) ? m = 2;
    m < 0 && ng_pre_eq(slider1, -30) && ng_pre_eq(slider2, 2) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 8) && ng_pre_eq(slider6, 40) && ng_pre_eq(slider7, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, -8) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 5) && ng_pre_eq(slider4, 4) && ng_pre_eq(slider5, 1) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 100) ? m = 4;
    m < 0 && ng_pre_eq(slider1, -16) && ng_pre_eq(slider2, 1) && ng_pre_eq(slider3, 3) && ng_pre_eq(slider4, 2) && ng_pre_eq(slider5, 3) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) ? m = 5;
    m < 0 && ng_pre_eq(slider1, -24) && ng_pre_eq(slider2, 2) && ng_pre_eq(slider3, 3) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 6) && ng_pre_eq(slider6, 100) && ng_pre_eq(slider7, 0) ? m = 6;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Mix Bus Glue";
    p == 2 ? s = "Drum Bus Punch";
    p == 3 ? s = "Parallel Drums";
    p == 4 ? s = "Gentle Master";
    p == 5 ? s = "Vocal Group";
    p == 6 ? s = "Pumping Bus";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  // detector key: the track, high-passed (one pole) when Sidechain HPF is on
  kl = spl0;
  kr = spl1;
  hpf ? (
    hl = (1 - ch) * kl + ch * hl;
    hr = (1 - ch) * kr + ch * hr;
    kl -= hl;
    kr -= hr;
  );
  lv = 20 * log10(max(max(abs(kl), abs(kr)), 0.000001));
  // gain computer: 4 dB soft knee centred on Threshold
  x = lv - thr;
  tg = x <= -2 ? 0 : x < 2 ? slope * (x + 2) * (x + 2) / 8 : slope * x;
  grf += (tg - grf) * (tg > grf ? ca : cr);
  grf < 0.000000001 ? grf = 0;
  rel_auto ? (
    grs += (tg - grs) * (tg > grs ? csa : csr);
    grs < 0.000000001 ? grs = 0;
    gr = max(grf, grs);
  ) : (
    gr = grf;
  );
  g = 1 - mix + mix * mk * 10 ^ (-gr / 20);
  spl0 *= g;
  spl1 *= g;

  // interface only: meters (read the audio state, never change it)
  gc_lv = max(abs(spl0), abs(spl1));
  gc_out = gc_lv > gc_out ? gc_lv : gc_out * gc_rel;
  gc_kv = max(abs(kl), abs(kr));
  gc_in = gc_kv > gc_in ? gc_kv : gc_in * gc_rel;

@gfx 480 380
  ng_knobs_begin("GLUE COMP", "ESSENTIALS", 480, 120, 2, 0);

  // display, left: the static curve (input -60..0 dB across, output -60..0 dB up) with the
  // detector level as a dot; right: detector, gain-reduction and output meters
  ng_plot(64, 66, 92, 92);
  ng_grid(4, 4, 0);
  ng_font(4, 8, 0);
  ng_col(NG_MUTED, 1);
  gc_i = 0;
  loop(3, sprintf(#gc_l, "%d", -30 * gc_i); ng_ptxt(#gc_l, ng_px - 6 * ng_s, ng_py + ng_ph * gc_i / 2, 2); gc_i += 1;);
  ng_col(NG_ACCENT, 0.25);
  gfx_line(ng_px, ng_py + ng_ph, ng_px + ng_pw, ng_py, 1);
  ng_col(NG_ACCENT, 1);
  gc_i = 0;
  loop(93,
    gc_yy = ng_lin_y(gc_curve(-60 + 60 * gc_i / 92), -60, 0);
    gc_xx = ng_px + ng_pw * gc_i / 92;
    gc_i == 0 ? ng_line_start(gc_xx, gc_yy) : ng_line_to(gc_xx, gc_yy);
    gc_i += 1;
  );
  gc_db = ng_to_db(gc_in);
  gc_db > -60 ? (
    ng_col(NG_TEXT, 1);
    gfx_circle(ng_lin_x(min(0, gc_db), -60, 0), ng_lin_y(gc_curve(min(0, gc_db)), -60, 0), 2.5 * ng_s, 1, 1);
  );
  // status line: ratio and release, plus what is switched on (detector high-pass, mix)
  ng_font(1, 7, 1);
  ng_col(NG_ACCENT, 1);
  sprintf(#gc_r, "%s   %s", slider2 == 0 ? "2:1" : slider2 == 1 ? "4:1" : "10:1", rel_auto ? "AUTO RELEASE" : "FIXED RELEASE");
  ng_txt(#gc_r, 180, 66, 0, 1);
  strcpy(#gc_a, "");
  slider7 > 0 ? sprintf(#gc_a, "   HPF %d HZ", slider7);
  strcpy(#gc_b, "");
  slider6 < 100 ? sprintf(#gc_b, "   MIX %d%%", slider6);
  sprintf(#gc_st, "%s%s", #gc_a, #gc_b);
  ng_col(NG_MUTED, 1);
  ng_txt(#gc_st, 448, 66, 2, 1);
  ng_meter(180, 82, 268, 10, "IN", gc_db, slider1, -60);
  ng_gr_meter(180, 106, 268, 10, "GR", gr, 24);
  ng_meter(180, 130, 268, 10, "OUT", ng_to_db(gc_out), -140, -60);

  ng_row(4);
  sprintf(#v1, "%.1f dB", slider1);
  ng_knob_ctl(1, "THRESHOLD", #v1, -40, 0, -10, 0.1, 0) ? update();
  ng_select_ctl(2, "RATIO", "2:1|4:1|10:1", 0) ? update();
  ng_select_ctl(3, "ATTACK", "0.1 MS|0.3 MS|1 MS|3 MS|10 MS|30 MS", 0) ? update();
  ng_select_ctl(4, "RELEASE", "0.1 S|0.3 S|0.6 S|1.2 S|AUTO", 0) ? update();
  ng_row(3);
  sprintf(#v5, "+%.1f dB", slider5);
  ng_knob_ctl(5, "MAKEUP", #v5, 0, 20, 0, 0.1, 0) ? update();
  sprintf(#v6, "%d%%", slider6);
  ng_knob_ctl(6, "MIX", #v6, 0, 100, 100, 1, 0) ? update();
  slider7 > 0 ? sprintf(#v7, "%d Hz", slider7) : strcpy(#v7, "OFF");
  ng_knob_ctl(7, "SC HPF", #v7, 0, 300, 0, 1, 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
