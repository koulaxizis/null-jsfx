desc:NULL Robotizer GFX
author: Christos Koulaxizis
tags: robot robotizer voice monotone sci-fi dalek metallic fft gui
//category: Advanced
//NULL JSFX v2.3 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:120<50,400,1>-Pitch (Hz)
slider2:30<0,100,1>-Metallic (%)
slider3:0<0,100,1>-Ring (%)
slider4:100<0,100,1>-Mix (%)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  // NULL Robotizer (../robotizer.jsfx) with its own interface: same audio code, plus @gfx.
  gfx_ext_retina = 1;
  // Classic FFT robotization: once every Pitch period a 1024-point slice of the input
  // is analysed, all of its phases are set to zero and it is resynthesised. Each slice
  // becomes a single buzz pulse with the voice's spectrum, and the pulses repeat at
  // exactly Pitch, so speech keeps its words but drones on one note. Metallic adds a
  // tuned comb resonance at Pitch; Ring blends in ring modulation for a Dalek tone.
  // Latency: 1024 samples (reported to REAPER).
  N = 1024;
  fft_buf = 0;                 // 2N slots, does not cross a 65536 boundary
  win = 2048;                  // Hann window, N
  in_l = 4096; in_r = in_l + N;
  out_l = in_r + N; out_r = out_l + 2 * N;
  // comb lines hold up to 8192 samples: one Pitch period (srate / 50 at most) up to 384 kHz
  CL = 8192;
  comb_l = out_r + 2 * N; comb_r = comb_l + CL;
  freembuf(comb_r + CL);
  memset(in_l, 0, comb_r + CL - in_l);
  i = 0;
  loop(N, win[i] = 0.5 - 0.5 * cos(2 * $pi * i / N); i += 1);
  ipos = 0;    // write position in the input rings
  opos = 0;    // read position in the output accumulators
  cnt = 0;
  cpos = 0;
  rph = 0;
  pdc_delay = N;
  pdc_bot_ch = 0;
  pdc_top_ch = 2;

  // analyse the last N input samples of one channel, zero the phases, and add the
  // resulting pulse to the output accumulator starting at the current read point
  function robot_frame(inb, outb) local(i, k, re, im, m, p)
  (
    i = 0;
    loop(N,
      p = (ipos + i) % N;            // oldest sample first
      fft_buf[2 * i] = inb[p] * win[i];
      fft_buf[2 * i + 1] = 0;
      i += 1;
    );
    fft(fft_buf, N);
    fft_permute(fft_buf, N);
    k = 0;
    loop(N,
      re = fft_buf[2 * k]; im = fft_buf[2 * k + 1];
      m = sqrt(re * re + im * im);
      // zero phase, then (-1)^k moves the pulse to the middle of the frame
      fft_buf[2 * k] = k & 1 ? -m : m;
      fft_buf[2 * k + 1] = 0;
      k += 1;
    );
    fft_ipermute(fft_buf, N);
    ifft(fft_buf, N);
    i = 0;
    loop(N,
      p = (opos + i) % (2 * N);
      outb[p] += fft_buf[2 * i] * norm;
      i += 1;
    );
  );

  function update()
  (
    P = max(16, floor(srate / slider1 + 0.5));
    // pulses overlap N/P times; keep the level close to the input
    norm = P / N * 2 / N;
    metal = slider2 / 100 * 0.85;
    ring = slider3 / 100;
    mix = slider4 / 100;
  );

  // interface: the latest output for the scope (memory far above the audio buffers)
  ng_tap_init(1000000, 2048);

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 8;

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 120); ng_slider_set(2, 30); ng_slider_set(3, 0); ng_slider_set(4, 100); );
    p == 1 ? ( ng_slider_set(1, 110); ng_slider_set(2, 20); ng_slider_set(3, 0); ng_slider_set(4, 100); );
    p == 2 ? ( ng_slider_set(1, 70); ng_slider_set(2, 40); ng_slider_set(3, 0); ng_slider_set(4, 100); );
    p == 3 ? ( ng_slider_set(1, 260); ng_slider_set(2, 15); ng_slider_set(3, 0); ng_slider_set(4, 100); );
    p == 4 ? ( ng_slider_set(1, 140); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 100); );
    p == 5 ? ( ng_slider_set(1, 100); ng_slider_set(2, 30); ng_slider_set(3, 80); ng_slider_set(4, 100); );
    p == 6 ? ( ng_slider_set(1, 200); ng_slider_set(2, 70); ng_slider_set(3, 0); ng_slider_set(4, 50); );
    p == 7 ? ( ng_slider_set(1, 120); ng_slider_set(2, 25); ng_slider_set(3, 0); ng_slider_set(4, 40); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 120) && ng_pre_eq(slider2, 30) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 100) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 110) && ng_pre_eq(slider2, 20) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 100) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 70) && ng_pre_eq(slider2, 40) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 100) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 260) && ng_pre_eq(slider2, 15) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 100) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 140) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 100) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 100) && ng_pre_eq(slider2, 30) && ng_pre_eq(slider3, 80) && ng_pre_eq(slider4, 100) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 200) && ng_pre_eq(slider2, 70) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 50) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 120) && ng_pre_eq(slider2, 25) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 40) ? m = 7;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Classic Robot Voice";
    p == 2 ? s = "Deep Android";
    p == 3 ? s = "Small Droid";
    p == 4 ? s = "Flat Monotone";
    p == 5 ? s = "Ring Mod Alien";
    p == 6 ? s = "Metallic Drum Buzz";
    p == 7 ? s = "Subtle Robot Blend";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  in_l[ipos] = spl0;
  in_r[ipos] = spl1;
  ipos += 1;
  ipos >= N ? ipos = 0;

  cnt += 1;
  cnt >= P ? (
    cnt = 0;
    robot_frame(in_l, out_l);
    robot_frame(in_r, out_r);
  );

  r_l = out_l[opos]; out_l[opos] = 0;
  r_r = out_r[opos]; out_r[opos] = 0;
  opos += 1;
  opos >= 2 * N ? opos = 0;

  // tuned comb resonance at the robot pitch
  cp = cpos - P; cp < 0 ? cp += CL;
  c_l = r_l + metal * comb_l[cp];
  c_r = r_r + metal * comb_r[cp];
  comb_l[cpos] = c_l;
  comb_r[cpos] = c_r;
  cpos += 1; cpos >= CL ? cpos = 0;
  c_l *= 1 - metal;
  c_r *= 1 - metal;

  rph += 30 / srate;
  rph >= 1 ? rph -= 1;
  rm = sin(2 * $pi * rph);
  c_l = c_l * (1 - ring) + c_l * rm * ring;
  c_r = c_r * (1 - ring) + c_r * rm * ring;

  // the dry signal is delayed by N to line up with the robot voice
  dry_l = in_l[ipos];
  dry_r = in_r[ipos];
  spl0 = dry_l * (1 - mix) + c_l * mix;
  spl1 = dry_r * (1 - mix) + c_r * mix;
  ng_tap(spl0, spl1);

@gfx 480 294
  ng_knobs_begin("ROBOTIZER", "ADVANCED", 480, 120, 1, 0);

  // display: the output waveform, with a dashed line every robot pitch period
  ng_plot(ng_vx, ng_vy + 14, ng_vw, ng_vh - 14);
  ng_grid(8, 2, 1);
  rb_per = max(1, floor(ng_tl / floor(ng_pw)));
  rb_k = 1;
  while (rb_k * P < floor(ng_pw) * rb_per) (
    rb_x = floor(ng_px + rb_k * P / rb_per) + 0.5;
    ng_col(NG_ACCENT, 0.35);
    rb_y = ng_py;
    while (rb_y < ng_py + ng_ph) ( gfx_line(rb_x, rb_y, rb_x, min(rb_y + 3 * ng_s, ng_py + ng_ph), 0); rb_y += 6 * ng_s; );
    rb_k += 1;
  );
  ng_scope(1);
  ng_font(4, 8, 0);
  ng_col(NG_MUTED, 1);
  sprintf(#rb_t, "PERIOD %.2f ms", P / srate * 1000);
  ng_ptxt(#rb_t, ng_px, Y(ng_vy + 4), 0);
  sprintf(#rb_t, "%d Hz", slider1);
  ng_ptxt(#rb_t, ng_px + ng_pw, Y(ng_vy + 4), 2);

  ng_row(4);
  sprintf(#v1, "%d Hz", slider1);
  ng_knob_ctl(1, "PITCH", #v1, 50, 400, 120, 1, 0) ? update();
  sprintf(#v2, "%d%%", slider2);
  ng_knob_ctl(2, "METALLIC", #v2, 0, 100, 30, 1, 0) ? update();
  sprintf(#v3, "%d%%", slider3);
  ng_knob_ctl(3, "RING", #v3, 0, 100, 0, 1, 0) ? update();
  sprintf(#v4, "%d%%", slider4);
  ng_knob_ctl(4, "MIX", #v4, 0, 100, 100, 1, 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
