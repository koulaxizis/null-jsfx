desc:NULL Vinyl Age GFX
author: Christos Koulaxizis
tags: vinyl lo-fi wow flutter crackle bitcrush degradation gui
//category: Advanced
//NULL JSFX v2.6.1 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:30<0,100,1>-Wow (%)
slider2:20<0,100,1>-Flutter (%)
slider3:25<0,100,1>-Crackle (%)
slider4:10<0,100,1>-Noise Level (%)
slider5:12<4,16,1>-Bit Depth
slider6:22050<2000,44100,100>-Sample Rate (Hz)
slider7:8000<1000,20000,100>-Lowpass Freq (Hz)
slider8:80<0,100,1>-Mix (%)
slider9:0<0,2,1{33,45,78}>-RPM
slider10:0<0,100,1>-Scratches (%)
slider11:0<0,1,1{Off,On}>-Mono

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
// NULL Vinyl Age (../vinyl_age.jsfx) with its own interface: same audio code, plus @gfx.
/* The wow/flutter delay line sits at a fixed 50 ms centre, so the dry signal is read
   from the same buffer at exactly that delay: dry and wet stay time-aligned at any Mix.
   The 50 ms is reported to the host as plug-in delay compensation.
   RPM: the wow follows the turntable speed (0.5 Hz at 33, 45/33 and 78/33 times that at 45 and 78);
   78 also gives the narrow band of a shellac disc. Scratches are sparse, louder clicks (a sharp
   tick and a softer thump) at random intervals; Mono folds the record path to mono. */
buf_size = ceil(srate * 0.15);
base_samps = floor(0.05 * srate);
pdc_bot_ch = 0;
pdc_top_ch = 2;
pdc_delay = base_samps;
buf_l = 0;
buf_r = buf_size;
freembuf(buf_r + buf_size);
memset(buf_l, 0, 2 * buf_size);
write_pos = 0;
lp1_l = 0; lp2_l = 0;
lp1_r = 0; lp2_r = 0;
crackle_env = 0;
crackle_cnt = 0;
noise_seed_l = 12345;
noise_seed_r = 67890;
crackle_seed = 24680;
wow_phase = 0;
flutter_phase = 0;
sr_cnt = 0;
hold_l = 0;
hold_r = 0;
scratch_seed = 86420;
sc_cnt = 0;
sc_next = floor(0.5 * srate);
sc_e1 = sc_e2 = 0;
sc_gl = sc_gr = 1;

/* RBJ biquads for the shellac band: type 0 high-pass, 1 low-pass, 2 peaking */
function sh_set(type, f, q, db) local(w, cs, al, A, a0) instance(b0, b1, b2, a1, a2)
(
  w = 2 * $pi * min(f, srate * 0.45) / srate; cs = cos(w); al = sin(w) / (2 * q); A = 10 ^ (db / 40);
  type == 0 ? (b0 = (1 + cs) / 2; b1 = -(1 + cs); b2 = b0; a0 = 1 + al; a1 = -2 * cs; a2 = 1 - al) :
  type == 1 ? (b0 = (1 - cs) / 2; b1 = 1 - cs; b2 = b0; a0 = 1 + al; a1 = -2 * cs; a2 = 1 - al) :
  (b0 = 1 + al * A; b1 = -2 * cs; b2 = 1 - al * A; a0 = 1 + al / A; a1 = -2 * cs; a2 = 1 - al / A);
  b0 /= a0; b1 /= a0; b2 /= a0; a1 /= a0; a2 /= a0;
);
function sh_bq(x) local(y) instance(b0, b1, b2, a1, a2, x1, x2, y1, y2)
(
  y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2;
  x2 = x1; x1 = x; y2 = y1; y1 = y;
  y;
);
function sh_clr() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );
shh_l.sh_clr(); shh_r.sh_clr(); shl_l.sh_clr(); shl_r.sh_clr(); shp_l.sh_clr(); shp_r.sh_clr();
gfx_ext_retina = 1;

function update()
(
  wow_amt = slider1 / 100;
  flutter_amt = slider2 / 100;
  crackle_amt = slider3 / 100;
  noise_lvl = slider4 / 100;
  bits = slider5 < 4 ? 4 : slider5;
  sr_target = slider6;
  lp_freq = slider7;
  mix = slider8 / 100;

  lp_coef = 1 - exp(-2 * $pi * lp_freq / srate);

  sr_div = srate / sr_target;
  sr_div = sr_div < 1 ? 1 : floor(sr_div);

  rpm = slider9;
  wow_hz = rpm == 1 ? 0.675 : 1.17;
  rpm == 2 ? (
    shh_l.sh_set(0, 300, 0.7, 0); shh_r.sh_set(0, 300, 0.7, 0);
    shl_l.sh_set(1, 4500, 0.7, 0); shl_r.sh_set(1, 4500, 0.7, 0);
    shp_l.sh_set(2, 1500, 0.8, 4); shp_r.sh_set(2, 1500, 0.8, 4);
  );
  scratch = slider10;
  mono = slider11;
  sc_d1 = exp(-1 / (0.0002 * srate));
  sc_d2 = exp(-1 / (0.004 * srate));
);

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 12;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1); ng_hist_add(2); ng_hist_add(3); ng_hist_add(4); ng_hist_add(5); ng_hist_add(6); ng_hist_add(7); ng_hist_add(8); ng_hist_add(9); ng_hist_add(10); ng_hist_add(11);
  ng_hist_init();

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 30); ng_slider_set(2, 20); ng_slider_set(3, 25); ng_slider_set(4, 10); ng_slider_set(5, 12); ng_slider_set(6, 22050); ng_slider_set(7, 8000); ng_slider_set(8, 80); ng_slider_set(9, 0); ng_slider_set(10, 0); ng_slider_set(11, 0); );
    p == 1 ? ( ng_slider_set(1, 8); ng_slider_set(2, 5); ng_slider_set(3, 10); ng_slider_set(4, 4); ng_slider_set(5, 16); ng_slider_set(6, 44100); ng_slider_set(7, 12000); ng_slider_set(8, 50); ng_slider_set(9, 0); ng_slider_set(10, 0); ng_slider_set(11, 0); );
    p == 2 ? ( ng_slider_set(1, 20); ng_slider_set(2, 10); ng_slider_set(3, 35); ng_slider_set(4, 12); ng_slider_set(5, 12); ng_slider_set(6, 22000); ng_slider_set(7, 6000); ng_slider_set(8, 80); ng_slider_set(9, 0); ng_slider_set(10, 0); ng_slider_set(11, 0); );
    p == 3 ? ( ng_slider_set(1, 25); ng_slider_set(2, 15); ng_slider_set(3, 60); ng_slider_set(4, 20); ng_slider_set(5, 10); ng_slider_set(6, 16000); ng_slider_set(7, 5000); ng_slider_set(8, 90); ng_slider_set(9, 0); ng_slider_set(10, 0); ng_slider_set(11, 0); );
    p == 4 ? ( ng_slider_set(1, 70); ng_slider_set(2, 40); ng_slider_set(3, 10); ng_slider_set(4, 15); ng_slider_set(5, 12); ng_slider_set(6, 22000); ng_slider_set(7, 6000); ng_slider_set(8, 85); ng_slider_set(9, 0); ng_slider_set(10, 0); ng_slider_set(11, 0); );
    p == 5 ? ( ng_slider_set(1, 5); ng_slider_set(2, 10); ng_slider_set(3, 15); ng_slider_set(4, 30); ng_slider_set(5, 8); ng_slider_set(6, 11000); ng_slider_set(7, 3500); ng_slider_set(8, 100); ng_slider_set(9, 0); ng_slider_set(10, 0); ng_slider_set(11, 0); );
    p == 6 ? ( ng_slider_set(1, 35); ng_slider_set(2, 25); ng_slider_set(3, 80); ng_slider_set(4, 25); ng_slider_set(5, 8); ng_slider_set(6, 8000); ng_slider_set(7, 3000); ng_slider_set(8, 100); ng_slider_set(9, 0); ng_slider_set(10, 0); ng_slider_set(11, 0); );
    p == 7 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, 50); ng_slider_set(4, 8); ng_slider_set(5, 16); ng_slider_set(6, 44100); ng_slider_set(7, 20000); ng_slider_set(8, 50); ng_slider_set(9, 0); ng_slider_set(10, 0); ng_slider_set(11, 0); );
    p == 8 ? ( ng_slider_set(1, 15); ng_slider_set(2, 10); ng_slider_set(3, 25); ng_slider_set(4, 8); ng_slider_set(5, 16); ng_slider_set(6, 44100); ng_slider_set(7, 12000); ng_slider_set(8, 80); ng_slider_set(9, 1); ng_slider_set(10, 10); ng_slider_set(11, 0); );
    p == 9 ? ( ng_slider_set(1, 30); ng_slider_set(2, 20); ng_slider_set(3, 70); ng_slider_set(4, 30); ng_slider_set(5, 12); ng_slider_set(6, 22000); ng_slider_set(7, 6000); ng_slider_set(8, 100); ng_slider_set(9, 2); ng_slider_set(10, 35); ng_slider_set(11, 1); );
    p == 10 ? ( ng_slider_set(1, 20); ng_slider_set(2, 10); ng_slider_set(3, 35); ng_slider_set(4, 12); ng_slider_set(5, 14); ng_slider_set(6, 32000); ng_slider_set(7, 9000); ng_slider_set(8, 90); ng_slider_set(9, 0); ng_slider_set(10, 60); ng_slider_set(11, 1); );
    p == 11 ? ( ng_slider_set(1, 40); ng_slider_set(2, 25); ng_slider_set(3, 50); ng_slider_set(4, 15); ng_slider_set(5, 12); ng_slider_set(6, 22000); ng_slider_set(7, 7000); ng_slider_set(8, 90); ng_slider_set(9, 1); ng_slider_set(10, 45); ng_slider_set(11, 0); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 30) && ng_pre_eq(slider2, 20) && ng_pre_eq(slider3, 25) && ng_pre_eq(slider4, 10) && ng_pre_eq(slider5, 12) && ng_pre_eq(slider6, 22050) && ng_pre_eq(slider7, 8000) && ng_pre_eq(slider8, 80) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 8) && ng_pre_eq(slider2, 5) && ng_pre_eq(slider3, 10) && ng_pre_eq(slider4, 4) && ng_pre_eq(slider5, 16) && ng_pre_eq(slider6, 44100) && ng_pre_eq(slider7, 12000) && ng_pre_eq(slider8, 50) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 20) && ng_pre_eq(slider2, 10) && ng_pre_eq(slider3, 35) && ng_pre_eq(slider4, 12) && ng_pre_eq(slider5, 12) && ng_pre_eq(slider6, 22000) && ng_pre_eq(slider7, 6000) && ng_pre_eq(slider8, 80) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 25) && ng_pre_eq(slider2, 15) && ng_pre_eq(slider3, 60) && ng_pre_eq(slider4, 20) && ng_pre_eq(slider5, 10) && ng_pre_eq(slider6, 16000) && ng_pre_eq(slider7, 5000) && ng_pre_eq(slider8, 90) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 70) && ng_pre_eq(slider2, 40) && ng_pre_eq(slider3, 10) && ng_pre_eq(slider4, 15) && ng_pre_eq(slider5, 12) && ng_pre_eq(slider6, 22000) && ng_pre_eq(slider7, 6000) && ng_pre_eq(slider8, 85) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 5) && ng_pre_eq(slider2, 10) && ng_pre_eq(slider3, 15) && ng_pre_eq(slider4, 30) && ng_pre_eq(slider5, 8) && ng_pre_eq(slider6, 11000) && ng_pre_eq(slider7, 3500) && ng_pre_eq(slider8, 100) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 35) && ng_pre_eq(slider2, 25) && ng_pre_eq(slider3, 80) && ng_pre_eq(slider4, 25) && ng_pre_eq(slider5, 8) && ng_pre_eq(slider6, 8000) && ng_pre_eq(slider7, 3000) && ng_pre_eq(slider8, 100) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 8) && ng_pre_eq(slider5, 16) && ng_pre_eq(slider6, 44100) && ng_pre_eq(slider7, 20000) && ng_pre_eq(slider8, 50) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 0) && ng_pre_eq(slider11, 0) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 15) && ng_pre_eq(slider2, 10) && ng_pre_eq(slider3, 25) && ng_pre_eq(slider4, 8) && ng_pre_eq(slider5, 16) && ng_pre_eq(slider6, 44100) && ng_pre_eq(slider7, 12000) && ng_pre_eq(slider8, 80) && ng_pre_eq(slider9, 1) && ng_pre_eq(slider10, 10) && ng_pre_eq(slider11, 0) ? m = 8;
    m < 0 && ng_pre_eq(slider1, 30) && ng_pre_eq(slider2, 20) && ng_pre_eq(slider3, 70) && ng_pre_eq(slider4, 30) && ng_pre_eq(slider5, 12) && ng_pre_eq(slider6, 22000) && ng_pre_eq(slider7, 6000) && ng_pre_eq(slider8, 100) && ng_pre_eq(slider9, 2) && ng_pre_eq(slider10, 35) && ng_pre_eq(slider11, 1) ? m = 9;
    m < 0 && ng_pre_eq(slider1, 20) && ng_pre_eq(slider2, 10) && ng_pre_eq(slider3, 35) && ng_pre_eq(slider4, 12) && ng_pre_eq(slider5, 14) && ng_pre_eq(slider6, 32000) && ng_pre_eq(slider7, 9000) && ng_pre_eq(slider8, 90) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 60) && ng_pre_eq(slider11, 1) ? m = 10;
    m < 0 && ng_pre_eq(slider1, 40) && ng_pre_eq(slider2, 25) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 15) && ng_pre_eq(slider5, 12) && ng_pre_eq(slider6, 22000) && ng_pre_eq(slider7, 7000) && ng_pre_eq(slider8, 90) && ng_pre_eq(slider9, 1) && ng_pre_eq(slider10, 45) && ng_pre_eq(slider11, 0) ? m = 11;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Subtle Warmth";
    p == 2 ? s = "Lofi Hip Hop Keys";
    p == 3 ? s = "Dusty Old Record";
    p == 4 ? s = "Warped Tape Memory";
    p == 5 ? s = "AM Radio";
    p == 6 ? s = "Gramophone";
    p == 7 ? s = "Crackle Only Layer";
    p == 8 ? s = "45 RPM Single";
    p == 9 ? s = "78 Shellac";
    p == 10 ? s = "Scratched Mono LP";
    p == 11 ? s = "Worn Jukebox 45";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
update();

@sample
in_l = spl0;
in_r = spl1;

/* ─── WOW (slow pitch drift ~0.5Hz) ─── */
rpm == 0 ? (wow_phase += 2 * $pi * 0.5 / srate) : (wow_phase += 2 * $pi * wow_hz / srate);
wow_phase > 2*$pi ? wow_phase -= 2*$pi;
wow_val = sin(wow_phase) * wow_amt;

/* ─── FLUTTER (fast pitch wobble ~6Hz) ─── */
flutter_phase += 2 * $pi * 6 / srate;
flutter_phase > 2*$pi ? flutter_phase -= 2*$pi;
flutter_val = sin(flutter_phase) * flutter_amt;

/* Combined pitch modulation in ms */
mod_ms = wow_val * 40 + flutter_val * 15;
mod_ms = mod_ms < -50 ? -50 : (mod_ms > 50 ? 50 : mod_ms);

/* Delay in samples (base 50ms + modulation) */
delay_samps = base_samps + mod_ms * 0.001 * srate;
delay_samps = delay_samps < 1 ? 1 : delay_samps;

/* Read from delay buffer with linear interpolation */
read_pos = write_pos - delay_samps;
read_pos < 0 ? read_pos += buf_size;

rp_int = floor(read_pos);
rp_frac = read_pos - rp_int;
rp_next = rp_int + 1;
rp_next >= buf_size ? rp_next = 0;

wet_l = buf_l[rp_int] * (1 - rp_frac) + buf_l[rp_next] * rp_frac;
wet_r = buf_r[rp_int] * (1 - rp_frac) + buf_r[rp_next] * rp_frac;

/* Dry signal delayed by the wet path's centre delay (phase-coherent mixing) */
dp = write_pos - base_samps;
dp < 0 ? dp += buf_size;
dry_l = buf_l[dp];
dry_r = buf_r[dp];

/* Write current input to buffer */
buf_l[write_pos] = in_l;
buf_r[write_pos] = in_r;
write_pos += 1;
write_pos >= buf_size ? write_pos = 0;

/* ─── BITCRUSH ─── */
levels = pow(2, bits) - 1;
wet_l = floor(wet_l * levels + 0.5) / levels;
wet_r = floor(wet_r * levels + 0.5) / levels;

/* ─── DOWNSAMPLE (hold) ─── */
sr_cnt += 1;
sr_cnt >= sr_div ? (
  sr_cnt = 0;
  hold_l = wet_l;
  hold_r = wet_r;
);
wet_l = hold_l;
wet_r = hold_r;

/* ─── LOWPASS FILTER — 2-POLE CASCADE (12dB/oct) ─── */
lp1_l += lp_coef * (wet_l - lp1_l);
lp2_l += lp_coef * (lp1_l - lp2_l);
wet_l = lp2_l;

lp1_r += lp_coef * (wet_r - lp1_r);
lp2_r += lp_coef * (lp1_r - lp2_r);
wet_r = lp2_r;

/* ─── SHELLAC BAND (78 RPM) ─── */
rpm == 2 ? (
  wet_l = shp_l.sh_bq(shl_l.sh_bq(shh_l.sh_bq(wet_l)));
  wet_r = shp_r.sh_bq(shl_r.sh_bq(shh_r.sh_bq(wet_r)));
);

/* ─── VINYL CRACKLE ─── */
crackle_cnt += 1;
crackle_env *= 0.95;
crackle_cnt > (srate / (5 + crackle_amt * 150)) && crackle_amt > 0 ? (
  crackle_cnt = 0;
  crackle_seed *= 16807; crackle_seed -= floor(crackle_seed / 2147483647) * 2147483647;
  crackle_env = (crackle_seed / 1073741824 - 1) * crackle_amt * 0.5;
);
wet_l += crackle_env;
wet_r += crackle_env;

/* ─── BACKGROUND NOISE ─── */
/* Park-Miller generators in exact double arithmetic, so the noise is the same on every CPU */
noise_seed_l *= 16807; noise_seed_l -= floor(noise_seed_l / 2147483647) * 2147483647;
noise_seed_r *= 16807; noise_seed_r -= floor(noise_seed_r / 2147483647) * 2147483647;
noise_l = ((noise_seed_l / 2147483647) * 2 - 1) * noise_lvl * 0.05;
noise_r = ((noise_seed_r / 2147483647) * 2 - 1) * noise_lvl * 0.05;
wet_l += noise_l;
wet_r += noise_r;

/* ─── SCRATCHES (own Park-Miller generator) ─── */
scratch > 0 ? (
  sc_cnt += 1;
  sc_cnt >= sc_next ? (
    sc_cnt = 0;
    scratch_seed *= 16807; scratch_seed -= floor(scratch_seed / 2147483647) * 2147483647;
    sc_r1 = scratch_seed / 2147483648;
    scratch_seed *= 16807; scratch_seed -= floor(scratch_seed / 2147483647) * 2147483647;
    sc_r2 = scratch_seed / 2147483648;
    scratch_seed *= 16807; scratch_seed -= floor(scratch_seed / 2147483647) * 2147483647;
    sc_r3 = scratch_seed / 2147483648;
    /* the next one in 0.25..2.5 s at 0 %, about four times as often at 100 % */
    sc_next = floor(srate * (25 + 225 * sc_r1) / (30 + scratch));
    sc_e1 = (0.4 + 0.6 * sc_r2) * scratch / 110;
    sc_r3 < 0.5 ? sc_e1 = -sc_e1;
    sc_e2 = sc_e1 * 0.3;
    sc_gl = 0.7 + 0.6 * sc_r3;
    sc_gr = 1.3 - 0.6 * sc_r3;
  );
  sc_v = sc_e1 - sc_e2;
  sc_e1 *= sc_d1;
  sc_e2 *= sc_d2;
  wet_l += sc_v * sc_gl;
  wet_r += sc_v * sc_gr;
);

/* ─── MONO ─── */
mono ? (
  wet_l = (wet_l + wet_r) * 0.5;
  wet_r = wet_l;
);

/* ─── MIX & OUTPUT ─── */
dry = 1 - mix;
out_l = dry_l * dry + wet_l * mix;
out_r = dry_r * dry + wet_r * mix;

spl0 = out_l;
spl1 = out_r;

@gfx 480 380
  function va_frac(x) ( x - floor(x); );

  ng_knobs_begin("VINYL AGE", "ADVANCED", 480, 120, 2, 0);

  // display: the wow + flutter pitch drift over 2 s, as the delay offset around the 50 ms centre
  // (-50 to +50 ms), with the crackle clicks behind it
  ng_plot(ng_vx + 26, ng_vy + 4, ng_vw - 30, ng_vh - 20);
  ng_grid(4, 4, 1);
  ng_font(4, 8, 0);
  ng_col(NG_MUTED, 1);
  ng_ptxt("+50", ng_px - 6 * ng_s, ng_py, 2);
  ng_ptxt("0", ng_px - 6 * ng_s, ng_py + ng_ph / 2, 2);
  ng_ptxt("-50", ng_px - 6 * ng_s, ng_py + ng_ph, 2);
  va_i = 1;
  loop(3, sprintf(#va_t, "%.1f s", va_i * 0.5); ng_ptxt(#va_t, ng_px + ng_pw * va_i / 4, ng_py + ng_ph + 10 * ng_s, 1); va_i += 1;);
  slider3 > 0 ? (
    ng_col(NG_MUTED, 0.6);
    va_dt = 1 / (5 + slider3 / 100 * 150);
    va_t = va_dt;
    va_k = 0;
    while (va_t < 2) (
      va_x = floor(ng_lin_x(va_t, 0, 2)) + 0.5;
      gfx_line(va_x, ng_py + ng_ph / 2, va_x, ng_py + ng_ph / 2 - (va_frac(va_k * 0.618034 + 0.2) * 2 - 1) * slider3 / 100 * ng_ph / 2, 0);
      va_t += va_dt;
      va_k += 1;
    );
  );
  ng_col(NG_MUTED, 1);
  ng_ptxt(slider9 == 0 ? "33 RPM" : slider9 == 1 ? "45 RPM" : "78 RPM", ng_px + ng_pw - 6 * ng_s, ng_py + 8 * ng_s, 2);
  va_hz = slider9 == 0 ? 0.5 : slider9 == 1 ? 0.675 : 1.17;
  ng_col(NG_ACCENT, 1);
  va_i = 0;
  loop(floor(ng_pw) + 1,
    va_t = va_i / ng_pw * 2;
    va_m = sin(2 * $pi * va_hz * va_t) * slider1 / 100 * 40 + sin(2 * $pi * 6 * va_t) * slider2 / 100 * 15;
    va_y = ng_lin_y(va_m, -50, 50);
    va_i == 0 ? ng_line_start(ng_px, va_y) : ng_line_to(ng_px + va_i, va_y);
    va_i += 1;
  );

  ng_row(6);
  sprintf(#v1, "%d%%", slider1);
  ng_knob_ctl(1, "WOW", #v1, 0, 100, 30, 1, 0) ? update();
  sprintf(#v2, "%d%%", slider2);
  ng_knob_ctl(2, "FLUTTER", #v2, 0, 100, 20, 1, 0) ? update();
  ng_select_ctl(9, "RPM", "33|45|78", 0) ? update();
  sprintf(#v3, "%d%%", slider3);
  ng_knob_ctl(3, "CRACKLE", #v3, 0, 100, 25, 1, 0) ? update();
  sprintf(#v10, "%d%%", slider10);
  ng_knob_ctl(10, "SCRATCHES", #v10, 0, 100, 0, 1, 0) ? update();
  sprintf(#v4, "%d%%", slider4);
  ng_knob_ctl(4, "NOISE", #v4, 0, 100, 10, 1, 0) ? update();
  ng_row(5);
  sprintf(#v5, "%d bit", slider5);
  ng_knob_ctl(5, "BITS", #v5, 4, 16, 12, 1, 0) ? update();
  sprintf(#v6, "%.1f kHz", slider6 / 1000);
  ng_knob_ctl(6, "RATE", #v6, 2000, 44100, 22050, 100, 0) ? update();
  sprintf(#v7, "%.1f kHz", slider7 / 1000);
  ng_knob_ctl(7, "LOWPASS", #v7, 1000, 20000, 8000, 100, 0) ? update();
  ng_select_ctl(11, "MONO", "OFF|ON", 0) ? update();
  sprintf(#v8, "%d%%", slider8);
  ng_knob_ctl(8, "MIX", #v8, 0, 100, 80, 1, 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
