desc:NULL Stereo Width GFX
author: Christos Koulaxizis
tags: stereo width mid side widening narrowing spread image crossover gui
//category: Essentials
//NULL JSFX v4.1 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:100<0,200,1>-Width (%)
slider2:100<0,100,1>-Mix (%)
slider3:0<0,500,1>-Crossover (Hz)
slider4:0<0,16000,10>-High Crossover (Hz)
slider5:100<0,200,1>-High Width (%)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // NULL Stereo Width (../stereo_width.jsfx) with its own interface: same audio code, plus @gfx.
  width_pct = 1;
  mix_amt = 1;
  xover_freq = 0;
  lp_mid_l = 0;
  lp_mid_r = 0;
  lp_side = 0;
  lp_hs = 0;
  // High Crossover above 0 Hz splits the widened side once more (one pole): above it the side
  // gets High Width instead of Width. At 0 Hz (the default) the plugin is as before.
  gfx_ext_retina = 1;
  // display only: vectorscope taps of the output
  ng_tap_init(4000000, 2048);

  function update()
  (
    width_pct = slider1 / 100;
    mix_amt = slider2 / 100;
    xover_freq = slider3;

    xover_freq > 0 ? (
      xover_coef = 1 - exp(-2 * 3.14159265358979 * xover_freq / srate);
    ) : xover_coef = 0;
    hx_freq = slider4;
    hw_pct = slider5 / 100;
    hx_freq > 0 ? (
      hx_coef = 1 - exp(-2 * 3.14159265358979 * min(hx_freq, 0.45 * srate) / srate);
    ) : hx_coef = 0;
  );

  // side gain (1 = unchanged) at frequency f: dry side plus the widened side above the
  // one-pole crossover of @sample, |(1 - mix) + mix * width * HP(f)|; mid is untouched
  // one-pole high-pass of coefficient c at frequency f: sw_hr + j sw_hi (1 when c = 0)
  function sw_hp(f, c) local(w, b, dr, di, dd)
  (
    c > 0 ? (
      w = 2 * $pi * min(f, srate * 0.499) / srate;
      b = 1 - c;
      dr = 1 - b * cos(w);
      di = b * sin(w);
      dd = dr * dr + di * di;
      sw_hr = 1 - c * dr / dd;
      sw_hi = c * di / dd;
    ) : (
      sw_hr = 1; sw_hi = 0;
    );
  );
  // with the high band: |(1 - mix) + mix * HP1 * (width + (high width - width) * HP2)|
  function sw_side(f) local(hr, hi, gr, gi, tr, ti)
  (
    sw_hp(f, xover_coef);
    hr = sw_hr; hi = sw_hi;
    gr = width_pct; gi = 0;
    hx_freq > 0 ? (
      sw_hp(f, hx_coef);
      gr += (hw_pct - width_pct) * sw_hr;
      gi = (hw_pct - width_pct) * sw_hi;
    );
    tr = (1 - mix_amt) + mix_amt * (hr * gr - hi * gi);
    ti = mix_amt * (hr * gi + hi * gr);
    sqrt(tr * tr + ti * ti);
  );

  // log-frequency grid (20 Hz to 20 kHz) without dB lines, for the plot set by ng_plot
  function sw_freq_grid() local(d, m, f, xx)
  (
    d = 10;
    loop(4,
      m = 1;
      loop(9,
        f = m * d;
        f >= 20 && f <= 20000 ? (
          xx = floor(ng_freq_x(f)) + 0.5;
          ng_col(NG_BORDER, m == 1 ? 1 : 0.5);
          gfx_line(xx, ng_py, xx, ng_py + ng_ph, 0);
        );
        m += 1;
      );
      d *= 10;
    );
    ng_font(4, 8, 0);
    ng_col(NG_MUTED, 1);
    ng_ptxt("100", ng_freq_x(100), ng_py + ng_ph + 11 * ng_s, 1);
    ng_ptxt("1k", ng_freq_x(1000), ng_py + ng_ph + 11 * ng_s, 1);
    ng_ptxt("10k", ng_freq_x(10000), ng_py + ng_ph + 11 * ng_s, 1);
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 11;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1); ng_hist_add(2); ng_hist_add(3); ng_hist_add(4); ng_hist_add(5);
  ng_hist_init();
  ng_dice_add(1, 0, 200, 1, 0); ng_dice_add(3, 0, 500, 1, 0); ng_dice_add(4, 0, 16000, 10, 0); ng_dice_add(5, 0, 200, 1, 0);

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 100); ng_slider_set(2, 100); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 100); );
    p == 1 ? ( ng_slider_set(1, 0); ng_slider_set(2, 100); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 100); );
    p == 2 ? ( ng_slider_set(1, 115); ng_slider_set(2, 100); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 100); );
    p == 3 ? ( ng_slider_set(1, 150); ng_slider_set(2, 100); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 100); );
    p == 4 ? ( ng_slider_set(1, 70); ng_slider_set(2, 100); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 100); );
    p == 5 ? ( ng_slider_set(1, 100); ng_slider_set(2, 100); ng_slider_set(3, 120); ng_slider_set(4, 0); ng_slider_set(5, 100); );
    p == 6 ? ( ng_slider_set(1, 130); ng_slider_set(2, 100); ng_slider_set(3, 150); ng_slider_set(4, 0); ng_slider_set(5, 100); );
    p == 7 ? ( ng_slider_set(1, 180); ng_slider_set(2, 100); ng_slider_set(3, 250); ng_slider_set(4, 0); ng_slider_set(5, 100); );
    p == 8 ? ( ng_slider_set(1, 85); ng_slider_set(2, 100); ng_slider_set(3, 200); ng_slider_set(4, 0); ng_slider_set(5, 100); );
    p == 9 ? ( ng_slider_set(1, 140); ng_slider_set(2, 100); ng_slider_set(3, 180); ng_slider_set(4, 0); ng_slider_set(5, 100); );
    p == 10 ? ( ng_slider_set(1, 200); ng_slider_set(2, 50); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 100); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 100) && ng_pre_eq(slider2, 100) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 100) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 100) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 100) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 115) && ng_pre_eq(slider2, 100) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 100) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 150) && ng_pre_eq(slider2, 100) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 100) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 70) && ng_pre_eq(slider2, 100) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 100) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 100) && ng_pre_eq(slider2, 100) && ng_pre_eq(slider3, 120) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 100) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 130) && ng_pre_eq(slider2, 100) && ng_pre_eq(slider3, 150) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 100) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 180) && ng_pre_eq(slider2, 100) && ng_pre_eq(slider3, 250) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 100) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 85) && ng_pre_eq(slider2, 100) && ng_pre_eq(slider3, 200) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 100) ? m = 8;
    m < 0 && ng_pre_eq(slider1, 140) && ng_pre_eq(slider2, 100) && ng_pre_eq(slider3, 180) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 100) ? m = 9;
    m < 0 && ng_pre_eq(slider1, 200) && ng_pre_eq(slider2, 50) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 100) ? m = 10;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Mono Check";
    p == 2 ? s = "Gentle Widen";
    p == 3 ? s = "Wide Pads";
    p == 4 ? s = "Narrow Overheads";
    p == 5 ? s = "Master Mono Lows";
    p == 6 ? s = "Mono Bass Wide Top";
    p == 7 ? s = "Extra Wide Synths";
    p == 8 ? s = "Narrow Mono Lows";
    p == 9 ? s = "Wide Backing Vocals";
    p == 10 ? s = "Half Width Blend";
    s;
  );

  // the hint line under the controls: a short help text per slider (from tools/site_content.json)
  function ng_hint_text(i) local(s)
  (
    s = "";
    i == 1 ? s = "Side level: 0% = mono, 100% = unchanged, 200% = twice as wide";
    i == 2 ? s = "Blend between original and processed signal";
    i == 3 ? s = "Below this frequency the signal is made mono and the width setting only applies above it (0 = off)";
    i == 4 ? s = "Above this frequency the highs get their own width (0 = off, one width for everything)";
    i == 5 ? s = "Width of the band above High Crossover (100% = unchanged, 0% = mono highs, 200% = extra wide)";
    s;
  );

  function ng_presets() local(i)
  (
    ng_hint_i > 0 && !ng_pre_open ? ng_hint(ng_hint_text(ng_hint_i));
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  mid = (spl0 + spl1) * 0.5;
  side = (spl0 - spl1) * 0.5;
  
  xover_freq > 0 ? (
    // Crossover mode: only widen highs, keep bass mono
    lp_mid_l = lp_mid_l + xover_coef * (mid - lp_mid_l);
    hp_mid = mid - lp_mid_l;
    
    lp_side = lp_side + xover_coef * (side - lp_side);
    hp_side = side - lp_side;
    
    // Bass: mid only (mono), no side
    out_l = lp_mid_l;
    out_r = lp_mid_l;
    
    // Highs: widened mid + side
    out_l += hp_mid + hp_side * width_pct;
    out_r += hp_mid - hp_side * width_pct;
  ) : (
    // Full range mode
    out_l = mid + side * width_pct;
    out_r = mid - side * width_pct;
  );
  hx_freq > 0 ? (
    // High band: the side above High Crossover gets High Width instead of Width
    hb_in = xover_freq > 0 ? hp_side : side;
    lp_hs = lp_hs + hx_coef * (hb_in - lp_hs);
    hb_side = (hb_in - lp_hs) * (hw_pct - width_pct);
    out_l += hb_side;
    out_r -= hb_side;
  );
  
  spl0 = spl0 * (1 - mix_amt) + out_l * mix_amt;
  spl1 = spl1 * (1 - mix_amt) + out_r * mix_amt;

  // display only (reads the output, never changes it)
  ng_tap(spl0, spl1);

@gfx 480 294
  ng_knobs_begin("STEREO WIDTH", "ESSENTIALS", 480, 120, 1, 0);

  // display, left: vectorscope of the output; right: the side level across frequency
  // (0 to 200 % of the input's), the crossover dashed
  ng_plot(32, 66, 96, 96);
  ng_vector(2);
  ng_plot(186, 66, 262, 80);
  sw_freq_grid();
  sw_i = 0;
  loop(5,
    sw_y = floor(ng_py + ng_ph * sw_i / 4) + 0.5;
    ng_col(sw_i == 2 ? 0x45433f : NG_BORDER, sw_i == 2 ? 1 : 0.6);
    gfx_line(ng_px, sw_y, ng_px + ng_pw, sw_y, 0);
    sw_i += 1;
  );
  ng_font(4, 8, 0);
  ng_col(NG_MUTED, 1);
  ng_ptxt("200%", ng_px - 6 * ng_s, ng_py, 2);
  ng_ptxt("100%", ng_px - 6 * ng_s, ng_py + ng_ph / 2, 2);
  ng_ptxt("0%", ng_px - 6 * ng_s, ng_py + ng_ph, 2);
  xover_freq > 0 ? (
    sw_x = floor(ng_freq_x(xover_freq)) + 0.5;
    ng_col(NG_ACCENT, 0.5);
    sw_y = ng_py;
    while(
      gfx_line(sw_x, sw_y, sw_x, min(sw_y + 3 * ng_s, ng_py + ng_ph), 0);
      sw_y += 6 * ng_s;
      sw_y < ng_py + ng_ph;
    );
  );
  hx_freq > 0 ? (
    sw_x = floor(ng_freq_x(min(hx_freq, 20000))) + 0.5;
    ng_col(NG_ACCENT, 0.5);
    sw_y = ng_py;
    while(
      gfx_line(sw_x, sw_y, sw_x, min(sw_y + 3 * ng_s, ng_py + ng_ph), 0);
      sw_y += 6 * ng_s;
      sw_y < ng_py + ng_ph;
    );
  );
  sw_z = ng_lin_y(0, 0, 2);
  ng_col(NG_ACCENT, 0.10);
  sw_i = 0;
  loop(floor(ng_pw) + 1,
    gfx_line(ng_px + sw_i, sw_z, ng_px + sw_i, ng_lin_y(sw_side(20 * 1000 ^ (sw_i / ng_pw)), 0, 2), 0);
    sw_i += 1;
  );
  ng_col(NG_ACCENT, 1);
  sw_i = 0;
  loop(floor(ng_pw) + 1,
    sw_y = ng_lin_y(sw_side(20 * 1000 ^ (sw_i / ng_pw)), 0, 2);
    sw_i == 0 ? ng_line_start(ng_px, sw_y) : ng_line_to(ng_px + sw_i, sw_y);
    sw_i += 1;
  );

  ng_row(5);
  sprintf(#sw_v1, "%d%%", slider1);
  ng_knob_ctl(1, "WIDTH", #sw_v1, 0, 200, 100, 1, 1) ? update();
  sprintf(#sw_v2, "%d%%", slider2);
  ng_knob_ctl(2, "MIX", #sw_v2, 0, 100, 100, 1, 0) ? update();
  slider3 > 0 ? sprintf(#sw_v3, "%d Hz", slider3) : sprintf(#sw_v3, "OFF");
  ng_knob_ctl(3, "CROSSOVER", #sw_v3, 0, 500, 0, 1, 0) ? update();
  slider4 > 0 ? (
    slider4 >= 1000 ? sprintf(#sw_v4, "%.1f kHz", slider4 / 1000) : sprintf(#sw_v4, "%d Hz", slider4);
  ) : sprintf(#sw_v4, "OFF");
  ng_knob_ctl(4, "HIGH XOVER", #sw_v4, 0, 16000, 0, 10, 0) ? update();
  sprintf(#sw_v5, "%d%%", slider5);
  ng_knob_ctl(5, "HIGH WIDTH", #sw_v5, 0, 200, 100, 1, 1) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
