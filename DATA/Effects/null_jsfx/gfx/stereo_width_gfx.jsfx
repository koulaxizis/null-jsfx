desc:NULL Stereo Width GFX
author: Christos Koulaxizis
tags: stereo width mid side widening narrowing spread image crossover gui
//category: Essentials
//NULL JSFX v2.9 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:100<0,200,1>-Width (%)
slider2:100<0,100,1>-Mix (%)
slider3:0<0,500,1>-Crossover (Hz)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // NULL Stereo Width (../stereo_width.jsfx) with its own interface: same audio code, plus @gfx.
  width_pct = 1;
  mix_amt = 1;
  xover_freq = 0;
  lp_mid_l = 0;
  lp_mid_r = 0;
  lp_side = 0;
  gfx_ext_retina = 1;
  // display only: vectorscope taps of the output
  ng_tap_init(4000000, 2048);

  function update()
  (
    width_pct = slider1 / 100;
    mix_amt = slider2 / 100;
    xover_freq = slider3;

    xover_freq > 0 ? (
      xover_coef = 1 - exp(-2 * 3.14159265358979 * xover_freq / srate);
    ) : xover_coef = 0;
  );

  // side gain (1 = unchanged) at frequency f: dry side plus the widened side above the
  // one-pole crossover of @sample, |(1 - mix) + mix * width * HP(f)|; mid is untouched
  function sw_side(f) local(w, b, dr, di, dd, hr, hi, tr)
  (
    xover_freq > 0 ? (
      w = 2 * $pi * min(f, srate * 0.499) / srate;
      b = 1 - xover_coef;
      dr = 1 - b * cos(w);
      di = b * sin(w);
      dd = dr * dr + di * di;
      hr = 1 - xover_coef * dr / dd;
      hi = xover_coef * di / dd;
    ) : (
      hr = 1; hi = 0;
    );
    tr = (1 - mix_amt) + mix_amt * width_pct * hr;
    hi *= mix_amt * width_pct;
    sqrt(tr * tr + hi * hi);
  );

  // log-frequency grid (20 Hz to 20 kHz) without dB lines, for the plot set by ng_plot
  function sw_freq_grid() local(d, m, f, xx)
  (
    d = 10;
    loop(4,
      m = 1;
      loop(9,
        f = m * d;
        f >= 20 && f <= 20000 ? (
          xx = floor(ng_freq_x(f)) + 0.5;
          ng_col(NG_BORDER, m == 1 ? 1 : 0.5);
          gfx_line(xx, ng_py, xx, ng_py + ng_ph, 0);
        );
        m += 1;
      );
      d *= 10;
    );
    ng_font(4, 8, 0);
    ng_col(NG_MUTED, 1);
    ng_ptxt("100", ng_freq_x(100), ng_py + ng_ph + 11 * ng_s, 1);
    ng_ptxt("1k", ng_freq_x(1000), ng_py + ng_ph + 11 * ng_s, 1);
    ng_ptxt("10k", ng_freq_x(10000), ng_py + ng_ph + 11 * ng_s, 1);
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 8;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1); ng_hist_add(2); ng_hist_add(3);
  ng_hist_init();

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 100); ng_slider_set(2, 100); ng_slider_set(3, 0); );
    p == 1 ? ( ng_slider_set(1, 0); ng_slider_set(2, 100); ng_slider_set(3, 0); );
    p == 2 ? ( ng_slider_set(1, 115); ng_slider_set(2, 100); ng_slider_set(3, 0); );
    p == 3 ? ( ng_slider_set(1, 150); ng_slider_set(2, 100); ng_slider_set(3, 0); );
    p == 4 ? ( ng_slider_set(1, 70); ng_slider_set(2, 100); ng_slider_set(3, 0); );
    p == 5 ? ( ng_slider_set(1, 100); ng_slider_set(2, 100); ng_slider_set(3, 120); );
    p == 6 ? ( ng_slider_set(1, 130); ng_slider_set(2, 100); ng_slider_set(3, 150); );
    p == 7 ? ( ng_slider_set(1, 180); ng_slider_set(2, 100); ng_slider_set(3, 250); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 100) && ng_pre_eq(slider2, 100) && ng_pre_eq(slider3, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 100) && ng_pre_eq(slider3, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 115) && ng_pre_eq(slider2, 100) && ng_pre_eq(slider3, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 150) && ng_pre_eq(slider2, 100) && ng_pre_eq(slider3, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 70) && ng_pre_eq(slider2, 100) && ng_pre_eq(slider3, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 100) && ng_pre_eq(slider2, 100) && ng_pre_eq(slider3, 120) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 130) && ng_pre_eq(slider2, 100) && ng_pre_eq(slider3, 150) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 180) && ng_pre_eq(slider2, 100) && ng_pre_eq(slider3, 250) ? m = 7;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Mono Check";
    p == 2 ? s = "Gentle Widen";
    p == 3 ? s = "Wide Pads";
    p == 4 ? s = "Narrow Overheads";
    p == 5 ? s = "Master Mono Lows";
    p == 6 ? s = "Mono Bass Wide Top";
    p == 7 ? s = "Extra Wide Synths";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  mid = (spl0 + spl1) * 0.5;
  side = (spl0 - spl1) * 0.5;
  
  xover_freq > 0 ? (
    // Crossover mode: only widen highs, keep bass mono
    lp_mid_l = lp_mid_l + xover_coef * (mid - lp_mid_l);
    hp_mid = mid - lp_mid_l;
    
    lp_side = lp_side + xover_coef * (side - lp_side);
    hp_side = side - lp_side;
    
    // Bass: mid only (mono), no side
    out_l = lp_mid_l;
    out_r = lp_mid_l;
    
    // Highs: widened mid + side
    out_l += hp_mid + hp_side * width_pct;
    out_r += hp_mid - hp_side * width_pct;
  ) : (
    // Full range mode
    out_l = mid + side * width_pct;
    out_r = mid - side * width_pct;
  );
  
  spl0 = spl0 * (1 - mix_amt) + out_l * mix_amt;
  spl1 = spl1 * (1 - mix_amt) + out_r * mix_amt;

  // display only (reads the output, never changes it)
  ng_tap(spl0, spl1);

@gfx 480 294
  ng_knobs_begin("STEREO WIDTH", "ESSENTIALS", 480, 120, 1, 0);

  // display, left: vectorscope of the output; right: the side level across frequency
  // (0 to 200 % of the input's), the crossover dashed
  ng_plot(32, 66, 96, 96);
  ng_vector(2);
  ng_plot(186, 66, 262, 80);
  sw_freq_grid();
  sw_i = 0;
  loop(5,
    sw_y = floor(ng_py + ng_ph * sw_i / 4) + 0.5;
    ng_col(sw_i == 2 ? 0x45433f : NG_BORDER, sw_i == 2 ? 1 : 0.6);
    gfx_line(ng_px, sw_y, ng_px + ng_pw, sw_y, 0);
    sw_i += 1;
  );
  ng_font(4, 8, 0);
  ng_col(NG_MUTED, 1);
  ng_ptxt("200%", ng_px - 6 * ng_s, ng_py, 2);
  ng_ptxt("100%", ng_px - 6 * ng_s, ng_py + ng_ph / 2, 2);
  ng_ptxt("0%", ng_px - 6 * ng_s, ng_py + ng_ph, 2);
  xover_freq > 0 ? (
    sw_x = floor(ng_freq_x(xover_freq)) + 0.5;
    ng_col(NG_ACCENT, 0.5);
    sw_y = ng_py;
    while(
      gfx_line(sw_x, sw_y, sw_x, min(sw_y + 3 * ng_s, ng_py + ng_ph), 0);
      sw_y += 6 * ng_s;
      sw_y < ng_py + ng_ph;
    );
  );
  sw_z = ng_lin_y(0, 0, 2);
  ng_col(NG_ACCENT, 0.10);
  sw_i = 0;
  loop(floor(ng_pw) + 1,
    gfx_line(ng_px + sw_i, sw_z, ng_px + sw_i, ng_lin_y(sw_side(20 * 1000 ^ (sw_i / ng_pw)), 0, 2), 0);
    sw_i += 1;
  );
  ng_col(NG_ACCENT, 1);
  sw_i = 0;
  loop(floor(ng_pw) + 1,
    sw_y = ng_lin_y(sw_side(20 * 1000 ^ (sw_i / ng_pw)), 0, 2);
    sw_i == 0 ? ng_line_start(ng_px, sw_y) : ng_line_to(ng_px + sw_i, sw_y);
    sw_i += 1;
  );

  ng_row(3);
  sprintf(#sw_v1, "%d%%", slider1);
  ng_knob_ctl(1, "WIDTH", #sw_v1, 0, 200, 100, 1, 1) ? update();
  sprintf(#sw_v2, "%d%%", slider2);
  ng_knob_ctl(2, "MIX", #sw_v2, 0, 100, 100, 1, 0) ? update();
  slider3 > 0 ? sprintf(#sw_v3, "%d Hz", slider3) : sprintf(#sw_v3, "OFF");
  ng_knob_ctl(3, "CROSSOVER", #sw_v3, 0, 500, 0, 1, 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
