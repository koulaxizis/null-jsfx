desc:NULL Console Buss GFX
author: Christos Koulaxizis
tags: console buss bus master analog mixer summing saturation crosstalk colour warm punchy bright drive glue gui
//category: Advanced
//NULL JSFX v2.9 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:1<0,3,1{Clean,Warm,Punchy,Bright}>-Character
slider2:30<0,100,1>-Drive (%)
slider3:0<-12,12,0.1>-Output (dB)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // NULL Console Buss (../console_buss.jsfx) with its own interface: same audio code, plus @gfx.
  // The summing bus of a mixing console, for the bus or master that Console Channel tracks
  // feed. Like Console Channel, each side goes through a pre-emphasis shelf, a soft saturator
  // (Pade tanh, flat beyond +-3) and the exact inverse of the shelf, but with 8 dB of headroom
  // and gentler shelves and drive, since the whole mix passes here. Then the two sides leak
  // into each other a little, as the busses of a real desk do: the other side, high-passed at
  // 1 kHz (the leak is capacitive), at up to -30 dB with Drive. Character: Clean = no shelf,
  // 9 dB of drive; Warm = +4 dB below 150 Hz, even harmonics, 12 dB; Punchy = +3 dB below
  // 60 Hz, a touch of even harmonics, 12 dB; Bright = +4 dB above 5 kHz, 9 dB. A 5 Hz DC blocker
  // follows. States below 1e-15 are cleared so silence stays free of denormals.

  // one side up to the crosstalk: emphasis, saturation, de-emphasis
  function cb_ch(x) instance(xp, ep, sp, yp) local(e, u, v, s, y)
  (
    emph ? (
      e = b0 * x - b1 * xp + sc * ep;
      xp = x;
      ep = abs(e) < 0.000000000000001 ? 0 : e;
    ) : (
      e = x;
    );
    u = e * k;
    u = u > 3 ? 3 : u < -3 ? -3 : u;
    v = u * (27 + u * u) / (27 + 9 * u * u);
    s = (v + asym * v * v) * ik;
    emph ? (
      y = (s - sc * sp + b1 * yp) / b0;
      sp = s;
      yp = abs(y) < 0.000000000000001 ? 0 : y;
    ) : (
      y = s;
    );
    y;
  );

  // one-pole high-pass for the leak
  function cb_hp(x) instance(lp)
  (
    lp = (1 - hc) * x + hc * lp;
    lp = abs(lp) < 0.000000000000001 ? 0 : lp;
    x - lp;
  );

  // DC blocker
  function cb_dc(x) instance(dx, dy) local(v)
  (
    v = x - dx + dc * dy;
    dx = x;
    dy = abs(v) < 0.000000000000001 ? 0 : v;
    v;
  );

  cb_rel = exp(-1 / (0.3 * srate));
  cb_in = cb_out = 0;
  gfx_ext_retina = 1;

  function update()
  (
    ch = slider1;
    emph = ch > 0;
    sg = 10 ^ ((ch == 2 ? 3 : 4) / 20);
    sc = exp(-2 * $pi * min(ch == 1 ? 150 : ch == 2 ? 60 : 5000, 0.45 * srate) / srate);
    ch == 3 ? (
      b0 = 1 + sc * (sg - 1);
      b1 = sg * sc;
    ) : (
      b0 = 1 + (sg - 1) * (1 - sc);
      b1 = sc;
    );
    asym = ch == 1 ? 0.1 : ch == 2 ? 0.03 : 0;
    k = 10 ^ (slider2 / 100 * (ch == 1 || ch == 2 ? 12 : 9) / 20) / 2.5;
    ik = 1 / k;
    ct = slider2 / 100 * 0.0316;
    hc = exp(-2 * $pi * min(1000, 0.45 * srate) / srate);
    go = 10 ^ (slider3 / 20);
    dc = 1 - 2 * $pi * 5 / srate;
  );

  // the static curve without the shelves: output for a steady input amplitude x
  function cb_curve(x) local(u, v)
  (
    u = x * k;
    u = u > 3 ? 3 : u < -3 ? -3 : u;
    v = u * (27 + u * u) / (27 + 9 * u * u);
    (v + asym * v * v) * ik * go;
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 7;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1); ng_hist_add(2); ng_hist_add(3);
  ng_hist_init();

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 1); ng_slider_set(2, 30); ng_slider_set(3, 0); );
    p == 1 ? ( ng_slider_set(1, 0); ng_slider_set(2, 40); ng_slider_set(3, 0); );
    p == 2 ? ( ng_slider_set(1, 1); ng_slider_set(2, 50); ng_slider_set(3, 0); );
    p == 3 ? ( ng_slider_set(1, 2); ng_slider_set(2, 60); ng_slider_set(3, 0); );
    p == 4 ? ( ng_slider_set(1, 3); ng_slider_set(2, 30); ng_slider_set(3, 0); );
    p == 5 ? ( ng_slider_set(1, 1); ng_slider_set(2, 90); ng_slider_set(3, -2); );
    p == 6 ? ( ng_slider_set(1, 1); ng_slider_set(2, 15); ng_slider_set(3, 0); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 30) && ng_pre_eq(slider3, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 40) && ng_pre_eq(slider3, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 50) && ng_pre_eq(slider3, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 60) && ng_pre_eq(slider3, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 3) && ng_pre_eq(slider2, 30) && ng_pre_eq(slider3, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 90) && ng_pre_eq(slider3, -2) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 15) && ng_pre_eq(slider3, 0) ? m = 6;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Clean Sum";
    p == 2 ? s = "Warm Mix Bus";
    p == 3 ? s = "Punchy Drum Bus";
    p == 4 ? s = "Bright Master";
    p == 5 ? s = "Driven Bus";
    p == 6 ? s = "Subtle Glue";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  // interface only: the input meter (reads the input, never changes it)
  cb_lv = max(abs(spl0), abs(spl1));
  cb_in = cb_lv > cb_in ? cb_lv : cb_in * cb_rel;
  yl = l.cb_ch(spl0);
  yr = r.cb_ch(spl1);
  hl = l.cb_hp(yl);
  hr = r.cb_hp(yr);
  spl0 = l.cb_dc(yl + ct * hr) * go;
  spl1 = r.cb_dc(yr + ct * hl) * go;

  // interface only: the output meter
  cb_lv = max(abs(spl0), abs(spl1));
  cb_out = cb_lv > cb_out ? cb_lv : cb_out * cb_rel;

@gfx 480 294
  ng_knobs_begin("CONSOLE BUSS", "ADVANCED", 480, 120, 1, 0);

  // display, left: the saturation curve (input -2..+2 across, output up; full scale at +-1)
  // without the shelves; right: the character, the drive and input and output meters
  ng_plot(64, 66, 92, 92);
  ng_grid(4, 4, 1);
  ng_font(4, 8, 0);
  ng_col(NG_MUTED, 1);
  ng_ptxt("+2", ng_px - 6 * ng_s, ng_py, 2);
  ng_ptxt("0", ng_px - 6 * ng_s, ng_py + ng_ph / 2, 2);
  ng_ptxt("-2", ng_px - 6 * ng_s, ng_py + ng_ph, 2);
  ng_col(NG_ACCENT, 0.25);
  gfx_line(ng_px, ng_py + ng_ph, ng_px + ng_pw, ng_py, 1);
  ng_col(NG_ACCENT, 1);
  cb_i = 0;
  loop(93,
    cb_yy = ng_lin_y(cb_curve(-2 + 4 * cb_i / 92), -2, 2);
    cb_xx = ng_px + ng_pw * cb_i / 92;
    cb_i == 0 ? ng_line_start(cb_xx, cb_yy) : ng_line_to(cb_xx, cb_yy);
    cb_i += 1;
  );
  ng_font(1, 7, 1);
  ng_col(NG_ACCENT, 1);
  ng_txt(slider1 == 1 ? "WARM" : slider1 == 2 ? "PUNCHY" : slider1 == 3 ? "BRIGHT" : "CLEAN", 180, 66, 0, 1);
  sprintf(#cb_st, "+%.1f DB DRIVE", slider2 / 100 * (ch == 1 || ch == 2 ? 12 : 9));
  ng_col(NG_MUTED, 1);
  ng_txt(#cb_st, 448, 66, 2, 1);
  ng_meter(180, 90, 268, 10, "IN", ng_to_db(cb_in), -140, -60);
  ng_meter(180, 118, 268, 10, "OUT", ng_to_db(cb_out), -140, -60);

  ng_row(3);
  ng_select_ctl(1, "CHARACTER", "CLEAN|WARM|PUNCHY|BRIGHT", 0) ? update();
  sprintf(#v2, "%d%%", slider2);
  ng_knob_ctl(2, "DRIVE", #v2, 0, 100, 30, 1, 0) ? update();
  sprintf(#v3, "%+.1f dB", slider3);
  ng_knob_ctl(3, "OUTPUT", #v3, -12, 12, 0, 0.1, 1) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
