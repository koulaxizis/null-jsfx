desc:NULL Pitch Correction GFX
author: Christos Koulaxizis
tags: pitch correction auto tune autotune vocal tuning key scale retune hard tune psola gui
//category: Advanced
//NULL JSFX v2.2 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:0<0,11,1{C,C#,D,D#,E,F,F#,G,G#,A,A#,B}>-Key
slider2:0<0,8,1{Chromatic,Major,Minor,Harmonic Minor,Pentatonic Major,Pentatonic Minor,Blues,Dorian,Mixolydian}>-Scale
slider3:20<0,400,1>-Retune Speed (ms)
slider4:20<0,100,1>-Humanize (%)
slider5:0<-12,12,1>-Transpose (semitones)
slider6:50<0,100,1>-Sensitivity (%)
slider7:100<0,100,1>-Mix (%)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  // NULL Pitch Correction (../pitch_correction.jsfx) with its own interface: same audio code,
  // plus @gfx.
  // Monophonic vocal tuning. The pitch is tracked with YIN on a mono, band-limited copy
  // decimated to about 11 kHz (70 Hz to 1 kHz, a new estimate every 64 decimated samples);
  // Sensitivity sets the YIN threshold (higher = more of the signal counts as pitched).
  // Each estimate is snapped to the nearest note of Key + Scale (with some hysteresis), and
  // the correction glides there at Retune Speed (0 ms = hard, stepped "robot" tuning).
  // Humanize keeps that share of the fast pitch movement (vibrato) around the note.
  // The shift is TD-PSOLA: analysis marks one input period apart, each on the same peak of
  // the cycle, and synthesis marks one output period apart; every synthesis mark adds the
  // Hann-windowed grain (two periods) around the nearest analysis mark, so the voice keeps
  // its formants. Unvoiced sounds pass with the transpose only. Latency: about 39 ms
  // (the pitch frame plus 1.5 periods of 70 Hz), reported to REAPER; the dry signal is
  // delayed to match.
  dec = max(1, floor(srate / 11025 + 0.5));
  fa = srate / dec;
  tmax = ceil(fa / 70);
  tmin = max(2, floor(fa / 1000));
  hop = 64;
  hop_s = (hop * dec) / srate;
  // (EEL2 binds '-' tighter than '+' and '/' tighter than '*': mixed chains are bracketed
  // left to right so that the VST3/CLAP port computes the same doubles)
  hm = ceil(srate / 70);             // longest period, the largest grain half-length
  mlag = tmax * dec + floor((hop * dec) / 2); // age of the pitch estimate (centre of the frame)
  lat = mlag + ceil(1.5 * hm) + 4;
  bs = lat + 2 * hm + 16;            // ring length
  in_l = 0; in_r = bs;               // input rings
  acc_l = 2 * bs; acc_r = 3 * bs;    // output accumulators
  acc_w = 4 * bs;                    // sum of the grain windows
  dbuf = 5 * bs; dbs = 1024;         // decimated analysis ring
  frm = dbuf + dbs;                  // one analysis frame (2 * tmax)
  cmn = frm + 1024;                  // YIN cumulative mean normalised difference
  amk = cmn + 512;                   // ring of the last 64 analysis marks
  lpb = amk + 64;                    // the low-passed mono signal, for the pitch marks
  memset(0, 0, lpb + bs);
  freembuf(lpb + bs);
  pdc_delay = lat;
  pdc_bot_ch = 0;
  pdc_top_ch = 2;

  hold_n = floor(0.06 / hop_s) + 1;  // keep the correction through ~60 ms dropouts
  t_uv = floor(srate / 200);         // grain period for unvoiced sounds
  ln2 = log(2);
  gd = floor(srate * 0.00035 + 0.5); // delay of the analysis low-pass

  // analysis filters: 50 Hz one-pole high-pass, 4th-order Butterworth low-pass at 1.2 kHz
  hp_c = exp((-2 * $pi * 50) / srate);
  lw = (2 * $pi * 1200) / srate;
  lc = cos(lw);
  la = sin(lw) / (2 * 0.5411961);
  b0a = (1 - lc) / 2 / (1 + la); b1a = (1 - lc) / (1 + la);
  a1a = (-2 * lc) / (1 + la); a2a = (1 - la) / (1 + la);
  la = sin(lw) / (2 * 1.3065630);
  b0b = (1 - lc) / 2 / (1 + la); b1b = (1 - lc) / (1 + la);
  a1b = (-2 * lc) / (1 + la); a2b = (1 - la) / (1 + la);
  hp_x = hp_y = 0;
  xa1 = xa2 = ya1 = ya2 = 0;
  xb1 = xb2 = yb1 = yb2 = 0;

  wp = 0; nabs = 0;
  dcnt = 0; dw = 0; hcnt = 0;
  per = per_a = t_uv; am_last = 0; mk = 0; s_next = 0;
  voiced = 0; was_v = 0; uvc = hold_n + 1;
  tf = tmax; det = 0; ms = 0; tgt = 60; sh = sh_a = 0; sh_t = 0;

  // YIN on the last 2 * tmax decimated samples: sets voiced and tf (period, decimated samples)
  function analyze() local(i, j, k, t, s, d, e, a, b, c, den, tau)
  (
    j = dw - 2 * tmax;
    j < 0 ? j += dbs;
    i = 0;
    loop(2 * tmax, frm[i] = dbuf[j]; j += 1; j >= dbs ? j = 0; i += 1;);
    e = 0; i = 0;
    loop(tmax, e += frm[i] * frm[i]; i += 1;);
    cmn[0] = 1;
    s = 0; t = 1;
    loop(tmax,
      d = 0; i = 0;
      loop(tmax, k = frm[i] - frm[i + t]; d += k * k; i += 1;);
      s += d;
      cmn[t] = s > 0 ? (d * t) / s : 1;
      t += 1;
    );
    // the first dip under the threshold, followed down to its minimum
    tau = 0; t = tmin;
    while (tau == 0 && t < tmax) (
      cmn[t] < thr ? (
        while (t + 1 < tmax && cmn[t + 1] < cmn[t]) ( t += 1; );
        tau = t;
      );
      t += 1;
    );
    voiced = tau > 0 && e > tmax * 0.00001;
    voiced ? (
      a = cmn[tau - 1]; b = cmn[tau]; c = cmn[tau + 1];
      den = (a - 2 * b) + c;
      tf = den > 0 ? tau + (0.5 * (a - c)) / den : tau;
    );
  );

  // pitch -> target note -> smoothed shift (semitones); keeps the previous hop's values
  function control() local(k, kk, pc, dd, bd, best)
  (
    per_a = per;
    sh_a = sh;
    voiced ? (
      per = min(tf * dec, hm);
      det = 69 + (12 * log(fa / tf / 440)) / ln2;
      best = 0; bd = 100;
      k = floor(det + 0.5) - 6;
      loop(13,
        kk = k - key;
        pc = kk - 12 * floor(kk / 12);
        (smask >> pc) & 1 ? (
          dd = abs(k - det);
          dd < bd ? ( bd = dd; best = k; );
        );
        k += 1;
      );
      // stay on the current note until the pitch is 0.7 semitone from it (chromatic)
      was_v ? (
        kk = tgt - key;
        pc = kk - 12 * floor(kk / 12);
        (((smask >> pc) & 1) && abs(tgt - det) < bd + 0.4) ? best = tgt;
      );
      (!was_v || best != tgt) ? (ms = det) : (ms += (det - ms) * hum_c);
      tgt = best;
      sh_t = tgt - det - hum * (ms - det);
      was_v = 1;
      uvc = 0;
    ) : (
      uvc += 1;
      uvc > hold_n ? ( was_v = 0; sh_t = 0; per = t_uv; );
    );
    sh += (sh_t - sh) * rk;
  );

  // a voiced analysis mark goes to the highest peak of the low-passed signal within a quarter
  // period of c, so the grains are centred on the same point of every cycle
  function snap(c) local(r, j, j1, k, bj, bk, bv, ym, yp, den)
  (
    r = floor(per / 4);
    j = (floor(c + 0.5) - r) + gd;
    j1 = min(floor(c + 0.5) + r + gd, nabs - 1);
    bj = -1; bk = 0; bv = -1;
    k = (wp + j) - nabs;
    k < 0 ? k += bs;
    loop(j1 - j + 1,
      lpb[k] > bv ? ( bv = lpb[k]; bj = j; bk = k; );
      k += 1; k >= bs ? k = 0;
      j += 1;
    );
    bj < 0 ? c : (
      // between samples: the vertex of the parabola through the peak and its neighbours
      // (only for a true peak, not a slope cut by the window)
      ym = lpb[bk > 0 ? bk - 1 : bs - 1];
      yp = lpb[bk < bs - 1 ? bk + 1 : 0];
      den = ym - 2 * bv + yp;
      den < 0 && ym <= bv && yp <= bv ? (bj - gd) + (0.5 * (ym - yp)) / den : bj - gd;
    );
  );

  // adds the grain for synthesis mark s; returns the output period (next mark distance)
  function place(s) local(t1, h, k, a, c, cnt, d, fr, i0, i1, i, ri, si, s2, w)
  (
    t1 = per_i / 2 ^ ((sh_i + transp) / 12);
    h = min(max(per_i, t1), hm);
    // the analysis mark nearest to s, walking back from the newest
    k = mk; c = amk[k]; cnt = 0;
    while (c > s && cnt < 63) (
      k -= 1;
      k < 0 ? k += 64;
      a = amk[k];
      a <= s ? (
        s - a <= c - s ? c = a;
        cnt = 63;
      ) : (
        c = a;
        cnt += 1;
      );
    );
    abs(c - s) > hm ? c = s;
    // the grain is read at s + (c - s), between samples: linear interpolation
    d = floor(c - s);
    fr = c - s - d;
    i0 = ceil(s - h); i1 = floor(s + h);
    ri = (wp + i0) - nabs;
    ri < 0 ? ri += bs;
    si = ri + d;
    si < 0 ? (si += bs) : si >= bs ? (si -= bs);
    s2 = si + 1;
    s2 >= bs ? s2 = 0;
    i = i0;
    loop(i1 - i0 + 1,
      w = 0.5 + 0.5 * cos(($pi * (i - s)) / h);
      acc_l[ri] += w * (in_l[si] + (in_l[s2] - in_l[si]) * fr);
      acc_r[ri] += w * (in_r[si] + (in_r[s2] - in_r[si]) * fr);
      acc_w[ri] += w;
      ri += 1; ri >= bs ? ri = 0;
      si = s2;
      s2 += 1; s2 >= bs ? s2 = 0;
      i += 1;
    );
    t1;
  );

  gfx_ext_retina = 1;

  // interface only: 3 s of the detected and the corrected pitch (MIDI note, 0 = unpitched),
  // one entry per 10 ms (300 entries, one per display pixel) in memory from 1000000
  pg_buf = 1000000; pg_len = 300; pg_w = 0; pg_n = 0;
  pg_chunk = max(1, floor(srate * 0.01));
  memset(pg_buf, 0, pg_len * 2);

  function update()
  (
    key = slider1;
    smask = slider2 == 0 ? 4095 : slider2 == 1 ? 2741 : slider2 == 2 ? 1453 : slider2 == 3 ? 2477 :
            slider2 == 4 ? 661 : slider2 == 5 ? 1193 : slider2 == 6 ? 1257 : slider2 == 7 ? 1709 : 1717;
    rk = slider3 > 0 ? 1 - exp((-hop_s * 1000) / slider3) : 1;
    hum = slider4 / 100;
    hum_c = 1 - exp(-hop_s / 0.15);
    transp = slider5;
    thr = 0.05 + (0.3 * slider6) / 100;
    mix = slider7 / 100;
  );

  // name of MIDI note k with its octave (60 = C4) in #pc_nt
  function pc_name(k) local(p)
  (
    p = k - 12 * floor(k / 12);
    strcpy(#pc_nm, p == 0 ? "C" : p == 1 ? "C#" : p == 2 ? "D" : p == 3 ? "D#" : p == 4 ? "E" :
           p == 5 ? "F" : p == 6 ? "F#" : p == 7 ? "G" : p == 8 ? "G#" : p == 9 ? "A" : p == 10 ? "A#" : "B");
    sprintf(#pc_nt, "%s%d", #pc_nm, floor(k / 12) - 1);
  );

  // left: the last 3 s of detected (grey) and corrected (silver) pitch on a 15-semitone note
  // grid around the average corrected pitch; the scale's notes are shaded (the key brighter,
  // the target note lit) and named. Right: the target note, the cents deviation of the
  // detected pitch from it, the detected frequency and the shift applied now.
  function pc_display() local(i, k, c, cnt, sum, v, y0, y1, yy, xx, p, ins, lo, hi, pv, ct)
  (
    ng_plot(52, 66, 300, 126);
    sum = 0; cnt = 0; i = 0;
    loop(pg_len, v = pg_buf[i * 2 + 1]; v > 0 ? ( sum += v; cnt += 1; ); i += 1;);
    c = cnt > 0 ? floor(sum / cnt + 0.5) : 60;
    lo = c - 7.5; hi = c + 7.5;
    ng_font(4, 7, 0);
    k = c - 7;
    loop(15,
      p = k - key - 12 * floor((k - key) / 12);
      ins = (smask >> p) & 1;
      y0 = ng_lin_y(k + 0.5, lo, hi);
      y1 = ng_lin_y(k - 0.5, lo, hi);
      ins ? (
        ng_col(NG_ACCENT, voiced && k == tgt ? 0.16 : p == 0 ? 0.09 : 0.045);
        gfx_rect(ng_px, y0, ng_pw, y1 - y0);
      );
      yy = floor(y1) + 0.5;
      ng_col(NG_BORDER, 0.6);
      gfx_line(ng_px, yy, ng_px + ng_pw, yy, 0);
      // names: the scale's notes, or the natural notes when Chromatic
      p = k - 12 * floor(k / 12);
      (smask == 4095 ? (2741 >> p) & 1 : ins) ? (
        pc_name(k);
        ng_col(NG_MUTED, 1);
        ng_ptxt(#pc_nt, ng_px - 6 * ng_s, (y0 + y1) / 2, 2);
      );
      k += 1;
    );
    yy = floor(ng_py) + 0.5;
    ng_col(NG_BORDER, 0.6);
    gfx_line(ng_px, yy, ng_px + ng_pw, yy, 0);

    // detected pitch, thin
    ng_col(NG_MUTED, 0.9);
    pv = 0; i = 0;
    loop(pg_len,
      v = pg_buf[((pg_w + i) % pg_len) * 2];
      xx = ng_px + (i + 0.5) * ng_s;
      v > 0 && pv > 0 && abs(v - pv) < 2 ? gfx_line(xx - ng_s, ng_lin_y(pv, lo, hi), xx, ng_lin_y(v, lo, hi), 1);
      pv = v; i += 1;
    );
    // corrected pitch, thick
    ng_col(NG_ACCENT, 1);
    pv = 0; i = 0;
    loop(pg_len,
      v = pg_buf[((pg_w + i) % pg_len) * 2 + 1];
      xx = ng_px + (i + 0.5) * ng_s;
      v > 0 ? (
        pv > 0 && abs(v - pv) < 2 ? ng_line_to(xx, ng_lin_y(v, lo, hi)) : ng_line_start(xx, ng_lin_y(v, lo, hi));
      );
      pv = v; i += 1;
    );

    ng_font(1, 7, 1);
    ng_col(NG_MUTED, 1);
    ng_txt("NOTE", 408, 74, 1, 1);
    ng_font(2, 22, 1);
    voiced ? (
      pc_name(tgt);
      ng_col(NG_TEXT, 1);
      ng_txt(#pc_nt, 408, 98, 1, 0);
    ) : (
      ng_col(NG_MUTED, 1);
      ng_txt("--", 408, 98, 1, 0);
    );
    // cents bar, -50 to +50
    ng_col(NG_BORDER, 1);
    gfx_rect(X(368), Y(120), 80 * ng_s, 6 * ng_s);
    voiced ? (
      ct = max(-50, min(50, (det - tgt) * 100));
      ng_col(NG_ACCENT, 0.5);
      ct > 0 ? gfx_rect(X(408), Y(120), ct * 0.8 * ng_s, 6 * ng_s)
             : gfx_rect(X(408 + ct * 0.8), Y(120), -ct * 0.8 * ng_s, 6 * ng_s);
      ng_col(NG_TEXT, 1);
      gfx_rect(X(407 + ct * 0.8), Y(117), 2 * ng_s, 12 * ng_s);
    );
    ng_col(NG_MUTED, 1);
    gfx_rect(X(408) - floor(ng_s / 2), Y(117), max(1, floor(ng_s)), 12 * ng_s);
    ng_font(3, 8.5, 0);
    ng_col(NG_TEXT, 1);
    voiced ? sprintf(#pc_c, "%+d ct", floor((det - tgt) * 100 + 0.5)) : strcpy(#pc_c, "-- ct");
    ng_txt(#pc_c, 408, 140, 1, 0);
    ng_font(4, 7.5, 0);
    ng_col(NG_MUTED, 1);
    voiced ? sprintf(#pc_f, "%.1f Hz", 440 * 2 ^ ((det - 69) / 12)) : strcpy(#pc_f, "-- Hz");
    ng_txt(#pc_f, 408, 160, 1, 0);
    sprintf(#pc_s, "SHIFT %+.2f st", sh + transp);
    ng_txt(#pc_s, 408, 178, 1, 0);
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 9;

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, 20); ng_slider_set(4, 20); ng_slider_set(5, 0); ng_slider_set(6, 50); ng_slider_set(7, 100); );
    p == 1 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, 60); ng_slider_set(4, 50); ng_slider_set(5, 0); ng_slider_set(6, 50); ng_slider_set(7, 100); );
    p == 2 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, 120); ng_slider_set(4, 60); ng_slider_set(5, 0); ng_slider_set(6, 50); ng_slider_set(7, 100); );
    p == 3 ? ( ng_slider_set(1, 0); ng_slider_set(2, 1); ng_slider_set(3, 35); ng_slider_set(4, 35); ng_slider_set(5, 0); ng_slider_set(6, 50); ng_slider_set(7, 100); );
    p == 4 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 60); ng_slider_set(7, 100); );
    p == 5 ? ( ng_slider_set(1, 9); ng_slider_set(2, 2); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 60); ng_slider_set(7, 100); );
    p == 6 ? ( ng_slider_set(1, 9); ng_slider_set(2, 5); ng_slider_set(3, 5); ng_slider_set(4, 10); ng_slider_set(5, 0); ng_slider_set(6, 50); ng_slider_set(7, 100); );
    p == 7 ? ( ng_slider_set(1, 4); ng_slider_set(2, 6); ng_slider_set(3, 30); ng_slider_set(4, 40); ng_slider_set(5, 0); ng_slider_set(6, 50); ng_slider_set(7, 100); );
    p == 8 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, 40); ng_slider_set(4, 40); ng_slider_set(5, 12); ng_slider_set(6, 50); ng_slider_set(7, 50); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 20) && ng_pre_eq(slider4, 20) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 50) && ng_pre_eq(slider7, 100) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 60) && ng_pre_eq(slider4, 50) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 50) && ng_pre_eq(slider7, 100) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 120) && ng_pre_eq(slider4, 60) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 50) && ng_pre_eq(slider7, 100) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 1) && ng_pre_eq(slider3, 35) && ng_pre_eq(slider4, 35) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 50) && ng_pre_eq(slider7, 100) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 60) && ng_pre_eq(slider7, 100) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 9) && ng_pre_eq(slider2, 2) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 60) && ng_pre_eq(slider7, 100) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 9) && ng_pre_eq(slider2, 5) && ng_pre_eq(slider3, 5) && ng_pre_eq(slider4, 10) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 50) && ng_pre_eq(slider7, 100) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 4) && ng_pre_eq(slider2, 6) && ng_pre_eq(slider3, 30) && ng_pre_eq(slider4, 40) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 50) && ng_pre_eq(slider7, 100) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 40) && ng_pre_eq(slider4, 40) && ng_pre_eq(slider5, 12) && ng_pre_eq(slider6, 50) && ng_pre_eq(slider7, 50) ? m = 8;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Natural Vocal Polish";
    p == 2 ? s = "Slow Ballad Touch";
    p == 3 ? s = "Pop Vocal C Major";
    p == 4 ? s = "Hard Tune Effect";
    p == 5 ? s = "Hard Tune A Minor";
    p == 6 ? s = "Pentatonic Snap A";
    p == 7 ? s = "Blues Lead E";
    p == 8 ? s = "Octave Up Layer";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  // pitch tracking on a band-limited mono copy, decimated
  ax = (spl0 + spl1) * 0.5;
  hp_y = hp_c * ((hp_y + ax) - hp_x);
  hp_x = ax;
  abs(hp_y) < 0.000000000000000000000000000001 ? hp_y = 0;
  ya = (b0a * hp_y + b1a * xa1 + b0a * xa2) - a1a * ya1 - a2a * ya2;
  abs(ya) < 0.000000000000000000000000000001 ? ya = 0;
  xa2 = xa1; xa1 = hp_y; ya2 = ya1; ya1 = ya;
  yb = (b0b * ya + b1b * xb1 + b0b * xb2) - a1b * yb1 - a2b * yb2;
  abs(yb) < 0.000000000000000000000000000001 ? yb = 0;
  xb2 = xb1; xb1 = ya; yb2 = yb1; yb1 = yb;
  (dcnt += 1) >= dec ? (
    dcnt = 0;
    dbuf[dw] = yb;
    dw += 1;
    dw >= dbs ? dw = 0;
    (hcnt += 1) >= hop ? (
      hcnt = 0;
      analyze();
      control();
    );
  );

  // the grains are older than the pitch estimate: use the shift one hop late, interpolated
  // across the hop
  hph = (hcnt * dec + dcnt) / (hop * dec);
  per_i = per_a + (per - per_a) * hph;
  sh_i = sh_a + (sh - sh_a) * hph;
  in_l[wp] = spl0;
  in_r[wp] = spl1;
  lpb[wp] = yb;
  // analysis marks one input period apart, as far as the pitch estimate reaches
  while (am_last <= nabs - mlag) (
    am_last += per;
    was_v ? am_last = snap(am_last);
    mk += 1;
    mk >= 64 ? mk = 0;
    amk[mk] = am_last;
  );
  // synthesis marks one output period apart, placed one grain ahead of the output
  while (s_next - nabs <= (hm + 1) - lat) ( s_next += place(s_next); );

  ro = wp - lat;
  ro < 0 ? ro += bs;
  wv = max(acc_w[ro], 0.5);
  wet_l = acc_l[ro] / wv;
  wet_r = acc_r[ro] / wv;
  acc_l[ro] = 0; acc_r[ro] = 0; acc_w[ro] = 0;
  dry_l = in_l[ro];
  dry_r = in_r[ro];
  wp += 1;
  wp >= bs ? wp = 0;
  nabs += 1;

  spl0 = dry_l * (1 - mix) + wet_l * mix;
  spl1 = dry_r * (1 - mix) + wet_r * mix;

  // interface only: pitch history (reads the audio state, never changes it)
  (pg_n += 1) >= pg_chunk ? (
    pg_buf[pg_w * 2] = voiced ? det : 0;
    pg_buf[pg_w * 2 + 1] = voiced ? det + sh : 0;
    pg_w = (pg_w + 1) % pg_len;
    pg_n = 0;
  );

@gfx 480 410
  ng_knobs_begin("PITCH CORRECTION", "ADVANCED", 480, 150, 2, 0);
  pc_display();

  ng_row(4);
  ng_select_ctl(1, "KEY", "C|C#|D|D#|E|F|F#|G|G#|A|A#|B", 0) ? update();
  ng_select_ctl(2, "SCALE", "CHROM|MAJOR|MINOR|HARM MIN|PENTA MAJ|PENTA MIN|BLUES|DORIAN|MIXOLYD", 0) ? update();
  slider3 == 0 ? strcpy(#v3, "HARD") : sprintf(#v3, "%d ms", slider3);
  ng_knob_ctl(3, "RETUNE", #v3, 0, 400, 20, 1, 0) ? update();
  sprintf(#v4, "%d%%", slider4);
  ng_knob_ctl(4, "HUMANIZE", #v4, 0, 100, 20, 1, 0) ? update();
  ng_row(3);
  sprintf(#v5, "%+d st", slider5);
  ng_knob_ctl(5, "TRANSPOSE", #v5, -12, 12, 0, 1, 1) ? update();
  sprintf(#v6, "%d%%", slider6);
  ng_knob_ctl(6, "SENSITIVITY", #v6, 0, 100, 50, 1, 0) ? update();
  sprintf(#v7, "%d%%", slider7);
  ng_knob_ctl(7, "MIX", #v7, 0, 100, 100, 1, 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
