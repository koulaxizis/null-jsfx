desc:NULL Phatter GFX
author: Christos Koulaxizis
tags: bass low end enhancement sub weight boost gui
//category: One Slider
//NULL JSFX v2.1 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:50<0,100,1>-Amount

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  // NULL Phatter (../phatter.jsfx) with its own interface: same audio code, plus @gfx.
  DB2LIN = 0.11512925464970228420;
  PI = 3.14159265358979;
  lp_l = 0; lp_r = 0;
  gfx_ext_retina = 1;

  function update()
  (
    amount = slider1 / 100;
    boost_db = amount * 12;
    boost_lin = exp(boost_db * DB2LIN);
    lp_alpha = 1 - exp(-2 * PI * 200 / srate);
  );

  // response in dB at frequency f: 1 + LP * (boost_lin - 1), LP the one-pole of @sample
  function gx_db(f) local(w, b, dr, di, dd, lr, li, hr, hi)
  (
    w = 2 * PI * min(f, srate * 0.499) / srate;
    b = 1 - lp_alpha;
    dr = 1 - b * cos(w);
    di = b * sin(w);
    dd = dr * dr + di * di;
    lr = lp_alpha * dr / dd;
    li = -lp_alpha * di / dd;
    hr = 1 + lr * (boost_lin - 1);
    hi = li * (boost_lin - 1);
    10 * log10(max(hr * hr + hi * hi, 0.0000000001));
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 6;

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 50); );
    p == 1 ? ( ng_slider_set(1, 20); );
    p == 2 ? ( ng_slider_set(1, 30); );
    p == 3 ? ( ng_slider_set(1, 40); );
    p == 4 ? ( ng_slider_set(1, 50); );
    p == 5 ? ( ng_slider_set(1, 65); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 50) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 20) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 30) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 40) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 50) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 65) ? m = 5;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Drum Bus Warmth";
    p == 2 ? s = "Bass Fatten";
    p == 3 ? s = "Kick Weight";
    p == 4 ? s = "Small Synth Body";
    p == 5 ? s = "Thin Sample Fix";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  lp_l = lp_l + lp_alpha * (spl0 - lp_l);
  lp_r = lp_r + lp_alpha * (spl1 - lp_r);
  spl0 = spl0 + lp_l * (boost_lin - 1);
  spl1 = spl1 + lp_r * (boost_lin - 1);

@gfx 360 240
  ng_one_slider_begin("PHATTER");

  // display: the low shelf's magnitude response, 200 Hz corner dashed
  ng_plot(46, 64, 284, 78);
  ng_grid_freq(20);
  gx_x = floor(ng_freq_x(200)) + 0.5;
  ng_col(NG_ACCENT, 0.5);
  gx_y = ng_py;
  while(
    gfx_line(gx_x, gx_y, gx_x, min(gx_y + 3 * ng_s, ng_py + ng_ph), 0);
    gx_y += 6 * ng_s;
    gx_y < ng_py + ng_ph;
  );
  gx_lim = 40 / 3;
  gx_zy = ng_lin_y(0, -gx_lim, gx_lim);
  ng_col(NG_ACCENT, 0.10);
  gx_i = 0;
  loop(floor(ng_pw) + 1,
    gfx_line(ng_px + gx_i, gx_zy, ng_px + gx_i, ng_lin_y(gx_db(20 * 1000 ^ (gx_i / ng_pw)), -gx_lim, gx_lim), 0);
    gx_i += 1;
  );
  ng_col(NG_ACCENT, 1);
  gx_i = 0;
  loop(floor(ng_pw) + 1,
    gx_y = ng_lin_y(gx_db(20 * 1000 ^ (gx_i / ng_pw)), -gx_lim, gx_lim);
    gx_i == 0 ? ng_line_start(ng_px, gx_y) : ng_line_to(ng_px + gx_i, gx_y);
    gx_i += 1;
  );

  // slider card
  slider1 == 0 ? sprintf(#gx_cap, "FLAT") : sprintf(#gx_cap, "BASS +%.1f dB", slider1 * 0.12);
  sprintf(#gx_val, "%d", floor(slider1 + 0.5));
  ng_set_slider(ng_one_slider_control("AMOUNT", #gx_cap, #gx_val, "FLAT", "PHAT", slider1, 0, 100, 50, 0), 1) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
