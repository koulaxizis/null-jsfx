desc:NULL Closer GFX
author: Christos Koulaxizis
tags: closer vocal voice presence proximity upfront forward compression dialogue podcast one knob gui
//category: One Slider
//NULL JSFX v4.1 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:40<0,100,1>-Amount

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // NULL Closer (../closer.jsfx) with its own interface: same audio code, plus @gfx.
  // One knob that brings a voice forward: a light compressor (threshold -24 dBFS, ratio up to
  // 3:1, 5 ms attack, 120 ms release, up to +3 dB make-up), a presence lift around 3.5 kHz (up to
  // +5 dB) that eases off by up to half while the compressor works hard (so loud words do not
  // get harsh), and a proximity lift below 180 Hz (up to +2.5 dB). At 0 it is untouched.
  cl_f = min(3500, 0.45 * srate);
  cl_w = 2 * $pi * cl_f / srate;
  cl_al = sin(cl_w) / (2 * 0.9);
  cl_a0 = 1 + cl_al;
  cl_b0 = cl_al / cl_a0;
  cl_b2 = -cl_al / cl_a0;
  cl_a1 = -2 * cos(cl_w) / cl_a0;
  cl_a2 = (1 - cl_al) / cl_a0;
  cl_lc = 1 - exp(-2 * $pi * min(180, 0.45 * srate) / srate);
  cl_att = 1 - exp(-1 / (0.005 * srate));
  cl_rel = 1 - exp(-1 / (0.12 * srate));
  cl_thr = -24;
  cl_e = 0;
  // the presence band: a band-pass biquad with 0 dB at its peak
  function bp(x) local(y)
  (
    y = cl_b0 * x + cl_b2 * this.x2 - cl_a1 * this.y1 - cl_a2 * this.y2;
    this.x2 = this.x1; this.x1 = x;
    this.y2 = this.y1; this.y1 = y;
    y;
  );
  function lp(x) ( this.y += (x - this.y) * cl_lc; );
  gfx_ext_retina = 1;

  function update()
  (
    cl_a = slider1 / 100;
    cl_ratio = 1 + 2 * cl_a;
    cl_kp = 10 ^ (cl_a * 5 / 20) - 1;
    cl_kl = 10 ^ (cl_a * 2.5 / 20) - 1;
    cl_mu = 10 ^ (cl_a * 3 / 20);
  );

  // the response (dB) at frequency f with presence k: |1 + k * band-pass + proximity * low-pass|
  function cl_db(f, k) local(w, c1, s1, c2, s2, nr, ni, dr, di, d, br, bi, lr, li)
  (
    w = 2 * $pi * min(f, srate * 0.499) / srate;
    c1 = cos(w); s1 = sin(w); c2 = cos(2 * w); s2 = sin(2 * w);
    nr = cl_b0 + cl_b2 * c2; ni = -(cl_b2 * s2);
    dr = 1 + cl_a1 * c1 + cl_a2 * c2; di = -(cl_a1 * s1 + cl_a2 * s2);
    d = max(dr * dr + di * di, 0.0000000001);
    br = (nr * dr + ni * di) / d; bi = (ni * dr - nr * di) / d;
    dr = 1 - (1 - cl_lc) * c1; di = (1 - cl_lc) * s1;
    d = max(dr * dr + di * di, 0.0000000001);
    lr = cl_lc * dr / d; li = -cl_lc * di / d;
    nr = 1 + k * br + cl_kl * lr; ni = k * bi + cl_kl * li;
    10 * log10(max(nr * nr + ni * ni, 0.0000000001));
  );

  // a text at pixel (x, y), vertically centred; align 0 left, 1 centre, 2 right
  function clo_lbl(str, x, y, align) local(w, h)
  (
    gfx_measurestr(str, w, h);
    gfx_x = align == 1 ? x - w / 2 : (align == 2 ? x - w : x);
    gfx_y = y - gfx_texth / 2;
    gfx_drawstr(str);
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 12;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1);
  ng_hist_init();
  ng_dice_add(1, 0, 100, 1, 0);

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 40); );
    p == 1 ? ( ng_slider_set(1, 15); );
    p == 2 ? ( ng_slider_set(1, 50); );
    p == 3 ? ( ng_slider_set(1, 35); );
    p == 4 ? ( ng_slider_set(1, 60); );
    p == 5 ? ( ng_slider_set(1, 75); );
    p == 6 ? ( ng_slider_set(1, 25); );
    p == 7 ? ( ng_slider_set(1, 65); );
    p == 8 ? ( ng_slider_set(1, 30); );
    p == 9 ? ( ng_slider_set(1, 85); );
    p == 10 ? ( ng_slider_set(1, 100); );
    p == 11 ? ( ng_slider_set(1, 20); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 40) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 15) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 50) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 35) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 60) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 75) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 25) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 65) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 30) ? m = 8;
    m < 0 && ng_pre_eq(slider1, 85) ? m = 9;
    m < 0 && ng_pre_eq(slider1, 100) ? m = 10;
    m < 0 && ng_pre_eq(slider1, 20) ? m = 11;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Gentle Forward";
    p == 2 ? s = "Podcast Voice";
    p == 3 ? s = "Dialogue Clarity";
    p == 4 ? s = "Pop Vocal Front";
    p == 5 ? s = "Rap Up Front";
    p == 6 ? s = "Backing Vocal Lift";
    p == 7 ? s = "Voice Over Close";
    p == 8 ? s = "Acoustic Guitar Front";
    p == 9 ? s = "Radio Voice";
    p == 10 ? s = "In Your Face";
    p == 11 ? s = "Choir Presence";
    s;
  );

  // the hint line under the controls: a short help text per slider (from tools/site_content.json)
  function ng_hint_text(i) local(s)
  (
    s = "";
    i == 1 ? s = "How far forward the voice comes: 0 is untouched";
    s;
  );

  function ng_presets() local(i)
  (
    ng_hint_i > 0 && !ng_pre_open ? ng_hint(ng_hint_text(ng_hint_i));
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  cl_in = max(abs(spl0), abs(spl1));
  cl_e += (cl_in - cl_e) * (cl_in > cl_e ? cl_att : cl_rel);
  cl_over = 20 * log10(max(cl_e, 0.000001)) - cl_thr;
  cl_gr = cl_over > 0 ? cl_over * (1 - 1 / cl_ratio) : 0;
  cl_g = 10 ^ (-cl_gr / 20) * cl_mu;
  cl_p = cl_kp * (1 - 0.5 * min(1, cl_gr / 6));
  cl_l = spl0 * cl_g;
  cl_r = spl1 * cl_g;
  spl0 = cl_l + bl.bp(cl_l) * cl_p + ll.lp(cl_l) * cl_kl;
  spl1 = cl_r + br.bp(cl_r) * cl_p + lr.lp(cl_r) * cl_kl;

@gfx 360 240
  ng_one_slider_begin("CLOSER");

  // display: the presence and proximity lift (make-up left out); the dim curve is the
  // presence while the compressor works hard
  ng_plot(46, 64, 284, 78);
  ng_grid_freq(12);
  ng_col(NG_ACCENT, 0.45);
  i = 0;
  loop(floor(ng_pw) + 1,
    yy = ng_lin_y(cl_db(20 * 1000 ^ (i / ng_pw), cl_kp * 0.5), -8, 8);
    i == 0 ? ng_line_start(ng_px, yy) : ng_line_to(ng_px + i, yy);
    i += 1;
  );
  ng_col(NG_ACCENT, 1);
  i = 0;
  loop(floor(ng_pw) + 1,
    yy = ng_lin_y(cl_db(20 * 1000 ^ (i / ng_pw), cl_kp), -8, 8);
    i == 0 ? ng_line_start(ng_px, yy) : ng_line_to(ng_px + i, yy);
    i += 1;
  );

  // slider card
  slider1 == 0 ? sprintf(#cap, "UNTOUCHED") : sprintf(#cap, "RATIO %.1f:1  PRESENCE +%.1f dB", cl_ratio, cl_a * 5);
  sprintf(#val, "%d", floor(slider1 + 0.5));
  ng_set_slider(ng_one_slider_control("AMOUNT", #cap, #val, "OFF", "CLOSE", slider1, 0, 100, 40, 0), 1) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
