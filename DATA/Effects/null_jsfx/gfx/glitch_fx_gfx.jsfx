desc:NULL Glitch FX GFX
author: Christos Koulaxizis
tags: glitch stutter pitch tape-stop reverse granular freeze random creative midi trigger gui
//category: Advanced
//NULL JSFX v2.5 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:4<0.1,20,0.1>-Rate (Hz)
slider2:8<1,64,1>-Stutter Length (1/x notes)
slider3:1<0,1,1{OFF,ON}>-Stutter
slider4:30<0,100,1>-Gate Depth (%)
slider5:0<0,1,1{OFF,ON}>-Gate
slider6:0<-24,24,0.1>-Pitch Shift (semitones)
slider7:0<0,1,1{OFF,ON}>-Pitch Shift
slider8:0<0,100,1>-Reverse Chance (%)
slider9:0<0,1,1{OFF,ON}>-Reverse
slider10:300<10,1000,10>-Tape Stop Time (ms)
slider11:0<0,1,1{OFF,ON}>-Tape Stop
slider12:200<10,500,10>-Grain Size (ms)
slider13:0<0,1,1{OFF,ON}>-Granular
slider14:50<0,100,1>-Mix (%)
slider15:0<0,1,1{Auto,MIDI}>-Trigger

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  // NULL Glitch FX (../glitch_fx.jsfx) with its own interface: same audio code, plus @gfx.
  // Every 1/Rate seconds a new "event" starts. At each event the plugin grabs the most
  // recent slice of audio (Stutter Length, in note values at the project tempo) and
  // loops it until the next event. On top of that loop, each switch adds a variation:
  // Gate chops it, Pitch Shift replays it faster/slower, Reverse plays it backwards
  // (with Reverse Chance), Tape Stop slows some events to a halt, and Granular loops a
  // short windowed grain instead of the whole slice.
  // Every effect also works with Stutter OFF, on the live signal: Reverse plays the
  // audio back in reversed chunks (each chunk = Stutter Length) during the events it
  // picks, Granular turns the live signal into overlapping Hann grains taken from the
  // last moments of audio (two grains, half a grain apart), Pitch Shift and Tape Stop
  // change their playback speed, and Gate chops whatever comes out.
  // Trigger MIDI plays the effects from held MIDI notes instead of the dice: C3, C#3, D3,
  // D#3, E3 and F3 (60..65) hold Stutter, Gate, Pitch Shift, Reverse, Tape Stop and Granular
  // (several at once combine, the switches and Rate are ignored), every note-on in that range
  // starts a new event (a fresh slice, the tape stop from full speed), and the velocity of
  // the latest note scales the Mix (a 5 ms fade); with no note held the dry signal passes.
  // Every MIDI message passes through.
  buf_size = ceil(srate * 4);
  buf_l = 0;
  buf_r = buf_l + buf_size;
  memset(buf_l, 0, 2 * buf_size);
  freembuf(buf_r + buf_size);
  // MIDI: when each effect note was pressed (0 = not held) and its velocity, this block's events
  held = buf_r + buf_size;
  hvel = held + 8;
  evq = hvel + 8;
  memset(held, 0, 16);
  freembuf(evq + 1024);
  stamp = 0; m_new = 0; m_tgt = 0; m_amt = 0;
  m_ofs = m_1 = m_2 = m_3 = 0;
  m_k = 1 - exp(-1 / (srate * 0.005));
  wpos = 0;
  ev_cnt = 1000000000;
  slice_start = 0;
  read = 0;
  speed = 1;
  dir = 1;
  tape = 0;
  rread = 0;
  g1ph = 0; g2ph = 0.5;
  g1st = g2st = 0;
  seed = 12345;

  // random value in [0, x): a Park-Miller generator in exact double arithmetic, so it gives
  // the same sequence on every CPU (and in the VST3/CLAP build)
  function prand(x)
  (
    seed *= 16807; seed -= floor(seed / 2147483647) * 2147483647;
    seed / 2147483648 * x;
  );

  function rd(buf, p) local(i, f, i2)
  (
    p < 0 ? p += buf_size;
    p >= buf_size ? p -= buf_size;
    i = floor(p);
    f = p - i;
    i2 = i + 1;
    i2 >= buf_size ? i2 = 0;
    buf[i] + (buf[i2] - buf[i]) * f;
  );
  gfx_ext_retina = 1;

  function update()
  (
    ev_len = max(1, floor(srate / slider1));
    pitch = slider7 ? 2 ^ (slider6 / 12) : 1;
    gate_depth = slider4 / 100;
    rev_chance = slider8;
    tape_len = max(1, srate * slider10 / 1000);
    grain_len = max(16, floor(srate * slider12 / 1000));
    mix = slider14 / 100;
    trig_midi = slider15 >= 0.5;
    pitch_m = 2 ^ (slider6 / 12);
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 12;

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 4); ng_slider_set(2, 8); ng_slider_set(3, 1); ng_slider_set(4, 30); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); ng_slider_set(10, 300); ng_slider_set(11, 0); ng_slider_set(12, 200); ng_slider_set(13, 0); ng_slider_set(14, 50); ng_slider_set(15, 0); );
    p == 1 ? ( ng_slider_set(1, 2); ng_slider_set(2, 16); ng_slider_set(3, 1); ng_slider_set(4, 30); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); ng_slider_set(10, 300); ng_slider_set(11, 0); ng_slider_set(12, 200); ng_slider_set(13, 0); ng_slider_set(14, 70); ng_slider_set(15, 0); );
    p == 2 ? ( ng_slider_set(1, 4); ng_slider_set(2, 32); ng_slider_set(3, 1); ng_slider_set(4, 80); ng_slider_set(5, 1); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); ng_slider_set(10, 300); ng_slider_set(11, 0); ng_slider_set(12, 200); ng_slider_set(13, 0); ng_slider_set(14, 60); ng_slider_set(15, 0); );
    p == 3 ? ( ng_slider_set(1, 2); ng_slider_set(2, 8); ng_slider_set(3, 1); ng_slider_set(4, 30); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 50); ng_slider_set(9, 1); ng_slider_set(10, 300); ng_slider_set(11, 0); ng_slider_set(12, 200); ng_slider_set(13, 0); ng_slider_set(14, 60); ng_slider_set(15, 0); );
    p == 4 ? ( ng_slider_set(1, 1); ng_slider_set(2, 4); ng_slider_set(3, 1); ng_slider_set(4, 30); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); ng_slider_set(10, 400); ng_slider_set(11, 1); ng_slider_set(12, 200); ng_slider_set(13, 0); ng_slider_set(14, 70); ng_slider_set(15, 0); );
    p == 5 ? ( ng_slider_set(1, 8); ng_slider_set(2, 16); ng_slider_set(3, 1); ng_slider_set(4, 30); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); ng_slider_set(10, 300); ng_slider_set(11, 0); ng_slider_set(12, 40); ng_slider_set(13, 1); ng_slider_set(14, 50); ng_slider_set(15, 0); );
    p == 6 ? ( ng_slider_set(1, 2); ng_slider_set(2, 4); ng_slider_set(3, 0); ng_slider_set(4, 30); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 40); ng_slider_set(9, 1); ng_slider_set(10, 300); ng_slider_set(11, 0); ng_slider_set(12, 200); ng_slider_set(13, 0); ng_slider_set(14, 100); ng_slider_set(15, 0); );
    p == 7 ? ( ng_slider_set(1, 4); ng_slider_set(2, 8); ng_slider_set(3, 0); ng_slider_set(4, 30); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); ng_slider_set(10, 300); ng_slider_set(11, 0); ng_slider_set(12, 120); ng_slider_set(13, 1); ng_slider_set(14, 50); ng_slider_set(15, 0); );
    p == 8 ? ( ng_slider_set(1, 4); ng_slider_set(2, 16); ng_slider_set(3, 0); ng_slider_set(4, 100); ng_slider_set(5, 1); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); ng_slider_set(10, 300); ng_slider_set(11, 0); ng_slider_set(12, 200); ng_slider_set(13, 0); ng_slider_set(14, 100); ng_slider_set(15, 0); );
    p == 9 ? ( ng_slider_set(1, 4); ng_slider_set(2, 16); ng_slider_set(3, 1); ng_slider_set(4, 100); ng_slider_set(5, 0); ng_slider_set(6, 12); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); ng_slider_set(10, 400); ng_slider_set(11, 0); ng_slider_set(12, 80); ng_slider_set(13, 0); ng_slider_set(14, 100); ng_slider_set(15, 1); );
    p == 10 ? ( ng_slider_set(1, 4); ng_slider_set(2, 32); ng_slider_set(3, 1); ng_slider_set(4, 80); ng_slider_set(5, 0); ng_slider_set(6, 7); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); ng_slider_set(10, 250); ng_slider_set(11, 0); ng_slider_set(12, 40); ng_slider_set(13, 0); ng_slider_set(14, 100); ng_slider_set(15, 1); );
    p == 11 ? ( ng_slider_set(1, 4); ng_slider_set(2, 4); ng_slider_set(3, 1); ng_slider_set(4, 60); ng_slider_set(5, 0); ng_slider_set(6, -12); ng_slider_set(7, 0); ng_slider_set(8, 0); ng_slider_set(9, 0); ng_slider_set(10, 900); ng_slider_set(11, 0); ng_slider_set(12, 200); ng_slider_set(13, 0); ng_slider_set(14, 100); ng_slider_set(15, 1); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 4) && ng_pre_eq(slider2, 8) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, 30) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 300) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 200) && ng_pre_eq(slider13, 0) && ng_pre_eq(slider14, 50) && ng_pre_eq(slider15, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 16) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, 30) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 300) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 200) && ng_pre_eq(slider13, 0) && ng_pre_eq(slider14, 70) && ng_pre_eq(slider15, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 4) && ng_pre_eq(slider2, 32) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, 80) && ng_pre_eq(slider5, 1) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 300) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 200) && ng_pre_eq(slider13, 0) && ng_pre_eq(slider14, 60) && ng_pre_eq(slider15, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 8) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, 30) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 50) && ng_pre_eq(slider9, 1) && ng_pre_eq(slider10, 300) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 200) && ng_pre_eq(slider13, 0) && ng_pre_eq(slider14, 60) && ng_pre_eq(slider15, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 4) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, 30) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 400) && ng_pre_eq(slider11, 1) && ng_pre_eq(slider12, 200) && ng_pre_eq(slider13, 0) && ng_pre_eq(slider14, 70) && ng_pre_eq(slider15, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 8) && ng_pre_eq(slider2, 16) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, 30) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 300) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 40) && ng_pre_eq(slider13, 1) && ng_pre_eq(slider14, 50) && ng_pre_eq(slider15, 0) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 4) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 30) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 40) && ng_pre_eq(slider9, 1) && ng_pre_eq(slider10, 300) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 200) && ng_pre_eq(slider13, 0) && ng_pre_eq(slider14, 100) && ng_pre_eq(slider15, 0) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 4) && ng_pre_eq(slider2, 8) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 30) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 300) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 120) && ng_pre_eq(slider13, 1) && ng_pre_eq(slider14, 50) && ng_pre_eq(slider15, 0) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 4) && ng_pre_eq(slider2, 16) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 1) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 300) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 200) && ng_pre_eq(slider13, 0) && ng_pre_eq(slider14, 100) && ng_pre_eq(slider15, 0) ? m = 8;
    m < 0 && ng_pre_eq(slider1, 4) && ng_pre_eq(slider2, 16) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 12) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 400) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 80) && ng_pre_eq(slider13, 0) && ng_pre_eq(slider14, 100) && ng_pre_eq(slider15, 1) ? m = 9;
    m < 0 && ng_pre_eq(slider1, 4) && ng_pre_eq(slider2, 32) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, 80) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 7) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 250) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 40) && ng_pre_eq(slider13, 0) && ng_pre_eq(slider14, 100) && ng_pre_eq(slider15, 1) ? m = 10;
    m < 0 && ng_pre_eq(slider1, 4) && ng_pre_eq(slider2, 4) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, 60) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, -12) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 0) && ng_pre_eq(slider10, 900) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 200) && ng_pre_eq(slider13, 0) && ng_pre_eq(slider14, 100) && ng_pre_eq(slider15, 1) ? m = 11;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Beat Repeat";
    p == 2 ? s = "Gated Stutter";
    p == 3 ? s = "Reverse Glitch";
    p == 4 ? s = "Tape Stop Hits";
    p == 5 ? s = "Granular Buzz";
    p == 6 ? s = "Live Reverse Chunks";
    p == 7 ? s = "Granular Vocal Haze";
    p == 8 ? s = "Chopped Pad Gate";
    p == 9 ? s = "MIDI Stutter Pads";
    p == 10 ? s = "MIDI Glitch Kit";
    p == 11 ? s = "MIDI Slow Tape Drops";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@block
  // MIDI: every message passes through; notes are applied at their offsets in @sample
  mq_n = 0;
  while (midirecv(m_ofs, m_1, m_2, m_3)) (
    midisend(m_ofs, m_1, m_2, m_3);
    mq_n < 256 ? (
      evq[mq_n * 4] = m_ofs;
      evq[mq_n * 4 + 1] = m_1;
      evq[mq_n * 4 + 2] = m_2;
      evq[mq_n * 4 + 3] = m_3;
      mq_n += 1;
    );
  );
  mq_i = 0;
  si = 0;

@sample
  // MIDI notes due now: C3..F3 held / released, all notes off
  while (mq_i < mq_n && evq[mq_i * 4] <= si) (
    m_st = evq[mq_i * 4 + 1] & 0xF0;
    m_d = evq[mq_i * 4 + 2];
    m_n = m_d - 60;
    m_st == 0x90 && evq[mq_i * 4 + 3] > 0 && m_n >= 0 && m_n < 6 ? (
      stamp += 1;
      held[m_n] = stamp;
      hvel[m_n] = evq[mq_i * 4 + 3];
      m_new = 1;
    ) : (m_st == 0x80 || m_st == 0x90) && m_n >= 0 && m_n < 6 ? (
      held[m_n] = 0;
    ) : m_st == 0xB0 && (m_d == 120 || m_d == 123) ? (
      memset(held, 0, 8);
    );
    // the latest held note's velocity sets the amount
    m_tgt = 0;
    m_b = 0;
    m_i = 0;
    loop(6,
      held[m_i] > m_b ? ( m_b = held[m_i]; m_tgt = hvel[m_i] / 127; );
      m_i += 1;
    );
    mq_i += 1;
  );
  si += 1;
  // the switches: the sliders, or under Trigger MIDI the held notes
  trig_midi ? (
    sw_st = held[0] > 0; sw_gate = held[1] > 0; sw_pitch = held[2] > 0;
    sw_rev = held[3] > 0; sw_tape = held[4] > 0; sw_gran = held[5] > 0;
    m_amt += (m_tgt - m_amt) * m_k;
  ) : (
    sw_st = slider3; sw_gate = slider5; sw_gran = slider13;
  );

  buf_l[wpos] = spl0;
  buf_r[wpos] = spl1;

  bpm = tempo > 0 ? tempo : 120;
  slice_len = max(16, min(buf_size / 2, floor(srate * 240 / bpm / slider2)));
  loop_len = sw_gran ? min(grain_len, slice_len) : slice_len;

  ev_cnt += 1;
  trig_midi ? (
    // a note-on starts a new event; Reverse and Tape Stop follow their notes
    m_new ? (
      m_new = 0;
      ev_cnt = 0;
      slice_start = wpos - slice_len;
      read = 0;
      rread = 0;
    );
    dir = sw_rev ? -1 : 1;
    tape = sw_tape;
  ) : ev_cnt >= ev_len ? (
    // new event: capture the latest slice and roll the dice
    ev_cnt = 0;
    slice_start = wpos - slice_len;
    read = 0;
    rread = 0;
    dir = slider9 && prand(100) < rev_chance ? -1 : 1;
    tape = slider11 && prand(100) < 30;
  );

  speed = trig_midi ? (sw_pitch ? pitch_m : 1) : pitch;
  tape ? speed *= max(0, 1 - ev_cnt / tape_len);

  sw_st ? (
    read += speed;
    read >= loop_len ? read -= loop_len;
    pos = dir > 0 ? slice_start + read : slice_start + loop_len - 1 - read;
    wet_l = rd(buf_l, pos);
    wet_r = rd(buf_r, pos);
    // short fades at the loop seam (or a full Hann window for grains)
    ph = read / loop_len;
    win = sw_gran ? 0.5 - 0.5 * cos(2 * $pi * ph) : min(1, min(ph, 1 - ph) * loop_len / (0.003 * srate));
    wet_l *= win;
    wet_r *= win;
  ) : sw_gran ? (
    // no stutter, granular: two overlapping grains read from the recent past
    gstep = 1 / grain_len;
    g1ph += gstep; g1ph >= 1 ? (g1ph -= 1; g1st = wpos - grain_len * (max(speed, 1) + 1) - prand(grain_len););
    g2ph += gstep; g2ph >= 1 ? (g2ph -= 1; g2st = wpos - grain_len * (max(speed, 1) + 1) - prand(grain_len););
    gp1 = dir > 0 ? g1ph : 1 - g1ph;
    gp2 = dir > 0 ? g2ph : 1 - g2ph;
    gw1 = 0.5 - 0.5 * cos(2 * $pi * g1ph);
    gw2 = 0.5 - 0.5 * cos(2 * $pi * g2ph);
    wet_l = rd(buf_l, g1st + gp1 * grain_len * speed) * gw1 + rd(buf_l, g2st + gp2 * grain_len * speed) * gw2;
    wet_r = rd(buf_r, g1st + gp1 * grain_len * speed) * gw1 + rd(buf_r, g2st + gp2 * grain_len * speed) * gw2;
  ) : dir < 0 ? (
    // no stutter, reverse: play each newest chunk of audio backwards
    rread += speed;
    rread >= slice_len ? (rread -= slice_len; slice_start = wpos - slice_len;);
    pos = slice_start + slice_len - 1 - rread;
    wet_l = rd(buf_l, pos);
    wet_r = rd(buf_r, pos);
    ph = rread / slice_len;
    win = min(1, min(ph, 1 - ph) * slice_len / (0.003 * srate));
    wet_l *= win;
    wet_r *= win;
  ) : (
    // no stutter: the effects act on the live signal (pitch via a short varispeed read)
    read += 1 - speed;
    read < 0 ? read += 0.05 * srate;
    read >= 0.05 * srate ? read -= 0.05 * srate;
    wet_l = rd(buf_l, wpos - 1 - read);
    wet_r = rd(buf_r, wpos - 1 - read);
  );

  sw_gate ? (
    // gate: silence the second half of every stutter repetition
    (ev_cnt % max(16, slice_len / 2)) > slice_len / 4 ? (
      wet_l *= 1 - gate_depth;
      wet_r *= 1 - gate_depth;
    );
  );

  wpos += 1;
  wpos >= buf_size ? wpos = 0;

  mx = trig_midi ? mix * m_amt : mix;
  spl0 = spl0 * (1 - mx) + wet_l * mx;
  spl1 = spl1 * (1 - mx) + wet_r * mx;

@gfx 480 408
  ng_knobs_begin("GLITCH FX", "ADVANCED", 480, 120, 2, 1);

  // display: one second of the wet level (the loop seams or grain windows and the gate),
  // events dashed, the playhead inside the stutter loop as a thin line; the random
  // Reverse and Tape Stop are left out. Trigger MIDI: the effects the held notes play, from
  // the note-on, and their names
  ng_plot(ng_vx + 26, ng_vy + 4, ng_vw - 30, ng_vh - 20);
  ng_grid(5, 4, 0);
  ng_font(4, 8, 0);
  ng_col(NG_MUTED, 1);
  ng_ptxt("100%", ng_px - 6 * ng_s, ng_py, 2);
  ng_ptxt("50%", ng_px - 6 * ng_s, ng_py + ng_ph / 2, 2);
  ng_ptxt("0", ng_px - 6 * ng_s, ng_py + ng_ph, 2);
  gl_i = 1;
  loop(4, sprintf(#gl_t, "%.1f s", gl_i * 0.2); ng_ptxt(#gl_t, ng_px + ng_pw * gl_i / 5, ng_py + ng_ph + 10 * ng_s, 1); gl_i += 1;);

  gl_bpm = tempo > 0 ? tempo : 120;
  gl_evl = trig_midi ? 2 : 1 / slider1;
  gl_s3 = trig_midi ? held[0] > 0 : slider3;
  gl_s5 = trig_midi ? held[1] > 0 : slider5;
  gl_s13 = trig_midi ? held[5] > 0 : slider13;
  gl_sl = min(2, 240 / gl_bpm / slider2);
  gl_ll = gl_s13 ? min(slider12 / 1000, gl_sl) : gl_sl;
  gl_pr = (trig_midi ? held[2] > 0 : slider7) ? 2 ^ (slider6 / 12) : 1;

  // events
  ng_col(NG_ACCENT, 0.5);
  gl_t = 0;
  while (gl_t < 1) (
    gl_x = floor(ng_lin_x(gl_t, 0, 1)) + 0.5;
    gl_y = ng_py;
    while (gfx_line(gl_x, gl_y, gl_x, min(gl_y + 3 * ng_s, ng_py + ng_ph), 0); gl_y += 6 * ng_s; gl_y < ng_py + ng_ph;);
    gl_t += gl_evl;
  );

  // level and playhead per column
  gl_n = floor(ng_pw);
  gl_i = 0;
  loop(gl_n + 1,
    gl_t = gl_i / gl_n;
    gl_te = gl_t - floor(gl_t / gl_evl) * gl_evl;
    gl_env = 1;
    gl_head = -1;
    gl_s3 ? (
      gl_rp = gl_te * gl_pr;
      gl_rp -= floor(gl_rp / gl_ll) * gl_ll;
      gl_ph = gl_rp / gl_ll;
      gl_env = gl_s13 ? 0.5 - 0.5 * cos(2 * $pi * gl_ph) : min(1, min(gl_ph, 1 - gl_ph) * gl_ll / 0.003);
      gl_head = gl_ph;
    );
    gl_s5 ? (
      gl_per = gl_sl / 2;
      gl_te - floor(gl_te / gl_per) * gl_per > gl_sl / 4 ? gl_env *= 1 - slider4 / 100;
    );
    gl_x = ng_px + ng_pw * gl_i / gl_n;
    gl_y = ng_lin_y(gl_env, 0, 1);
    ng_col(NG_ACCENT, 0.10);
    gfx_line(gl_x, gl_y, gl_x, ng_py + ng_ph, 0);
    gl_head >= 0 ? (
      gl_hy = ng_lin_y(gl_head, 0, 1);
      ng_col(NG_MUTED, 0.8);
      gl_i > 0 && gl_head >= gl_ph0 ? gfx_line(gl_hx0, gl_hy0, gl_x, gl_hy, 1);
      gl_hx0 = gl_x; gl_hy0 = gl_hy; gl_ph0 = gl_head;
    );
    ng_col(NG_ACCENT, 1);
    gl_i == 0 ? ng_line_start(gl_x, gl_y) : ng_line_to(gl_x, gl_y);
    gl_i += 1;
  );

  // Trigger MIDI: the held effects by name
  trig_midi ? (
    strcpy(#gl_m, "MIDI:");
    gl_i = 0;
    loop(6,
      held[gl_i] > 0 ? (
        sprintf(#gl_m2, "%s %s", #gl_m, gl_i == 0 ? "STUTTER" : gl_i == 1 ? "GATE" : gl_i == 2 ? "PITCH" :
                                        gl_i == 3 ? "REVERSE" : gl_i == 4 ? "TAPE STOP" : "GRANULAR");
        strcpy(#gl_m, #gl_m2);
      );
      gl_i += 1;
    );
    strlen(#gl_m) <= 5 ? strcpy(#gl_m, "MIDI: HOLD C3 TO F3");
    ng_col(NG_TEXT, 1);
    ng_ptxt(#gl_m, ng_px + 6 * ng_s, ng_py + 8 * ng_s, 0);
  );

  gl_page = ng_tabs("STUTTER|EFFECTS", gl_page);
  gl_page == 0 ? (
    ng_row(4);
    ng_select_ctl(3, "STUTTER", "OFF|ON", 0) ? update();
    sprintf(#v1, "%.1f Hz", slider1);
    ng_knob_ctl(1, "RATE", #v1, 0.1, 20, 4, 0.1, 0) ? update();
    sprintf(#v2, "1/%d", slider2);
    ng_knob_ctl(2, "LENGTH", #v2, 1, 64, 8, 1, 0) ? update();
    sprintf(#v14, "%d%%", slider14);
    ng_knob_ctl(14, "MIX", #v14, 0, 100, 50, 1, 0) ? update();
    ng_row(4);
    ng_select_ctl(5, "GATE", "OFF|ON", 0) ? update();
    sprintf(#v4, "%d%%", slider4);
    ng_knob_ctl(4, "DEPTH", #v4, 0, 100, 30, 1, 0) ? update();
    ng_select_ctl(13, "GRANULAR", "OFF|ON", 0) ? update();
    sprintf(#v12, "%d ms", slider12);
    ng_knob_ctl(12, "GRAIN", #v12, 10, 500, 200, 10, 0) ? update();
  ) : (
    ng_row(4);
    ng_select_ctl(7, "PITCH", "OFF|ON", 0) ? update();
    slider6 > 0 ? sprintf(#v6, "+%.1f st", slider6) : sprintf(#v6, "%.1f st", slider6);
    ng_knob_ctl(6, "SHIFT", #v6, -24, 24, 0, 0.1, 1) ? update();
    ng_select_ctl(9, "REVERSE", "OFF|ON", 0) ? update();
    sprintf(#v8, "%d%%", slider8);
    ng_knob_ctl(8, "CHANCE", #v8, 0, 100, 0, 1, 0) ? update();
    ng_row(3);
    ng_select_ctl(11, "TAPE STOP", "OFF|ON", 0) ? update();
    sprintf(#v10, "%d ms", slider10);
    ng_knob_ctl(10, "TAPE TIME", #v10, 10, 1000, 300, 10, 0) ? update();
    ng_select_ctl(15, "TRIGGER", "AUTO|MIDI", 0) ? update();
  );

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
