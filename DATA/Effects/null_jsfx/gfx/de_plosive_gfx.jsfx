desc:NULL De-Plosive GFX
author: Christos Koulaxizis
tags: de-plosive deplosive plosive pop p b vocal voice dialogue podcast low end thump repair restoration gui
//category: Essentials
//NULL JSFX v2.6.1 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:50<0,100,1>-Sensitivity (%)
slider2:150<60,400,1:log>-Frequency (Hz)
slider3:18<0,30,1>-Max Reduction (dB)
slider4:80<20,300,1>-Release (ms)
slider5:0<0,1,1{Off,On}>-Listen

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // NULL De-Plosive (../de_plosive.jsfx) with its own interface: same audio code, plus @gfx.
  // Removes the low-frequency bursts of P and B sounds. A Linkwitz-Riley crossover (24 dB/oct,
  // in phase, sums back flat) splits the signal at Frequency. A fast envelope of the low band
  // (1 ms attack, 30 ms release, both channels linked) is compared with the same envelope of
  // the high band and with its own slow average (200 ms): when it jumps above both by more
  // than the threshold (12 dB at Sensitivity 0 down to 0 dB at 100, 6 dB by default), the low
  // band alone is turned down by twice the excess, up to Max Reduction (1 ms attack, Release).
  // Both bands run 5 ms late (look-ahead, reported as latency) so the onset is caught.
  // Listen outputs only what is being removed.
  look = floor(0.005 * srate + 0.5);
  pdc_delay = look;
  pdc_bot_ch = 0;
  pdc_top_ch = 2;
  b_ll = 0;            // delayed bands: low left, low right, high left, high right
  b_lr = look;
  b_hl = 2 * look;
  b_hr = 3 * look;
  memset(0, 0, 4 * look);
  freembuf(4 * look);
  wp = 0;
  att_e = exp(-1 / (0.001 * srate));
  rel_e = exp(-1 / (0.03 * srate));
  slow_e = exp(-1 / (0.2 * srate));
  att_g = exp(-1 / (0.001 * srate));
  e_lo = e_hi = s_lo = 0;
  gs = 0;
  l1.ic1 = l1.ic2 = l2.ic1 = l2.ic2 = l3.ic1 = l3.ic2 = 0;
  r1.ic1 = r1.ic2 = r2.ic1 = r2.ic2 = r3.ic1 = r3.ic2 = 0;

  // TPT state-variable filter (Butterworth, k = sqrt 2): low-pass into this.lp, high-pass
  // into this.hp
  function svf(x) local(v1, v2, v3)
  (
    v3 = x - this.ic2;
    v1 = sa1 * this.ic1 + sa2 * v3;
    v2 = this.ic2 + sa2 * this.ic1 + sa3 * v3;
    this.ic1 = 2 * v1 - this.ic1;
    this.ic2 = 2 * v2 - this.ic2;
    this.lp = v2;
    this.hp = x - 1.4142135623730951 * v1 - v2;
  );

  // flushes a filter's state once it decays below -300 dB (no denormals in silence)
  function flush()
  (
    abs(this.ic1) < 0.000000000000001 ? this.ic1 = 0;
    abs(this.ic2) < 0.000000000000001 ? this.ic2 = 0;
  );

  function update()
  (
    sg = tan($pi * slider2 / srate);
    sa1 = 1 / (1 + sg * (sg + 1.4142135623730951));
    sa2 = sg * sa1;
    sa3 = sg * sa2;
    thr_db = 12 - 0.12 * slider1;
    thr = 10 ^ (thr_db / 20);
    maxr = slider3;
    rel_g = exp(-1 / (slider4 * 0.001 * srate));
    listen = slider5;
  );

  gfx_ext_retina = 1;

  // interface only: a 1.8 s history of the low band (before the cut) and its gain, one entry
  // per 7 ms (260 entries, one per display pixel) in memory from 4000000, and meters
  dp_buf = 4000000; dp_len = 260; dp_w = 0;
  dp_chunk = max(1, floor(srate * 0.007));
  dp_n = 0; dp_hl = 0; dp_hg = 1;
  dp_i = 0;
  loop(dp_len, dp_buf[dp_i * 2] = 0; dp_buf[dp_i * 2 + 1] = 1; dp_i += 1;);
  dp_rel = exp(-1 / (0.3 * srate));
  dp_low = dp_gr = 0;

  // history: the low band as bars (-48..0 dB, brighter where a plosive was cut), the low
  // band's gain as the line (-32..0 dB)
  function dp_history() local(i, k, xx, yy, h)
  (
    ng_plot(56, 68, 260, 88);
    ng_grid(8, 4, 0);
    ng_font(4, 8, 0);
    ng_col(NG_MUTED, 1);
    i = 0;
    loop(5,
      sprintf(#dp_l, "%d", 0 - 8 * i);
      ng_ptxt(#dp_l, ng_px - 6 * ng_s, ng_py + ng_ph * i / 4, 2);
      i += 1;
    );
    i = 0;
    loop(dp_len,
      k = (dp_w + i) % dp_len;
      h = ng_ph * ng_db_norm(ng_to_db(dp_buf[k * 2]), -48);
      ng_col(NG_ACCENT, dp_buf[k * 2 + 1] < 0.891 ? 0.45 : 0.15);
      h > 0 ? gfx_rect(ng_px + i * ng_s, ng_py + ng_ph - h, ng_s, h);
      i += 1;
    );
    ng_col(NG_ACCENT, 1);
    i = 0;
    loop(dp_len,
      k = (dp_w + i) % dp_len;
      xx = ng_px + (i + 0.5) * ng_s;
      yy = ng_lin_y(ng_to_db(dp_buf[k * 2 + 1]), -32, 0);
      i == 0 ? ng_line_start(xx, yy) : ng_line_to(xx, yy);
      i += 1;
    );
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 10;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1); ng_hist_add(2); ng_hist_add(3); ng_hist_add(4); ng_hist_add(5);
  ng_hist_init();

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 50); ng_slider_set(2, 150); ng_slider_set(3, 18); ng_slider_set(4, 80); ng_slider_set(5, 0); );
    p == 1 ? ( ng_slider_set(1, 35); ng_slider_set(2, 120); ng_slider_set(3, 10); ng_slider_set(4, 100); ng_slider_set(5, 0); );
    p == 2 ? ( ng_slider_set(1, 60); ng_slider_set(2, 160); ng_slider_set(3, 18); ng_slider_set(4, 80); ng_slider_set(5, 0); );
    p == 3 ? ( ng_slider_set(1, 55); ng_slider_set(2, 180); ng_slider_set(3, 20); ng_slider_set(4, 90); ng_slider_set(5, 0); );
    p == 4 ? ( ng_slider_set(1, 80); ng_slider_set(2, 220); ng_slider_set(3, 28); ng_slider_set(4, 120); ng_slider_set(5, 0); );
    p == 5 ? ( ng_slider_set(1, 50); ng_slider_set(2, 130); ng_slider_set(3, 18); ng_slider_set(4, 80); ng_slider_set(5, 0); );
    p == 6 ? ( ng_slider_set(1, 50); ng_slider_set(2, 200); ng_slider_set(3, 15); ng_slider_set(4, 70); ng_slider_set(5, 0); );
    p == 7 ? ( ng_slider_set(1, 65); ng_slider_set(2, 170); ng_slider_set(3, 24); ng_slider_set(4, 100); ng_slider_set(5, 0); );
    p == 8 ? ( ng_slider_set(1, 70); ng_slider_set(2, 100); ng_slider_set(3, 30); ng_slider_set(4, 150); ng_slider_set(5, 0); );
    p == 9 ? ( ng_slider_set(1, 50); ng_slider_set(2, 150); ng_slider_set(3, 18); ng_slider_set(4, 80); ng_slider_set(5, 1); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 50) && ng_pre_eq(slider2, 150) && ng_pre_eq(slider3, 18) && ng_pre_eq(slider4, 80) && ng_pre_eq(slider5, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 35) && ng_pre_eq(slider2, 120) && ng_pre_eq(slider3, 10) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 60) && ng_pre_eq(slider2, 160) && ng_pre_eq(slider3, 18) && ng_pre_eq(slider4, 80) && ng_pre_eq(slider5, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 55) && ng_pre_eq(slider2, 180) && ng_pre_eq(slider3, 20) && ng_pre_eq(slider4, 90) && ng_pre_eq(slider5, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 80) && ng_pre_eq(slider2, 220) && ng_pre_eq(slider3, 28) && ng_pre_eq(slider4, 120) && ng_pre_eq(slider5, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 50) && ng_pre_eq(slider2, 130) && ng_pre_eq(slider3, 18) && ng_pre_eq(slider4, 80) && ng_pre_eq(slider5, 0) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 50) && ng_pre_eq(slider2, 200) && ng_pre_eq(slider3, 15) && ng_pre_eq(slider4, 70) && ng_pre_eq(slider5, 0) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 65) && ng_pre_eq(slider2, 170) && ng_pre_eq(slider3, 24) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 0) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 70) && ng_pre_eq(slider2, 100) && ng_pre_eq(slider3, 30) && ng_pre_eq(slider4, 150) && ng_pre_eq(slider5, 0) ? m = 8;
    m < 0 && ng_pre_eq(slider1, 50) && ng_pre_eq(slider2, 150) && ng_pre_eq(slider3, 18) && ng_pre_eq(slider4, 80) && ng_pre_eq(slider5, 1) ? m = 9;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Gentle";
    p == 2 ? s = "Close Mic Vocal";
    p == 3 ? s = "Spoken Word";
    p == 4 ? s = "Aggressive";
    p == 5 ? s = "Male Vocal";
    p == 6 ? s = "Female Vocal";
    p == 7 ? s = "Handheld Podcast";
    p == 8 ? s = "Mic Bumps";
    p == 9 ? s = "Listen Check";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@block
  l1.flush(); l2.flush(); l3.flush(); r1.flush(); r2.flush(); r3.flush();
  e_lo < 0.000000000000001 ? e_lo = 0;
  e_hi < 0.000000000000001 ? e_hi = 0;
  s_lo < 0.000000000000001 ? s_lo = 0;

@sample
  // Linkwitz-Riley 4: low = LP(LP(x)), high = HP(HP(x))
  l1.svf(spl0);
  l2.svf(l1.lp);
  l3.svf(l1.hp);
  r1.svf(spl1);
  r2.svf(r1.lp);
  r3.svf(r1.hp);
  lo_l = l2.lp; hi_l = l3.hp;
  lo_r = r2.lp; hi_r = r3.hp;

  // detector: fast low and high envelopes, slow low average
  dl = max(abs(lo_l), abs(lo_r));
  dh = max(abs(hi_l), abs(hi_r));
  e_lo = dl > e_lo ? dl + (e_lo - dl) * att_e : dl + (e_lo - dl) * rel_e;
  e_hi = dh > e_hi ? dh + (e_hi - dh) * att_e : dh + (e_hi - dh) * rel_e;
  s_lo = e_lo + (s_lo - e_lo) * slow_e;
  ratio = min(e_lo / (e_hi + 0.001), e_lo / (s_lo + 0.001));
  gt = ratio > thr ? min(maxr, 2 * (20 * log10(ratio) - thr_db)) : 0;
  gs = gt > gs ? gt + (gs - gt) * att_g : gt + (gs - gt) * rel_g;
  gs < 0.000001 ? gs = 0;
  gl = gs > 0 ? 10 ^ (0 - gs / 20) : 1;

  // look-ahead: both bands 5 ms late
  dlo_l = b_ll[wp]; b_ll[wp] = lo_l;
  dlo_r = b_lr[wp]; b_lr[wp] = lo_r;
  dhi_l = b_hl[wp]; b_hl[wp] = hi_l;
  dhi_r = b_hr[wp]; b_hr[wp] = hi_r;
  wp = wp + 1 >= look ? 0 : wp + 1;

  listen > 0.5 ? (
    spl0 = dlo_l * (1 - gl);
    spl1 = dlo_r * (1 - gl);
  ) : (
    spl0 = dlo_l * gl + dhi_l;
    spl1 = dlo_r * gl + dhi_r;
  );

  // interface only: meters and history (read the audio state, never change it)
  dp_lv = max(abs(dlo_l), abs(dlo_r));
  dp_low = dp_lv > dp_low ? dp_lv : dp_low * dp_rel;
  dp_gr = gs > dp_gr ? gs : dp_gr * dp_rel;
  dp_hl = max(dp_hl, dp_lv);
  dp_hg = min(dp_hg, gl);
  (dp_n += 1) >= dp_chunk ? (
    dp_buf[dp_w * 2] = dp_hl;
    dp_buf[dp_w * 2 + 1] = dp_hg;
    dp_w = (dp_w + 1) % dp_len;
    dp_n = 0; dp_hl = 0; dp_hg = 1;
  );

@gfx 480 294
  ng_knobs_begin("DE-PLOSIVE", "ESSENTIALS", 480, 120, 1, 0);

  // display, left: the last 1.8 s of the low band (bars, brighter where a plosive was cut) and
  // its gain (line); right: low-band level and gain-reduction meters and the plosive light
  dp_history();
  ng_meter(336, 76, 112, 10, "LOW", ng_to_db(dp_low), -140, -48);
  ng_gr_meter(336, 100, 112, 10, "GR", dp_gr, 30);
  dp_on = dp_gr > 1;
  ng_col(dp_on ? NG_ACCENT : NG_BORDER, 1);
  gfx_circle(X(340), Y(129), 4 * ng_s, 1, 1);
  ng_font(1, 7, 1);
  ng_col(dp_on ? NG_TEXT : NG_MUTED, 1);
  ng_txt("PLOSIVE", 350, 129, 0, 1);

  ng_row(5);
  sprintf(#v1, "%d%%", slider1);
  ng_knob_ctl(1, "SENSITIVITY", #v1, 0, 100, 50, 1, 0) ? update();
  sprintf(#v2, "%d Hz", slider2);
  ng_knob_ctl_log(2, "FREQUENCY", #v2, 60, 400, 150, 1) ? update();
  sprintf(#v3, "%d dB", slider3);
  ng_knob_ctl(3, "REDUCTION", #v3, 0, 30, 18, 1, 0) ? update();
  sprintf(#v4, "%d ms", slider4);
  ng_knob_ctl(4, "RELEASE", #v4, 20, 300, 80, 1, 0) ? update();
  ng_select_ctl(5, "LISTEN", "OFF|ON", 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
