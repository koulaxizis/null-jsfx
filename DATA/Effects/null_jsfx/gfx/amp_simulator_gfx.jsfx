  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 5) && ng_pre_eq(slider3, 5) && ng_pre_eq(slider4, 5) && ng_pre_eq(slider5, 5) && ng_pre_eq(slider6, 5) && ng_pre_eq(slider7, 5) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 30) && ng_pre_eq(slider10, 1) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, -90) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 3.5) && ng_pre_eq(slider3, 4.5) && ng_pre_eq(slider4, 4) && ng_pre_eq(slider5, 6.5) && ng_pre_eq(slider6, 6) && ng_pre_eq(slider7, 5) && ng_pre_eq(slider8, 1) && ng_pre_eq(slider9, 20) && ng_pre_eq(slider10, 1) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, -90) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 3) && ng_pre_eq(slider3, 6) && ng_pre_eq(slider4, 5.5) && ng_pre_eq(slider5, 3.5) && ng_pre_eq(slider6, 3.5) && ng_pre_eq(slider7, 5) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 25) && ng_pre_eq(slider10, 1) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, -90) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 3.5) && ng_pre_eq(slider3, 5) && ng_pre_eq(slider4, 6.5) && ng_pre_eq(slider5, 5.5) && ng_pre_eq(slider6, 5) && ng_pre_eq(slider7, 5) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 45) && ng_pre_eq(slider10, 1) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, -90) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 6.5) && ng_pre_eq(slider3, 5) && ng_pre_eq(slider4, 6) && ng_pre_eq(slider5, 6) && ng_pre_eq(slider6, 6) && ng_pre_eq(slider7, 6) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 30) && ng_pre_eq(slider10, 1) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, -90) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 7) && ng_pre_eq(slider3, 6) && ng_pre_eq(slider4, 3.5) && ng_pre_eq(slider5, 6.5) && ng_pre_eq(slider6, 6.5) && ng_pre_eq(slider7, 5) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 10) && ng_pre_eq(slider10, 1) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, -90) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 8) && ng_pre_eq(slider3, 5) && ng_pre_eq(slider4, 7) && ng_pre_eq(slider5, 5) && ng_pre_eq(slider6, 5.5) && ng_pre_eq(slider7, 5) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 40) && ng_pre_eq(slider10, 1) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, -90) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 3) && ng_pre_eq(slider2, 3) && ng_pre_eq(slider3, 6.5) && ng_pre_eq(slider4, 4.5) && ng_pre_eq(slider5, 4.5) && ng_pre_eq(slider6, 4) && ng_pre_eq(slider7, 5) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 35) && ng_pre_eq(slider10, 1) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, -90) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 3) && ng_pre_eq(slider2, 7) && ng_pre_eq(slider3, 5.5) && ng_pre_eq(slider4, 6.5) && ng_pre_eq(slider5, 6) && ng_pre_eq(slider6, 6) && ng_pre_eq(slider7, 5) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 25) && ng_pre_eq(slider10, 1) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, -90) ? m = 8;
    m < 0 && ng_pre_eq(slider1, 4) && ng_pre_eq(slider2, 4) && ng_pre_eq(slider3, 6) && ng_pre_eq(slider4, 5) && ng_pre_eq(slider5, 3.5) && ng_pre_eq(slider6, 4) && ng_pre_eq(slider7, 5) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 20) && ng_pre_eq(slider10, 1) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, -90) ? m = 9;
    m < 0 && ng_pre_eq(slider1, 5) && ng_pre_eq(slider2, 6) && ng_pre_eq(slider3, 5) && ng_pre_eq(slider4, 7) && ng_pre_eq(slider5, 6.5) && ng_pre_eq(slider6, 6) && ng_pre_eq(slider7, 6.5) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 40) && ng_pre_eq(slider10, 1) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, -90) ? m = 10;
    m < 0 && ng_pre_eq(slider1, 6) && ng_pre_eq(slider2, 7) && ng_pre_eq(slider3, 6) && ng_pre_eq(slider4, 3) && ng_pre_eq(slider5, 6.5) && ng_pre_eq(slider6, 6.5) && ng_pre_eq(slider7, 5) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 10) && ng_pre_eq(slider10, 1) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, -50) ? m = 11;
    m < 0 && ng_pre_eq(slider1, 7) && ng_pre_eq(slider2, 7) && ng_pre_eq(slider3, 6) && ng_pre_eq(slider4, 4) && ng_pre_eq(slider5, 5.5) && ng_pre_eq(slider6, 5) && ng_pre_eq(slider7, 5) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 50) && ng_pre_eq(slider10, 1) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, -90) ? m = 12;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 8.5) && ng_pre_eq(slider3, 5) && ng_pre_eq(slider4, 6) && ng_pre_eq(slider5, 5.5) && ng_pre_eq(slider6, 6) && ng_pre_eq(slider7, 5) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 20) && ng_pre_eq(slider10, 1) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, -55) ? m = 13;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Sparkling Clean";
    p == 2 ? s = "Warm Jazz Clean";
    p == 3 ? s = "Blues Edge";
    p == 4 ? s = "Classic Rock Crunch";
    p == 5 ? s = "Tight Metal Rhythm";
    p == 6 ? s = "Singing Lead";
    p == 7 ? s = "Round Bass";
    p == 8 ? s = "Growling Bass";
    p == 9 ? s = "Jazz Box";
    p == 10 ? s = "British Crunch";
    p == 11 ? s = "Modern Chug";
    p == 12 ? s = "Vintage Fuzz";
    p == 13 ? s = "Gated Lead";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  am_a = max(abs(spl0), abs(spl1));
  am_pk = am_a > am_pk ? am_a : am_pk * am_rel;
  gate_on ? (
    // noise gate key: the input peak, held and released over 50 ms
    gt_x = max(abs(spl0), abs(spl1));
    gt_env = max(gt_x, gt_env * gt_rel);
    gt_env > gt_th ? (gt_open = 1; gt_cnt = gt_hold) : gt_env < gt_th * 0.5 ? (gt_cnt > 0 ? gt_cnt -= 1 : gt_open = 0);
    gt_g += (gt_open ? gt_ga : gt_gr) * (gt_open - gt_g);
  );
  spl0 = chan(spl0, st_l);
  spl1 = chan(spl1, st_r);
  gate_on ? (spl0 *= gt_g; spl1 *= gt_g);

@gfx 480 400
  ng_knobs_begin("AMP SIMULATOR", "ADVANCED", 480, 140, 2, 0);

  // display, left: the tone shaping (tone stack, resonance, presence, Bright) from -16 to +16 dB,
  // the model at the top right
  ng_plot(ng_vx + 26, ng_vy + 4, ng_vw - 158, ng_vh - 20);
  ng_grid_freq(24);
  am_zy = ng_lin_y(0, -16, 16);
  ng_col(NG_ACCENT, 0.10);
  am_i = 0;
  loop(floor(ng_pw) + 1,
    gfx_line(ng_px + am_i, am_zy, ng_px + am_i, ng_lin_y(am_db(20 * 1000 ^ (am_i / ng_pw)), -16, 16), 0);
    am_i += 1;
  );
  ng_col(NG_ACCENT, 1);
  am_i = 0;
  loop(floor(ng_pw) + 1,
    am_y = ng_lin_y(am_db(20 * 1000 ^ (am_i / ng_pw)), -16, 16);
    am_i == 0 ? ng_line_start(ng_px, am_y) : ng_line_to(ng_px + am_i, am_y);
    am_i += 1;
  );
  ng_font(4, 8, 0);
  ng_col(NG_MUTED, 1);
  ng_ptxt(model == 0 ? "Clean" : model == 1 ? "Crunch" : model == 2 ? "Lead" : model == 3 ? "Bass" :
          model == 4 ? "Jazz Clean" : model == 5 ? "British" : model == 6 ? "Modern High Gain" : "Fuzz",
          ng_px + ng_pw - 6 * ng_s, ng_py + 8 * ng_s, 2);

  // display, right: the preamp's transfer curve (input -1..1 across), rising, with the input peak
  // as a dot on it, and the Gain in dB below
  ng_plot(ng_vx + ng_vw - 104, ng_vy + 4, 104, ng_vh - 20);
  ng_grid(4, 4, 1);
  am_sg = ns == 3 ? -1 : 1;
  am_nm = max(abs(am_xfer(1)), abs(am_xfer(-1)));
  ng_col(NG_ACCENT, 1);
  am_i = 0;
  loop(floor(ng_pw) + 1,
    am_y = ng_py + ng_ph * (0.5 - 0.5 * am_sg * am_xfer(am_i / ng_pw * 2 - 1) / am_nm);
    am_i == 0 ? ng_line_start(ng_px, am_y) : ng_line_to(ng_px + am_i, am_y);
    am_i += 1;
  );
  am_x = min(1, am_pk);
  ng_col(NG_TEXT, 1);
  gfx_circle(ng_px + ng_pw * (am_x + 1) / 2, ng_py + ng_ph * (0.5 - 0.5 * am_sg * am_xfer(am_x) / am_nm), 3 * ng_s, 1, 1);
  ng_col(NG_MUTED, 1);
  sprintf(#am_t, "DRIVE %+.0f dB", pre_db);
  ng_ptxt(#am_t, ng_px + ng_pw / 2, ng_py + ng_ph + 10 * ng_s, 1);

  ng_row(6);
  ng_select_ctl(1, "MODEL", "CLEAN|CRUNCH|LEAD|BASS|JAZZ|BRITISH|MODERN|FUZZ", 0) ? update();
  sprintf(#v2, "%.1f", slider2);
  ng_knob_ctl(2, "GAIN", #v2, 0, 10, 5, 0.1, 0) ? update();
  sprintf(#v3, "%.1f", slider3);
  ng_knob_ctl(3, "BASS", #v3, 0, 10, 5, 0.1, 0) ? update();
  sprintf(#v4, "%.1f", slider4);
  ng_knob_ctl(4, "MID", #v4, 0, 10, 5, 0.1, 0) ? update();
  sprintf(#v5, "%.1f", slider5);
  ng_knob_ctl(5, "TREBLE", #v5, 0, 10, 5, 0.1, 0) ? update();
  sprintf(#v6, "%.1f", slider6);
  ng_knob_ctl(6, "PRESENCE", #v6, 0, 10, 5, 0.1, 0) ? update();

  ng_row(6);
  sprintf(#v7, "%.1f", slider7);
  ng_knob_ctl(7, "MASTER", #v7, 0, 10, 5, 0.1, 0) ? update();
  ng_select_ctl(8, "BRIGHT", "OFF|ON", 0) ? update();
  sprintf(#v9, "%d%%", slider9);
  ng_knob_ctl(9, "SAG", #v9, 0, 100, 30, 1, 0) ? update();
  ng_select_ctl(10, "OVERSAMPLE", "2X|4X", 0) ? update();
  sprintf(#v11, "%+.1f dB", slider11);
  ng_knob_ctl(11, "OUTPUT", #v11, -24, 12, 0, 0.1, 1) ? update();
  slider12 > -90 ? sprintf(#v12, "%.1f dB", slider12) : strcpy(#v12, "OFF");
  ng_knob_ctl(12, "GATE", #v12, -90, -20, -90, 0.1, 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
