    m < 0 && ng_pre_eq(slider1, 100) && ng_pre_eq(slider2, 20) && ng_pre_eq(slider3, 60) && ng_pre_eq(slider4, 20) && ng_pre_eq(slider5, 80) && ng_pre_eq(slider6, 20) && ng_pre_eq(slider7, 50) && ng_pre_eq(slider8, 30) && ng_pre_eq(slider9, 100) && ng_pre_eq(slider10, 20) && ng_pre_eq(slider11, 60) && ng_pre_eq(slider12, 20) && ng_pre_eq(slider13, 90) && ng_pre_eq(slider14, 40) && ng_pre_eq(slider15, 70) && ng_pre_eq(slider16, 10) && ng_pre_eq(slider17, 16) && ng_pre_eq(slider18, 2) && ng_pre_eq(slider19, 200) && ng_pre_eq(slider20, 5000) && ng_pre_eq(slider21, 50) && ng_pre_eq(slider22, 0) && ng_pre_eq(slider23, 30) && ng_pre_eq(slider24, 7) && ng_pre_eq(slider25, 100) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 100) && ng_pre_eq(slider2, 20) && ng_pre_eq(slider3, 60) && ng_pre_eq(slider4, 20) && ng_pre_eq(slider5, 80) && ng_pre_eq(slider6, 20) && ng_pre_eq(slider7, 50) && ng_pre_eq(slider8, 30) && ng_pre_eq(slider9, 100) && ng_pre_eq(slider10, 20) && ng_pre_eq(slider11, 60) && ng_pre_eq(slider12, 20) && ng_pre_eq(slider13, 90) && ng_pre_eq(slider14, 40) && ng_pre_eq(slider15, 70) && ng_pre_eq(slider16, 10) && ng_pre_eq(slider17, 16) && ng_pre_eq(slider18, 2) && ng_pre_eq(slider19, 400) && ng_pre_eq(slider20, 7000) && ng_pre_eq(slider21, 55) && ng_pre_eq(slider22, 0) && ng_pre_eq(slider23, 20) && ng_pre_eq(slider24, 42) && ng_pre_eq(slider25, 100) ? m = 8;
    m < 0 && ng_pre_eq(slider1, 100) && ng_pre_eq(slider2, 20) && ng_pre_eq(slider3, 60) && ng_pre_eq(slider4, 20) && ng_pre_eq(slider5, 80) && ng_pre_eq(slider6, 20) && ng_pre_eq(slider7, 50) && ng_pre_eq(slider8, 30) && ng_pre_eq(slider9, 100) && ng_pre_eq(slider10, 20) && ng_pre_eq(slider11, 60) && ng_pre_eq(slider12, 20) && ng_pre_eq(slider13, 90) && ng_pre_eq(slider14, 40) && ng_pre_eq(slider15, 70) && ng_pre_eq(slider16, 10) && ng_pre_eq(slider17, 16) && ng_pre_eq(slider18, 3) && ng_pre_eq(slider19, 250) && ng_pre_eq(slider20, 8000) && ng_pre_eq(slider21, 65) && ng_pre_eq(slider22, 0) && ng_pre_eq(slider23, 0) && ng_pre_eq(slider24, 101) && ng_pre_eq(slider25, 100) ? m = 9;
    m < 0 && ng_pre_eq(slider1, 100) && ng_pre_eq(slider2, 20) && ng_pre_eq(slider3, 60) && ng_pre_eq(slider4, 20) && ng_pre_eq(slider5, 80) && ng_pre_eq(slider6, 20) && ng_pre_eq(slider7, 50) && ng_pre_eq(slider8, 30) && ng_pre_eq(slider9, 100) && ng_pre_eq(slider10, 20) && ng_pre_eq(slider11, 60) && ng_pre_eq(slider12, 20) && ng_pre_eq(slider13, 90) && ng_pre_eq(slider14, 40) && ng_pre_eq(slider15, 70) && ng_pre_eq(slider16, 10) && ng_pre_eq(slider17, 16) && ng_pre_eq(slider18, 2) && ng_pre_eq(slider19, 200) && ng_pre_eq(slider20, 5000) && ng_pre_eq(slider21, 40) && ng_pre_eq(slider22, 0) && ng_pre_eq(slider23, 40) && ng_pre_eq(slider24, 0) && ng_pre_eq(slider25, 50) ? m = 10;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Sixteenth Sweep";
    p == 2 ? s = "Acid Steps";
    p == 3 ? s = "Eighth Note Wah";
    p == 4 ? s = "Hi Pass Pump";
    p == 5 ? s = "Triplet Feel Five";
    p == 6 ? s = "Slow Quarter Motion";
    p == 7 ? s = "Generative Seed 7";
    p == 8 ? s = "Generative Seed 42";
    p == 9 ? s = "Generative 32nds";
    p == 10 ? s = "Half Mix Motion";
    s;
  );

  // the hint line under the controls: a short help text per slider (from tools/site_content.json)
  function ng_hint_text(i) local(s)
  (
    s = "";
    i == 1 ? s = "Step 1 position between Low (0%) and High (100%) on a musical scale";
    i == 2 ? s = "Step 2 position between Low (0%) and High (100%) on a musical scale";
    i == 3 ? s = "Step 3 position between Low (0%) and High (100%) on a musical scale";
    i == 4 ? s = "Step 4 position between Low (0%) and High (100%) on a musical scale";
    i == 5 ? s = "Step 5 position between Low (0%) and High (100%) on a musical scale";
    i == 6 ? s = "Step 6 position between Low (0%) and High (100%) on a musical scale";
    i == 7 ? s = "Step 7 position between Low (0%) and High (100%) on a musical scale";
    i == 8 ? s = "Step 8 position between Low (0%) and High (100%) on a musical scale";
    i == 9 ? s = "Step 9 position between Low (0%) and High (100%) on a musical scale";
    i == 10 ? s = "Step 10 position between Low (0%) and High (100%) on a musical scale";
    i == 11 ? s = "Step 11 position between Low (0%) and High (100%) on a musical scale";
    i == 12 ? s = "Step 12 position between Low (0%) and High (100%) on a musical scale";
    i == 13 ? s = "Step 13 position between Low (0%) and High (100%) on a musical scale";
    i == 14 ? s = "Step 14 position between Low (0%) and High (100%) on a musical scale";
    i == 15 ? s = "Step 15 position between Low (0%) and High (100%) on a musical scale";
    i == 16 ? s = "Step 16 position between Low (0%) and High (100%) on a musical scale";
    i == 17 ? s = "How many of the 16 steps play before the sequence repeats (odd counts drift against the bar)";
    i == 18 ? s = "Note value of one step at the host tempo";
    i == 19 ? s = "Cutoff of a step at 0%";
    i == 20 ? s = "Cutoff of a step at 100% (below Low turns the sweep upside down)";
    i == 21 ? s = "Resonance at the cutoff (0% = smooth, 100% = sharp and vocal)";
    i == 22 ? s = "Low Pass, Band Pass or High Pass";
    i == 23 ? s = "How much of each step the cutoff spends gliding from the previous value (0% = hard steps)";
    i == 24 ? s = "0: the Step sliders play; any other value plays a sequence drawn from it (the same Seed always gives the";
    i == 25 ? s = "Blend of the filtered and the dry signal";
    s;
  );

  function ng_presets() local(i)
  (
    ng_hint_i > 0 && !ng_pre_open ? ng_hint(ng_hint_text(ng_hint_i));
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@block
  bpm = tempo > 0 ? tempo : 120;
  step_inc = bpm / 60 * steps_per_beat / srate;
  // lock to the host grid while playing
  play_state & 1 ? step_pos = beat_position * steps_per_beat;

@sample
  step_pos += step_inc;
  // keep the free-running counter small (the synced one is re-read every block)
  step_pos >= 16 * sf_n ? step_pos -= 16 * sf_n;
  s = floor(step_pos);
  cur_step = s - sf_n * floor(s / sf_n);   // also correct for negative positions (pre-roll)
  v = SV[cur_step];
  glide > 0 ? (
    t = (step_pos - s) / glide;
    t < 1 ? (
      vp = SV[cur_step > 0 ? cur_step - 1 : sf_n - 1];
      v = vp + (v - vp) * (0.5 - 0.5 * cos($pi * t));
    );
  );
  fc = min(lo * (hi / lo) ^ v, 0.45 * srate);
  g = tan($pi * fc / srate);
  a1 = 1 / (1 + g * (g + sf_k));
  a2 = g * a1;
  a3 = g * a2;

  x = spl0;
  v3 = x - ic2_l;
  v1 = a1 * ic1_l + a2 * v3;
  v2 = ic2_l + a2 * ic1_l + a3 * v3;
  ic1_l = 2 * v1 - ic1_l;
  ic2_l = 2 * v2 - ic2_l;
  y = sf_type == 0 ? v2 : sf_type == 1 ? sf_k * v1 : x - sf_k * v1 - v2;
  spl0 = x + (y - x) * mix;

  x = spl1;
  v3 = x - ic2_r;
  v1 = a1 * ic1_r + a2 * v3;
  v2 = ic2_r + a2 * ic1_r + a3 * v3;
  ic1_r = 2 * v1 - ic1_r;
  ic2_r = 2 * v2 - ic2_r;
  y = sf_type == 0 ? v2 : sf_type == 1 ? sf_k * v1 : x - sf_k * v1 - v2;
  spl1 = x + (y - x) * mix;

@gfx 480 408
  ng_knobs_begin("STEP FILTER", "ESSENTIALS", 480, 120, 2, 1);

  // display (SV[] holds the values playing, see update()): one bar per step, its height the
  // step's place between Low (bottom) and High (top); the steps past Steps are dimmed and the
  // playing step is marked below. The line is the cutoff's path with Glide. With Seed 0 a click
  // in a bar sets that step to the height clicked; with a Seed the bars are the drawn values.
  ng_plot(ng_vx + 26, ng_vy + 4, ng_vw - 30, ng_vh - 20);
  ng_font(4, 8, 0);
  ng_col(NG_MUTED, 1);
  hi >= 1000 ? sprintf(#sf_t, "%.1fk", hi / 1000) : sprintf(#sf_t, "%d", hi);
  ng_ptxt(#sf_t, ng_px - 6 * ng_s, ng_py, 2);
  lo >= 1000 ? sprintf(#sf_t, "%.1fk", lo / 1000) : sprintf(#sf_t, "%d", lo);
  ng_ptxt(#sf_t, ng_px - 6 * ng_s, ng_py + ng_ph, 2);
  sf_cw = ng_pw / 16;
  sf_j = 0;
  loop(16,
    sf_x0 = ng_px + sf_j * sf_cw + ng_s;
    sf_w = sf_cw - 2 * ng_s;
    ng_col(sf_j == cur_step ? NG_BORDER : NG_BG, 1);
    gfx_rect(sf_x0, ng_py, sf_w, ng_ph);
    sf_h = SV[sf_j] * ng_ph;
    ng_col(NG_ACCENT, sf_j >= sf_n ? 0.08 : sf_j == cur_step ? 0.45 : 0.25);
    gfx_rect(sf_x0, ng_py + ng_ph - sf_h, sf_w, sf_h);
    sf_j == cur_step ? (
      ng_col(NG_TEXT, 1);
      gfx_rect(sf_x0, ng_py + ng_ph + 2 * ng_s, sf_w, 2 * ng_s);
    );
    sf_j % 4 == 0 ? (
      sprintf(#sf_t, "%d", sf_j + 1);
      ng_col(NG_MUTED, 1);
      ng_ptxt(#sf_t, sf_x0 + sf_w / 2, ng_py + ng_ph + 11 * ng_s, 1);
    );
    ng_click && slider24 < 0.5 && mouse_x >= sf_x0 && mouse_x < sf_x0 + sf_w && mouse_y >= ng_py && mouse_y < ng_py + ng_ph ? (
      ng_slider_set(sf_j + 1, max(0, min(100, floor((ng_py + ng_ph - mouse_y) / ng_ph * 100 + 0.5)))) ? update();
    );
    sf_j += 1;
  );
  // the cutoff's path over the steps that play: Glide from the previous value, then held
  ng_col(NG_ACCENT, 1);
  sf_j = 0;
  loop(sf_n,
    sf_vp = SV[sf_j > 0 ? sf_j - 1 : sf_n - 1];
    sf_j == 0 ? ng_line_start(ng_px, ng_lin_y(glide > 0 ? sf_vp : SV[0], 0, 1)) : ng_line_to(ng_px + sf_j * sf_cw, ng_lin_y(glide > 0 ? sf_vp : SV[sf_j - 1], 0, 1));
    glide > 0 ? (
      sf_i = 1;
      loop(8,
        ng_line_to(ng_px + (sf_j + glide * sf_i / 8) * sf_cw, ng_lin_y(sf_vp + (SV[sf_j] - sf_vp) * (0.5 - 0.5 * cos($pi * sf_i / 8)), 0, 1));
        sf_i += 1;
      );
    ) : ng_line_to(ng_px + sf_j * sf_cw, ng_lin_y(SV[sf_j], 0, 1));
    ng_line_to(ng_px + (sf_j + 1) * sf_cw, ng_lin_y(SV[sf_j], 0, 1));
    sf_j += 1;
  );

  sf_page = ng_tabs("FILTER|STEPS 1-8|STEPS 9-16", sf_page);
  sf_page == 0 ? (
    ng_row(4);
    slider19 >= 1000 ? sprintf(#v19, "%.2f kHz", slider19 / 1000) : sprintf(#v19, "%d Hz", slider19);
    ng_knob_ctl_log(19, "LOW", #v19, 20, 20000, 200, 1) ? update();
    slider20 >= 1000 ? sprintf(#v20, "%.2f kHz", slider20 / 1000) : sprintf(#v20, "%d Hz", slider20);
    ng_knob_ctl_log(20, "HIGH", #v20, 20, 20000, 5000, 1) ? update();
    sprintf(#v21, "%d%%", slider21);
    ng_knob_ctl(21, "RESONANCE", #v21, 0, 100, 30, 1, 0) ? update();
    ng_select_ctl(22, "TYPE", "LOW PASS|BAND PASS|HIGH PASS", 0) ? update();
    ng_row(5);
    sprintf(#v17, "%d", slider17);
    ng_knob_ctl(17, "STEPS", #v17, 1, 16, 16, 1, 0) ? update();
    ng_select_ctl(18, "NOTE", "1/4|1/8|1/16|1/32", 0) ? update();
    sprintf(#v23, "%d%%", slider23);
    ng_knob_ctl(23, "GLIDE", #v23, 0, 100, 20, 1, 0) ? update();
    slider24 > 0 ? sprintf(#v24, "%d", slider24) : strcpy(#v24, "OFF");
    ng_knob_ctl(24, "SEED", #v24, 0, 999, 0, 1, 0) ? update();
    sprintf(#v25, "%d%%", slider25);
    ng_knob_ctl(25, "MIX", #v25, 0, 100, 100, 1, 0) ? update();
  ) : (
    sf_b = sf_page == 1 ? 0 : 8;
    sf_j = 0;
    loop(2,
      ng_row(4);
      loop(4,
        sf_j += 1;
        sprintf(#sf_l, "STEP %d", sf_b + sf_j);
        sprintf(#sf_v, "%d%%", slider(sf_b + sf_j));
        ng_knob_ctl(sf_b + sf_j, #sf_l, #sf_v, 0, 100, SD[sf_b + sf_j - 1], 1, 0) ? update();
      );
    );
  );

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
