  update();

@block
  // MIDI of this block, played at its offsets in @sample
  mq_n = 0;
  while (midirecv(m_ofs, m_1, m_2, m_3)) (
    // every message goes on to the next plugin too, so instruments can be layered
    midisend(m_ofs, m_1, m_2, m_3);
    mq_n < 256 ? (
      MQ[mq_n * 4] = m_ofs;
      MQ[mq_n * 4 + 1] = m_1;
      MQ[mq_n * 4 + 2] = m_2;
      MQ[mq_n * 4 + 3] = m_3;
      mq_n += 1;
    );
  );
  mq_i = 0;

  playing = play_state & 1;
  b_inc = tempo / (60 * srate);
  b_0 = beat_position;
  si = 0;

  // a voice heard from the interface (GFX version)
  pc_preview > 0 ? ( trig(pc_preview - 1, 0, 1); pc_preview = 0; );

@sample
  while (mq_i < mq_n && MQ[mq_i * 4] <= si) (
    m_s = MQ[mq_i * 4 + 1] & 0xF0;
    m_n = MQ[mq_i * 4 + 2];
    m_v = MQ[mq_i * 4 + 3];
    m_s == 0x90 && m_v > 0 ? note_on(m_n, m_v / 127) :
    (m_s == 0x80 || m_s == 0x90) && keys && m_n >= 24 && m_n <= 31 ? key_off(m_n - 24) :
    m_s == 0xB0 && (m_n == 120 || m_n == 123) ? keys_off();
    mq_i += 1;
  );

  // the groove: sixteenths (the odd ones moved later by Swing) or three steps per beat; a
  // step plays when the position enters it
  g_cur = keys ? k_grv : playing ? g_sel : 0;
  g_cur > 0 ? (
    pb = GRV + (g_cur - 1) * GSZ;
    g_len = pb[352];
    g_spb = pb[353];
    playing ? bb = b_0 + si * b_inc : ( bb = fb; fb += b_inc; );
    bb >= 0 ? (
      g_spb == 3 ? (
        s = floor(bb * 3 + 0.000001);
        s0 = s / 3;
      ) : (
        p8 = floor(bb * 2 + 0.000001);
        s = p8 * 2 + (bb * 2 - p8 + 0.000001 >= sw ? 1 : 0);
        s0 = (s & 1 ? p8 + sw : p8) / 2;
      );
      s != last_s ? (
        // at a start, only when it starts on the step's beginning
        last_s > -1000 || bb - s0 < 0.001 ? play_step(s);
        last_s = s;
      );
    );
  ) : last_s = -1000;
  pc_step = g_cur > 0 ? last_s : -1;
  si += 1;

  // white noise (Park-Miller), shared by the voices
  seed *= 16807; seed -= floor(seed / 2147483647) * 2147483647;
  nz = seed / 1073741824 - 1;
  outl = outr = 0;

  cg.on ? ( y = cg.mem(nz) * 0.357 * VL[0]; outl += y * VPL[0]; outr += y * VPR[0]; );
  tu.on ? ( y = tu.mem(nz) * 0.383 * VL[1]; outl += y * VPL[1]; outr += y * VPR[1]; );
  bh.on ? ( y = bh.mem(nz) * 0.306 * VL[2]; outl += y * VPL[2]; outr += y * VPR[2]; );
  bl.on ? ( y = bl.mem(nz) * 0.323 * VL[3]; outl += y * VPL[3]; outr += y * VPR[3]; );

  sh_on ? (
    sh_bp.svf(nz);
    sh_hp.svf(sh_bp.bp);
    y = sh_hp.hp * (sh_ea - sh_eb);
    sh_ea *= sh_ca; sh_eb *= sh_cb;
    sh_ea < 0.000001 ? sh_on = 0;
    y *= 0.9 * VL[4]; outl += y * VPL[4]; outr += y * VPR[4];
  );

  tb_on ? (
    tb_t < 3 * tb_per ? (
      tb_t == 0 || tb_t == tb_per || tb_t == 2 * tb_per ? tb_env = tb_t == 0 ? 1 : tb_t == tb_per ? 0.75 : 0.5;
      g = tb_env; tb_env *= tb_bc;
    ) : (
      tb_t == 3 * tb_per ? tb_env = 0.45;
      g = tb_env; tb_env *= tb_tc;
      tb_env < 0.000001 ? tb_on = 0;
    );
    tb_t += 1;
    tb_bp.svf(0.6 * tb_m.metal() + 0.4 * nz);
    tb_hp.svf(tb_bp.bp);
    y = tb_hp.hp * g * tb_vel;
    y *= 0.95 * VL[5]; outl += y * VPL[5]; outr += y * VPR[5];
  );

  cb_on ? (
    cb_bp.svf(square(cb_p1, cb_d1) + square(cb_p2, cb_d2));
    cb_p1 += cb_d1; cb_p1 -= floor(cb_p1);
    cb_p2 += cb_d2; cb_p2 -= floor(cb_p2);
    y = cb_bp.bp * (cb_e1 + cb_e2);
    cb_e1 *= cb_c1; cb_e2 *= cb_c2;
    cb_e2 < 0.000001 ? cb_on = 0;
    y *= 0.18 * VL[6]; outl += y * VPL[6]; outr += y * VPR[6];
  );

  cl_on ? (
    cl_ph += cl_d; cl_ph -= floor(cl_ph);
    y = sin(2 * $pi * cl_ph) * cl_env + nz * cl_ck * 0.3;
    cl_env *= cl_c; cl_ck *= cl_cc;
    cl_env < 0.000001 ? cl_on = 0;
    y *= 0.36 * VL[7]; outl += y * VPL[7]; outr += y * VPR[7];
  );

  gu_on ? (
    gu_ph += gu_d;
    gu_ph >= 1 ? ( gu_ph -= 1; gu_tk = 1; );
    gu_bp.svf(nz * (gu_tk + 0.12));
    x = gu_t / gu_len;
    y = gu_bp.bp * sin($pi * x) * gu_vel;
    gu_tk *= gu_tc;
    gu_t += 1;
    gu_t >= gu_len ? gu_on = 0;
    y *= 0.7 * VL[8]; outl += y * VPL[8]; outr += y * VPR[8];
  );

  ca_on ? (
    ca_bp.svf(nz);
    ca_hp.svf(ca_bp.bp);
    y = ca_hp.hp * (ca_ea - ca_eb);
    ca_ea *= ca_ca; ca_eb *= ca_cb;
    ca_ea < 0.000001 ? ca_on = 0;
    y *= 0.6 * VL[9]; outl += y * VPL[9]; outr += y * VPR[9];
  );

  tr_on ? (
    tr_p1 += tr_d1; tr_p1 -= floor(tr_p1);
    tr_p2 += tr_d2; tr_p2 -= floor(tr_p2);
    tr_p3 += tr_d3; tr_p3 -= floor(tr_p3);
    tr_p4 += tr_d4; tr_p4 -= floor(tr_p4);
    y = sin(2 * $pi * tr_p1) * tr_e1 + tr_g2 * sin(2 * $pi * tr_p2) * tr_e2
      + tr_g3 * sin(2 * $pi * tr_p3) * tr_e3 + tr_g4 * sin(2 * $pi * tr_p4) * tr_e4 + nz * tr_ck * 0.2;
    tr_mute ? (
      tr_e1 *= tr_mc; tr_e2 *= tr_mc; tr_e3 *= tr_mc; tr_e4 *= tr_mc;
    ) : (
      tr_e1 *= tr_o1; tr_e2 *= tr_o2; tr_e3 *= tr_o3; tr_e4 *= tr_o4;
    );
    tr_ck *= tr_cc;
    tr_e1 + tr_e2 + tr_e3 + tr_e4 < 0.000001 ? tr_on = 0;
    y *= 0.3 * VL[10]; outl += y * VPL[10]; outr += y * VPR[10];
  );

  // Room: four damped combs and two all-passes per side, mixed in
  room > 0 ? (
    wl = comb(0, outl) + comb(1, outl) + comb(2, outl) + comb(3, outl);
    wr = comb(4, outr) + comb(5, outr) + comb(6, outr) + comb(7, outr);
    wl = allpass(9, allpass(8, wl));
    wr = allpass(11, allpass(10, wr));
    outl += wl * rm_wet;
    outr += wr * rm_wet;
  );

  spl0 = outl * vol;
  spl1 = outr * vol;

@gfx 640 494
  ng_knobs_begin("PERCUSSION", "INSTRUMENTS", 640, 206, 2, 1);

  // display: the groove that plays (else the last one the keys played, else the selected one)
  // as a grid of its steps, the voices' names and keys; a click on a name selects the voice
  // and plays it
  g_cur > 0 ? pc_last = g_cur;
  pc_g = g_cur > 0 ? g_cur : keys && pc_last > 0 ? pc_last : g_sel;
  ng_font(1, 7, 1);
  ng_col(NG_MUTED, 0.6);
  pc_g > 0 ? (
    pc_b = GRV + (pc_g - 1) * GSZ;
    pc_len = pc_b[352];
    pc_spb = pc_b[353];
    sprintf(#pc_h, "%s: %d BEATS OF %s", pc_groove_name(pc_g), pc_len / pc_spb, pc_spb == 3 ? "TRIPLETS" : "SIXTEENTHS");
  ) : (
    pc_len = 16; pc_spb = 4;
    strcpy(#pc_h, "OFF: MIDI ONLY");
  );
  ng_txt(#pc_h, 128, 71, 0, 1);
  ng_txt(keys ? "KEYS: HOLD C1..G1" : "PLAYS WITH THE HOST", 616, 71, 2, 1);
  pc_p = pc_cell_p(pc_len, pc_spb);

  t = 0;
  loop(NT,
    yy = 80 + t * 15;
    pc_fl = max(0, min(1, HIT[t] * 1.5));
    HIT[t] = HIT[t] * 0.8;
    t == pc_sel ? ( ng_col(NG_ACCENT, 1); gfx_rect(X(24), Y(yy + 1), max(2, 2 * ng_s), 11 * ng_s); );
    t == pc_sel ? ng_col(NG_TEXT, 1) : ng_mix(NG_MUTED, NG_TEXT, pc_fl, 1);
    ng_font(1, 7, 1);
    ng_txt(pc_name(t), 31, yy + 6.5, 0, 1);
    ng_font(3, 7, 0);
    ng_col(NG_MUTED, 0.7);
    ng_txt(pc_key(t), 121, yy + 6.5, 2, 0);
    hover = mouse_x >= X(24) && mouse_x < X(124) && mouse_y >= Y(yy) && mouse_y < Y(yy + 13);
    hover && ng_click ? ( pc_sel = t; pc_preview = t + 1; );

    i = 0;
    loop(pc_len,
      xx = pc_cell_x(i, pc_len, pc_spb);
      cw = max(1, pc_p - 2);
      v = pc_g > 0 ? pc_b[t * 32 + i] : 0;
      ng_col(v > 0 ? NG_ACCENT : NG_BG, v == 1 || v == 4 || v == 6 ? 0.55 : v == 3 ? 0.25 : v == 5 ? 0.85 : 1);
      gfx_rect(X(xx), Y(yy), cw * ng_s, 13 * ng_s);
      ng_col(NG_BG, 1);
      v == 2 || v == 5 ? gfx_rect(X(xx + cw / 2 - 1.5), Y(yy + 5), 3 * ng_s, 3 * ng_s);
      v == 4 ? gfx_rect(X(xx + cw / 4), Y(yy + 5.5), cw / 2 * ng_s, max(1, 2 * ng_s));
      v == 6 ? gfx_rect(X(xx + 2), Y(yy + 5.5), (cw - 4) * ng_s, max(1, 2 * ng_s));
      ng_col(NG_BORDER, 1);
      gfx_rect(X(xx), Y(yy), cw * ng_s, 13 * ng_s, 0);
      // the playhead
      pc_g == g_cur && pc_step >= 0 && i == pc_step - floor(pc_step / pc_len) * pc_len ? (
        ng_col(NG_TEXT, 1);
        gfx_rect(X(xx), Y(yy), cw * ng_s, 13 * ng_s, 0);
        gfx_rect(X(xx) + 1, Y(yy) + 1, cw * ng_s - 2, 13 * ng_s - 2, 0);
      );
      i += 1;
    );
    t += 1;
  );

  // controls: the selected voice and the room, then the groove
  pc_sel = ng_tabs("CONGA|TUMBA|BONGO H|BONGO L|SHAKER|TAMB|BELL|CLAVES|GUIRO|CABASA|TRI", pc_sel);
  ng_row(6);
  b = 9 + 4 * pc_sel;
  sprintf(#pc_v1, "%.1f dB", pc_slider(b));
  ng_knob_ctl(b, "LEVEL", #pc_v1, -40, 6, 0, 0.1, 0) ? update();
  sprintf(#pc_v2, "%+.1f st", pc_slider(b + 1));
  ng_knob_ctl(b + 1, "TUNE", #pc_v2, -12, 12, 0, 0.1, 1) ? update();
  sprintf(#pc_v3, "%d%%", pc_slider(b + 2));
  ng_knob_ctl(b + 2, "DECAY", #pc_v3, 0, 100, 50, 1, 0) ? update();
  pc_pv = pc_slider(b + 3);
  pc_pv == 0 ? strcpy(#pc_v4, "C") : sprintf(#pc_v4, pc_pv < 0 ? "L%d" : "R%d", abs(pc_pv));
  ng_knob_ctl(b + 3, "PAN", #pc_v4, -100, 100, pc_pan_def(pc_sel), 1, 1) ? update();
  sprintf(#pc_g6, "%d%%", slider6);
  ng_knob_ctl(6, "ROOM", #pc_g6, 0, 100, 15, 1, 0) ? update();
  sprintf(#pc_g7, "%d%%", slider7);
  ng_knob_ctl(7, "SIZE", #pc_g7, 0, 100, 50, 1, 0) ? update();

  ng_row(6);
  ng_select_ctl(1, "GROOVE", "OFF|SALSA|BOSSA|SAMBA|CUMBIA|AFRO BELL|AFROBEAT|REGGAETON|POP", 0) ? update();
  ng_select_ctl(2, "PLAY", "TRANSPORT|KEYS", 0) ? update();
  sprintf(#pc_g3, "%d%%", slider3);
  ng_knob_ctl(3, "SWING", #pc_g3, 50, 75, 50, 1, 0) ? update();
  sprintf(#pc_g4, "%d%%", slider4);
  ng_knob_ctl(4, "ACCENT", #pc_g4, 0, 100, 50, 1, 0) ? update();
  sprintf(#pc_g5, "%d%%", slider5);
  ng_knob_ctl(5, "HUMANIZE", #pc_g5, 0, 100, 0, 1, 0) ? update();
  sprintf(#pc_g8, "%+.1f dB", slider8);
  ng_knob_ctl(8, "VOLUME", #pc_g8, -24, 12, 0, 0.1, 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
