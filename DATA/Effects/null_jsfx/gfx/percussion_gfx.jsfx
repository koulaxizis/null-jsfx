  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Salsa Night";
    p == 2 ? s = "Bossa Lounge";
    p == 3 ? s = "Samba Street";
    p == 4 ? s = "Cumbia Party";
    p == 5 ? s = "Afro Bell 12-8";
    p == 6 ? s = "Afrobeat Band";
    p == 7 ? s = "Reggaeton Perc";
    p == 8 ? s = "Pop Shaker";
    p == 9 ? s = "Key Grooves";
    p == 10 ? s = "MIDI Kit";
    p == 11 ? s = "Dry Studio";
    p == 12 ? s = "Big Room";
    p == 13 ? s = "Tuned Up";
    p == 14 ? s = "Deep Drums";
    p == 15 ? s = "Loose Feel";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

