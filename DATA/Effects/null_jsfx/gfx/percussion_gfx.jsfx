  );
  function pc_name(t) ( t == 0 ? "CONGA" : t == 1 ? "TUMBA" : t == 2 ? "BONGO HI" : t == 3 ? "BONGO LO" : t == 4 ? "SHAKER" : t == 5 ? "TAMBOURINE" : t == 6 ? "COWBELL" : t == 7 ? "CLAVES" : t == 8 ? "GUIRO" : t == 9 ? "CABASA" : "TRIANGLE"; );
  // the voice's main key (C4 = 60)
  function pc_key(t) ( t == 0 ? "D#4" : t == 1 ? "E4" : t == 2 ? "C4" : t == 3 ? "C#4" : t == 4 ? "A#4" : t == 5 ? "F#3" : t == 6 ? "G#3" : t == 7 ? "D#5" : t == 8 ? "C#5" : t == 9 ? "A4" : "A5"; );
  function pc_pan_def(t) ( t == 0 ? 15 : t == 1 ? -15 : t == 2 ? 35 : t == 3 ? 25 : t == 4 ? -35 : t == 5 ? 40 : t == 6 ? -20 : t == 7 ? 10 : t == 8 ? -45 : t == 9 ? 45 : -30; );
  function pc_groove_name(g) ( g == 1 ? "SALSA" : g == 2 ? "BOSSA" : g == 3 ? "SAMBA" : g == 4 ? "CUMBIA" : g == 5 ? "AFRO BELL" : g == 6 ? "AFROBEAT" : g == 7 ? "REGGAETON" : "POP"; );
  // left edge of step i of a groove of len steps, spb per beat (a gap after every beat)
  function pc_cell_p(len, spb) ( (488 - (len / spb - 1) * 3) / len; );
  function pc_cell_x(i, len, spb) ( 128 + i * pc_cell_p(len, spb) + floor(i / spb) * 3; );

