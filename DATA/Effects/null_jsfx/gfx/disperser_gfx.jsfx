desc:NULL Disperser GFX
author: Christos Koulaxizis
tags: allpass phase dispersion group delay transient laser zap chirp kick sound design gui
//category: Essentials
//NULL JSFX v2.7 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:1000<20,20000,1:log>-Frequency (Hz)
slider2:16<0,64,1>-Amount
slider3:50<0,100,1>-Pinch (%)
slider4:100<0,100,1>-Mix (%)
slider5:0<0,1,1{Mono,Stereo}>-Mode

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // NULL Disperser (../disperser.jsfx) with its own interface: same audio code, plus @gfx.
  // Phase dispersion: a chain of Amount identical 2nd-order all-pass filters (up to 64) around
  // Frequency. The magnitude stays flat, but frequencies near Frequency are delayed more than
  // the rest, so transients smear into a falling "laser" chirp and kicks get a tighter, more
  // focused attack. Pinch sets the all-passes' Q: low spreads the delay over a wide band, high
  // concentrates it at Frequency. Stereo detunes the two channels a quarter octave apart.
  // Frequency, Pinch, Mix and Mode glide (20 ms) so changes do not click.
  stl = 0;     // left chain: 64 stages x (ic1, ic2)
  str = 128;   // right chain
  memset(stl, 0, 256);
  freembuf(str + 128);
  ks = 1 - exp(-1 / (0.02 * srate));
  snap = 1;

  // all-pass coefficients for the smoothed values (log frequencies lfl / lfr, log Q lq)
  function coefs() local(g)
  (
    k = 1 / exp(lq);
    g = tan($pi * exp(lfl) / srate);
    al1 = 1 / (1 + g * (g + k));
    al2 = g * al1;
    al3 = g * al2;
    g = tan($pi * exp(lfr) / srate);
    ar1 = 1 / (1 + g * (g + k));
    ar2 = g * ar1;
    ar3 = g * ar2;
  );

  function update()
  (
    tl = log(min(slider1 * (slider5 > 0.5 ? 0.8409 : 1), srate * 0.45));
    tr = log(min(slider1 * (slider5 > 0.5 ? 1.1892 : 1), srate * 0.45));
    tq = log(0.25 * 40 ^ (slider3 / 100));
    tm = slider4 / 100;
    n = slider2;
    // stages that are off start from silence when they come back
    memset(stl + n * 2, 0, 128 - n * 2);
    memset(str + n * 2, 0, 128 - n * 2);
    snap ? (
      lfl = tl; lfr = tr; lq = tq; mx = tm;
      coefs();
      snap = 0;
    );
  );

  // display: group delay (ms) of the chain at f, all-passes at the log frequency lf. Each stage
  // is the bilinear transform of (s^2 - k s + 1) / (s^2 + k s + 1), s = j o, o = tan(pi f / srate) / g,
  // whose delay is 2 k (1 + o^2) / ((1 - o^2)^2 + k^2 o^2), times d o / d w = (1 + t^2) / (2 g)
  function dp_ms(f, lf) local(t, g, o2, kk)
  (
    t = tan($pi * min(f, srate * 0.4999) / srate);
    g = tan($pi * exp(lf) / srate);
    o2 = t * t / (g * g);
    kk = 1 / exp(tq);
    n * 2 * kk * (1 + o2) / ((1 - o2) * (1 - o2) + kk * kk * o2) * (1 + t * t) / (2 * g) / srate * 1000;
  );

  // display: delay label for v ms (1, 2, 5 x 10^e or half of one)
  function dp_label(v)
  (
    v >= 1000 ? (
      v / 1000 == floor(v / 1000) ? sprintf(#dp_l, "%ds", v / 1000) : sprintf(#dp_l, "%.1fs", v / 1000);
    ) : (
      v == floor(v) ? sprintf(#dp_l, "%dms", v) : sprintf(#dp_l, "%.1fms", v);
    );
  );

  gfx_ext_retina = 1;

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 7;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1); ng_hist_add(2); ng_hist_add(3); ng_hist_add(4); ng_hist_add(5);
  ng_hist_init();

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 1000); ng_slider_set(2, 16); ng_slider_set(3, 50); ng_slider_set(4, 100); ng_slider_set(5, 0); );
    p == 1 ? ( ng_slider_set(1, 80); ng_slider_set(2, 8); ng_slider_set(3, 60); ng_slider_set(4, 100); ng_slider_set(5, 0); );
    p == 2 ? ( ng_slider_set(1, 120); ng_slider_set(2, 16); ng_slider_set(3, 40); ng_slider_set(4, 100); ng_slider_set(5, 0); );
    p == 3 ? ( ng_slider_set(1, 1500); ng_slider_set(2, 32); ng_slider_set(3, 70); ng_slider_set(4, 100); ng_slider_set(5, 0); );
    p == 4 ? ( ng_slider_set(1, 3000); ng_slider_set(2, 48); ng_slider_set(3, 80); ng_slider_set(4, 100); ng_slider_set(5, 1); );
    p == 5 ? ( ng_slider_set(1, 2000); ng_slider_set(2, 6); ng_slider_set(3, 30); ng_slider_set(4, 100); ng_slider_set(5, 0); );
    p == 6 ? ( ng_slider_set(1, 800); ng_slider_set(2, 24); ng_slider_set(3, 30); ng_slider_set(4, 100); ng_slider_set(5, 1); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 1000) && ng_pre_eq(slider2, 16) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 80) && ng_pre_eq(slider2, 8) && ng_pre_eq(slider3, 60) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 120) && ng_pre_eq(slider2, 16) && ng_pre_eq(slider3, 40) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 1500) && ng_pre_eq(slider2, 32) && ng_pre_eq(slider3, 70) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 3000) && ng_pre_eq(slider2, 48) && ng_pre_eq(slider3, 80) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 1) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 2000) && ng_pre_eq(slider2, 6) && ng_pre_eq(slider3, 30) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 0) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 800) && ng_pre_eq(slider2, 24) && ng_pre_eq(slider3, 30) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 1) ? m = 6;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Kick Punch Focus";
    p == 2 ? s = "Bass Phase Smear";
    p == 3 ? s = "Laser Snare";
    p == 4 ? s = "Synth Zap";
    p == 5 ? s = "Soft Transients";
    p == 6 ? s = "Stereo Width Smear";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----


@slider
  update();

@block
  // flush states that decayed below -300 dB (no denormals in silence)
  i = 0;
  loop(256,
    abs(stl[i]) < 0.000000000000001 ? stl[i] = 0;
    i += 1;
  );

@sample
  lfl !== tl || lfr !== tr || lq !== tq || mx !== tm ? (
    lfl += (tl - lfl) * ks;
    abs(tl - lfl) < 0.0001 ? lfl = tl;
    lfr += (tr - lfr) * ks;
    abs(tr - lfr) < 0.0001 ? lfr = tr;
    lq += (tq - lq) * ks;
    abs(tq - lq) < 0.0001 ? lq = tq;
    mx += (tm - mx) * ks;
    abs(tm - mx) < 0.0001 ? mx = tm;
    coefs();
  );
  // TPT state-variable all-pass stages: y = x - 2 k bp
  xl = spl0;
  s = stl;
  loop(n,
    v3 = xl - s[1];
    v1 = al1 * s[0] + al2 * v3;
    v2 = s[1] + al2 * s[0] + al3 * v3;
    s[0] = 2 * v1 - s[0];
    s[1] = 2 * v2 - s[1];
    xl -= 2 * k * v1;
    s += 2;
  );
  xr = spl1;
  s = str;
  loop(n,
    v3 = xr - s[1];
    v1 = ar1 * s[0] + ar2 * v3;
    v2 = s[1] + ar2 * s[0] + ar3 * v3;
    s[0] = 2 * v1 - s[0];
    s[1] = 2 * v2 - s[1];
    xr -= 2 * k * v1;
    s += 2;
  );
  spl0 += (xl - spl0) * mx;
  spl1 += (xr - spl1) * mx;

@gfx 480 294
  ng_knobs_begin("DISPERSER", "ESSENTIALS", 480, 120, 1, 0);

  // display: the group delay of the chain from 20 Hz to 20 kHz on a scale that fits its peak
  // (Stereo: the right channel dimmer), Frequency dashed
  dp_px = ng_vx + 26; dp_py = ng_vy + 4; dp_pw = ng_vw - 30; dp_ph = ng_vh - 20;
  ng_plot(dp_px, dp_py, dp_pw, dp_ph);
  dp_pk = max(dp_ms(exp(tl), tl), dp_ms(exp(tr), tr));
  dp_j = 0;
  loop(200,
    dp_f = 20 * 1000 ^ (dp_j / 199);
    dp_pk = max(dp_pk, max(dp_ms(dp_f, tl), dp_ms(dp_f, tr)));
    dp_j += 1;
  );
  dp_top = 1; dp_m = 1;
  while (dp_top < dp_pk * 1.05) (
    dp_top *= dp_m == 2 ? 2.5 : 2;
    dp_m = dp_m == 1 ? 2 : dp_m == 2 ? 5 : 1;
  );

  dp_d = 10;
  loop(4,
    dp_m = 1;
    loop(9,
      dp_f = dp_m * dp_d;
      dp_f >= 20 && dp_f <= 20000 ? (
        dp_xx = floor(ng_freq_x(dp_f)) + 0.5;
        ng_col(NG_BORDER, dp_m == 1 ? 1 : 0.5);
        gfx_line(dp_xx, ng_py, dp_xx, ng_py + ng_ph, 0);
      );
      dp_m += 1;
    );
    dp_d *= 10;
  );
  ng_font(4, 8, 0);
  dp_j = 0;
  loop(3,
    dp_yy = floor(ng_lin_y(dp_top * dp_j / 2, 0, dp_top)) + 0.5;
    ng_col(dp_j == 0 ? 0x45433f : NG_BORDER, dp_j == 0 ? 1 : 0.6);
    gfx_line(ng_px, dp_yy, ng_px + ng_pw, dp_yy, 0);
    ng_col(NG_MUTED, 1);
    dp_j == 0 ? strcpy(#dp_l, "0") : dp_label(dp_top * dp_j / 2);
    ng_txt(#dp_l, dp_px - 6, (dp_yy - ng_oy) / ng_s, 2, 0);
    dp_j += 1;
  );
  ng_txt("100", dp_px + dp_pw * log(5) / log(1000), dp_py + dp_ph + 11, 1, 0);
  ng_txt("1k", dp_px + dp_pw * log(50) / log(1000), dp_py + dp_ph + 11, 1, 0);
  ng_txt("10k", dp_px + dp_pw * log(500) / log(1000), dp_py + dp_ph + 11, 1, 0);

  dp_xx = floor(ng_freq_x(slider1)) + 0.5;
  ng_col(NG_ACCENT, 0.5);
  dp_yy = ng_py;
  while (
    gfx_line(dp_xx, dp_yy, dp_xx, min(dp_yy + 3 * ng_s, ng_py + ng_ph), 0);
    dp_yy += 6 * ng_s;
    dp_yy < ng_py + ng_ph;
  );

  dp_zy = ng_py + ng_ph;
  slider5 > 0.5 ? (
    ng_col(NG_ACCENT, 0.45);
    dp_i = 0;
    loop(floor(ng_pw) + 1,
      dp_yy = ng_lin_y(dp_ms(20 * 1000 ^ (dp_i / ng_pw), tr), 0, dp_top);
      dp_i == 0 ? ng_line_start(ng_px, dp_yy) : ng_line_to(ng_px + dp_i, dp_yy);
      dp_i += 1;
    );
  );
  ng_col(NG_ACCENT, 0.10);
  dp_i = 0;
  loop(floor(ng_pw) + 1,
    gfx_line(ng_px + dp_i, dp_zy, ng_px + dp_i, ng_lin_y(dp_ms(20 * 1000 ^ (dp_i / ng_pw), tl), 0, dp_top), 0);
    dp_i += 1;
  );
  ng_col(NG_ACCENT, 1);
  dp_i = 0;
  loop(floor(ng_pw) + 1,
    dp_yy = ng_lin_y(dp_ms(20 * 1000 ^ (dp_i / ng_pw), tl), 0, dp_top);
    dp_i == 0 ? ng_line_start(ng_px, dp_yy) : ng_line_to(ng_px + dp_i, dp_yy);
    dp_i += 1;
  );

  ng_row(5);
  slider1 >= 1000 ? sprintf(#v1, "%.2f kHz", slider1 / 1000) : sprintf(#v1, "%d Hz", slider1);
  ng_knob_ctl_log(1, "FREQ", #v1, 20, 20000, 1000, 1) ? update();
  sprintf(#v2, "%d", slider2);
  ng_knob_ctl(2, "AMOUNT", #v2, 0, 64, 16, 1, 0) ? update();
  sprintf(#v3, "%d%%", slider3);
  ng_knob_ctl(3, "PINCH", #v3, 0, 100, 50, 1, 0) ? update();
  sprintf(#v4, "%d%%", slider4);
  ng_knob_ctl(4, "MIX", #v4, 0, 100, 100, 1, 0) ? update();
  ng_select_ctl(5, "MODE", "MONO|STEREO", 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
