desc:NULL Test Signal GFX
author: Christos Koulaxizis
tags: test signal tone generator sine sweep pink noise white noise polarity calibration reference level speaker wiring utility gui
//category: Essentials
//NULL JSFX v2.9 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:0<0,4,1{Sine,Sweep,Pink Noise,White Noise,Polarity}>-Signal
slider2:1000<20,20000,1:log>-Frequency (Hz)
slider3:-20<-60,0,0.1>-Level (dBFS)
slider4:10<1,60,0.1>-Sweep Time (s)
slider5:0<0,2,1{Both,Left,Right}>-Channels
slider6:0<0,1,1{Off,On}>-Invert Right
slider7:0<0,1,1{Off,On}>-Pass Input

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep the sweep and the noise going, as in the VST3/CLAP
  // NULL Test Signal (../test_signal.jsfx) with its own interface: same audio code, plus @gfx.
  // Test tones at a known level, for calibrating speakers and checking the wiring:
  //   - Sine at Frequency; Level is its peak (a full-scale sine is 0 dBFS)
  //   - Sweep: a logarithmic sweep from 20 Hz to 20 kHz over Sweep Time, then again; Level peak
  //   - Pink Noise (Paul Kellet's filter on Park-Miller white noise) and White Noise; Level is
  //     their RMS (white noise peaks 4.8 dB above it, pink more)
  //   - Polarity: a 2 ms positive pulse (raised cosine) twice a second, peak at Level, so a
  //     polarity checker or a look at the waveform shows a speaker wired the wrong way round
  // Channels plays the signal on both sides or only on one (to find which speaker is which),
  // Invert Right turns the right channel upside down (a polarity check by ear: the image goes
  // wide and the bass thin). Pass Input Off replaces the input; On adds the signal to it.
  // Level changes glide over 10 ms.
  ph = 0;                      // the oscillator's phase (0..1)
  sw_t = 0;                    // the sweep's time (s)
  pl_n = 0;                    // samples since the last polarity pulse
  seed = 12345;                // Park-Miller
  pk0 = pk1 = pk2 = pk3 = pk4 = pk5 = pk6 = 0;
  gs = 0;                      // the gain now (glides to g)
  cur_f = 1000;                // the frequency now (for the display)

  gfx_ext_retina = 1;
  ng_tap_init(4000000, 2048);  // the output, for the scope
  ts_pk = 0;                   // output peak (display only)

  function update()
  (
    sig = floor(slider1 + 0.5);
    g = 10 ^ (slider3 / 20);
    sw_len = slider4;
    chans = floor(slider5 + 0.5);
    inv = slider6 >= 0.5;
    pass = slider7 >= 0.5;
    g_c = 1 - exp(-1000 / (10 * srate));
    pl_len = floor(0.002 * srate);
    pl_every = floor(0.5 * srate);
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 13;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1); ng_hist_add(2); ng_hist_add(3); ng_hist_add(4); ng_hist_add(5); ng_hist_add(6); ng_hist_add(7);
  ng_hist_init();

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 0); ng_slider_set(2, 1000); ng_slider_set(3, -20); ng_slider_set(4, 10); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); );
    p == 1 ? ( ng_slider_set(1, 0); ng_slider_set(2, 1000); ng_slider_set(3, -18); ng_slider_set(4, 10); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); );
    p == 2 ? ( ng_slider_set(1, 2); ng_slider_set(2, 1000); ng_slider_set(3, -20); ng_slider_set(4, 10); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); );
    p == 3 ? ( ng_slider_set(1, 2); ng_slider_set(2, 1000); ng_slider_set(3, -23); ng_slider_set(4, 10); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); );
    p == 4 ? ( ng_slider_set(1, 2); ng_slider_set(2, 1000); ng_slider_set(3, -23); ng_slider_set(4, 10); ng_slider_set(5, 1); ng_slider_set(6, 0); ng_slider_set(7, 0); );
    p == 5 ? ( ng_slider_set(1, 2); ng_slider_set(2, 1000); ng_slider_set(3, -23); ng_slider_set(4, 10); ng_slider_set(5, 2); ng_slider_set(6, 0); ng_slider_set(7, 0); );
    p == 6 ? ( ng_slider_set(1, 4); ng_slider_set(2, 1000); ng_slider_set(3, -12); ng_slider_set(4, 10); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); );
    p == 7 ? ( ng_slider_set(1, 2); ng_slider_set(2, 1000); ng_slider_set(3, -23); ng_slider_set(4, 10); ng_slider_set(5, 0); ng_slider_set(6, 1); ng_slider_set(7, 0); );
    p == 8 ? ( ng_slider_set(1, 1); ng_slider_set(2, 1000); ng_slider_set(3, -20); ng_slider_set(4, 30); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); );
    p == 9 ? ( ng_slider_set(1, 1); ng_slider_set(2, 1000); ng_slider_set(3, -20); ng_slider_set(4, 3); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); );
    p == 10 ? ( ng_slider_set(1, 0); ng_slider_set(2, 40); ng_slider_set(3, -20); ng_slider_set(4, 10); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); );
    p == 11 ? ( ng_slider_set(1, 0); ng_slider_set(2, 50); ng_slider_set(3, -30); ng_slider_set(4, 10); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 1); );
    p == 12 ? ( ng_slider_set(1, 3); ng_slider_set(2, 1000); ng_slider_set(3, -20); ng_slider_set(4, 10); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 1000) && ng_pre_eq(slider3, -20) && ng_pre_eq(slider4, 10) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 1000) && ng_pre_eq(slider3, -18) && ng_pre_eq(slider4, 10) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 1000) && ng_pre_eq(slider3, -20) && ng_pre_eq(slider4, 10) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 1000) && ng_pre_eq(slider3, -23) && ng_pre_eq(slider4, 10) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 1000) && ng_pre_eq(slider3, -23) && ng_pre_eq(slider4, 10) && ng_pre_eq(slider5, 1) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 1000) && ng_pre_eq(slider3, -23) && ng_pre_eq(slider4, 10) && ng_pre_eq(slider5, 2) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 4) && ng_pre_eq(slider2, 1000) && ng_pre_eq(slider3, -12) && ng_pre_eq(slider4, 10) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 1000) && ng_pre_eq(slider3, -23) && ng_pre_eq(slider4, 10) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 1) && ng_pre_eq(slider7, 0) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 1000) && ng_pre_eq(slider3, -20) && ng_pre_eq(slider4, 30) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) ? m = 8;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 1000) && ng_pre_eq(slider3, -20) && ng_pre_eq(slider4, 3) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) ? m = 9;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 40) && ng_pre_eq(slider3, -20) && ng_pre_eq(slider4, 10) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) ? m = 10;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 50) && ng_pre_eq(slider3, -30) && ng_pre_eq(slider4, 10) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 1) ? m = 11;
    m < 0 && ng_pre_eq(slider1, 3) && ng_pre_eq(slider2, 1000) && ng_pre_eq(slider3, -20) && ng_pre_eq(slider4, 10) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) ? m = 12;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "1 kHz Reference";
    p == 2 ? s = "Pink Noise -20 dBFS";
    p == 3 ? s = "Speaker Level Check";
    p == 4 ? s = "Left Speaker";
    p == 5 ? s = "Right Speaker";
    p == 6 ? s = "Polarity Check";
    p == 7 ? s = "Out Of Phase Test";
    p == 8 ? s = "Slow Sweep";
    p == 9 ? s = "Fast Sweep";
    p == 10 ? s = "Sub Check 40 Hz";
    p == 11 ? s = "Hum Hunt 50 Hz";
    p == 12 ? s = "White Noise -20 dBFS";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  gs += (g - gs) * g_c;
  sig == 0 ? (
    cur_f = slider2;
    x = sin(2 * $pi * ph);
    ph += cur_f / srate;
    ph -= floor(ph);
  ) : sig == 1 ? (
    cur_f = 20 * 1000 ^ (sw_t / sw_len);
    x = sin(2 * $pi * ph);
    ph += cur_f / srate;
    ph -= floor(ph);
    sw_t += 1 / srate;
    sw_t >= sw_len ? sw_t = 0;
  ) : sig == 4 ? (
    x = pl_n < pl_len ? 0.5 - 0.5 * cos(2 * $pi * pl_n / pl_len) : 0;
    pl_n += 1;
    pl_n >= pl_every ? pl_n = 0;
  ) : (
    seed *= 16807; seed -= floor(seed / 2147483647) * 2147483647;
    w = seed / 1073741824 - 1;
    sig == 3 ? x = w * 1.7320508075688772 : (
      pk0 = 0.99886 * pk0 + w * 0.0555179;
      pk1 = 0.99332 * pk1 + w * 0.0750759;
      pk2 = 0.969 * pk2 + w * 0.153852;
      pk3 = 0.8665 * pk3 + w * 0.3104856;
      pk4 = 0.55 * pk4 + w * 0.5329522;
      pk5 = -0.7616 * pk5 - w * 0.016898;
      x = (pk0 + pk1 + pk2 + pk3 + pk4 + pk5 + pk6 + w * 0.5362) * 0.5628;
      pk6 = w * 0.115926;
    );
  );
  x *= gs;
  xl = chans == 2 ? 0 : x;
  xr = chans == 1 ? 0 : inv ? -x : x;
  pass ? (
    spl0 += xl;
    spl1 += xr;
  ) : (
    spl0 = xl;
    spl1 = xr;
  );
  ng_tap(spl0, spl1);
  ts_pk = max(ts_pk, max(abs(spl0), abs(spl1)));

@gfx 480 380
  ng_knobs_begin("TEST SIGNAL", "ESSENTIALS", 480, 120, 2, 0);

  // display: the signal, its frequency and level on the left, the output waveform on the right
  ts_tx = ng_vx + 8;
  ng_font(1, 7, 1);
  ng_col(NG_ACCENT, 1);
  strcpy(#ts_n, sig == 0 ? "SINE" : sig == 1 ? "SWEEP" : sig == 2 ? "PINK NOISE" : sig == 3 ? "WHITE NOISE" : "POLARITY");
  ng_txt(#ts_n, ts_tx, ng_vy + 14, 0, 1);
  ng_col(NG_MUTED, 1);
  sig <= 1 ? (
    cur_f >= 1000 ? sprintf(#ts_f, "%.2f kHz", cur_f / 1000) : sprintf(#ts_f, "%.0f Hz", cur_f);
  ) : sig == 4 ? strcpy(#ts_f, "PULSE 2/S") : strcpy(#ts_f, "20 HZ - 20 KHZ");
  ng_txt(#ts_f, ts_tx, ng_vy + 30, 0, 1);
  sprintf(#ts_l, sig == 2 || sig == 3 ? "%.1f dBFS RMS" : "%.1f dBFS PEAK", slider3);
  ng_txt(#ts_l, ts_tx, ng_vy + 46, 0, 1);
  strcpy(#ts_c, chans == 1 ? "LEFT ONLY" : chans == 2 ? "RIGHT ONLY" : inv ? "BOTH, RIGHT INVERTED" : "BOTH");
  ng_txt(#ts_c, ts_tx, ng_vy + 62, 0, 1);
  ts_db = ng_to_db(ts_pk);
  ng_meter(ts_tx, ng_vy + ng_vh - 22, 150, 8, "OUT", ts_db, -140, -60);
  ts_pk = 0;
  ng_plot(ng_vx + 180, ng_vy + 4, ng_vw - 184, ng_vh - 8);
  ng_col(NG_BORDER, 1);
  gfx_line(ng_px, ng_py + ng_ph / 2, ng_px + ng_pw, ng_py + ng_ph / 2, 0);
  ng_scope(0.8 / max(g, 0.01)); // scaled to the Level, so the shape shows at any level

  ng_row(4);
  ng_select_ctl(1, "SIGNAL", "SINE|SWEEP|PINK|WHITE|POLARITY", 0) ? update();
  slider2 >= 1000 ? sprintf(#ts_v2, "%.2f kHz", slider2 / 1000) : sprintf(#ts_v2, "%d Hz", slider2);
  ng_knob_ctl_log(2, "FREQUENCY", #ts_v2, 20, 20000, 1000, 1) ? update();
  sprintf(#ts_v3, "%.1f dB", slider3);
  ng_knob_ctl(3, "LEVEL", #ts_v3, -60, 0, -20, 0.1, 0) ? update();
  sprintf(#ts_v4, "%.1f s", slider4);
  ng_knob_ctl(4, "SWEEP TIME", #ts_v4, 1, 60, 10, 0.1, 0) ? update();

  ng_row(3);
  ng_select_ctl(5, "CHANNELS", "BOTH|LEFT|RIGHT", 0) ? update();
  ng_select_ctl(6, "INVERT R", "OFF|ON", 0) ? update();
  ng_select_ctl(7, "PASS INPUT", "OFF|ON", 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
