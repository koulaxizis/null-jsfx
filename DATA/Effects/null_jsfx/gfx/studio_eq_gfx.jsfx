  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Vocal Clean Up";
    p == 2 ? s = "Kick Weight And Click";
    p == 3 ? s = "Snare Body";
    p == 4 ? s = "Acoustic Guitar";
    p == 5 ? s = "Bass Definition";
    p == 6 ? s = "Mix Bus Polish";
    p == 7 ? s = "Mastering Linear";
    p == 8 ? s = "Mono Low End";
    p == 9 ? s = "Wide Air";
    p == 10 ? s = "Telephone Voice";
    p == 11 ? s = "Surgical Notch 60 Hz";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  SQ_PRE[sq_wp] = (spl0 + spl1) * 0.5; // display only: the input for the spectrum
  se_lin ? (
    SE_IL[se_pos] = spl0; SE_IR[se_pos] = spl1;
    spl0 = SE_OL[se_pos] * se_gout;
    spl1 = SE_OR[se_pos] * se_gout;
    se_pos += 1;
    se_pos >= 1024 ? ( se_block(); se_pos = 0; );
  ) : (
    se_l = spl0; se_r = spl1;
    se_b = 0;
    loop(8,
      se_n = SE_NS[se_b];
      se_n > 0 ? (
        se_c = SE_BQ + se_b * 128;
        se_h = SE_CH[se_b];
        se_h == 0 ? (
          se_l = se_cas(se_l, se_c, se_c + 64, se_n);
          se_r = se_cas(se_r, se_c, se_c + 68, se_n);
        ) : se_h == 3 ? (
          se_l = se_cas(se_l, se_c, se_c + 64, se_n);
        ) : se_h == 4 ? (
          se_r = se_cas(se_r, se_c, se_c + 68, se_n);
        ) : (
          se_m = (se_l + se_r) * 0.5;
          se_s = (se_l - se_r) * 0.5;
          se_h == 1 ? se_m = se_cas(se_m, se_c, se_c + 64, se_n) : se_s = se_cas(se_s, se_c, se_c + 64, se_n);
          se_l = se_m + se_s;
          se_r = se_m - se_s;
        );
      );
      se_b += 1;
    );
    spl0 = se_l * se_gout;
    spl1 = se_r * se_gout;
  );
  // display only: the output for the spectrum
  SQ_POST[sq_wp] = (spl0 + spl1) * 0.5;
  sq_wp = (sq_wp + 1) & 4095;

@gfx 480 468
  ng_knobs_begin("STUDIO EQ", "ESSENTIALS", 480, 180, 2, 1);

  // display: the bands' response (-24..+24 dB) over the spectrum, the selected band dashed, a
  // node per band (filled = on, hollow = off; M, S, L or R above a band that is not stereo).
  // Drag a node: across for the frequency, up and down for the gain of a bell or shelf.
  ng_plot(ng_vx + 26, ng_vy + 4, ng_vw - 30, ng_vh - 20);
  sq_an < 2 ? (
    sq_analyze(sq_an == 0 ? SQ_POST : SQ_PRE);
    sq_spectrum(ng_vw - 30);
  );
  ng_grid_freq(36);
  sq_x = floor(ng_freq_x(slider(sq_tab * 6 + 2))) + 0.5;
  ng_col(NG_ACCENT, 0.5);
  sq_y = ng_py;
  while (
    gfx_line(sq_x, sq_y, sq_x, min(sq_y + 3 * ng_s, ng_py + ng_ph), 0);
    sq_y += 6 * ng_s;
    sq_y < ng_py + ng_ph;
  );
  sq_zy = ng_lin_y(0, -24, 24);
  ng_col(NG_ACCENT, 0.10);
  sq_i = 0;
  loop(floor(ng_pw) + 1,
    gfx_line(ng_px + sq_i, sq_zy, ng_px + sq_i, ng_lin_y(sq_total(20 * 1000 ^ (sq_i / ng_pw)), -24, 24), 0);
    sq_i += 1;
  );
  ng_col(NG_ACCENT, 1);
  sq_i = 0;
  loop(floor(ng_pw) + 1,
    sq_y = ng_lin_y(sq_total(20 * 1000 ^ (sq_i / ng_pw)), -24, 24);
    sq_i == 0 ? ng_line_start(ng_px, sq_y) : ng_line_to(ng_px + sq_i, sq_y);
    sq_i += 1;
  );

  // the spectrum selector: a click steps POST, PRE, OFF
  sq_bx = ng_vx + ng_vw - 62; sq_by = ng_vy + 7;
  sq_hov = mouse_x >= X(sq_bx) && mouse_x < X(sq_bx + 58) && mouse_y >= Y(sq_by) && mouse_y < Y(sq_by + 14);
  ng_click && sq_hov ? ( sq_an = (sq_an + 1) % 3; ng_click = 0; );

  // dragging a node
  ng_click ? (
    sq_k = 0;
    sq_best = 8 * ng_s;
    loop(8,
      sq_d = sqrt(sqr(mouse_x - ng_freq_x(min(20000, slider(sq_k * 6 + 2)))) + sqr(mouse_y - sq_node_y(sq_k)));
      sq_d < sq_best ? ( sq_best = sq_d; sq_drag = sq_k + 1; sq_tab = sq_k; );
      sq_k += 1;
    );
    sq_drag ? ng_click = 0;
  );
  !ng_lmb ? sq_drag = 0;
  sq_drag ? (
    sq_k = sq_drag - 1;
    sq_ch = ng_slider_set(sq_k * 6 + 2, floor(min(30000, max(10, 20 * 1000 ^ ((mouse_x - ng_px) / ng_pw))) + 0.5));
    sq_tp = slider(sq_k * 6 + 1);
    sq_tp >= 1 && sq_tp <= 3 ? sq_ch += ng_slider_set(sq_k * 6 + 3, floor(min(24, max(-24, 24 - 48 * (mouse_y - ng_py) / ng_ph)) * 10 + 0.5) / 10);
    sq_ch ? update();
  );

  // the nodes
  sq_k = 0;
  loop(8,
    sq_x = ng_freq_x(min(20000, slider(sq_k * 6 + 2)));
    sq_y = sq_node_y(sq_k);
    sq_on = SE_NS[sq_k] > 0;
    sq_k == sq_tab ? (
      ng_col(sq_on ? NG_ACCENT : NG_MUTED, 1);
      gfx_circle(sq_x, sq_y, 4 * ng_s, 1, 1);
    ) : (
      ng_col(sq_on ? NG_ACCENT : NG_MUTED, 1);
      gfx_circle(sq_x, sq_y, 3 * ng_s, sq_on, 1);
    );
    sq_h = slider(sq_k * 6 + 6);
    sq_on && sq_h > 0 ? (
      ng_font(1, 6.5, 1);
      ng_ptxt(sq_h == 1 ? "M" : sq_h == 2 ? "S" : sq_h == 3 ? "L" : "R", sq_x, sq_y - 9 * ng_s, 1);
    );
    sq_k += 1;
  );

  // status: phase mode and auto gain, top left
  ng_font(1, 6.5, 1);
  ng_col(NG_MUTED, 1);
  slider50 ? sprintf(#sq_st, "%s   AUTO %+.1f dB", slider51 ? "LINEAR PHASE" : "ZERO LATENCY", se_ag)
           : strcpy(#sq_st, slider51 ? "LINEAR PHASE" : "ZERO LATENCY");
  ng_txt(#sq_st, ng_vx + 30, ng_vy + 14, 0, 1);

  ng_col(NG_BG, 0.85);
  gfx_roundrect(X(sq_bx), Y(sq_by), 58 * ng_s, 14 * ng_s, 3 * ng_s, 1);
  gfx_rect(X(sq_bx) + 1, Y(sq_by) + 1, 58 * ng_s - 1, 14 * ng_s - 1);
  ng_col(sq_hov ? 0x45433f : NG_BORDER, 1);
  gfx_roundrect(X(sq_bx), Y(sq_by), 58 * ng_s, 14 * ng_s, 3 * ng_s, 1);
  ng_font(1, 6.5, 1);
  ng_col(sq_an < 2 ? NG_TEXT : NG_MUTED, 1);
  ng_txt(sq_an == 0 ? "FFT POST" : sq_an == 1 ? "FFT PRE" : "FFT OFF", sq_bx + 29, sq_by + 7, 1, 1);

  sq_tab = ng_tabs("BAND 1|BAND 2|BAND 3|BAND 4|BAND 5|BAND 6|BAND 7|BAND 8", sq_tab);
  sq_b = sq_tab * 6;
  ng_row(6);
  ng_select_ctl(sq_b + 1, "TYPE", "OFF|BELL|LO SHELF|HI SHELF|LOW CUT|HIGH CUT|NOTCH|BAND", 0) ? update();
  ng_knob_ctl_log(sq_b + 2, "FREQ", sq_freq_txt(slider(sq_b + 2)), 10, 30000, sq_fdef(sq_tab), 1) ? update();
  sprintf(#sq_g, "%+.1f dB", slider(sq_b + 3));
  ng_knob_ctl(sq_b + 3, "GAIN", #sq_g, -30, 30, 0, 0.1, 1) ? update();
  sprintf(#sq_q, "%.2f", slider(sq_b + 4));
  ng_knob_ctl_log(sq_b + 4, "Q", #sq_q, 0.1, 18, 0.71, 0.01) ? update();
  ng_select_ctl(sq_b + 5, "SLOPE", "6 dB|12 dB|18 dB|24 dB|36 dB|48 dB|72 dB|96 dB", 0) ? update();
  ng_select_ctl(sq_b + 6, "CHANNELS", "STEREO|MID|SIDE|LEFT|RIGHT", 0) ? update();
  ng_row(3);
  sprintf(#sq_o, "%+.1f dB", slider49);
  ng_knob_ctl(49, "OUTPUT", #sq_o, -24, 24, 0, 0.1, 1) ? update();
  ng_select_ctl(50, "AUTO GAIN", "OFF|ON", 0) ? update();
  ng_select_ctl(51, "PHASE", "ZERO LAT|LINEAR", 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
