  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Electric Piano";
    p == 2 ? s = "Soft EP";
    p == 3 ? s = "Tubular Bells";
    p == 4 ? s = "Glass Bells";
    p == 5 ? s = "FM Bass";
    p == 6 ? s = "Slap Bass";
    p == 7 ? s = "Brass";
    p == 8 ? s = "Soft Pad";
    p == 9 ? s = "Marimba";
    p == 10 ? s = "Vibraphone";
    p == 11 ? s = "Organ";
    p == 12 ? s = "Clav";
    p == 13 ? s = "Sync Lead";
    p == 14 ? s = "Harp Pluck";
    p == 15 ? s = "Bell Pad";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@block
  // MIDI of this block, played at its offsets in @sample
  mq_n = 0;
  while (midirecv(m_ofs, m_1, m_2, m_3)) (
    // every message goes on to the next plugin too, so instruments can be layered
    midisend(m_ofs, m_1, m_2, m_3);
    mq_n < 256 ? (
      MQ[mq_n * 4] = m_ofs;
      MQ[mq_n * 4 + 1] = m_1;
      MQ[mq_n * 4 + 2] = m_2;
      MQ[mq_n * 4 + 3] = m_3;
      mq_n += 1;
    );
  );
  mq_i = 0;
  si = 0;
  vib_inc = 5.5 / srate;
  ch_inc = 0.45 / srate;

@sample
  while (mq_i < mq_n && MQ[mq_i * 4] <= si) (
    midi_in(MQ[mq_i * 4 + 1], MQ[mq_i * 4 + 2], MQ[mq_i * 4 + 3]);
    mq_i += 1;
  );
  si += 1;

  // pitch bend and the mod wheel's vibrato (5.5 Hz, up to half a semitone)
  vib_ph += vib_inc; vib_ph -= floor(vib_ph);
  pmod = bend * bend_r + 0.5 * mwheel * sin(2 * $pi * vib_ph);

  outv = 0;
  v0.vproc(); v1.vproc(); v2.vproc(); v3.vproc(); v4.vproc(); v5.vproc(); v6.vproc(); v7.vproc();
  outl = outr = outv;

  // Chorus: two delay lines (12 ms +- 3 ms) moved by a slow sine in quadrature
  ch_on ? (
    ch_ph += ch_inc; ch_ph -= floor(ch_ph);
    CHL[ch_w] = outl; CHR[ch_w] = outr;
    ch_d = (0.012 + 0.003 * sin(2 * $pi * ch_ph)) * srate;
    ch_r = ch_w - ch_d; ch_r < 0 ? ch_r += CHN;
    ch_i = floor(ch_r); ch_fr = ch_r - ch_i; ch_j = ch_i + 1; ch_j >= CHN ? ch_j -= CHN;
    ch_yl = CHL[ch_i] + (CHL[ch_j] - CHL[ch_i]) * ch_fr;
    ch_d = (0.012 + 0.003 * cos(2 * $pi * ch_ph)) * srate;
    ch_r = ch_w - ch_d; ch_r < 0 ? ch_r += CHN;
    ch_i = floor(ch_r); ch_fr = ch_r - ch_i; ch_j = ch_i + 1; ch_j >= CHN ? ch_j -= CHN;
    ch_yr = CHR[ch_i] + (CHR[ch_j] - CHR[ch_i]) * ch_fr;
    ch_w += 1; ch_w >= CHN ? ch_w = 0;
    outl = outl * (1 - 0.5 * ch_mix) + ch_yr * 0.5 * ch_mix;
    outr = outr * (1 - 0.5 * ch_mix) + ch_yl * 0.5 * ch_mix;
  );

  // Reverb: eight delay lines through a Hadamard matrix, each damped and decaying by Size
  rv_on ? (
    k = 0;
    loop(8,
      rv_p = RVB + k * RVN + RVP[k];
      RVS[k] += (rv_p[0] - RVS[k]) * rv_dc;
      RVT[k] = RVS[k] * RVG[k];
      RVY[k] = RVT[k];
      k += 1;
    );
    rv_a = RVT[0] + RVT[1]; rv_b = RVT[0] - RVT[1]; RVT[0] = rv_a; RVT[1] = rv_b;
    rv_a = RVT[2] + RVT[3]; rv_b = RVT[2] - RVT[3]; RVT[2] = rv_a; RVT[3] = rv_b;
    rv_a = RVT[4] + RVT[5]; rv_b = RVT[4] - RVT[5]; RVT[4] = rv_a; RVT[5] = rv_b;
    rv_a = RVT[6] + RVT[7]; rv_b = RVT[6] - RVT[7]; RVT[6] = rv_a; RVT[7] = rv_b;
    rv_a = RVT[0] + RVT[2]; rv_b = RVT[0] - RVT[2]; RVT[0] = rv_a; RVT[2] = rv_b;
    rv_a = RVT[1] + RVT[3]; rv_b = RVT[1] - RVT[3]; RVT[1] = rv_a; RVT[3] = rv_b;
    rv_a = RVT[4] + RVT[6]; rv_b = RVT[4] - RVT[6]; RVT[4] = rv_a; RVT[6] = rv_b;
    rv_a = RVT[5] + RVT[7]; rv_b = RVT[5] - RVT[7]; RVT[5] = rv_a; RVT[7] = rv_b;
    rv_a = RVT[0] + RVT[4]; rv_b = RVT[0] - RVT[4]; RVT[0] = rv_a; RVT[4] = rv_b;
    rv_a = RVT[1] + RVT[5]; rv_b = RVT[1] - RVT[5]; RVT[1] = rv_a; RVT[5] = rv_b;
    rv_a = RVT[2] + RVT[6]; rv_b = RVT[2] - RVT[6]; RVT[2] = rv_a; RVT[6] = rv_b;
    rv_a = RVT[3] + RVT[7]; rv_b = RVT[3] - RVT[7]; RVT[3] = rv_a; RVT[7] = rv_b;
    k = 0;
    loop(8,
      rv_p = RVB + k * RVN + RVP[k];
      rv_p[0] = RVT[k] * 0.35355339059327373 + (k & 1 ? outr : outl) * 0.3;
      RVP[k] += 1; RVP[k] >= RVL[k] ? RVP[k] = 0;
      k += 1;
    );
    outl += (RVY[0] + RVY[2] + RVY[4] + RVY[6]) * 0.5 * rv_mix;
    outr += (RVY[1] + RVY[3] + RVY[5] + RVY[7]) * 0.5 * rv_mix;
  );

  spl0 = outl * vol;
  spl1 = outr * vol;

@gfx 600 438
  ng_knobs_begin("FM", "INSTRUMENTS", 600, 150, 2, 1);

  // display: the algorithm (who modulates whom; carriers on the output line, the feedback
  // loop on operator 4) and the four envelopes at their levels, the selected one bright, with
  // a dot per voice that lights while it sounds
  fm_a = floor(slider1 + 0.5);
  strcpy_substr(#fm_n, "STACK     DUAL MOD  BRANCH    PAIR STACKTWO PAIRS TRIPLE    ONE PAIR  ADDITIVE  ", fm_a * 10, 10);
  fm_k = strlen(#fm_n); while (fm_k > 0 && str_getchar(#fm_n, fm_k - 1) == ' ') ( fm_k -= 1; );
  strcpy_substr(#fm_n, #fm_n, 0, fm_k);
  sprintf(#fm_ti, "ALGORITHM  %s", #fm_n);
  fm_panel(24, 230, #fm_ti);
  // the output line under the carriers
  ng_col(NG_MUTED, 1);
  fm_x0 = 1000; fm_x1 = 0;
  fm_k = 0;
  loop(4,
    fm_pos(fm_a, fm_k);
    CR[fm_k] > 0 ? ( fm_x0 = min(fm_x0, fm_x); fm_x1 = max(fm_x1, fm_x); gfx_line(X(fm_x), Y(fm_y + 8), X(fm_x), Y(184), 0); );
    fm_k += 1;
  );
  gfx_rect(X(fm_x0 - 1), Y(184), (fm_x1 - fm_x0 + 2) * ng_s, max(1, 2 * ng_s));
  // modulation: from the bottom of the modulator to the top of the one it modulates
  fm_i = 0;
  loop(4,
    fm_j = 0;
    loop(4,
      MM[fm_i * 4 + fm_j] > 0 ? (
        fm_pos(fm_a, fm_j); fm_sx = fm_x; fm_sy = fm_y;
        fm_pos(fm_a, fm_i);
        ng_col(NG_ACCENT, 0.8);
        gfx_line(X(fm_sx), Y(fm_sy + 8), X(fm_x), Y(fm_y - 8), 1);
      );
      fm_j += 1;
    );
    fm_i += 1;
  );
  // the feedback loop on operator 4
  fm_pos(fm_a, 3);
  ng_col(slider2 > 0 ? NG_ACCENT : NG_BORDER, 1);
  gfx_line(X(fm_x + 14), Y(fm_y), X(fm_x + 20), Y(fm_y), 0);
  gfx_line(X(fm_x + 20), Y(fm_y), X(fm_x + 20), Y(fm_y - 12), 0);
  gfx_line(X(fm_x + 20), Y(fm_y - 12), X(fm_x), Y(fm_y - 12), 0);
  gfx_line(X(fm_x), Y(fm_y - 12), X(fm_x), Y(fm_y - 8), 0);
  // the operators
  fm_k = 0;
  loop(4,
    fm_pos(fm_a, fm_k);
    ng_col(NG_CARD, 1);
    gfx_rect(X(fm_x - 14), Y(fm_y - 8), 28 * ng_s, 16 * ng_s);
    fm_lv = fm_slider(4 + fm_k * 7) / 100;
    ng_mix(NG_BORDER, NG_ACCENT, fm_k == fm_tab ? 1 : 0.35 + 0.65 * fm_lv, 1);
    gfx_rect(X(fm_x - 14), Y(fm_y - 8), 28 * ng_s, 16 * ng_s, 0);
    ng_font(1, 8, 1);
    fm_k == fm_tab ? ng_col(NG_TEXT, 1) : ng_mix(NG_MUTED, NG_TEXT, fm_lv, 1);
    sprintf(#fm_on, "%d", fm_k + 1);
    ng_txt(#fm_on, fm_x, fm_y, 1, 0);
    fm_k += 1;
  );

  fm_panel(264, 312, "ENVELOPES");
  fm_k = 0;
  loop(5,
    // the selected operator last, on top (on the MASTER tab all four alike)
    fm_o = fm_k < 4 ? fm_k : fm_tab;
    (fm_k < 4 && fm_o != fm_tab) || (fm_k == 4 && fm_tab < 4) ? (
      fm_b = 3 + fm_o * 7;
      fm_k == 4 ? ng_col(NG_ACCENT, 1) : ng_col(NG_MUTED, fm_tab < 4 ? 0.45 : 0.9);
      fm_env(268, 304, fm_slider(fm_b + 2), fm_slider(fm_b + 3), fm_slider(fm_b + 4) / 100, fm_slider(fm_b + 5), fm_slider(fm_b + 1) / 100);
    );
    fm_k += 1;
  );
  fm_k = 0;
  loop(8,
    fm_v = fm_k == 0 ? v0.st : fm_k == 1 ? v1.st : fm_k == 2 ? v2.st : fm_k == 3 ? v3.st : fm_k == 4 ? v4.st : fm_k == 5 ? v5.st : fm_k == 6 ? v6.st : v7.st;
    fm_m = VM + fm_k * 20;
    fm_v = fm_v > 0 ? max(max(fm_m[4], fm_m[5]), max(fm_m[6], fm_m[7])) : 0;
    ng_mix(NG_BORDER, NG_ACCENT, max(0, min(1, fm_v)), 1);
    gfx_circle(X(510 + fm_k * 9), Y(68), 2.5 * ng_s, 1, 1);
    fm_k += 1;
  );

  fm_tab = ng_tabs("OP 1|OP 2|OP 3|OP 4|MASTER", fm_tab);
  fm_tab < 4 ? (
    fm_b = 3 + fm_tab * 7;
    ng_row(6);
    sprintf(#fm_v0, "x%.2f", fm_slider(fm_b));
    ng_knob_ctl_log(fm_b, "RATIO", #fm_v0, 0.5, 16, fm_tab == 2 ? 2 : 1, 0.01) ? update();
    sprintf(#fm_v1, "%d%%", fm_slider(fm_b + 1));
    ng_knob_ctl(fm_b + 1, "LEVEL", #fm_v1, 0, 100, fm_tab == 0 ? 100 : fm_tab == 1 ? 45 : 0, 1, 0) ? update();
    strcpy(#fm_v2, fm_ms(fm_slider(fm_b + 2)));
    ng_knob_ctl_log(fm_b + 2, "ATTACK", #fm_v2, 1, 10000, 2, 1) ? update();
    strcpy(#fm_v3, fm_ms(fm_slider(fm_b + 3)));
    ng_knob_ctl_log(fm_b + 3, "DECAY", #fm_v3, 1, 10000, fm_tab == 0 ? 1500 : 800, 1) ? update();
    sprintf(#fm_v4, "%d%%", fm_slider(fm_b + 4));
    ng_knob_ctl(fm_b + 4, "SUSTAIN", #fm_v4, 0, 100, fm_tab == 0 ? 50 : 30, 1, 0) ? update();
    strcpy(#fm_v5, fm_ms(fm_slider(fm_b + 5)));
    ng_knob_ctl_log(fm_b + 5, "RELEASE", #fm_v5, 1, 10000, 400, 1) ? update();
    ng_row(6);
    sprintf(#fm_v6, "%d%%", fm_slider(fm_b + 6));
    ng_knob_ctl(fm_b + 6, "VELOCITY", #fm_v6, 0, 100, fm_tab == 1 ? 70 : 50, 1, 0) ? update();
  ) : (
    ng_row(4);
    sprintf(#fm_g34, "%d%%", slider34);
    ng_knob_ctl(34, "REVERB SIZE", #fm_g34, 0, 100, 50, 1, 0) ? update();
    sprintf(#fm_g35, "%+d", slider35);
    ng_knob_ctl(35, "OCTAVE", #fm_g35, -3, 3, 0, 1, 1) ? update();
    sprintf(#fm_g36, "%d st", slider36);
    ng_knob_ctl(36, "BEND", #fm_g36, 0, 24, 2, 1, 0) ? update();
    sprintf(#fm_g37, "%+.1f dB", slider37);
    ng_knob_ctl(37, "VOLUME", #fm_g37, -24, 12, 0, 0.1, 0) ? update();
    ng_row(5);
  );
  ng_select_ctl(1, "ALGORITHM", "STACK|DUAL MOD|BRANCH|PAIR STACK|TWO PAIRS|TRIPLE|ONE PAIR|ADDITIVE", 0) ? update();
  sprintf(#fm_g2, "%d%%", slider2);
  ng_knob_ctl(2, "FEEDBACK", #fm_g2, 0, 100, 0, 1, 0) ? update();
  sprintf(#fm_g31, "%+d%%", slider31);
  ng_knob_ctl(31, "BRIGHTNESS", #fm_g31, -100, 100, 0, 1, 1) ? update();
  sprintf(#fm_g32, "%d%%", slider32);
  ng_knob_ctl(32, "CHORUS", #fm_g32, 0, 100, 0, 1, 0) ? update();
  sprintf(#fm_g33, "%d%%", slider33);
  ng_knob_ctl(33, "REVERB", #fm_g33, 0, 100, 15, 1, 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
