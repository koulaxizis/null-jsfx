desc:NULL Stereo Scope GFX
author: Christos Koulaxizis
tags: stereo scope goniometer vectorscope lissajous correlation phase balance width meter analyzer metering gui
//category: Advanced
//NULL JSFX v2.6 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:0<-12,24,0.5>-Scope Gain (dB)
slider2:1<0,1,1{Off,On}>-Auto Gain
slider3:50<0,100,1>-Decay (%)
slider4:300<50,3000,10:log>-Integration (ms)
slider5:0<0,2,1{Stereo,Mono,Side}>-Monitor

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  // NULL Stereo Scope (../stereo_scope.jsfx) with its own interface: same audio code, plus @gfx.
  // Stereo image meter. The audio passes through untouched (bit-exact); Monitor Mono or Side
  // only fold it for listening. The measurement integrates the energies of L and R and their
  // product with a one-pole of time constant Integration:
  //   correlation = <LR> / sqrt(<LL><RR>)     (+1 mono, 0 unrelated, -1 out of phase)
  //   balance     = <RR> vs <LL> in dB
  //   width       = side level / mid level    (0% mono, 100% as much side as mid)
  // The interface draws a goniometer (Lissajous, L/R rotated 45 degrees so mid is up) with
  // persistence, the meters and a correlation history.
  sc_ll = sc_rr = sc_lr = 0;
  gfx_ext_retina = 1;
  // display only: ring of the latest 8192 input samples (L, R) for the goniometer, peak
  // levels, and the correlation every 1/30 s for the history (150 values = 5 s)
  SC_N = 8192;
  sc_rb = 1000000;
  sc_hb = sc_rb + 2 * SC_N;
  memset(sc_rb, 0, 2 * SC_N + 150);
  sc_rw = 0;
  sc_hw = sc_hn = sc_hc = 0;
  sc_hper = floor(srate / 30);
  sc_prel = exp(-1 / (0.3 * srate));
  sc_pl = sc_pr = 0;
  sc_ag = 1;

  // correlation of the integrated energies (0 when either side is silent)
  function sc_corr() local(p) ( p = sc_ll * sc_rr; p > 0.00000000000001 ? max(-1, min(1, sc_lr / sqrt(p))) : 0; );

  // readout tile: background box, label, value
  function sc_tile(x, y, w, h, label, value)
  (
    ng_col(NG_BG, 1);
    gfx_roundrect(X(x), Y(y), w * ng_s, h * ng_s, 4 * ng_s, 1);
    gfx_rect(X(x) + 1, Y(y) + 1, w * ng_s - 1, h * ng_s - 1);
    ng_col(NG_BORDER, 1);
    gfx_roundrect(X(x), Y(y), w * ng_s, h * ng_s, 4 * ng_s, 1);
    ng_font(1, 7, 1);
    ng_col(NG_MUTED, 1);
    ng_txt(label, x + 8, y + 11, 0, 1.2);
    ng_font(5, 15, 1);
    ng_col(NG_TEXT, 1);
    ng_txt(value, x + 8, y + 31, 0, 0);
  );

  // horizontal bar meter from -1 to +1 at design (x, y, w, h), filled from the centre to v,
  // with ticks at every half and end labels
  function sc_bar(x, y, w, h, label, v, lo_txt, mid_txt, hi_txt) local(cx, vx, i)
  (
    ng_font(1, 7, 1);
    ng_col(NG_MUTED, 1);
    ng_txt(label, x, y - 8, 0, 1.2);
    ng_col(NG_BG, 1);
    gfx_rect(X(x), Y(y), w * ng_s, h * ng_s);
    ng_col(NG_BORDER, 1);
    i = 0;
    loop(5, gfx_rect(X(x + w * i / 4) - (i == 4), Y(y), 1, h * ng_s); i += 1;);
    cx = X(x + w / 2);
    vx = X(x + w * (v + 1) / 2);
    ng_col(NG_ACCENT, 0.75);
    gfx_rect(min(cx, vx), Y(y + 2), abs(vx - cx), (h - 4) * ng_s);
    ng_col(NG_TEXT, 1);
    gfx_rect(vx - ng_s, Y(y - 2), 2 * ng_s, (h + 4) * ng_s);
    ng_font(4, 7.5, 0);
    ng_col(NG_MUTED, 1);
    ng_txt(lo_txt, x, y + h + 9, 0, 0);
    ng_txt(mid_txt, x + w / 2, y + h + 9, 1, 0);
    ng_txt(hi_txt, x + w, y + h + 9, 2, 0);
  );

  function update()
  (
    sc_k = 1 - exp(-1 / (slider4 / 1000 * srate));
    sc_mon = slider5;
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 7;

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 0); ng_slider_set(2, 1); ng_slider_set(3, 50); ng_slider_set(4, 300); ng_slider_set(5, 0); );
    p == 1 ? ( ng_slider_set(1, 0); ng_slider_set(2, 1); ng_slider_set(3, 20); ng_slider_set(4, 100); ng_slider_set(5, 0); );
    p == 2 ? ( ng_slider_set(1, 0); ng_slider_set(2, 1); ng_slider_set(3, 80); ng_slider_set(4, 2000); ng_slider_set(5, 0); );
    p == 3 ? ( ng_slider_set(1, 12); ng_slider_set(2, 0); ng_slider_set(3, 60); ng_slider_set(4, 300); ng_slider_set(5, 0); );
    p == 4 ? ( ng_slider_set(1, -6); ng_slider_set(2, 0); ng_slider_set(3, 40); ng_slider_set(4, 300); ng_slider_set(5, 0); );
    p == 5 ? ( ng_slider_set(1, 0); ng_slider_set(2, 1); ng_slider_set(3, 50); ng_slider_set(4, 300); ng_slider_set(5, 1); );
    p == 6 ? ( ng_slider_set(1, 0); ng_slider_set(2, 1); ng_slider_set(3, 50); ng_slider_set(4, 300); ng_slider_set(5, 2); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 1) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 300) && ng_pre_eq(slider5, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 1) && ng_pre_eq(slider3, 20) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 1) && ng_pre_eq(slider3, 80) && ng_pre_eq(slider4, 2000) && ng_pre_eq(slider5, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 12) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 60) && ng_pre_eq(slider4, 300) && ng_pre_eq(slider5, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, -6) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 40) && ng_pre_eq(slider4, 300) && ng_pre_eq(slider5, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 1) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 300) && ng_pre_eq(slider5, 1) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 1) && ng_pre_eq(slider3, 50) && ng_pre_eq(slider4, 300) && ng_pre_eq(slider5, 2) ? m = 6;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Fast Response";
    p == 2 ? s = "Slow Averaging";
    p == 3 ? s = "Quiet Source Zoom";
    p == 4 ? s = "Hot Master View";
    p == 5 ? s = "Mono Check";
    p == 6 ? s = "Side Listen";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  sc_dl = spl0;
  sc_dr = spl1;
  sc_ll += sc_k * (sc_dl * sc_dl - sc_ll);
  sc_rr += sc_k * (sc_dr * sc_dr - sc_rr);
  sc_lr += sc_k * (sc_dl * sc_dr - sc_lr);
  abs(sc_ll) < 0.000000000000000000001 ? sc_ll = 0;
  abs(sc_rr) < 0.000000000000000000001 ? sc_rr = 0;
  abs(sc_lr) < 0.000000000000000000001 ? sc_lr = 0;

  sc_mon == 1 ? (
    sc_o = (spl0 + spl1) * 0.5;
    spl0 = sc_o;
    spl1 = sc_o;
  ) : sc_mon == 2 ? (
    sc_o = (spl0 - spl1) * 0.5;
    spl0 = sc_o;
    spl1 = sc_o;
  );

  // display only (reads the signal, never changes it); the input, before Monitor folds it
  sc_rb[sc_rw * 2] = sc_dl;
  sc_rb[sc_rw * 2 + 1] = sc_dr;
  sc_rw += 1;
  sc_rw >= SC_N ? sc_rw = 0;
  abs(sc_dl) > sc_pl ? sc_pl = abs(sc_dl) : sc_pl *= sc_prel;
  abs(sc_dr) > sc_pr ? sc_pr = abs(sc_dr) : sc_pr *= sc_prel;
  sc_hc += 1;
  sc_hc >= sc_hper ? (
    sc_hc = 0;
    sc_hb[sc_hw] = sc_corr();
    sc_hw += 1;
    sc_hw >= 150 ? sc_hw = 0;
    sc_hn = min(150, sc_hn + 1);
  );

@gfx 600 474
  ng_knobs_begin("STEREO SCOPE", "ADVANCED", 600, 300, 1, 0);

  // ---- goniometer: L/R rotated 45 degrees (mid up, side across), newest samples brightest --------
  sc_cx = X(167); sc_cy = Y(204); sc_rad = 135 * ng_s;
  ng_col(NG_BG2, 1);
  gfx_circle(sc_cx, sc_cy, sc_rad, 1, 1);
  ng_col(NG_BORDER, 1);
  gfx_circle(sc_cx, sc_cy, sc_rad, 0, 1);
  ng_col(NG_BORDER, 0.6);
  gfx_circle(sc_cx, sc_cy, sc_rad * 0.5, 0, 1);
  gfx_line(sc_cx - sc_rad * 0.7071, sc_cy - sc_rad * 0.7071, sc_cx + sc_rad * 0.7071, sc_cy + sc_rad * 0.7071, 1);
  gfx_line(sc_cx + sc_rad * 0.7071, sc_cy - sc_rad * 0.7071, sc_cx - sc_rad * 0.7071, sc_cy + sc_rad * 0.7071, 1);
  ng_col(0x45433f, 1);
  gfx_line(sc_cx, sc_cy - sc_rad, sc_cx, sc_cy + sc_rad, 0);
  gfx_line(sc_cx - sc_rad, sc_cy, sc_cx + sc_rad, sc_cy, 0);
  ng_font(1, 7.5, 1);
  ng_col(NG_MUTED, 1);
  ng_txt("L", 167 - 108, 204 - 108, 1, 0);
  ng_txt("R", 167 + 108, 204 - 108, 1, 0);
  ng_txt("M", 167 + 9, 204 - 127, 1, 0);
  ng_txt("S", 167 + 127, 204 - 9, 1, 0);

  // scope gain: Auto follows the peak of what is drawn (fast down, slow up), else the knob
  sc_n = 1024 + floor(slider3 / 100 * 7168);
  sc_pk = 0;
  sc_i = 0;
  loop(sc_n,
    sc_k2 = (sc_rw - 1 - sc_i + SC_N) % SC_N;
    sc_l = sc_rb[sc_k2 * 2]; sc_r = sc_rb[sc_k2 * 2 + 1];
    sc_pk = max(sc_pk, max(abs(sc_l + sc_r), abs(sc_r - sc_l)) * 0.7071);
    sc_i += 1;
  );
  sc_t = sc_pk > 0.0001 ? max(0.25, min(64, 0.85 / sc_pk)) : 1;
  sc_t < sc_ag ? sc_ag = sc_t : sc_ag += (sc_t - sc_ag) * 0.08;
  sc_g = slider2 ? sc_ag : 10 ^ (slider1 / 20);

  // the samples, oldest first in 4 age bands
  sc_dot = max(1, ng_s);
  sc_b = 0;
  loop(4,
    ng_col(NG_ACCENT, sc_b == 0 ? 0.1 : sc_b == 1 ? 0.2 : sc_b == 2 ? 0.36 : 0.6);
    sc_i = floor(sc_n * (4 - sc_b) / 4) - 1;
    sc_i1 = floor(sc_n * (3 - sc_b) / 4);
    while (sc_i >= sc_i1) (
      sc_k2 = (sc_rw - 1 - sc_i + SC_N) % SC_N;
      sc_l = sc_rb[sc_k2 * 2] * sc_g; sc_r = sc_rb[sc_k2 * 2 + 1] * sc_g;
      sc_x = max(-1, min(1, (sc_r - sc_l) * 0.7071));
      sc_y = max(-1, min(1, (sc_l + sc_r) * 0.7071));
      gfx_rect(sc_cx + sc_x * sc_rad - sc_dot / 2, sc_cy - sc_y * sc_rad - sc_dot / 2, sc_dot, sc_dot);
      sc_i -= 1;
    );
    sc_b += 1;
  );
  ng_font(4, 7.5, 0);
  ng_col(NG_MUTED, 1);
  sc_gdb = 20 * log10(sc_g);
  slider2 ? sprintf(#sc_t, "AUTO %+.1f dB", sc_gdb) : sprintf(#sc_t, "GAIN %+.1f dB", sc_gdb);
  ng_txt(#sc_t, 32, 336, 0, 0);

  // ---- readouts ---------------------------------------------------------------------------------
  sc_c = sc_corr();
  sc_live = sc_ll + sc_rr > 0.0000000001;
  sc_live ? sprintf(#sc_v, "%+.2f", sc_c) : strcpy(#sc_v, "--");
  sc_tile(318, 66, 80, 46, "CORRELATION", #sc_v);
  sc_mm = (sc_ll + sc_rr + 2 * sc_lr) / 4;
  sc_ss = max(0, (sc_ll + sc_rr - 2 * sc_lr) / 4);
  sc_live ? (
    sc_w = sc_mm > 0.0000000001 ? min(999, 100 * sqrt(sc_ss / sc_mm)) : 999;
    sprintf(#sc_v, "%d%%", floor(sc_w + 0.5));
  ) : strcpy(#sc_v, "--");
  sc_tile(403, 66, 80, 46, "WIDTH", #sc_v);
  sc_live ? (
    sc_bal = sc_ll <= 0 ? 60 : sc_rr <= 0 ? -60 : max(-60, min(60, 10 * log10(sc_rr / sc_ll)));
    abs(sc_bal) < 0.05 ? strcpy(#sc_v, "C") : sc_bal > 0 ? sprintf(#sc_v, "R %.1f", sc_bal) : sprintf(#sc_v, "L %.1f", -sc_bal);
  ) : (
    sc_bal = 0;
    strcpy(#sc_v, "--");
  );
  sc_tile(488, 66, 80, 46, "BALANCE", #sc_v);

  // ---- meters -------------------------------------------------------------------------------------
  sc_bar(318, 138, 250, 10, "CORRELATION", sc_c, "-1", "0", "+1");
  sc_bp = sc_live ? (sc_rr - sc_ll) / (sc_rr + sc_ll) : 0;
  sc_bar(318, 182, 250, 10, "BALANCE", sc_bp, "L", "C", "R");
  ng_meter(318, 214, 250, 7, "L", ng_to_db(sc_pl), -140, -60);
  ng_meter(318, 228, 250, 7, "R", ng_to_db(sc_pr), -140, -60);

  // ---- correlation history (5 s, newest on the right) ---------------------------------------
  ng_plot(336, 254, 232, 82);
  ng_grid(5, 4, 0);
  ng_col(0x45433f, 1);
  gfx_line(ng_px, floor(ng_py + ng_ph / 2) + 0.5, ng_px + ng_pw, floor(ng_py + ng_ph / 2) + 0.5, 0);
  ng_font(4, 7.5, 0);
  ng_col(NG_MUTED, 1);
  ng_ptxt("+1", ng_px - 5 * ng_s, ng_py, 2);
  ng_ptxt("0", ng_px - 5 * ng_s, ng_py + ng_ph / 2, 2);
  ng_ptxt("-1", ng_px - 5 * ng_s, ng_py + ng_ph, 2);
  ng_col(NG_ACCENT, 1);
  sc_i = 150 - sc_hn;
  while (sc_i < 150) (
    sc_k2 = (sc_hw - 150 + sc_i + 150) % 150;
    sc_x = ng_px + ng_pw * sc_i / 149;
    sc_y = ng_lin_y(sc_hb[sc_k2], -1, 1);
    sc_i == 150 - sc_hn ? ng_line_start(sc_x, sc_y) : ng_line_to(sc_x, sc_y);
    sc_i += 1;
  );

  ng_row(5);
  slider2 ? strcpy(#v1, "AUTO") : sprintf(#v1, "%+.1f dB", slider1);
  ng_knob_ctl(1, "GAIN", #v1, -12, 24, 0, 0.5, 0) ? update();
  ng_select_ctl(2, "AUTO", "OFF|ON", 0) ? update();
  sprintf(#v3, "%d%%", slider3);
  ng_knob_ctl(3, "DECAY", #v3, 0, 100, 50, 1, 0) ? update();
  sprintf(#v4, "%d ms", slider4);
  ng_knob_ctl_log(4, "INTEGRATION", #v4, 50, 3000, 300, 10) ? update();
  ng_select_ctl(5, "MONITOR", "STEREO|MONO|SIDE", 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
