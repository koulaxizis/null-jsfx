desc:NULL Loudness Meter GFX
author: Christos Koulaxizis
tags: loudness meter lufs lra true peak ebu r128 itu bs1770 metering analyzer mastering streaming gui
//category: Advanced
//NULL JSFX v2.4 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:0<0,2,1{-14 LUFS,-16 LUFS,-23 LUFS}>-Target
slider2:0<0,1,1{EBU +9,EBU +18}>-Scale
slider3:1<0,3,1{10 s,30 s,1 min,5 min}>-History
slider4:0<0,1,1{Off,On Play}>-Auto Reset
slider5:0<0,1,1{Reset,Reset}>-Reset
slider6:0<0,1,1{Stereo,Mono}>-Monitor

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  // NULL Loudness Meter (../loudness_meter.jsfx) with its own interface: same audio code, plus @gfx.
  // ITU-R BS.1770-4 / EBU R128 loudness meter. The audio passes through untouched (Monitor
  // Mono only folds it to mono for listening); everything below is measurement in doubles:
  //   K-weighting (high shelf + high pass, designed for the session's sample rate),
  //   100 ms sub-blocks of the summed channel energies,
  //   momentary = last 400 ms, short-term = last 3 s, both updated every 100 ms,
  //   integrated = 400 ms blocks every 100 ms, gated at -70 LUFS and -10 LU below their mean,
  //   loudness range (EBU Tech 3342) = 95th - 10th percentile of the short-term values, gated
  //   at -70 LUFS and -20 LU,
  //   sample peak and true peak (4x oversampled with the BS.1770-4 Annex 2 interpolator).
  // Integrated and LRA keep 0.01 LU histograms (count and energy per bin) so they run for
  // hours in constant memory. @gfx shows the readouts and the loudness history.
  ext_noinit = 1;              // REAPER must not restart the measurement at every play

  lm_sb = 0;                   // 30 sub-block energies (ring)
  lm_hs = 64;                  // short-term history, 3000 x 100 ms
  lm_hm = 3064;                // momentary history, 3000 x 100 ms
  LM_NB = 9000;                // histogram bins: 0.01 LU from -70 LUFS
  lm_ic = 6100;                // integrated: block count per bin
  lm_ie = lm_ic + LM_NB;       // integrated: block energy sum per bin
  lm_rc = lm_ie + LM_NB;       // LRA: short-term block count per bin
  lm_tc = lm_rc + LM_NB;       // true peak: 4 phases x 12 taps
  lm_xl = lm_tc + 48;          // true peak input history, 24 slots per channel (12, mirrored)
  lm_xr = lm_xl + 24;
  freembuf(lm_xr + 24);
  memset(0, 0, lm_xr + 24);

  // K-weighting at this sample rate (the BS.1770 48 kHz filters re-derived, as in libebur128)
  lm_k = tan($pi * 1681.974450955533 / srate);
  lm_vh = 10 ^ (3.999843853973347 / 20);
  lm_vb = lm_vh ^ 0.4996667741545416;
  lm_q = 0.7071752369554196;
  lm_a0 = 1 + lm_k / lm_q + lm_k * lm_k;
  lm_b0 = (lm_vh + lm_vb * lm_k / lm_q + lm_k * lm_k) / lm_a0;
  lm_b1 = 2 * (lm_k * lm_k - lm_vh) / lm_a0;
  lm_b2 = (lm_vh - lm_vb * lm_k / lm_q + lm_k * lm_k) / lm_a0;
  lm_a1 = 2 * (lm_k * lm_k - 1) / lm_a0;
  lm_a2 = (1 - lm_k / lm_q + lm_k * lm_k) / lm_a0;
  lm_k = tan($pi * 38.13547087602444 / srate);
  lm_q = 0.5003270373238773;
  lm_c0 = 1 + lm_k / lm_q + lm_k * lm_k;
  lm_c1 = 2 * (lm_k * lm_k - 1) / lm_c0;
  lm_c2 = (1 - lm_k / lm_q + lm_k * lm_k) / lm_c0;
  lm_z1l = lm_z2l = lm_z3l = lm_z4l = 0;
  lm_z1r = lm_z2r = lm_z3r = lm_z4r = 0;

  // true-peak interpolator, BS.1770-4 Annex 2
  lm_i = 0;
  loop(48,
    lm_tc[lm_i] =
      lm_i ==  0 ?  0.0017089843750 : lm_i ==  1 ?  0.0109863281250 : lm_i ==  2 ? -0.0196533203125 :
      lm_i ==  3 ?  0.0332031250000 : lm_i ==  4 ? -0.0594482421875 : lm_i ==  5 ?  0.1373291015625 :
      lm_i ==  6 ?  0.9721679687500 : lm_i ==  7 ? -0.1022949218750 : lm_i ==  8 ?  0.0476074218750 :
      lm_i ==  9 ? -0.0266113281250 : lm_i == 10 ?  0.0148925781250 : lm_i == 11 ? -0.0083007812500 :
      lm_i == 12 ? -0.0291748046875 : lm_i == 13 ?  0.0292968750000 : lm_i == 14 ? -0.0517578125000 :
      lm_i == 15 ?  0.0891113281250 : lm_i == 16 ? -0.1665039062500 : lm_i == 17 ?  0.4650878906250 :
      lm_i == 18 ?  0.7797851562500 : lm_i == 19 ? -0.2003173828125 : lm_i == 20 ?  0.1015625000000 :
      lm_i == 21 ? -0.0582275390625 : lm_i == 22 ?  0.0330810546875 : lm_i == 23 ? -0.0189208984375 :
      lm_tc[47 - lm_i];   // phases 2 and 3 are phases 1 and 0 reversed
    lm_i += 1;
  );
  lm_tw = 0;

  lm_n = floor(srate * 0.1 + 0.5);   // samples per 100 ms sub-block
  lm_acc = 0;
  lm_cnt = 0;
  lm_sbw = 0;
  lm_was_play = 0;
  lm_rst_last = slider5;

  // loudness of a mean-square energy, -200 for silence
  function lm_db(p) ( p > 0 ? -0.691 + 10 * log10(p) : -200; );

  // clears integrated, LRA, maxima and the history (momentary and short-term keep running)
  function lm_reset()
  (
    memset(lm_ic, 0, 3 * LM_NB);
    lm_blocks = 0;
    lm_abs_sum = lm_abs_n = lm_ihi = 0;
    lm_st_sum = lm_st_n = lm_rhi = 0;
    lm_int = -200;
    lm_lra = 0;
    lm_mmax = lm_smax = -200;
    lm_tpmax = lm_spmax = 0;
    lm_hw = lm_hn = 0;
  );

  // every 100 ms: momentary, short-term, gating blocks, integrated, LRA, history
  function lm_subblock() local(k, s, b, rel, sum, cnt, n, lo, hi, cum, ilo, ihi)
  (
    lm_sb[lm_sbw] = lm_acc;
    lm_acc = 0;
    lm_sbw += 1;
    lm_sbw >= 30 ? lm_sbw = 0;
    lm_blocks += 1;

    // newest sub-block first: 4 for momentary, 30 for short-term
    s = 0;
    k = lm_sbw;
    loop(4, k -= 1; k < 0 ? k += 30; s += lm_sb[k];);
    lm_mp = s / (4 * lm_n);
    loop(26, k -= 1; k < 0 ? k += 30; s += lm_sb[k];);
    lm_stp = s / (30 * lm_n);
    lm_m = lm_db(lm_mp);
    lm_s = lm_db(lm_stp);

    // integrated: a 400 ms gating block every 100 ms
    lm_blocks >= 4 && lm_m > -70 ? (
      b = min(LM_NB - 1, floor((lm_m + 70) * 100));
      lm_ic[b] += 1;
      lm_ie[b] += lm_mp;
      b >= lm_ihi ? lm_ihi = b + 1;
      lm_abs_sum += lm_mp;
      lm_abs_n += 1;
      rel = lm_db(lm_abs_sum / lm_abs_n) - 10;
      b = max(0, floor((rel + 70) * 100));
      sum = cnt = 0;
      while (b < lm_ihi) ( sum += lm_ie[b]; cnt += lm_ic[b]; b += 1; );
      lm_int = cnt > 0 ? lm_db(sum / cnt) : -200;
    );

    // loudness range: the short-term value every 100 ms once 3 s have been measured
    lm_blocks >= 30 && lm_s > -70 ? (
      b = min(LM_NB - 1, floor((lm_s + 70) * 100));
      lm_rc[b] += 1;
      b >= lm_rhi ? lm_rhi = b + 1;
      lm_st_sum += lm_stp;
      lm_st_n += 1;
      rel = lm_db(lm_st_sum / lm_st_n) - 20;
      b = max(0, floor((rel + 70) * 100));
      n = 0;
      k = b;
      while (k < lm_rhi) ( n += lm_rc[k]; k += 1; );
      n > 0 ? (
        lo = floor((n - 1) * 0.1 + 0.5);
        hi = floor((n - 1) * 0.95 + 0.5);
        cum = 0;
        ilo = ihi = -1;
        k = b;
        while (k < lm_rhi && ihi < 0) (
          cum += lm_rc[k];
          ilo < 0 && cum > lo ? ilo = k;
          ihi < 0 && cum > hi ? ihi = k;
          k += 1;
        );
        lm_lra = (ihi - ilo) / 100;
      );
    );

    lm_m > lm_mmax ? lm_mmax = lm_m;
    lm_s > lm_smax ? lm_smax = lm_s;
    lm_hs[lm_hw] = lm_s;
    lm_hm[lm_hw] = lm_m;
    lm_hw += 1;
    lm_hw >= 3000 ? lm_hw = 0;
    lm_hn = min(3000, lm_hn + 1);
  );

  lm_reset();
  lm_m = lm_s = -200;
  gfx_ext_retina = 1;

  function update()
  (
    lm_target = slider1 == 0 ? -14 : (slider1 == 1 ? -16 : -23);
    lm_mono = slider6;
    slider5 != lm_rst_last ? (
      lm_rst_last = slider5;
      lm_reset();
    );
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 7;

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, 1); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 0); );
    p == 1 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, 2); ng_slider_set(4, 1); ng_slider_set(5, 0); ng_slider_set(6, 0); );
    p == 2 ? ( ng_slider_set(1, 2); ng_slider_set(2, 1); ng_slider_set(3, 3); ng_slider_set(4, 1); ng_slider_set(5, 0); ng_slider_set(6, 0); );
    p == 3 ? ( ng_slider_set(1, 1); ng_slider_set(2, 0); ng_slider_set(3, 3); ng_slider_set(4, 1); ng_slider_set(5, 0); ng_slider_set(6, 0); );
    p == 4 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 0); );
    p == 5 ? ( ng_slider_set(1, 1); ng_slider_set(2, 1); ng_slider_set(3, 3); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 0); );
    p == 6 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, 1); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 1); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 2) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 1) && ng_pre_eq(slider3, 3) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 3) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 1) && ng_pre_eq(slider3, 3) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 0) && ng_pre_eq(slider3, 1) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 1) ? m = 6;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Streaming Master";
    p == 2 ? s = "Broadcast R128";
    p == 3 ? s = "Podcast Episode";
    p == 4 ? s = "Quick Mix Check";
    p == 5 ? s = "Long Form Monitor";
    p == 6 ? s = "Mono Fold Check";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@block
  lm_play = play_state == 1 || play_state == 5;
  lm_play && !lm_was_play && slider4 ? lm_reset();
  lm_was_play = lm_play;

@sample
  // K-weighting, transposed direct form II: shelf (b, a) then high pass (1, -2, 1 / c)
  lm_x = spl0;
  lm_y = lm_b0 * lm_x + lm_z1l;
  lm_z1l = lm_b1 * lm_x - lm_a1 * lm_y + lm_z2l;
  lm_z2l = lm_b2 * lm_x - lm_a2 * lm_y;
  lm_kl = lm_y + lm_z3l;
  lm_z3l = -2 * lm_y - lm_c1 * lm_kl + lm_z4l;
  lm_z4l = lm_y - lm_c2 * lm_kl;

  lm_x = spl1;
  lm_y = lm_b0 * lm_x + lm_z1r;
  lm_z1r = lm_b1 * lm_x - lm_a1 * lm_y + lm_z2r;
  lm_z2r = lm_b2 * lm_x - lm_a2 * lm_y;
  lm_kr = lm_y + lm_z3r;
  lm_z3r = -2 * lm_y - lm_c1 * lm_kr + lm_z4r;
  lm_z4r = lm_y - lm_c2 * lm_kr;

  lm_acc += lm_kl * lm_kl + lm_kr * lm_kr;

  // sample peak and true peak (newest input at lm_tw, mirrored 12 slots on so taps read straight)
  lm_tw -= 1;
  lm_tw < 0 ? lm_tw = 11;
  lm_xl[lm_tw] = lm_xl[lm_tw + 12] = spl0;
  lm_xr[lm_tw] = lm_xr[lm_tw + 12] = spl1;
  lm_pk = max(abs(spl0), abs(spl1));
  lm_pk > lm_spmax ? lm_spmax = lm_pk;
  lm_ph = 0;
  loop(4,
    lm_al = lm_ar = 0;
    lm_j = 0;
    loop(12,
      lm_al += lm_tc[lm_ph + lm_j] * lm_xl[lm_tw + lm_j];
      lm_ar += lm_tc[lm_ph + lm_j] * lm_xr[lm_tw + lm_j];
      lm_j += 1;
    );
    lm_pk = max(lm_pk, max(abs(lm_al), abs(lm_ar)));
    lm_ph += 12;
  );
  lm_pk > lm_tpmax ? lm_tpmax = lm_pk;

  lm_cnt += 1;
  lm_cnt >= lm_n ? (
    lm_cnt = 0;
    lm_subblock();
  );

  lm_mono ? (
    lm_o = (spl0 + spl1) * 0.5;
    spl0 = lm_o;
    spl1 = lm_o;
  );

@gfx 600 414
  ng_knobs_begin("LOUDNESS METER", "ADVANCED", 600, 240, 1, 0);

  // readout text for a loudness or peak value in dB ("-INF" below -100)
  function lm_fmt(v) ( v <= -100 ? strcpy(#lm_v, "-INF") : v > 0.05 ? sprintf(#lm_v, "+%.1f", v) : sprintf(#lm_v, "%.1f", v); );
  // readout tile: background box, label, value, unit
  function lm_tile(x, y, w, h, label, value, unit, big)
  (
    ng_col(NG_BG, 1);
    gfx_roundrect(X(x), Y(y), w * ng_s, h * ng_s, 4 * ng_s, 1);
    gfx_rect(X(x) + 1, Y(y) + 1, w * ng_s - 1, h * ng_s - 1);
    ng_col(NG_BORDER, 1);
    gfx_roundrect(X(x), Y(y), w * ng_s, h * ng_s, 4 * ng_s, 1);
    ng_font(1, 7, 1);
    ng_col(NG_MUTED, 1);
    ng_txt(label, x + 8, y + 11, 0, 1.2);
    ng_txt(unit, x + w - 8, y + 11, 2, 1);
    ng_font(5, big ? 26 : 15, 1);
    ng_col(NG_TEXT, 1);
    ng_txt(value, x + 8, y + (big ? 38 : 31), 0, 0);
  );

  // readouts: integrated on top, then momentary / short-term, LRA / true peak, maxima
  lm_fmt(lm_int);
  lm_tile(24, 62, 180, 72, "INTEGRATED", #lm_v, "LUFS", 1);
  ng_font(1, 7.5, 0);
  ng_col(NG_MUTED, 1);
  lm_int > -100 ? (
    lm_d = lm_int - lm_target;
    abs(lm_d) < 0.05 ? lm_d = 0;
    lm_d > 0 ? sprintf(#lm_t, "TARGET %d   +%.1f LU", lm_target, lm_d) : sprintf(#lm_t, "TARGET %d   %.1f LU", lm_target, lm_d);
  ) : sprintf(#lm_t, "TARGET %d LUFS", lm_target);
  ng_txt(#lm_t, 32, 122, 0, 0.5);
  lm_fmt(lm_m);
  lm_tile(24, 138, 88, 46, "MOMENTARY", #lm_v, "", 0);
  lm_fmt(lm_s);
  lm_tile(116, 138, 88, 46, "SHORT-TERM", #lm_v, "", 0);
  sprintf(#lm_v, "%.1f", lm_lra);
  lm_tile(24, 188, 88, 46, "LRA", #lm_v, "LU", 0);
  lm_fmt(lm_tpmax > 0 ? 20 * log10(lm_tpmax) : -200);
  lm_tile(116, 188, 88, 46, "TP MAX", #lm_v, "DBTP", 0);
  lm_fmt(lm_mmax);
  lm_tile(24, 238, 88, 46, "MAX M", #lm_v, "", 0);
  lm_fmt(lm_smax);
  lm_tile(116, 238, 88, 46, "MAX S", #lm_v, "", 0);

  // history: short-term (silver) and momentary (grey) on the EBU +9 / +18 scale around the target
  lm_hi = slider2 ? lm_target + 18 : lm_target + 9;
  lm_lo = slider2 ? lm_target - 36 : lm_target - 18;
  lm_st = slider2 ? 6 : 3;
  ng_plot(240, 68, 330, 196);
  ng_grid(5, 9, 0);
  ng_font(4, 8, 0);
  lm_v = lm_lo;
  loop(10,
    lm_gy = floor(ng_lin_y(lm_v, lm_lo, lm_hi)) + 0.5;
    lm_v == lm_target ? (
      ng_col(0x45433f, 1);
      gfx_line(ng_px, lm_gy, ng_px + ng_pw, lm_gy, 0);
    );
    ng_col(lm_v == lm_target ? NG_TEXT : NG_MUTED, 1);
    sprintf(#lm_t, "%d", lm_v);
    ng_ptxt(#lm_t, ng_px - 5 * ng_s, lm_gy, 2);
    lm_v += lm_st;
  );
  lm_secs = slider3 == 0 ? 10 : slider3 == 1 ? 30 : slider3 == 2 ? 60 : 300;
  ng_col(NG_MUTED, 1);
  lm_c = 0;
  loop(6,
    lm_a = lm_secs * (5 - lm_c) / 5;
    lm_a == 0 ? strcpy(#lm_t, "NOW") : lm_a >= 60 ? sprintf(#lm_t, "-%d MIN", lm_a / 60) : sprintf(#lm_t, "-%d S", lm_a);
    ng_ptxt(#lm_t, ng_px + ng_pw * lm_c / 5, ng_py + ng_ph + 10 * ng_s, lm_c == 0 ? 0 : lm_c == 5 ? 2 : 1);
    lm_c += 1;
  );
  // integrated as a line
  lm_int > lm_lo && lm_int < lm_hi ? (
    ng_col(NG_TEXT, 0.45);
    lm_gy = floor(ng_lin_y(lm_int, lm_lo, lm_hi)) + 0.5;
    gfx_line(ng_px, lm_gy, ng_px + ng_pw, lm_gy, 0);
  );

  // n points over the width (oldest left, newest right); more points than columns are
  // reduced to the loudest per column. Pass 0 = momentary, 1 = short-term.
  lm_np = lm_secs * 10;
  lm_cols = 330;
  lm_pass = 0;
  loop(2,
    lm_buf = lm_pass ? lm_hs : lm_hm;
    lm_pass ? ng_col(NG_ACCENT, 1) : ng_col(NG_MUTED, 0.7);
    lm_first = 1;
    lm_np <= lm_cols ? (
      lm_gi = max(0, lm_np - lm_hn);
      while (lm_gi < lm_np) (
        lm_gk = lm_hw - lm_np + lm_gi;
        lm_gk < 0 ? lm_gk += 3000;
        lm_gx = ng_px + ng_pw * lm_gi / (lm_np - 1);
        lm_gy = ng_lin_y(lm_buf[lm_gk], lm_lo, lm_hi);
        lm_first ? ng_line_start(lm_gx, lm_gy) : lm_pass ? ng_line_to(lm_gx, lm_gy) : gfx_line(lm_lx, lm_ly, lm_gx, lm_gy, 1);
        lm_lx = lm_gx; lm_ly = lm_gy;
        lm_first = 0;
        lm_gi += 1;
      );
    ) : (
      lm_c = 0;
      loop(lm_cols,
        lm_gi = floor(lm_c * lm_np / lm_cols);
        lm_gi1 = floor((lm_c + 1) * lm_np / lm_cols);
        lm_gi = max(lm_gi, lm_np - lm_hn);
        lm_gi < lm_gi1 ? (
          lm_v = -200;
          while (lm_gi < lm_gi1) (
            lm_gk = lm_hw - lm_np + lm_gi;
            lm_gk < 0 ? lm_gk += 3000;
            lm_v = max(lm_v, lm_buf[lm_gk]);
            lm_gi += 1;
          );
          lm_gx = ng_px + ng_pw * (lm_c + 0.5) / lm_cols;
          lm_gy = ng_lin_y(lm_v, lm_lo, lm_hi);
          lm_first ? ng_line_start(lm_gx, lm_gy) : lm_pass ? ng_line_to(lm_gx, lm_gy) : gfx_line(lm_lx, lm_ly, lm_gx, lm_gy, 1);
          lm_lx = lm_gx; lm_ly = lm_gy;
          lm_first = 0;
        );
        lm_c += 1;
      );
    );
    lm_pass += 1;
  );

  ng_row(6);
  ng_select_ctl(1, "TARGET", "-14 LUFS|-16 LUFS|-23 LUFS", 0) ? update();
  ng_select_ctl(2, "SCALE", "EBU +9|EBU +18", 0) ? update();
  ng_select_ctl(3, "HISTORY", "10 S|30 S|1 MIN|5 MIN", 0) ? update();
  ng_select_ctl(4, "AUTO RESET", "OFF|ON PLAY", 0) ? update();
  ng_select_ctl(5, "RESET", "RESET|RESET", 0) ? update();
  ng_select_ctl(6, "MONITOR", "STEREO|MONO", 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
