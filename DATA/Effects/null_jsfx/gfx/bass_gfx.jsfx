desc:NULL Bass GFX
author: Christos Koulaxizis
tags: instrument bass synth bass 808 sub saw square mono glide portamento acid filter drive phrase player key switch midi gui
//category: Instruments
//NULL JSFX v3.0 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:1<0,3,1{Sub,Saw,Square,808}>-Oscillator
slider2:0<-2,2,1>-Octave
slider3:0<0,50,1>-Detune (cents)
slider4:30<0,100,1>-Sub Level (%)
slider5:30<0,100,1>-Punch (%)
slider6:10<0,100,1>-Drive (%)
slider7:900<30,12000,1:log>-Cutoff (Hz)
slider8:20<0,100,1>-Resonance (%)
slider9:40<-100,100,1>-Env Amount (%)
slider10:250<5,3000,1:log>-Filter Decay (ms)
slider11:2<1,2000,1:log>-Attack (ms)
slider12:400<5,5000,1:log>-Decay (ms)
slider13:70<0,100,1>-Sustain (%)
slider14:80<5,5000,1:log>-Release (ms)
slider15:0<0,1,1{Legato,Always}>-Glide Mode
slider16:30<0,1000,1>-Glide (ms)
slider17:50<0,100,1>-Velocity (%)
slider18:0<0,8,1{Off,Eighths,Octaves,Offbeat,Gallop,Funk,Acid,Tresillo,Trap}>-Phrase
slider19:0<-24,12,0.1>-Volume (dB)

in_pin:none
out_pin:Left
out_pin:Right

@init
  // NULL Bass (../bass.jsfx) with its own interface: same audio code, plus @gfx.
  // A monophonic synth bass (no samples): one oscillator (Sub: a sine with a little second
  // harmonic, Saw and Square: band-limited with PolyBLEP, 808: a sine that drops in pitch at
  // every new note), an optional detuned twin (Detune), a sine one octave below (Sub Level),
  // a 24 dB low-pass (two state-variable stages) with its own decaying envelope, Drive (soft
  // clipping after the filter), an ADSR and Punch, a short boost at every new note (in 808
  // mode also the depth of the pitch drop). Last-note priority: a key pressed while another is
  // held glides to its pitch without a new attack (Glide Mode Legato), or every note glides
  // from the last pitch and starts again (Always); releasing a key goes back to the key still
  // held. Pitch bend: +-2 semitones.
  //
  // Phrase player: the keys below C2 (MIDI note 36) choose a phrase (C1 = 24 Off, C#1 to G#1
  // = phrases 1 to 8, the Phrase slider sets it too). While a phrase is chosen and a key from
  // C2 up is held, the bass plays the phrase in 16ths at the host's tempo (on the host's beat
  // while it plays, from the first key while it is stopped), on the last key held as root.
  // Phrase steps: '.' rest, '-' tie, else an interval: r root, o octave, f fifth, l fifth
  // below, d octave below, m minor third, q fourth, s minor seventh, n second; a = accent,
  // s = slide (the note before holds and glides into it).
  //
  // Memory: 0.. the MIDI of the block (4 per message), 2048.. the keys held (last = newest),
  // 2100.. the phrase steps (16 per phrase), 2300.. accents, 2500.. slides, 2700.. gates.
  ext_noinit = 1;
  ext_tail_size = -1;
  MQ = 0; HS = 2048; PN = 2100; PA = 2300; PS = 2500; PG = 2700;

  function ival(c)
  (
    c == 'r' ? 0 : c == 'o' ? 12 : c == 'f' ? 7 : c == 'l' ? -5 : c == 'd' ? -12 :
    c == 'm' ? 3 : c == 'q' ? 5 : c == 's' ? 10 : c == 'n' ? 2 : c == '-' ? -200 : -100;
  );
  function phr_set(k, notes, mods, gate) local(i, m)
  (
    i = 0;
    loop(16,
      m = str_getchar(mods, i);
      PN[k * 16 + i] = ival(str_getchar(notes, i));
      PA[k * 16 + i] = m == 'a' ? 1 : 0;
      PS[k * 16 + i] = m == 's' ? 1 : 0;
      i += 1;
    );
    PG[k] = gate;
  );
  phr_set(1, "r.r.r.r.r.r.r.r.", "a...a...a...a...", 0.7);  // Eighths
  phr_set(2, "r.o.r.o.r.o.r.o.", "a.......a.......", 0.55); // Octaves
  phr_set(3, "..r...r...r...r.", "................", 0.6);  // Offbeat
  phr_set(4, "r.rrr.rrr.rrr.rr", "a...a...a...a...", 0.65); // Gallop
  phr_set(5, "r..ro..rr.s.f.o.", "a...a.......a...", 0.45); // Funk
  phr_set(6, "rror.rfr.ormo.sr", "a.s..as..a.s..as", 0.5);  // Acid
  phr_set(7, "r..r..r.r..f..o.", "a..a..a.a..a..a.", 0.6);  // Tresillo
  phr_set(8, "r-------..r-o---", "a.........a.s...", 0.95); // Trap

  // band-limited square and saw corrections (PolyBLEP) at phase p with phase step dt
  function blep(t, dt)
  (
    t < dt ? ( t /= dt; t + t - t * t - 1; ) :
    t > 1 - dt ? ( t = (t - 1) / dt; t * t + t + t + 1; ) : 0;
  );
  function square(p, dt) local(q)
  (
    q = p + 0.5;
    q -= floor(q);
    (p < 0.5 ? 1 : -1) + blep(p, dt) - blep(q, dt);
  );
  function osc_wave(p, dt)
  (
    osc == 0 ? sin(2 * $pi * p) + 0.2 * sin(4 * $pi * p) :
    osc == 1 ? 2 * p - 1 - blep(p, dt) :
    osc == 2 ? square(p, dt) :
    sin(2 * $pi * p);
  );

  // ---- the voice ------------------------------------------------------------------------------
  // a note: retrig starts the envelopes again (from where they are), glide moves the pitch at
  // rate gc (else it jumps)
  function v_note(n, vel, retrig, glide, gc)
  (
    v_has && glide ? v_gc = gc : ( v_cur = n; v_gc = 1; );
    v_tgt = n;
    v_has = 1;
    retrig || v_stage == 0 || v_stage == 3 ? (
      v_env < 0.001 ? ( v_ph = 0; v_ph2 = 0.37; v_phs = 0; );
      v_stage = 1; v_fe = 1; v_pkt = 1; v_pe = 1;
      v_vg = 1 - vs * (1 - vel);
    );
    v_gate = 1;
  );
  function v_release()
  (
    v_gate = 0;
    v_stage > 0 ? v_stage = 3;
  );

  // ---- the keys held (a stack, the newest last) --------------------------------------------------
  function hs_remove(n) local(i)
  (
    i = 0;
    while (i < hn && HS[i] != n) ( i += 1; );
    i < hn ? (
      while (i < hn - 1) ( HS[i] = HS[i + 1]; i += 1; );
      hn -= 1;
    );
  );
  function hs_push(n) local(i)
  (
    hs_remove(n);
    hn >= 32 ? (
      i = 0;
      while (i < 31) ( HS[i] = HS[i + 1]; i += 1; );
      hn = 31;
    );
    HS[hn] = n;
    hn += 1;
  );

  // ---- the phrase player ------------------------------------------------------------------------
  // step s (16ths from the bar's start) of the phrase: a rest releases, a tie holds, a note plays
  // until its gate (or into the next note when that one slides); ph_rel is in 16ths
  function ph_step(s) local(i, b, iv, t, j, hold)
  (
    i = s - floor(s / 16) * 16;
    b = ph_sel * 16 + i;
    iv = PN[b];
    iv == -100 ? (
      ph_on ? ( ph_on = 0; v_release(); );
    ) : iv != -200 ? (
      t = 0;
      j = i + 1;
      while (j < 16 && PN[ph_sel * 16 + j] == -200) ( t += 1; j += 1; );
      hold = j < 16 && PS[ph_sel * 16 + j] > 0 && PN[ph_sel * 16 + j] > -100;
      ph_rel = hold ? s + 1 + t + 4 : s + (1 + t) * PG[ph_sel];
      ph_ival = iv;
      PS[b] > 0 && ph_on ? v_note(ph_root + iv, 0, 0, 1, sl_c)
                         : v_note(ph_root + iv, ph_vel * (PA[b] > 0 ? 1 : 0.78), 1, gmode, gl_c);
      ph_on = 1;
    );
  );
  // choose a phrase (0 = Off): a note playing stops, the keys still held start again
  function ph_set(k)
  (
    k != ph_sel ? (
      ph_sel = k;
      ph_on = 0;
      ph_s = -1000;
      v_release();
      hn > 0 ? (
        k == 0 ? ( v_key = HS[hn - 1]; v_note(v_key, lk_vel, 1, 0, 1); )
               : ( ph_root = HS[hn - 1]; ph_vel = lk_vel; ph_clock = 0; );
      );
    );
  );

  // ---- MIDI ------------------------------------------------------------------------------------
  function key_on(n, v) local(was, legato)
  (
    n < 36 ? (
      n >= 24 && n <= 32 ? ph_set(n - 24);
    ) : (
      was = hn;
      hs_push(n);
      lk_vel = v;
      ph_sel > 0 ? (
        ph_root = n;
        ph_vel = v;
        was == 0 ? (
          ph_s = -1000;
          ph_clock = 0;
        ) : ph_on ? (
          v_tgt = n + ph_ival;
          v_gc = gl_c;
        );
      ) : (
        legato = was > 0 && v_gate;
        v_key = n;
        gmode ? v_note(n, v, 1, 1, gl_c) : v_note(n, v, !legato, legato, gl_c);
      );
    );
  );
  function key_off(n)
  (
    n >= 36 ? (
      hs_remove(n);
      ph_sel > 0 ? (
        hn == 0 ? (
          ph_on ? v_release();
          ph_on = 0;
          ph_s = -1000;
        ) : (
          ph_root = HS[hn - 1];
          ph_on ? ( v_tgt = ph_root + ph_ival; v_gc = gl_c; );
        );
      ) : n == v_key ? (
        hn > 0 ? ( v_key = HS[hn - 1]; v_note(v_key, lk_vel, 0, 1, gl_c); ) : v_release();
      );
    );
  );
  function midi_ev(st, d1, d2) local(t)
  (
    t = st & 0xF0;
    t == 0x90 && d2 > 0 ? key_on(d1, d2 / 127) :
    t == 0x80 || t == 0x90 ? key_off(d1) :
    t == 0xB0 && (d1 == 123 || d1 == 120) ? ( hn = 0; ph_on = 0; ph_s = -1000; v_release(); ) :
    t == 0xE0 ? bend = (d2 * 128 + d1 - 8192) / 8192 * 2;
  );

  v_stage = 0; v_env = 0; v_gate = 0; v_has = 0; v_cur = v_tgt = 48; v_gc = 1;
  v_ph = v_ph2 = v_phs = 0; v_fe = v_pk = v_pkt = v_pe = 0; v_vg = 1; v_key = -1;
  f1s1 = f1s2 = f2s1 = f2s2 = 0;
  hn = 0; bend = 0; lk_vel = 0.8;
  ph_sel = 0; ph_last = -1; ph_s = -1000; ph_on = 0; ph_clock = 0; ph_root = 48; ph_vel = 0.8;
  ph_ival = 0; ph_rel = 0;
  bs_req = 0;
  m_ofs = m_1 = m_2 = m_3 = 0;

  gfx_ext_retina = 1;

  function bs_white(pc) ( pc == 0 || pc == 2 || pc == 4 || pc == 5 || pc == 7 || pc == 9 || pc == 11; );
  function bs_held(n) local(k, r) ( r = 0; k = 0; while (k < hn) ( HS[k] == n ? r = 1; k += 1; ); r; );
  function bs_ms(str, v) ( v >= 1000 ? sprintf(str, "%.2f s", v / 1000) : sprintf(str, "%d ms", v); );

  function update()
  (
    osc = floor(slider1 + 0.5);
    oct = floor(slider2 + 0.5);
    det_on = slider3 > 0;
    det_r = 2 ^ (slider3 / 1200);
    sub_l = slider4 / 100;
    punch = slider5 / 100;
    drop = 3 + 21 * punch;
    drv = slider6 / 100;
    drv_g = 1 + 8 * drv;
    drv_n = 1 / (1 + 0.6 * drv);
    cut = slider7;
    res = slider8 / 100;
    k1 = 1 / 0.541;
    k2 = 1 / (0.707 + 9 * res * res);
    env_oct = slider9 / 100 * 6;
    fdc = exp(-3 / (slider10 / 1000 * srate));
    a_inc = 1 / (slider11 / 1000 * srate);
    d_c = exp(-3 / (slider12 / 1000 * srate));
    sus = slider13 / 100;
    r_c = exp(-3 / (slider14 / 1000 * srate));
    gmode = slider15 >= 0.5;
    gl = slider16;
    gl_c = gl > 0 ? 1 - exp(-3 / (gl / 1000 * srate)) : 1;
    sl_c = 1 - exp(-3 / (max(gl, 60) / 1000 * srate));
    vs = slider17 / 100;
    vol = 10 ^ (slider19 / 20);
    pk_c = exp(-1 / (0.02 * srate));
    pa_c = 1 - exp(-1 / (0.0015 * srate));
    pe_c = exp(-1 / (0.035 * srate));
    // the Phrase slider when it moves (a key below C2 chooses one too)
    slider18 != ph_last ? ( ph_last = slider18; ph_set(max(0, min(8, floor(slider18 + 0.5)))); );
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 16;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1); ng_hist_add(2); ng_hist_add(3); ng_hist_add(4); ng_hist_add(5); ng_hist_add(6); ng_hist_add(7); ng_hist_add(8); ng_hist_add(9); ng_hist_add(10); ng_hist_add(11); ng_hist_add(12); ng_hist_add(13); ng_hist_add(14); ng_hist_add(15); ng_hist_add(16); ng_hist_add(17); ng_hist_add(18); ng_hist_add(19);
  ng_hist_init();

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 1); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 30); ng_slider_set(5, 30); ng_slider_set(6, 10); ng_slider_set(7, 900); ng_slider_set(8, 20); ng_slider_set(9, 40); ng_slider_set(10, 250); ng_slider_set(11, 2); ng_slider_set(12, 400); ng_slider_set(13, 70); ng_slider_set(14, 80); ng_slider_set(15, 0); ng_slider_set(16, 30); ng_slider_set(17, 50); ng_slider_set(18, 0); ng_slider_set(19, 0); );
    p == 1 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 40); ng_slider_set(5, 20); ng_slider_set(6, 0); ng_slider_set(7, 400); ng_slider_set(8, 20); ng_slider_set(9, 10); ng_slider_set(10, 250); ng_slider_set(11, 2); ng_slider_set(12, 400); ng_slider_set(13, 100); ng_slider_set(14, 120); ng_slider_set(15, 0); ng_slider_set(16, 30); ng_slider_set(17, 50); ng_slider_set(18, 0); ng_slider_set(19, 0); );
    p == 2 ? ( ng_slider_set(1, 1); ng_slider_set(2, 0); ng_slider_set(3, 25); ng_slider_set(4, 50); ng_slider_set(5, 30); ng_slider_set(6, 25); ng_slider_set(7, 700); ng_slider_set(8, 10); ng_slider_set(9, 20); ng_slider_set(10, 250); ng_slider_set(11, 5); ng_slider_set(12, 400); ng_slider_set(13, 100); ng_slider_set(14, 200); ng_slider_set(15, 0); ng_slider_set(16, 30); ng_slider_set(17, 50); ng_slider_set(18, 0); ng_slider_set(19, 0); );
    p == 3 ? ( ng_slider_set(1, 3); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 50); ng_slider_set(6, 30); ng_slider_set(7, 3000); ng_slider_set(8, 20); ng_slider_set(9, 0); ng_slider_set(10, 250); ng_slider_set(11, 2); ng_slider_set(12, 1800); ng_slider_set(13, 0); ng_slider_set(14, 300); ng_slider_set(15, 1); ng_slider_set(16, 80); ng_slider_set(17, 50); ng_slider_set(18, 0); ng_slider_set(19, 0); );
    p == 4 ? ( ng_slider_set(1, 3); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 70); ng_slider_set(6, 75); ng_slider_set(7, 5000); ng_slider_set(8, 20); ng_slider_set(9, 0); ng_slider_set(10, 250); ng_slider_set(11, 2); ng_slider_set(12, 2500); ng_slider_set(13, 0); ng_slider_set(14, 250); ng_slider_set(15, 1); ng_slider_set(16, 120); ng_slider_set(17, 50); ng_slider_set(18, 0); ng_slider_set(19, -2); );
    p == 5 ? ( ng_slider_set(1, 1); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 30); ng_slider_set(6, 40); ng_slider_set(7, 300); ng_slider_set(8, 80); ng_slider_set(9, 80); ng_slider_set(10, 180); ng_slider_set(11, 2); ng_slider_set(12, 400); ng_slider_set(13, 100); ng_slider_set(14, 30); ng_slider_set(15, 0); ng_slider_set(16, 60); ng_slider_set(17, 80); ng_slider_set(18, 6); ng_slider_set(19, 0); );
    p == 6 ? ( ng_slider_set(1, 1); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 40); ng_slider_set(5, 50); ng_slider_set(6, 10); ng_slider_set(7, 600); ng_slider_set(8, 20); ng_slider_set(9, 50); ng_slider_set(10, 120); ng_slider_set(11, 2); ng_slider_set(12, 350); ng_slider_set(13, 40); ng_slider_set(14, 40); ng_slider_set(15, 0); ng_slider_set(16, 0); ng_slider_set(17, 80); ng_slider_set(18, 5); ng_slider_set(19, 0); );
    p == 7 ? ( ng_slider_set(1, 2); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 20); ng_slider_set(5, 30); ng_slider_set(6, 10); ng_slider_set(7, 1200); ng_slider_set(8, 30); ng_slider_set(9, 60); ng_slider_set(10, 150); ng_slider_set(11, 2); ng_slider_set(12, 300); ng_slider_set(13, 20); ng_slider_set(14, 60); ng_slider_set(15, 0); ng_slider_set(16, 30); ng_slider_set(17, 50); ng_slider_set(18, 0); ng_slider_set(19, 0); );
    p == 8 ? ( ng_slider_set(1, 1); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 30); ng_slider_set(5, 30); ng_slider_set(6, 10); ng_slider_set(7, 1000); ng_slider_set(8, 25); ng_slider_set(9, 50); ng_slider_set(10, 120); ng_slider_set(11, 2); ng_slider_set(12, 400); ng_slider_set(13, 60); ng_slider_set(14, 40); ng_slider_set(15, 0); ng_slider_set(16, 0); ng_slider_set(17, 50); ng_slider_set(18, 2); ng_slider_set(19, 0); );
    p == 9 ? ( ng_slider_set(1, 3); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 0); ng_slider_set(5, 60); ng_slider_set(6, 40); ng_slider_set(7, 4000); ng_slider_set(8, 20); ng_slider_set(9, 0); ng_slider_set(10, 250); ng_slider_set(11, 2); ng_slider_set(12, 3000); ng_slider_set(13, 50); ng_slider_set(14, 200); ng_slider_set(15, 0); ng_slider_set(16, 120); ng_slider_set(17, 50); ng_slider_set(18, 8); ng_slider_set(19, 0); );
    p == 10 ? ( ng_slider_set(1, 1); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 20); ng_slider_set(5, 40); ng_slider_set(6, 50); ng_slider_set(7, 1500); ng_slider_set(8, 20); ng_slider_set(9, 30); ng_slider_set(10, 250); ng_slider_set(11, 2); ng_slider_set(12, 400); ng_slider_set(13, 80); ng_slider_set(14, 40); ng_slider_set(15, 0); ng_slider_set(16, 0); ng_slider_set(17, 50); ng_slider_set(18, 4); ng_slider_set(19, 0); );
    p == 11 ? ( ng_slider_set(1, 1); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 30); ng_slider_set(5, 30); ng_slider_set(6, 10); ng_slider_set(7, 800); ng_slider_set(8, 35); ng_slider_set(9, 60); ng_slider_set(10, 200); ng_slider_set(11, 2); ng_slider_set(12, 250); ng_slider_set(13, 30); ng_slider_set(14, 60); ng_slider_set(15, 0); ng_slider_set(16, 30); ng_slider_set(17, 50); ng_slider_set(18, 3); ng_slider_set(19, 0); );
    p == 12 ? ( ng_slider_set(1, 0); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 30); ng_slider_set(5, 40); ng_slider_set(6, 10); ng_slider_set(7, 900); ng_slider_set(8, 20); ng_slider_set(9, 40); ng_slider_set(10, 250); ng_slider_set(11, 2); ng_slider_set(12, 600); ng_slider_set(13, 50); ng_slider_set(14, 100); ng_slider_set(15, 0); ng_slider_set(16, 30); ng_slider_set(17, 50); ng_slider_set(18, 7); ng_slider_set(19, 0); );
    p == 13 ? ( ng_slider_set(1, 1); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 30); ng_slider_set(5, 30); ng_slider_set(6, 30); ng_slider_set(7, 1100); ng_slider_set(8, 20); ng_slider_set(9, 30); ng_slider_set(10, 250); ng_slider_set(11, 2); ng_slider_set(12, 400); ng_slider_set(13, 80); ng_slider_set(14, 50); ng_slider_set(15, 0); ng_slider_set(16, 30); ng_slider_set(17, 50); ng_slider_set(18, 1); ng_slider_set(19, 0); );
    p == 14 ? ( ng_slider_set(1, 2); ng_slider_set(2, 0); ng_slider_set(3, 0); ng_slider_set(4, 30); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 500); ng_slider_set(8, 20); ng_slider_set(9, 10); ng_slider_set(10, 250); ng_slider_set(11, 30); ng_slider_set(12, 400); ng_slider_set(13, 100); ng_slider_set(14, 300); ng_slider_set(15, 0); ng_slider_set(16, 30); ng_slider_set(17, 50); ng_slider_set(18, 0); ng_slider_set(19, 0); );
    p == 15 ? ( ng_slider_set(1, 1); ng_slider_set(2, -1); ng_slider_set(3, 12); ng_slider_set(4, 20); ng_slider_set(5, 30); ng_slider_set(6, 80); ng_slider_set(7, 1500); ng_slider_set(8, 50); ng_slider_set(9, 40); ng_slider_set(10, 250); ng_slider_set(11, 2); ng_slider_set(12, 400); ng_slider_set(13, 90); ng_slider_set(14, 80); ng_slider_set(15, 0); ng_slider_set(16, 30); ng_slider_set(17, 50); ng_slider_set(18, 0); ng_slider_set(19, -2); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
