  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Sub Bass";
    p == 2 ? s = "Reese";
    p == 3 ? s = "808 Boom";
    p == 4 ? s = "808 Distorted";
    p == 5 ? s = "Acid";
    p == 6 ? s = "Funk Finger";
    p == 7 ? s = "Square Pluck";
    p == 8 ? s = "Disco Octaves";
    p == 9 ? s = "Trap Glide";
    p == 10 ? s = "Rock Gallop";
    p == 11 ? s = "Offbeat House";
    p == 12 ? s = "Tresillo Pop";
    p == 13 ? s = "Eighths Driver";
    p == 14 ? s = "Soft Square";
    p == 15 ? s = "Growl";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@block
  // the MIDI of this block, played at its offsets in @sample
  mq_n = 0;
  while (midirecv(m_ofs, m_1, m_2, m_3)) (
    // every message goes on to the next plugin too, so instruments can be layered
    midisend(m_ofs, m_1, m_2, m_3);
    mq_n < 512 ? (
      MQ[mq_n * 4] = m_ofs;
      MQ[mq_n * 4 + 1] = m_1;
      MQ[mq_n * 4 + 2] = m_2;
      MQ[mq_n * 4 + 3] = m_3;
      mq_n += 1;
    );
  );
  mq_i = 0;
  playing = play_state & 1;
  b_inc = tempo / (60 * srate);
  b_0 = beat_position;
  si = 0;
  // a phrase chosen in the interface (GFX version)
  bs_req > 0 ? ( ph_set(bs_req - 1); bs_req = 0; );

@sample
  while (mq_i < mq_n && MQ[mq_i * 4] <= si) (
    midi_ev(MQ[mq_i * 4 + 1], MQ[mq_i * 4 + 2], MQ[mq_i * 4 + 3]);
    mq_i += 1;
  );

  // the phrase: a step plays when the position enters it (on the first key, also when the key
  // comes in the first half of the step)
  ph_sel > 0 && hn > 0 ? (
    bb = playing ? b_0 + si * b_inc : ph_clock;
    ph_clock = bb + b_inc;
    s = floor(bb * 4 + 0.000001);
    s != ph_s ? (
      ph_s > -1000 || bb * 4 - s < 0.5 ? ph_step(s);
      ph_s = s;
    );
    ph_on && bb * 4 + 0.000001 >= ph_rel ? ( ph_on = 0; v_release(); );
  );
  si += 1;

  out = 0;
  v_stage > 0 ? (
    // pitch: glide, octave, bend and the 808 drop
    v_cur += (v_tgt - v_cur) * v_gc;
    p = v_cur + oct * 12 + bend + (osc == 3 ? drop * v_pe : 0);
    dt = min(0.45, 440 * 2 ^ ((p - 69) / 12) / srate);
    v_ph += dt; v_ph -= floor(v_ph);
    y = osc_wave(v_ph, dt);
    det_on ? (
      dt2 = min(0.45, dt * det_r);
      v_ph2 += dt2; v_ph2 -= floor(v_ph2);
      y = (y + osc_wave(v_ph2, dt2)) * 0.6;
    );
    v_phs += dt * 0.5; v_phs -= floor(v_phs);
    y += sub_l * sin(2 * $pi * v_phs);

    // 24 dB low-pass: two state-variable stages, the second one resonant
    fc = max(20, min(0.45 * srate, cut * 2 ^ (env_oct * v_fe * v_vg)));
    g = tan($pi * fc / srate);
    a1 = 1 / (1 + g * (g + k1)); a2 = g * a1; a3 = g * a2;
    v3 = y - f1s2; v1 = a1 * f1s1 + a2 * v3; v2 = f1s2 + a2 * f1s1 + a3 * v3;
    f1s1 = 2 * v1 - f1s1; f1s2 = 2 * v2 - f1s2;
    a1 = 1 / (1 + g * (g + k2)); a2 = g * a1; a3 = g * a2;
    v3 = v2 - f2s2; v1 = a1 * f2s1 + a2 * v3; v2 = f2s2 + a2 * f2s1 + a3 * v3;
    f2s1 = 2 * v1 - f2s1; f2s2 = 2 * v2 - f2s2;
    y = v2;

    // Drive: soft clipping
    drv > 0 ? ( u = max(-3, min(3, y * drv_g)); y = u * (27 + u * u) / (27 + 9 * u * u) * drv_n; );

    // amplitude: ADSR, velocity and Punch (a boost that rises in 1.5 ms and falls in 20 ms)
    v_pk += (v_pkt - v_pk) * pa_c;
    out = y * v_env * v_vg * (1 + 2 * punch * v_pk) * 0.42;
    v_pkt *= pk_c; v_fe *= fdc; v_pe *= pe_c;
    v_stage == 1 ? (
      v_env += a_inc;
      v_env >= 1 ? ( v_env = 1; v_stage = 2; );
    ) : v_stage == 2 ? (
      v_env = sus + (v_env - sus) * d_c;
      sus <= 0 && v_env < 0.00001 ? ( v_env = 0; v_stage = 0; );
    ) : (
      v_env *= r_c;
      v_env < 0.00001 ? ( v_env = 0; v_stage = 0; );
    );
  );
  spl0 = out * vol;
  spl1 = spl0;

@gfx 560 502
  ng_knobs_begin("BASS", "INSTRUMENTS", 560, 156, 3, 0);

  // display: the phrase chips (a click chooses one, like the keys C1 to G#1), the steps of the
  // phrase with the step that plays, and a keyboard from C1 to B4
  bs_cw = 480 / 9;
  bs_sel = max(0, min(8, ph_sel));
  bs_step = ph_sel > 0 && hn > 0 && ph_s > -1000 ? ph_s - floor(ph_s / 16) * 16 : -1;
  i = 0;
  loop(9,
    xx = 24 + i * (bs_cw + 4);
    hover = mouse_x >= X(xx) && mouse_x < X(xx + bs_cw) && mouse_y >= Y(64) && mouse_y < Y(82) && !ng_pre_open;
    ng_col(i == bs_sel ? NG_ACCENT : NG_BG, 1);
    gfx_roundrect(X(xx), Y(64), bs_cw * ng_s, 18 * ng_s, 4 * ng_s, 1);
    gfx_rect(X(xx) + 1, Y(64) + 1, bs_cw * ng_s - 1, 18 * ng_s - 1);
    ng_col(i == bs_sel ? NG_ACCENT : hover ? 0x45433f : NG_BORDER, 1);
    gfx_roundrect(X(xx), Y(64), bs_cw * ng_s, 18 * ng_s, 4 * ng_s, 1);
    ng_font(1, 7, 1);
    ng_col(i == bs_sel ? NG_BG : NG_TEXT, 1);
    ng_txt(i == 0 ? "OFF" : i == 1 ? "EIGHTHS" : i == 2 ? "OCTAVES" : i == 3 ? "OFFBEAT" : i == 4 ? "GALLOP" :
           i == 5 ? "FUNK" : i == 6 ? "ACID" : i == 7 ? "TRESILLO" : "TRAP", xx + bs_cw / 2, 73, 1, 0.5);
    hover && ng_click ? ( ng_slider_set(18, i) ? update(); bs_req = i + 1; );
    i += 1;
  );

  bs_sel == 0 ? (
    ng_col(NG_BG, 1);
    gfx_rect(X(24), Y(88), 512 * ng_s, 42 * ng_s);
    ng_col(NG_BORDER, 1);
    gfx_rect(X(24), Y(88), 512 * ng_s, 42 * ng_s, 0);
    ng_font(1, 7.5, 1);
    ng_col(NG_MUTED, 1);
    ng_txt("PHRASE OFF: THE KEYS FROM C2 UP PLAY THE BASS", 280, 109, 1, 1);
  ) : (
    bs_last = 0;
    i = 0;
    loop(16,
      xx = 24 + i * 32;
      ng_col(NG_BG, 1);
      gfx_rect(X(xx), Y(88), 30 * ng_s, 42 * ng_s);
      iv = PN[bs_sel * 16 + i];
      iv > -100 ? bs_last = iv;
      hh = 8 + (max(-12, min(12, bs_last)) + 12) / 24 * 30;
      iv > -100 ? (
        ng_col(NG_ACCENT, PA[bs_sel * 16 + i] > 0 ? 1 : 0.6);
        gfx_rect(X(xx + 3), Y(130 - hh), 27 * ng_s, hh * ng_s);
        PS[bs_sel * 16 + i] > 0 ? ( ng_col(NG_TEXT, 1); gfx_rect(X(xx + 3), Y(90), 8 * ng_s, max(1, 2 * ng_s)); );
      ) : iv < -150 ? (
        // a tie holds the note before
        ng_col(NG_ACCENT, 0.3);
        gfx_rect(X(xx), Y(130 - hh), 30 * ng_s, hh * ng_s);
      );
      ng_col(i == bs_step ? NG_TEXT : NG_BORDER, 1);
      gfx_rect(X(xx), Y(88), 30 * ng_s, 42 * ng_s, 0);
      i == bs_step ? gfx_rect(X(xx) + 1, Y(88) + 1, 30 * ng_s - 2, 42 * ng_s - 2, 0);
      i - floor(i / 4) * 4 == 0 ? (
        ng_font(1, 6.5, 1);
        ng_col(NG_MUTED, 1);
        sprintf(#bs_n, "%d", i / 4 + 1);
        ng_txt(#bs_n, xx + 26, 95, 2, 0);
      );
      i += 1;
    );
  );

  // the note playing
  bs_play = v_stage == 1 || v_stage == 2 ? floor(v_tgt + 0.5) : -1;
  bs_play >= 0 ? (
    bs_pc = bs_play - floor(bs_play / 12) * 12;
    sprintf(#bs_info, "NOTE %s%d", bs_pc == 0 ? "C" : bs_pc == 1 ? "C#" : bs_pc == 2 ? "D" : bs_pc == 3 ? "D#" : bs_pc == 4 ? "E" : bs_pc == 5 ? "F" :
            bs_pc == 6 ? "F#" : bs_pc == 7 ? "G" : bs_pc == 8 ? "G#" : bs_pc == 9 ? "A" : bs_pc == 10 ? "A#" : "B", floor(bs_play / 12) - 1);
  ) : strcpy(#bs_info, "NOTE -");
  ng_font(1, 7, 1);
  ng_col(NG_TEXT, 1);
  ng_txt(#bs_info, 24, 139, 0, 1);
  ng_col(NG_MUTED, 1);
  ng_txt("C1 OFF  C#1-G#1 PHRASES  C2+ NOTES", 536, 139, 2, 1);

  // the keyboard: the phrase keys tinted, the active one dotted, the keys held marked
  bs_ww = 512 / 28; bs_bw = bs_ww * 0.62; bs_bh = 52 * 0.6;
  i = 0; n = 24;
  loop(48,
    pc = n - floor(n / 12) * 12;
    bs_white(pc) ? (
      xx = 24 + i * bs_ww;
      n == bs_play ? ng_col(NG_ACCENT, 1) : ng_col(n <= 32 ? 0x55534f : 0x2d2b28, 1);
      gfx_rect(X(xx + 0.5), Y(146), (bs_ww - 1) * ng_s, 52 * ng_s);
      bs_held(n) ? ( ng_col(n == bs_play ? NG_BG : NG_TEXT, 1); gfx_rect(X(xx + 2.5), Y(148), (bs_ww - 5) * ng_s, 3 * ng_s); );
      n <= 32 && n - 24 == bs_sel ? ( ng_col(NG_ACCENT, 1); gfx_circle(X(xx + bs_ww / 2), Y(146 + 52 - 13), 2.6 * ng_s, 1, 1); );
      pc == 0 ? (
        ng_font(1, 6, 1);
        ng_col(n == bs_play ? NG_BG : NG_MUTED, 1);
        sprintf(#bs_n, "C%d", floor(n / 12) - 1);
        ng_txt(#bs_n, xx + bs_ww / 2, 146 + 52 - 5, 1, 0);
      );
      i += 1;
    );
    n += 1;
  );
  i = 0; n = 24;
  loop(48,
    pc = n - floor(n / 12) * 12;
    bs_white(pc) ? i += 1 : (
      xx = 24 + i * bs_ww - bs_bw / 2;
      ng_col(NG_CARD, 1);
      gfx_rect(X(xx - 1), Y(146), (bs_bw + 2) * ng_s, (bs_bh + 1) * ng_s);
      n == bs_play ? ng_col(NG_ACCENT, 1) : ng_col(n <= 32 ? 0x3e3c39 : 0x131211, 1);
      gfx_rect(X(xx), Y(146), bs_bw * ng_s, bs_bh * ng_s);
      bs_held(n) ? ( ng_col(n == bs_play ? NG_BG : NG_TEXT, 1); gfx_rect(X(xx + 1.5), Y(148), (bs_bw - 3) * ng_s, 3 * ng_s); );
      n <= 32 && n - 24 == bs_sel ? ( ng_col(NG_ACCENT, 1); gfx_circle(X(xx + bs_bw / 2), Y(146 + bs_bh - 11), 2.2 * ng_s, 1, 1); );
    );
    n += 1;
  );

  // controls
  ng_row(6);
  ng_select_ctl(1, "OSCILLATOR", "SUB|SAW|SQUARE|808", 0) ? update();
  sprintf(#bs_v, "%+d", slider2);
  ng_knob_ctl(2, "OCTAVE", #bs_v, -2, 2, 0, 1, 1) ? update();
  sprintf(#bs_v2, "%d ct", slider3);
  ng_knob_ctl(3, "DETUNE", #bs_v2, 0, 50, 0, 1, 0) ? update();
  sprintf(#bs_v3, "%d%%", slider4);
  ng_knob_ctl(4, "SUB", #bs_v3, 0, 100, 30, 1, 0) ? update();
  sprintf(#bs_v4, "%d%%", slider5);
  ng_knob_ctl(5, "PUNCH", #bs_v4, 0, 100, 30, 1, 0) ? update();
  sprintf(#bs_v5, "%d%%", slider6);
  ng_knob_ctl(6, "DRIVE", #bs_v5, 0, 100, 10, 1, 0) ? update();

  ng_row(6);
  slider7 >= 1000 ? sprintf(#bs_v6, "%.1f kHz", slider7 / 1000) : sprintf(#bs_v6, "%d Hz", slider7);
  ng_knob_ctl_log(7, "CUTOFF", #bs_v6, 30, 12000, 900, 1) ? update();
  sprintf(#bs_v7, "%d%%", slider8);
  ng_knob_ctl(8, "RESONANCE", #bs_v7, 0, 100, 20, 1, 0) ? update();
  sprintf(#bs_v8, "%+d%%", slider9);
  ng_knob_ctl(9, "ENV AMOUNT", #bs_v8, -100, 100, 40, 1, 1) ? update();
  bs_ms(#bs_v9, slider10);
  ng_knob_ctl_log(10, "FILTER DECAY", #bs_v9, 5, 3000, 250, 1) ? update();
  sprintf(#bs_v10, "%d%%", slider17);
  ng_knob_ctl(17, "VELOCITY", #bs_v10, 0, 100, 50, 1, 0) ? update();
  sprintf(#bs_v11, "%+.1f dB", slider19);
  ng_knob_ctl(19, "VOLUME", #bs_v11, -24, 12, 0, 0.1, 0) ? update();

  ng_row(6);
  bs_ms(#bs_v12, slider11);
  ng_knob_ctl_log(11, "ATTACK", #bs_v12, 1, 2000, 2, 1) ? update();
  bs_ms(#bs_v13, slider12);
  ng_knob_ctl_log(12, "DECAY", #bs_v13, 5, 5000, 400, 1) ? update();
  sprintf(#bs_v14, "%d%%", slider13);
  ng_knob_ctl(13, "SUSTAIN", #bs_v14, 0, 100, 70, 1, 0) ? update();
  bs_ms(#bs_v15, slider14);
  ng_knob_ctl_log(14, "RELEASE", #bs_v15, 5, 5000, 80, 1) ? update();
  ng_select_ctl(15, "GLIDE MODE", "LEGATO|ALWAYS", 0) ? update();
  bs_ms(#bs_v16, slider16);
  ng_knob_ctl(16, "GLIDE", #bs_v16, 0, 1000, 30, 1, 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
