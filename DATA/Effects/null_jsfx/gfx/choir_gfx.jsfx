desc:NULL Choir GFX
author: Christos Koulaxizis
tags: instrument choir vocal voices aah ooh formant vowel ensemble pad polyphonic synth mpe midi gui
//category: Instruments
//NULL JSFX v4.2 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:0<0,4,0.01>-Vowel
slider2:8<1,8,1>-Voices
slider3:11<0,40,1>-Detune (ct)
slider4:25<0,100,1>-Breath (%)
slider5:35<0,100,1>-Vibrato (%)
slider6:5.4<3,8,0.1>-Vibrato Rate (Hz)
slider7:0<0,4,1{Auto,Soprano,Alto,Tenor,Bass}>-Section
slider8:250<5,3000,1:log>-Attack (ms)
slider9:600<20,5000,1:log>-Release (ms)
slider10:50<0,100,1>-Brightness (%)
slider11:100<0,100,1>-Velocity (%)
slider12:100<0,100,1>-Stereo (%)
slider13:0<0,1,1{Off,On}>-MPE
slider14:48<0,96,1>-MPE Bend Range (st)
slider15:0<-24,12,0.1>-Volume (dB)

in_pin:none
out_pin:Left
out_pin:Right

@init
  // A choir from synthesis (no samples), fully polyphonic: every key sings with Voices singers
  // (1 to 8), each a band-limited sawtooth (PolyBLEP) with its own detune (up to Detune cents),
  // a slow pitch drift and a vibrato (Vibrato depth, up to 0.45 semitones, at Vibrato Rate +-10%,
  // fading in from 0.25 s after the key over 0.6 s), plus breath noise pulsed by its glottal
  // cycle (Breath). The singers are spread across the stereo field (Stereo). Each key goes through
  // a one-pole glottal tilt (darker when soft: 1.5 kHz plus 3.5 kHz times velocity, Brightness
  // +-2 octaves), then into the four sections of the choir, soprano, alto, tenor and bass, each a
  // bank of five formant resonators per channel tuned to the vowel (Vowel: A, E, I, O, U and the
  // blends between; the right channel's formants 0.6% higher at full Stereo), with three banks
  // halfway between them (seven in all). Section Auto sends a key to the two banks nearest its
  // pitch (bass at A2 and below, tenor at F3, alto at D4, soprano at A#4 and above); the others
  // send every key to one section. One envelope per key
  // (Attack to full, Release to silence; the sustain pedal, CC 64, holds keys). Velocity sets the
  // level and the tilt (Velocity 0%: every key sings at full velocity). The mod wheel (CC 1)
  // moves the vowel towards U. Pitch bend: +-2 semitones. All notes off (CC 123/120) releases
  // every key. MPE (On): channel 1 is the master channel as above; on channels 2-16 the pitch
  // bend (MPE Bend Range), channel pressure (up to +6 dB) and CC74 timbre (64 neutral, the tilt
  // +-2 octaves) belong to the key on that channel, and a note-off ends only its own channel's key.
  //
  // Memory: 0.. the MIDI of the block (4 per message), 2048.. per key (down, gate, envelope,
  // channel, velocity, time, tilt states and coefficient, sections, pitch, pressure, timbre),
  // 4096.. per singer (8 per key: phase, detune, vibrato rate and phase, drift, increment),
  // 10240.. the formant tables, 10560.. the resonators' coefficients, 10848.. their states,
  // 11136.. the bank inputs, 11152.. the bank run-out counters, 11200.. MPE channel bend,
  // pressure and timbre (16 each), 11300.. singer pans.
  // NULL Choir (../choir.jsfx) with its own interface: same audio code, plus @gfx.
  gfx_ext_retina = 1;
  ext_noinit = 1;
  ext_tail_size = -1;
  MQ = 0;
  KD = 2048; K_g = 2176; K_e = 2304; K_ch = 2432; K_v = 2560; K_t = 2688;
  K_tl = 2816; K_tr = 2944; K_ta = 3072; K_s0 = 3200; K_sf = 3328; K_dt = 3456;
  K_pp = 3584; K_tt = 3712;
  S_ph = 4096; S_det = 5120; S_vr = 6144; S_vp = 7168; S_dr = 8192; S_inc = 9216;
  FT = 10240; CO = 10560; ST = 10848; BUS = 11136; SACT = 11152;
  CHB = 11200; CHP = 11216; CHT = 11232; PANL = 11300; PANR = 11308;
  freembuf(11400);
  memset(0, 0, 11400);
  tpi = 2 * $pi;
  k = 0;
  loop(128, K_dt[k] = 440 * 2 ^ ((k - 69) / 12) / srate; k += 1;);
  sus = 0; bendv = 0; mwheel = 0; vw = 0; cur_ch = 0; mpe_was = 0;
  klo = 128; khi = -1;               // the range of keys sounding or held
  ctl = 0;                           // samples to the next control tick (every 16)
  vowel_c = -1; width_c = -1;        // the vowel and width the coefficients were made for
  seed = 12345;

  // the formant tables: soprano, alto, tenor, bass x A, E, I, O, U x (5 frequencies in Hz,
  // 5 levels in dB, 5 bandwidths in Hz)
  ftp = FT;
  function ft5(a, b, c, d, e) ( ftp[0] = a; ftp[1] = b; ftp[2] = c; ftp[3] = d; ftp[4] = e; ftp += 5; );
  ft5(800, 1150, 2900, 3900, 4950); ft5(0, -6, -32, -20, -50); ft5(80, 90, 120, 130, 140);
  ft5(350, 2000, 2800, 3600, 4950); ft5(0, -20, -15, -40, -56); ft5(60, 100, 120, 150, 200);
  ft5(270, 2140, 2950, 3900, 4950); ft5(0, -12, -26, -26, -44); ft5(60, 90, 100, 120, 120);
  ft5(450, 800, 2830, 3800, 4950); ft5(0, -11, -22, -22, -50); ft5(70, 80, 100, 130, 135);
  ft5(325, 700, 2700, 3800, 4950); ft5(0, -16, -35, -40, -60); ft5(50, 60, 170, 180, 200);
  ft5(800, 1150, 2800, 3500, 4950); ft5(0, -4, -20, -36, -60); ft5(80, 90, 120, 130, 140);
  ft5(400, 1600, 2700, 3300, 4950); ft5(0, -24, -30, -35, -60); ft5(60, 80, 120, 150, 200);
  ft5(350, 1700, 2700, 3700, 4950); ft5(0, -20, -30, -36, -60); ft5(50, 100, 120, 150, 200);
  ft5(450, 800, 2830, 3500, 4950); ft5(0, -9, -16, -28, -55); ft5(70, 80, 100, 130, 135);
  ft5(325, 700, 2530, 3500, 4950); ft5(0, -12, -30, -40, -64); ft5(50, 60, 170, 180, 200);
  ft5(650, 1080, 2650, 2900, 3250); ft5(0, -6, -7, -8, -22); ft5(80, 90, 120, 130, 140);
  ft5(400, 1700, 2600, 3200, 3580); ft5(0, -14, -12, -14, -20); ft5(70, 80, 100, 120, 120);
  ft5(290, 1870, 2800, 3250, 3540); ft5(0, -15, -18, -20, -30); ft5(40, 90, 100, 120, 120);
  ft5(400, 800, 2600, 2800, 3000); ft5(0, -10, -12, -12, -26); ft5(40, 80, 100, 120, 120);
  ft5(350, 600, 2700, 2900, 3300); ft5(0, -20, -17, -14, -26); ft5(40, 60, 100, 120, 120);
  ft5(600, 1040, 2250, 2450, 2750); ft5(0, -7, -9, -9, -20); ft5(60, 70, 110, 120, 130);
  ft5(400, 1620, 2400, 2800, 3100); ft5(0, -12, -9, -12, -18); ft5(40, 80, 100, 120, 120);
  ft5(250, 1750, 2600, 3050, 3340); ft5(0, -30, -16, -22, -28); ft5(60, 90, 100, 120, 120);
  ft5(400, 750, 2400, 2600, 2900); ft5(0, -11, -21, -20, -40); ft5(40, 80, 100, 120, 120);
  ft5(350, 600, 2400, 2675, 2950); ft5(0, -20, -32, -28, -36); ft5(40, 80, 100, 120, 120);

  // Park-Miller in exact double arithmetic, uniform in (0, 1)
  function rnd()
  (
    seed *= 16807; seed -= floor(seed / 2147483647) * 2147483647;
    seed / 2147483647;
  );

  // a formant value (o: 0 frequency, 5 level, 10 bandwidth) of bank s for vowel v0..v1
  function ftv(s, o, v0, v1, vf) local(t0, t1, tf, a, b)
  (
    t0 = floor(s / 2); t1 = min(3, t0 + (s & 1)); tf = (s & 1) * 0.5;
    a = FT[t0 * 75 + v0 * 15 + o] * (1 - vf) + FT[t0 * 75 + v1 * 15 + o] * vf;
    b = FT[t1 * 75 + v0 * 15 + o] * (1 - vf) + FT[t1 * 75 + v1 * 15 + o] * vf;
    a * (1 - tf) + b * tf;
  );

  // the resonators of the seven banks for vowel v (0..4) and width wd (0..1)
  function coefs(v, wd) local(s, k, v0, v1, vf, f, db, bw, r, w, c, g, i)
  (
    v = max(0, min(4, v));
    v0 = floor(v); v1 = min(4, v0 + 1); vf = v - v0;
    s = 0;
    loop(7,
      k = 0;
      loop(5,
        f = ftv(s, k, v0, v1, vf);
        db = ftv(s, 5 + k, v0, v1, vf);
        bw = ftv(s, 10 + k, v0, v1, vf);
        r = exp(-$pi * bw / srate);
        g = 10 ^ (db / 20) * (1 + k * 0.5);
        c = 0;
        loop(2,
          w = tpi * min(f * (c ? 1 + 0.006 * wd : 1), 0.45 * srate) / srate;
          i = CO + ((s * 5 + k) * 2 + c) * 4;
          i[0] = (1 - r * r) * 0.5;
          i[1] = 2 * r * cos(w);
          i[2] = r * r;
          i[3] = g;
          c += 1;
        );
        k += 1;
      );
      s += 1;
    );
    vowel_c = v; width_c = wd;
  );

  // which banks a key sings in: Auto blends the two nearest its pitch
  function sections(n) local(ti)
  (
    sect > 0 ? (
      K_s0[n] = (sect - 1) * 2; K_sf[n] = 0;
    ) : (
      ti = n >= 70 ? 0 : n <= 45 ? 6 : n >= 62 ? (70 - n) / 4 : n >= 53 ? 2 + (62 - n) / 4.5 : 4 + (53 - n) / 4;
      K_s0[n] = min(6, floor(ti)); K_sf[n] = ti - K_s0[n];
    );
  );

  function note_on(n, vel, ch) local(i, j)
  (
    KD[n] = 1;
    klo = min(klo, n); khi = max(khi, n);
    K_e[n] <= 0 ? (
      // a key starting from silence: new singers
      i = 0;
      loop(8,
        j = n * 8 + i;
        S_ph[j] = rnd();
        S_det[j] = 2 * rnd() - 1;
        S_vr[j] = 0.9 + 0.2 * rnd();
        S_vp[j] = rnd();
        S_dr[j] = 0;
        S_inc[j] = K_dt[n];
        i += 1;
      );
      K_t[n] = 0; K_tl[n] = 0; K_tr[n] = 0;
      K_pp[n] = 0; K_tt[n] = 0;
    );
    K_v[n] = 1 - vsens * (1 - vel);
    K_ch[n] = ch;
    sections(n);
    K_g[n] = 1;
  );
  function note_off(n, ch)
  (
    !mpe || K_ch[n] == ch ? (
      KD[n] = 0;
      !sus ? K_g[n] = 0;
    );
  );
  function sus_off() local(k)
  (
    sus = 0;
    k = 0;
    loop(128, KD[k] == 0 ? K_g[k] = 0; k += 1;);
  );
  function all_off()
  (
    memset(KD, 0, 128);
    memset(K_g, 0, 128);
    sus = 0;
  );
  function midi_ev(st, d1, d2) local(t)
  (
    t = st & 0xF0;
    cur_ch = st & 0x0F;
    mpe && cur_ch > 0 && (t == 0xE0 || t == 0xD0 || (t == 0xB0 && d1 == 74)) ? (
      // MPE: a member channel's bend, pressure and timbre belong to its key
      t == 0xE0 ? CHB[cur_ch] = (d2 * 128 + d1 - 8192) / 8192 :
      t == 0xD0 ? CHP[cur_ch] = d1 / 127 :
      CHT[cur_ch] = (d2 - 64) / 64;
    ) :
    t == 0x90 && d2 > 0 ? note_on(d1, d2 / 127, cur_ch) :
    t == 0x80 || t == 0x90 ? note_off(d1, cur_ch) :
    t == 0xE0 ? bendv = (d2 * 128 + d1 - 8192) / 8192 :
    t == 0xB0 ? (
      d1 == 64 ? ( d2 >= 64 ? sus = 1 : sus ? sus_off(); ) :
      d1 == 1 ? mwheel = d2 / 127 :
      d1 == 123 || d1 == 120 ? all_off();
    );
  );

  // the control tick, every 16 samples: pitch, vibrato and drift of every singer, the tilt, the
  // MPE pressure and timbre, the vowel (mod wheel smoothed over about 20 ms)
  function tick() local(k, i, j, sem, vd, fc, bs)
  (
    vw += (mwheel - vw) * kw;
    vt = vowel + vw * (4 - vowel);
    abs(vt - vowel_c) > 0.0001 || width != width_c ? coefs(vt, width);
    k = klo;
    loop(max(0, khi - klo + 1),
      K_e[k] > 0 || K_g[k] > 0 ? (
        mpe ? (
          K_pp[k] += (CHP[K_ch[k]] - K_pp[k]) * mpe_sm;
          K_tt[k] += (CHT[K_ch[k]] - K_tt[k]) * mpe_sm;
          bs = 2 * bendv + (K_ch[k] > 0 ? mpe_r * CHB[K_ch[k]] : 0);
        ) : bs = 2 * bendv;
        vd = vib * 0.45 * max(0, min(1, (K_t[k] / srate - 0.25) / 0.6));
        i = 0;
        loop(nv,
          j = k * 8 + i;
          S_dr[j] += 0.0064 * ((2 * rnd() - 1) * 3 - S_dr[j]);
          S_vp[j] += S_vr[j] * vrate * 16 / srate;
          S_vp[j] -= floor(S_vp[j]);
          sem = (nv > 1 ? S_det[j] * detune / 100 : 0) + S_dr[j] * 0.06 + vd * sin(tpi * S_vp[j]) + bs;
          S_inc[j] = min(0.45, K_dt[k] * 2 ^ (sem / 12));
          i += 1;
        );
        fc = (1500 + 3500 * K_v[k]) * bright * (mpe ? 2 ^ (2 * K_tt[k]) : 1);
        K_ta[k] = exp(-tpi * min(fc, 0.45 * srate) / srate);
      );
      k += 1;
    );
  );

  // for the display: the white keys, and the response of bank s (left channel) at w
  function ch_white(pc) ( pc == 0 || pc == 2 || pc == 4 || pc == 5 || pc == 7 || pc == 9 || pc == 11; );
  function ch_mag(s, w) local(k, c, nr, ni, dr, di, d2, hr, hi)
  (
    hr = hi = 0;
    k = 0;
    loop(5,
      c = CO + (s * 10 + k * 2) * 4;
      // b (1 - z^-2) / (1 - c1 z^-1 + c2 z^-2) at z = e^jw
      nr = c[0] * (1 - cos(2 * w)); ni = c[0] * sin(2 * w);
      dr = 1 - c[1] * cos(w) + c[2] * cos(2 * w); di = c[1] * sin(w) - c[2] * sin(2 * w);
      d2 = dr * dr + di * di;
      hr += c[3] * (nr * dr + ni * di) / d2;
      hi += c[3] * (ni * dr - nr * di) / d2;
      k += 1;
    );
    sqrt(hr * hr + hi * hi);
  );

  function update()
  (
    vowel = max(0, min(4, slider1));
    nv = max(1, min(8, floor(slider2 + 0.5)));
    detune = slider3;
    breath = slider4 / 100 * 1.6;
    vib = slider5 / 100;
    vrate = slider6;
    sect = max(0, min(4, floor(slider7 + 0.5)));
    ka = 1 - exp(-4.6 / (slider8 * 0.001 * srate));
    kr = 1 - exp(-4.6 / (slider9 * 0.001 * srate));
    bright = 2 ^ ((slider10 - 50) / 25);
    vsens = slider11 / 100;
    width = slider12 / 100;
    mpe = slider13 >= 0.5;
    mpe_r = slider14;
    mpe_sm = 1 - exp(-16000 / (5 * srate));
    kw = 1 - exp(-16000 / (20 * srate));
    // MPE turned on starts from neutral channels
    mpe && !mpe_was ? memset(CHB, 0, 48);
    mpe_was = mpe;
    vol = 10 ^ (slider15 / 20);
    gnv = 1 / sqrt(nv);
    // the singers' places from left to right
    i = 0;
    loop(8,
      p = nv > 1 ? 0.5 + ((i + 0.5) / nv - 0.5) * width : 0.5;
      PANL[i] = sqrt(1 - p);
      PANR[i] = sqrt(p);
      i += 1;
    );
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 17;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1); ng_hist_add(2); ng_hist_add(3); ng_hist_add(4); ng_hist_add(5); ng_hist_add(6); ng_hist_add(7); ng_hist_add(8); ng_hist_add(9); ng_hist_add(10); ng_hist_add(11); ng_hist_add(12); ng_hist_add(13); ng_hist_add(14); ng_hist_add(15);
  ng_hist_init();
  ng_dice_add(1, 0, 4, 0.01, 0); ng_dice_add(2, 1, 8, 1, 0); ng_dice_add(3, 0, 40, 1, 0); ng_dice_add(4, 0, 100, 1, 0); ng_dice_add(5, 0, 100, 1, 0); ng_dice_add(6, 3, 8, 0.1, 0); ng_dice_add(7, 0, 4, 1, 0); ng_dice_add(8, 5, 3000, 1, 1); ng_dice_add(9, 20, 5000, 1, 1); ng_dice_add(10, 0, 100, 1, 0); ng_dice_add(11, 0, 100, 1, 0); ng_dice_add(12, 0, 100, 1, 0); ng_dice_add(13, 0, 1, 1, 0); ng_dice_add(14, 0, 96, 1, 0);

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 0); ng_slider_set(2, 8); ng_slider_set(3, 11); ng_slider_set(4, 25); ng_slider_set(5, 35); ng_slider_set(6, 5.4); ng_slider_set(7, 0); ng_slider_set(8, 250); ng_slider_set(9, 600); ng_slider_set(10, 50); ng_slider_set(11, 100); ng_slider_set(12, 100); ng_slider_set(13, 0); ng_slider_set(14, 48); ng_slider_set(15, 0); );
    p == 1 ? ( ng_slider_set(1, 0); ng_slider_set(2, 8); ng_slider_set(3, 11); ng_slider_set(4, 25); ng_slider_set(5, 35); ng_slider_set(6, 5.4); ng_slider_set(7, 0); ng_slider_set(8, 250); ng_slider_set(9, 600); ng_slider_set(10, 50); ng_slider_set(11, 100); ng_slider_set(12, 100); ng_slider_set(13, 0); ng_slider_set(14, 48); ng_slider_set(15, 0); );
    p == 2 ? ( ng_slider_set(1, 3.6); ng_slider_set(2, 8); ng_slider_set(3, 11); ng_slider_set(4, 30); ng_slider_set(5, 35); ng_slider_set(6, 5.4); ng_slider_set(7, 0); ng_slider_set(8, 600); ng_slider_set(9, 1500); ng_slider_set(10, 35); ng_slider_set(11, 100); ng_slider_set(12, 100); ng_slider_set(13, 0); ng_slider_set(14, 48); ng_slider_set(15, 0); );
    p == 3 ? ( ng_slider_set(1, 1.2); ng_slider_set(2, 6); ng_slider_set(3, 11); ng_slider_set(4, 25); ng_slider_set(5, 30); ng_slider_set(6, 5.4); ng_slider_set(7, 0); ng_slider_set(8, 250); ng_slider_set(9, 600); ng_slider_set(10, 65); ng_slider_set(11, 100); ng_slider_set(12, 100); ng_slider_set(13, 0); ng_slider_set(14, 48); ng_slider_set(15, 0); );
    p == 4 ? ( ng_slider_set(1, 3.6); ng_slider_set(2, 1); ng_slider_set(3, 11); ng_slider_set(4, 20); ng_slider_set(5, 60); ng_slider_set(6, 5.4); ng_slider_set(7, 0); ng_slider_set(8, 120); ng_slider_set(9, 400); ng_slider_set(10, 50); ng_slider_set(11, 100); ng_slider_set(12, 100); ng_slider_set(13, 0); ng_slider_set(14, 48); ng_slider_set(15, -1); );
    p == 5 ? ( ng_slider_set(1, 0.4); ng_slider_set(2, 4); ng_slider_set(3, 11); ng_slider_set(4, 25); ng_slider_set(5, 50); ng_slider_set(6, 5.4); ng_slider_set(7, 1); ng_slider_set(8, 150); ng_slider_set(9, 600); ng_slider_set(10, 50); ng_slider_set(11, 100); ng_slider_set(12, 100); ng_slider_set(13, 0); ng_slider_set(14, 48); ng_slider_set(15, 3); );
    p == 6 ? ( ng_slider_set(1, 3.2); ng_slider_set(2, 6); ng_slider_set(3, 11); ng_slider_set(4, 55); ng_slider_set(5, 35); ng_slider_set(6, 5.4); ng_slider_set(7, 4); ng_slider_set(8, 400); ng_slider_set(9, 600); ng_slider_set(10, 40); ng_slider_set(11, 100); ng_slider_set(12, 100); ng_slider_set(13, 0); ng_slider_set(14, 48); ng_slider_set(15, 0); );
    p == 7 ? ( ng_slider_set(1, 0.3); ng_slider_set(2, 6); ng_slider_set(3, 11); ng_slider_set(4, 25); ng_slider_set(5, 40); ng_slider_set(6, 5.4); ng_slider_set(7, 3); ng_slider_set(8, 250); ng_slider_set(9, 600); ng_slider_set(10, 50); ng_slider_set(11, 100); ng_slider_set(12, 100); ng_slider_set(13, 0); ng_slider_set(14, 48); ng_slider_set(15, 0); );
    p == 8 ? ( ng_slider_set(1, 3); ng_slider_set(2, 8); ng_slider_set(3, 11); ng_slider_set(4, 100); ng_slider_set(5, 10); ng_slider_set(6, 5.4); ng_slider_set(7, 0); ng_slider_set(8, 500); ng_slider_set(9, 600); ng_slider_set(10, 60); ng_slider_set(11, 100); ng_slider_set(12, 100); ng_slider_set(13, 0); ng_slider_set(14, 48); ng_slider_set(15, 3); );
    p == 9 ? ( ng_slider_set(1, 1.5); ng_slider_set(2, 8); ng_slider_set(3, 16); ng_slider_set(4, 25); ng_slider_set(5, 35); ng_slider_set(6, 5.4); ng_slider_set(7, 0); ng_slider_set(8, 1200); ng_slider_set(9, 2500); ng_slider_set(10, 45); ng_slider_set(11, 100); ng_slider_set(12, 100); ng_slider_set(13, 0); ng_slider_set(14, 48); ng_slider_set(15, 0); );
    p == 10 ? ( ng_slider_set(1, 0); ng_slider_set(2, 8); ng_slider_set(3, 24); ng_slider_set(4, 25); ng_slider_set(5, 25); ng_slider_set(6, 5.4); ng_slider_set(7, 0); ng_slider_set(8, 250); ng_slider_set(9, 600); ng_slider_set(10, 50); ng_slider_set(11, 100); ng_slider_set(12, 100); ng_slider_set(13, 0); ng_slider_set(14, 48); ng_slider_set(15, 0); );
