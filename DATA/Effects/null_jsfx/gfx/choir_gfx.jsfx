    m < 0 && ng_pre_eq(slider1, 3.2) && ng_pre_eq(slider2, 6) && ng_pre_eq(slider3, 11) && ng_pre_eq(slider4, 55) && ng_pre_eq(slider5, 35) && ng_pre_eq(slider6, 5.4) && ng_pre_eq(slider7, 4) && ng_pre_eq(slider8, 400) && ng_pre_eq(slider9, 600) && ng_pre_eq(slider10, 40) && ng_pre_eq(slider11, 100) && ng_pre_eq(slider12, 100) && ng_pre_eq(slider13, 0) && ng_pre_eq(slider14, 48) && ng_pre_eq(slider15, 0) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 0.3) && ng_pre_eq(slider2, 6) && ng_pre_eq(slider3, 11) && ng_pre_eq(slider4, 25) && ng_pre_eq(slider5, 40) && ng_pre_eq(slider6, 5.4) && ng_pre_eq(slider7, 3) && ng_pre_eq(slider8, 250) && ng_pre_eq(slider9, 600) && ng_pre_eq(slider10, 50) && ng_pre_eq(slider11, 100) && ng_pre_eq(slider12, 100) && ng_pre_eq(slider13, 0) && ng_pre_eq(slider14, 48) && ng_pre_eq(slider15, 0) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 3) && ng_pre_eq(slider2, 8) && ng_pre_eq(slider3, 11) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 10) && ng_pre_eq(slider6, 5.4) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 500) && ng_pre_eq(slider9, 600) && ng_pre_eq(slider10, 60) && ng_pre_eq(slider11, 100) && ng_pre_eq(slider12, 100) && ng_pre_eq(slider13, 0) && ng_pre_eq(slider14, 48) && ng_pre_eq(slider15, 3) ? m = 8;
    m < 0 && ng_pre_eq(slider1, 1.5) && ng_pre_eq(slider2, 8) && ng_pre_eq(slider3, 16) && ng_pre_eq(slider4, 25) && ng_pre_eq(slider5, 35) && ng_pre_eq(slider6, 5.4) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 1200) && ng_pre_eq(slider9, 2500) && ng_pre_eq(slider10, 45) && ng_pre_eq(slider11, 100) && ng_pre_eq(slider12, 100) && ng_pre_eq(slider13, 0) && ng_pre_eq(slider14, 48) && ng_pre_eq(slider15, 0) ? m = 9;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 8) && ng_pre_eq(slider3, 24) && ng_pre_eq(slider4, 25) && ng_pre_eq(slider5, 25) && ng_pre_eq(slider6, 5.4) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 250) && ng_pre_eq(slider9, 600) && ng_pre_eq(slider10, 50) && ng_pre_eq(slider11, 100) && ng_pre_eq(slider12, 100) && ng_pre_eq(slider13, 0) && ng_pre_eq(slider14, 48) && ng_pre_eq(slider15, 0) ? m = 10;
    m < 0 && ng_pre_eq(slider1, 3.4) && ng_pre_eq(slider2, 8) && ng_pre_eq(slider3, 6) && ng_pre_eq(slider4, 25) && ng_pre_eq(slider5, 5) && ng_pre_eq(slider6, 5.4) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 300) && ng_pre_eq(slider9, 600) && ng_pre_eq(slider10, 40) && ng_pre_eq(slider11, 100) && ng_pre_eq(slider12, 0) && ng_pre_eq(slider13, 0) && ng_pre_eq(slider14, 48) && ng_pre_eq(slider15, 0) ? m = 11;
    m < 0 && ng_pre_eq(slider1, 0.2) && ng_pre_eq(slider2, 6) && ng_pre_eq(slider3, 11) && ng_pre_eq(slider4, 25) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 5.4) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 15) && ng_pre_eq(slider9, 120) && ng_pre_eq(slider10, 50) && ng_pre_eq(slider11, 100) && ng_pre_eq(slider12, 100) && ng_pre_eq(slider13, 0) && ng_pre_eq(slider14, 48) && ng_pre_eq(slider15, 0) ? m = 12;
    m < 0 && ng_pre_eq(slider1, 3.8) && ng_pre_eq(slider2, 8) && ng_pre_eq(slider3, 11) && ng_pre_eq(slider4, 35) && ng_pre_eq(slider5, 35) && ng_pre_eq(slider6, 5.4) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 900) && ng_pre_eq(slider9, 4000) && ng_pre_eq(slider10, 15) && ng_pre_eq(slider11, 100) && ng_pre_eq(slider12, 100) && ng_pre_eq(slider13, 0) && ng_pre_eq(slider14, 48) && ng_pre_eq(slider15, -2) ? m = 13;
    m < 0 && ng_pre_eq(slider1, 0.8) && ng_pre_eq(slider2, 3) && ng_pre_eq(slider3, 30) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 5.4) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 250) && ng_pre_eq(slider9, 600) && ng_pre_eq(slider10, 80) && ng_pre_eq(slider11, 0) && ng_pre_eq(slider12, 100) && ng_pre_eq(slider13, 0) && ng_pre_eq(slider14, 48) && ng_pre_eq(slider15, 0) ? m = 14;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 4) && ng_pre_eq(slider3, 11) && ng_pre_eq(slider4, 25) && ng_pre_eq(slider5, 15) && ng_pre_eq(slider6, 5.4) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 80) && ng_pre_eq(slider9, 600) && ng_pre_eq(slider10, 50) && ng_pre_eq(slider11, 100) && ng_pre_eq(slider12, 100) && ng_pre_eq(slider13, 1) && ng_pre_eq(slider14, 48) && ng_pre_eq(slider15, 0) ? m = 15;
    m < 0 && ng_pre_eq(slider1, 0.5) && ng_pre_eq(slider2, 2) && ng_pre_eq(slider3, 35) && ng_pre_eq(slider4, 45) && ng_pre_eq(slider5, 70) && ng_pre_eq(slider6, 4) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 250) && ng_pre_eq(slider9, 600) && ng_pre_eq(slider10, 25) && ng_pre_eq(slider11, 100) && ng_pre_eq(slider12, 100) && ng_pre_eq(slider13, 0) && ng_pre_eq(slider14, 48) && ng_pre_eq(slider15, 0) ? m = 16;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Aah Choir";
    p == 2 ? s = "Ooh Pad";
    p == 3 ? s = "Eeh Bright";
    p == 4 ? s = "Soft Ooh Solo";
    p == 5 ? s = "Soprano Line";
    p == 6 ? s = "Male Ooh";
    p == 7 ? s = "Tenor Section";
    p == 8 ? s = "Breathy Whisper";
    p == 9 ? s = "Vowel Morph Pad";
    p == 10 ? s = "Wide Ensemble";
    p == 11 ? s = "Mono Chant";
    p == 12 ? s = "Fast Staccato";
    p == 13 ? s = "Dark Cathedral";
    p == 14 ? s = "Synth Voices";
    p == 15 ? s = "MPE Voices";
    p == 16 ? s = "Lo-Fi Choir";
    s;
  );

  // the hint line under the controls: a short help text per slider (from tools/site_content.json)
  function ng_hint_text(i) local(s)
  (
    s = "";
    i == 1 ? s = "The vowel sung: A, E, I, O, U and every blend between (the mod wheel moves it towards U)";
    i == 2 ? s = "How many singers each key has, from a soloist to a section of eight";
    i == 3 ? s = "How far the singers of a key are spread around its pitch";
    i == 4 ? s = "Breath noise in each singer's voice, pulsed with its vocal cords";
    i == 5 ? s = "Depth of the singers' vibrato, which fades in a quarter second after the key";
    i == 6 ? s = "Speed of the vibrato; every singer is a little faster or slower";
    i == 7 ? s = "Auto lets each key sing in the voices nearest its pitch; the others pick soprano, alto, tenor or bass";
    i == 8 ? s = "How slowly the keys swell in";
    i == 9 ? s = "How long the keys ring after they are let go";
    i == 10 ? s = "The vocal tone, from dark to bright, before the formants";
    i == 11 ? s = "How much velocity changes the level and the tone; 0% sings every key at full velocity";
    i == 12 ? s = "How far the singers spread across the stereo field";
    i == 13 ? s = "On: pitch bend, pressure and CC74 timbre of channels 2-16 belong to the key played there";
    i == 14 ? s = "Pitch bend range of the MPE channels";
    i == 15 ? s = "Output level";
    s;
  );

  function ng_presets() local(i)
  (
    ng_hint_i > 0 && !ng_pre_open ? ng_hint(ng_hint_text(ng_hint_i));
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@block
  // the MIDI of this block, played at its offsets in @sample
  mq_n = 0;
  while (midirecv(m_ofs, m_1, m_2, m_3)) (
    // every message goes on to the next plugin too, so instruments can be layered
    midisend(m_ofs, m_1, m_2, m_3);
    mq_n < 512 ? (
      MQ[mq_n * 4] = m_ofs;
      MQ[mq_n * 4 + 1] = m_1;
      MQ[mq_n * 4 + 2] = m_2;
      MQ[mq_n * 4 + 3] = m_3;
      mq_n += 1;
    );
  );
  mq_i = 0;
  si = 0;

@sample
  while (mq_i < mq_n && MQ[mq_i * 4] <= si) (
    midi_ev(MQ[mq_i * 4 + 1], MQ[mq_i * 4 + 2], MQ[mq_i * 4 + 3]);
    mq_i += 1;
  );
  si += 1;
  ctl <= 0 ? ( tick(); ctl = 16; );
  ctl -= 1;

  // the keys: their singers, breath, envelope and tilt, into the sections
  nlo = 128; nhi = -1;
  k = klo;
  loop(max(0, khi - klo + 1),
    e = K_e[k];
    K_g[k] > 0 ? (
      e += ka * (1 - e);
      e > 0.9999 ? e = 1;
    ) : (
      e -= kr * e;
      e < 0.0001 ? e = 0;
    );
    K_e[k] = e;
    e > 0 ? (
      sl = sr = pl = pr = 0;
      i = 0;
      j = k * 8;
      loop(nv,
        dt = S_inc[j];
        p = S_ph[j] + dt;
        p >= 1 ? p -= 1;
        S_ph[j] = p;
        x = 2 * p - 1;
        p < dt ? ( q = p / dt; x -= q + q - q * q - 1; ) :
        p > 1 - dt ? ( q = (p - 1) / dt; x -= q * q + q + q + 1; );
        u = p < 0.4 ? 1 : 0.35;
        sl -= x * PANL[i]; sr -= x * PANR[i];
        pl += u * u * PANL[i] * PANL[i]; pr += u * u * PANR[i] * PANR[i];
        i += 1; j += 1;
      );
      nz = (2 * rnd() - 1) * breath;
      a = K_ta[k];
      // one noise for the key, at the level of a noise of its own for each singer
      K_tl[k] = (sl + nz * sqrt(pl)) * gnv * (1 - a) + a * K_tl[k];
      K_tr[k] = (sr + nz * sqrt(pr)) * gnv * (1 - a) + a * K_tr[k];
      g = e * (0.35 + 0.65 * K_v[k]) * (mpe ? 1 + K_pp[k] : 1) * 0.6;
      s0 = K_s0[k]; sf = K_sf[k];
      BUS[s0 * 2] += K_tl[k] * g * (1 - sf);
      BUS[s0 * 2 + 1] += K_tr[k] * g * (1 - sf);
      SACT[s0] = srate;
      sf > 0 ? (
        BUS[s0 * 2 + 2] += K_tl[k] * g * sf;
        BUS[s0 * 2 + 3] += K_tr[k] * g * sf;
        SACT[s0 + 1] = srate;
      );
      K_t[k] += 1;
    );
    e > 0 || K_g[k] > 0 ? ( nlo = min(nlo, k); nhi = k; );
    k += 1;
  );
  klo = nlo; khi = nhi;

  // the banks: five formant resonators per channel each (a bank left silent for a second stops
  // and is cleared)
  o_l = o_r = 0;
  s = 0;
  loop(7,
    SACT[s] > 0 ? (
      SACT[s] -= 1;
      k = 0;
      loop(10,
        c = CO + (s * 10 + k) * 4;
        z = ST + (s * 10 + k) * 4;
        x = BUS[s * 2 + (k & 1)];
        y = c[0] * (x - z[1]) + c[1] * z[2] - c[2] * z[3];
        z[1] = z[0]; z[0] = x; z[3] = z[2]; z[2] = y;
        k & 1 ? o_r += c[3] * y : o_l += c[3] * y;
        k += 1;
      );
      SACT[s] <= 0 ? memset(ST + s * 40, 0, 40);
    );
    BUS[s * 2] = 0; BUS[s * 2 + 1] = 0;
    s += 1;
  );

  spl0 = o_l * vol;
  spl1 = o_r * vol;

@gfx 560 502
  ng_knobs_begin("CHOIR", "INSTRUMENTS", 560, 156, 3, 0);

  // display: the formants of the vowel sung now (soprano, alto, tenor and bass, 50 Hz to 10 kHz,
  // -48 to +6 dB), the vowel between A and U (the mod wheel included), the keys sounding, the
  // section and a keyboard from C2 to C7
  vowel_c < 0 ? coefs(vowel, width);
  ng_plot(24, 66, 252, 70);
  ng_grid(4, 3, 0);
  ch_s = 0;
  loop(4,
    ng_col(NG_ACCENT, sect == 0 || sect == ch_s + 1 ? 1 : 0.3);
    ch_j = 0;
    loop(101,
      ch_f = 50 * 200 ^ (ch_j / 100);
      ch_w = tpi * min(ch_f, 0.4999 * srate) / srate;
      ch_m = ch_mag(ch_s * 2, ch_w);
      ch_x = ng_px + ng_pw * ch_j / 100;
      ch_y = ng_lin_y(20 * log10(max(ch_m, 0.0000001)), -48, 6);
      ch_j == 0 ? ng_line_start(ch_x, ch_y) : ng_line_to(ch_x, ch_y);
      ch_j += 1;
    );
    ch_s += 1;
  );
  ng_font(1, 6.5, 1);
  ng_col(NG_MUTED, 1);
  ng_txt("FORMANTS", 30, 72, 0, 0.5);

  ng_plot(284, 66, 252, 70);
  ng_grid(4, 1, 0);
  ch_v = vowel_c < 0 ? vowel : vowel_c;
  ng_col(NG_ACCENT, 1);
  gfx_rect(ng_px + ng_pw * ch_v / 4 - ng_s, ng_py, 2 * ng_s, ng_ph);
  ch_i = 0;
  loop(5,
    ng_font(1, 12, 1);
    ng_col(abs(ch_v - ch_i) < 0.5 ? NG_TEXT : NG_MUTED, 1);
    ng_txt(ch_i == 0 ? "A" : ch_i == 1 ? "E" : ch_i == 2 ? "I" : ch_i == 3 ? "O" : "U",
      (ng_px + ng_pw * (ch_i == 0 ? 0.04 : ch_i == 4 ? 0.96 : ch_i / 4)) / ng_s, 66 + 35, 1, 0.5);
    ch_i += 1;
  );
  ng_font(1, 6.5, 1);
  ng_col(NG_MUTED, 1);
  ng_txt("VOWEL", 530, 72, 2, 0.5);

  // the keys sounding and the section
  ch_n = 0;
  ch_i = 0;
  loop(128, K_e[ch_i] > 0 ? ch_n += 1; ch_i += 1;);
  ng_font(1, 7, 1);
  ng_col(NG_TEXT, 1);
  sprintf(#ch_info, "KEYS %d  VOICES %d", ch_n, nv);
  ng_txt(#ch_info, 24, 146, 0, 1);
  ng_col(NG_MUTED, 1);
  ng_txt(sect == 0 ? "AUTO" : sect == 1 ? "SOPRANO" : sect == 2 ? "ALTO" : sect == 3 ? "TENOR" : "BASS", 536, 146, 2, 1);

  // the keyboard from C2 to C7, the keys sounding lit
  ch_ww = 512 / 36; ch_bw = ch_ww * 0.62; ch_bh = 44 * 0.6;
  ch_i = 0; ch_nn = 36;
  loop(61,
    ch_pc = ch_nn - floor(ch_nn / 12) * 12;
    ch_white(ch_pc) ? (
      ch_x = 24 + ch_i * ch_ww;
      ch_on = K_e[ch_nn] > 0;
      ng_col(ch_on ? NG_ACCENT : 0x2d2b28, 1);
      gfx_rect(X(ch_x + 0.5), Y(156), (ch_ww - 1) * ng_s, 44 * ng_s);
      ch_pc == 0 ? (
        ng_font(1, 6, 1);
        ng_col(ch_on ? NG_BG : NG_MUTED, 1);
        sprintf(#ch_c, "C%d", floor(ch_nn / 12) - 1);
        ng_txt(#ch_c, ch_x + ch_ww / 2, 156 + 44 - 5, 1, 0);
      );
      ch_i += 1;
    );
    ch_nn += 1;
  );
  ch_i = 0; ch_nn = 36;
  loop(61,
    ch_pc = ch_nn - floor(ch_nn / 12) * 12;
    ch_white(ch_pc) ? ch_i += 1 : (
      ch_x = 24 + ch_i * ch_ww - ch_bw / 2;
      ng_col(NG_CARD, 1);
      gfx_rect(X(ch_x - 1), Y(156), (ch_bw + 2) * ng_s, (ch_bh + 1) * ng_s);
      ng_col(K_e[ch_nn] > 0 ? NG_ACCENT : 0x131211, 1);
      gfx_rect(X(ch_x), Y(156), ch_bw * ng_s, ch_bh * ng_s);
    );
    ch_nn += 1;
  );

  // controls
  ng_row(6);
  ch_v1 = slider1; ch_l = floor(ch_v1 + 0.0001); ch_f = ch_v1 - ch_l;
  ch_f < 0.005 ? sprintf(#ch_s1, "%s", ch_l == 0 ? "A" : ch_l == 1 ? "E" : ch_l == 2 ? "I" : ch_l == 3 ? "O" : "U")
    : sprintf(#ch_s1, "%s>%s %d%%", ch_l == 0 ? "A" : ch_l == 1 ? "E" : ch_l == 2 ? "I" : "O", ch_l == 0 ? "E" : ch_l == 1 ? "I" : ch_l == 2 ? "O" : "U", floor(ch_f * 100 + 0.5));
  ng_knob_ctl(1, "VOWEL", #ch_s1, 0, 4, 0, 0.01, 0) ? update();
  sprintf(#ch_s2, "%d", slider2);
  ng_knob_ctl(2, "VOICES", #ch_s2, 1, 8, 8, 1, 0) ? update();
  sprintf(#ch_s3, "%d ct", slider3);
  ng_knob_ctl(3, "DETUNE", #ch_s3, 0, 40, 11, 1, 0) ? update();
  sprintf(#ch_s4, "%d%%", slider4);
  ng_knob_ctl(4, "BREATH", #ch_s4, 0, 100, 25, 1, 0) ? update();
  sprintf(#ch_s5, "%d%%", slider5);
  ng_knob_ctl(5, "VIBRATO", #ch_s5, 0, 100, 35, 1, 0) ? update();
  sprintf(#ch_s6, "%.1f Hz", slider6);
  ng_knob_ctl(6, "RATE", #ch_s6, 3, 8, 5.4, 0.1, 0) ? update();

  ng_row(6);
  ng_select_ctl(7, "SECTION", "AUTO|SOPRANO|ALTO|TENOR|BASS", 0) ? update();
  slider8 >= 1000 ? sprintf(#ch_s8, "%.2f s", slider8 / 1000) : sprintf(#ch_s8, "%d ms", slider8);
  ng_knob_ctl_log(8, "ATTACK", #ch_s8, 5, 3000, 250, 1) ? update();
  slider9 >= 1000 ? sprintf(#ch_s9, "%.2f s", slider9 / 1000) : sprintf(#ch_s9, "%d ms", slider9);
  ng_knob_ctl_log(9, "RELEASE", #ch_s9, 20, 5000, 600, 1) ? update();
  sprintf(#ch_s10, "%d%%", slider10);
  ng_knob_ctl(10, "BRIGHTNESS", #ch_s10, 0, 100, 50, 1, 0) ? update();
  sprintf(#ch_s11, "%d%%", slider11);
  ng_knob_ctl(11, "VELOCITY", #ch_s11, 0, 100, 100, 1, 0) ? update();
  sprintf(#ch_s12, "%d%%", slider12);
  ng_knob_ctl(12, "STEREO", #ch_s12, 0, 100, 100, 1, 0) ? update();

  ng_row(3);
  ng_select_ctl(13, "MPE", "OFF|ON", 0) ? update();
  sprintf(#ch_s14, "%d st", slider14);
  ng_knob_ctl(14, "BEND RANGE", #ch_s14, 0, 96, 48, 1, 0) ? update();
  sprintf(#ch_s15, "%+.1f dB", slider15);
  ng_knob_ctl(15, "VOLUME", #ch_s15, -24, 12, 0, 0.1, 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
