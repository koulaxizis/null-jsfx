  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Up & Down 8ths";
    p == 2 ? s = "Two Octave Run";
    p == 3 ? s = "Trance Pulse";
    p == 4 ? s = "Swing Shuffle";
    p == 5 ? s = "Triplet Cascade";
    p == 6 ? s = "Random Sparkle";
    p == 7 ? s = "Chord Stabs";
    p == 8 ? s = "Latched Pad Arp";
    p == 9 ? s = "As Played";
    p == 10 ? s = "Dotted Eighths";
    p == 11 ? s = "Accent on the Beat";
    p == 12 ? s = "Legato Lead";
    p == 13 ? s = "Fast 32nds";
    p == 14 ? s = "Offbeat Skips";
    p == 15 ? s = "Quarter Chords";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@block
  playing = play_state & 1;
  bps = 60 * srate;
  bps = max(1, tempo) / bps;
  // the random pattern starts from the seed again when it changes and at every transport start
  (playing && !was_play) || seed_v != pm_seed ? ( pm_seed = seed_v; pm = 12345 + seed_v * 7919; );
  // the transport stopped: release everything
  was_play && !playing ? ar_cut(bpos, -1);
  b0 = playing ? beat_position : fb;
  // Latch turned off: the keys no longer held leave the arp
  !latch ? (
    ar_i = 0;
    while (ar_i < nl) ( ACT[LC[ar_i] * 128 + LN[ar_i]] ? ar_i += 1 : ar_remove(ar_i); );
    nl == 0 && run ? ( run = 0; ar_end(bpos, -1); );
  );
  // on the grid: the host's step at a transport start, after a jump or a new Rate
  run ? (
    ar_kb = ar_first(b0);
    (playing && !was_play) || next_k < ar_kb - 1 || next_k > ar_kb + 1 ? next_k = ar_kb;
  );
  was_play = playing;

  while (midirecv(m_ofs, m_1, m_2, m_3)) (
    ar_steps(m_ofs);
    ar_in(m_ofs, m_1, m_2, m_3);
  );
  ar_steps(samplesblock);
  !run ? cur_step = -1;

  b_end = bpos + samplesblock;
  q_i = 0;
  while (q_i < qn && Q[q_i * 4] < b_end) (
    ar_emit(Q[q_i * 4] - bpos, Q[q_i * 4 + 1], Q[q_i * 4 + 2], Q[q_i * 4 + 3]);
    q_i += 1;
  );
  q_i > 0 ? (
    q_j = 0;
    loop((qn - q_i) * 4, Q[q_j] = Q[q_j + q_i * 4]; q_j += 1;);
    qn -= q_i;
  );
  fb = b0 + samplesblock * bps;
  bpos = b_end;

@sample
  // the audio passes through
  spl0 = spl0;
  spl1 = spl1;

@gfx 480 430
  ng_knobs_begin("ARPEGGIATOR", "MIDI", 480, 170, 2, 0);

  // display: the pattern, rate and octaves with the tempo and whether it follows the host; the
  // velocity lane (drag over the bars to draw it, wheel over a bar for 5 % steps), the step
  // playing lit, the steps past Steps dimmed; a keyboard C2..C7 with the notes in the arp marked
  // on top and the notes sounding silver
  kb_scan();
  g_cur = cur_step;
  g_n = max(1, min(16, floor(steps + 0.5)));
  sprintf(#g_l, "%s  %s  %d OCT%s",
    pat == 0 ? "UP" : pat == 1 ? "DOWN" : pat == 2 ? "UP-DOWN" : pat == 3 ? "DOWN-UP" : pat == 4 ? "PLAYED" : pat == 5 ? "RANDOM" : "CHORD",
    rate == 0 ? "1/4" : rate == 1 ? "1/4D" : rate == 2 ? "1/4T" : rate == 3 ? "1/8" : rate == 4 ? "1/8D" : rate == 5 ? "1/8T" :
    rate == 6 ? "1/16" : rate == 7 ? "1/16D" : rate == 8 ? "1/16T" : "1/32", oct, latch ? "  LATCH" : "");
  sprintf(#g_r, "%d BPM  %s", floor((tempo > 0 ? tempo : 120) + 0.5), play_state & 1 ? "SYNC" : "FREE");
  ng_font(1, 7.5, 1);
  ng_col(NG_MUTED, 1);
  ng_txt(#g_l, 24, 70, 0, 1.2);
  ng_txt(#g_r, 456, 70, 2, 1.2);

  g_k = 0;
  loop(16,
    g_x = 24 + g_k * 27;
    g_in = g_k < g_n;
    ng_col(g_k == g_cur ? NG_BORDER : NG_BG, 1);
    gfx_rect(X(g_x + 1), Y(80), 25 * ng_s, 64 * ng_s);
    g_v = LANE[g_k];
    g_h = 64 * g_v / 100;
    ng_col(NG_ACCENT, g_k == g_cur ? 1 : g_in ? 0.55 : 0.15);
    g_h > 0 ? gfx_rect(X(g_x + 3), Y(144 - g_h), 21 * ng_s, g_h * ng_s);
    sprintf(#g_num, "%d", g_k + 1);
    ng_font(4, 7, 0);
    ng_col(g_k == g_cur ? NG_TEXT : NG_MUTED, g_in ? 1 : 0.5);
    ng_txt(#g_num, g_x + 13.5, 151, 1, 0);
    // drawing the lane, the wheel
    g_hover = mouse_x >= X(g_x) && mouse_x < X(g_x + 27) && mouse_y >= Y(80) && mouse_y < Y(144);
    g_hover && mouse_wheel != 0 && !ng_pre_open ? (
      ng_slider_set(9 + g_k, max(0, min(100, g_v + (mouse_wheel > 0 ? 5 : -5)))) ? update();
    );
    g_k += 1;
  );
  ng_click && mouse_x >= X(24) && mouse_x < X(456) && mouse_y >= Y(80) && mouse_y < Y(144) ? g_drag = 1;
  !ng_lmb || ng_pre_open ? g_drag = 0;
  g_drag ? (
    g_k = max(0, min(15, floor((mouse_x - X(24)) / (27 * ng_s))));
    g_v = max(0, min(100, floor(100 * (Y(144) - mouse_y) / (64 * ng_s) + 0.5)));
    ng_slider_set(9 + g_k, g_v) ? update();
  );

  kb_draw(24, 160, 432, 52, 36, 96);

  ng_row(6);
  ng_select_ctl(1, "RATE", "1/4|1/4D|1/4T|1/8|1/8D|1/8T|1/16|1/16D|1/16T|1/32", 0) ? update();
  ng_select_ctl(2, "PATTERN", "UP|DOWN|UP-DN|DN-UP|PLAYED|RANDOM|CHORD", 0) ? update();
  sprintf(#v3, "%d", slider3);
  ng_knob_ctl(3, "OCTAVES", #v3, 1, 4, 1, 1, 0) ? update();
  sprintf(#v4, "%d%%", slider4);
  ng_knob_ctl(4, "GATE", #v4, 5, 200, 50, 1, 0) ? update();
  sprintf(#v5, "%d%%", slider5);
  ng_knob_ctl(5, "SWING", #v5, 0, 100, 0, 1, 0) ? update();
  ng_select_ctl(6, "LATCH", "OFF|ON", 0) ? update();
  ng_row(2);
  sprintf(#v7, "%d", slider7);
  ng_knob_ctl(7, "STEPS", #v7, 1, 16, 16, 1, 0) ? update();
  sprintf(#v8, "%d", slider8);
  ng_knob_ctl(8, "SEED", #v8, 1, 9999, 1, 1, 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
