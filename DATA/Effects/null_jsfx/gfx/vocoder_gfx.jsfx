desc:NULL Vocoder GFX
author: Christos Koulaxizis
tags: vocoder talkbox robot voice synth carrier modulator filterbank gui
//category: Advanced
//NULL JSFX v4.0 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:1<0,3,1{Right Input,Saw,Pulse,Noise}>-Carrier
slider2:110<40,880,0.1>-Carrier Pitch (Hz)
slider3:0<-12,12,0.1>-Formant Shift (semitones)
slider4:5<0.5,50,0.1>-Attack (ms)
slider5:40<5,500,1>-Release (ms)
slider6:20<0,100,1>-Sibilance (%)
slider7:100<0,100,1>-Mix (%)
slider8:0<-12,24,0.1>-Output (dB)
slider9:60<0,100,1>-Stereo Width (%)
slider10:0<0,1,1{Channel,Talkbox}>-Mode

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // NULL Vocoder (../vocoder.jsfx) with its own interface: same audio code, plus @gfx.
  gfx_ext_retina = 1;
  // 16-band channel vocoder. The modulator (your voice) is the LEFT input; the carrier
  // is either the RIGHT input (route a synth there) or a built-in saw, pulse or noise
  // oscillator at Carrier Pitch. The voice's level in each band is measured and imposed
  // on the same band of the carrier, so the carrier "speaks". Formant Shift moves the
  // carrier bands up or down for smaller/bigger voices; Sibilance lets the voice's
  // highs (s, t, ch) through so words stay clear. Stereo Width spreads the bands:
  // even bands lean left, odd bands lean right (equal power; 0% = mono centre,
  // 100% = alternate bands hard left / hard right). The sibilance stays centred.
  // Mode Talkbox (4.0) replaces the 16 bands with linear prediction, as a talkbox does:
  // every quarter of a 32 ms window the voice (pre-emphasised, Hann windowed) gets an
  // all-pole model of order srate / 1000 + 2 (at most 40) by Levinson-Durbin; the carrier
  // (pre-emphasised unless it is the noise, and brought to a steady level) goes through that
  // model as a lattice whose coefficients glide over the quarter, scaled to the voice's level
  // and de-emphasised. The result is centred; Formant Shift, Attack, Release and Stereo Width
  // shape the Channel mode only. Sibilance, Mix and Output work in both.
  nb = 16;
  // memory: 32 slots per band = modulator coefs [0..2], carrier coefs [3..5],
  // modulator filter state [8..15], carrier filter state [16..23], envelope [24],
  // left/right band gains [25..26]
  TBP = min(40, floor(srate / 1000) + 2);   // the order
  TBN = floor(0.032 * srate);                 // the window
  TBH = max(1, floor(TBN / 4));               // the hop
  TBK = nb * 32;               // reflection coefficients in use (41)
  TBG = TBK + 41;              // their targets (41)
  TBD = TBG + 41;              // their steps (41)
  TBB = TBD + 41;              // the lattice's backward state (41)
  TBA = TBB + 41;              // prediction coefficients (41)
  TBT = TBA + 41;              // scratch (41)
  TBR = TBT + 41;              // autocorrelation (41)
  TBE = TBR + 41;              // the model's level at the 16 band centres, for the display (16)
  TBM = TBE + 16;              // the voice ring (N)
  TBW = TBM + TBN;             // the Hann window (N)
  TBF = TBW + TBN;             // one windowed frame (N)
  freembuf(TBF + TBN);
  memset(0, 0, TBF + TBN);
  tb_ww = 0;
  i = 0;
  loop(TBN, TBW[i] = 0.5 - 0.5 * cos(2 * $pi * (i + 0.5) / TBN); tb_ww += TBW[i] * TBW[i]; i += 1;);
  tb_wp = tb_cnt = 0;
  tb_mx = tb_cx = tb_y = 0;    // pre-emphasis memories, the de-emphasis output
  tb_ce = 0;                   // the carrier's power
  tb_g = tb_gt = tb_gd = 0;    // the gain, its target and step
  tb_ca = exp(-1 / (0.02 * srate));
  tb_e8 = 10 ^ -8;
  tb_e10 = 10 ^ -10;
  TBL = 1.25;                  // the Talkbox level against the Channel mode
  osc = 0;
  sib_x = sib_y = 0;
  // noise carrier: Park-Miller generator in exact double arithmetic (same on every CPU)
  seed = 12345;

  // band-pass coefficients for band i at centre f (stored in the band's block)
  function set_bp(b, f) local(w, al, n)
  (
    w = 2 * $pi * min(f, srate * 0.45) / srate;
    al = sin(w) / (2 * 6);
    n = 1 / (1 + al);
    b[0] = al * n; b[1] = -2 * cos(w) * n; b[2] = (1 - al) * n;
  );
  // two cascaded band-passes (steeper bands); state at s[0..3], s[4..7]
  function bp2(b, s, x) local(y)
  (
    y = b[0] * (x - s[1]) - b[1] * s[2] - b[2] * s[3];
    s[1] = s[0]; s[0] = x; s[3] = s[2]; s[2] = y;
    x = y;
    y = b[0] * (x - s[5]) - b[1] * s[6] - b[2] * s[7];
    s[5] = s[4]; s[4] = x; s[7] = s[6]; s[6] = y;
    y;
  );
  // one analysis: the model of the last N samples of the voice, then the steps towards it
  function tb_frame() local(i, j, acc, k, e, re, im, w, f, stop)
  (
    i = 0;
    loop(TBN, TBF[i] = TBM[(tb_wp + i) % TBN] * TBW[i]; i += 1;);
    j = 0;
    loop(TBP + 1,
      acc = 0;
      i = j;
      loop(TBN - j, acc += TBF[i] * TBF[i - j]; i += 1;);
      TBR[j] = acc;
      j += 1;
    );
    memset(TBA, 0, 41);
    TBR[0] > tb_ww * tb_e10 ? (
      e = TBR[0] * 1.0001;
      stop = 0;
      i = 1;
      loop(TBP,
        acc = TBR[i];
        j = 1;
        loop(i - 1, acc += TBA[j] * TBR[i - j]; j += 1;);
        // the recursion stops at the first |k| >= 0.995 (the orders above stay 0): clamping k
        // instead would leave e out of step with the filter (a pure tone near Nyquist then gave
        // a gain of 1e8)
        k = stop ? 0 : -acc / e;
        abs(k) >= 0.995 ? ( stop = 1; k = 0; );
        j = 1;
        loop(i - 1, TBT[j] = TBA[j] + k * TBA[i - j]; j += 1;);
        j = 1;
        loop(i - 1, TBA[j] = TBT[j]; j += 1;);
        TBA[i] = k;
        TBG[i] = k;
        e *= 1 - k * k;
        i += 1;
      );
      tb_gt = sqrt(e / tb_ww);
    ) : (
      memset(TBG, 0, 41);
      tb_gt = 0;
    );
    i = 1;
    loop(TBP, TBD[i] = (TBG[i] - TBK[i]) / TBH; i += 1;);
    tb_gd = (tb_gt - tb_g) / TBH;
    // the display: the model's level in each band, as the Channel mode's envelopes would read it
    i = 0;
    loop(nb,
      f = 100 * (8000 / 100) ^ (i / (nb - 1));
      w = 2 * $pi * min(f, srate * 0.45) / srate;
      re = 1; im = 0;
      j = 1;
      loop(TBP, re += TBA[j] * cos(w * j); im -= TBA[j] * sin(w * j); j += 1;);
      TBE[i] = 0.8 * tb_gt / sqrt(max(re * re + im * im, tb_e10)) / sqrt(1 - 1.94 * cos(w) + 0.9409) * sqrt(2 * f / 9 / srate);
      i += 1;
    );
  );

  function update()
  (
    src = slider1;
    inc = slider2 / srate;
    shift = 2 ^ (slider3 / 12);
    att = exp(-1 / (slider4 / 1000 * srate));
    rel = exp(-1 / (slider5 / 1000 * srate));
    sib = slider6 / 100;
    width = slider9 / 100;
    mix = slider7 / 100;
    out = 10 ^ (slider8 / 20) * 30;
    i = 0;
    loop(nb,
      f = 100 * (8000 / 100) ^ (i / (nb - 1));   // 100 Hz .. 8 kHz, log spaced
      set_bp(i * 32, f);                           // modulator band
      set_bp(i * 32 + 3, f * shift);               // carrier band
      th = $pi / 4 * (1 + (i % 2 ? width : -width));
      (i * 32)[25] = sqrt(2) * cos(th);             // left gain (1 at width 0)
      (i * 32)[26] = sqrt(2) * sin(th);             // right gain
      i += 1;
    );
    sib_c = exp(-2 * $pi * 6000 / srate);
    talk = slider10;
    tout = 10 ^ (slider8 / 20) * TBL;
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 15;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1); ng_hist_add(2); ng_hist_add(3); ng_hist_add(4); ng_hist_add(5); ng_hist_add(6); ng_hist_add(7); ng_hist_add(8); ng_hist_add(9); ng_hist_add(10);
  ng_hist_init();

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 1); ng_slider_set(2, 110); ng_slider_set(3, 0); ng_slider_set(4, 5); ng_slider_set(5, 40); ng_slider_set(6, 20); ng_slider_set(7, 100); ng_slider_set(8, 0); ng_slider_set(9, 60); ng_slider_set(10, 0); );
    p == 1 ? ( ng_slider_set(1, 1); ng_slider_set(2, 82.4); ng_slider_set(3, 0); ng_slider_set(4, 3); ng_slider_set(5, 30); ng_slider_set(6, 25); ng_slider_set(7, 100); ng_slider_set(8, 0); ng_slider_set(9, 60); ng_slider_set(10, 0); );
    p == 2 ? ( ng_slider_set(1, 0); ng_slider_set(2, 110); ng_slider_set(3, 0); ng_slider_set(4, 3); ng_slider_set(5, 35); ng_slider_set(6, 30); ng_slider_set(7, 100); ng_slider_set(8, 6.7); ng_slider_set(9, 60); ng_slider_set(10, 0); );
    p == 3 ? ( ng_slider_set(1, 3); ng_slider_set(2, 110); ng_slider_set(3, 0); ng_slider_set(4, 5); ng_slider_set(5, 60); ng_slider_set(6, 40); ng_slider_set(7, 100); ng_slider_set(8, 14.7); ng_slider_set(9, 80); ng_slider_set(10, 0); );
    p == 4 ? ( ng_slider_set(1, 2); ng_slider_set(2, 220); ng_slider_set(3, 2); ng_slider_set(4, 5); ng_slider_set(5, 80); ng_slider_set(6, 20); ng_slider_set(7, 100); ng_slider_set(8, 0); ng_slider_set(9, 100); ng_slider_set(10, 0); );
    p == 5 ? ( ng_slider_set(1, 1); ng_slider_set(2, 55); ng_slider_set(3, -5); ng_slider_set(4, 5); ng_slider_set(5, 50); ng_slider_set(6, 10); ng_slider_set(7, 100); ng_slider_set(8, 6.5); ng_slider_set(9, 60); ng_slider_set(10, 0); );
    p == 6 ? ( ng_slider_set(1, 2); ng_slider_set(2, 440); ng_slider_set(3, 6); ng_slider_set(4, 5); ng_slider_set(5, 40); ng_slider_set(6, 30); ng_slider_set(7, 100); ng_slider_set(8, -9); ng_slider_set(9, 60); ng_slider_set(10, 0); );
    p == 7 ? ( ng_slider_set(1, 1); ng_slider_set(2, 110); ng_slider_set(3, 0); ng_slider_set(4, 1); ng_slider_set(5, 20); ng_slider_set(6, 10); ng_slider_set(7, 100); ng_slider_set(8, 0); ng_slider_set(9, 60); ng_slider_set(10, 0); );
    p == 8 ? ( ng_slider_set(1, 1); ng_slider_set(2, 130.8); ng_slider_set(3, 0); ng_slider_set(4, 15); ng_slider_set(5, 150); ng_slider_set(6, 15); ng_slider_set(7, 100); ng_slider_set(8, 0); ng_slider_set(9, 90); ng_slider_set(10, 0); );
    p == 9 ? ( ng_slider_set(1, 1); ng_slider_set(2, 65.4); ng_slider_set(3, 0); ng_slider_set(4, 2); ng_slider_set(5, 25); ng_slider_set(6, 20); ng_slider_set(7, 100); ng_slider_set(8, 0); ng_slider_set(9, 60); ng_slider_set(10, 0); );
    p == 10 ? ( ng_slider_set(1, 2); ng_slider_set(2, 110); ng_slider_set(3, 0); ng_slider_set(4, 2); ng_slider_set(5, 30); ng_slider_set(6, 35); ng_slider_set(7, 100); ng_slider_set(8, 0); ng_slider_set(9, 30); ng_slider_set(10, 0); );
    p == 11 ? ( ng_slider_set(1, 1); ng_slider_set(2, 220); ng_slider_set(3, 0); ng_slider_set(4, 5); ng_slider_set(5, 40); ng_slider_set(6, 25); ng_slider_set(7, 100); ng_slider_set(8, 0); ng_slider_set(9, 60); ng_slider_set(10, 1); );
    p == 12 ? ( ng_slider_set(1, 0); ng_slider_set(2, 110); ng_slider_set(3, 0); ng_slider_set(4, 5); ng_slider_set(5, 40); ng_slider_set(6, 20); ng_slider_set(7, 100); ng_slider_set(8, 0); ng_slider_set(9, 60); ng_slider_set(10, 1); );
    p == 13 ? ( ng_slider_set(1, 2); ng_slider_set(2, 110); ng_slider_set(3, 0); ng_slider_set(4, 5); ng_slider_set(5, 40); ng_slider_set(6, 30); ng_slider_set(7, 100); ng_slider_set(8, 0); ng_slider_set(9, 60); ng_slider_set(10, 1); );
    p == 14 ? ( ng_slider_set(1, 3); ng_slider_set(2, 110); ng_slider_set(3, 0); ng_slider_set(4, 5); ng_slider_set(5, 40); ng_slider_set(6, 40); ng_slider_set(7, 100); ng_slider_set(8, 0); ng_slider_set(9, 60); ng_slider_set(10, 1); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 110) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 5) && ng_pre_eq(slider5, 40) && ng_pre_eq(slider6, 20) && ng_pre_eq(slider7, 100) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 60) && ng_pre_eq(slider10, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 82.4) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 3) && ng_pre_eq(slider5, 30) && ng_pre_eq(slider6, 25) && ng_pre_eq(slider7, 100) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 60) && ng_pre_eq(slider10, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 110) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 3) && ng_pre_eq(slider5, 35) && ng_pre_eq(slider6, 30) && ng_pre_eq(slider7, 100) && ng_pre_eq(slider8, 6.7) && ng_pre_eq(slider9, 60) && ng_pre_eq(slider10, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 3) && ng_pre_eq(slider2, 110) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 5) && ng_pre_eq(slider5, 60) && ng_pre_eq(slider6, 40) && ng_pre_eq(slider7, 100) && ng_pre_eq(slider8, 14.7) && ng_pre_eq(slider9, 80) && ng_pre_eq(slider10, 0) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 220) && ng_pre_eq(slider3, 2) && ng_pre_eq(slider4, 5) && ng_pre_eq(slider5, 80) && ng_pre_eq(slider6, 20) && ng_pre_eq(slider7, 100) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 100) && ng_pre_eq(slider10, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 55) && ng_pre_eq(slider3, -5) && ng_pre_eq(slider4, 5) && ng_pre_eq(slider5, 50) && ng_pre_eq(slider6, 10) && ng_pre_eq(slider7, 100) && ng_pre_eq(slider8, 6.5) && ng_pre_eq(slider9, 60) && ng_pre_eq(slider10, 0) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 440) && ng_pre_eq(slider3, 6) && ng_pre_eq(slider4, 5) && ng_pre_eq(slider5, 40) && ng_pre_eq(slider6, 30) && ng_pre_eq(slider7, 100) && ng_pre_eq(slider8, -9) && ng_pre_eq(slider9, 60) && ng_pre_eq(slider10, 0) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 110) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 1) && ng_pre_eq(slider5, 20) && ng_pre_eq(slider6, 10) && ng_pre_eq(slider7, 100) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 60) && ng_pre_eq(slider10, 0) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 130.8) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 15) && ng_pre_eq(slider5, 150) && ng_pre_eq(slider6, 15) && ng_pre_eq(slider7, 100) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 90) && ng_pre_eq(slider10, 0) ? m = 8;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 65.4) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 2) && ng_pre_eq(slider5, 25) && ng_pre_eq(slider6, 20) && ng_pre_eq(slider7, 100) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 60) && ng_pre_eq(slider10, 0) ? m = 9;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 110) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 2) && ng_pre_eq(slider5, 30) && ng_pre_eq(slider6, 35) && ng_pre_eq(slider7, 100) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 30) && ng_pre_eq(slider10, 0) ? m = 10;
    m < 0 && ng_pre_eq(slider1, 1) && ng_pre_eq(slider2, 220) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 5) && ng_pre_eq(slider5, 40) && ng_pre_eq(slider6, 25) && ng_pre_eq(slider7, 100) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 60) && ng_pre_eq(slider10, 1) ? m = 11;
    m < 0 && ng_pre_eq(slider1, 0) && ng_pre_eq(slider2, 110) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 5) && ng_pre_eq(slider5, 40) && ng_pre_eq(slider6, 20) && ng_pre_eq(slider7, 100) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 60) && ng_pre_eq(slider10, 1) ? m = 12;
    m < 0 && ng_pre_eq(slider1, 2) && ng_pre_eq(slider2, 110) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 5) && ng_pre_eq(slider5, 40) && ng_pre_eq(slider6, 30) && ng_pre_eq(slider7, 100) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 60) && ng_pre_eq(slider10, 1) ? m = 13;
    m < 0 && ng_pre_eq(slider1, 3) && ng_pre_eq(slider2, 110) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 5) && ng_pre_eq(slider5, 40) && ng_pre_eq(slider6, 40) && ng_pre_eq(slider7, 100) && ng_pre_eq(slider8, 0) && ng_pre_eq(slider9, 60) && ng_pre_eq(slider10, 1) ? m = 14;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Synth Voice Low";
    p == 2 ? s = "Talking Synth Sidechain";
    p == 3 ? s = "Whisper Noise";
    p == 4 ? s = "Pulse Choir";
    p == 5 ? s = "Deep Monster Voice";
    p == 6 ? s = "Chipmunk Robot";
    p == 7 ? s = "Drum Rhythm Synth";
    p == 8 ? s = "Smooth Pad Vocoder";
    p == 9 ? s = "Talkbox Bass";
    p == 10 ? s = "Robot Announcer";
    p == 11 ? s = "Talkbox Saw Lead";
    p == 12 ? s = "Talkbox Sidechain Synth";
    p == 13 ? s = "Talkbox Pulse Robot";
    p == 14 ? s = "Talkbox Whisper";
    s;
  );

  // the hint line under the controls: a short help text per slider (from tools/site_content.json)
  function ng_hint_text(i) local(s)
  (
    s = "";
    i == 1 ? s = "Carrier source: Right Input (route a synth there) or the built-in Saw, Pulse or Noise";
    i == 2 ? s = "Pitch of the built-in Saw and Pulse oscillators";
    i == 3 ? s = "Shifts the carrier bands up or down for smaller/bigger voices";
    i == 4 ? s = "How fast band envelopes respond to the voice";
    i == 5 ? s = "How fast band envelopes fall";
    i == 6 ? s = "Passes the voice’s highs (above ~6 kHz) for intelligibility";
    i == 7 ? s = "Dry/wet blend";
    i == 8 ? s = "Output level";
    i == 9 ? s = "Spreads the bands across the stereo field: even bands lean left, odd bands right (0% = mono)";
    i == 10 ? s = "How the voice shapes the carrier: Channel measures it in 16 bands, Talkbox models the voice's throat by";
    s;
  );

  function ng_presets() local(i)
  (
    ng_hint_i > 0 && !ng_pre_open ? ng_hint(ng_hint_text(ng_hint_i));
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  mod = spl0;
  osc += inc; osc >= 1 ? osc -= 1;
  car = src == 0 ? spl1 : src == 1 ? 2 * osc - 1 : src == 2 ? (osc < 0.5 ? 1 : -1) :
        (seed *= 16807; seed -= floor(seed / 2147483647) * 2147483647; seed / 1073741824 - 1);

  // the voice ring fills in both modes, so a switch to Talkbox starts from a full window
  TBM[tb_wp] = mod - 0.97 * tb_mx;
  tb_mx = mod;
  tb_wp += 1;
  tb_wp >= TBN ? tb_wp = 0;
  acc_l = acc_r = 0;
  talk ? (
    tb_cnt += 1;
    tb_cnt >= TBH ? ( tb_cnt = 0; tb_frame(); );
    // the carrier, pre-emphasised (the noise is white already) at a steady level, through
    // the lattice
    c = src == 3 ? car : car - 0.97 * tb_cx;
    tb_cx = car;
    tb_ce = tb_ca * tb_ce + (1 - tb_ca) * c * c;
    x = c / sqrt(max(tb_ce, tb_e8));
    tb_g += tb_gd;
    j = TBP;
    loop(TBP,
      TBK[j] += TBD[j];
      x -= TBK[j] * TBB[j - 1];
      TBB[j] = TBB[j - 1] + TBK[j] * x;
      j -= 1;
    );
    TBB[0] = x;
    tb_y = x * tb_g + 0.97 * tb_y;
    acc_l = acc_r = tb_y * tout;
  ) : (
  i = 0;
  loop(nb,
    b = i * 32;
    m = bp2(b, b + 8, mod);
    c = bp2(b + 3, b + 16, car);
    lev = abs(m);
    env = b[24];
    env = lev > env ? att * env + (1 - att) * lev : rel * env + (1 - rel) * lev;
    b[24] = env;
    c *= env;
    acc_l += c * b[25];
    acc_r += c * b[26];
    i += 1;
  );
  acc_l *= out;
  acc_r *= out;
  );
  // let the voice's highest frequencies through for intelligibility
  sib_y = sib_c * (sib_y + mod - sib_x); sib_x = mod;
  wet_l = acc_l + sib_y * sib;
  wet_r = acc_r + sib_y * sib;
  spl0 = spl0 * (1 - mix) + wet_l * mix;
  spl1 = spl1 * (1 - mix) + wet_r * mix;

@gfx 480 380
  ng_knobs_begin("VOCODER", "ADVANCED", 480, 120, 2, 0);

  // display: the voice's level in each of the 16 bands (0 to -60 dB) at the band centres on a
  // log-frequency axis; ticks at the bottom mark the carrier bands (moved by Formant Shift).
  // In Talkbox mode the bars show the voice's model at the band centres, without ticks.
  ng_plot(ng_vx + 26, ng_vy + 4, ng_vw - 30, ng_vh - 20);
  ng_grid(1, 4, 0);
  ng_font(4, 8, 0);
  ng_col(NG_MUTED, 1);
  ng_ptxt("0", ng_px - 6 * ng_s, ng_py, 2);
  ng_ptxt("-30", ng_px - 6 * ng_s, ng_py + ng_ph / 2, 2);
  ng_ptxt("-60", ng_px - 6 * ng_s, ng_py + ng_ph, 2);
  ng_ptxt("100", ng_freq_x(100), ng_py + ng_ph + 10 * ng_s, 1);
  ng_ptxt("1k", ng_freq_x(1000), ng_py + ng_ph + 10 * ng_s, 1);
  ng_ptxt("8k", ng_freq_x(8000), ng_py + ng_ph + 10 * ng_s, 1);
  vc_bw = max(2, 6 * ng_s);
  vc_i = 0;
  loop(nb,
    vc_f = 100 * (8000 / 100) ^ (vc_i / (nb - 1));
    vc_y = ng_lin_y(20 * log10(max(talk ? TBE[vc_i] : (vc_i * 32)[24], 0.000001)), -60, 0);
    ng_col(NG_ACCENT, 1);
    vc_y < ng_py + ng_ph - 1 ? gfx_rect(ng_freq_x(vc_f) - vc_bw / 2, vc_y, vc_bw, ng_py + ng_ph - vc_y);
    ng_col(NG_MUTED, 1);
    !talk ? gfx_line(ng_freq_x(vc_f * 2 ^ (slider3 / 12)), ng_py + ng_ph - 1, ng_freq_x(vc_f * 2 ^ (slider3 / 12)), ng_py + ng_ph - 7 * ng_s, 1);
    vc_i += 1;
  );

  ng_row(6);
  ng_select_ctl(1, "CARRIER", "RIGHT|SAW|PULSE|NOISE", 0) ? update();
  sprintf(#v2, "%.1f Hz", slider2);
  ng_knob_ctl(2, "PITCH", #v2, 40, 880, 110, 0.1, 0) ? update();
  sprintf(#v3, "%.1f st", slider3);
  ng_knob_ctl(3, "FORMANT", #v3, -12, 12, 0, 0.1, 1) ? update();
  sprintf(#v4, "%.1f ms", slider4);
  ng_knob_ctl(4, "ATTACK", #v4, 0.5, 50, 5, 0.1, 0) ? update();
  sprintf(#v5, "%d ms", slider5);
  ng_knob_ctl(5, "RELEASE", #v5, 5, 500, 40, 1, 0) ? update();
  sprintf(#v6, "%d%%", slider6);
  ng_knob_ctl(6, "SIBILANCE", #v6, 0, 100, 20, 1, 0) ? update();
  ng_row(4);
  sprintf(#v7, "%d%%", slider7);
  ng_knob_ctl(7, "MIX", #v7, 0, 100, 100, 1, 0) ? update();
  sprintf(#v8, "%.1f dB", slider8);
  ng_knob_ctl(8, "OUTPUT", #v8, -12, 24, 0, 0.1, 0) ? update();
  sprintf(#v9, "%d%%", slider9);
  ng_knob_ctl(9, "WIDTH", #v9, 0, 100, 60, 1, 0) ? update();
  ng_select_ctl(10, "MODE", "CHANNEL|TALKBOX", 0) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
