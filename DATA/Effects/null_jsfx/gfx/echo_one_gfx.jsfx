desc:NULL Echo One GFX
author: Christos Koulaxizis
tags: delay echo slapback ping-pong tempo sync repeats filtered tape gui
//category: One Slider
//NULL JSFX v4.1.1 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:40<0,100,1>-Amount

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // NULL Echo One (../echo_one.jsfx) with its own interface: same audio code, plus @gfx.
  // One-knob delay locked to the project tempo (120 bpm when the host gives none). Amount moves
  // from a soft 1/16 slapback through 1/8 and dotted 1/8 to a long 1/4 ping-pong: the time
  // steps up, the feedback, the wet level and the ping-pong spread rise, and the repeats get
  // darker (a low-pass falling from 7 to 3 kHz and a 150 Hz high-pass in the loop). The delay
  // time glides (80 ms) to its new value, so a change sounds like tape, never a click.
  ec_n = ceil(srate * 2) + 4;  // 2 s per channel: a 1/4 note down to 30 bpm
  ec_bl = 0;
  ec_br = ec_n;
  memset(0, 0, ec_n * 2); freembuf(ec_n * 2);
  ec_wp = 0;
  ec_dt = -1;                  // the delay time in samples; -1 until the first sample sets it
  ec_glide = 1 - exp(-1 / (0.08 * srate));
  ec_hpc = 1 - exp(-2 * $pi * 150 / srate);
  ec_lpl = ec_lpr = ec_hpl = ec_hpr = 0;

  // the note length (beats) for an Amount from 0 to 100
  function ec_beats(v) ( v < 25 ? 0.25 : v < 50 ? 0.5 : v < 75 ? 0.75 : 1; );
  gfx_ext_retina = 1;

  function update()
  (
    ec_a = slider1 / 100;
    ec_note = ec_beats(slider1);
    ec_fb = 0.12 + ec_a * 0.5;
    ec_wet = ec_a * 0.5;
    ec_dry = 1 - ec_a * 0.25;
    ec_pp = min(1, max(0, (ec_a - 0.25) * 2));
    ec_lpc = 1 - exp(-2 * $pi * min(7000 - ec_a * 4000, 0.45 * srate) / srate);
  );

  // the note name of an Amount
  function ec_name(v) ( v < 25 ? "1/16" : v < 50 ? "1/8" : v < 75 ? "1/8 DOTTED" : "1/4"; );

  // a text at pixel (x, y), vertically centred; align 0 left, 1 centre, 2 right
  function ec_lbl(str, x, y, align) local(w, h)
  (
    gfx_measurestr(str, w, h);
    gfx_x = align == 1 ? x - w / 2 : (align == 2 ? x - w : x);
    gfx_y = y - gfx_texth / 2;
    gfx_drawstr(str);
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 12;
  strcpy(#ng_h_ix, "");
  ng_hist_add(1);
  ng_hist_init();
  ng_dice_add(1, 0, 100, 1, 0);

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 40); );
    p == 1 ? ( ng_slider_set(1, 10); );
    p == 2 ? ( ng_slider_set(1, 18); );
    p == 3 ? ( ng_slider_set(1, 30); );
    p == 4 ? ( ng_slider_set(1, 42); );
    p == 5 ? ( ng_slider_set(1, 55); );
    p == 6 ? ( ng_slider_set(1, 68); );
    p == 7 ? ( ng_slider_set(1, 78); );
    p == 8 ? ( ng_slider_set(1, 90); );
    p == 9 ? ( ng_slider_set(1, 100); );
    p == 10 ? ( ng_slider_set(1, 6); );
    p == 11 ? ( ng_slider_set(1, 62); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 40) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 10) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 18) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 30) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 42) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 55) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 68) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 78) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 90) ? m = 8;
    m < 0 && ng_pre_eq(slider1, 100) ? m = 9;
    m < 0 && ng_pre_eq(slider1, 6) ? m = 10;
    m < 0 && ng_pre_eq(slider1, 62) ? m = 11;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Soft Slapback";
    p == 2 ? s = "Vocal Slap";
    p == 3 ? s = "Eighth Echo";
    p == 4 ? s = "Guitar Eighths";
    p == 5 ? s = "Dotted Lead";
    p == 6 ? s = "Dotted Wide";
    p == 7 ? s = "Quarter Ping-Pong";
    p == 8 ? s = "Dub Throw";
    p == 9 ? s = "Long Wash";
    p == 10 ? s = "Drum Room Echo";
    p == 11 ? s = "Synth Bounce";
    s;
  );

  // the hint line under the controls: a short help text per slider (from tools/site_content.json)
  function ng_hint_text(i) local(s)
  (
    s = "";
    i == 1 ? s = "Delay amount in one move: 0 to 24 is a soft 1/16 slapback, 25 to 49 a 1/8 echo, 50 to 74 a dotted 1/8 and";
    s;
  );

  function ng_presets() local(i)
  (
    ng_hint_i > 0 && !ng_pre_open ? ng_hint(ng_hint_text(ng_hint_i));
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_hist() ? update();
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  ec_in0 = spl0;
  ec_in1 = spl1;
  ec_t = min(ec_n - 3, ec_note * 60 / (tempo > 0 ? tempo : 120) * srate);
  ec_dt < 0 ? ec_dt = ec_t : ec_dt += (ec_t - ec_dt) * ec_glide;
  ec_rp = ec_wp - ec_dt;
  ec_rp < 0 ? ec_rp += ec_n;
  ec_rp >= ec_n ? ec_rp -= ec_n; // a tiny negative read point can round up to ec_n
  ec_i0 = floor(ec_rp);
  ec_fr = ec_rp - ec_i0;
  ec_i1 = ec_i0 + 1;
  ec_i1 >= ec_n ? ec_i1 = 0;
  ec_yl = ec_bl[ec_i0] + (ec_bl[ec_i1] - ec_bl[ec_i0]) * ec_fr;
  ec_yr = ec_br[ec_i0] + (ec_br[ec_i1] - ec_br[ec_i0]) * ec_fr;
  // darker repeats: low-pass, then the high-pass takes the lows out
  ec_lpl += (ec_yl - ec_lpl) * ec_lpc;
  ec_lpr += (ec_yr - ec_lpr) * ec_lpc;
  ec_hpl += (ec_lpl - ec_hpl) * ec_hpc;
  ec_hpr += (ec_lpr - ec_hpr) * ec_hpc;
  ec_fl = ec_lpl - ec_hpl;
  ec_fr2 = ec_lpr - ec_hpr;
  // ping-pong: the input goes in on the left and the repeats cross sides, by ec_pp
  ec_m = (ec_in0 + ec_in1) * 0.5;
  ec_bl[ec_wp] = ec_in0 * (1 - ec_pp) + ec_m * ec_pp + (ec_fl * (1 - ec_pp) + ec_fr2 * ec_pp) * ec_fb;
  ec_br[ec_wp] = ec_in1 * (1 - ec_pp) + (ec_fr2 * (1 - ec_pp) + ec_fl * ec_pp) * ec_fb;
  ec_wp += 1;
  ec_wp >= ec_n ? ec_wp = 0;
  spl0 = ec_in0 * ec_dry + ec_fl * ec_wet;
  spl1 = ec_in1 * ec_dry + ec_fr2 * ec_wet;

@gfx 360 240
  ng_one_slider_begin("ECHO ONE");

  // display: the dry hit at 0 and the repeats over 4 beats (0 to -48 dB, filters left out);
  // with ping-pong the repeats alternate sides, the right ones drawn dimmer
  ng_plot(46, 64, 284, 78);
  ng_grid(4, 4, 0);
  ng_font(4, 8, 0);
  ng_col(NG_MUTED, 1);
  ec_lbl("0", ng_px - 6 * ng_s, floor(ng_py) + 0.5, 2);
  ec_lbl("-24", ng_px - 6 * ng_s, floor(ng_py + ng_ph / 2) + 0.5, 2);
  ec_lbl("-48", ng_px - 6 * ng_s, floor(ng_py + ng_ph) + 0.5, 2);
  ec_lbl("1 beat", ng_px + ng_pw / 4, ng_py + ng_ph + 11 * ng_s, 1);
  ec_lbl("2 beats", ng_px + ng_pw / 2, ng_py + ng_ph + 11 * ng_s, 1);
  ec_lbl("3 beats", ng_px + ng_pw * 3 / 4, ng_py + ng_ph + 11 * ng_s, 1);
  ng_col(NG_ACCENT, 1);
  gfx_rect(ng_px, ng_lin_y(20 * log10(ec_dry), -48, 0), max(2, 2 * ng_s), ng_py + ng_ph - ng_lin_y(20 * log10(ec_dry), -48, 0));
  slider1 > 0 ? (
    ec_k = 1;
    loop(16,
      ec_db = 20 * log10(ec_wet * ec_fb ^ (ec_k - 1));
      ec_x = ng_px + ng_pw * ec_k * ec_note / 4;
      ng_col(NG_ACCENT, ec_pp > 0.5 && ec_k % 2 == 0 ? 0.45 : 1);
      ec_k * ec_note <= 4 && ec_db > -48 ? gfx_rect(min(ec_x, ng_px + ng_pw - 2 * ng_s), ng_lin_y(ec_db, -48, 0), max(2, 2 * ng_s), ng_py + ng_ph - ng_lin_y(ec_db, -48, 0));
      ec_k += 1;
    );
  );

  // slider card
  slider1 == 0 ? sprintf(#cap, "DRY") : sprintf(#cap, "%s  FEEDBACK %d%%  PING-PONG %d%%", ec_name(slider1), floor(ec_fb * 100 + 0.5), floor(ec_pp * 100 + 0.5));
  sprintf(#val, "%d", floor(slider1 + 0.5));
  ng_set_slider(ng_one_slider_control("AMOUNT", #cap, #val, "DRY", "LONG", slider1, 0, 100, 40, 0), 1) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
