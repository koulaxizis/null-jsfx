desc:NULL OTT GFX
author: Christos Koulaxizis
tags: ott multiband upward downward compression edm loud aggressive gui
//category: Advanced
//NULL JSFX v2.3 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:100<0,100,1>-Depth (%)
slider2:100<0,400,1>-Time (%)
slider3:100<0,100,1>-Upward (%)
slider4:100<0,100,1>-Downward (%)
slider5:0<-12,12,0.1>-Low Gain (dB)
slider6:0<-12,12,0.1>-Mid Gain (dB)
slider7:0<-12,12,0.1>-High Gain (dB)
slider8:0<-12,12,0.1>-Output (dB)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  // NULL OTT (../ott.jsfx) with its own interface: same audio code, plus @gfx.
  gfx_ext_retina = 1;
  // "Over The Top" multiband compression: three bands (split at 88 Hz and 2.5 kHz), each
  // squashed from above (loud parts pushed down, 66:1 above -33 dB) and lifted from
  // below (quiet parts brought up, 4:1 below -41 dB, up to +24 dB). Everything gets
  // dense, loud and detailed. Depth blends with the dry signal; Time scales the
  // attack/release; Upward/Downward scale each half of the effect.

  // 2nd-order Butterworth low-pass, two in series = 4th-order Linkwitz-Riley
  function lp_set(freq) local(k, n)
  (
    k = tan($pi * freq / srate);
    n = 1 / (1 + sqrt(2) * k + k * k);
    this.b0 = k * k * n; this.b1 = 2 * this.b0; this.a1 = 2 * (k * k - 1) * n; this.a2 = (1 - sqrt(2) * k + k * k) * n;
  );
  function lp_run(x) local(y)
  (
    y = this.b0 * x + this.s1;
    this.s1 = this.b1 * x - this.a1 * y + this.s2;
    this.s2 = this.b0 * x - this.a2 * y;
    y;
  );

  // gain (linear) for one band from its envelope; envelope state in this.env
  function band_gain(x) local(lev, db, g)
  (
    lev = abs(x);
    this.env = lev > this.env ? att * this.env + (1 - att) * lev : rel * this.env + (1 - rel) * lev;
    db = 20 * log10(max(this.env, 0.000001));
    g = 0;
    db > -33 ? g -= (db + 33) * (1 - 1 / 66) * down;
    db < -41 && db > -80 ? g += min(24, (-41 - db) * (1 - 1 / 4)) * up;
    10 ^ (g / 20);
  );

  function update()
  (
    // each filter stage is its own object (coefficients + state), per channel
    a1l.lp_set(88); a2l.lp_set(88); a1r.lp_set(88); a2r.lp_set(88);
    b1l.lp_set(2500); b2l.lp_set(2500); b1r.lp_set(2500); b2r.lp_set(2500);
    depth = slider1 / 100;
    t = max(slider2, 1) / 100;
    att = exp(-1 / (0.0135 * t * srate));
    rel = exp(-1 / (0.132 * t * srate));
    up = slider3 / 100;
    down = slider4 / 100;
    g_low = 10 ^ (slider5 / 20);
    g_mid = 10 ^ (slider6 / 20);
    g_high = 10 ^ (slider7 / 20);
    // fixed make-up for the downward half, so Depth 100% sits near the input loudness
    makeup = 10 ^ (12 * down / 20);
    out = 10 ^ (slider8 / 20);
  );

  // interface: the gain computer of one band in dB (without the make-up gain)
  function ott_curve(d) local(g)
  (
    g = 0;
    d > -33 ? g -= (d + 33) * (1 - 1 / 66) * down;
    d < -41 && d > -80 ? g += min(24, (-41 - d) * (1 - 1 / 4)) * up;
    d + g;
  );

  // interface: bipolar gain bar (-24..+24 dB) in design units with label and value
  function ott_bar(y, label, db) local(x0, x1, xc, xv)
  (
    ng_font(1, 7.5, 1);
    ng_col(NG_MUTED, 1);
    ng_txt(label, 196, y + 5, 0, 1.5);
    x0 = X(236); x1 = X(ng_dw - 82); xc = (x0 + x1) / 2;
    ng_col(NG_BORDER, 1);
    gfx_rect(x0, Y(y), x1 - x0, 10 * ng_s);
    xv = xc + (x1 - x0) / 2 * max(-1, min(1, db / 24));
    ng_col(NG_ACCENT, 1);
    abs(xv - xc) >= 1 ? gfx_rect(min(xc, xv), Y(y), abs(xv - xc), 10 * ng_s);
    ng_col(NG_MUTED, 1);
    gfx_rect(xc, Y(y - 2), max(1, ng_s), 14 * ng_s);
    ng_font(3, 8.5, 0);
    ng_col(NG_TEXT, 1);
    sprintf(#ott_v, "%.1f dB", db);
    ng_txt(#ott_v, ng_dw - 24, y + 5, 2, 0);
  );

  // ---- factory presets: generated by tools/build_presets.py, do not edit ----
  ng_pre_n = 9;

  function ng_preset_load(p)
  (
    p == 0 ? ( ng_slider_set(1, 100); ng_slider_set(2, 100); ng_slider_set(3, 100); ng_slider_set(4, 100); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 1 ? ( ng_slider_set(1, 25); ng_slider_set(2, 120); ng_slider_set(3, 100); ng_slider_set(4, 100); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 2 ? ( ng_slider_set(1, 60); ng_slider_set(2, 100); ng_slider_set(3, 100); ng_slider_set(4, 80); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); );
    p == 3 ? ( ng_slider_set(1, 50); ng_slider_set(2, 60); ng_slider_set(3, 70); ng_slider_set(4, 100); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, -1); );
    p == 4 ? ( ng_slider_set(1, 35); ng_slider_set(2, 150); ng_slider_set(3, 80); ng_slider_set(4, 60); ng_slider_set(5, -2); ng_slider_set(6, 0); ng_slider_set(7, 1); ng_slider_set(8, 0); );
    p == 5 ? ( ng_slider_set(1, 50); ng_slider_set(2, 100); ng_slider_set(3, 100); ng_slider_set(4, 0); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, -2); );
    p == 6 ? ( ng_slider_set(1, 60); ng_slider_set(2, 100); ng_slider_set(3, 0); ng_slider_set(4, 100); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, -3); );
    p == 7 ? ( ng_slider_set(1, 70); ng_slider_set(2, 80); ng_slider_set(3, 100); ng_slider_set(4, 100); ng_slider_set(5, -2); ng_slider_set(6, 0); ng_slider_set(7, 2); ng_slider_set(8, -1); );
    p == 8 ? ( ng_slider_set(1, 50); ng_slider_set(2, 300); ng_slider_set(3, 100); ng_slider_set(4, 70); ng_slider_set(5, 0); ng_slider_set(6, 0); ng_slider_set(7, 0); ng_slider_set(8, 0); );
  );

  // the first preset every slider matches, or -1
  function ng_preset_match() local(m)
  (
    m = -1;
    m < 0 && ng_pre_eq(slider1, 100) && ng_pre_eq(slider2, 100) && ng_pre_eq(slider3, 100) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 0;
    m < 0 && ng_pre_eq(slider1, 25) && ng_pre_eq(slider2, 120) && ng_pre_eq(slider3, 100) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 1;
    m < 0 && ng_pre_eq(slider1, 60) && ng_pre_eq(slider2, 100) && ng_pre_eq(slider3, 100) && ng_pre_eq(slider4, 80) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 2;
    m < 0 && ng_pre_eq(slider1, 50) && ng_pre_eq(slider2, 60) && ng_pre_eq(slider3, 70) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, -1) ? m = 3;
    m < 0 && ng_pre_eq(slider1, 35) && ng_pre_eq(slider2, 150) && ng_pre_eq(slider3, 80) && ng_pre_eq(slider4, 60) && ng_pre_eq(slider5, -2) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 1) && ng_pre_eq(slider8, 0) ? m = 4;
    m < 0 && ng_pre_eq(slider1, 50) && ng_pre_eq(slider2, 100) && ng_pre_eq(slider3, 100) && ng_pre_eq(slider4, 0) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, -2) ? m = 5;
    m < 0 && ng_pre_eq(slider1, 60) && ng_pre_eq(slider2, 100) && ng_pre_eq(slider3, 0) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, -3) ? m = 6;
    m < 0 && ng_pre_eq(slider1, 70) && ng_pre_eq(slider2, 80) && ng_pre_eq(slider3, 100) && ng_pre_eq(slider4, 100) && ng_pre_eq(slider5, -2) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 2) && ng_pre_eq(slider8, -1) ? m = 7;
    m < 0 && ng_pre_eq(slider1, 50) && ng_pre_eq(slider2, 300) && ng_pre_eq(slider3, 100) && ng_pre_eq(slider4, 70) && ng_pre_eq(slider5, 0) && ng_pre_eq(slider6, 0) && ng_pre_eq(slider7, 0) && ng_pre_eq(slider8, 0) ? m = 8;
    m;
  );

  function ng_preset_name(p) local(s)
  (
    s = "";
    p == 0 ? s = "Default";
    p == 1 ? s = "Parallel Polish";
    p == 2 ? s = "Synth Detail";
    p == 3 ? s = "Drum Loop Smash";
    p == 4 ? s = "Vocal Thickener";
    p == 5 ? s = "Upward Only Detail";
    p == 6 ? s = "Downward Only Tame";
    p == 7 ? s = "Bright Air Squash";
    p == 8 ? s = "Slow Pad Bloom";
    s;
  );

  function ng_presets() local(i)
  (
    ng_pre_req >= 0 ? ( ng_preset_load(ng_pre_req); update(); ng_pre_req = -1; );
    ng_pre_cur = ng_preset_match();
    ng_pre_open ? (
      ng_pre_menu_begin();
      i = 0;
      loop(ng_pre_n, ng_pre_item(i, ng_preset_name(i)); i += 1;);
      ng_pre_menu_end();
    );
    strcpy(#ng_pre_name, ng_pre_cur >= 0 ? ng_preset_name(ng_pre_cur) : "CUSTOM");
  );
  // ---- end of factory presets ----

@slider
  update();

@sample
  // split: low = LR4 low-pass, rest = input - low (sums back exactly)
  lo_l = a2l.lp_run(a1l.lp_run(spl0));
  lo_r = a2r.lp_run(a1r.lp_run(spl1));
  rest_l = spl0 - lo_l; rest_r = spl1 - lo_r;
  mid_l = b2l.lp_run(b1l.lp_run(rest_l));
  mid_r = b2r.lp_run(b1r.lp_run(rest_r));
  hi_l = rest_l - mid_l; hi_r = rest_r - mid_r;

  // linked detection per band (both channels share one gain)
  gl = lowb.band_gain(max(abs(lo_l), abs(lo_r))) * g_low;
  gm = midb.band_gain(max(abs(mid_l), abs(mid_r))) * g_mid;
  gh = hib.band_gain(max(abs(hi_l), abs(hi_r))) * g_high;

  wet_l = (lo_l * gl + mid_l * gm + hi_l * gh) * makeup;
  wet_r = (lo_r * gl + mid_r * gm + hi_r * gh) * makeup;
  spl0 = (spl0 * (1 - depth) + wet_l * depth) * out;
  spl1 = (spl1 * (1 - depth) + wet_r * depth) * out;

  // safety: anything above 0 dBFS is bent smoothly towards +6 dBFS instead of running away
  // when every gain stage is turned up at once
  abs(spl0) > 1 ? spl0 = sign(spl0) * (1 + (abs(spl0) - 1) / abs(spl0));
  abs(spl1) > 1 ? spl1 = sign(spl1) * (1 + (abs(spl1) - 1) / abs(spl1));

@gfx 480 380
  ng_knobs_begin("OTT", "ADVANCED", 480, 120, 2, 0);

  // display, left: one band's static curve (in -80..0 dB across, out -80..0 dB up);
  // right: the gain each band gets now (downward cut, upward lift, band gain), -24..+24 dB
  ng_plot(ng_vx + 26, ng_vy + 4, 96, 96);
  ng_grid(4, 4, 0);
  ng_font(4, 8, 0);
  ng_col(NG_MUTED, 1);
  ng_ptxt("0", ng_px - 6 * ng_s, ng_py, 2);
  ng_ptxt("-40", ng_px - 6 * ng_s, ng_py + ng_ph / 2, 2);
  ng_ptxt("-80", ng_px - 6 * ng_s, ng_py + ng_ph, 2);
  ng_col(NG_ACCENT, 0.25);
  gfx_line(ng_px, ng_py + ng_ph, ng_px + ng_pw, ng_py, 1);
  ng_col(NG_ACCENT, 1);
  ott_i = 0;
  loop(97,
    ott_y = ng_lin_y(ott_curve(-80 + 80 * ott_i / 96), -80, 0);
    ott_i == 0 ? ng_line_start(ng_px, ott_y) : ng_line_to(ng_px + ng_pw * ott_i / 96, ott_y);
    ott_i += 1;
  );
  ott_bar(72, "LOW", 20 * log10(max(gl, 0.000001)));
  ott_bar(101, "MID", 20 * log10(max(gm, 0.000001)));
  ott_bar(130, "HIGH", 20 * log10(max(gh, 0.000001)));

  ng_row(4);
  sprintf(#v1, "%d%%", slider1);
  ng_knob_ctl(1, "DEPTH", #v1, 0, 100, 100, 1, 0) ? update();
  sprintf(#v2, "%d%%", slider2);
  ng_knob_ctl(2, "TIME", #v2, 0, 400, 100, 1, 0) ? update();
  sprintf(#v3, "%d%%", slider3);
  ng_knob_ctl(3, "UPWARD", #v3, 0, 100, 100, 1, 0) ? update();
  sprintf(#v4, "%d%%", slider4);
  ng_knob_ctl(4, "DOWNWARD", #v4, 0, 100, 100, 1, 0) ? update();
  ng_row(4);
  sprintf(#v5, "%.1f dB", slider5);
  ng_knob_ctl(5, "LOW", #v5, -12, 12, 0, 0.1, 1) ? update();
  sprintf(#v6, "%.1f dB", slider6);
  ng_knob_ctl(6, "MID", #v6, -12, 12, 0, 0.1, 1) ? update();
  sprintf(#v7, "%.1f dB", slider7);
  ng_knob_ctl(7, "HIGH", #v7, -12, 12, 0, 0.1, 1) ? update();
  sprintf(#v8, "%.1f dB", slider8);
  ng_knob_ctl(8, "OUTPUT", #v8, -12, 12, 0, 0.1, 1) ? update();

  ng_end();

  ng_presets(); // the preset list (generated by tools/build_presets.py)
