desc:NULL Ring Mod
author: Christos Koulaxizis
tags: ringmod ring modulator amplitude modulation metallic carrier
//category: Essentials
//NULL JSFX v2.0 • https://nulljsfx.tech • MIT License

slider1:5<0.1,20,0.1>Rate (Hz)
slider2:200<100,2000,10>Carrier Freq (Hz)
slider3:50<0,100,1>Depth (%)
slider4:40<0,100,1>Mix (%)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  phase = 0;

@slider
  rate = slider1;
  carrier_freq = slider2;
  depth_pct = slider3 / 100;
  mix_amt = slider4 / 100;
  phase_inc = 6.28318530717958 * rate / srate;

@sample
  phase >= 6.28318530717958 ? (phase = phase - 6.28318530717958;);
  carrier = sin(phase * carrier_freq / rate);
  phase = phase + phase_inc;
  
  proc_l = spl0 * carrier * depth_pct;
  proc_r = spl1 * carrier * depth_pct;
  
  out_l = spl0 * (1 - mix_amt) + proc_l * mix_amt;
  out_r = spl1 * (1 - mix_amt) + proc_r * mix_amt;
  
  spl0 = out_l;
  spl1 = out_r;
