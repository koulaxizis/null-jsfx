desc:NULL DeEsser
author: Christos Koulaxizis
tags: deess sibilance sibilants hiss vocal harshness frequency wideband listen
//category: Essentials
//NULL JSFX v4.1 • https://nulljsfx.tech • MIT License

slider1:6000<4000,10000,100>Target (Hz)
slider2:-6<-18,0,0.1>Reduction (dB)
slider3:0<0,1,1{Split,Wide}>Mode
slider4:0<0,1,1{Auto,Manual}>Threshold Mode
slider5:-30<-60,0,0.1>Threshold (dB)
slider6:-18<-18,0,0.1>Range (dB)
slider7:0<0,1,1{Off,On}>Listen
slider8:0<0,16000,100>Suppress Freq (Hz)
slider9:2<0.5,8,0.1>Suppress Q
slider10:0<0,1,1{Band,Shelf}>Suppress Shape

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // Split-band de-esser: a band-pass around Target isolates the sibilance, an envelope
  // follower measures it, and only that band is turned down (by up to Reduction dB)
  // when it gets loud, so the rest of the voice is untouched. Wide turns the whole signal down
  // instead; Manual sets the threshold (Auto: -30 dB); Range caps the reduction; Listen plays
  // only what is removed. The band that is turned down can differ from the one that is
  // measured: Suppress Freq (0 = Target), Suppress Q and Suppress Shape (Band: a band-pass;
  // Shelf: everything above Suppress Freq, a high-pass). At their defaults the measured band is
  // also the one turned down, as before.
  threshold = 10 ^ (-30 / 20);
  thr_auto = threshold;
  att = exp(-1 / (0.0005 * srate));
  rel = exp(-1 / (0.06 * srate));
  env = 0;
  x1l = x2l = y1l = y2l = 0;
  x1r = x2r = y1r = y2r = 0;
  sx1l = sx2l = sy1l = sy2l = 0;
  sx1r = sx2r = sy1r = sy2r = 0;

@slider
  w0 = 2 * $pi * min(slider1, srate * 0.45) / srate;
  q = 2;
  alpha = sin(w0) / (2 * q);
  a0 = 1 + alpha;
  b0 = alpha / a0;
  b2 = -alpha / a0;
  a1 = -2 * cos(w0) / a0;
  a2 = (1 - alpha) / a0;
  max_cut = 1 - 10 ^ (slider2 / 20);   // fraction of the band that may be removed
  wide = slider3 >= 0.5;
  threshold = slider4 >= 0.5 ? 10 ^ (slider5 / 20) : thr_auto;
  rng_on = slider6 > slider2;          // a Range below Reduction never limits
  rng_cut = 1 - 10 ^ (slider6 / 20);
  listen = slider7 >= 0.5;
  own = slider8 > 0 || slider9 != 2 || slider10 >= 0.5;
  own ? (
    sw0 = 2 * $pi * min(slider8 > 0 ? slider8 : slider1, srate * 0.45) / srate;
    salpha = sin(sw0) / (2 * slider9);
    sa0 = 1 + salpha;
    slider10 >= 0.5 ? (
      sb0 = (1 + cos(sw0)) / 2 / sa0;
      sb1 = -(1 + cos(sw0)) / sa0;
      sb2 = sb0;
    ) : (
      sb0 = salpha / sa0;
      sb1 = 0;
      sb2 = -salpha / sa0;
    );
    sa1 = -2 * cos(sw0) / sa0;
    sa2 = (1 - salpha) / sa0;
  );

@sample
  bl = b0 * spl0 + b2 * x2l - a1 * y1l - a2 * y2l;
  x2l = x1l; x1l = spl0; y2l = y1l; y1l = bl;
  br = b0 * spl1 + b2 * x2r - a1 * y1r - a2 * y2r;
  x2r = x1r; x1r = spl1; y2r = y1r; y1r = br;
  own ? (
    s_l = sb0 * spl0 + sb1 * sx1l + sb2 * sx2l - sa1 * sy1l - sa2 * sy2l;
    sx2l = sx1l; sx1l = spl0; sy2l = sy1l; sy1l = s_l;
    s_r = sb0 * spl1 + sb1 * sx1r + sb2 * sx2r - sa1 * sy1r - sa2 * sy2r;
    sx2r = sx1r; sx1r = spl1; sy2r = sy1r; sy1r = s_r;
  );

  level = max(abs(bl), abs(br));
  env = level > env ? att * env + (1 - att) * level : rel * env + (1 - rel) * level;

  // 0 below threshold, rising to full reduction 12 dB above it
  over = env > threshold ? min(log(env / threshold) / log(4), 1) : 0;
  cut = over * max_cut;
  rng_on ? cut = min(cut, rng_cut);

  wide ? (
    rm_l = spl0 * cut;
    rm_r = spl1 * cut;
  ) : own ? (
    rm_l = s_l * cut;
    rm_r = s_r * cut;
  ) : (
    rm_l = bl * cut;
    rm_r = br * cut;
  );
  listen ? (
    spl0 = rm_l;
    spl1 = rm_r;
  ) : (
    spl0 -= rm_l;
    spl1 -= rm_r;
  );
