desc:NULL Filter
//tags: filter lowpass highpass bandpass notch allpass resonance q cutoff svf tpt multi-mode
//Collection: NULL JSFX
//Author: Christos Koulaxizis

slider1:1000<20,20000,1:log>Cutoff-(Hz)
slider2:1<0.1,10,0.1>Resonance
slider3:0<-12,12,0.1>Gain-(dB)
slider4:0<0,4,1{Lowpass,Highpass,Bandpass,Notch,Allpass}>Mode

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
  ic1_l = 0; ic2_l = 0;
  ic1_r = 0; ic2_r = 0;

@slider
  fc = slider1;
  Q = slider2;
  filter_mode = slider4;

  g = tan(3.14159265358979 * fc / srate);
  R = 1 / (2 * Q);
  g2 = g * g;
  Rg = R * g;
  denom = 1 / (1 + Rg + g2);

  gain_lin = exp(slider3 * 0.11512925464970228420);

@sample
  // Left channel - SVF
  v3_hp = (spl0 - ic2_l - (R + g) * ic1_l) * denom;
  v1_bp = g * v3_hp + ic1_l;
  v2_lp = g * v1_bp + ic2_l;
  ic1_l = v1_bp;
  ic2_l = v2_lp;

  filter_mode == 0 ? (
    spl0 = v2_lp * gain_lin;
  ) : (
    filter_mode == 1 ? (
      spl0 = v3_hp * gain_lin;
    ) : (
      filter_mode == 2 ? (
        spl0 = v1_bp * gain_lin;
      ) : (
        filter_mode == 3 ? (
          spl0 = (v2_lp + v3_hp) * gain_lin;
        ) : (
          spl0 = (spl0 - 2 * v2_lp) * gain_lin;
        );
      );
    );
  );

  // Right channel - SVF
  v3_hp = (spl1 - ic2_r - (R + g) * ic1_r) * denom;
  v1_bp = g * v3_hp + ic1_r;
  v2_lp = g * v1_bp + ic2_r;
  ic1_r = v1_bp;
  ic2_r = v2_lp;

  filter_mode == 0 ? (
    spl1 = v2_lp * gain_lin;
  ) : (
    filter_mode == 1 ? (
      spl1 = v3_hp * gain_lin;
    ) : (
      filter_mode == 2 ? (
        spl1 = v1_bp * gain_lin;
      ) : (
        filter_mode == 3 ? (
          spl1 = (v2_lp + v3_hp) * gain_lin;
        ) : (
          spl1 = (spl1 - 2 * v2_lp) * gain_lin;
        );
      );
    );
  );