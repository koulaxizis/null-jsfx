desc:NULL Click Repair
author: Christos Koulaxizis
tags: click repair audio restoration pop crackle vinyl denoise
//category: Essentials
//NULL JSFX v2.0 • https://nulljsfx.tech • MIT License

slider1:50<0,100,1>Threshold (%)
slider2:10<1,50,1>Window (Samples)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  // Finds samples that jump far away from the recent signal (clicks, pops, digital
  // spikes), marks Window samples from there as damaged, and redraws them as a straight
  // line between the good samples on either side. The output is delayed by
  // 2 x Window samples (reported to REAPER for delay compensation) so the repair can
  // see the good sample after each click.
  ring = 256;
  buf_l = 0;
  buf_r = buf_l + ring;
  bad_l = buf_r + ring;
  bad_r = bad_l + ring;
  freembuf(bad_r + ring);
  memset(buf_l, 0, 4 * ring);
  pos = 0;
  avg_l = avg_r = 0.01;
  left_l = left_r = 0;
  last_l = last_r = 0;
  pdc_bot_ch = 0;
  pdc_top_ch = 2;

  function store(buf, bad, x, avg*, left*) local(d)
  (
    d = abs(x - buf[(pos - 1 + ring) % ring]);
    left <= 0 && d > max(avg * ratio, 0.01) ? left = win;
    left > 0 ? (bad[pos] = 1; left -= 1) : (bad[pos] = 0; avg = avg * 0.995 + d * 0.005);
    buf[pos] = x;
  );

  function repaired(buf, bad, last*) local(o, j, n, y)
  (
    o = (pos - delay + ring) % ring;
    bad[o] ? (
      j = o;
      n = 1;
      while (j = (j + 1) % ring; n += 1; bad[j] && n < ring);
      y = last + (buf[j] - last) / n;
    ) : (
      y = buf[o];
    );
    last = y;
  );

@slider
  win = max(1, min(50, floor(slider2)));
  delay = 2 * win;
  pdc_delay = delay;
  // 0% = most sensitive (step 4x the average), 100% = least sensitive (step 30x)
  ratio = 4 + slider1 / 100 * 26;

@sample
  store(buf_l, bad_l, spl0, avg_l, left_l);
  store(buf_r, bad_r, spl1, avg_r, left_r);
  spl0 = repaired(buf_l, bad_l, last_l);
  spl1 = repaired(buf_r, bad_r, last_r);
  pos = (pos + 1) % ring;
