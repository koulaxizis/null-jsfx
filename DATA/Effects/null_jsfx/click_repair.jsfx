desc:NULL Click Repair
author: Christos Koulaxizis
tags: click repair audio restoration pop crackle vinyl denoise
//category: Essentials
//NULL JSFX v2.0 • https://nulljsfx.tech • MIT License

slider1:50<0,100,1>Threshold (%)
slider2:10<1,50,1>Window (Samples)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  win_idx = 0;
  threshold_db = slider1 / 100;
  window_len = floor(slider2);
  loop(window_len, window_data[i] = 0;);
  prev_sample = 0;

@slider
  threshold_db = slider1 / 100;
  window_len = floor(slider2);

@sample
  current = spl0;
  diff = current - prev_sample;
  
  diff > threshold_db || diff < -threshold_db ? (
    interpolated = 0;
    loop(window_len, 
      sum = 0;
      count = 0;
      loop(window_len,
        k = win_idx - j;
        k < 0 ? k = k + window_len;
        k >= window_len ? k = k - window_len;
        sum = sum + window_data[k];
        count = count + 1;
      );
      interpolated = sum / count;
    );
    
    spl0 = interpolated;
    spl1 = interpolated;
  );
  
  window_data[win_idx] = spl0;
  win_idx = win_idx + 1;
  win_idx >= window_len ? win_idx = 0;
  
  prev_sample = current;
