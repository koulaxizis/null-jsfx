desc:NULL Filter
author: Christos Koulaxizis
tags: filter lowpass resonance q cutoff svf tpt
//category: Essentials
//NULL JSFX v2.0 • https://nulljsfx.tech • MIT License

slider1:1000<20,20000,1:log>Cutoff (Hz)
slider2:1<0.1,10,0.1>Resonance
slider3:0<-12,12,0.1>Gain (dB)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ic1_l = 0; ic2_l = 0;
  ic1_r = 0; ic2_r = 0;

@slider
  fc = slider1;
  Q = slider2;
  
  g = tan($pi * fc / srate);
  R = 1 / (2 * Q);
  g2 = g * g;
  Rg = R * g;
  denom = 1 / (1 + Rg + g2);
  
  gain_lin = exp(slider3 * 0.11513);

@sample
  // Left channel
  v3 = (spl0 - ic2_l - (R + g) * ic1_l) * denom;
  v1 = g * v3 + ic1_l;
  v2 = g * v1 + ic2_l;
  ic1_l = v1;
  ic2_l = v2;
  spl0 = v2 * gain_lin;
  
  // Right channel
  v3 = (spl1 - ic2_r - (R + g) * ic1_r) * denom;
  v1 = g * v3 + ic1_r;
  v2 = g * v1 + ic2_r;
  ic1_r = v1;
  ic2_r = v2;
  spl1 = v2 * gain_lin;
