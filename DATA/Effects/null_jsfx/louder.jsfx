desc:NULL Louder
author: Christos Koulaxizis
tags: loudness gain volume boost makeup utility
//category: One Slider
//NULL JSFX v2.0 • https://nulljsfx.tech • MIT License

slider1:50<0,100,1>Amount

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  // Loudness maximizer: up to +12 dB of gain into a 2 ms look-ahead peak limiter
  // (ceiling -0.3 dBFS, 80 ms release), so the track gets louder without clipping.
  // At 0 nothing happens below the ceiling.
  la = max(1, floor(0.002 * srate));
  buf = 0; memset(buf, 0, 2 * la + 2); freembuf(2 * la + 2);
  pos = 0; env = 1; hval = 1; hcount = 0;
  ceiling = 10 ^ (-0.3 / 20);
  att = exp(-3 / la);
  rel = exp(-1 / (0.08 * srate));
  pdc_delay = la; pdc_bot_ch = 0; pdc_top_ch = 2;

@slider
  gain = 10 ^ (slider1 / 100 * 12 / 20);

@sample
  xl = spl0 * gain; xr = spl1 * gain;
  pk = max(abs(xl), abs(xr));
  target = pk > ceiling ? ceiling / pk : 1;
  // hold the deepest gain reduction for the look-ahead time so the delayed peak is caught
  target <= hval ? (hval = target; hcount = la) : hcount > 0 ? hcount -= 1 : hval = target;
  env = hval < env ? att * env + (1 - att) * hval : rel * env + (1 - rel) * hval;
  dl = buf[pos]; dr = buf[pos + la];
  buf[pos] = xl; buf[pos + la] = xr;
  pos = (pos + 1) % la;
  spl0 = max(-ceiling, min(ceiling, dl * env));
  spl1 = max(-ceiling, min(ceiling, dr * env));
