desc:NULL Console Buss
author: Christos Koulaxizis
tags: console buss bus master analog mixer summing saturation crosstalk colour warm punchy bright drive glue
//category: Advanced
//NULL JSFX v2.9 • https://nulljsfx.tech • MIT License

slider1:1<0,3,1{Clean,Warm,Punchy,Bright}>Character
slider2:30<0,100,1>Drive (%)
slider3:0<-12,12,0.1>Output (dB)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // The summing bus of a mixing console, for the bus or master that Console Channel tracks
  // feed. Like Console Channel, each side goes through a pre-emphasis shelf, a soft saturator
  // (Pade tanh, flat beyond +-3) and the exact inverse of the shelf, but with 8 dB of headroom
  // and gentler shelves and drive, since the whole mix passes here. Then the two sides leak
  // into each other a little, as the busses of a real desk do: the other side, high-passed at
  // 1 kHz (the leak is capacitive), at up to -30 dB with Drive. Character: Clean = no shelf,
  // 9 dB of drive; Warm = +4 dB below 150 Hz, even harmonics, 12 dB; Punchy = +3 dB below
  // 60 Hz, a touch of even harmonics, 12 dB; Bright = +4 dB above 5 kHz, 9 dB. A 5 Hz DC blocker
  // follows. States below 1e-15 are cleared so silence stays free of denormals.

  // one side up to the crosstalk: emphasis, saturation, de-emphasis
  function cb_ch(x) instance(xp, ep, sp, yp) local(e, u, v, s, y)
  (
    emph ? (
      e = b0 * x - b1 * xp + sc * ep;
      xp = x;
      ep = abs(e) < 0.000000000000001 ? 0 : e;
    ) : (
      e = x;
    );
    u = e * k;
    u = u > 3 ? 3 : u < -3 ? -3 : u;
    v = u * (27 + u * u) / (27 + 9 * u * u);
    s = (v + asym * v * v) * ik;
    emph ? (
      y = (s - sc * sp + b1 * yp) / b0;
      sp = s;
      yp = abs(y) < 0.000000000000001 ? 0 : y;
    ) : (
      y = s;
    );
    y;
  );

  // one-pole high-pass for the leak
  function cb_hp(x) instance(lp)
  (
    lp = (1 - hc) * x + hc * lp;
    lp = abs(lp) < 0.000000000000001 ? 0 : lp;
    x - lp;
  );

  // DC blocker
  function cb_dc(x) instance(dx, dy) local(v)
  (
    v = x - dx + dc * dy;
    dx = x;
    dy = abs(v) < 0.000000000000001 ? 0 : v;
    v;
  );

@slider
  ch = slider1;
  emph = ch > 0;
  sg = 10 ^ ((ch == 2 ? 3 : 4) / 20);
  sc = exp(-2 * $pi * min(ch == 1 ? 150 : ch == 2 ? 60 : 5000, 0.45 * srate) / srate);
  ch == 3 ? (
    b0 = 1 + sc * (sg - 1);
    b1 = sg * sc;
  ) : (
    b0 = 1 + (sg - 1) * (1 - sc);
    b1 = sc;
  );
  asym = ch == 1 ? 0.1 : ch == 2 ? 0.03 : 0;
  k = 10 ^ (slider2 / 100 * (ch == 1 || ch == 2 ? 12 : 9) / 20) / 2.5;
  ik = 1 / k;
  ct = slider2 / 100 * 0.0316;
  hc = exp(-2 * $pi * min(1000, 0.45 * srate) / srate);
  go = 10 ^ (slider3 / 20);
  dc = 1 - 2 * $pi * 5 / srate;

@sample
  yl = l.cb_ch(spl0);
  yr = r.cb_ch(spl1);
  hl = l.cb_hp(yl);
  hr = r.cb_hp(yr);
  spl0 = l.cb_dc(yl + ct * hr) * go;
  spl1 = r.cb_dc(yr + ct * hl) * go;
