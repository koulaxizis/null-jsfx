desc:NULL Pitch Shifter
author: Christos Koulaxizis
tags: pitch shift detune harmonizer transposition semitone octave
//category: Essentials
//NULL JSFX v2.0 • https://nulljsfx.tech • MIT License

slider1:0<-2,2,1>Octave
slider2:0<-12,12,1>Semitones
slider3:0<-50,50,0.1>Fine (cents)
slider4:50<0,100,1>Mix (%)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  buf_size = srate * 0.1;
  wpos = 0;
  readpos = 0;
  
  i = 0;
  while(i < buf_size)(buffer_l[i] = 0; buffer_r[i] = 0; i += 1);

@slider
  octave = slider1;
  semitones = slider2;
  fine = slider3;
  mix_amt = slider4 / 100;
  total_shift = octave * 12 + semitones + fine / 100;
  pitch_factor = pow(2, total_shift / 12);

@sample
  buffer_l[wpos] = spl0;
  buffer_r[wpos] = spl1;
  
  wpos = wpos + 1;
  wpos >= buf_size ? wpos = 0;
  
  readpos = readpos + pitch_factor;
  readpos >= buf_size ? readpos = readpos - buf_size;
  
  rpos_int = floor(readpos);
  rpos_frac = readpos - rpos_int;
  
  rpos_next = rpos_int + 1;
  rpos_next >= buf_size ? rpos_next = 0;
  
  d1_l = buffer_l[rpos_int];
  d2_l = buffer_l[rpos_next];
  d1_r = buffer_r[rpos_int];
  d2_r = buffer_r[rpos_next];
  
  shifted_l = d1_l + (d2_l - d1_l) * rpos_frac;
  shifted_r = d1_r + (d2_r - d1_r) * rpos_frac;
  
  spl0 = spl0 * (1 - mix_amt) + shifted_l * mix_amt;
  spl1 = spl1 * (1 - mix_amt) + shifted_r * mix_amt;
