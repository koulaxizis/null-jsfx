desc:NULL Delay
author: Christos Koulaxizis
tags: delay echo slapback feedback pre-delay timing sync tempo
//category: Essentials
//NULL JSFX v2.0 • https://nulljsfx.tech • MIT License

slider1:250<0,2000,1>Time (ms)
slider2:0<0,100,1>Feedback (%)
slider3:30<0,100,1>Mix (%)
slider4:0<0,1,1{OFF,ON}>Tempo Sync
slider5:0<0,3,1{1/4,1/8,1/16,1/32}>Subdivision

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  buf_size = ceil(srate * 2.1);
  buf_l = 0;
  buf_r = buf_l + buf_size;
  memset(buf_l, 0, 2 * buf_size);
  freembuf(buf_r + buf_size);
  wpos = 0;
  delay_samples = 1;

  function update_time()
  (
    tempo_sync && tempo > 0 ? (
      delay_ms = 60000 / tempo * (slider5 == 0 ? 1 : slider5 == 1 ? 0.5 : slider5 == 2 ? 0.25 : 0.125);
    ) : (
      delay_ms = slider1;
    );
    delay_samples = floor(delay_ms * srate / 1000 + 0.5);
    delay_samples = max(1, min(buf_size - 1, delay_samples));
  );

@slider
  feedback = slider2 / 100 * 0.95;
  mix_amt = slider3 / 100;
  tempo_sync = slider4;
  update_time();

@block
  tempo_sync ? update_time();

@sample
  rpos = wpos - delay_samples;
  rpos < 0 ? rpos += buf_size;
  echo_l = buf_l[rpos];
  echo_r = buf_r[rpos];

  buf_l[wpos] = spl0 + echo_l * feedback;
  buf_r[wpos] = spl1 + echo_r * feedback;
  wpos += 1;
  wpos >= buf_size ? wpos = 0;

  spl0 = spl0 * (1 - mix_amt) + echo_l * mix_amt;
  spl1 = spl1 * (1 - mix_amt) + echo_r * mix_amt;
