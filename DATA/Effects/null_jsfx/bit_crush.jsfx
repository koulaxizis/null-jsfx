desc:NULL Bit Crush
//tags: bitcrush lofi retro degrade quantize crusher
//author: Christos Koulaxizis
//Collection: NULL JSFX

slider1:30<0,100,0.1>Drive-%
slider2:16<1,16,1>Bit-Depth
slider3:44100<1000,44100,100>Sample-Rate-(Hz)
slider4:0<-12,12,0.1>Tone-(dB)
slider5:100<0,100,1>Mix-%

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
  DB2LIN = 0.11512925464970228420;
  bc_hold_counter = 0;
  bc_hold_l = 0;
  bc_hold_r = 0;
  tilt_lp_l = 0;
  tilt_lp_r = 0;

@slider
  drive_pct = slider1 / 100;
  bc_bits = slider2;
  bc_target_sr = slider3;
  tilt_db = slider4;
  mix_pct = slider5 / 100;

  bc_levels = pow(2, bc_bits);
  bc_quant = 2 / bc_levels;
  bc_sr_ratio = srate / bc_target_sr;
  
  bc_pre_gain = 1 + drive_pct * 5;
  
  tilt_alpha = 1 - exp(-2 * 3.14159265 * 1500 / srate);
  tilt_hi = pow(10, tilt_db / 40);
  tilt_lo = pow(10, -tilt_db / 40);

@sample
  input_crushed_l = spl0 * bc_pre_gain;
  input_crushed_r = spl1 * bc_pre_gain;

  quant_l = floor(input_crushed_l / bc_quant + 0.5) * bc_quant;
  quant_r = floor(input_crushed_r / bc_quant + 0.5) * bc_quant;

  quant_l = quant_l > 1 ? 1 : (quant_l < -1 ? -1 : quant_l);
  quant_r = quant_r > 1 ? 1 : (quant_r < -1 ? -1 : quant_r);

  bc_hold_counter = bc_hold_counter + 1;
  bc_hold_counter >= bc_sr_ratio ? (
    bc_hold_l = quant_l;
    bc_hold_r = quant_r;
    bc_hold_counter = 0;
  );
  
  proc_l = bc_hold_l;
  proc_r = bc_hold_r;
  
  tilt_lp_l = tilt_lp_l + tilt_alpha * (proc_l - tilt_lp_l);
  tilt_lp_r = tilt_lp_r + tilt_alpha * (proc_r - tilt_lp_r);
  tilt_hp_l = proc_l - tilt_lp_l;
  tilt_hp_r = proc_r - tilt_lp_r;
  
  tilt_out_l = tilt_hp_l * tilt_hi + tilt_lp_l * tilt_lo;
  tilt_out_r = tilt_hp_r * tilt_hi + tilt_lp_r * tilt_lo;
  
  out_l = spl0 * (1 - mix_pct) + tilt_out_l * mix_pct;
  out_r = spl1 * (1 - mix_pct) + tilt_out_r * mix_pct;
  
  spl0 = out_l;
  spl1 = out_r;