slider1:2<0,11,1{Off,User,House,Techno,Boom Bap,Electro,Breakbeat,Trap,Disco,Synth Pop,Dembow,Bossa}>Pattern
slider2:50<50,75,1>Swing (%)
slider3:50<0,100,1>Accent (%)
slider4:0<0,100,1>Drive (%)
slider5:0<0,100,1>Grit (%)
slider6:0<-24,12,0.1>Volume (dB)
slider7:0<-40,6,0.1>Kick Level (dB)
slider8:0<-12,12,0.1>Kick Tune (st)
slider9:50<0,100,1>Kick Decay (%)
slider10:50<0,100,1>Kick Tone (%)
slider11:0<-100,100,1>Kick Pan (%)
slider12:0<-40,6,0.1>Snare Level (dB)
slider13:0<-12,12,0.1>Snare Tune (st)
slider14:50<0,100,1>Snare Decay (%)
slider15:50<0,100,1>Snare Tone (%)
slider16:0<-100,100,1>Snare Pan (%)
slider17:0<-40,6,0.1>Clap Level (dB)
slider18:0<-12,12,0.1>Clap Tune (st)
slider19:50<0,100,1>Clap Decay (%)
slider20:50<0,100,1>Clap Tone (%)
slider21:0<-100,100,1>Clap Pan (%)
slider22:0<-40,6,0.1>Rim Level (dB)
slider23:0<-12,12,0.1>Rim Tune (st)
slider24:50<0,100,1>Rim Decay (%)
slider25:0<0,100,1>Rim Tone (%)
slider26:-15<-100,100,1>Rim Pan (%)
slider27:0<-40,6,0.1>Closed Hat Level (dB)
slider28:0<-12,12,0.1>Closed Hat Tune (st)
slider29:50<0,100,1>Closed Hat Decay (%)
slider30:30<0,100,1>Closed Hat Tone (%)
slider31:20<-100,100,1>Closed Hat Pan (%)
slider32:0<-40,6,0.1>Open Hat Level (dB)
slider33:0<-12,12,0.1>Open Hat Tune (st)
slider34:50<0,100,1>Open Hat Decay (%)
slider35:30<0,100,1>Open Hat Tone (%)
slider36:20<-100,100,1>Open Hat Pan (%)
slider37:0<-40,6,0.1>Low Tom Level (dB)
slider38:0<-12,12,0.1>Low Tom Tune (st)
slider39:50<0,100,1>Low Tom Decay (%)
slider40:30<0,100,1>Low Tom Tone (%)
slider41:-25<-100,100,1>Low Tom Pan (%)
slider42:0<-40,6,0.1>High Tom Level (dB)
slider43:0<-12,12,0.1>High Tom Tune (st)
slider44:50<0,100,1>High Tom Decay (%)
slider45:30<0,100,1>High Tom Tone (%)
slider46:25<-100,100,1>High Tom Pan (%)
slider47:0<-40,6,0.1>Cowbell Level (dB)
slider48:0<-12,12,0.1>Cowbell Tune (st)
slider49:50<0,100,1>Cowbell Decay (%)
slider50:50<0,100,1>Cowbell Tone (%)
slider51:-10<-100,100,1>Cowbell Pan (%)
slider52:0<-40,6,0.1>Cymbal Level (dB)
slider53:0<-12,12,0.1>Cymbal Tune (st)
slider54:50<0,100,1>Cymbal Decay (%)
slider55:50<0,100,1>Cymbal Tone (%)
slider56:10<-100,100,1>Cymbal Pan (%)

in_pin:none
out_pin:Left
out_pin:Right

@init
  // A drum machine with ten synthesized voices (no samples) and a 16-step sequencer that
  // follows the host's tempo and transport. MIDI notes (General MIDI drum map) play the voices
  // at any time. It takes the best of the classics:
  //   - TR-808: the voice circuits (sine kick, two-tone snare, three-burst clap, six-square
  //     metal for the hats and cymbal, two-square cowbell), Accent, the closed hat choking the
  //     open hat
  //   - TR-909: the punchy kick (click and fast pitch sweep at high Tone), Snappy, Flam steps
  //   - LinnDrum / MPC: Swing 50-75 %, Roll steps (note repeat), velocity from MIDI
  //   - SP-1200: Grit (fewer bits, lower sample rate) for the whole kit
  //   - Simmons SDS-V: tom pitch sweeps (Tone); CR-78 / TR-606: the clave (Rim Tone)
  //   - Elektron / DrumBrute: a length of 1 to 16 steps per track (polyrhythm)
  // The sequencer plays the selected pattern while the host plays; "User" is the pattern drawn
  // in the GFX version, saved with the project; "Off" leaves only MIDI.
  //
  // Memory: 0..169 the User pattern (10 tracks x 16 steps, then 10 lengths), 1000.. the factory
  // patterns (170 each), 4000.. the MIDI notes of the block, 5000.. per-voice values.
  // Step values: 0 off, 1 hit, 2 accent, 3 flam, 4 roll.
  ext_tail_size = -1;
  NT = 10;
  FACT = 1000;
  MQ = 4000;
  VL = 5000; VPL = 5010; VPR = 5020; PEND = 5030; PVEL = 5040; HIT = 5050;
  ser_ver = 1;

  // pattern k (0 = the User pattern, 1.. the factory ones): track t from a string of 16 steps
  // ". x X f r" (off, hit, accent, flam, roll) and the track's length
  function pat_set(k, t, str, len) local(b, i, c)
  (
    b = k == 0 ? 0 : FACT + (k - 1) * 170;
    i = 0;
    loop(16,
      c = str_getchar(str, i);
      b[t * 16 + i] = c == 'x' ? 1 : c == 'X' ? 2 : c == 'f' ? 3 : c == 'r' ? 4 : 0;
      i += 1;
    );
    b[160 + t] = len;
  );
  function pat_clear(k) local(t)
  (
    t = 0;
    loop(NT, pat_set(k, t, "................", 16); t += 1;);
  );

  // the User pattern starts as a basic beat, once (REAPER runs @init again at every playback
  // start; the pattern a project saved arrives in @serialize after the first @init)
  !dm_ready ? (
    pat_clear(0);
    pat_set(0, 0, "x...x...x...x...", 16);
    pat_set(0, 1, "....x.......x...", 16);
    pat_set(0, 4, "x.x.x.x.x.x.x.x.", 16);
    dm_ready = 1;
  );

  // factory patterns, in the order of the Pattern slider after Off and User
  pat_clear(1); // House
  pat_set(1, 0, "X...x...X...x...", 16);
  pat_set(1, 2, "....x.......x...", 16);
  pat_set(1, 3, "..............x.", 16);
  pat_set(1, 4, "x...x...x...x...", 16);
  pat_set(1, 5, "..x...x...x...x.", 16);
  pat_clear(2); // Techno: the rim runs over 6 steps against the bar
  pat_set(2, 0, "X...x...X...x...", 16);
  pat_set(2, 3, "..x..x..........", 6);
  pat_set(2, 4, "xxXxxxXxxxXxxxXx", 16);
  pat_set(2, 6, "..........x.....", 16);
  pat_set(2, 9, "..x...x...x...x.", 16);
  pat_clear(3); // Boom Bap
  pat_set(3, 0, "X......xx.x.....", 16);
  pat_set(3, 1, "....X.......X...", 16);
  pat_set(3, 4, "x.x.x.x.x.x.x...", 16);
  pat_set(3, 5, "..............x.", 16);
  pat_clear(4); // Electro
  pat_set(4, 0, "X.....x...x..x..", 16);
  pat_set(4, 1, "....x.......x...", 16);
  pat_set(4, 2, "....x.......X...", 16);
  pat_set(4, 4, "xxxxxxxxxxxxxxxx", 16);
  pat_set(4, 8, "..x..x....x..x..", 16);
  pat_clear(5); // Breakbeat
  pat_set(5, 0, "X.x.......xx....", 16);
  pat_set(5, 1, "....X..x.x..X..x", 16);
  pat_set(5, 4, "x.x.x.x.x.x.x.x.", 16);
  pat_set(5, 9, "X...............", 16);
  pat_clear(6); // Trap: hat rolls, half-time snare
  pat_set(6, 0, "X......x..x.....", 16);
  pat_set(6, 1, "........X.......", 16);
  pat_set(6, 2, "........x.......", 16);
  pat_set(6, 4, "x.x.x.r.x.x.rrx.", 16);
  pat_clear(7); // Disco
  pat_set(7, 0, "X...x...X...x...", 16);
  pat_set(7, 1, "....x.......x...", 16);
  pat_set(7, 4, "x...x...x...x...", 16);
  pat_set(7, 5, "..X...X...X...X.", 16);
  pat_set(7, 6, ".............x..", 16);
  pat_set(7, 7, "..............x.", 16);
  pat_clear(8); // Synth Pop
  pat_set(8, 0, "X.......x.x.....", 16);
  pat_set(8, 1, "....X.......X...", 16);
  pat_set(8, 2, "....x.......x...", 16);
  pat_set(8, 4, "x.x.x.x.x.x.x.x.", 16);
  pat_set(8, 9, "X...............", 16);
  pat_clear(9); // Dembow
  pat_set(9, 0, "X...x...X...x...", 16);
  pat_set(9, 1, "...x..x....x..x.", 16);
  pat_set(9, 4, "x.x.x.x.x.x.x.x.", 16);
  pat_set(9, 3, "...x..f....x..x.", 16);
  pat_clear(10); // Bossa
  pat_set(10, 0, "X..xx..xX..xx..x", 16);
  pat_set(10, 3, "x..x..x...x.x...", 16);
  pat_set(10, 4, "xxXxxxXxxxXxxxXx", 16);
  pat_set(10, 6, "...........x....", 16);

  // ---- building blocks ----------------------------------------------------------------------
  // state-variable filter (TPT): svf_set(cutoff, Q) then svf(x); lp, bp, hp are the outputs
  function svf_set(fc, q)
  (
    this.g = tan($pi * min(fc, 0.45 * srate) / srate);
    this.k = 1 / q;
    this.a1 = 1 / (1 + this.g * (this.g + this.k));
    this.a2 = this.g * this.a1;
    this.a3 = this.g * this.a2;
  );
  function svf(x) local(v1, v2, v3)
  (
    v3 = x - this.s2;
    v1 = this.a1 * this.s1 + this.a2 * v3;
    v2 = this.s2 + this.a2 * this.s1 + this.a3 * v3;
    this.s1 = 2 * v1 - this.s1;
    this.s2 = 2 * v2 - this.s2;
    this.lp = v2;
    this.bp = v1;
    this.hp = x - this.k * v1 - v2;
  );

  // band-limited square (PolyBLEP) at phase p (0..1) with phase step dt
  function blep(t, dt)
  (
    t < dt ? ( t /= dt; t + t - t * t - 1; ) :
    t > 1 - dt ? ( t = (t - 1) / dt; t * t + t + t + 1; ) : 0;
  );
  function square(p, dt) local(q)
  (
    q = p + 0.5;
    q -= floor(q);
    (p < 0.5 ? 1 : -1) + blep(p, dt) - blep(q, dt);
  );

  // the TR-808 metal: six squares at 205.3, 304.4, 369.6, 522.7, 540 and 800 Hz times r
  function metal_set(r)
  (
    this.d1 = 205.3 * r / srate; this.d2 = 304.4 * r / srate; this.d3 = 369.6 * r / srate;
    this.d4 = 522.7 * r / srate; this.d5 = 540 * r / srate; this.d6 = 800 * r / srate;
  );
  function metal_reset()
  (
    this.p1 = 0; this.p2 = 0.13; this.p3 = 0.29; this.p4 = 0.41; this.p5 = 0.57; this.p6 = 0.73;
  );
  function metal() local(y)
  (
    y = square(this.p1, this.d1) + square(this.p2, this.d2) + square(this.p3, this.d3)
      + square(this.p4, this.d4) + square(this.p5, this.d5) + square(this.p6, this.d6);
    this.p1 += this.d1; this.p1 -= floor(this.p1);
    this.p2 += this.d2; this.p2 -= floor(this.p2);
    this.p3 += this.d3; this.p3 -= floor(this.p3);
    this.p4 += this.d4; this.p4 -= floor(this.p4);
    this.p5 += this.d5; this.p5 -= floor(this.p5);
    this.p6 += this.d6; this.p6 -= floor(this.p6);
    y / 6;
  );

  // decay coefficient for a time constant in seconds
  function dcy(tau) ( exp(-1 / (tau * srate)); );

  // tom (low and high): sine with a downward pitch sweep (Simmons at high Tone) and a stick click
  function tom_set(f, d, o)
  (
    this.f0 = f;
    this.sw = 0.15 + 1.6 * o;
    this.pc = dcy(0.03 + 0.12 * o);
    this.ac = dcy(0.05 + 0.6 * d * d + 0.1 * d);
    this.nc = dcy(0.004);
  );
  function tom_trig(v) ( this.ph = 0; this.env = v; this.pe = 1; this.ne = v; this.on = 1; );
  function tom(n) local(y)
  (
    y = 0;
    this.on ? (
      this.ph += this.f0 * (1 + this.sw * this.pe) / srate;
      this.ph -= floor(this.ph);
      y = sin(2 * $pi * this.ph) * this.env + n * 0.08 * this.ne;
      this.pe *= this.pc;
      this.env *= this.ac;
      this.ne *= this.nc;
      this.env < 0.000001 ? this.on = 0;
    );
    y;
  );

  // ---- voices ---------------------------------------------------------------------------------
  function trig(t, v)
  (
    HIT[t] = v;
    t == 0 ? ( k_ph = 0; k_env = v; k_pe = 1; k_ce = v; k_on = 1; ) :
    t == 1 ? ( s_ph1 = 0; s_ph2 = 0; s_pe = 1; s_be = v; s_ne = v; s_on = 1; ) :
    t == 2 ? ( c_t = 0; c_env = 1; c_vel = v; c_on = 1; ) :
    t == 3 ? ( r_ph1 = 0; r_ph2 = 0; r_ph3 = 0; r_env = v; r_on = 1; ) :
    t == 4 ? ( h_m.metal_reset(); h_env = v; h_on = 1; o_choke = 1; ) :
    t == 5 ? ( o_m.metal_reset(); o_env = v; o_on = 1; o_choke = 0; ) :
    t == 6 ? lt.tom_trig(v) :
    t == 7 ? ht.tom_trig(v) :
    t == 8 ? ( b_p1 = 0; b_p2 = 0.25; b_e1 = 0.7 * v; b_e2 = 0.3 * v; b_on = 1; ) :
    t == 9 ? ( y_m.metal_reset(); y_env = v; y_on = 1; );
  );

  // General MIDI drum notes to voices
  function note_on(n, v)
  (
    n == 35 || n == 36 ? trig(0, v) :
    n == 38 || n == 40 ? trig(1, v) :
    n == 39 ? trig(2, v) :
    n == 37 ? trig(3, v) :
    n == 42 || n == 44 ? trig(4, v) :
    n == 46 ? trig(5, v) :
    n == 41 || n == 43 || n == 45 ? trig(6, v) :
    n == 47 || n == 48 || n == 50 ? trig(7, v) :
    n == 56 ? trig(8, v) :
    n == 49 || n == 51 || n == 52 || n == 55 || n == 57 || n == 59 ? trig(9, v);
  );

  function pan_set(t, lev, p)
  (
    VL[t] = 10 ^ (lev / 20);
    VPL[t] = sqrt(2) * cos((p / 100 + 1) * $pi / 4);
    VPR[t] = sqrt(2) * sin((p / 100 + 1) * $pi / 4);
  );

  // one sequencer step on every track: its value in the track's own length
  function play_step(s) local(t, len, i, v, vel)
  (
    t = 0;
    loop(NT,
      len = max(1, pb[160 + t]);
      i = s - floor(s / len) * len;
      v = pb[t * 16 + i];
      v > 0 ? (
        vel = v == 2 ? 1 : 1 - 0.5 * acc;
        v == 3 ? ( trig(t, vel * 0.5); PEND[t] = flam_n; PVEL[t] = vel; ) :
        v == 4 ? ( trig(t, vel); PEND[t] = roll_n; PVEL[t] = vel * 0.8; ) :
        trig(t, vel);
      );
      t += 1;
    );
  );

  // all voices quiet, sequencer waiting for the next step
  k_on = s_on = c_on = r_on = h_on = o_on = b_on = y_on = 0;
  lt.on = ht.on = 0;
  memset(PEND, 0, NT);
  last_s = -1000;
  seed = 22222;
  gr_ph = 0; gr_hl = gr_hr = 0;
  dm_preview = 0;
  m_ofs = m_1 = m_2 = m_3 = 0;

@serialize
  file_var(0, ser_ver);
  file_mem(0, 0, 170);

@slider
  pat = floor(slider1 + 0.5);
  sw = slider2 / 100;
  acc = slider3 / 100;
  drv = slider4 / 100;
  drv_g = 1 + 3 * drv;
  grit = slider5 / 100;
  gr_step = 48000 * (1 / 6) ^ grit / srate;
  gr_q = 2 ^ (15 - 11 * grit);
  vol = 10 ^ (slider6 / 20);

  // Kick: 808 boom (Tone 0) to 909 punch (Tone 100): more click, faster and deeper sweep
  pan_set(0, slider7, slider11);
  k_f0 = 48 * 2 ^ (slider8 / 12);
  d = slider9 / 100; o = slider10 / 100;
  k_sw = 1.5 + 4 * o;
  k_pc = dcy(0.008 + 0.012 * (1 - o));
  k_ac = dcy(0.06 + 1.4 * d * d);
  k_cc = dcy(0.0015);
  k_cl = 0.6 * o;

  // Snare: two tones with a short pitch drop plus high-passed noise; Tone = Snappy
  pan_set(1, slider12, slider16);
  r = 2 ^ (slider13 / 12);
  d = slider14 / 100; o = slider15 / 100;
  s_f1 = 185 * r; s_f2 = 330 * r;
  s_pc = dcy(0.012);
  s_bc = dcy(0.02 + 0.12 * d);
  s_nc = dcy(0.03 + 0.05 * d + 0.25 * d * d);
  s_bg = 1 - 0.7 * o; s_ng = 0.3 + 0.7 * o;
  s_hp.svf_set(1800 * r, 0.7);

  // Clap: three bursts of band-passed noise 11 ms apart, then the tail; Tone = tail level
  pan_set(2, slider17, slider21);
  r = 2 ^ (slider18 / 12);
  d = slider19 / 100; o = slider20 / 100;
  c_bp.svf_set(1100 * r, 1.6);
  c_per = floor(0.011 * srate);
  c_bc = dcy(0.0045);
  c_tc = dcy(0.05 + 0.05 * d + 0.5 * d * d);
  c_tail = 0.25 + 0.75 * o;

  // Rim: 808 rimshot (two tones and a click) to clave (one high tone)
  pan_set(3, slider22, slider26);
  r = 2 ^ (slider23 / 12);
  d = slider24 / 100; o = slider25 / 100;
  r_d1 = 480 * r / srate; r_d2 = 1650 * r / srate; r_d3 = 2500 * r / srate;
  r_c = dcy(0.006 + 0.06 * d);
  r_m = o;

  // Closed and open hat: 808 metal (Tone 0) to 909-like noise (Tone 100), band-passed and
  // high-passed; the closed hat chokes the open one
  pan_set(4, slider27, slider31);
  r = 2 ^ (slider28 / 12);
  d = slider29 / 100;
  h_mx = slider30 / 100;
  h_m.metal_set(r);
  h_bp.svf_set(9000 * r, 1.2);
  h_hp.svf_set(6500 * r, 0.7);
  h_c = dcy(0.008 + 0.07 * d);

  pan_set(5, slider32, slider36);
  r = 2 ^ (slider33 / 12);
  d = slider34 / 100;
  o_mx = slider35 / 100;
  o_m.metal_set(r);
  o_bp.svf_set(9000 * r, 1.2);
  o_hp.svf_set(6500 * r, 0.7);
  o_c = dcy(0.06 + 0.05 * d + 0.9 * d * d);
  o_kc = dcy(0.004);

  // Toms: Tone from a steady conga-like pitch to the Simmons sweep
  pan_set(6, slider37, slider41);
  lt.tom_set(95 * 2 ^ (slider38 / 12), slider39 / 100, slider40 / 100);
  pan_set(7, slider42, slider46);
  ht.tom_set(165 * 2 ^ (slider43 / 12), slider44 / 100, slider45 / 100);

  // Cowbell: two squares (540 and 800 Hz) through a band-pass; Tone = brightness
  pan_set(8, slider47, slider51);
  r = 2 ^ (slider48 / 12);
  d = slider49 / 100; o = slider50 / 100;
  b_d1 = 540 * r / srate; b_d2 = 800 * r / srate;
  b_bp.svf_set((600 + 1800 * o) * r, 2.5);
  b_c1 = dcy(0.012);
  b_c2 = dcy(0.04 + 0.4 * d);

  // Cymbal: metal plus noise, ride (Tone 0) to crash (Tone 100)
  pan_set(9, slider52, slider56);
  r = 2 ^ (slider53 / 12);
  d = slider54 / 100; o = slider55 / 100;
  y_m.metal_set(r * 1.18);
  y_bp.svf_set((5000 + 4000 * o) * r, 0.8);
  y_hp.svf_set(4000 * r, 0.7);
  y_c = dcy(0.25 + 0.2 * d + 2.2 * d * d);
  y_mx = 0.15 + 0.6 * o;

@block
  // MIDI note-ons of this block, played at their offsets in @sample
  mq_n = 0;
  while (midirecv(m_ofs, m_1, m_2, m_3)) (
    (m_1 & 0xF0) == 0x90 && m_3 > 0 && mq_n < 128 ? (
      MQ[mq_n * 3] = m_ofs;
      MQ[mq_n * 3 + 1] = m_2;
      MQ[mq_n * 3 + 2] = m_3 / 127;
      mq_n += 1;
    );
  );
  mq_i = 0;

  // the sequencer runs while the host plays; the pattern is the User one (memory 0) or a factory one
  seq_on = (play_state & 1) && pat > 0;
  !seq_on ? last_s = -1000;
  pb = pat <= 1 ? 0 : FACT + (pat - 2) * 170;
  b_inc = tempo / (60 * srate);
  b_0 = beat_position;
  flam_n = max(1, floor(0.018 * srate));
  roll_n = max(1, floor(7.5 / tempo * srate));
  si = 0;

  // a voice heard from the interface (GFX version)
  dm_preview > 0 ? ( trig(dm_preview - 1, 1); dm_preview = 0; );

@sample
  while (mq_i < mq_n && MQ[mq_i * 3] <= si) (
    note_on(MQ[mq_i * 3 + 1], MQ[mq_i * 3 + 2]);
    mq_i += 1;
  );

  // delayed hits (flam, roll)
  t = 0;
  loop(NT,
    PEND[t] > 0 ? (
      PEND[t] -= 1;
      PEND[t] < 0.5 ? trig(t, PVEL[t]);
    );
    t += 1;
  );

  // sixteenths, the odd ones moved later by Swing; a step plays when the position enters it
  seq_on ? (
    bb = b_0 + si * b_inc;
    bb >= 0 ? (
      p8 = floor(bb * 2 + 0.000001);
      s = p8 * 2 + (bb * 2 - p8 + 0.000001 >= sw ? 1 : 0);
      s != last_s ? (
        // at transport start, only when it starts on the step's beginning
        last_s > -1000 || bb - (s & 1 ? p8 + sw : p8) / 2 < 0.001 ? play_step(s);
        last_s = s;
      );
    );
  );
  dm_step = seq_on ? last_s : -1;
  si += 1;

  // white noise (Park-Miller), shared by the voices
  seed *= 16807; seed -= floor(seed / 2147483647) * 2147483647;
  nz = seed / 1073741824 - 1;
  outl = outr = 0;

  k_on ? (
    k_ph += k_f0 * (1 + k_sw * k_pe) / srate;
    k_ph -= floor(k_ph);
    y = sin(2 * $pi * k_ph) * k_env + nz * k_ce * k_cl;
    k_pe *= k_pc; k_env *= k_ac; k_ce *= k_cc;
    k_env < 0.000001 ? k_on = 0;
    y *= 0.45 * VL[0]; outl += y * VPL[0]; outr += y * VPR[0];
  );

  s_on ? (
    s_ph1 += s_f1 * (1 + 0.6 * s_pe) / srate; s_ph1 -= floor(s_ph1);
    s_ph2 += s_f2 * (1 + 0.6 * s_pe) / srate; s_ph2 -= floor(s_ph2);
    s_hp.svf(nz);
    y = (sin(2 * $pi * s_ph1) + 0.6 * sin(2 * $pi * s_ph2)) * 0.6 * s_be * s_bg + s_hp.hp * s_ne * s_ng;
    s_pe *= s_pc; s_be *= s_bc; s_ne *= s_nc;
    s_be + s_ne < 0.000001 ? s_on = 0;
    y *= 0.35 * VL[1]; outl += y * VPL[1]; outr += y * VPR[1];
  );

  c_on ? (
    c_t < 3 * c_per ? (
      c_t == 0 || c_t == c_per || c_t == 2 * c_per ? c_env = 1;
      g = c_env; c_env *= c_bc;
    ) : (
      c_t == 3 * c_per ? c_env = c_tail;
      g = c_env; c_env *= c_tc;
      c_env < 0.000001 ? c_on = 0;
    );
    c_t += 1;
    c_bp.svf(nz);
    y = c_bp.bp * g * c_vel * 1.2 * VL[2]; outl += y * VPL[2]; outr += y * VPR[2];
  );

  r_on ? (
    r_ph1 += r_d1; r_ph1 -= floor(r_ph1);
    r_ph2 += r_d2; r_ph2 -= floor(r_ph2);
    r_ph3 += r_d3; r_ph3 -= floor(r_ph3);
    y = ((1 - r_m) * (0.6 * sin(2 * $pi * r_ph1) + 0.5 * sin(2 * $pi * r_ph2) + 0.4 * nz * r_env)
         + r_m * sin(2 * $pi * r_ph3)) * r_env;
    r_env *= r_c;
    r_env < 0.000001 ? r_on = 0;
    y *= 0.24 * VL[3]; outl += y * VPL[3]; outr += y * VPR[3];
  );

  h_on ? (
    h_bp.svf((1 - h_mx) * h_m.metal() + h_mx * nz);
    h_hp.svf(h_bp.bp);
    y = h_hp.hp * h_env;
    h_env *= h_c;
    h_env < 0.000001 ? h_on = 0;
    y *= 0.68 * VL[4]; outl += y * VPL[4]; outr += y * VPR[4];
  );

  o_on ? (
    o_bp.svf((1 - o_mx) * o_m.metal() + o_mx * nz);
    o_hp.svf(o_bp.bp);
    y = o_hp.hp * o_env;
    o_env *= o_choke ? o_kc : o_c;
    o_env < 0.000001 ? o_on = 0;
    y *= 0.68 * VL[5]; outl += y * VPL[5]; outr += y * VPR[5];
  );

  lt.on ? ( y = lt.tom(nz) * 0.38 * VL[6]; outl += y * VPL[6]; outr += y * VPR[6]; );
  ht.on ? ( y = ht.tom(nz) * 0.38 * VL[7]; outl += y * VPL[7]; outr += y * VPR[7]; );

  b_on ? (
    b_bp.svf(square(b_p1, b_d1) + square(b_p2, b_d2));
    b_p1 += b_d1; b_p1 -= floor(b_p1);
    b_p2 += b_d2; b_p2 -= floor(b_p2);
    y = b_bp.bp * (b_e1 + b_e2);
    b_e1 *= b_c1; b_e2 *= b_c2;
    b_e2 < 0.000001 ? b_on = 0;
    y *= 0.13 * VL[8]; outl += y * VPL[8]; outr += y * VPR[8];
  );

  y_on ? (
    y_bp.svf((1 - y_mx) * y_m.metal() + y_mx * nz);
    y_hp.svf(y_bp.bp);
    y = y_hp.hp * y_env;
    y_env *= y_c;
    y_env < 0.000001 ? y_on = 0;
    y *= 0.6 * VL[9]; outl += y * VPL[9]; outr += y * VPR[9];
  );

  // Drive: soft clipping of the whole kit
  drv > 0 ? (
    u = max(-3, min(3, outl * drv_g)); outl = u * (27 + u * u) / (27 + 9 * u * u) / (1 + drv);
    u = max(-3, min(3, outr * drv_g)); outr = u * (27 + u * u) / (27 + 9 * u * u) / (1 + drv);
  );

  // Grit: sample-and-hold at a lower rate (48 kHz down to 8 kHz) and fewer bits (15 down to 4)
  grit > 0 ? (
    gr_ph += gr_step;
    gr_ph >= 1 ? (
      gr_ph -= floor(gr_ph);
      gr_hl = floor(outl * gr_q + 0.5) / gr_q;
      gr_hr = floor(outr * gr_q + 0.5) / gr_q;
    );
    outl = gr_hl; outr = gr_hr;
  );

  spl0 = outl * vol;
  spl1 = outr * vol;
