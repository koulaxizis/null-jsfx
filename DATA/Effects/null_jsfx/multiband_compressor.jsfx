desc:NULL Multiband Comp
author: Christos Koulaxizis
tags: multiband compressor four-band crossover dynamics mastering per-band
//category: Essentials
//NULL JSFX v2.0 • https://nulljsfx.tech • MIT License

slider1:120<50,1000,1>Crossover 1 (Hz)
slider2:1000<500,4000,1>Crossover 2 (Hz)
slider3:6000<4000,12000,1>Crossover 3 (Hz)
slider4:-20<-60,0,1>Low Threshold (dB)
slider5:3<1,20,0.1>Low Ratio
slider6:0<0,12,1>Low Makeup (dB)
slider7:0<0,3,1{Active,Bypass,Mute,Solo}>Low Mode
slider8:-20<-60,0,1>LowMid Threshold (dB)
slider9:3<1,20,0.1>LowMid Ratio
slider10:0<0,12,1>LowMid Makeup (dB)
slider11:0<0,3,1{Active,Bypass,Mute,Solo}>LowMid Mode
slider12:-20<-60,0,1>HighMid Threshold (dB)
slider13:3<1,20,0.1>HighMid Ratio
slider14:0<0,12,1>HighMid Makeup (dB)
slider15:0<0,3,1{Active,Bypass,Mute,Solo}>HighMid Mode
slider16:-20<-60,0,1>High Threshold (dB)
slider17:3<1,20,0.1>High Ratio
slider18:0<0,12,1>High Makeup (dB)
slider19:0<0,3,1{Active,Bypass,Mute,Solo}>High Mode
slider20:10<0,200,1>Attack (ms)
slider21:100<0,1000,1>Release (ms)
slider22:0<0,100,1>Knee (%)
slider23:0<0,12,1>Master Output (dB)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  PI = 3.14159265358979;
  LN10 = 2.30258509299405;
  DB2LIN = LN10 / 20;

  x1_l1=0; x1_l2=0; x1_l3=0; x1_l4=0;
  x1_r1=0; x1_r2=0; x1_r3=0; x1_r4=0;

  x2_l1=0; x2_l2=0; x2_l3=0; x2_l4=0;
  x2_r1=0; x2_r2=0; x2_r3=0; x2_r4=0;

  x3_l1=0; x3_l2=0; x3_l3=0; x3_l4=0;
  x3_r1=0; x3_r2=0; x3_r3=0; x3_r4=0;

  env_lo=1; env_lm=1; env_hm=1; env_hi=1;

@slider
  // Internal limits match the slider ranges. Each crossover is kept at least
  // 1.5x (about 7 semitones) above the one below it, so the bands never overlap
  // or invert: Crossover 2 >= 1.5 x Crossover 1, Crossover 3 >= 1.5 x Crossover 2.
  xover1 = max(50, min(1000, slider1));
  xover2 = max(xover1 * 1.5, max(500, min(4000, slider2)));
  xover3 = max(xover2 * 1.5, max(4000, min(12000, slider3)));
  xover3 = min(xover3, 0.45 * srate);

  lo_thr = slider4;
  lo_ratio = max(1, min(20, slider5));
  lo_mk = slider6;
  lo_mode = slider7;

  lm_thr = slider8;
  lm_ratio = max(1, min(20, slider9));
  lm_mk = slider10;
  lm_mode = slider11;

  hm_thr = slider12;
  hm_ratio = max(1, min(20, slider13));
  hm_mk = slider14;
  hm_mode = slider15;

  hi_thr = slider16;
  hi_ratio = max(1, min(20, slider17));
  hi_mk = slider18;
  hi_mode = slider19;

  att_ms = max(0, slider20);
  rel_ms = max(0, slider21);
  knee_pct = max(0, min(100, slider22));
  master_db = slider23;

  alpha1 = 1 - exp(-2 * PI * xover1 / srate);
  alpha2 = 1 - exp(-2 * PI * xover2 / srate);
  alpha3 = 1 - exp(-2 * PI * xover3 / srate);

  att_ms > 0 ? (att_c = 1 - exp(-1000 / (att_ms * srate));) : (att_c = 1;);
  rel_ms > 0 ? (rel_c = 1 - exp(-1000 / (rel_ms * srate));) : (rel_c = 1;);

  lo_mk_lin = exp(lo_mk * DB2LIN);
  lm_mk_lin = exp(lm_mk * DB2LIN);
  hm_mk_lin = exp(hm_mk * DB2LIN);
  hi_mk_lin = exp(hi_mk * DB2LIN);
  master_lin = exp(master_db * DB2LIN);

  lo_rf = 1 - (1 / lo_ratio);
  lm_rf = 1 - (1 / lm_ratio);
  hm_rf = 1 - (1 / hm_ratio);
  hi_rf = 1 - (1 / hi_ratio);

  knee_w = knee_pct * 0.6;

@sample
  // CROSSOVER 1: LP at xover1 → Low band
  x1_l1 = x1_l1 + alpha1 * (spl0 - x1_l1);
  x1_l2 = x1_l2 + alpha1 * (x1_l1 - x1_l2);
  x1_l3 = x1_l3 + alpha1 * (x1_l2 - x1_l3);
  x1_l4 = x1_l4 + alpha1 * (x1_l3 - x1_l4);
  x1_r1 = x1_r1 + alpha1 * (spl1 - x1_r1);
  x1_r2 = x1_r2 + alpha1 * (x1_r1 - x1_r2);
  x1_r3 = x1_r3 + alpha1 * (x1_r2 - x1_r3);
  x1_r4 = x1_r4 + alpha1 * (x1_r3 - x1_r4);
  low_l = x1_l4;
  low_r = x1_r4;

  rem1_l = spl0 - low_l;
  rem1_r = spl1 - low_r;

  // CROSSOVER 2: LP at xover2 on Remainder 1 → LowMid band
  x2_l1 = x2_l1 + alpha2 * (rem1_l - x2_l1);
  x2_l2 = x2_l2 + alpha2 * (x2_l1 - x2_l2);
  x2_l3 = x2_l3 + alpha2 * (x2_l2 - x2_l3);
  x2_l4 = x2_l4 + alpha2 * (x2_l3 - x2_l4);
  x2_r1 = x2_r1 + alpha2 * (rem1_r - x2_r1);
  x2_r2 = x2_r2 + alpha2 * (x2_r1 - x2_r2);
  x2_r3 = x2_r3 + alpha2 * (x2_r2 - x2_r3);
  x2_r4 = x2_r4 + alpha2 * (x2_r3 - x2_r4);
  lowmid_l = x2_l4;
  lowmid_r = x2_r4;

  rem2_l = rem1_l - lowmid_l;
  rem2_r = rem1_r - lowmid_r;

  // CROSSOVER 3: LP at xover3 on Remainder 2 → HighMid band
  x3_l1 = x3_l1 + alpha3 * (rem2_l - x3_l1);
  x3_l2 = x3_l2 + alpha3 * (x3_l1 - x3_l2);
  x3_l3 = x3_l3 + alpha3 * (x3_l2 - x3_l3);
  x3_l4 = x3_l4 + alpha3 * (x3_l3 - x3_l4);
  x3_r1 = x3_r1 + alpha3 * (rem2_r - x3_r1);
  x3_r2 = x3_r2 + alpha3 * (x3_r1 - x3_r2);
  x3_r3 = x3_r3 + alpha3 * (x3_r2 - x3_r3);
  x3_r4 = x3_r4 + alpha3 * (x3_r3 - x3_r4);
  highmid_l = x3_l4;
  highmid_r = x3_r4;

  high_l = rem2_l - highmid_l;
  high_r = rem2_r - highmid_r;

  // ─── LOW BAND ───
  abs_l = low_l < 0 ? -low_l : low_l;
  abs_r = low_r < 0 ? -low_r : low_r;
  peak = abs_l > abs_r ? abs_l : abs_r;
  peak_db = peak > 0 ? log(peak) / LN10 * 20 : -200;
  ks = lo_thr - knee_w;
  ke = lo_thr + knee_w;
  over = peak_db - lo_thr;
  peak_db > ke ? (
    gr_db = over * lo_rf;
  ) : (
    peak_db > ks ? (
      kp = (peak_db - ks) / (knee_w * 2);
      gr_db = over * lo_rf * kp * kp;
    ) : (
      gr_db = 0;
    );
  );
  gr_db = gr_db > 60 ? 60 : gr_db;
  gr_lin = exp(-gr_db * DB2LIN);
  gr_lin < env_lo ? (
    env_lo = env_lo + (gr_lin - env_lo) * att_c;
  ) : (
    env_lo = env_lo + (gr_lin - env_lo) * rel_c;
  );
  lo_mode == 1 ? (
    lo_out_l = low_l * lo_mk_lin;
    lo_out_r = low_r * lo_mk_lin;
  ) : (
    lo_out_l = low_l * env_lo * lo_mk_lin;
    lo_out_r = low_r * env_lo * lo_mk_lin;
  );

  // ─── LOW MID BAND ───
  abs_l = lowmid_l < 0 ? -lowmid_l : lowmid_l;
  abs_r = lowmid_r < 0 ? -lowmid_r : lowmid_r;
  peak = abs_l > abs_r ? abs_l : abs_r;
  peak_db = peak > 0 ? log(peak) / LN10 * 20 : -200;
  ks = lm_thr - knee_w;
  ke = lm_thr + knee_w;
  over = peak_db - lm_thr;
  peak_db > ke ? (
    gr_db = over * lm_rf;
  ) : (
    peak_db > ks ? (
      kp = (peak_db - ks) / (knee_w * 2);
      gr_db = over * lm_rf * kp * kp;
    ) : (
      gr_db = 0;
    );
  );
  gr_db = gr_db > 60 ? 60 : gr_db;
  gr_lin = exp(-gr_db * DB2LIN);
  gr_lin < env_lm ? (
    env_lm = env_lm + (gr_lin - env_lm) * att_c;
  ) : (
    env_lm = env_lm + (gr_lin - env_lm) * rel_c;
  );
  lm_mode == 1 ? (
    lm_out_l = lowmid_l * lm_mk_lin;
    lm_out_r = lowmid_r * lm_mk_lin;
  ) : (
    lm_out_l = lowmid_l * env_lm * lm_mk_lin;
    lm_out_r = lowmid_r * env_lm * lm_mk_lin;
  );

  // ─── HIGH MID BAND ───
  abs_l = highmid_l < 0 ? -highmid_l : highmid_l;
  abs_r = highmid_r < 0 ? -highmid_r : highmid_r;
  peak = abs_l > abs_r ? abs_l : abs_r;
  peak_db = peak > 0 ? log(peak) / LN10 * 20 : -200;
  ks = hm_thr - knee_w;
  ke = hm_thr + knee_w;
  over = peak_db - hm_thr;
  peak_db > ke ? (
    gr_db = over * hm_rf;
  ) : (
    peak_db > ks ? (
      kp = (peak_db - ks) / (knee_w * 2);
      gr_db = over * hm_rf * kp * kp;
    ) : (
      gr_db = 0;
    );
  );
  gr_db = gr_db > 60 ? 60 : gr_db;
  gr_lin = exp(-gr_db * DB2LIN);
  gr_lin < env_hm ? (
    env_hm = env_hm + (gr_lin - env_hm) * att_c;
  ) : (
    env_hm = env_hm + (gr_lin - env_hm) * rel_c;
  );
  hm_mode == 1 ? (
    hm_out_l = highmid_l * hm_mk_lin;
    hm_out_r = highmid_r * hm_mk_lin;
  ) : (
    hm_out_l = highmid_l * env_hm * hm_mk_lin;
    hm_out_r = highmid_r * env_hm * hm_mk_lin;
  );

  // ─── HIGH BAND ───
  abs_l = high_l < 0 ? -high_l : high_l;
  abs_r = high_r < 0 ? -high_r : high_r;
  peak = abs_l > abs_r ? abs_l : abs_r;
  peak_db = peak > 0 ? log(peak) / LN10 * 20 : -200;
  ks = hi_thr - knee_w;
  ke = hi_thr + knee_w;
  over = peak_db - hi_thr;
  peak_db > ke ? (
    gr_db = over * hi_rf;
  ) : (
    peak_db > ks ? (
      kp = (peak_db - ks) / (knee_w * 2);
      gr_db = over * hi_rf * kp * kp;
    ) : (
      gr_db = 0;
    );
  );
  gr_db = gr_db > 60 ? 60 : gr_db;
  gr_lin = exp(-gr_db * DB2LIN);
  gr_lin < env_hi ? (
    env_hi = env_hi + (gr_lin - env_hi) * att_c;
  ) : (
    env_hi = env_hi + (gr_lin - env_hi) * rel_c;
  );
  hi_mode == 1 ? (
    hi_out_l = high_l * hi_mk_lin;
    hi_out_r = high_r * hi_mk_lin;
  ) : (
    hi_out_l = high_l * env_hi * hi_mk_lin;
    hi_out_r = high_r * env_hi * hi_mk_lin;
  );

  // SOLO/MUTE/BYPASS + OUTPUT
  any_solo = (lo_mode == 3) || (lm_mode == 3) || (hm_mode == 3) || (hi_mode == 3);

  any_solo ? (
    spl0 = 0;
    spl1 = 0;
    lo_mode == 3 ? (spl0 = spl0 + lo_out_l; spl1 = spl1 + lo_out_r;);
    lm_mode == 3 ? (spl0 = spl0 + lm_out_l; spl1 = spl1 + lm_out_r;);
    hm_mode == 3 ? (spl0 = spl0 + hm_out_l; spl1 = spl1 + hm_out_r;);
    hi_mode == 3 ? (spl0 = spl0 + hi_out_l; spl1 = spl1 + hi_out_r;);
  ) : (
    spl0 = lo_out_l + lm_out_l + hm_out_l + hi_out_l;
    spl1 = lo_out_r + lm_out_r + hm_out_r + hi_out_r;
    lo_mode == 2 ? (spl0 = spl0 - lo_out_l; spl1 = spl1 - lo_out_r;);
    lm_mode == 2 ? (spl0 = spl0 - lm_out_l; spl1 = spl1 - lm_out_r;);
    hm_mode == 2 ? (spl0 = spl0 - hm_out_l; spl1 = spl1 - hm_out_r;);
    hi_mode == 2 ? (spl0 = spl0 - hi_out_l; spl1 = spl1 - hi_out_r;);
  );

  spl0 = spl0 * master_lin;
  spl1 = spl1 * master_lin;
