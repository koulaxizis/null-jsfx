desc:NULL Spectrum Analyzer
author: Christos Koulaxizis
tags: spectrum analyzer analyser fft frequency meter metering peak hold slope visual mixing mastering
//category: Advanced
//NULL JSFX v2.6 • https://nulljsfx.tech • MIT License

slider1:2<0,4,1{1024,2048,4096,8192,16384}>FFT Size
slider2:4.5<0,6,0.5>Slope (dB/oct)
slider3:300<0,2000,10>Release (ms)
slider4:2<0,3,1{60 dB,80 dB,100 dB,120 dB}>Range
slider5:1<0,2,1{Off,2 s,Infinite}>Peak Hold
slider6:0<0,3,1{Mid,Left,Right,Side}>Channel
slider7:0<0,1,1{Stereo,Solo}>Monitor

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  // FFT spectrum analyzer. The audio passes through untouched (Monitor Solo only plays the
  // analysed channel on both sides). Every hop (25 ms, at most half a frame) the last N
  // samples of the chosen channel get a Hann window and an FFT; each bin's power (0 dB = a
  // full-scale sine) rises at once and falls with Release, and a second set holds the peaks.
  // Slope tilts the display around 1 kHz; Range is the floor of the display below 0 dB.
  // This file shows nothing: the GFX version (gfx/spectrum_analyzer_gfx.jsfx) and the
  // VST3/CLAP draw the spectrum from these bins.
  sa_ring = 0;                 // input ring, 16384
  sa_win = 16384;              // Hann window, N
  sa_buf = 65536;              // FFT buffer, 2N, does not cross a 65536 boundary
  sa_spec = 131072;            // smoothed power, N/2 + 1
  sa_hold = 147456;            // held power
  sa_holdt = 163840;           // hold countdown in frames
  freembuf(sa_holdt + 8193);
  memset(0, 0, sa_holdt + 8193);
  sa_wp = 0;
  sa_hc = 0;
  sa_n = 0;
  sa_hmode = -1;

  function sa_frame() local(i, p, k, re, im, pw, s)
  (
    i = 0;
    p = sa_wp - sa_n;
    p < 0 ? p += 16384;
    loop(sa_n,
      sa_buf[2 * i] = sa_ring[p] * sa_win[i];
      sa_buf[2 * i + 1] = 0;
      p += 1;
      p >= 16384 ? p = 0;
      i += 1;
    );
    fft(sa_buf, sa_n);
    fft_permute(sa_buf, sa_n);
    k = 0;
    loop(sa_n / 2 + 1,
      re = sa_buf[2 * k];
      im = sa_buf[2 * k + 1];
      pw = (re * re + im * im) * sa_norm;
      s = sa_spec[k];
      s = pw > s ? pw : s * sa_rc + pw * (1 - sa_rc);
      sa_spec[k] = s;
      sa_hmode > 0 ? (
        s >= sa_hold[k] ? (
          sa_hold[k] = s;
          sa_holdt[k] = sa_hframes;
        ) : sa_hmode == 1 ? (
          sa_holdt[k] > 0 ? (sa_holdt[k] -= 1) : (sa_hold[k] = s);
        );
      );
      k += 1;
    );
  );

@slider
  sa_nn = slider1 == 0 ? 1024 : slider1 == 1 ? 2048 : slider1 == 2 ? 4096 : slider1 == 3 ? 8192 : 16384;
  sa_nn != sa_n || slider5 != sa_hmode ? (
    sa_nn != sa_n ? (
      sa_n = sa_nn;
      sa_i = 0;
      loop(sa_n, sa_win[sa_i] = 0.5 - 0.5 * cos(2 * $pi * sa_i / sa_n); sa_i += 1;);
      memset(sa_spec, 0, 8193);
    );
    sa_hmode = slider5;
    memset(sa_hold, 0, 8193);
    memset(sa_holdt, 0, 8193);
  );
  sa_hop = min(sa_n / 2, floor(srate / 40 + 0.5));
  sa_norm = 16 / (sa_n * sa_n);
  sa_rc = slider3 > 0 ? exp(-sa_hop / (srate * slider3 / 1000)) : 0;
  sa_hframes = ceil(2 * srate / sa_hop);
  sa_chan = slider6;
  sa_solo = slider7;

@sample
  sa_x = sa_chan == 0 ? (spl0 + spl1) * 0.5 : sa_chan == 1 ? spl0 : sa_chan == 2 ? spl1 : (spl0 - spl1) * 0.5;
  sa_ring[sa_wp] = sa_x;
  sa_wp += 1;
  sa_wp >= 16384 ? sa_wp = 0;
  sa_hc += 1;
  sa_hc >= sa_hop ? (
    sa_hc = 0;
    sa_frame();
  );
  sa_solo ? (
    spl0 = sa_x;
    spl1 = sa_x;
  );
