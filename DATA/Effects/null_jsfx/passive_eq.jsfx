desc:NULL Passive EQ
author: Christos Koulaxizis
tags: eq equalizer passive program tube vintage low boost attenuate shelf air bandwidth mastering color
//category: Essentials
//NULL JSFX v2.9 • https://nulljsfx.tech • MIT License

slider1:2<0,3,1{20 Hz,30 Hz,60 Hz,100 Hz}>Low Freq
slider2:0<0,10,0.1>Low Boost
slider3:0<0,10,0.1>Low Atten
slider4:3<0,6,1{3 kHz,4 kHz,5 kHz,8 kHz,10 kHz,12 kHz,16 kHz}>High Freq
slider5:0<0,10,0.1>High Boost
slider6:5<0,10,0.1>Bandwidth
slider7:1<0,2,1{5 kHz,10 kHz,20 kHz}>Atten Freq
slider8:0<0,10,0.1>High Atten
slider9:0<0,100,1>Tube (%)
slider10:0<-12,12,0.1>Output (dB)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep the filters, as in the VST3/CLAP
  // A program EQ in the passive style, with broad, musical curves and no frequency knobs to
  // hunt with. Low Boost is a low shelf at 1.2 x Low Freq (up to +13.5 dB) and Low Atten a
  // gentler shelf at 2.2 x Low Freq (down to -17.5 dB): both together give the classic bump
  // under the frequency with a dip just above it. High Boost is a peak at High Freq (up to
  // +18 dB) whose width is Bandwidth (0 sharp, 10 broad); High Atten is a high shelf at Atten
  // Freq (down to -20 dB). Tube drives a slightly asymmetric tanh stage (even harmonics) with
  // a 10 Hz DC blocker after it. Every band at 0 and Tube at 0 % leave the sound untouched.
  ST = 0;                      // filter state: 4 biquads x 2 channels x 2 values
  memset(ST, 0, 16);
  dcl = dcr = dxl = dxr = 0;

  // tanh (EEL2 has none): (e^2x - 1) / (e^2x + 1), clamped
  function pe_tanh(x) local(e)
  (
    x > 20 ? 1 : x < -20 ? -1 : (e = exp(2 * x); (e - 1) / (e + 1));
  );

  // RBJ biquads: kind 0 = low shelf (slope S), 1 = high shelf (slope S), 2 = peaking (Q)
  function pe_bq(kind, f, sq, g) local(w0, cw, sw, A, al, a0, b2a)
  (
    w0 = 2 * $pi * min(f, 0.45 * srate) / srate;
    cw = cos(w0);
    sw = sin(w0);
    A = 10 ^ (g / 40);
    kind == 2 ? (
      al = sw / (2 * sq);
      a0 = 1 + al / A;
      this.b0 = (1 + al * A) / a0;
      this.b1 = -2 * cw / a0;
      this.b2 = (1 - al * A) / a0;
      this.a1 = this.b1;
      this.a2 = (1 - al / A) / a0;
    ) : (
      al = sw / 2 * sqrt((A + 1 / A) * (1 / sq - 1) + 2);
      b2a = 2 * sqrt(A) * al;
      kind == 0 ? (
        a0 = (A + 1) + (A - 1) * cw + b2a;
        this.b0 = A * ((A + 1) - (A - 1) * cw + b2a) / a0;
        this.b1 = 2 * A * ((A - 1) - (A + 1) * cw) / a0;
        this.b2 = A * ((A + 1) - (A - 1) * cw - b2a) / a0;
        this.a1 = -2 * ((A - 1) + (A + 1) * cw) / a0;
        this.a2 = ((A + 1) + (A - 1) * cw - b2a) / a0;
      ) : (
        a0 = (A + 1) - (A - 1) * cw + b2a;
        this.b0 = A * ((A + 1) + (A - 1) * cw + b2a) / a0;
        this.b1 = -2 * A * ((A - 1) + (A + 1) * cw) / a0;
        this.b2 = A * ((A + 1) + (A - 1) * cw - b2a) / a0;
        this.a1 = 2 * ((A - 1) - (A + 1) * cw) / a0;
        this.a2 = ((A + 1) - (A - 1) * cw - b2a) / a0;
      );
    );
  );

  function pe_run(x, s) local(y)
  (
    y = this.b0 * x + ST[s];
    ST[s] = this.b1 * x - this.a1 * y + ST[s + 1];
    ST[s + 1] = this.b2 * x - this.a2 * y;
    y;
  );

  function pe_chain(x, c)
  (
    lb_on ? x = lb.pe_run(x, c * 8);
    la_on ? x = la.pe_run(x, c * 8 + 2);
    hb_on ? x = hb.pe_run(x, c * 8 + 4);
    ha_on ? x = ha.pe_run(x, c * 8 + 6);
    x;
  );

@slider
  lf = slider1 == 0 ? 20 : slider1 == 1 ? 30 : slider1 == 2 ? 60 : 100;
  hf = slider4 == 0 ? 3000 : slider4 == 1 ? 4000 : slider4 == 2 ? 5000 : slider4 == 3 ? 8000 :
       slider4 == 4 ? 10000 : slider4 == 5 ? 12000 : 16000;
  af = slider7 == 0 ? 5000 : slider7 == 1 ? 10000 : 20000;
  lb_on = slider2 > 0;
  la_on = slider3 > 0;
  hb_on = slider5 > 0;
  ha_on = slider8 > 0;
  lb.pe_bq(0, 1.2 * lf, 0.7, 1.35 * slider2);
  la.pe_bq(0, 2.2 * lf, 0.4, -1.75 * slider3);
  hb.pe_bq(2, hf, 2.2 - 0.19 * slider6, 1.8 * slider5);
  ha.pe_bq(1, af, 0.6, -2 * slider8);
  tube = slider9 / 100;
  tk = 1 + 3 * tube;
  tb = 0.2 * tube;
  tz = pe_tanh(tb);
  dca = exp(-2 * $pi * 10 / srate);
  og = 10 ^ (slider10 / 20);

@sample
  l = pe_chain(spl0, 0);
  r = pe_chain(spl1, 1);
  tube > 0 ? (
    l = (pe_tanh(tk * l + tb) - tz) / tk;
    r = (pe_tanh(tk * r + tb) - tz) / tk;
    // DC blocker: y = x - x1 + a * y1
    yl = l - dxl + dca * dcl;
    dxl = l;
    dcl = yl;
    l = yl;
    yr = r - dxr + dca * dcr;
    dxr = r;
    dcr = yr;
    r = yr;
  );
  spl0 = l * og;
  spl1 = r * og;
