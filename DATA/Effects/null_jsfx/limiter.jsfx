desc:NULL Limiter
author: Christos Koulaxizis
tags: limiter ceiling clipper brickwall peak protection mastering
//category: Essentials
//NULL JSFX v2.0 • https://nulljsfx.tech • MIT License

slider1:0<0,2,1{Limiter,Clipper,Brickwall}>Mode
slider2:0<-30,0,0.1>Threshold (dB)
slider3:-0.1<-6,-0.1,0.1>Ceiling (dB)
slider4:200<0,1000,1>Release (ms)
slider5:2<0,10,0.1>Lookahead (ms)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  // Limiter:   look-ahead limiter; the gain starts falling before a peak arrives.
  // Clipper:   soft clipper, no delay.
  // Brickwall: like Limiter but the gain drops instantly, so nothing passes the ceiling.
  // Threshold sets how hard the signal is pushed: the level at Threshold comes out at Ceiling.
  max_look = ceil(srate * 0.011) + 2;
  buf_l = 0;
  buf_r = buf_l + max_look;
  memset(buf_l, 0, 2 * max_look);
  freembuf(buf_r + max_look);
  wpos = 0;
  hold_val = 0;
  hold_cnt = 0;
  gain = 1;
  pdc_bot_ch = 0;
  pdc_top_ch = 2;

@slider
  mode = slider1;
  ceiling = 10 ^ (slider3 / 20);
  drive = 10 ^ ((slider3 - slider2) / 20);
  look = mode == 1 ? 0 : floor(slider5 * srate / 1000 + 0.5);
  pdc_delay = look;
  rel = exp(-1 / max(1, slider4 * srate / 1000));
  att = mode == 2 || look < 1 ? 1 : 1 - exp(-5 / look);

@sample
  in_l = spl0 * drive;
  in_r = spl1 * drive;

  mode == 1 ? (
    // soft clip: linear up to 70% of the ceiling, then a smooth knee into the ceiling
    knee = 0.7 * ceiling;
    a = abs(in_l);
    a > knee ? in_l = sign(in_l) * (knee + (ceiling - knee) * (1 - exp(-(a - knee) / (ceiling - knee))));
    a = abs(in_r);
    a > knee ? in_r = sign(in_r) * (knee + (ceiling - knee) * (1 - exp(-(a - knee) / (ceiling - knee))));
    spl0 = in_l;
    spl1 = in_r;
  ) : (
    // peak detector on the incoming (not yet delayed) signal, held for the look-ahead time
    peak = max(abs(in_l), abs(in_r));
    peak >= hold_val ? (
      hold_val = peak;
      hold_cnt = look;
    ) : hold_cnt > 0 ? (
      hold_cnt -= 1;
    ) : (
      hold_val = max(peak, hold_val * rel);
    );
    target = hold_val > ceiling ? ceiling / hold_val : 1;
    gain = target < gain ? gain + (target - gain) * att : target + (gain - target) * rel;

    buf_l[wpos] = in_l;
    buf_r[wpos] = in_r;
    rpos = wpos - look;
    rpos < 0 ? rpos += max_look;
    wpos += 1;
    wpos >= max_look ? wpos = 0;

    spl0 = max(-ceiling, min(ceiling, buf_l[rpos] * gain));
    spl1 = max(-ceiling, min(ceiling, buf_r[rpos] * gain));
  );
