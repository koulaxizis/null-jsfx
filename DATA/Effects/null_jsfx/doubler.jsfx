desc:NULL Doubler
author: Christos Koulaxizis
tags: doubler vocal doubling double-tracking adt stereo width
//category: One Slider
//NULL JSFX v2.0 • https://nulljsfx.tech • MIT License

slider1:40<0,100,1>Amount

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  // Automatic double tracking: two copies of the input, each delayed 12-30 ms with a
  // slow, slightly different pitch drift (a few cents), are placed left and right
  // around the original, like a second take of the same part. Amount sets how loud
  // and how wide the doubles are.
  buf_size = ceil(srate * 0.05);
  buf = 0;
  freembuf(buf + buf_size);
  memset(buf, 0, buf_size);
  wpos = 0;
  ph1 = 0;
  ph2 = 0.37;

  function tap(delay_ms) local(rp, i, f, i2)
  (
    rp = wpos - delay_ms * srate / 1000;
    rp < 0 ? rp += buf_size;
    i = floor(rp);
    f = rp - i;
    i2 = i + 1;
    i2 >= buf_size ? i2 = 0;
    buf[i] + (buf[i2] - buf[i]) * f;
  );

@slider
  amount = slider1 / 100;
  level = amount * 0.8;
  dry = 1 / (1 + level * 0.5);

@sample
  mono = (spl0 + spl1) * 0.5;
  buf[wpos] = mono;
  // two slow, unrelated drifts (0.13 Hz and 0.21 Hz) give each double its own timing and pitch
  ph1 += 0.13 / srate; ph1 >= 1 ? ph1 -= 1;
  ph2 += 0.21 / srate; ph2 >= 1 ? ph2 -= 1;
  d1 = tap(14 + 2 * sin(2 * $pi * ph1) + amount * 6);
  d2 = tap(21 + 2.5 * sin(2 * $pi * ph2) + amount * 8);
  wpos += 1;
  wpos >= buf_size ? wpos = 0;

  spl0 = (spl0 + d1 * level) * dry;
  spl1 = (spl1 + d2 * level) * dry;
