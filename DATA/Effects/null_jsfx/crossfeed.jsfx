desc:NULL Crossfeed
author: Christos Koulaxizis
tags: crossfeed headphones bs2b bauer speakers room head shadow itd monitoring mixing fatigue
//category: Essentials
//NULL JSFX v2.6 • https://nulljsfx.tech • MIT License

slider1:0<0,1,1{Crossfeed,Speakers}>Mode
slider2:700<300,2000,10>Cutoff (Hz)
slider3:4.5<1,15,0.5>Feed (dB)
slider4:30<10,60,1>Angle (deg)
slider5:20<0,100,1>Room (%)
slider6:100<0,100,1>Mix (%)
slider7:0<-12,12,0.1>Output (dB)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // Headphone monitoring that sounds less like the music sits inside the head.
  // Crossfeed: Bauer's stereophonic-to-binaural filter as libbs2b computes it. Each ear gets its
  //   own side through a high-frequency boost and the other side through a first-order low
  //   pass at Cutoff, Feed dB below it at low frequencies; a mono signal keeps its level in the
  //   lows and loses up to 2 dB in the highs, as in libbs2b.
  //   700 Hz / 4.5 dB is the bs2b default, 700 / 6 Chu Moy, 650 / 9.5 Jan Meier.
  // Speakers: two speakers Angle degrees off centre. Each ear gets both: its own side through
  //   the Brown-Duda head-shadow filter for the near ear, the other side through the one for
  //   the far ear and later by Woodworth's interaural time (head radius 8.75 cm, sound at
  //   343 m/s), half each so a mono signal keeps its level (the far ear's delay still colours it
  //   a little, as real speakers do); Room adds six early reflections
  //   (4 to 22 ms, low passed at 5 kHz), different for each ear.
  // Then Mix with the dry signal and Output. No latency.
  XF_DL = 0;                   // far-ear delay lines (256 each)
  XF_DR = 256;
  XF_RL = 512;                 // room delay lines (8192 each)
  XF_RR = XF_RL + 8192;
  XF_T = XF_RR + 8192;         // room taps: delay ms (left ear, right ear), gain, source side
  freembuf(XF_T + 32);
  memset(0, 0, XF_T);
  XF_T[0] = 4.3;  XF_T[1] = 4.67; XF_T[2] = 0.62; XF_T[3] = 0;
  XF_T[4] = 6.1;  XF_T[5] = 5.81; XF_T[6] = 0.53; XF_T[7] = 1;
  XF_T[8] = 8.9;  XF_T[9] = 9.43; XF_T[10] = 0.45; XF_T[11] = 0;
  XF_T[12] = 11.4; XF_T[13] = 10.99; XF_T[14] = 0.37; XF_T[15] = 1;
  XF_T[16] = 15.7; XF_T[17] = 16.31; XF_T[18] = 0.29; XF_T[19] = 0;
  XF_T[20] = 21.2; XF_T[21] = 20.73; XF_T[22] = 0.22; XF_T[23] = 1;
  xf_w = xf_rw = 0;
  xf_lol = xf_lor = xf_hil = xf_hir = xf_asl = xf_asr = 0;
  xf_nl1 = xf_nr1 = xf_ynl = xf_ynr = 0;
  xf_fl1 = xf_fr1 = xf_yfl = xf_yfr = 0;
  xf_rlp_l = xf_rlp_r = 0;
  // the head-shadow coefficients, set by xf_hsf in @slider
  xf_nb0 = xf_nb1 = xf_na1 = xf_fb0 = xf_fb1 = xf_fa1 = 0;
  xf_rlpa = exp(-2 * $pi * min(5000, srate * 0.45) / srate);

  // Brown-Duda head shadow, bilinear: H(s) = (alpha s + beta) / (s + beta), beta = 2 c / a,
  // alpha = 1.05 + 0.95 cos(phi / 150 x 180 deg) for incidence phi degrees from the ear axis
  function xf_alpha(phi) ( 1.05 + 0.95 * cos(phi / 150 * $pi); );
  function xf_hsf(al, b0*, b1*, a1*) local(be, k)
  (
    be = 2 * 343 / 0.0875;
    k = 2 * srate;
    b0 = (al * k + be) / (k + be);
    b1 = (be - al * k) / (k + be);
    a1 = (be - k) / (k + be);
  );

@slider
  xf_mode = slider1 >= 0.5;
  // bs2b: levels in dB, the cross low pass and the direct high boost
  xf_gblo = slider3 * -5 / 6 - 3;
  xf_gbhi = slider3 / 6 - 3;
  xf_glo = 10 ^ (xf_gblo / 20);
  xf_ghi = 1 - 10 ^ (xf_gbhi / 20);
  xf_fchi = slider2 * 2 ^ ((xf_gblo - 20 * log10(xf_ghi)) / 12);
  xf_x = exp(-2 * $pi * slider2 / srate);
  xf_b1lo = xf_x;
  xf_a0lo = xf_glo * (1 - xf_x);
  xf_x = exp(-2 * $pi * xf_fchi / srate);
  xf_b1hi = xf_x;
  xf_a0hi = 1 - xf_ghi * (1 - xf_x);
  xf_a1hi = -xf_x;
  xf_gain = 1 / (1 - xf_ghi + xf_glo);
  // speakers: near and far ear filters, their high-frequency gains scaled to sum to 2 so a
  // mono signal keeps its level on average up top as well as at the bottom; the far ear's
  // delay in samples
  xf_an = xf_alpha(90 - slider4);
  xf_af = xf_alpha(90 + slider4);
  xf_hsf(2 * xf_an / (xf_an + xf_af), xf_nb0, xf_nb1, xf_na1);
  xf_hsf(2 * xf_af / (xf_an + xf_af), xf_fb0, xf_fb1, xf_fa1);
  xf_th = slider4 / 180 * $pi;
  xf_itd = 0.0875 / 343 * (xf_th + sin(xf_th)) * srate;
  xf_itdi = floor(xf_itd);
  xf_itdf = xf_itd - xf_itdi;
  xf_room = slider5 / 100 * 0.5;
  xf_mix = slider6 / 100;
  xf_out = 10 ^ (slider7 / 20);

@sample
  xf_inl = spl0;
  xf_inr = spl1;
  xf_mode ? (
    // near ear: own side through its head shadow
    xf_ynl = xf_nb0 * xf_inl + xf_nb1 * xf_nl1 - xf_na1 * xf_ynl;
    xf_ynr = xf_nb0 * xf_inr + xf_nb1 * xf_nr1 - xf_na1 * xf_ynr;
    xf_nl1 = xf_inl;
    xf_nr1 = xf_inr;
    // far ear: the other side, delayed (linear interpolation), through its head shadow
    XF_DL[xf_w] = xf_inl;
    XF_DR[xf_w] = xf_inr;
    xf_a = (xf_w - xf_itdi + 256) % 256;
    xf_b = (xf_a + 255) % 256;
    xf_fdl = XF_DL[xf_a] + (XF_DL[xf_b] - XF_DL[xf_a]) * xf_itdf;
    xf_fdr = XF_DR[xf_a] + (XF_DR[xf_b] - XF_DR[xf_a]) * xf_itdf;
    xf_w = (xf_w + 1) % 256;
    xf_yfl = xf_fb0 * xf_fdl + xf_fb1 * xf_fl1 - xf_fa1 * xf_yfl;
    xf_yfr = xf_fb0 * xf_fdr + xf_fb1 * xf_fr1 - xf_fa1 * xf_yfr;
    xf_fl1 = xf_fdl;
    xf_fr1 = xf_fdr;
    xf_wl = (xf_ynl + xf_yfr) * 0.5;
    xf_wr = (xf_ynr + xf_yfl) * 0.5;
    // room: six reflections per ear from both sides, low passed
    XF_RL[xf_rw] = xf_inl;
    XF_RR[xf_rw] = xf_inr;
    xf_el = xf_er = 0;
    xf_i = 0;
    loop(6,
      xf_j = xf_i * 4;
      xf_a = (xf_rw - floor(XF_T[xf_j] * srate / 1000 + 0.5) + 8192) % 8192;
      xf_b = (xf_rw - floor(XF_T[xf_j + 1] * srate / 1000 + 0.5) + 8192) % 8192;
      xf_el += XF_T[xf_j + 2] * (XF_T[xf_j + 3] ? XF_RR[xf_a] : XF_RL[xf_a]);
      xf_er += XF_T[xf_j + 2] * (XF_T[xf_j + 3] ? XF_RL[xf_b] : XF_RR[xf_b]);
      xf_i += 1;
    );
    xf_rw = (xf_rw + 1) % 8192;
    xf_rlp_l = xf_el + (xf_rlp_l - xf_el) * xf_rlpa;
    xf_rlp_r = xf_er + (xf_rlp_r - xf_er) * xf_rlpa;
    xf_wl += xf_rlp_l * xf_room;
    xf_wr += xf_rlp_r * xf_room;
  ) : (
    xf_lol = xf_a0lo * xf_inl + xf_b1lo * xf_lol;
    xf_lor = xf_a0lo * xf_inr + xf_b1lo * xf_lor;
    xf_hil = xf_a0hi * xf_inl + xf_a1hi * xf_asl + xf_b1hi * xf_hil;
    xf_hir = xf_a0hi * xf_inr + xf_a1hi * xf_asr + xf_b1hi * xf_hir;
    xf_asl = xf_inl;
    xf_asr = xf_inr;
    xf_wl = (xf_hil + xf_lor) * xf_gain;
    xf_wr = (xf_hir + xf_lol) * xf_gain;
  );
  spl0 = (xf_inl + (xf_wl - xf_inl) * xf_mix) * xf_out;
  spl1 = (xf_inr + (xf_wr - xf_inr) * xf_mix) * xf_out;
