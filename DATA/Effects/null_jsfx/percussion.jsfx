in_pin:none
out_pin:Left
out_pin:Right

@init
  // Hand percussion with eleven synthesized voices (no samples) and a groove player that
  // follows the host's tempo:
  //   - conga and tumba (low conga), bongo high and low: a membrane of three sine modes
  //     (1, 1.59, 2.24 times the pitch) with a short pitch drop and a band of noise for the
  //     hand; open, mute (short, few overtones) and slap (bright, noisy) strokes
  //   - shaker and cabasa: high-passed noise with a soft (shaker) or quick (cabasa) attack
  //   - tambourine: three quick bursts of jingles (six squares and noise) and their ring
  //   - cowbell: two squares through a band-pass; claves: one high wooden mode and a click
  //   - guiro: a scrape of noise ticks 60 per second under a rising and falling stroke
  //   - triangle: four bar modes (1, 2.76, 5.40, 8.93), open or muted
  // MIDI notes on the General MIDI percussion keys play the voices (velocity sensitive); see
  // note_on below. Groove plays one of eight built-in grooves (salsa, bossa, samba, cumbia,
  // a 12/8 bell, afrobeat, reggaeton, pop): with Groove Play Transport while the host plays,
  // with Keys while one of the keys C1..G1 (MIDI 24..31) is held, that key choosing the
  // groove (synced to the host's beat while it plays, else started by the key). Swing moves
  // the odd sixteenths later, Accent sets how much quieter unaccented steps are, Humanize
  // varies the groove's velocities (a Park-Miller draw), Room adds a small room.
  //
  // Memory: 4000.. the MIDI of the block, 5000.. per-voice values, 10000.. the grooves
  // (GSZ each: 11 tracks x 32 steps, then length and steps per beat), 20000.. the room.
  ext_tail_size = -1;
  NT = 11;
  MQ = 4000;
  VL = 5000; VPL = 5020; VPR = 5040; HIT = 5060; KH = 5080;
  GRV = 10000; GSZ = 360;
  RB = 20000; RL = 5100; RP = 5120; RF = 5140;
  RMAX = ceil(0.06 * srate) + 4;

  // groove k (1..8): its length in steps and steps per beat, then a track from a string of
  // steps ". x X g m s l" (off, hit, accent, ghost, mute, slap, long) repeated over the length
  function g_def(k, len, spb) local(b)
  (
    b = GRV + (k - 1) * GSZ;
    memset(b, 0, GSZ);
    b[352] = len;
    b[353] = spb;
  );
  function g_set(k, t, str) local(b, i, n, c)
  (
    b = GRV + (k - 1) * GSZ;
    n = strlen(str);
    i = 0;
    loop(b[352],
      c = str_getchar(str, i % n);
      b[t * 32 + i] = c == 'x' ? 1 : c == 'X' ? 2 : c == 'g' ? 3 : c == 'm' ? 4 : c == 's' ? 5 : c == 'l' ? 6 : 0;
      i += 1;
    );
  );
  g_def(1, 32, 4); // Salsa
  g_set(1, 0, "m.g.s.g.m.g.x...");
  g_set(1, 1, "..............x.");
  g_set(1, 2, "x.x.x...x.x.x...");
  g_set(1, 3, "......x.......x.");
  g_set(1, 4, "x.g.x.g.x.g.x.g.");
  g_set(1, 6, "x...x.x.X.x.x...");
  g_set(1, 7, "x.....x.....x.......x...x.......");
  g_set(1, 8, "l...x.x.l...x.x.");
  g_def(2, 32, 4); // Bossa
  g_set(2, 0, "....g.......g...");
  g_set(2, 1, "x......gx......g");
  g_set(2, 4, "XgxgXgxgXgxgXgxg");
  g_set(2, 7, "x..x..x...x..x....x..x...x......");
  g_set(2, 9, "..x...x...x...x.");
  g_def(3, 16, 4); // Samba
  g_set(3, 0, "..s...x...s.x.x.");
  g_set(3, 1, "m...X...m...X...");
  g_set(3, 4, "xxxXxxxXxxxXxxxX");
  g_set(3, 5, "X.xxX.xxX.xxX.xx");
  g_set(3, 6, "x.x.x..x.x.x.x..");
  g_def(4, 16, 4); // Cumbia
  g_set(4, 0, "m...s.g.m...s.g.");
  g_set(4, 1, "..x...x...x...x.");
  g_set(4, 4, "x.X.x.X.x.X.x.X.");
  g_set(4, 8, "l.xxl.xxl.xxl.xx");
  g_def(5, 12, 3); // Afro Bell
  g_set(5, 0, "m.gs.gm.gx.x");
  g_set(5, 1, "X.....x.....");
  g_set(5, 3, "...x.....x..");
  g_set(5, 4, "XgxXgxXgxXgx");
  g_set(5, 6, "x.x.xx.x.x.x");
  g_def(6, 16, 4); // Afrobeat
  g_set(6, 0, "..s...x.m.s...x.");
  g_set(6, 1, "X.....x.....x...");
  g_set(6, 4, "xgxgXgxgxgxgXgxg");
  g_set(6, 5, "....x.......x...");
  g_set(6, 6, "x.x.xx.xx.x.xx.x");
  g_set(6, 7, "x..x..x...x.x...");
  g_def(7, 16, 4); // Reggaeton
  g_set(7, 0, "...s..s....s..s.");
  g_set(7, 1, "X...x...X...x...");
  g_set(7, 3, "......x.......x.");
  g_set(7, 4, "x.x.x.x.x.x.x.x.");
  g_set(7, 9, "..x...x...x...x.");
  g_def(8, 16, 4); // Pop
  g_set(8, 0, "......x.m.....x.");
  g_set(8, 1, "x.........x.....");
  g_set(8, 4, "xgXgxgXgxgXgxgXg");
  g_set(8, 5, "....X.......X...");
  g_set(8, 10, "x.......m.......");

  // one Park-Miller step (the same as the noise), for Humanize
  function pm(x)
  (
    x *= 16807;
    x - floor(x / 2147483647) * 2147483647;
  );

  // ---- building blocks ----------------------------------------------------------------------
  // state-variable filter (TPT): svf_set(cutoff, Q) then svf(x); lp, bp, hp are the outputs
  function svf_set(fc, q)
  (
    this.g = tan($pi * min(fc, 0.45 * srate) / srate);
    this.k = 1 / q;
    this.a1 = 1 / (1 + this.g * (this.g + this.k));
    this.a2 = this.g * this.a1;
    this.a3 = this.g * this.a2;
  );
  function svf(x) local(v1, v2, v3)
  (
    v3 = x - this.s2;
    v1 = this.a1 * this.s1 + this.a2 * v3;
    v2 = this.s2 + this.a2 * this.s1 + this.a3 * v3;
    this.s1 = 2 * v1 - this.s1;
    this.s2 = 2 * v2 - this.s2;
    this.lp = v2;
    this.bp = v1;
    this.hp = x - this.k * v1 - v2;
  );

  // band-limited square (PolyBLEP) at phase p (0..1) with phase step dt
  function blep(t, dt)
  (
    t < dt ? ( t /= dt; t + t - t * t - 1; ) :
    t > 1 - dt ? ( t = (t - 1) / dt; t * t + t + t + 1; ) : 0;
  );
  function square(p, dt) local(q)
  (
    q = p + 0.5;
    q -= floor(q);
    (p < 0.5 ? 1 : -1) + blep(p, dt) - blep(q, dt);
  );

  // six squares (the metal of the classic drum machines) at 205.3 .. 800 Hz times r
  function metal_set(r)
  (
    this.d1 = 205.3 * r / srate; this.d2 = 304.4 * r / srate; this.d3 = 369.6 * r / srate;
    this.d4 = 522.7 * r / srate; this.d5 = 540 * r / srate; this.d6 = 800 * r / srate;
  );
  function metal() local(y)
  (
    y = square(this.p1, this.d1) + square(this.p2, this.d2) + square(this.p3, this.d3)
      + square(this.p4, this.d4) + square(this.p5, this.d5) + square(this.p6, this.d6);
    this.p1 += this.d1; this.p1 -= floor(this.p1);
    this.p2 += this.d2; this.p2 -= floor(this.p2);
    this.p3 += this.d3; this.p3 -= floor(this.p3);
    this.p4 += this.d4; this.p4 -= floor(this.p4);
    this.p5 += this.d5; this.p5 -= floor(this.p5);
    this.p6 += this.d6; this.p6 -= floor(this.p6);
    y / 6;
  );

  // decay coefficient for a time constant in seconds; one-pole low-pass coefficient for f Hz
  function dcy(tau) ( exp(-1 / (tau * srate)); );
  function onep(f) ( 1 - exp(-2 * $pi * min(f, 0.45 * srate) / srate); );

  // membrane (conga, tumba, bongos): three sine modes with a pitch drop and a band of noise.
  // f the pitch, d the Decay (0..1), ta + tb * d * d the open stroke's time constant
  function mem_set(f, d, ta, tb) local(t)
  (
    this.f0 = f;
    t = ta + tb * d * d;
    this.o1 = dcy(t); this.o2 = dcy(t * 0.5); this.o3 = dcy(t * 0.25);
    t = 0.016 + 0.024 * d;
    this.m1 = dcy(t); this.m2 = dcy(t * 0.6); this.m3 = dcy(t * 0.4);
    t = 0.02 + 0.03 * d;
    this.q1 = dcy(t); this.q2 = dcy(t * 0.8); this.q3 = dcy(t * 0.6);
    this.cp = dcy(0.012);
    this.cno = dcy(0.004);
    this.cns = dcy(0.01);
    // the hand's noise: a band between two one-pole low-passes
    this.lao = onep(f * 9); this.lbo = onep(f * 2.5);
    this.las = onep(7000); this.lbs = onep(1200);
  );
  // stroke art: 0 open, 1 mute, 2 slap
  function mem_trig(art, v)
  (
    !this.on ? ( this.p1 = 0; this.p2 = 0; this.p3 = 0; );
    this.pe = 1;
    art == 0 ? (
      this.e1 = v; this.e2 = 0.45 * v; this.e3 = 0.2 * v; this.ne = 0.3 * v;
      this.c1 = this.o1; this.c2 = this.o2; this.c3 = this.o3; this.cn = this.cno;
      this.pa = 0.07; this.la = this.lao; this.lb = this.lbo;
    ) : art == 1 ? (
      this.e1 = 0.75 * v; this.e2 = 0.15 * v; this.e3 = 0.05 * v; this.ne = 0.45 * v;
      this.c1 = this.m1; this.c2 = this.m2; this.c3 = this.m3; this.cn = this.cno;
      this.pa = 0.03; this.la = this.lao; this.lb = this.lbo;
    ) : (
      this.e1 = 0.4 * v; this.e2 = 0.45 * v; this.e3 = 0.4 * v; this.ne = 1.2 * v;
      this.c1 = this.q1; this.c2 = this.q2; this.c3 = this.q3; this.cn = this.cns;
      this.pa = 0.12; this.la = this.las; this.lb = this.lbs;
    );
    this.on = 1;
  );
  function mem(n) local(y, fq, q)
  (
    fq = this.f0 * (1 + this.pa * this.pe);
    q = fq / srate;
    this.p1 += q; this.p1 -= floor(this.p1);
    q = fq * 1.59;
    q = q / srate;
    this.p2 += q; this.p2 -= floor(this.p2);
    q = fq * 2.24;
    q = q / srate;
    this.p3 += q; this.p3 -= floor(this.p3);
    this.na += this.la * (n - this.na);
    this.nb += this.lb * (n - this.nb);
    y = sin(2 * $pi * this.p1) * this.e1 + sin(2 * $pi * this.p2) * this.e2
      + sin(2 * $pi * this.p3) * this.e3 + (this.na - this.nb) * this.ne;
    this.pe *= this.cp;
    this.e1 *= this.c1; this.e2 *= this.c2; this.e3 *= this.c3;
    this.ne *= this.cn;
    this.e1 + this.ne < 0.000001 ? this.on = 0;
    y;
  );

  // ---- voices ---------------------------------------------------------------------------------
  // t the voice, art the stroke (membranes: open, mute, slap; guiro: short, long; triangle:
  // open, mute), v the velocity 0..1
  function trig(t, art, v)
  (
    HIT[t] = v;
    t == 0 ? cg.mem_trig(art, v) :
    t == 1 ? tu.mem_trig(art, v) :
    t == 2 ? bh.mem_trig(art, v) :
    t == 3 ? bl.mem_trig(art, v) :
    t == 4 ? ( sh_ea = v; sh_eb = v; sh_on = 1; ) :
    t == 5 ? ( tb_t = 0; tb_env = 1; tb_vel = v; tb_on = 1; ) :
    t == 6 ? ( !cb_on ? ( cb_p1 = 0; cb_p2 = 0.25; ); cb_e1 = 0.7 * v; cb_e2 = 0.3 * v; cb_on = 1; ) :
    t == 7 ? ( !cl_on ? cl_ph = 0; cl_env = v; cl_ck = v; cl_on = 1; ) :
    t == 8 ? ( gu_t = 0; gu_len = art == 1 ? gu_long : gu_short; gu_ph = 0; gu_tk = 0; gu_vel = v; gu_on = 1; ) :
    t == 9 ? ( ca_ea = v; ca_eb = v; ca_on = 1; ) :
    t == 10 ? (
      !tr_on ? ( tr_p1 = 0; tr_p2 = 0; tr_p3 = 0; tr_p4 = 0; );
      tr_e1 = 0.35 * v; tr_e2 = 0.6 * v; tr_e3 = 0.5 * v; tr_e4 = 0.35 * v; tr_ck = v;
      tr_mute = art == 1;
      tr_on = 1;
    );
  );

  // MIDI notes: the General MIDI percussion keys; with Groove Play Keys, C1..G1 hold a groove
  function note_on(n, v)
  (
    keys && n >= 24 && n <= 31 ? (
      // the groove starts with the first key held; from the key when the host is stopped
      k_grv == 0 && !playing ? ( fb = 0; last_s = -1000; );
      KH[n - 24] = 1;
      k_grv = n - 23;
    ) :
    n == 60 ? trig(2, 0, v) :
    n == 61 ? trig(3, 0, v) :
    n == 62 ? trig(0, 1, v) :
    n == 63 ? trig(0, 0, v) :
    n == 64 ? trig(1, 0, v) :
    n == 65 ? trig(0, 2, v) :
    n == 66 ? trig(1, 2, v) :
    n == 54 ? trig(5, 0, v) :
    n == 56 ? trig(6, 0, v) :
    n == 69 ? trig(9, 0, v) :
    n == 70 || n == 82 ? trig(4, 0, v) :
    n == 73 ? trig(8, 0, v) :
    n == 74 ? trig(8, 1, v) :
    n == 75 ? trig(7, 0, v) :
    n == 80 ? trig(10, 1, v) :
    n == 81 ? trig(10, 0, v);
  );
  // a groove key let go: the groove of the key pressed last that is still held, or none
  function key_off(k) local(i)
  (
    KH[k] = 0;
    k_grv == k + 1 ? (
      k_grv = 0;
      i = 0;
      loop(8, KH[i] ? k_grv = i + 1; i += 1;);
    );
  );
  function keys_off() ( memset(KH, 0, 8); k_grv = 0; );

  function pan_set(t, lev, p)
  (
    VL[t] = 10 ^ (lev / 20);
    VPL[t] = sqrt(2) * cos((p / 100 + 1) * $pi / 4);
    VPR[t] = sqrt(2) * sin((p / 100 + 1) * $pi / 4);
  );

  // one groove step on every track
  function play_step(s) local(t, i, v, vel, art)
  (
    i = s - floor(s / g_len) * g_len;
    t = 0;
    loop(NT,
      v = pb[t * 32 + i];
      v > 0 ? (
        vel = v == 2 ? 0.6 : v == 3 ? 0.24 * (1 - 0.5 * acc) : 0.6 - 0.3 * acc;
        hum > 0 ? (
          hx = pm(hx);
          hr = hx / 2147483647;
          hr *= hum;
          vel *= 1 - 0.5 * hr;
        );
        art = v == 4 || v == 6 ? 1 : v == 5 ? 2 : 0;
        trig(t, art, vel);
      );
      t += 1;
    );
  );

  // the room: four damped combs and two all-passes per side; lengths in ms
  function room_len(j, ms, sc) local(x)
  (
    x = ms * sc;
    x = x * srate;
    RL[j] = max(1, min(RMAX - 1, floor(x / 1000)));
    RP[j] >= RL[j] ? RP[j] = 0;
  );
  function comb(j, x) local(b, y)
  (
    b = RB + j * RMAX;
    y = b[RP[j]];
    RF[j] = y + rm_d * (RF[j] - y);
    b[RP[j]] = x + RF[j] * rm_fb;
    RP[j] += 1;
    RP[j] >= RL[j] ? RP[j] = 0;
    y;
  );
  function allpass(j, x) local(b, y, o)
  (
    b = RB + j * RMAX;
    y = b[RP[j]];
    o = y - 0.5 * x;
    b[RP[j]] = x + 0.5 * o;
    RP[j] += 1;
    RP[j] >= RL[j] ? RP[j] = 0;
    o;
  );

  // all voices quiet, the groove waiting for its next step, the room empty
  cg.on = tu.on = bh.on = bl.on = 0;
  sh_on = tb_on = cb_on = cl_on = gu_on = ca_on = tr_on = 0;
  memset(KH, 0, 8);
  k_grv = 0;
  last_s = -1000;
  fb = 0;
  seed = 22222;
  hx = 12345;
  memset(RB, 0, 12 * RMAX);
  memset(RP, 0, 12);
  memset(RF, 0, 12);
  pc_preview = 0;
  m_ofs = m_1 = m_2 = m_3 = 0;

@slider
  g_sel = floor(slider1 + 0.5);
  keys = slider2 >= 0.5;
  !keys ? keys_off();
  sw = slider3 / 100;
  acc = slider4 / 100;
  hum = slider5 / 100;
  room = slider6 / 100;
  rm_wet = 0.1 * room;
  x = slider7 / 100;
  rm_fb = 0.6 + 0.28 * x;
  rm_d = 0.35;
  rm_sc = 0.5 + 0.8 * x;
  room_len(0, 17.3, rm_sc); room_len(1, 21.1, rm_sc); room_len(2, 24.7, rm_sc); room_len(3, 28.9, rm_sc);
  room_len(4, 17.9, rm_sc); room_len(5, 21.8, rm_sc); room_len(6, 25.3, rm_sc); room_len(7, 29.6, rm_sc);
  room_len(8, 5.1, 1); room_len(9, 1.7, 1); room_len(10, 5.6, 1); room_len(11, 1.9, 1);
  vol = 10 ^ (slider8 / 20);

  // membranes: pitch, then the open stroke's time constant at Decay 0 and its growth
  pan_set(0, slider9, slider12);
  cg.mem_set(245 * 2 ^ (slider10 / 12), slider11 / 100, 0.06, 0.45);
  pan_set(1, slider13, slider16);
  tu.mem_set(178 * 2 ^ (slider14 / 12), slider15 / 100, 0.08, 0.55);
  pan_set(2, slider17, slider20);
  bh.mem_set(470 * 2 ^ (slider18 / 12), slider19 / 100, 0.035, 0.25);
  pan_set(3, slider21, slider24);
  bl.mem_set(335 * 2 ^ (slider22 / 12), slider23 / 100, 0.045, 0.3);

  // shaker: noise through a band-pass and a high-pass, soft attack
  pan_set(4, slider25, slider28);
  r = 2 ^ (slider26 / 12);
  d = slider27 / 100;
  sh_bp.svf_set(5200 * r, 0.9);
  sh_hp.svf_set(2800 * r, 0.7);
  sh_ca = dcy(0.025 + 0.12 * d);
  sh_cb = dcy(0.008);

  // tambourine: three bursts 8 ms apart, then the jingles ring
  pan_set(5, slider29, slider32);
  r = 2 ^ (slider30 / 12);
  d = slider31 / 100;
  tb_m.metal_set(7.3 * r);
  tb_bp.svf_set(7600 * r, 1.2);
  tb_hp.svf_set(4500 * r, 0.7);
  tb_per = floor(0.008 * srate);
  tb_bc = dcy(0.006);
  tb_tc = dcy(0.05 + 0.3 * d);

  // cowbell: two squares through a band-pass
  pan_set(6, slider33, slider36);
  r = 2 ^ (slider34 / 12);
  d = slider35 / 100;
  cb_d1 = 587 * r / srate; cb_d2 = 845 * r / srate;
  cb_bp.svf_set(1000 * r, 2.2);
  cb_c1 = dcy(0.01);
  cb_c2 = dcy(0.05 + 0.35 * d);

  // claves: one high mode and a click
  pan_set(7, slider37, slider40);
  r = 2 ^ (slider38 / 12);
  d = slider39 / 100;
  cl_d = 2450 * r / srate;
  cl_c = dcy(0.025 + 0.12 * d);
  cl_cc = dcy(0.0007);

  // guiro: ticks 60 per second (times the tune) through a band-pass under the stroke
  pan_set(8, slider41, slider44);
  r = 2 ^ (slider42 / 12);
  d = slider43 / 100;
  gu_d = 60 * r / srate;
  x = 0.5 + d;
  x *= srate;
  gu_short = floor(0.085 * x);
  gu_long = floor(0.28 * x);
  gu_bp.svf_set(2600 * r, 1.6);
  gu_tc = dcy(0.0015);

  // cabasa: brighter noise with a quick attack
  pan_set(9, slider45, slider48);
  r = 2 ^ (slider46 / 12);
  d = slider47 / 100;
  ca_bp.svf_set(8200 * r, 1.4);
  ca_hp.svf_set(6000 * r, 0.7);
  ca_ca = dcy(0.02 + 0.12 * d);
  ca_cb = dcy(0.0015);

  // triangle: four bar modes (those above 0.45 * srate left out), open or muted
  pan_set(10, slider49, slider52);
  r = 2 ^ (slider50 / 12);
  d = slider51 / 100;
  tr_f = 1180 * r;
  tr_d1 = tr_f / srate;
  tr_d2 = tr_f * 2.76; tr_d2 = tr_d2 / srate;
  tr_d3 = tr_f * 5.4; tr_d3 = tr_d3 / srate;
  tr_d4 = tr_f * 8.93; tr_d4 = tr_d4 / srate;
  tr_g2 = tr_d2 < 0.45; tr_g3 = tr_d3 < 0.45; tr_g4 = tr_d4 < 0.45;
  t = 0.25 + 1.6 * d * d;
  tr_o1 = dcy(t); tr_o2 = dcy(t * 0.85); tr_o3 = dcy(t * 0.7); tr_o4 = dcy(t * 0.55);
  tr_mc = dcy(0.025);
  tr_cc = dcy(0.0008);

@block
  // MIDI of this block, played at its offsets in @sample
  mq_n = 0;
  while (midirecv(m_ofs, m_1, m_2, m_3)) (
    mq_n < 256 ? (
      MQ[mq_n * 4] = m_ofs;
      MQ[mq_n * 4 + 1] = m_1;
      MQ[mq_n * 4 + 2] = m_2;
      MQ[mq_n * 4 + 3] = m_3;
      mq_n += 1;
    );
  );
  mq_i = 0;

  playing = play_state & 1;
  b_inc = tempo / (60 * srate);
  b_0 = beat_position;
  si = 0;

  // a voice heard from the interface (GFX version)
  pc_preview > 0 ? ( trig(pc_preview - 1, 0, 1); pc_preview = 0; );

@sample
  while (mq_i < mq_n && MQ[mq_i * 4] <= si) (
    m_s = MQ[mq_i * 4 + 1] & 0xF0;
    m_n = MQ[mq_i * 4 + 2];
    m_v = MQ[mq_i * 4 + 3];
    m_s == 0x90 && m_v > 0 ? note_on(m_n, m_v / 127) :
    (m_s == 0x80 || m_s == 0x90) && keys && m_n >= 24 && m_n <= 31 ? key_off(m_n - 24) :
    m_s == 0xB0 && (m_n == 120 || m_n == 123) ? keys_off();
    mq_i += 1;
  );

  // the groove: sixteenths (the odd ones moved later by Swing) or three steps per beat; a
  // step plays when the position enters it
  g_cur = keys ? k_grv : playing ? g_sel : 0;
  g_cur > 0 ? (
    pb = GRV + (g_cur - 1) * GSZ;
    g_len = pb[352];
    g_spb = pb[353];
    playing ? bb = b_0 + si * b_inc : ( bb = fb; fb += b_inc; );
    bb >= 0 ? (
      g_spb == 3 ? (
        s = floor(bb * 3 + 0.000001);
        s0 = s / 3;
      ) : (
        p8 = floor(bb * 2 + 0.000001);
        s = p8 * 2 + (bb * 2 - p8 + 0.000001 >= sw ? 1 : 0);
        s0 = (s & 1 ? p8 + sw : p8) / 2;
      );
      s != last_s ? (
        // at a start, only when it starts on the step's beginning
        last_s > -1000 || bb - s0 < 0.001 ? play_step(s);
        last_s = s;
      );
    );
  ) : last_s = -1000;
  pc_step = g_cur > 0 ? last_s : -1;
  si += 1;

  // white noise (Park-Miller), shared by the voices
  seed *= 16807; seed -= floor(seed / 2147483647) * 2147483647;
  nz = seed / 1073741824 - 1;
  outl = outr = 0;

  cg.on ? ( y = cg.mem(nz) * 0.357 * VL[0]; outl += y * VPL[0]; outr += y * VPR[0]; );
  tu.on ? ( y = tu.mem(nz) * 0.383 * VL[1]; outl += y * VPL[1]; outr += y * VPR[1]; );
  bh.on ? ( y = bh.mem(nz) * 0.306 * VL[2]; outl += y * VPL[2]; outr += y * VPR[2]; );
  bl.on ? ( y = bl.mem(nz) * 0.323 * VL[3]; outl += y * VPL[3]; outr += y * VPR[3]; );

  sh_on ? (
    sh_bp.svf(nz);
    sh_hp.svf(sh_bp.bp);
    y = sh_hp.hp * (sh_ea - sh_eb);
    sh_ea *= sh_ca; sh_eb *= sh_cb;
    sh_ea < 0.000001 ? sh_on = 0;
    y *= 0.9 * VL[4]; outl += y * VPL[4]; outr += y * VPR[4];
  );

  tb_on ? (
    tb_t < 3 * tb_per ? (
      tb_t == 0 || tb_t == tb_per || tb_t == 2 * tb_per ? tb_env = tb_t == 0 ? 1 : tb_t == tb_per ? 0.75 : 0.5;
      g = tb_env; tb_env *= tb_bc;
    ) : (
      tb_t == 3 * tb_per ? tb_env = 0.45;
      g = tb_env; tb_env *= tb_tc;
      tb_env < 0.000001 ? tb_on = 0;
    );
    tb_t += 1;
    tb_bp.svf(0.6 * tb_m.metal() + 0.4 * nz);
    tb_hp.svf(tb_bp.bp);
    y = tb_hp.hp * g * tb_vel;
    y *= 0.95 * VL[5]; outl += y * VPL[5]; outr += y * VPR[5];
  );

  cb_on ? (
    cb_bp.svf(square(cb_p1, cb_d1) + square(cb_p2, cb_d2));
    cb_p1 += cb_d1; cb_p1 -= floor(cb_p1);
    cb_p2 += cb_d2; cb_p2 -= floor(cb_p2);
    y = cb_bp.bp * (cb_e1 + cb_e2);
    cb_e1 *= cb_c1; cb_e2 *= cb_c2;
    cb_e2 < 0.000001 ? cb_on = 0;
    y *= 0.18 * VL[6]; outl += y * VPL[6]; outr += y * VPR[6];
  );

  cl_on ? (
    cl_ph += cl_d; cl_ph -= floor(cl_ph);
    y = sin(2 * $pi * cl_ph) * cl_env + nz * cl_ck * 0.3;
    cl_env *= cl_c; cl_ck *= cl_cc;
    cl_env < 0.000001 ? cl_on = 0;
    y *= 0.36 * VL[7]; outl += y * VPL[7]; outr += y * VPR[7];
  );

  gu_on ? (
    gu_ph += gu_d;
    gu_ph >= 1 ? ( gu_ph -= 1; gu_tk = 1; );
    gu_bp.svf(nz * (gu_tk + 0.12));
    x = gu_t / gu_len;
    y = gu_bp.bp * sin($pi * x) * gu_vel;
    gu_tk *= gu_tc;
    gu_t += 1;
    gu_t >= gu_len ? gu_on = 0;
    y *= 0.7 * VL[8]; outl += y * VPL[8]; outr += y * VPR[8];
  );

  ca_on ? (
    ca_bp.svf(nz);
    ca_hp.svf(ca_bp.bp);
    y = ca_hp.hp * (ca_ea - ca_eb);
    ca_ea *= ca_ca; ca_eb *= ca_cb;
    ca_ea < 0.000001 ? ca_on = 0;
    y *= 0.6 * VL[9]; outl += y * VPL[9]; outr += y * VPR[9];
  );

  tr_on ? (
    tr_p1 += tr_d1; tr_p1 -= floor(tr_p1);
    tr_p2 += tr_d2; tr_p2 -= floor(tr_p2);
    tr_p3 += tr_d3; tr_p3 -= floor(tr_p3);
    tr_p4 += tr_d4; tr_p4 -= floor(tr_p4);
    y = sin(2 * $pi * tr_p1) * tr_e1 + tr_g2 * sin(2 * $pi * tr_p2) * tr_e2
      + tr_g3 * sin(2 * $pi * tr_p3) * tr_e3 + tr_g4 * sin(2 * $pi * tr_p4) * tr_e4 + nz * tr_ck * 0.2;
    tr_mute ? (
      tr_e1 *= tr_mc; tr_e2 *= tr_mc; tr_e3 *= tr_mc; tr_e4 *= tr_mc;
    ) : (
      tr_e1 *= tr_o1; tr_e2 *= tr_o2; tr_e3 *= tr_o3; tr_e4 *= tr_o4;
    );
    tr_ck *= tr_cc;
    tr_e1 + tr_e2 + tr_e3 + tr_e4 < 0.000001 ? tr_on = 0;
    y *= 0.3 * VL[10]; outl += y * VPL[10]; outr += y * VPR[10];
  );

  // Room: four damped combs and two all-passes per side, mixed in
  room > 0 ? (
    wl = comb(0, outl) + comb(1, outl) + comb(2, outl) + comb(3, outl);
    wr = comb(4, outr) + comb(5, outr) + comb(6, outr) + comb(7, outr);
    wl = allpass(9, allpass(8, wl));
    wr = allpass(11, allpass(10, wr));
    outl += wl * rm_wet;
    outr += wr * rm_wet;
  );

  spl0 = outl * vol;
  spl1 = outr * vol;
