desc:NULL Crunch
author: Christos Koulaxizis
tags: distortion grit crunch fuzz aggressive
//category: One Slider
//NULL JSFX v2.0 • https://nulljsfx.tech • MIT License

slider1:50<0,100,1>Amount

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  DB2LIN = 0.11512925464970228420;

@slider
  amount = slider1 / 100;
  drive = 1 + amount * 3;
  makeup_db = -amount * 2;
  makeup_lin = exp(makeup_db * DB2LIN);

@sample
  in_l = spl0 * drive;
  in_r = spl1 * drive;
  hard_l = in_l > 1 ? 1 : in_l < -1 ? -1 : in_l;
  hard_r = in_r > 1 ? 1 : in_r < -1 ? -1 : in_r;
  soft_l = hard_l * (1 - abs(hard_l) * 0.2);
  soft_r = hard_r * (1 - abs(hard_r) * 0.2);
  out_l = soft_l * (1 - amount * 0.5) + hard_l * amount * 0.5;
  out_r = soft_r * (1 - amount * 0.5) + hard_r * amount * 0.5;
  spl0 = out_l * makeup_lin;
  spl1 = out_r * makeup_lin;
