desc:NULL De-Clip
author: Christos Koulaxizis
tags: de-clip declip clipping repair restoration reconstruct peaks overload distortion
//category: Essentials
//NULL JSFX v2.9 • https://nulljsfx.tech • MIT License

slider1:-0.3<-24,0,0.1>Clip Level (dB)
slider2:3<2,8,1>Min Length (Samples)
slider3:0<-24,12,0.1>Output (dB)
slider4:0<0,1,1{Output,Delta}>Listen

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  ext_noinit = 1;              // play and seek keep tails and state, as in the VST3/CLAP
  // Rebuilds clipped peaks. A run of at least Min Length samples in a row at or above Clip
  // Level (one channel at a time) counts as clipped; it is redrawn with the cubic through the
  // two good samples on either side of it, kept on the side of the clip level it was on and
  // at most 12 dB above it. The output runs 128 samples late (reported for delay
  // compensation) so a run up to 120 samples long can be seen whole before it is played;
  // longer runs stay as they are. The rebuilt peaks pass 0 dBFS: lower Output, or follow with
  // a limiter, before a fixed-point export.
  DC_R = 256;                  // ring length
  DC_L = 128;                  // look-ahead = latency
  DC_XL = 0;                   // input, left / right
  DC_XR = DC_XL + DC_R;
  DC_YL = DC_XR + DC_R;        // output (input with the rebuilt runs), left / right
  DC_YR = DC_YL + DC_R;
  freembuf(DC_YR + DC_R);
  memset(0, 0, DC_YR + DC_R);
  dc_w = 0;
  dc_runs = 0;
  pdc_delay = DC_L;
  pdc_bot_ch = 0;
  pdc_top_ch = 2;

  // A run that ended 3 samples ago (its last sample at c, then two good ones): find where it
  // began and redraw it. Nodes at -2, -1 (before) and m, m + 1 (after), the run at 0 .. m - 1.
  function dc_fix(x, y) local(c, s, m, k, sg, a0, a1, b0, b1, t, v, d0, d1)
  (
    c = (dc_w - 3 + DC_R) % DC_R;
    abs(x[c]) >= dc_thr && abs(x[(c + 1) % DC_R]) < dc_thr ? (
      sg = x[c] > 0 ? 1 : -1;
      m = 1;
      s = c;
      while (k = (s - 1 + DC_R) % DC_R; m <= DC_L - 8 && x[k] * sg >= dc_thr ? (s = k; m += 1; 1) : 0);
      m >= dc_min && m <= DC_L - 8 ? (
        a0 = x[(s - 2 + DC_R) % DC_R];
        a1 = x[(s - 1 + DC_R) % DC_R];
        b0 = x[(c + 1) % DC_R];
        b1 = x[(c + 2) % DC_R];
        d0 = (m + 2) * (m + 3);
        d1 = (m + 1) * (m + 2);
        t = 0;
        loop(m,
          v = -(t + 1) * (t - m) * (t - m - 1) / d0 * a0
              + (t + 2) * (t - m) * (t - m - 1) / d1 * a1
              - (t + 2) * (t + 1) * (t - m - 1) / d1 * b0
              + (t + 2) * (t + 1) * (t - m) / d0 * b1;
          v = sg * min(max(v * sg, dc_thr), dc_thr * 4);
          y[(s + t) % DC_R] = v;
          t += 1;
        );
        dc_runs += 1;
      );
    );
  );

@slider
  dc_thr = 10 ^ (slider1 / 20);
  dc_min = max(2, min(8, floor(slider2 + 0.5)));
  dc_gain = 10 ^ (slider3 / 20);
  dc_delta = slider4 >= 0.5;

@sample
  DC_XL[dc_w] = DC_YL[dc_w] = spl0;
  DC_XR[dc_w] = DC_YR[dc_w] = spl1;
  dc_w = (dc_w + 1) % DC_R;
  dc_fix(DC_XL, DC_YL);
  dc_fix(DC_XR, DC_YR);
  dc_o = (dc_w - 1 - DC_L + DC_R) % DC_R;
  dc_delta ? (
    spl0 = (DC_YL[dc_o] - DC_XL[dc_o]) * dc_gain;
    spl1 = (DC_YR[dc_o] - DC_XR[dc_o]) * dc_gain;
  ) : (
    spl0 = DC_YL[dc_o] * dc_gain;
    spl1 = DC_YR[dc_o] * dc_gain;
  );
