slider23:1.0<0.1,10.0,0.1>Ultra High Q
slider24:2<0,7,1{Low Shelf,High Shelf,Peaking,Low Pass,High Pass,Notch,Band Pass,All Pass}>Ultra High Type
slider25:0<0,2,1{Active,Bypass,Solo}>Ultra High Mode

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  // Five fully parametric bands in series. Each band can be any of eight RBJ filter
  // shapes. Mode: Bypass skips the band; Solo plays only what that band's frequency
  // and Q select (band-pass), to find problem frequencies.

  // coefficients for one band: this.b0 .. this.a2
  function design(freq, gain, q, type) local(w, c, s, al, A, sq, a0)
  (
    w = 2 * $pi * min(freq, srate * 0.49) / srate;
    c = cos(w); s = sin(w);
    al = s / (2 * max(q, 0.05));
    A = 10 ^ (gain / 40); sq = sqrt(A);
    type == 0 ? (       // low shelf
      this.b0 = A * ((A + 1) - (A - 1) * c + 2 * sq * al);
      this.b1 = 2 * A * ((A - 1) - (A + 1) * c);
      this.b2 = A * ((A + 1) - (A - 1) * c - 2 * sq * al);
      a0 = (A + 1) + (A - 1) * c + 2 * sq * al;
      this.a1 = -2 * ((A - 1) + (A + 1) * c);
      this.a2 = (A + 1) + (A - 1) * c - 2 * sq * al;
    ) : type == 1 ? (   // high shelf
      this.b0 = A * ((A + 1) + (A - 1) * c + 2 * sq * al);
      this.b1 = -2 * A * ((A - 1) + (A + 1) * c);
      this.b2 = A * ((A + 1) + (A - 1) * c - 2 * sq * al);
      a0 = (A + 1) - (A - 1) * c + 2 * sq * al;
      this.a1 = 2 * ((A - 1) - (A + 1) * c);
      this.a2 = (A + 1) - (A - 1) * c - 2 * sq * al;
    ) : type == 2 ? (   // peaking
      this.b0 = 1 + al * A; this.b1 = -2 * c; this.b2 = 1 - al * A;
      a0 = 1 + al / A; this.a1 = -2 * c; this.a2 = 1 - al / A;
    ) : type == 3 ? (   // low pass
      this.b0 = (1 - c) / 2; this.b1 = 1 - c; this.b2 = (1 - c) / 2;
      a0 = 1 + al; this.a1 = -2 * c; this.a2 = 1 - al;
    ) : type == 4 ? (   // high pass
      this.b0 = (1 + c) / 2; this.b1 = -(1 + c); this.b2 = (1 + c) / 2;
      a0 = 1 + al; this.a1 = -2 * c; this.a2 = 1 - al;
    ) : type == 5 ? (   // notch
      this.b0 = 1; this.b1 = -2 * c; this.b2 = 1;
      a0 = 1 + al; this.a1 = -2 * c; this.a2 = 1 - al;
    ) : type == 6 ? (   // band pass (0 dB peak)
      this.b0 = al; this.b1 = 0; this.b2 = -al;
      a0 = 1 + al; this.a1 = -2 * c; this.a2 = 1 - al;
    ) : (               // all pass
      this.b0 = 1 - al; this.b1 = -2 * c; this.b2 = 1 + al;
      a0 = 1 + al; this.a1 = -2 * c; this.a2 = 1 - al;
    );
    this.b0 /= a0; this.b1 /= a0; this.b2 /= a0; this.a1 /= a0; this.a2 /= a0;
  );

  function setup(freq, gain, q, type, mode)
  (
    this.design(freq, gain, q, mode == 2 ? 6 : type);
    this.on = mode != 1;
    this.solo = mode == 2;
  );

  // run one channel through one band; state is per band and per channel (this.xl1 ...)
  function run_l(x) local(y)
  (
    y = this.b0 * x + this.b1 * this.xl1 + this.b2 * this.xl2 - this.a1 * this.yl1 - this.a2 * this.yl2;
    this.xl2 = this.xl1; this.xl1 = x; this.yl2 = this.yl1; this.yl1 = y;
    y;
  );
  function run_r(x) local(y)
  (
    y = this.b0 * x + this.b1 * this.xr1 + this.b2 * this.xr2 - this.a1 * this.yr1 - this.a2 * this.yr2;
    this.xr2 = this.xr1; this.xr1 = x; this.yr2 = this.yr1; this.yr1 = y;
    y;
  );
  function band(xl*, xr*, active)
  (
    active ? (xl = this.run_l(xl); xr = this.run_r(xr));
  );

@slider
  b1.setup(slider1, slider2, slider3, slider4, slider5);
  b2.setup(slider6, slider7, slider8, slider9, slider10);
  b3.setup(slider11, slider12, slider13, slider14, slider15);
  b4.setup(slider16, slider17, slider18, slider19, slider20);
  b5.setup(slider21, slider22, slider23, slider24, slider25);
  solo_any = b1.solo || b2.solo || b3.solo || b4.solo || b5.solo;

@sample
  l = spl0; r = spl1;
  b1.band(l, r, solo_any ? b1.solo : b1.on);
  b2.band(l, r, solo_any ? b2.solo : b2.on);
  b3.band(l, r, solo_any ? b3.solo : b3.on);
  b4.band(l, r, solo_any ? b4.solo : b4.on);
  b5.band(l, r, solo_any ? b5.solo : b5.on);
  spl0 = l; spl1 = r;
