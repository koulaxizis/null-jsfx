desc:NUL ONE SLIDER Riser
//tags: build tension riser sweep transition edm pre-drop 
// Collection: NULL JSFX 
// Author: Christos Koulaxizis 
// v1.0 — One slider tension builder (pitch rise + filter + noise + reverb)

slider1:0<0,100,1>Riser Intensity (0=Bypass, 100=Full Build Effect)
@init
// Riser parameters - all mapped to single slider
pitch_rate = 0;
filter_cutoff = 20;
noise_level = 0;
reverb_decay = 0;
white_noise_buffer = 0;
noise_phase = 0;
// Filter state (highpass for tension)
hp_prev_in = 0;
hp_prev_out = 0;
hp_a0 = 0; hp_a1 = 0; hp_a2 = 0; hp_b1 = 0; hp_b2 = 0;
// Reverb delay line
reverb_delay_size = 44100;
reverb_pos = 0;
reverb_feedback = 0;
reverb_out = 0;
// Pitch modulation
pitch_osc = 0;
pitch_osc_rate = 0;
@slider
// Read slider (0-100)
riser_val = slider1 / 100; // 0 to 1
// Map to multiple parameters
pitch_rate = riser_val * 10; // 0 to 10 Hz upward pitch sweep
filter_cutoff = 20 + riser_val * 19980; // 20Hz to 20kHz (opens up)
noise_level = riser_val * 0.3; // 0 to 30% white noise
reverb_decay = riser_val * 2; // 0 to 2 sec tail
pitch_osc_rate = 10 + riser_val * 20; // 10-30 Hz vibrato for tension
// Highpass filter coefficients for tension buildup
f_norm = filter_cutoff / sr * 2;
w = f_norm * 3.14159265359;
alpha = sin(w) / 2;
// HPF RBJ coefficients
hp_a0 = 1 / (1 + alpha);
hp_a1 = -2 * cos(w) * hp_a0;
hp_a2 = (1 - alpha) * hp_a0;
hp_b1 = -(1 - alpha) * hp_a0;
hp_b2 = (1 - alpha) * hp_a0;
// Reverb parameters
reverb_feedback = riser_val * 0.8; // 0 to 0.8 feedback
@sample
// Generate white noise for riser texture
noise_phase = noise_phase + 1;
if (noise_phase >= 44100) noise_phase = 0;
// Pseudo-random noise (simple PRNG)
white_noise_buffer = white_noise_buffer * 16807 % 2147483647;
noise_sample = (white_noise_buffer / 2147483647.0) * 2 - 1;
// Apply white noise
noise_out_l = noise_sample * noise_level;
noise_out_r = noise_sample * noise_level;
// Highpass filter for tension (cutoff opens with slider)
hp_in = in_l + noise_out_l;
hp_out_l = hp_a0 * hp_in + hp_a1 * hp_prev_in + hp_a2 * hp_prev2_in - hp_b1 * hp_prev_out_l - hp_b2 * hp_prev2_out_l;
hp_prev2_in = hp_prev_in; hp_prev_in = hp_in;
hp_prev2_out_l = hp_prev_out_l; hp_prev_out_l = hp_out_l;
// Same for right channel
hp_in_r = in_r + noise_out_r;
hp_out_r = hp_a0 * hp_in_r + hp_a1 * hp_prev_in_r + hp_a2 * hp_prev2_in_r - hp_b1 * hp_prev_out_r - hp_b2 * hp_prev2_out_r;
hp_prev2_in_r = hp_prev_in_r; hp_prev_in_r = hp_in_r;
hp_prev2_out_r = hp_prev_out_r; hp_prev_out_r = hp_out_r;
// Pitch modulation (subtle upward sweep for tension)
pitch_osc = pitch_osc + pitch_osc_rate / sr;
if (pitch_osc > 1) pitch_osc = pitch_osc - 1;
pitch_mod = sin(pitch_osc * 6.28318530718) * riser_val * 0.1; // +/- 10% pitch variation
// Combine filtered signal + original + noise
filtered_mix = riser_val; // More filter as slider increases
out_l = in_l * (1 - filtered_mix) + hp_out_l * filtered_mix + noise_out_l;
out_r = in_r * (1 - filtered_mix) + hp_out_r * filtered_mix + noise_out_r;
// Simple reverb tail for build-up atmosphere (running comb filter)
reverb_pos = (reverb_pos + 1) % reverb_delay_size;
reverb_delay[reverb_pos] = out_l + reverb_feedback * reverb_out;
reverb_read = (reverb_pos - int(sr * reverb_decay / 2)) % reverb_delay_size;
if (reverb_read < 0) reverb_read += reverb_delay_size;
reverb_out = reverb_delay[reverb_read];
// Mix in reverb (increases with intensity)
reverb_mix = riser_val * 0.2; // Max 20% reverb
out_l = out_l * (1 - reverb_mix) + reverb_out * reverb_mix;
out_r = out_r * (1 - reverb_mix) + reverb_out * reverb_mix;
// Clamp
out_l = min(max(out_l, -1), 1);
out_r = min(max(out_r, -1), 1);