desc:NULL Wetter
author: Christos Koulaxizis
tags: reverb space ambience hall room wet
//category: One Slider
//NULL JSFX v2.0 • https://nulljsfx.tech • MIT License

slider1:50<0,100,1>Amount

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  // Instant room: a compact Freeverb-style reverb (four damped feedback combs and two
  // allpass diffusers per channel, right channel slightly longer for width).
  // Amount raises the wet level (up to 45%) and the room size together.
  bs = ceil(srate * 0.05) + 2;
  memset(0, 0, bs * 12); freembuf(bs * 12);
  sc = srate / 44100;
  function comb_init(b, len) ( this.b = b; this.len = max(1, floor(len * sc)); this.p = 0; this.f = 0; );
  function comb(x, fb, damp) local(y)
  (
    y = this.b[this.p];
    this.f = y * (1 - damp) + this.f * damp;
    this.b[this.p] = x + this.f * fb;
    this.p = (this.p + 1) % this.len;
    y;
  );
  function ap_init(b, len) ( this.b = b; this.len = max(1, floor(len * sc)); this.p = 0; );
  function ap(x) local(y, v)
  (
    v = this.b[this.p];
    y = v - x;
    this.b[this.p] = x + v * 0.5;
    this.p = (this.p + 1) % this.len;
    y;
  );
  cl1.comb_init(bs * 0, 1116); cl2.comb_init(bs * 1, 1188); cl3.comb_init(bs * 2, 1277); cl4.comb_init(bs * 3, 1356);
  cr1.comb_init(bs * 4, 1139); cr2.comb_init(bs * 5, 1211); cr3.comb_init(bs * 6, 1300); cr4.comb_init(bs * 7, 1379);
  al1.ap_init(bs * 8, 556); al2.ap_init(bs * 9, 341);
  ar1.ap_init(bs * 10, 579); ar2.ap_init(bs * 11, 364);

@slider
  amount = slider1 / 100;
  fb = 0.70 + amount * 0.18;
  damp = 0.35;
  wet = amount * 0.45 * 0.25;
  dry = 1 - amount * 0.25;

@sample
  in = (spl0 + spl1) * 0.5;
  l = cl1.comb(in, fb, damp) + cl2.comb(in, fb, damp) + cl3.comb(in, fb, damp) + cl4.comb(in, fb, damp);
  r = cr1.comb(in, fb, damp) + cr2.comb(in, fb, damp) + cr3.comb(in, fb, damp) + cr4.comb(in, fb, damp);
  l = al2.ap(al1.ap(l));
  r = ar2.ap(ar1.ap(r));
  spl0 = spl0 * dry + l * wet;
  spl1 = spl1 * dry + r * wet;
