desc:NULL Breath Control
author: Christos Koulaxizis
tags: breath vocal dynamics
//category: Essentials
//NULL JSFX v2.0 • https://nulljsfx.tech • MIT License

slider1:-40<-70,0,0.5>Threshold (dB)
slider2:5<1,50,1>Attack (ms)
slider3:120<20,1000,1>Release (ms)
slider4:-12<-24,0,1>Range (dB)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  // Breath reducer: a stereo-linked level detector (max of L/R power, 1 ms rise and
  // 30 ms fall smoothing) is compared with Threshold. While the level stays below Threshold
  // (breaths, room noise between phrases) the gain moves down to Range; when the
  // voice comes back above Threshold the gain returns to unity. A 3 dB hysteresis
  // keeps it from chattering around the threshold. No clipping, zero latency.
  env = 0;
  gain = 1;
  open = 1;

@slider
  thr_lin = 10 ^ (slider1 / 20);
  thr_open = thr_lin * thr_lin;
  thr_close = thr_open * 0.5;
  att_c = 1 - exp(-1 / (max(slider2, 0.1) * srate / 1000));
  rel_c = 1 - exp(-1 / (max(slider3, 1) * srate / 1000));
  range_lin = 10 ^ (slider4 / 20);
  env_up = 1 - exp(-1 / (0.001 * srate));
  env_dn = 1 - exp(-1 / (0.03 * srate));

@sample
  pw = max(spl0 * spl0, spl1 * spl1);
  env += (pw > env ? env_up : env_dn) * (pw - env);
  open = open ? (env > thr_close) : (env > thr_open);
  target = open ? 1 : range_lin;
  gain += (target > gain ? att_c : rel_c) * (target - gain);
  spl0 *= gain;
  spl1 *= gain;
