+
+   #if DISTRHO_PLUGIN_NUM_OUTPUTS != 0
+    // NULL JSFX patch: no output sample is subnormal. The DSP runs in double, so a decaying tail
+    // turns into subnormal floats on the way out, which hosts and clap-validator reject.
+    static void flushSubnormalOutputs(float** const outputs, const uint32_t frames) noexcept
+    {
+        for (uint32_t i=0; i<DISTRHO_PLUGIN_NUM_OUTPUTS; ++i)
+        {
+            if (float* const out = outputs[i])
+            {
+                for (uint32_t j=0; j<frames; ++j)
+                    if (std::fabs(out[j]) < FLT_MIN)
+                        out[j] = 0.0f;
+            }
+        }
     }
    #endif
 
