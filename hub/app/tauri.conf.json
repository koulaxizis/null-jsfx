{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NULL JSFX Hub",
  "mainBinaryName": "null-jsfx-hub",
  "identifier": "tech.nulljsfx.hub",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NULL JSFX Hub",
        "width": 1180,
        "height": 780,
        "minWidth": 760,
        "minHeight": 520,
        "backgroundColor": "#1b1a18",
        "theme": "Dark",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://nulljsfx.tech data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "deb",
      "dmg"
    ],
    "publisher": "NULL JSFX",
    "homepage": "https://nulljsfx.tech",
    "category": "Music",
    "shortDescription": "Install, update and remove the NULL JSFX plugins",
    "longDescription": "NULL JSFX Hub installs, updates and removes the free NULL JSFX plugins (JSFX, JSFX GFX, VST3, CLAP) from the official GitHub releases.",
    "copyright": "MIT License",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "deb": {
        "section": "sound"
      }
    }
  }
}
