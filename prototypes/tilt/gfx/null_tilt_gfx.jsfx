desc:NULL Tilt GFX
author: Christos Koulaxizis
tags: eq tilt tone bass treble balance tonal gui
//category: One Slider
//NULL JSFX v2.0 • https://nulljsfx.tech • MIT License

import null_gfx.jsfx-inc

slider1:0<-100,100,1>-Amount

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
  // Same DSP as NULL Tilt: a one-pole low-pass at 700 Hz splits the signal, the low part
  // gets -t*6 dB and the high part +t*6 dB (t = Amount/100). Positive values brighten,
  // negative values darken, 0 is flat. The only addition is a ~10 ms smoother on the two
  // gains so moving the knob does not zip; at rest the gains equal the targets exactly.
  lp_l = lp_r = 0;
  gain_init = 0;
  gfx_ext_retina = 1;

  function update_coefs()
  (
    t = slider1 / 100;
    c = exp(-2 * $pi * 700 / srate);
    g_low = 10 ^ (-t * 6 / 20);
    g_high = 10 ^ (t * 6 / 20);
  );

  function set_amount(v)
  (
    v = max(-100, min(100, floor(v + 0.5)));
    v != slider1 ? (
      slider1 = v;
      update_coefs();
      sliderchange(slider1);
      slider_automate(slider1);
    );
  );

  // tilt response in dB at frequency f (one-pole split, same as @sample)
  function tilt_db(f) local(w, cw, sw, den, lr, li, hr, hi)
  (
    w = 2 * $pi * min(f, srate * 0.499) / srate;
    cw = cos(w);
    sw = sin(w);
    den = (1 - c * cw) * (1 - c * cw) + c * c * sw * sw;
    lr = (1 - c) * (1 - c * cw) / den;
    li = -(1 - c) * c * sw / den;
    hr = g_high + (g_low - g_high) * lr;
    hi = (g_low - g_high) * li;
    10 * log10(max(hr * hr + hi * hi, 0.0000000001));
  );

@slider
  update_coefs();
  gain_init == 0 ? (
    gl = g_low;
    gh = g_high;
    gain_init = 1;
  );

@block
  sm = 1 - exp(-1 / (0.01 * srate));

@sample
  gl != g_low ? (
    gl += sm * (g_low - gl);
    abs(g_low - gl) < 0.0000001 ? gl = g_low;
  );
  gh != g_high ? (
    gh += sm * (g_high - gh);
    abs(g_high - gh) < 0.0000001 ? gh = g_high;
  );
  lp_l = (1 - c) * spl0 + c * lp_l;
  lp_r = (1 - c) * spl1 + c * lp_r;
  spl0 = lp_l * gl + (spl0 - lp_l) * gh;
  spl1 = lp_r * gl + (spl1 - lp_r) * gh;

@gfx 360 240
  ng_begin(360, 240);
  ng_header("TILT", "ONE SLIDER");

  // ---- response card ---------------------------------------------------------------------
  ng_card(14, 54, 332, 110);
  gx = X(46); gy = Y(64); gw = 284 * ng_s; gh_px = 78 * ng_s;
  lf = log(1000);

  // frequency grid: 1..9 x decade, decades brighter
  d = 10;
  loop(4,
    m = 1;
    loop(9,
      f = m * d;
      f >= 20 && f <= 20000 ? (
        xx = floor(gx + gw * log(f / 20) / lf) + 0.5;
        ng_col(NG_BORDER, m == 1 ? 1 : 0.5);
        gfx_line(xx, gy, xx, gy + gh_px, 0);
      );
      m += 1;
    );
    d *= 10;
  );
  // dB grid and labels
  ng_font(4, 8, 0);
  db = -6;
  loop(5,
    yy = floor(gy + gh_px * (0.5 - db / 16)) + 0.5;
    ng_col(db == 0 ? 0x45433f : NG_BORDER, db == 0 ? 1 : 0.6);
    gfx_line(gx, yy, gx + gw, yy, 0);
    abs(db) == 6 || db == 0 ? (
      ng_col(NG_MUTED, 1);
      db > 0 ? sprintf(#lbl, "+%d", db) : sprintf(#lbl, "%d", db);
      ng_txt(#lbl, 40, 64 + 78 * (0.5 - db / 16), 2, 0);
    );
    db += 3;
  );
  ng_col(NG_MUTED, 1);
  ng_txt("100", 46 + 284 * log(5) / lf, 153, 1, 0);
  ng_txt("1k", 46 + 284 * log(50) / lf, 153, 1, 0);
  ng_txt("10k", 46 + 284 * log(500) / lf, 153, 1, 0);

  // 700 Hz pivot (dashed)
  mx = floor(gx + gw * log(35) / lf) + 0.5;
  ng_col(NG_ACCENT, 0.5);
  yy = gy;
  while(
    gfx_line(mx, yy, mx, min(yy + 3 * ng_s, gy + gh_px), 0);
    yy += 6 * ng_s;
    yy < gy + gh_px;
  );

  // magnitude response: soft fill to 0 dB, then the curve
  zy = gy + gh_px * 0.5;
  ng_col(NG_ACCENT, 0.10);
  xi = 0;
  loop(floor(gw) + 1,
    yy = gy + gh_px * (0.5 - tilt_db(20 * 1000 ^ (xi / gw)) / 16);
    gfx_line(gx + xi, zy, gx + xi, yy, 0);
    xi += 1;
  );
  ng_col(NG_ACCENT, 1);
  k = 0;
  loop(3,
    xi = 0;
    loop(floor(gw) + 1,
      yy = gy + gh_px * (0.5 - tilt_db(20 * 1000 ^ (xi / gw)) / 16) + (k - 1) * 0.6 * ng_s;
      xi == 0 ? (gfx_x = gx; gfx_y = yy;) : gfx_lineto(gx + xi, yy, 1);
      xi += 1;
    );
    k += 1;
  );

  // ---- slider card -----------------------------------------------------------------------
  ng_card(14, 172, 332, 54);
  ng_font(1, 8, 1);
  ng_col(NG_MUTED, 1);
  ng_txt("AMOUNT", 28, 187, 0, 2);
  ng_font(4, 8, 0);
  slider1 == 0 ? sprintf(#cap, "FLAT") : sprintf(#cap, "LOW %+.1f  HIGH %+.1f dB", 0 - slider1 * 0.06, slider1 * 0.06);
  ng_txt(#cap, 180, 187, 1, 0.3);
  v = floor(slider1 + 0.5);
  v > 0 ? sprintf(#val, "+%d", v) : sprintf(#val, "%d", v);
  ng_font(3, 13, 1);
  ng_col(NG_TEXT, 1);
  ng_txt(#val, 332, 187, 2, 0);
  ng_font(1, 7, 1);
  ng_col(NG_MUTED, 1);
  ng_txt("DARK", 28, 210, 0, 1);
  ng_txt("BRIGHT", 332, 210, 2, 1);
  hover = ng_slider(74, 210, 212, (slider1 + 100) / 200, 1, ng_drag == 1);
  set_amount(ng_input(1, hover, slider1, -100, 100, 0, 1, 212, 1));

  ng_end();
